+    EXPECT_EQ(rootClass->source, SourceKind::Omp);
+    EXPECT_EQ(workerClass->role, Classification::Role::Self);
+    EXPECT_EQ(workerClass->root, rootKey);
+    EXPECT_EQ(toolClass->role, Classification::Role::Tool);
+    EXPECT_EQ(toolClass->root, rootKey);
+}
