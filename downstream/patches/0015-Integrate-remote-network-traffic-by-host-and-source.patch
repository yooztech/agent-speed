--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/RemoteTraffic.swift
@@ -0,0 +1,72 @@
+import Foundation
+import AgentSpeedCore
+
+/// Collector measurements are optional so snapshots from older collectors remain readable.
+struct RemoteTrafficRate: Decodable, Sendable {
+    let rx: Double
+    let tx: Double
+
+    var value: TrafficRate { TrafficRate(rx: rx, tx: tx) }
+}
+
+struct RemoteTrafficToday: Decodable, Sendable {
+    let rxSelf: Int64
+    let txSelf: Int64
+    let rxTools: Int64
+    let txTools: Int64
+}
+
+struct RemoteSourceTraffic: Decodable, Sendable {
+    let selfRate: RemoteTrafficRate?
+    let withToolsRate: RemoteTrafficRate?
+    let today: RemoteTrafficToday?
+
+    func value(source: SourceKind, online: Bool) -> SourceTraffic {
+        SourceTraffic(source: source,
+            today: TrafficSplit(own: TrafficBytes(rx: today?.rxSelf ?? 0, tx: today?.txSelf ?? 0),
+                                tools: TrafficBytes(rx: today?.rxTools ?? 0, tx: today?.txTools ?? 0)),
+            liveWithTools: online ? withToolsRate?.value : .zero,
+            liveOwn: online ? selfRate?.value : .zero)
+    }
+}
+
+struct RemoteMachineTrafficToday: Decodable, Sendable {
+    let rx: Int64
+    let tx: Int64
+    let sampledMs: Int64
+}
+
+struct RemoteTrafficHistoryRow: Decodable, Sendable {
+    let day: String
+    let key: String
+    let rx: Int64
+    let tx: Int64
+    let rxTools: Int64
+    let txTools: Int64
+    let sampledMs: Int64
+}
+
+struct RemoteTrafficHistoryKey: Hashable {
+    let day: String
+    let source: String
+}
+
+extension RemoteTrafficHistoryRow {
+    var historyKey: RemoteTrafficHistoryKey { RemoteTrafficHistoryKey(day: day, source: key) }
+
+    func adding(_ previous: RemoteTrafficHistoryRow?) -> RemoteTrafficHistoryRow {
+        guard let previous else { return self }
+        return RemoteTrafficHistoryRow(day: day, key: key, rx: rx + previous.rx, tx: tx + previous.tx,
+            rxTools: rxTools + previous.rxTools, txTools: txTools + previous.txTools,
+            sampledMs: sampledMs + previous.sampledMs)
+    }
+}
+
+struct RemoteTraffic: Decodable, Sendable {
+    let enabled: Bool
+    let available: Bool
+    let machineRate: RemoteTrafficRate?
+    let machineToday: RemoteMachineTrafficToday?
+    let sources: [String: RemoteSourceTraffic]?
+    let history: [RemoteTrafficHistoryRow]?
+}
