+            HistoryCsv.BuildHosts(selected, null, new(new(2026, 10, 24), day), default, HistoryColumn.Date, false,
+                null, visible, day, DateTimeOffset.Now, "local");
+        var lines = Export(hosts, true).Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+        var header = lines[0].Split(',');
+        Assert.Equal("traffic_rx_bytes", header[^4]);
+        var rows = lines[1..].Select(line => line.Split(',')).ToArray();
+        Assert.All(rows, row => Assert.Equal(header.Length, row.Length));
+        string[] Row(string host, string date, string source) => Assert.Single(rows, row => row[0] == host && row[1] == date && row[2] == source);
