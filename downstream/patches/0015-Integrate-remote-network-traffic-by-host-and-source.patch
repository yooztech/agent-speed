+        Assert.All(Row("local", "2026-10-24", "pi")[^4..], value => Assert.Empty(value));
+        Assert.All(Row("remote-a", "2026-10-25", "pi")[^4..], value => Assert.Empty(value));
+        Assert.All(Row("remote-a", "2026-10-24", "codex")[^4..], value => Assert.Empty(value));
+
+        var remoteOnly = Export(hosts.Skip(1).Take(1), true);
