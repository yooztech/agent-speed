+import AgentSpeedCore
+import Foundation
+import Testing
+@testable import AgentSpeed
+
+@Suite("Remote traffic")
+struct RemoteTrafficTests {
+    private func decode(_ text: String) throws -> RemoteMessage {
+        try #require(RemoteMessage.decode(Data(text.utf8)))
+    }
+
+    @Test func optionalPayloadAndRealHistory() throws {
+        let old = try decode(#"{"version":1,"type":"snapshot"}"#)
+        #expect(old.traffic == nil)
+        let frame = try decode(#"{"version":1,"type":"snapshot","traffic":{"enabled":true,"available":true,"machine_rate":null,"machine_today":{"rx":20,"tx":10,"sampled_ms":500},"sources":{"codex":{"self_rate":{"rx":4,"tx":2},"with_tools_rate":{"rx":6,"tx":3},"today":{"rx_self":100,"tx_self":50,"rx_tools":20,"tx_tools":10}}},"history":[{"day":"2026-01-01","key":"codex","rx":30,"tx":20,"rx_tools":5,"tx_tools":3,"sampled_ms":1000}]}}"#)
+        let traffic = try #require(frame.traffic)
+        let source = try #require(traffic.sources?["codex"])
+        #expect(source.value(source: .codex, online: true).today.total(includeTools: true) == TrafficBytes(rx: 120, tx: 60))
+        #expect(source.value(source: .codex, online: true).liveOwn == TrafficRate(rx: 4, tx: 2))
+        #expect(traffic.history?.count == 1)
+        #expect(traffic.history?.first?.day == "2026-01-01")
+        let disconnected = source.value(source: .codex, online: false)
+        #expect(disconnected.liveOwn == .zero && disconnected.liveWithTools == .zero)
+        #expect(disconnected.today.own == TrafficBytes(rx: 100, tx: 50))
+    }
+
+    @Test @MainActor func rowsKeepHostsSeparateAndHonorSourceFilter() throws {
+        let frame = try decode(#"{"version":1,"type":"snapshot","sources":[{"source":"codex","enabled":true,"available":true,"sessions":0,"active_agents":0,"today_input":0,"today_output":0,"today_requests":0},{"source":"omp","enabled":true,"available":true,"sessions":0,"active_agents":0,"today_input":0,"today_output":0,"today_requests":0}],"traffic":{"enabled":true,"available":true,"sources":{"codex":{"self_rate":{"rx":4,"tx":2},"with_tools_rate":{"rx":6,"tx":3},"today":{"rx_self":100,"tx_self":50,"rx_tools":20,"tx_tools":10}},"omp":{"self_rate":{"rx":12,"tx":3},"with_tools_rate":{"rx":12,"tx":3},"today":{"rx_self":200,"tx_self":30,"rx_tools":0,"tx_tools":0}}},"history":[]}}"#)
+        var state = RemoteHostState()
+        state.apply(frame)
+        let host = RemoteHost(label: "Server", destination: "server", enabled: true)
+        let statuses = try #require(state.dashboardSnapshot?.sources)
+        let instances = statuses.map { SourceInstance(hostID: host.id, status: $0) }
+        let local = TrafficSnapshot(timestamp: Date(), enabled: true, processState: .standby,
+            sources: [.codex: SourceTraffic(source: .codex, today: TrafficSplit(own: TrafficBytes(rx: 7, tx: 8)))])
+        let rows = TrafficSection.rows(local, instances: instances, hosts: [host], states: [host.id: state], enabled: SourceSet(.codex), includeTools: true)
+        #expect(rows.count == 3)
+        #expect(rows.first(where: { $0.hostID == host.id && $0.traffic.source == .codex })?.traffic.today.own.rx == 100)
+        #expect(rows.first(where: { $0.hostID == host.id && $0.traffic.source == .omp })?.traffic.today.own.rx == 200)
+        #expect(rows.first(where: { $0.hostID == host.id && $0.traffic.source == .omp })?.traffic.liveOwn == TrafficRate(rx: 12, tx: 3))
+        #expect(rows.first(where: { $0.hostID == nil })?.traffic.today.own.rx == 7)
+        let hidden = TrafficSection.rows(TrafficSnapshot(timestamp: Date(), enabled: true, processState: .standby), instances: instances, hosts: [host], states: [host.id: state], enabled: SourceSet(rawValue: 0), includeTools: true)
+        #expect(hidden.count == 2 && hidden.allSatisfy { $0.hostID == host.id })
+        state.disconnected()
+        let offline = TrafficSection.rows(local, instances: instances, hosts: [host], states: [host.id: state], enabled: .everything, includeTools: true)
+        #expect(offline.first(where: { $0.hostID == host.id && $0.traffic.source == .codex })?.traffic.liveOwn == .zero)
+        #expect(offline.first(where: { $0.hostID == host.id && $0.traffic.source == .codex })?.traffic.today.own.rx == 100)
+    }
+
+    @Test @MainActor func remoteHistoryAndRowsUseRemoteSourceEnablement() throws {
+        let json = #"{"version":1,"type":"snapshot","sources":[{"source":"omp","enabled":true,"available":true,"sessions":0,"active_agents":0,"today_input":0,"today_output":0,"today_requests":0}],"traffic":{"enabled":true,"available":true,"sources":{"omp":{"self_rate":{"rx":12,"tx":3},"with_tools_rate":{"rx":12,"tx":3},"today":{"rx_self":200,"tx_self":30,"rx_tools":0,"tx_tools":0}}},"history":[{"day":"2026-01-01","key":"omp","rx":200,"tx":30,"rx_tools":0,"tx_tools":0,"sampled_ms":1000}]}}"#
+        let host = RemoteHost(label: "Server", destination: "server", enabled: true)
+        var state = RemoteHostState()
+        state.apply(try decode(json))
+        let day = try #require(DayKey("2026-01-01"))
+        let local = TrafficSnapshot(timestamp: Date(), enabled: true, processState: .standby,
+            sources: [.codex: SourceTraffic(source: .codex, today: TrafficSplit(own: TrafficBytes(rx: 7, tx: 8))),
+                      .omp: SourceTraffic(source: .omp, today: TrafficSplit(own: TrafficBytes(rx: 9, tx: 10)))])
+        func rows() throws -> [TrafficDisplayRow] {
+            let statuses = try #require(state.dashboardSnapshot?.sources)
+            return TrafficSection.rows(local, instances: statuses.map { SourceInstance(hostID: host.id, status: $0) },
+                hosts: [host], states: [host.id: state], enabled: SourceSet(.codex), includeTools: true)
+        }
+        let visible = try rows()
+        #expect(visible.contains { $0.hostID == host.id && $0.traffic.source == .omp })
+        #expect(visible.contains { $0.hostID == nil && $0.traffic.source == .codex })
+        #expect(!visible.contains { $0.hostID == nil && $0.traffic.source == .omp })
+        let history = HistoryViewModel.remoteHistoryTraffic(host: host, state: state, includeTools: true, bits: false)
+        #expect(history.day(day, source: .omp, today: day, now: Date(), calendar: .current)?.own.rx == 200)
+        state.apply(try decode(json.replacingOccurrences(of: #""source":"omp","enabled":true"#, with: #""source":"omp","enabled":false"#)))
+        #expect(!(try rows()).contains { $0.hostID == host.id && $0.traffic.source == .omp })
+        let hidden = HistoryViewModel.remoteHistoryTraffic(host: host, state: state, includeTools: true, bits: false)
+        #expect(hidden.day(day, source: .omp, today: day, now: Date(), calendar: .current) == nil)
+    }
+
+    @Test func collectorRestartsAccumulateOnlyOnce() throws {
+        let first = try decode(#"{"version":1,"type":"snapshot","traffic":{"enabled":true,"available":true,"history":[{"day":"2026-01-01","key":"codex","rx":100,"tx":20,"rx_tools":5,"tx_tools":2,"sampled_ms":1000}]}}"#)
+        let second = try decode(#"{"version":1,"type":"snapshot","traffic":{"enabled":true,"available":true,"history":[{"day":"2026-01-01","key":"codex","rx":30,"tx":10,"rx_tools":3,"tx_tools":1,"sampled_ms":500}]}}"#)
+        let key = RemoteTrafficHistoryKey(day: "2026-01-01", source: "codex")
+        var state = RemoteHostState()
+        state.apply(first)
+        state.apply(first)
+        #expect(state.trafficHistory[key]?.rx == 100)
+        state.disconnected()
+        state.apply(second)
+        state.apply(second)
+        #expect(state.trafficHistory[key]?.rx == 130)
+        #expect(state.trafficHistory[key]?.sampledMs == 1500)
+        state.disconnected()
+        #expect(state.trafficHistory[key]?.rx == 130)
+    }
+
+    @Test func remoteHistoryDoesNotInventMissingDaysOrSources() throws {
+        let row = TrafficDay(day: "2026-01-01", key: "codex", rx: 40, tx: 20, sampledMs: 1000)
+        let history = HistoryTraffic(days: [row], since: nil, includeTools: true, bits: false, requiresRecordedRows: true)
+        let recorded = try #require(DayKey("2026-01-01"))
+        let missing = try #require(DayKey("2026-01-02"))
+        let now = Date()
+        #expect(history.day(recorded, source: .codex, today: missing, now: now, calendar: .current)?.own.rx == 40)
+        #expect(history.day(missing, source: .codex, today: missing, now: now, calendar: .current) == nil)
+        #expect(history.day(recorded, source: .claudeCode, today: missing, now: now, calendar: .current) == nil)
+    }
+
+    @Test func missingTodayIsNotARecordedDay() throws {
+        let frame = try decode(#"{"version":1,"type":"snapshot","traffic":{"enabled":true,"available":true,"sources":{"codex":{"self_rate":{"rx":4,"tx":2},"with_tools_rate":null,"today":null}}}}"#)
+        let traffic = try #require(frame.traffic)
+        #expect(traffic.sources?["codex"]?.today == nil)
+        #expect(traffic.history == nil)
+    }
+}
