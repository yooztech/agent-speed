+TEST(CollectorProtocol, TrafficExportsMeasuredRatesTotalsAndHistory) {
+    collector::Protocol protocol;
+    agentspeed::Snapshot snapshot;
+    auto& traffic = snapshot.traffic;
+    traffic.enabled = true;
+    traffic.available = false;
+    traffic.machine = agentspeed::traffic::Rate{12.5, 6};
+    traffic.machineToday = {100, 200, 3000};
+    traffic.sources[agentspeed::SourceKind::Codex] = {
+        agentspeed::traffic::Rate{9, 10}, agentspeed::traffic::Rate{3, 4}};
+    traffic.sourcesToday[agentspeed::SourceKind::Codex] = {11, 12, 13, 14, 0, 0};
+    traffic.sourcesToday[agentspeed::SourceKind::Gemini] = {21, 22, 23, 24, 0, 0};
+    const std::vector<agentspeed::traffic::HistoryRow> history = {
+        {"2026-11-05", "codex", 101, 102, 103, 104, 5000}};
+    agentspeed::json::Document doc;
+    ASSERT_TRUE(doc.parse(protocol.snapshot(snapshot, std::nullopt, nullptr, history)));
+    const auto t = doc.root()["traffic"];
+    EXPECT_EQ(t["enabled"].raw(), "true");
+    EXPECT_EQ(t["available"].raw(), "false");
+    EXPECT_EQ(t["machine_rate"]["rx"].raw(), "12.5");
+    EXPECT_EQ(t["machine_today"]["tx"].raw(), "200");
+    EXPECT_EQ(t["machine_today"]["sampled_ms"].raw(), "3000");
+    const auto codex = t["sources"]["codex"];
+    EXPECT_EQ(codex["self_rate"]["rx"].raw(), "3");
+    EXPECT_EQ(codex["with_tools_rate"]["tx"].raw(), "10");
+    EXPECT_EQ(codex["today"]["rx_self"].raw(), "11");
+    EXPECT_EQ(codex["today"]["tx_tools"].raw(), "14");
+    EXPECT_TRUE(t["sources"]["gemini"]["self_rate"].isNull());
+    EXPECT_EQ(t["sources"]["gemini"]["today"]["rx_tools"].raw(), "23");
+    EXPECT_EQ(t["history"].at(0)["day"].string(), "2026-11-05");
+    EXPECT_EQ(t["history"].at(0)["key"].string(), "codex");
+    EXPECT_EQ(t["history"].at(0)["rx_tools"].raw(), "103");
+    EXPECT_EQ(t["history"].at(0)["sampled_ms"].raw(), "5000");
+    EXPECT_FALSE(t["history"].at(1).valid());
+}
+
