+        {
+            ("local", [Usage("2026-10-24", SourceKind.Pi)], HistoryTraffic.None),
+            ("remote-a", [Usage("2026-10-24", SourceKind.Pi), Usage("2026-10-25", SourceKind.Pi), Usage("2026-10-24", SourceKind.Codex)], first),
