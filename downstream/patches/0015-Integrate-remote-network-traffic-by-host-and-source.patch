@@ -0,0 +1,154 @@
+using System.Text.Json;
+using AgentSpeed.Core.Traffic;
+
+namespace AgentSpeed.Core;
+
+/// <summary>Traffic actually reported by a remote collector, without filling missing history.</summary>
+public sealed record RemoteTraffic(TrafficSnapshot Snapshot, IReadOnlyList<TrafficDay> Days)
+{
+    internal static RemoteTraffic? Parse(JsonElement root)
+    {
+        if (!root.TryGetProperty("traffic", out var traffic) || traffic.ValueKind != JsonValueKind.Object)
+            return null;
+        var sources = new Dictionary<SourceKind, SourceTraffic>();
+        if (traffic.TryGetProperty("sources", out var sourceObject) && sourceObject.ValueKind == JsonValueKind.Object)
+        {
+            foreach (var item in sourceObject.EnumerateObject())
+            {
+                if (RemoteHostData.Kind(item.Name) is not { } kind || item.Value.ValueKind != JsonValueKind.Object) continue;
+                var today = Object(item.Value, "today");
+                var split = new TrafficSplit(new(today.Integer("rx_self"), today.Integer("tx_self")),
+                    new(today.Integer("rx_tools"), today.Integer("tx_tools")));
+                var available = traffic.Boolean("available") == true;
+                sources[kind] = new(kind, split, TrafficBytes.Zero, available ? Rate(item.Value, "with_tools_rate") : null, available ? Rate(item.Value, "self_rate") : null)
+                { TodayKnown = today.ValueKind == JsonValueKind.Object };
+            }
+        }
+        var machine = Object(traffic, "machine_today");
+        var days = new List<TrafficDay>();
+        if (traffic.Array("history") is { } history)
+            foreach (var row in history.EnumerateArray())
+                if (row.Text("day") is { } day && row.Text("key") is { } key &&
+                    (key == TrafficDay.MachineKey || RemoteHostData.Kind(key) is not null))
+                    days.Add(new(day, key == TrafficDay.MachineKey ? key : History.SourceNames.Of(RemoteHostData.Kind(key)!.Value), row.Integer("rx"), row.Integer("tx"), row.Integer("rx_tools"), row.Integer("tx_tools"), row.Integer("sampled_ms")));
+        var enabled = traffic.Boolean("enabled") == true;
+        return new(new TrafficSnapshot
+        {
+            Enabled = enabled,
+            MachineLive = Rate(traffic, "machine_rate"),
+            MachineToday = new(machine.Integer("rx"), machine.Integer("tx")),
+            MachineSampledMs = machine.Integer("sampled_ms"),
+            Sources = sources,
+            ProcessState = !enabled ? ProcessTrafficState.Off : traffic.Boolean("available") == true
+                ? ProcessTrafficState.Running(1) : ProcessTrafficState.Unavailable(TrafficUnavailableReason.Sampler),
+        }, days);
+    }
+
+    internal static RemoteTraffic MergeSession(RemoteTraffic? previous, RemoteTraffic current)
+    {
+        if (previous is null) return current;
+        var rows = previous.Days.Concat(current.Days).GroupBy(r => (r.Day, r.Key))
+            .Select(g => new TrafficDay(g.Key.Day, g.Key.Key, g.Sum(r => r.Rx), g.Sum(r => r.Tx),
+                g.Sum(r => r.RxTools), g.Sum(r => r.TxTools), g.Sum(r => r.SampledMs))).ToArray();
+        var currentDay = current.Days.Select(r => r.Day).Max(StringComparer.Ordinal) ?? previous.Days.Select(r => r.Day).Max(StringComparer.Ordinal);
+        var previousToday = previous.Days.Where(r => r.Day == currentDay).ToArray();
+        var machine = previousToday.FirstOrDefault(r => r.IsMachine);
+        var sources = new Dictionary<SourceKind, SourceTraffic>(current.Snapshot.Sources);
+        foreach (var row in previousToday.Where(r => r.Source is not null))
+        {
+            var kind = row.Source!.Value;
+            var prior = new TrafficSplit(new(row.Rx, row.Tx), new(row.RxTools, row.TxTools));
+            if (sources.TryGetValue(kind, out var source)) sources[kind] = source with { Today = source.Today + prior };
+            else sources[kind] = new(kind, prior, TrafficBytes.Zero, null, null) { TodayKnown = false };
+        }
+        return new(current.Snapshot with { Sources = sources, MachineToday = current.Snapshot.MachineToday +
+            (machine is null ? TrafficBytes.Zero : new TrafficBytes(machine.Rx, machine.Tx)) }, rows);
+    }
+
+    /// <summary>Keep previously observed totals when a later snapshot omits today's values.</summary>
+    public static RemoteTraffic PreserveMissingToday(RemoteTraffic? previous, RemoteTraffic current)
+    {
+        if (previous is null) return current;
+        var sources = new Dictionary<SourceKind, SourceTraffic>(current.Snapshot.Sources);
+        foreach (var (kind, prior) in previous.Snapshot.Sources)
+        {
+            if (!sources.TryGetValue(kind, out var source))
+                sources[kind] = prior with { TodayKnown = false, LiveSelf = null, LiveWithTools = null };
+            else if (!source.TodayKnown)
+                sources[kind] = source with { Today = prior.Today };
+        }
+        var days = current.Days.GroupBy(row => (row.Day, row.Key)).ToDictionary(group => group.Key, group => group.Last());
+        foreach (var row in previous.Days) days.TryAdd((row.Day, row.Key), row);
+        return current with { Snapshot = current.Snapshot with { Sources = sources }, Days = days.Values.ToArray() };
+    }
+
+    /// <summary>Combines observed host snapshots without inventing samples for older collectors.</summary>
+    public static TrafficSnapshot Combine(TrafficSnapshot local, IEnumerable<RemoteHostStatus> hosts)
+    {
+        var hostRows = new List<HostTraffic> { new(null, string.Empty, string.Empty, local) };
+        var seenSources = new HashSet<(string, SourceKind)>();
+        var seenMachines = new HashSet<string>(StringComparer.Ordinal);
+        var sources = new Dictionary<SourceKind, SourceTraffic>(local.Sources);
+        var machineRate = local.MachineLive;
+        var machineUnknown = local.Enabled && local.MachineLive is null;
+        var machineToday = local.MachineToday;
+        var snapshots = new List<TrafficSnapshot>();
+        foreach (var host in hosts)
+        {
+            if (host.Traffic?.Snapshot is not { Enabled: true } raw) continue;
+            var uniqueSources = raw.Sources.Where(x => seenSources.Add((host.MachineId, x.Key))).ToDictionary(x => x.Key, x => x.Value);
+            var uniqueMachine = seenMachines.Add(host.MachineId);
+            var snapshot = raw with { Sources = uniqueSources, MachineLive = uniqueMachine ? raw.MachineLive : null, MachineToday = uniqueMachine ? raw.MachineToday : TrafficBytes.Zero };
+            hostRows.Add(new(host.Id, host.Label, host.MachineId, raw));
+            if (uniqueSources.Count == 0 && !uniqueMachine) continue;
+            snapshots.Add(snapshot);
+            if (uniqueMachine && snapshot.MachineLive is null) machineUnknown = true;
+            if (snapshot.MachineLive is { } rate) machineRate = (machineRate ?? TrafficRate.Zero) + rate;
+            machineToday += snapshot.MachineToday;
+            foreach (var (kind, source) in snapshot.Sources)
+            {
+                if (!sources.TryGetValue(kind, out var previous)) { sources[kind] = source; continue; }
+                sources[kind] = previous with
+                {
+                    Today = previous.Today + source.Today,
+                    Unassigned = previous.Unassigned + source.Unassigned,
+                    LiveSelf = Add(previous.LiveSelf, source.LiveSelf),
+                    LiveWithTools = Add(previous.LiveWithTools, source.LiveWithTools),
+                };
+            }
+        }
+        return local with { Enabled = local.Enabled || snapshots.Count > 0, MachineLive = machineUnknown ? null : machineRate, MachineToday = machineToday, Sources = sources, Hosts = hostRows,
+            ProcessState = local.ProcessState.IsAvailable ? local.ProcessState : snapshots.FirstOrDefault(s => s.ProcessState.IsAvailable)?.ProcessState ?? local.ProcessState };
+    }
+
+    private static TrafficRate? Add(TrafficRate? a, TrafficRate? b) =>
+        a is { } left && b is { } right ? left + right : null;
+
+    /// <summary>Last accumulated values with rates unknown while an online collector omits traffic.</summary>
+    public RemoteTraffic Unavailable() => this with { Snapshot = Snapshot with
+    {
+        MachineLive = null,
+        ProcessState = ProcessTrafficState.Unavailable(TrafficUnavailableReason.Sampler),
+        Sources = Snapshot.Sources.ToDictionary(x => x.Key, x => x.Value with
+        { LiveSelf = null, LiveWithTools = null, TodayKnown = false }),
+    } };
+
+    public RemoteTraffic Offline() => this with { Snapshot = Snapshot with
+    {
+        MachineLive = TrafficRate.Zero,
+        ProcessState = ProcessTrafficState.Standby,
+        Sources = Snapshot.Sources.ToDictionary(x => x.Key, x => x.Value with
+        { LiveSelf = TrafficRate.Zero, LiveWithTools = TrafficRate.Zero }),
+    } };
+
+    private static JsonElement Object(JsonElement parent, string name) =>
+        parent.ValueKind == JsonValueKind.Object && parent.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.Object ? value : default;
+
+    private static TrafficRate? Rate(JsonElement parent, string name)
+    {
+        var value = Object(parent, name);
+        var rx = value.NullableNumber("rx");
+        var tx = value.NullableNumber("tx");
+        return rx is >= 0 && tx is >= 0 ? new(rx.Value, tx.Value) : null;
+    }
+}
