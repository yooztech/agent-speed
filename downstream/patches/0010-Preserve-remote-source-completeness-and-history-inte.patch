+using AgentSpeed.Core;
+using AgentSpeed.Core.Money;
+using AgentSpeed.Dashboard;
+using AgentSpeed.Presentation.Cost;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Presentation.Heat;
+
+namespace AgentSpeed.Windows.Tests;
+
+public class DashboardRemoteCompletenessTests
+{
+    [Fact]
+    public void MoneyTotalsBecomeUnknownWhenRemoteContributionsAreIncompleteAndRecover()
+    {
+        Exception? failure = null;
+        var thread = new Thread(() =>
+        {
+            try
+            {
+                var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+                var model = new DashboardViewModel
+                {
+                    Cost = new CostDisplay(loc, CurrencyTable.Bundled, null),
+                    LiveUnit = LiveUnit.Cost,
+                };
+                var complete = SpeedSnapshot.Empty;
+                var incomplete = complete with { RemoteLiveComplete = false, RemoteTodayComplete = false };
+                void Update(SpeedSnapshot snapshot) => model.Update(snapshot, 0, SpeedTitle.Idle, 400, SpeedMetric.Output, loc, false);
+
+                Update(complete);
+                var live = model.ValueText;
+                var today = model.TodayCostText;
+                Assert.NotEqual("—", live);
+                Assert.NotEqual("—", today);
+                Update(incomplete);
+                Assert.Equal("—", model.ValueText);
+                Assert.Equal("—", model.HeroAccessibleName);
+                Assert.True(model.HeroMuted);
+                Assert.False(model.HeroAtLeast);
+                Assert.Equal("—", model.TodayCostText);
+                Assert.Empty(model.TodayCostRows);
+                Update(complete);
+                Assert.Equal(live, model.ValueText);
+                Assert.Equal(today, model.TodayCostText);
+            }
+            catch (Exception ex)
+            {
+                failure = ex;
+            }
+        });
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start();
+        thread.Join();
+        if (failure is not null)
+        {
+            System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+        }
+    }
