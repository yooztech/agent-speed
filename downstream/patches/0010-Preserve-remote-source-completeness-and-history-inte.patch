+    {
+        Exception? failure = null;
+        var thread = new Thread(() =>
+        {
+            try
+            {
+                var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+                var model = new DashboardViewModel();
+                var snapshot = SpeedSnapshot.Empty with
+                {
+                    AverageToday = 12.5,
+                    RemoteHosts = [new RemoteHostStatus(Guid.NewGuid(), "remote", true, null)],
+                };
+                model.Update(snapshot, 0, SpeedTitle.Idle, 400, SpeedMetric.Output, loc, false);
+                Assert.NotEqual("—", model.AverageText);
+                model.Update(snapshot with { AverageToday = null }, 0, SpeedTitle.Idle, 400, SpeedMetric.Output, loc, false);
+                Assert.Equal("—", model.AverageText);
+            }
+            catch (Exception ex) { failure = ex; }
+        });
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start();
+        thread.Join();
+        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+    }
