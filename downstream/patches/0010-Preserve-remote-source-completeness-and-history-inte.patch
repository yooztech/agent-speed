+++ b/windows/src/AgentSpeed.Presentation/History/HistoryAggregator.cs
@@ -5,6 +5,24 @@ namespace AgentSpeed.Presentation.History;
 /// <summary>Turns stored per-source days (<see cref="DailyUsage"/>) into what the Usage History window shows.</summary>
 public static class HistoryAggregator
 {
+    /// <summary>Choose one host's complete history per remote machine and source, retaining host attribution for export.</summary>
+    public static IEnumerable<(string Id, IReadOnlyList<DailyUsage> Days)> Hosts(
+        IReadOnlyList<DailyUsage> local, IEnumerable<RemoteHostStatus> hosts)
+    {
+        yield return ("local", local);
+        var seen = new HashSet<(string Machine, SourceKind Source)>();
+        foreach (var host in hosts.OrderByDescending(h => h.Online).ThenByDescending(h => h.HistoryCurrent))
+        {
+            var covered = host.HistoryCurrent && host.HistoryPartial == false && host.HistorySourceCoverage is { } coverage
+                ? host.Days.Select(d => d.Source).Concat(coverage)
+                : host.Days.Select(d => d.Source);
+            var accepted = covered.Distinct()
+                .Where(source => seen.Add((host.MachineId ?? host.Id.ToString(), source))).ToHashSet();
+            var days = host.Days.Where(d => accepted.Contains(d.Source)).ToArray();
+            if (days.Length > 0) yield return (host.Id.ToString(), days);
+        }
+    }
+
     /// <summary>
     /// Days with data inside <paramref name="range"/> for one source (or every source when null), oldest first.
     /// Records with an unreadable day or without any usage are ignored. The costs of <paramref name="excluded"/> sources add
