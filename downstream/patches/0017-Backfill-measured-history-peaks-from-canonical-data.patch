+TEST(CollectorSampler, HistoryBackfillsMeasuredPeakOnFirstRun) {
+    char home[] = "/tmp/agentspeed-sampler-backfill-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    struct TempHome {
+        const char* path;
+        ~TempHome() { std::filesystem::remove_all(path); }
+    } tempHome{home};
+    ScopedEnv homeEnv("HOME", home);
+    ScopedEnv agentEnv("PI_CODING_AGENT_DIR", nullptr);
+    ScopedEnv sessionEnv("PI_CODING_AGENT_SESSION_DIR", nullptr);
+    ScopedEnv configEnv("PI_CONFIG_DIR", ".omp");
+    ScopedEnv codexEnv("CODEX_HOME", nullptr);
+    ScopedEnv claudeEnv("CLAUDE_CONFIG_DIR", nullptr);
+    ScopedEnv deepseekEnv("DSH_HOME", nullptr);
+    ScopedEnv xdgEnv("XDG_DATA_HOME", nullptr);
+    ScopedEnv geminiEnv("GEMINI_CLI_HOME", nullptr);
+
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-project";
+    std::filesystem::create_directories(dir);
+    const auto file = dir / "2026-10-19T23-30-00-000Z_01a158ec-db00-75e2-83a6-00013c6ef362.jsonl";
+    std::ofstream(file)
+        << R"({"type":"session","version":3,"id":"session-id","timestamp":"2026-10-19T23:30:00.000Z","cwd":"/project"})" << '\n'
+        << R"({"type":"message","id":"response-id","parentId":null,"timestamp":"2026-10-19T23:30:00.000Z","message":{"role":"assistant","content":[],"api":"openai-responses","provider":"openai","model":"gpt-5.5","usage":{"input":300,"output":410,"cacheRead":40,"cacheWrite":20,"reasoningTokens":70,"totalTokens":770},"stopReason":"stop","timestamp":1792452600000,"duration":3000}})" << '\n';
+
+    const std::string digest(64, 'a');
+    const auto losAngeles = agentspeed::TimeZone::load("America/Los_Angeles");
+    ASSERT_TRUE(losAngeles);
+    const collector::View west{std::string("America/Los_Angeles"), losAngeles};
+    constexpr std::int64_t now = 1792476000000LL; // 2026-10-20 06:00 UTC
+    {
+        collector::Sampler sampler(home, digest);
+        sampler.poll(now);
+        std::string history;
+        agentspeed::json::Document doc;
+        for (int i = 0; i < 500; ++i) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            history = sampler.history(west);
+            if (history.empty() || !doc.parse(history)) continue;
+            if (doc.root()["days"].at(0)["peak"].number()) break;
+        }
+        ASSERT_FALSE(history.empty());
+        ASSERT_TRUE(doc.parse(history));
+        EXPECT_EQ(doc.root()["days"].at(0)["day"].string(), "2026-10-19");
+        const auto peak = doc.root()["days"].at(0)["peak"].number();
+        ASSERT_TRUE(peak.has_value());
+        EXPECT_NEAR(*peak, 410.0 / 3.0, 1e-9);
+    }
+    const auto database = std::filesystem::path(home) / ".cache/agentspeed-collector" / digest / "history.sqlite3";
+    auto store = agentspeed::history::Store::open(database.string());
+    ASSERT_TRUE(store);
+    const auto peaks = store->peakDays("America/Los_Angeles");
+    ASSERT_EQ(peaks.size(), 1u);
+    EXPECT_NEAR(peaks.at("2026-10-19"), 410.0 / 3.0, 1e-9);
+}
