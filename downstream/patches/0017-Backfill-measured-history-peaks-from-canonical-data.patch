+std::map<std::string, double> Analyzer::measuredPeaks(std::shared_ptr<const TimeZone> zone) const {
+    const DayLabeler labeler(std::move(zone));
+    struct Stream {
+        std::int64_t start = 0, end = 0, output = 0, bucket = 0, key = 0;
+        double value = 0;
+        bool next() {
+            if (bucket >= end) return false;
+            key = bucket;
+            const auto high = std::min(bucket + 1000, end);
+            const auto low = std::max(bucket, start);
+            value = static_cast<double>(output) * static_cast<double>(high - low) / static_cast<double>(end - start);
+            bucket += 1000;
+            return true;
+        }
+    };
+    struct Later {
+        bool operator()(const Stream& a, const Stream& b) const { return a.key > b.key; }
+    };
+    std::priority_queue<Stream, std::vector<Stream>, Later> pending;
+    for (const auto& [path, file] : canonicalFiles_) {
+        if (!file) continue;
+        for (const auto& response : file->items) {
+            if (!response.final) continue;
+            const auto engineResponse = engineOf(response);
+            const auto interval = engine::interval(engineResponse);
+            if (!interval || interval->second <= interval->first || engineResponse.output <= 0) continue;
+            Stream stream;
+            stream.start = interval->first;
+            stream.end = interval->second;
+            stream.output = engineResponse.output;
+            stream.bucket = (stream.start >= 0 ? stream.start / 1000 : (stream.start - 999) / 1000) * 1000;
+            if (stream.next()) pending.push(stream);
+        }
+    }
+    std::map<std::int64_t, double> window;
+    std::map<std::string, double> peaks;
+    while (!pending.empty()) {
+        const auto key = pending.top().key;
+        double value = 0;
+        while (!pending.empty() && pending.top().key == key) {
+            auto stream = pending.top();
+            pending.pop();
+            value += stream.value;
+            if (stream.next()) pending.push(stream);
+        }
+        window[key] = value;
+        if (const auto day = labeler.label(key)) {
+            double sum = 0;
+            for (int i = 0; i < 3; ++i) {
+                const auto at = key - i * 1000;
+                const auto it = window.find(at);
+                if (it != window.end() && labeler.label(at) == day) sum += it->second;
+            }
+            auto& peak = peaks[*day];
+            if (sum / 3.0 > peak) peak = sum / 3.0;
+        }
+        while (!window.empty() && window.begin()->first < key - 2000) window.erase(window.begin());
+    }
+    return peaks;
+}
