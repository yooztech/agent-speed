+    replaceAll(data, "2026-10-20T10:", "2026-10-20T00:");
+    writeFile(file, data);
+
+    SourceLocations locations;
+    locations.codexRoot = root.string();
+    const std::set<SourceKind> enabled{SourceKind::Codex};
+    const auto utc = TimeZone::utc();
+    const auto la = TimeZone::load("America/Los_Angeles");
+    ASSERT_TRUE(la);
+    auto store = Store::open((temp.path / "backfill.sqlite").string());
+    ASSERT_TRUE(store);
+    Analyzer analyzer(*store, std::make_shared<pricing::PriceBook>());
+    const auto report = analyzer.runShared(locations, enabled, utc, "UTC");
+    ASSERT_EQ(report.filesAnalyzed, 1);
+    const auto utcPeaks = analyzer.measuredPeaks(utc);
+    ASSERT_EQ(utcPeaks.size(), 1u);
+    EXPECT_GT(utcPeaks.at("2026-10-20"), 0);
+    const auto laPeaks = analyzer.measuredPeaks(la);
+    ASSERT_EQ(laPeaks.size(), 1u);
+    EXPECT_GT(laPeaks.at("2026-10-19"), 0);
+    EXPECT_DOUBLE_EQ(utcPeaks.at("2026-10-20"), laPeaks.at("2026-10-19"));
