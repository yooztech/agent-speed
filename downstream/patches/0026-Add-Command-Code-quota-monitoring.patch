diff --git a/macos/Sources/AgentSpeedCore/CommandCodeAPIKeyStore.swift b/macos/Sources/AgentSpeedCore/CommandCodeAPIKeyStore.swift
new file mode 100644
index 00000000..6951d736
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CommandCodeAPIKeyStore.swift
@@ -0,0 +1,111 @@
+import Foundation
+#if canImport(Security)
+import Security
+#endif
+
+public struct CommandCodeKeyMetadata: Equatable, Sendable {
+    public let configured: Bool
+    public init(configured: Bool) { self.configured = configured }
+}
+
+public enum CommandCodeKeyStoreError: Error, Sendable { case invalidRequest, storageError }
+
+/// A key saved by AgentSpeed plus the per-save revision that isolates its quota cache.
+public struct CommandCodeAPIKey: Codable, Sendable, Equatable {
+    public let apiKey: String
+    public let revision: String
+    public init(apiKey: String, revision: String) throws {
+        guard Self.isValid(apiKey), Self.isValidRevision(revision) else { throw CommandCodeKeyStoreError.invalidRequest }
+        self.apiKey = apiKey
+        self.revision = revision
+    }
+    public static func isValid(_ key: String) -> Bool {
+        !key.isEmpty && key.utf8.count <= 4096 && key.utf8.allSatisfy { (33...126).contains($0) }
+    }
+    /// Exactly sixteen random bytes in lowercase hex; never derived from the key.
+    public static func isValidRevision(_ value: String) -> Bool {
+        value.utf8.count == 32 && value.utf8.allSatisfy { (48...57).contains($0) || (97...102).contains($0) }
+    }
+    public static func randomRevision() -> String {
+        var generator = SystemRandomNumberGenerator()
+        return (0..<16).map { _ in String(format: "%02x", UInt8.random(in: 0...255, using: &generator)) }.joined()
+    }
+}
+
+/// Only nil means absence. Errors and malformed configured items must never enable another source.
+public protocol CommandCodeAPIKeyStoring: Sendable {
+    func read() throws -> CommandCodeAPIKey?
+    func metadata() throws -> CommandCodeKeyMetadata
+    func save(apiKey: String) throws
+    func delete() throws
+}
+
+public extension CommandCodeAPIKeyStoring {
+    func metadata() throws -> CommandCodeKeyMetadata {
+        CommandCodeKeyMetadata(configured: try read() != nil)
+    }
+}
+
+/// A single Keychain item atomically binds the key and its revision. No UserDefaults or file fallback.
+public struct CommandCodeKeychainStore: CommandCodeAPIKeyStoring {
+    public init() {}
+    #if canImport(Security)
+    private var query: [String: Any] {
+        [kSecClass as String: kSecClassGenericPassword,
+         kSecAttrService as String: "com.agent-speed.subscription.commandcode",
+         kSecAttrAccount as String: "api-key",
+         kSecAttrSynchronizable as String: false]
+    }
+    public func read() throws -> CommandCodeAPIKey? {
+        var lookup = query
+        lookup[kSecReturnData as String] = true
+        lookup[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(lookup as CFDictionary, &result)
+        if status == errSecItemNotFound { return nil }
+        guard status == errSecSuccess, let data = result as? Data,
+              let key = try? JSONDecoder().decode(CommandCodeAPIKey.self, from: data),
+              CommandCodeAPIKey.isValid(key.apiKey), CommandCodeAPIKey.isValidRevision(key.revision) else {
+            throw CommandCodeKeyStoreError.storageError
+        }
+        return key
+    }
+    /// Presence is read from item attributes, so the secret is never decrypted for Settings.
+    public func metadata() throws -> CommandCodeKeyMetadata {
+        var lookup = query
+        lookup[kSecReturnAttributes as String] = true
+        lookup[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(lookup as CFDictionary, &result)
+        if status == errSecItemNotFound { return CommandCodeKeyMetadata(configured: false) }
+        guard status == errSecSuccess else { throw CommandCodeKeyStoreError.storageError }
+        return CommandCodeKeyMetadata(configured: true)
+    }
+    public func save(apiKey: String) throws {
+        let value = try CommandCodeAPIKey(apiKey: apiKey, revision: CommandCodeAPIKey.randomRevision())
+        let data = try JSONEncoder().encode(value)
+        let status = SecItemUpdate(query as CFDictionary, [kSecValueData as String: data] as CFDictionary)
+        if status == errSecSuccess { return }
+        guard status == errSecItemNotFound else { throw CommandCodeKeyStoreError.storageError }
+        var item = query
+        item[kSecValueData as String] = data
+        item[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        guard SecItemAdd(item as CFDictionary, nil) == errSecSuccess else { throw CommandCodeKeyStoreError.storageError }
+    }
+    public func delete() throws {
+        let status = SecItemDelete(query as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else { throw CommandCodeKeyStoreError.storageError }
+    }
+    #else
+    public func read() throws -> CommandCodeAPIKey? { throw CommandCodeKeyStoreError.storageError }
+    public func save(apiKey: String) throws { throw CommandCodeKeyStoreError.storageError }
+    public func delete() throws { throw CommandCodeKeyStoreError.storageError }
+    #endif
+}
+
+/// Explicit dependency for OAuth-only portable fixtures; production always uses Keychain.
+struct AbsentCommandCodeAPIKeyStore: CommandCodeAPIKeyStoring {
+    func read() -> CommandCodeAPIKey? { nil }
+    func save(apiKey: String) throws { throw CommandCodeKeyStoreError.storageError }
+    func delete() throws { throw CommandCodeKeyStoreError.storageError }
+}
diff --git a/macos/Sources/AgentSpeedCore/CommandCodeCredentials.swift b/macos/Sources/AgentSpeedCore/CommandCodeCredentials.swift
new file mode 100644
index 00000000..6d73bd88
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CommandCodeCredentials.swift
@@ -0,0 +1,52 @@
+import Foundation
+#if canImport(CryptoKit)
+import CryptoKit
+#else
+import Crypto
+#endif
+
+// Command Code CLI owns sign-in and key rotation. This reader never writes or refreshes credentials.
+struct CommandCodeCredentials: Sendable {
+    static let environmentKey = "COMMAND_CODE_API_KEY"
+
+    let token: String
+    let identity: String
+
+    /// A key saved by AgentSpeed. The per-save revision keeps its schedules and
+    /// observations separate, so re-saving the same key restarts from a clean state.
+    static func apiKey(_ key: CommandCodeAPIKey) -> CommandCodeCredentials {
+        CommandCodeCredentials(token: key.apiKey,
+                               identity: digest("agent-speed\u{0}" + key.revision + "\u{0}" + digest(key.apiKey)))
+    }
+
+    static func authURL(home: URL = FileManager.default.homeDirectoryForCurrentUser) -> URL {
+        home.appendingPathComponent(".commandcode/auth.json")
+    }
+
+    /// Environment keys take precedence only when the trimmed value is nonempty.
+    static func load(environment: [String: String], authURL: URL) -> CommandCodeCredentials? {
+        if let token = nonEmpty(environment[environmentKey]) {
+            return CommandCodeCredentials(token: token, identity: digest(token))
+        }
+        return load(from: authURL)
+    }
+
+    static func load(from url: URL) -> CommandCodeCredentials? {
+        guard let data = try? Data(contentsOf: url),
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let token = nonEmpty(root["apiKey"] as? String) else { return nil }
+        return CommandCodeCredentials(token: token, identity: digest(token))
+    }
+
+    private static func nonEmpty(_ value: String?) -> String? {
+        guard let value else { return nil }
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty,
+              !trimmed.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 }) else { return nil }
+        return trimmed
+    }
+
+    private static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/CommandCodeQuotaProvider.swift b/macos/Sources/AgentSpeedCore/CommandCodeQuotaProvider.swift
new file mode 100644
index 00000000..36b5bbe4
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CommandCodeQuotaProvider.swift
@@ -0,0 +1,357 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+// Polling, schedule persistence and cancellation follow the Codenotch Kimi provider pattern.
+// Copyright (c) 2026 Vinz, MIT. Full notice: Resources/Codenotch-LICENSE.txt.
+public actor CommandCodeQuotaProvider: QuotaProvider {
+    public nonisolated let id = "commandcode"
+    public static let signInReason = "Command Code credentials not found. Sign in with the Command Code CLI or set COMMAND_CODE_API_KEY."
+    public static let rejectedReason = "Command Code credentials were rejected. Sign in again or set a new COMMAND_CODE_API_KEY."
+    public static let noSubscriptionReason = "No Command Code subscription or credit data on this account."
+    public static let apiKeyReason = "Command Code API key unavailable or rejected. Check the saved API key in Settings."
+    static let source = CommandCodeUsage.source
+    typealias Transport = @Sendable (URLRequest) async throws -> (Data, HTTPURLResponse)
+
+    private struct Schedule: Codable {
+        var next: Date?
+        var failures = 0
+        var coldFailures: Int?
+        var rejected = false
+        var status: QuotaStatus?
+        var observation: QuotaPersistedObservation?
+        /// Persisted snapshots are account-scoped without a label; the safe whoami
+        /// label is kept beside them so a restart still names the account.
+        var accountLabel: String?
+    }
+
+    private let environment: [String: String]
+    private let authURL: URL
+    private let keyStore: any CommandCodeAPIKeyStoring
+    private let now: @Sendable () -> Date
+    private let transport: Transport
+    private let persistence: QuotaPersistence
+    private var schedules: [String: Schedule] = [:]
+    private var cached: [String: QuotaSnapshot] = [:]
+    private var inFlight: Task<QuotaSnapshot, Never>?
+    private var generation = 0
+
+    public init(keyStore: any CommandCodeAPIKeyStoring = CommandCodeKeychainStore()) {
+        self.keyStore = keyStore
+        environment = ProcessInfo.processInfo.environment
+        authURL = CommandCodeCredentials.authURL(home: FileManager.default.homeDirectoryForCurrentUser)
+        now = { Date() }
+        transport = Self.request
+        persistence = QuotaPersistence(directory: QuotaPersistence.directory.appendingPathComponent("commandcode"))
+    }
+
+    init(environment: [String: String] = [:], authURL: URL, cacheDirectory: URL,
+         keyStore: any CommandCodeAPIKeyStoring = AbsentCommandCodeAPIKeyStore(),
+         now: @escaping @Sendable () -> Date, transport: @escaping Transport) {
+        self.environment = environment
+        self.authURL = authURL
+        self.keyStore = keyStore
+        self.now = now
+        self.transport = transport
+        persistence = QuotaPersistence(directory: cacheDirectory)
+    }
+
+    public func readCachedSnapshot() -> QuotaSnapshot {
+        let resolved = credentials()
+        guard let credential = resolved.value else { return snapshot(.needsAuth, reason: authReason(resolved)) }
+        let schedule = load(credential.identity)
+        if schedule.rejected { return snapshot(.needsAuth, reason: rejectionReason(resolved)) }
+        if schedule.status == .unsupported {
+            return snapshot(.unsupported, next: schedule.next, reason: Self.noSubscriptionReason)
+        }
+        return stale(credential.identity, next: schedule.next)
+    }
+
+    public func refreshStartup() async -> QuotaSnapshot { await refresh() }
+
+    public func refresh() async -> QuotaSnapshot {
+        if let inFlight { return await inFlight.value }
+        let current = generation
+        let task = Task { await self.performRefresh() }
+        inFlight = task
+        let result = await task.value
+        if current == generation { inFlight = nil }
+        return result
+    }
+
+    public func cancel() {
+        generation += 1
+        inFlight?.cancel()
+        inFlight = nil
+    }
+
+    /// Drop every observation and schedule when a caller rotates the borrowed credential.
+    public func credentialsChanged() {
+        cancel()
+        schedules.removeAll()
+        cached.removeAll()
+        persistence.removeAll()
+    }
+
+    /// AgentSpeed's stored key wins; a present but unreadable item is a credential
+    /// error rather than permission to borrow the CLI login.
+    private func credentials() -> (value: CommandCodeCredentials?, keyConfigured: Bool) {
+        do {
+            if let key = try keyStore.read() {
+                return (CommandCodeAPIKey.isValid(key.apiKey) ? CommandCodeCredentials.apiKey(key) : nil, true)
+            }
+        } catch { return (nil, true) }
+        return (CommandCodeCredentials.load(environment: environment, authURL: authURL), false)
+    }
+
+    private func authReason(_ resolved: (value: CommandCodeCredentials?, keyConfigured: Bool)) -> String {
+        resolved.keyConfigured ? Self.apiKeyReason : Self.signInReason
+    }
+
+    private func rejectionReason(_ resolved: (value: CommandCodeCredentials?, keyConfigured: Bool)) -> String {
+        resolved.keyConfigured ? Self.apiKeyReason : Self.rejectedReason
+    }
+
+    private func isCurrent(_ credential: CommandCodeCredentials, generation expected: Int) -> Bool {
+        guard generation == expected, !Task.isCancelled, let current = credentials().value else { return false }
+        return current.identity == credential.identity
+    }
+
+    private func load(_ identity: String) -> Schedule {
+        let schedule = schedules[identity] ?? persistence.load(Schedule.self, key: identity) ?? Schedule()
+        schedules[identity] = schedule
+        if cached[identity] == nil,
+           let observation = schedule.observation?.validated(accountKey: identity, id: id, source: Self.source) {
+            cached[identity] = Self.labelled(observation.copying(status: .stale, next: schedule.next, configured: true),
+                                             account: schedule.accountLabel)
+        }
+        return schedule
+    }
+
+    private func performRefresh() async -> QuotaSnapshot {
+        guard !Task.isCancelled else { return readCachedSnapshot() }
+        let expected = generation
+        let resolved = credentials()
+        guard let credential = resolved.value else { return snapshot(.needsAuth, reason: authReason(resolved)) }
+        let identity = credential.identity
+        var schedule = load(identity)
+        if schedule.rejected { return snapshot(.needsAuth, reason: rejectionReason(resolved)) }
+        if let next = schedule.next, now() < next {
+            if schedule.status == .unsupported {
+                return snapshot(.unsupported, next: next, reason: Self.noSubscriptionReason)
+            }
+            return stale(identity, next: next)
+        }
+
+        var retry: TimeInterval?
+        let transport = self.transport
+        do {
+            let (whoamiData, whoamiResponse) = try await transport(Self.authorized(Self.whoamiURL, token: credential.token))
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            retry = Self.retryAfter(whoamiResponse.value(forHTTPHeaderField: "Retry-After"), now: now())
+            switch whoamiResponse.statusCode {
+            case 200...299:
+                break
+            case 401, 403:
+                return rejected(identity, schedule: &schedule)
+            case 404:
+                return unsupported(identity, schedule: &schedule)
+            case 429:
+                return failure(identity, schedule: &schedule, retryAfter: retry, rateLimited: true)
+            default:
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+            guard let account = CommandCodeUsage.identity(whoamiData) else {
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+
+            // Both billing reads share the fixed origin and one org filter. Read them in order so
+            // a rejected or throttled first read never spends a second request.
+            let credits = try await transport(Self.authorized(Self.billingURL("credits", orgID: account.orgID),
+                                                              token: credential.token))
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            retry = Self.longer(retry, Self.retryAfter(credits.1.value(forHTTPHeaderField: "Retry-After"), now: now()))
+            switch credits.1.statusCode {
+            case 200...299:
+                break
+            case 401, 403:
+                return rejected(identity, schedule: &schedule)
+            case 404:
+                return unsupported(identity, schedule: &schedule)
+            case 429:
+                return failure(identity, schedule: &schedule, retryAfter: retry, rateLimited: true)
+            default:
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+
+            let subscription = try await transport(Self.authorized(Self.billingURL("subscriptions", orgID: account.orgID),
+                                                                   token: credential.token))
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            retry = Self.longer(retry, Self.retryAfter(subscription.1.value(forHTTPHeaderField: "Retry-After"), now: now()))
+            switch subscription.1.statusCode {
+            case 200...299:
+                break
+            case 401, 403:
+                return rejected(identity, schedule: &schedule)
+            case 404:
+                return unsupported(identity, schedule: &schedule)
+            case 429:
+                return failure(identity, schedule: &schedule, retryAfter: retry, rateLimited: true)
+            default:
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+
+            do {
+                let result = try CommandCodeUsage.parse(whoami: whoamiData, credits: credits.0,
+                                                        subscription: subscription.0, at: now())
+                guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+                guard result.status != .unsupported else {
+                    return unsupported(identity, schedule: &schedule)
+                }
+                schedule = Schedule(observation: QuotaPersistedObservation(accountKey: identity,
+                                                                           snapshot: Self.unlabelled(result)),
+                                    accountLabel: result.account)
+                save(schedule, key: identity)
+                cached[identity] = result
+                // No successful manual-read floor. Automatic refresh uses the app's cadence.
+                return result
+            } catch CommandCodeUsage.ParseError.noData {
+                guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+                return unsupported(identity, schedule: &schedule)
+            } catch {
+                guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+        } catch {
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            return failure(identity, schedule: &schedule, retryAfter: retry)
+        }
+    }
+
+    private func rejected(_ identity: String, schedule: inout Schedule) -> QuotaSnapshot {
+        schedule = Schedule(rejected: true)
+        save(schedule, key: identity)
+        cached.removeValue(forKey: identity)
+        return snapshot(.needsAuth, reason: rejectionReason(credentials()))
+    }
+
+    private func unsupported(_ identity: String, schedule: inout Schedule) -> QuotaSnapshot {
+        schedule = Schedule(next: now().addingTimeInterval(300), status: .unsupported)
+        save(schedule, key: identity)
+        cached.removeValue(forKey: identity)
+        return snapshot(.unsupported, next: schedule.next, reason: Self.noSubscriptionReason)
+    }
+
+    private func failure(_ identity: String, schedule: inout Schedule, retryAfter: TimeInterval? = nil,
+                         rateLimited: Bool = false) -> QuotaSnapshot {
+        let cold = schedule.observation?.validated(accountKey: identity, id: id, source: Self.source) == nil
+        let wait: TimeInterval
+        if cold && !rateLimited {
+            let attempt = min((schedule.coldFailures ?? 0) + 1, 4)
+            schedule.coldFailures = attempt
+            wait = max(min(30, 5 * pow(2, Double(attempt - 1))), retryAfter ?? 0)
+        } else {
+            wait = OpenCodeGoQuotaProvider.backoff(attempt: schedule.failures, retryAfter: retryAfter)
+        }
+        schedule.failures = min(schedule.failures + 1, 5)
+        schedule.next = now().addingTimeInterval(wait)
+        schedule.status = .error
+        save(schedule, key: identity)
+        return stale(identity, next: schedule.next)
+    }
+
+    private func stale(_ identity: String, next: Date?) -> QuotaSnapshot {
+        guard let value = cached[identity], value.observedAt != nil else { return snapshot(.error, next: next) }
+        return value.copying(status: .stale, next: next, configured: true)
+    }
+
+    private func save(_ schedule: Schedule, key: String) {
+        schedules[key] = schedule
+        persistence.save(schedule, key: key)
+    }
+
+    private static func labelled(_ value: QuotaSnapshot, account: String?) -> QuotaSnapshot {
+        guard let account, value.account == nil else { return value }
+        return QuotaSnapshot(id: value.id, displayName: value.displayName, fidelity: value.fidelity,
+                             status: value.status, windows: value.windows, headlineId: value.headlineId,
+                             block: value.block, account: account, plan: value.plan, observedAt: value.observedAt,
+                             source: value.source, credits: value.credits, nextAllowedAt: value.nextAllowedAt,
+                             waitingForRefresh: value.waitingForRefresh,
+                             resetCreditsAvailable: value.resetCreditsAvailable,
+                             resetCreditsNextExpiry: value.resetCreditsNextExpiry,
+                             accountIdentity: value.accountIdentity, configured: value.configured)
+    }
+
+    private static func unlabelled(_ value: QuotaSnapshot) -> QuotaSnapshot {
+        QuotaSnapshot(id: value.id, displayName: value.displayName, fidelity: value.fidelity,
+                      status: value.status, windows: value.windows, headlineId: value.headlineId,
+                      block: value.block, account: nil, plan: value.plan, observedAt: value.observedAt,
+                      source: value.source, credits: value.credits, nextAllowedAt: value.nextAllowedAt,
+                      waitingForRefresh: value.waitingForRefresh,
+                      resetCreditsAvailable: value.resetCreditsAvailable,
+                      resetCreditsNextExpiry: value.resetCreditsNextExpiry,
+                      accountIdentity: value.accountIdentity, configured: value.configured)
+    }
+
+    private func snapshot(_ status: QuotaStatus, next: Date? = nil, reason: String? = nil) -> QuotaSnapshot {
+        let resolved = credentials()
+        return QuotaSnapshot(id: id, displayName: "Command Code", fidelity: "official", status: status,
+                      windows: [], headlineId: nil, block: reason, account: nil, plan: nil,
+                      observedAt: nil, source: Self.source, credits: nil, nextAllowedAt: next,
+                      waitingForRefresh: false, configured: resolved.value != nil || resolved.keyConfigured)
+    }
+
+    private static var whoamiURL: URL {
+        url("alpha/whoami", query: [URLQueryItem(name: "limits", value: "1")])
+    }
+
+    private static func billingURL(_ resource: String, orgID: String?) -> URL {
+        url("alpha/billing/" + resource,
+            query: orgID.map { [URLQueryItem(name: "orgId", value: $0)] } ?? [])
+    }
+
+    private static func url(_ path: String, query: [URLQueryItem]) -> URL {
+        var components = URLComponents(url: CommandCodeUsage.origin.appendingPathComponent(path),
+                                       resolvingAgainstBaseURL: false)!
+        components.queryItems = query.isEmpty ? nil : query
+        return components.url!
+    }
+
+    private static func authorized(_ url: URL, token: String) -> URLRequest {
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+
+    private static func retryAfter(_ value: String?, now: Date) -> TimeInterval? {
+        OpenCodeGoQuotaProvider.retryAfter(value, now: now)
+    }
+
+    private static func longer(_ lhs: TimeInterval?, _ rhs: TimeInterval?) -> TimeInterval? {
+        switch (lhs, rhs) {
+        case let (lhs?, rhs?): return max(lhs, rhs)
+        case let (lhs?, nil): return lhs
+        case let (nil, rhs?): return rhs
+        case (nil, nil): return nil
+        }
+    }
+
+    private final class NoRedirect: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+        func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                        newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+            completionHandler(nil)
+        }
+    }
+
+    private static func request(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {
+        let session = URLSession(configuration: .ephemeral, delegate: NoRedirect(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let (data, response) = try await session.data(for: request)
+        guard let response = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        return (data, response)
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/CommandCodeUsage.swift b/macos/Sources/AgentSpeedCore/CommandCodeUsage.swift
new file mode 100644
index 00000000..9e451023
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CommandCodeUsage.swift
@@ -0,0 +1,255 @@
+import Foundation
+import CoreFoundation
+
+/// Read-only mapping for Command Code's whoami, credits and subscription payloads.
+enum CommandCodeUsage {
+    static let origin = URL(string: "https://api.commandcode.ai")!
+    static let source = "command-code · local credentials"
+
+    enum ParseError: Error { case noData }
+
+    struct Identity: Sendable, Equatable {
+        let orgID: String?
+        let account: String?
+    }
+
+    static func identity(_ data: Data) -> Identity? {
+        guard let root = try? object(data) else { return nil }
+        let org = root["org"] as? [String: Any]
+        let user = root["user"] as? [String: Any]
+        return Identity(orgID: identifier(org?["id"]),
+                        account: safeLabel(org?["login"] as? String) ?? safeLabel(user?["userName"] as? String))
+    }
+
+    static func parse(whoami: Data, credits: Data, subscription: Data, at time: Date) throws -> QuotaSnapshot {
+        _ = try object(whoami)
+        let whoamiIdentity = identity(whoami) ?? Identity(orgID: nil, account: nil)
+
+        let creditsRoot = try object(credits)
+        let creditsEnvelope = creditsRoot["data"] as? [String: Any]
+        let credit = creditsEnvelope?["credits"] as? [String: Any]
+            ?? creditsRoot["credits"] as? [String: Any]
+            ?? creditsEnvelope
+            ?? creditsRoot
+        // Billing revisions move fields between the credits object, the data
+        // envelope and the root: fall back per field, as the other readers do.
+        let monthlyCredits = number(credit["monthlyCredits"])
+            ?? number(creditsEnvelope?["monthlyCredits"]) ?? number(creditsRoot["monthlyCredits"])
+        let granted = number(credit["monthlyCreditsGranted"])
+            ?? number(creditsEnvelope?["monthlyCreditsGranted"]) ?? number(creditsRoot["monthlyCreditsGranted"])
+        let purchased = number(credit["purchasedCredits"])
+            ?? number(creditsEnvelope?["purchasedCredits"]) ?? number(creditsRoot["purchasedCredits"])
+        let free = number(credit["freeCredits"])
+            ?? number(creditsEnvelope?["freeCredits"]) ?? number(creditsRoot["freeCredits"])
+        let creditPlan = safeLabel(credit["planId"] as? String)
+            ?? safeLabel(creditsEnvelope?["planId"] as? String) ?? safeLabel(creditsRoot["planId"] as? String)
+        let limits = (creditsRoot["windowLimits"] as? [String: Any])
+            ?? (credit["windowLimits"] as? [String: Any])
+            ?? (creditsEnvelope?["windowLimits"] as? [String: Any])
+            ?? [:]
+
+        let subscriptionRoot = try object(subscription)
+        let subscriptionValue = subscriptionRoot["data"] as? [String: Any] ?? subscriptionRoot
+        let subscriptionPlan = safeLabel(subscriptionValue["planId"] as? String)
+        let periodStart = date(subscriptionValue["currentPeriodStart"])
+        let periodEnd = date(subscriptionValue["currentPeriodEnd"])
+        let plan = subscriptionPlan ?? creditPlan
+        let grant = granted ?? allowance(for: subscriptionPlan) ?? allowance(for: creditPlan)
+
+        var windows: [QuotaWindow] = []
+        if let grant, grant > 0, let monthlyCredits {
+            let duration = periodStart.flatMap { start in
+                periodEnd.flatMap { end in end > start ? end.timeIntervalSince(start) : nil }
+            }
+            windows.append(QuotaWindow(id: "monthly", label: "Monthly limit",
+                                       usedFraction: (grant - monthlyCredits) / grant,
+                                       remaining: monthlyCredits / grant,
+                                       used: (grant - monthlyCredits) / grant,
+                                       resetAt: periodEnd, duration: duration))
+        }
+        if let weekly = rolling(limits["weekly"], id: "weekly", label: "Weekly limit", duration: 604_800) {
+            windows.append(weekly)
+        }
+        if let fiveHour = rolling(limits["fiveHour"], id: "fiveHour", label: "5h limit", duration: 18_000) {
+            windows.append(fiveHour)
+        }
+
+        // Included monthly credits are a window, not a credit balance. Only the
+        // separate purchased/free pools become Credits, so monthly-only accounts
+        // never grow a redundant "Credits: Yes" footer.
+        let extrasPresent = purchased != nil || free != nil
+        let extraCredits = (purchased ?? 0) + (free ?? 0)
+        let creditsValue = extrasPresent
+            ? QuotaCredits(hasCredits: (monthlyCredits ?? 0) + extraCredits > 0, unlimited: false,
+                           limit: nil, used: nil, usedFraction: nil, resetAt: nil,
+                           balance: decimalString(extraCredits))
+            : nil
+        guard !windows.isEmpty || creditsValue != nil else {
+            return QuotaSnapshot(id: "commandcode", displayName: "Command Code", fidelity: "official",
+                                 status: .unsupported, windows: [], headlineId: nil, block: nil,
+                                 account: whoamiIdentity.account, plan: plan.map(planName), observedAt: nil,
+                                 source: source, credits: nil, nextAllowedAt: nil,
+                                 waitingForRefresh: false, configured: true)
+        }
+
+        let headline: String?
+        if windows.contains(where: { $0.id == "monthly" }) { headline = "monthly" }
+        else if windows.contains(where: { $0.id == "fiveHour" }) { headline = "fiveHour" }
+        else if windows.contains(where: { $0.id == "weekly" }) { headline = "weekly" }
+        else { headline = nil }
+
+        return QuotaSnapshot(id: "commandcode", displayName: "Command Code", fidelity: "official",
+                             status: .ok, windows: windows, headlineId: headline, block: nil,
+                             account: whoamiIdentity.account, plan: plan.map(planName), observedAt: time,
+                             source: source, credits: creditsValue, nextAllowedAt: nil,
+                             waitingForRefresh: false, configured: true)
+    }
+
+    static func parse(whoami: Data, credits: Data, subscriptions: Data, at time: Date) throws -> QuotaSnapshot {
+        try parse(whoami: whoami, credits: credits, subscription: subscriptions, at: time)
+    }
+
+    /// Plan ids arrive prefixed per tier (`individual-go`, `individual-max-10x`,
+    /// `team-pro`, ...), so compare the normalized tier rather than the whole string.
+    static func allowance(for plan: String?) -> Double? {
+        switch planKind(plan) {
+        case .go: return 10
+        case .goat: return 100
+        case .pro: return 110
+        case .provider: return 15
+        case .max10x: return 150
+        case .max20x: return 300
+        case .teamPro: return 40
+        // `individual-ultra` has no published included-credit grant: omit the
+        // monthly percentage instead of inventing an allowance.
+        case .ultra, nil: return nil
+        }
+    }
+
+    private enum PlanKind {
+        case go, goat, pro, provider, max10x, max20x, ultra, teamPro
+    }
+
+    private static func planKind(_ plan: String?) -> PlanKind? {
+        switch tier(plan) {
+        case "go": return .go
+        case "goat": return .goat
+        case "pro": return .pro
+        case "provider": return .provider
+        case "max-10x": return .max10x
+        case "max-20x": return .max20x
+        case "ultra": return .ultra
+        case "team-pro": return .teamPro
+        default: return nil
+        }
+    }
+
+    /// Command Code scopes consumer tiers under `individual-` and may append a
+    /// version suffix (`individual-pro-v2`); compare the tier itself.
+    private static func tier(_ plan: String?) -> String {
+        var key = normalized(plan)
+        if key.hasPrefix("individual-") { key = String(key.dropFirst("individual-".count)) }
+        if let range = key.range(of: "-v[0-9]+$", options: .regularExpression) {
+            key = String(key[..<range.lowerBound])
+        }
+        return key
+    }
+
+    private static func rolling(_ entry: Any?, id: String, label: String, duration: TimeInterval) -> QuotaWindow? {
+        guard let entry = entry as? [String: Any], let used = number(entry["used"]),
+              let cap = number(entry["cap"]), cap > 0 else { return nil }
+        let milliseconds = number(entry["resetAt"]).flatMap { $0 > 0 ? $0 : nil }
+        let reset = milliseconds.map { Date(timeIntervalSince1970: $0 / 1_000) }
+        return QuotaWindow(id: id, label: label, usedFraction: used / cap,
+                           remaining: 1 - used / cap, used: used / cap, resetAt: reset, duration: duration)
+    }
+
+    private static func planName(_ value: String) -> String {
+        switch planKind(value) {
+        case .go: return "Go"
+        case .goat: return "GOAT"
+        case .pro: return "Pro"
+        case .provider: return "Provider"
+        case .max10x: return "Max 10x"
+        case .max20x: return "Max 20x"
+        case .ultra: return "Ultra"
+        case .teamPro: return "Team Pro"
+        case nil: return value
+        }
+    }
+
+    /// Collapses separators into single dashes so ids such as `Max 10X` and `max-10x` agree.
+    private static func normalized(_ value: String?) -> String {
+        guard let value else { return "" }
+        var result = ""
+        var dashed = false
+        for character in value.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() {
+            if character.isLetter || character.isNumber {
+                result.append(character)
+                dashed = false
+            } else if (character == "-" || character == "_" || character == " "), !dashed, !result.isEmpty {
+                result.append("-")
+                dashed = true
+            }
+        }
+        if result.hasSuffix("-") { result.removeLast() }
+        return result
+    }
+
+    private static func object(_ data: Data) throws -> [String: Any] {
+        guard let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw URLError(.cannotParseResponse)
+        }
+        return root
+    }
+
+    private static func identifier(_ raw: Any?) -> String? {
+        let text: String?
+        if let value = raw as? String { text = value }
+        else if let value = raw as? NSNumber {
+            text = CFGetTypeID(value) == CFBooleanGetTypeID() ? nil : value.stringValue
+        } else { text = nil }
+        guard let text else { return nil }
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty, !trimmed.contains("\r"), !trimmed.contains("\n") else { return nil }
+        return trimmed
+    }
+
+    private static func safeLabel(_ raw: String?) -> String? {
+        guard let raw else { return nil }
+        let trimmed = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty, !trimmed.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 }) else { return nil }
+        return String(trimmed.prefix(120))
+    }
+
+    private static func date(_ raw: Any?) -> Date? {
+        guard let value = raw as? String else { return nil }
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let plain = ISO8601DateFormatter()
+        return fractional.date(from: value) ?? plain.date(from: value)
+    }
+
+    private static func number(_ raw: Any?) -> Double? {
+        let value: Double?
+        if let number = raw as? NSNumber {
+            guard CFGetTypeID(number) != CFBooleanGetTypeID() else { return nil }
+            value = number.doubleValue
+        } else if let text = raw as? String {
+            value = Double(text)
+        } else {
+            value = nil
+        }
+        return value.flatMap { $0.isFinite ? $0 : nil }
+    }
+
+    private static func decimalString(_ value: Double) -> String {
+        guard value.isFinite else { return "0" }
+        let formatter = NumberFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.numberStyle = .decimal
+        formatter.usesGroupingSeparator = false
+        formatter.maximumFractionDigits = 8
+        return formatter.string(from: NSNumber(value: value)) ?? String(value)
+    }
+}
