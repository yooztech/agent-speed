@@ -0,0 +1,141 @@
+import Foundation
+import Testing
+@testable import AgentSpeed
+import AgentSpeedCore
+
+@MainActor
+private final class CommandCodeChannel {
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let transport: RemoteQuotaTransport
+    let host = RemoteHost(label: "Linux", destination: "user@host", enabled: true)
+    let connection = UUID()
+    let commands: AsyncStream<Data>
+    private let events: AsyncStream<Data>.Continuation
+    init() {
+        defaults = UserDefaults(suiteName: suite)!
+        transport = RemoteQuotaTransport(defaults: defaults)
+        let stream = AsyncStream<Data>.makeStream(); commands = stream.stream; events = stream.continuation
+        transport.configure(hosts: [host], connections: [host.id: connection])
+        transport.send = { [events] _, data in events.yield(data); return true }
+    }
+    func clean() { events.finish(); defaults.removePersistentDomain(forName: suite) }
+    func response(_ id: String, configured: Bool) throws -> CommandCodeCredentialResponse {
+        let root: [String: Any] = ["type": "commandcode_credentials_result", "requestId": id,
+                                   "status": "ok", "configured": configured]
+        return try #require(CommandCodeCredentialResponse.decode(JSONSerialization.data(withJSONObject: root)))
+    }
+}
+
+@Suite("Command Code remote credential protocol")
+@MainActor
+struct CommandCodeCredentialTransportTests {
+    @Test func validatesPresenceOnlyResponsesAndRejectsSecretsOrUnknownFields() throws {
+        let valid = #"{"type":"commandcode_credentials_result","requestId":"safe_ID-1","status":"ok","configured":true}"#
+        #expect(CommandCodeCredentialResponse.decode(Data(valid.utf8))?.configured == true)
+        let absent = #"{"type":"commandcode_credentials_result","requestId":"safe_ID-1","status":"ok","configured":false}"#
+        #expect(CommandCodeCredentialResponse.decode(Data(absent.utf8))?.configured == false)
+        for json in [
+            #"{"type":"commandcode_credentials_result","requestId":"unsafe id","status":"ok","configured":false}"#,
+            #"{"type":"commandcode_credentials_result","requestId":"x","status":"ok"}"#,
+            #"{"type":"commandcode_credentials_result","requestId":"x","status":"ok","configured":true,"apiKey":"never-accept"}"#,
+            #"{"type":"commandcode_credentials_result","requestId":"x","status":"ok","configured":true,"region":"china"}"#,
+            #"{"type":"commandcode_credentials_result","requestId":"x","status":"error","errorCode":"raw_exception"}"#,
+            #"{"type":"commandcode_credentials_result","requestId":"x","status":"error","errorCode":"storage_error","configured":true}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"ok","configured":true}"#
+        ] { #expect(CommandCodeCredentialResponse.decode(Data(json.utf8)) == nil) }
+        #expect(CommandCodeCredentialResponse.decode(Data(#"{"type":"commandcode_credentials_result","requestId":"x","status":"error","errorCode":"storage_error"}"#.utf8))?.errorCode == "storage_error")
+    }
+
+    @Test func sendsExactCommandsAndCorrelatesHostConnectionAndSubscriber() async throws {
+        let channel = CommandCodeChannel(); defer { channel.clean() }
+        var commands = channel.commands.makeAsyncIterator()
+        for operation in [CommandCodeCredentialOperation.get, .set, .delete] {
+            let pending = Task {
+                await channel.transport.commandCodeCredentials(hostID: channel.host.id, operation: operation,
+                                                               apiKey: operation == .set ? "transient-secret" : nil)
+            }
+            let bytes = try #require(await commands.next())
+            #expect(bytes.last == 10 && bytes.count <= 16_384)
+            let root = try #require(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
+            #expect(root["type"] as? String == "commandcode_credentials")
+            #expect(root["operation"] as? String == operation.rawValue)
+            #expect(Set(root.keys) == (operation == .set ? ["type", "requestId", "operation", "apiKey"]
+                                                        : ["type", "requestId", "operation"]))
+            let id = try #require(root["requestId"] as? String)
+            let response = try channel.response(id, configured: operation != .delete)
+            channel.transport.receiveCommandCodeCredentials(response, hostID: UUID(), connection: channel.connection)
+            channel.transport.receiveCommandCodeCredentials(response, hostID: channel.host.id, connection: UUID())
+            channel.transport.receiveCommandCodeCredentials(response, hostID: channel.host.id, connection: channel.connection)
+            let value = try (await pending.value).get()
+            #expect(value.configured == (operation != .delete))
+            #expect(!channel.defaults.dictionaryRepresentation().description.contains("transient-secret"))
+        }
+    }
+
+    @Test func unexpectedPresenceForSetOrDeleteIsAStorageError() async throws {
+        let channel = CommandCodeChannel(); defer { channel.clean() }
+        var commands = channel.commands.makeAsyncIterator()
+        for operation in [CommandCodeCredentialOperation.set, .delete] {
+            let pending = Task {
+                await channel.transport.commandCodeCredentials(hostID: channel.host.id, operation: operation,
+                                                               apiKey: operation == .set ? "secret" : nil)
+            }
+            let bytes = try #require(await commands.next())
+            let root = try #require(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
+            let id = try #require(root["requestId"] as? String)
+            channel.transport.receiveCommandCodeCredentials(try channel.response(id, configured: operation == .delete),
+                                                            hostID: channel.host.id, connection: channel.connection)
+            if case .failure(.storageError) = await pending.value {} else {
+                Issue.record("Contradictory presence reported success")
+            }
+        }
+        if case .failure(.invalidRequest) = await channel.transport.commandCodeCredentials(
+            hostID: channel.host.id, operation: .get, apiKey: "must-not-send") {} else {
+            Issue.record("A read accepted a key")
+        }
+        if case .failure(.invalidRequest) = await channel.transport.commandCodeCredentials(
+            hostID: channel.host.id, operation: .set, apiKey: "not a key") {} else {
+            Issue.record("An invalid key was sent")
+        }
+    }
+
+    @Test func disconnectDestinationChangeCancellationAndTimeoutNeverReportSaved() async throws {
+        for reason in ["disconnect", "destination", "cancel", "timeout"] {
+            let channel = CommandCodeChannel(); defer { channel.clean() }
+            var commands = channel.commands.makeAsyncIterator()
+            let pending = Task {
+                await channel.transport.commandCodeCredentials(hostID: channel.host.id, operation: .set, apiKey: "secret")
+            }
+            let bytes = try #require(await commands.next())
+            let root = try #require(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
+            let id = try #require(root["requestId"] as? String)
+            if reason == "disconnect" { channel.transport.configure(hosts: [channel.host], connections: [:]) }
+            if reason == "destination" {
+                var changed = channel.host; changed.destination = "other@host"
+                channel.transport.configure(hosts: [changed], connections: [changed.id: UUID()])
+            }
+            if reason == "cancel" { pending.cancel() }
+            if reason == "timeout" { channel.transport.expireCommandCodeCredentials(id) }
+            let result = await pending.value
+            guard case .failure(let error) = result else { Issue.record("Unconfirmed command reported success"); continue }
+            #expect(error == (reason == "timeout" ? .unsupported : reason == "cancel" ? .cancelled : .disconnected))
+            // A late reply cannot resurrect a cancelled subscriber or change persisted quota.
+            channel.transport.receiveCommandCodeCredentials(try channel.response(id, configured: true),
+                                                            hostID: channel.host.id, connection: channel.connection)
+            #expect(!channel.defaults.dictionaryRepresentation().description.contains("secret"))
+        }
+    }
+
+    @Test func disconnectedHostIsListedWithoutStartingConnectionOrSendingCommands() async throws {
+        let channel = CommandCodeChannel(); defer { channel.clean() }
+        channel.transport.configure(hosts: [channel.host], connections: [:])
+        #expect(channel.transport.sources.contains { $0.id == QuotaSourceIdentity.remote(hostID: channel.host.id, providerID: "commandcode") })
+        #expect(channel.transport.hostID(sourceID: QuotaSourceIdentity.remote(hostID: channel.host.id, providerID: "commandcode")) == channel.host.id)
+        #expect(channel.transport.hostID(sourceID: "commandcode") == nil)
+        #expect(!channel.transport.isConnected(hostID: channel.host.id))
+        if case .failure(.disconnected) = await channel.transport.commandCodeCredentials(hostID: channel.host.id, operation: .get) {} else {
+            Issue.record("Disconnected host accepted a credential command")
+        }
+    }
+}
