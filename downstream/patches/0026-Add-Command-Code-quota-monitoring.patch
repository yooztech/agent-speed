+TEST(CollectorQuotaProvider, CommandCodeAuthUnsupportedRetryAndStaleSemantics) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    {
+        Home home; home.commandCodeAuth();
+        q::Provider provider("commandcode", home.paths(), success, [] { return now; });
+        EXPECT_EQ(provider.read(true).status, "ok");
+    }
+    {
+        Home home; home.commandCodeAuth(); auto time = now;
+        { q::Provider first("commandcode", home.paths(), success, [&] { return time; }); ASSERT_EQ(first.read(true).status, "ok"); }
+        int calls = 0;
+        q::Provider failing("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{503, "", ""}; }, [&] { return time; });
+        auto stale = failing.read(true); EXPECT_EQ(stale.status, "stale"); EXPECT_EQ(stale.observedAt, now);
+        ASSERT_TRUE(stale.nextAllowedAt); EXPECT_EQ(*stale.nextAllowedAt, time + 60000); EXPECT_EQ(calls, 1);
+    }
+    {
+        Home home; home.commandCodeAuth(); int calls = 0;
+        q::Provider rejected("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{401, "", ""}; }, [] { return now; });
+        auto denied = rejected.read(true); EXPECT_EQ(denied.status, "needsAuth");
+        EXPECT_TRUE(denied.windows.empty()); EXPECT_FALSE(denied.observedAt); ASSERT_TRUE(denied.block);
+        EXPECT_EQ(rejected.read(true).status, "needsAuth"); EXPECT_EQ(calls, 1);
+        q::Provider restored("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{401, "", ""}; }, [] { return now; });
+        EXPECT_EQ(restored.read(true).status, "needsAuth"); EXPECT_EQ(calls, 1);
+    }
+    {
+        Home home; home.commandCodeAuth(); auto time = now;
+        q::Provider limited("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{429, "", "1"}; }, [&] { return time; });
+        auto slow = limited.read(true); EXPECT_EQ(slow.status, "error"); EXPECT_FALSE(slow.observedAt);
+        ASSERT_TRUE(slow.nextAllowedAt); EXPECT_GE(*slow.nextAllowedAt, time + 60000);
+        q::Provider restored("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{429, "", "1200"}; }, [&] { return time; });
+        EXPECT_EQ(restored.read(true).nextAllowedAt, slow.nextAllowedAt);
+    }
+    {
+        Home home; home.commandCodeAuth();
+        q::Provider missing("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{404, "", ""}; }, [] { return now; });
+        auto unsupported = missing.read(true); EXPECT_EQ(unsupported.status, "unsupported");
+        EXPECT_TRUE(unsupported.windows.empty()); EXPECT_FALSE(unsupported.observedAt); ASSERT_TRUE(unsupported.block);
+    }
+    {
+        Home home; int calls = 0;
+        q::Provider absent("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+        auto value = absent.read(true); EXPECT_EQ(value.status, "needsAuth"); ASSERT_TRUE(value.block); EXPECT_EQ(calls, 0);
+    }
+}
