+            var body = Failure == "decode" ? "not json" : path switch
+            {
+                "/alpha/whoami" => Whoami,
+                "/alpha/billing/credits" => Credits,
+                _ => Subscription
+            };
+            response.Content = new StringContent(body);
+            return response;
+        }
+    }
