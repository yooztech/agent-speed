+
+    @Test func resavingTheSameKeyGetsANewRevisionAndClearsTheRejection() async throws {
+        let fixture = try CommandCodeControllerFixture(selected: true); defer { fixture.clean() }
+        try fixture.store.save(apiKey: "same-key")
