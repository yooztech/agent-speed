@@ -0,0 +1,137 @@
+import AgentSpeedCore
+import SwiftUI
+
+/// This sheet owns transient input; quota snapshots and the app's observable model never contain it.
+struct CommandCodeKeyEditor: View {
+    let quota: QuotaController
+    let l10n: Localizer
+    @Environment(\.dismiss) private var dismiss
+    @State private var sourceID = "commandcode"
+    @State private var apiKey = ""
+    @State private var metadata: CommandCodeKeyMetadata?
+    @State private var message: String?
+    @State private var busy = false
+    @State private var operation: Task<Void, Never>?
+
+    private var connected: Bool { quota.commandCodeSourceConnected(sourceID) }
+    private var destinationRevision: String {
+        sourceID + ":" + (quota.commandCodeConnections[sourceID]?.uuidString ?? "local-or-disconnected")
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            Text(l10n("mac.quota.commandCode.keyTitle")).font(.headline)
+            Form {
+                Picker(l10n("mac.quota.source"), selection: $sourceID) {
+                    ForEach(quota.commandCodeSources) { source in
+                        Text(source.id == "commandcode" ? l10n("orbs.sources.local") : source.name).tag(source.id)
+                    }
+                }
+                if sourceID != "commandcode" {
+                    Text(l10n(connected ? "mac.quota.commandCode.connected" : "mac.quota.commandCode.disconnected"))
+                        .foregroundStyle(.secondary)
+                }
+                SecureField(l10n("mac.quota.commandCode.apiKey"), text: $apiKey)
+                    .textContentType(nil)
+                    .autocorrectionDisabled()
+                    .disabled(busy || !connected)
+                if let metadata {
+                    Text(l10n(metadata.configured ? "mac.quota.commandCode.configured" : "mac.quota.commandCode.notConfigured"))
+                        .foregroundStyle(.secondary)
+                }
+            }.formStyle(.grouped)
+            Text(l10n("mac.quota.commandCode.keyHint")).font(.footnote).foregroundStyle(.secondary)
+            if let message { Text(l10n(message)).font(.footnote).textSelection(.enabled) }
+            HStack {
+                if busy { ProgressView().controlSize(.small) }
+                Button(l10n("orbs.remove.button"), role: .destructive) { remove() }
+                    .disabled(!connected || busy || metadata?.configured == false)
+                Spacer()
+                Button(l10n("history.cancel")) { close() }.keyboardShortcut(.cancelAction)
+                Button(l10n("mac.quota.commandCode.saveVerify")) { save() }
+                    .keyboardShortcut(.defaultAction)
+                    .disabled(!connected || busy || !CommandCodeAPIKey.isValid(apiKey))
+            }
+        }
+        .padding(20)
+        .frame(width: 490)
+        .task(id: destinationRevision) { await loadMetadata() }
+        .onChange(of: sourceID) { apiKey = ""; operation?.cancel() }
+        .onDisappear { apiKey = ""; operation?.cancel(); operation = nil }
+    }
+
+    private func loadMetadata() async {
+        operation?.cancel()
+        operation = nil
+        apiKey = ""
+        metadata = nil
+        message = nil
+        busy = true
+        let result = await quota.commandCodeMetadata(sourceID: sourceID)
+        guard !Task.isCancelled else { return }
+        busy = false
+        switch result {
+        case .success(let value): metadata = value
+        case .failure(let error): message = commandCodeCredentialMessage(error)
+        }
+    }
+
+    private func save() {
+        let submitted = apiKey, source = sourceID
+        apiKey = ""
+        busy = true
+        message = nil
+        operation = Task {
+            let result = await quota.saveCommandCode(sourceID: source, apiKey: submitted)
+            guard !Task.isCancelled else { return }
+            busy = false
+            switch result {
+            case .success(let outcome):
+                metadata = CommandCodeKeyMetadata(configured: true)
+                message = completeCommandCodeSave(outcome, dismiss: close)
+            case .failure(let error): message = commandCodeCredentialMessage(error)
+            }
+            operation = nil
+        }
+    }
+
+    private func remove() {
+        apiKey = ""
+        busy = true
+        message = nil
+        let source = sourceID
+        operation = Task {
+            let result = await quota.removeCommandCode(sourceID: source)
+            guard !Task.isCancelled else { return }
+            busy = false
+            switch result {
+            case .success(let value): metadata = value; message = "mac.quota.commandCode.removed"
+            case .failure(let error): message = commandCodeCredentialMessage(error)
+            }
+            operation = nil
+        }
+    }
+
+    private func close() { apiKey = ""; operation?.cancel(); operation = nil; dismiss() }
+}
+
+@MainActor
+func completeCommandCodeSave(_ outcome: QuotaController.CommandCodeSaveOutcome, dismiss: () -> Void) -> String? {
+    switch outcome {
+    case .verified:
+        dismiss()
+        return nil
+    case .savedOffline: return "mac.quota.commandCode.savedOffline"
+    case .savedVerificationFailed: return "mac.quota.commandCode.savedVerificationFailed"
+    }
+}
+
+func commandCodeCredentialMessage(_ error: CommandCodeCredentialFailure) -> String {
+    switch error {
+    case .invalidRequest: "mac.quota.commandCode.invalidKey"
+    case .storageError: "mac.quota.commandCode.storageError"
+    case .disconnected: "mac.quota.commandCode.disconnected"
+    case .unsupported: "mac.quota.commandCode.updateCollector"
+    case .cancelled: "mac.quota.commandCode.cancelled"
+    }
+}
