+    ASSERT_EQ(rootLimits.windows.size(), 1u); EXPECT_EQ(rootLimits.windows[0].usedFraction, .5);
+    EXPECT_EQ(q::parseCommandCodeProfile(R"({"org":{"id":42}})").organization, "42");
+    EXPECT_EQ(q::parseCommandCodeProfile(R"({"user":{"userName":"  bob  "}})").account, "bob");
+
+    auto over = q::parseCommandCode("{}", R"({"credits":{"monthlyCredits":120,"monthlyCreditsGranted":100}})", "{}", now);
+    ASSERT_EQ(over.windows.size(), 1u);
+    EXPECT_NEAR(*over.windows[0].usedFraction, -.2, 1e-12); EXPECT_NEAR(*over.windows[0].remaining, 1.2, 1e-12);
+    auto zero = q::parseCommandCode("{}", R"({"credits":{"monthlyCredits":0,"monthlyCreditsGranted":10}})", "{}", now);
+    ASSERT_EQ(zero.windows.size(), 1u); EXPECT_EQ(zero.windows[0].usedFraction, 1.0);
+    EXPECT_FALSE(zero.credits); EXPECT_EQ(zero.observedAt, now);
+    auto zeroExtras = q::parseCommandCode("{}", R"({"credits":{"monthlyCredits":0,"purchasedCredits":0,"freeCredits":0}})", "{}", now);
+    EXPECT_EQ(zeroExtras.status, "ok"); EXPECT_EQ(zeroExtras.observedAt, now); EXPECT_TRUE(zeroExtras.windows.empty());
+    ASSERT_TRUE(zeroExtras.credits); ASSERT_TRUE(zeroExtras.credits->hasCredits);
+    EXPECT_FALSE(*zeroExtras.credits->hasCredits); EXPECT_EQ(zeroExtras.credits->balance, "0");
+
+    auto empty = q::parseCommandCode("{}", "{}", "{}", now);
+    EXPECT_EQ(empty.status, "unsupported"); EXPECT_TRUE(empty.windows.empty()); EXPECT_FALSE(empty.observedAt);
+    ASSERT_TRUE(empty.block); EXPECT_FALSE(empty.block->empty());
+    EXPECT_THROW(q::parseCommandCode("[]", commandCodeCredits, commandCodeSubscriptions, now), std::runtime_error);
+    EXPECT_THROW(q::parseCommandCode(commandCodeWhoami, "{", commandCodeSubscriptions, now), std::runtime_error);
+    EXPECT_EQ(q::commandCodeUrl("/alpha/billing/credits"), "https://api.commandcode.ai/alpha/billing/credits");
+    EXPECT_EQ(q::commandCodeUrl("/alpha/billing/credits", "org/cc"), "https://api.commandcode.ai/alpha/billing/credits?orgId=org%2Fcc");
+    EXPECT_EQ(q::commandCodeUrl("/alpha/whoami?limits=1", "a b"), "https://api.commandcode.ai/alpha/whoami?limits=1&orgId=a%20b");
+}
+
+TEST(CollectorQuotaProvider, CommandCodeWhoamiThenOrgScopedBillingAndCache) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY");
+    unsetenv("COMMAND_CODE_API_KEY"); home.commandCodeAuth();
+    auto time = now; std::vector<std::string> urls;
+    auto transport = [&](const std::string& url, const q::Credential& c, bool reset) {
+        EXPECT_FALSE(reset); EXPECT_EQ(c.token, "synthetic-command-code");
+        urls.push_back(url); return success(url, c, reset);
+    };
+    q::Provider provider("commandcode", home.paths(), transport, [&] { return time; });
+    auto value = provider.read(true); ASSERT_EQ(value.status, "ok");
+    ASSERT_EQ(value.windows.size(), 3u); EXPECT_EQ(value.account, "acme"); EXPECT_FALSE(value.accountIdentity);
+    EXPECT_FALSE(value.nextAllowedAt);
+    ASSERT_EQ(urls.size(), 3u);
+    EXPECT_EQ(urls[0], "https://api.commandcode.ai/alpha/whoami?limits=1");
+    EXPECT_EQ(urls[1], "https://api.commandcode.ai/alpha/billing/credits?orgId=org-cc");
+    EXPECT_EQ(urls[2], "https://api.commandcode.ai/alpha/billing/subscriptions?orgId=org-cc");
+    EXPECT_TRUE(fs::exists(home.root + "/.agent-speed/quota/commandcode-" + sha256("synthetic-command-code") + ".json"));
+    for (const auto& entry : fs::directory_iterator(home.root + "/.agent-speed/quota")) {
+        std::ifstream input(entry.path()); std::string body((std::istreambuf_iterator<char>(input)), {});
+        EXPECT_EQ(body.find("synthetic-command-code"), std::string::npos);
+    }
+    q::Provider restored("commandcode", home.paths(), transport, [&] { return time; });
+    auto cached = restored.read(false); EXPECT_EQ(cached.status, "stale"); EXPECT_EQ(cached.observedAt, now);
+    EXPECT_EQ(urls.size(), 3u);
+    EXPECT_EQ(restored.read(true).status, "ok"); EXPECT_EQ(urls.size(), 6u);
+}
+
+TEST(CollectorQuotaProvider, CommandCodeAuthUnsupportedRetryAndStaleSemantics) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    {
+        Home home; home.commandCodeAuth();
+        q::Provider provider("commandcode", home.paths(), success, [] { return now; });
+        EXPECT_EQ(provider.read(true).status, "ok");
+    }
+    {
+        Home home; home.commandCodeAuth(); auto time = now;
+        { q::Provider first("commandcode", home.paths(), success, [&] { return time; }); ASSERT_EQ(first.read(true).status, "ok"); }
+        int calls = 0;
+        q::Provider failing("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{503, "", ""}; }, [&] { return time; });
+        auto stale = failing.read(true); EXPECT_EQ(stale.status, "stale"); EXPECT_EQ(stale.observedAt, now);
+        ASSERT_TRUE(stale.nextAllowedAt); EXPECT_EQ(*stale.nextAllowedAt, time + 60000); EXPECT_EQ(calls, 1);
+    }
+    {
+        Home home; home.commandCodeAuth(); int calls = 0;
+        q::Provider rejected("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{401, "", ""}; }, [] { return now; });
+        auto denied = rejected.read(true); EXPECT_EQ(denied.status, "needsAuth");
+        EXPECT_TRUE(denied.windows.empty()); EXPECT_FALSE(denied.observedAt); ASSERT_TRUE(denied.block);
+        EXPECT_EQ(rejected.read(true).status, "needsAuth"); EXPECT_EQ(calls, 1);
+        q::Provider restored("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{401, "", ""}; }, [] { return now; });
+        EXPECT_EQ(restored.read(true).status, "needsAuth"); EXPECT_EQ(calls, 1);
+    }
+    {
+        Home home; home.commandCodeAuth(); auto time = now;
+        q::Provider limited("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{429, "", "1"}; }, [&] { return time; });
+        auto slow = limited.read(true); EXPECT_EQ(slow.status, "error"); EXPECT_FALSE(slow.observedAt);
+        ASSERT_TRUE(slow.nextAllowedAt); EXPECT_GE(*slow.nextAllowedAt, time + 60000);
+        q::Provider restored("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{429, "", "1200"}; }, [&] { return time; });
+        EXPECT_EQ(restored.read(true).nextAllowedAt, slow.nextAllowedAt);
+    }
+    {
+        Home home; home.commandCodeAuth();
+        q::Provider missing("commandcode", home.paths(), [&](const auto&, const auto&, bool) { return q::HttpReply{404, "", ""}; }, [] { return now; });
+        auto unsupported = missing.read(true); EXPECT_EQ(unsupported.status, "unsupported");
+        EXPECT_TRUE(unsupported.windows.empty()); EXPECT_FALSE(unsupported.observedAt); ASSERT_TRUE(unsupported.block);
+    }
+    {
+        Home home; int calls = 0;
+        q::Provider absent("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+        auto value = absent.read(true); EXPECT_EQ(value.status, "needsAuth"); ASSERT_TRUE(value.block); EXPECT_EQ(calls, 0);
+    }
+}
+
+TEST(CollectorQuotaProvider, CommandCodeColdFailuresUseDocumentedSequence) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY");
+    unsetenv("COMMAND_CODE_API_KEY"); home.commandCodeAuth(); auto time = now; int calls = 0;
+    auto transport = [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{503, "", ""}; };
+    int attempt = 0;
+    for (auto delay : {5000, 10000, 20000, 30000, 30000}) {
+        q::Provider provider("commandcode", home.paths(), transport, [&] { return time; });
+        auto failure = provider.read(true);
+        EXPECT_EQ(failure.status, "error"); EXPECT_FALSE(failure.observedAt);
+        ASSERT_EQ(failure.nextAllowedAt, time + delay); EXPECT_EQ(calls, ++attempt);
+        time += delay;
+    }
+    EXPECT_EQ(calls, 5);
+    q::Provider recovered("commandcode", home.paths(), success, [&] { return time; });
+    EXPECT_EQ(recovered.read(true).status, "ok");
+}
+
+TEST(CollectorQuotaProvider, CommandCodeInFlightRotationDiscardsResult) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY");
+    unsetenv("COMMAND_CODE_API_KEY"); home.commandCodeAuth("first-key");
+    q::Provider rotating("commandcode", home.paths(), [&](const auto&, const auto&, bool) {
+        home.commandCodeAuth("second-key"); return q::HttpReply{200, commandCodeWhoami, ""};
+    }, [] { return now; });
+    auto discarded = rotating.read(true); EXPECT_TRUE(discarded.windows.empty()); EXPECT_FALSE(discarded.observedAt);
+    q::Provider current("commandcode", home.paths(), success, [] { return now; });
+    EXPECT_TRUE(current.read(false).windows.empty());
+    EXPECT_EQ(current.read(true).status, "ok");
+}
+
+TEST(CollectorQuotaService, CommandCodeFourthProviderIsIndependentAndCacheOnly) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY");
+    unsetenv("COMMAND_CODE_API_KEY");
+    home.codexAuth(); home.goAuth(); home.kimiAuth(); home.commandCodeAuth();
+    std::atomic<int> calls{0};
+    q::Service service(home.paths(), [&](const std::string& url, const q::Credential& c, bool reset) {
+        if (url.find("api.commandcode.ai") != std::string::npos) ++calls;
+        return success(url, c, reset);
+    }, [] { return now; });
+    ASSERT_TRUE(service.control(command("four", true, "\"codex\",\"opencode-go\",\"kimi\",\"commandcode\""), 7));
+    auto out = replies(service, 1); ASSERT_EQ(out.size(), 1u); EXPECT_EQ(out[0].first, 7u);
+    Document doc;
+    if (!out.empty()) {
+        ASSERT_TRUE(doc.parse(out[0].second)); ASSERT_EQ(doc.root()["snapshots"].size(), 4u);
+        const auto snapshot = doc.root()["snapshots"].at(3);
+        EXPECT_TRUE(snapshot["id"].equals("commandcode"));
+        EXPECT_TRUE(snapshot["displayName"].equals("Command Code"));
+        EXPECT_TRUE(snapshot["source"].equals("command-code · local credentials"));
+        EXPECT_TRUE(snapshot["accountIdentity"].isNull());
+        EXPECT_TRUE(snapshot["status"].equals("ok"));
+        EXPECT_EQ(snapshot["windows"].size(), 3u);
+    }
+    EXPECT_EQ(calls, 3);
+    ASSERT_TRUE(service.control(command("four-cache", false, "\"commandcode\""), 8));
+    auto cached = replies(service, 1); ASSERT_EQ(cached.size(), 1u); EXPECT_EQ(cached[0].first, 8u);
+    if (!cached.empty()) {
+        ASSERT_TRUE(doc.parse(cached[0].second));
+        EXPECT_TRUE(doc.root()["snapshots"].at(0)["status"].equals("stale"));
+        EXPECT_EQ(doc.root()["snapshots"].at(0)["windows"].size(), 3u);
+    }
+    EXPECT_EQ(calls, 3);
+    EXPECT_FALSE(service.control(command("duplicate", false, "\"codex\",\"opencode-go\",\"kimi\",\"commandcode\",\"commandcode\""), 9));
+}
+
 } // namespace
