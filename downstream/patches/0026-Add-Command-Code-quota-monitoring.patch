+// Real plan ids are prefixed (`individual-go`, `team-pro`) and may carry a
+// version suffix. Only ids documented in the contract map to an allocation;
+// anything else, including `individual-ultra`, yields no invented amount.
+struct CommandCodePlan { std::optional<double> credits; std::optional<std::string> name; };
+CommandCodePlan commandCodePlan(const std::optional<std::string>& id) {
+    if (!id) return {};
+    const auto value = trim(*id);
+    if (value.empty()) return {};
+    std::string key;
+    for (unsigned char c : value) key += static_cast<char>(std::tolower(c));
+    // Real ids are prefixed (`individual-go`, `individual-go-v1`, `team-pro`);
+    // only the documented families map to an included-credit allocation.
+    bool team = false;
+    for (const char* prefix : {"individual-", "individual_", "team-", "team_"}) {
+        const std::string text(prefix);
+        if (key.rfind(text, 0) == 0) { team = text.rfind("team", 0) == 0; key.erase(0, text.size()); break; }
+    }
+    std::string compact;
+    for (unsigned char c : key) if (std::isalnum(c)) compact += static_cast<char>(c);
+    // Drop a trailing version marker such as `go-v1` or `max-10x-v12`.
+    if (auto version = compact.find_last_of('v'); version != std::string::npos && version > 0 && version + 1 < compact.size()) {
+        const auto rest = static_cast<std::string::difference_type>(version) + 1;
+        if (std::all_of(compact.begin() + rest, compact.end(), [](unsigned char c) { return std::isdigit(c); })) compact.erase(version);
+    }
+    if (team) return compact == "pro" || compact == "teampro" ? CommandCodePlan{40, "Team Pro"} : CommandCodePlan{{}, value};
+    if (compact == "teampro") return {40, "Team Pro"};
+    if (compact == "go") return {10, "Go"};
+    if (compact == "goat") return {100, "GOAT"};
+    if (compact == "pro") return {110, "Pro"};
+    if (compact == "provider") return {15, "Provider"};
+    if (compact == "max10x" || compact == "max10") return {150, "Max 10x"};
+    if (compact == "max20x" || compact == "max20") return {300, "Max 20x"};
+    if (compact == "ultra") return {{}, "Ultra"};
+    // Unknown (for example `individual-mystery`): keep the label, invent no allowance.
+    return {{}, value};
+}
