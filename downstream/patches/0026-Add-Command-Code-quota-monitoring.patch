+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls, BillingStatus = 200;
+        public int Status = 200;
+        public double? Retry;
+        public string? Failure;
+        public string? Token;
+        public string Whoami = CommandCodeQuotaProviderTests.Whoami;
+        public string Credits = CommandCodeQuotaProviderTests.Credits;
+        public string Subscription = CommandCodeQuotaProviderTests.Subscription;
+        public TaskCompletionSource? Block;
+        public readonly List<string> Paths = [];
