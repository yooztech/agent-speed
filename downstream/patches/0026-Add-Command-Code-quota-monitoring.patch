+import Foundation
+import Testing
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+@testable import AgentSpeedCore
+
+private final class ManagedKeyStoreFixture: CommandCodeAPIKeyStoring, @unchecked Sendable {
+    private let lock = NSLock()
+    private var value: CommandCodeAPIKey?
+    private var unreadable = false
+
+    func read() throws -> CommandCodeAPIKey? {
+        try lock.withLock {
+            if unreadable { throw CommandCodeKeyStoreError.storageError }
+            return value
+        }
+    }
+    func save(apiKey: String) throws {
+        let newValue = try CommandCodeAPIKey(apiKey: apiKey, revision: CommandCodeAPIKey.randomRevision())
+        lock.withLock { value = newValue; unreadable = false }
+    }
+    func delete() { lock.withLock { value = nil; unreadable = false } }
+    func failRead() { lock.withLock { unreadable = true } }
+    func current() -> CommandCodeAPIKey? { lock.withLock { value } }
+}
+
+private final class ManagedKeyHTTPFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var requests: [URLRequest] = []
+    private var status = 200
+    func respond(_ value: Int) { lock.withLock { status = value } }
+    func captured() -> [URLRequest] { lock.withLock { requests } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        let code = lock.withLock { () -> Int in
+            requests.append(request)
+            return status
+        }
+        let body: String
+        switch request.url?.path {
+        case "/alpha/whoami": body = #"{"org":{"id":"org-1","login":"octo"},"user":{"userName":"octocat"}}"#
+        case "/alpha/billing/credits": body = #"{"credits":{"monthlyCredits":70,"monthlyCreditsGranted":100,"purchasedCredits":1,"freeCredits":0.5,"planId":"pro"}}"#
+        default: body = #"{"planId":"Pro","currentPeriodStart":"2027-01-01T00:00:00Z","currentPeriodEnd":"2027-02-01T00:00:00Z"}"#
+        }
+        return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: code, httpVersion: nil, headerFields: nil)!)
+    }
+}
+
+@Suite("Command Code managed API keys")
+struct CommandCodeAPIKeyTests {
+    private func directory() throws -> URL {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        return url
+    }
+
+    private func writeAuth(_ directory: URL, token: String) throws {
+        try JSONSerialization.data(withJSONObject: ["apiKey": token])
+            .write(to: directory.appendingPathComponent("auth.json"), options: .atomic)
+    }
+
+    private func provider(_ directory: URL, store: ManagedKeyStoreFixture, http: ManagedKeyHTTPFixture,
+                          environment: [String: String] = [:]) -> CommandCodeQuotaProvider {
+        CommandCodeQuotaProvider(environment: environment, authURL: directory.appendingPathComponent("auth.json"),
+                                 cacheDirectory: directory.appendingPathComponent("cache"), keyStore: store,
+                                 now: { Date(timeIntervalSince1970: 1_800_000_000) }, transport: { http.fetch($0) })
+    }
+
+    @Test func validatesKeyAlphabetBoundsAndRevisionShape() throws {
+        for valid in ["!", "a~Z_09-", String(repeating: "x", count: 4096)] {
+            #expect(CommandCodeAPIKey.isValid(valid))
+        }
+        for invalid in ["", "a b", "\nkey", "key\t", "é", "a\u{7f}", String(repeating: "x", count: 4097)] {
+            #expect(!CommandCodeAPIKey.isValid(invalid))
+            #expect(throws: CommandCodeKeyStoreError.self) {
+                try CommandCodeAPIKey(apiKey: invalid, revision: CommandCodeAPIKey.randomRevision())
+            }
+        }
+        let revision = CommandCodeAPIKey.randomRevision()
+        #expect(CommandCodeAPIKey.isValidRevision(revision))
+        for invalid in ["", "ABC", String(repeating: "g", count: 32), String(repeating: "a", count: 31),
+                        String(repeating: "a", count: 33), revision.uppercased()] {
+            #expect(!CommandCodeAPIKey.isValidRevision(invalid))
+            #expect(throws: CommandCodeKeyStoreError.self) { try CommandCodeAPIKey(apiKey: "key", revision: invalid) }
+        }
+    }
+
+    @Test func metadataReportsPresenceWithoutReadingTheSecret() throws {
+        let store = ManagedKeyStoreFixture()
+        #expect(try store.metadata() == CommandCodeKeyMetadata(configured: false))
+        try store.save(apiKey: "stored-secret")
+        #expect(try store.metadata() == CommandCodeKeyMetadata(configured: true))
+        #expect(try store.read()?.apiKey == "stored-secret")
+        store.failRead()
+        #expect(throws: CommandCodeKeyStoreError.self) { try store.metadata() }
+        store.delete()
+        #expect(try store.metadata() == CommandCodeKeyMetadata(configured: false))
+    }
+
+    @Test func managedKeyWinsOverEnvironmentAndCLIFile() async throws {
+        let url = try directory(); defer { try? FileManager.default.removeItem(at: url) }
+        try writeAuth(url, token: "cli-key")
+        let store = ManagedKeyStoreFixture(), http = ManagedKeyHTTPFixture()
+        try store.save(apiKey: "managed-key")
+        let reader = provider(url, store: store, http: http, environment: ["COMMAND_CODE_API_KEY": "env-key"])
+        #expect(await reader.refresh().status == .ok)
+        #expect(http.captured().allSatisfy { $0.value(forHTTPHeaderField: "Authorization") == "Bearer managed-key" })
+        #expect(await reader.readCachedSnapshot().configured == true)
+
+        // Removing the managed key rediscovers the environment value, then the CLI file.
+        store.delete()
+        await reader.credentialsChanged()
+        #expect(await reader.refresh().status == .ok)
+        #expect(http.captured().last?.value(forHTTPHeaderField: "Authorization") == "Bearer env-key")
+
+        let fileStore = ManagedKeyStoreFixture(), fileHTTP = ManagedKeyHTTPFixture()
+        let fileReader = provider(url, store: fileStore, http: fileHTTP)
+        #expect(await fileReader.refresh().status == .ok)
+        #expect(fileHTTP.captured().first?.value(forHTTPHeaderField: "Authorization") == "Bearer cli-key")
+        #expect(await fileReader.readCachedSnapshot().configured == true)
+    }
+
+    @Test func unreadableManagedKeyNeverFallsBack() async throws {
+        let url = try directory(); defer { try? FileManager.default.removeItem(at: url) }
+        try writeAuth(url, token: "cli-key")
+        let store = ManagedKeyStoreFixture(), http = ManagedKeyHTTPFixture()
+        try store.save(apiKey: "stored-key")
+        store.failRead()
+        let reader = provider(url, store: store, http: http, environment: ["COMMAND_CODE_API_KEY": "env-key"])
+        for value in [await reader.readCachedSnapshot(), await reader.refresh()] {
+            #expect(value.status == .needsAuth && value.block == CommandCodeQuotaProvider.apiKeyReason)
+            #expect(value.windows.isEmpty && value.observedAt == nil)
+            #expect(value.configured == true)
+        }
+        #expect(http.captured().isEmpty)
+    }
+
+    @Test func malformedStoredItemIsACredentialErrorWithoutRequests() async throws {
+        let url = try directory(); defer { try? FileManager.default.removeItem(at: url) }
+        try writeAuth(url, token: "cli-key")
+        let broken = CommandCodeQuotaProvider(environment: ["COMMAND_CODE_API_KEY": "env-key"],
+                                              authURL: url.appendingPathComponent("auth.json"),
+                                              cacheDirectory: url.appendingPathComponent("cache"),
+                                              keyStore: MalformedManagedKeyStore(),
+                                              now: { Date(timeIntervalSince1970: 1_800_000_000) }) { request in
+            Issue.record("A corrupt managed store must not request the supplier")
+            return (Data(), HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!)
+        }
+        let value = await broken.refresh()
+        #expect(value.status == .needsAuth && value.block == CommandCodeQuotaProvider.apiKeyReason)
+        #expect(value.configured == true && value.windows.isEmpty)
+    }
+
+    @Test func resavingTheSameKeyResetsRejectionAndIsolatesSchedules() async throws {
+        let url = try directory(); defer { try? FileManager.default.removeItem(at: url) }
+        let store = ManagedKeyStoreFixture(), http = ManagedKeyHTTPFixture()
+        try store.save(apiKey: "same-key")
+        let first = store.current()
+        let reader = provider(url, store: store, http: http)
+        http.respond(401)
+        let rejected = await reader.refresh()
+        #expect(rejected.status == .needsAuth && rejected.block == CommandCodeQuotaProvider.apiKeyReason)
+        #expect(await reader.readCachedSnapshot().block == CommandCodeQuotaProvider.apiKeyReason)
+
+        http.respond(200)
+        try store.save(apiKey: "same-key")
+        #expect(store.current()?.revision != first?.revision)
+        await reader.credentialsChanged()
+        #expect(await reader.refresh().status == .ok)
+        #expect(http.captured().last?.value(forHTTPHeaderField: "Authorization") == "Bearer same-key")
+    }
+
+    @Test func removingTheManagedKeyClearsObservationsAndDiskCache() async throws {
+        let url = try directory(); defer { try? FileManager.default.removeItem(at: url) }
+        try writeAuth(url, token: "cli-key")
+        let store = ManagedKeyStoreFixture(), http = ManagedKeyHTTPFixture()
+        try store.save(apiKey: "managed-secret")
+        let reader = provider(url, store: store, http: http, environment: ["COMMAND_CODE_API_KEY": "env-key"])
+        #expect(await reader.refresh().status == .ok)
+        store.delete()
+        await reader.credentialsChanged()
+        let cleared = await reader.readCachedSnapshot()
+        #expect(cleared.windows.isEmpty && cleared.observedAt == nil)
+        // Official credentials still make the provider configured after our key is gone.
+        #expect(cleared.configured == true)
+        let requests = http.captured().count
+        for file in try FileManager.default.contentsOfDirectory(at: url.appendingPathComponent("cache"),
+                                                               includingPropertiesForKeys: nil) {
+            let text = try String(contentsOf: file, encoding: .utf8)
+            #expect(!text.contains("managed-secret") && !text.contains("env-key") && !text.contains("cli-key"))
+        }
+        #expect(http.captured().count == requests)
+    }
+
+    #if !canImport(Security)
+    @Test func unsupportedPlatformHasNoPlaintextOrSuccessfulKeychainPath() throws {
+        let store = CommandCodeKeychainStore()
+        #expect(throws: CommandCodeKeyStoreError.self) { try store.read() }
+        #expect(throws: CommandCodeKeyStoreError.self) { try store.metadata() }
+        #expect(throws: CommandCodeKeyStoreError.self) { try store.save(apiKey: "secret") }
+        #expect(throws: CommandCodeKeyStoreError.self) { try store.delete() }
+    }
+    #endif
+}
+
+/// A configured location whose payload cannot be decoded.
+private final class MalformedManagedKeyStore: CommandCodeAPIKeyStoring, @unchecked Sendable {
+    func read() throws -> CommandCodeAPIKey? { throw CommandCodeKeyStoreError.storageError }
+    func save(apiKey: String) throws { throw CommandCodeKeyStoreError.storageError }
+    func delete() throws { throw CommandCodeKeyStoreError.storageError }
+}
