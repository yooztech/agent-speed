+TEST(CollectorQuotaProvider, CommandCodeWhoamiThenOrgScopedBillingAndCache) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY");
+    unsetenv("COMMAND_CODE_API_KEY"); home.commandCodeAuth();
+    auto time = now; std::vector<std::string> urls;
+    auto transport = [&](const std::string& url, const q::Credential& c, bool reset) {
+        EXPECT_FALSE(reset); EXPECT_EQ(c.token, "synthetic-command-code");
+        urls.push_back(url); return success(url, c, reset);
+    };
+    q::Provider provider("commandcode", home.paths(), transport, [&] { return time; });
+    auto value = provider.read(true); ASSERT_EQ(value.status, "ok");
+    ASSERT_EQ(value.windows.size(), 3u); EXPECT_EQ(value.account, "acme"); EXPECT_FALSE(value.accountIdentity);
+    EXPECT_FALSE(value.nextAllowedAt);
+    ASSERT_EQ(urls.size(), 3u);
+    EXPECT_EQ(urls[0], "https://api.commandcode.ai/alpha/whoami?limits=1");
+    EXPECT_EQ(urls[1], "https://api.commandcode.ai/alpha/billing/credits?orgId=org-cc");
+    EXPECT_EQ(urls[2], "https://api.commandcode.ai/alpha/billing/subscriptions?orgId=org-cc");
+    // Environment and CLI credentials keep the token-scoped context; the key is
+    // derived from context + token so a saved-key revision cannot reuse this cache.
+    EXPECT_TRUE(fs::exists(home.root + "/.agent-speed/quota/commandcode-" + sha256("commandcode:local\nsynthetic-command-code") + ".json"));
+    for (const auto& entry : fs::directory_iterator(home.root + "/.agent-speed/quota")) {
+        std::ifstream input(entry.path()); std::string body((std::istreambuf_iterator<char>(input)), {});
+        EXPECT_EQ(body.find("synthetic-command-code"), std::string::npos);
+    }
+    q::Provider restored("commandcode", home.paths(), transport, [&] { return time; });
+    auto cached = restored.read(false); EXPECT_EQ(cached.status, "stale"); EXPECT_EQ(cached.observedAt, now);
+    EXPECT_EQ(urls.size(), 3u);
+    EXPECT_EQ(restored.read(true).status, "ok"); EXPECT_EQ(urls.size(), 6u);
+}
