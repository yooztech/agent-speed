+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls, BillingStatus = 200;
+        public int Status = 200;
+        public double? Retry;
+        public string? Failure;
+        public string? Token;
+        public string Whoami = CommandCodeQuotaProviderTests.Whoami;
+        public string Credits = CommandCodeQuotaProviderTests.Credits;
+        public string Subscription = CommandCodeQuotaProviderTests.Subscription;
+        public TaskCompletionSource? Block;
+        public readonly List<string> Paths = [];
+        public readonly Dictionary<string, string> Queries = new(StringComparer.Ordinal);
+        public readonly Dictionary<string, string> Tokens = new(StringComparer.Ordinal);
+
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Calls++;
+            var path = request.RequestUri!.AbsolutePath;
+            Paths.Add(path + request.RequestUri.Query);
+            Queries[path] = request.RequestUri.Query;
+            Token = request.Headers.Authorization?.Parameter;
+            Tokens[path] = Token ?? "";
+            if (Block is { } block) await block.Task.WaitAsync(cancellationToken);
+            if (Failure == "network") throw new HttpRequestException("Synthetic unavailable transport");
+            var status = path.EndsWith("/whoami", StringComparison.Ordinal) || BillingStatus == 200 ? Status : BillingStatus;
+            var response = new HttpResponseMessage((HttpStatusCode)status);
+            if (status == 429 && Retry is { } seconds) response.Headers.RetryAfter = new RetryConditionHeaderValue(TimeSpan.FromSeconds(seconds));
+            if (status is not (200 or 429)) return response;
+            var body = Failure == "decode" ? "not json" : path switch
+            {
+                "/alpha/whoami" => Whoami,
+                "/alpha/billing/credits" => Credits,
+                _ => Subscription
+            };
+            response.Content = new StringContent(body);
+            return response;
+        }
+    }
