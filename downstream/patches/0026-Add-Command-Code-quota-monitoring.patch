@@ -0,0 +1,128 @@
+using System.Windows;
+using System.Windows.Controls;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+
+namespace AgentSpeed.Settings;
+
+internal sealed record CommandCodeKeySource(string Id, string Label, string? Destination, bool Connected)
+{
+    public override string ToString() => Label;
+}
+internal sealed record CommandCodeKeyResult(CommandCodeCredentialMetadata Metadata, string MessageKey);
+internal delegate Task<CommandCodeKeyResult> CommandCodeKeyOperation(CommandCodeKeySource source, string operation, string? apiKey, CancellationToken cancellationToken);
+
+/// <summary>A separate native editor: quota page redraws never own or recreate its transient password input.</summary>
+internal sealed class CommandCodeKeyDialog : Window
+{
+    private readonly Localizer loc;
+    private readonly CommandCodeKeyOperation operate;
+    private readonly ComboBox sources = new() { MinHeight = 30 };
+    private readonly PasswordBox password = new() { MinHeight = 30, MaxLength = 4096 };
+    private readonly TextBlock connection = new() { TextWrapping = TextWrapping.Wrap };
+    private readonly TextBlock status = new() { TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 12, 0, 12) };
+    private readonly Button save = new() { MinHeight = 30, Padding = new Thickness(12, 3, 12, 3) };
+    private readonly Button remove = new() { MinHeight = 30, Padding = new Thickness(12, 3, 12, 3), Margin = new Thickness(8, 0, 0, 0) };
+    private IReadOnlyList<CommandCodeKeySource> available = [];
+    private CancellationTokenSource? pending;
+    private bool closed, updating, busy;
+
+    public CommandCodeKeyDialog(Localizer loc, IReadOnlyList<CommandCodeKeySource> available, CommandCodeKeyOperation operate)
+    {
+        this.loc = loc;
+        this.operate = operate;
+        Title = T("commandCodeKeys"); Width = 480; SizeToContent = SizeToContent.Height;
+        ResizeMode = ResizeMode.NoResize; WindowStartupLocation = WindowStartupLocation.CenterOwner;
+        var panel = new StackPanel { Margin = new Thickness(20) };
+        Content = panel;
+        panel.Children.Add(Label("commandCodeDestination")); panel.Children.Add(sources); panel.Children.Add(connection);
+        panel.Children.Add(Label("commandCodeApiKey")); panel.Children.Add(password);
+        System.Windows.Automation.AutomationProperties.SetName(password, T("commandCodeApiKey"));
+        panel.Children.Add(status);
+        var buttons = new StackPanel { Orientation = Orientation.Horizontal };
+        save.Content = T("commandCodeSaveVerify"); remove.Content = T("commandCodeRemove");
+        buttons.Children.Add(save); buttons.Children.Add(remove); panel.Children.Add(buttons);
+        sources.SelectionChanged += (_, _) => { if (!updating) SelectSource(); };
+        save.Click += async (_, _) => await Run("set");
+        remove.Click += async (_, _) => await Run("delete");
+        Closed += (_, _) => { closed = true; pending?.Cancel(); pending?.Dispose(); password.Clear(); };
+        UpdateSources(available);
+    }
+
+    private string T(string key) => loc["win.quota." + key];
+    private TextBlock Label(string key) => new() { Text = T(key), Margin = new Thickness(0, 12, 0, 5) };
+
+    public void UpdateSources(IReadOnlyList<CommandCodeKeySource> next)
+    {
+        if (closed) return;
+        var selected = sources.SelectedItem as CommandCodeKeySource;
+        var sameList = available.Count == next.Count && available.Zip(next).All(pair =>
+            pair.First.Id == pair.Second.Id && pair.First.Destination == pair.Second.Destination && pair.First.Label == pair.Second.Label);
+        available = next;
+        if (!sameList)
+        {
+            updating = true;
+            sources.ItemsSource = next;
+            sources.SelectedItem = next.FirstOrDefault(item => selected is not null && item.Id == selected.Id && item.Destination == selected.Destination) ?? next.FirstOrDefault();
+            updating = false;
+            var current = sources.SelectedItem as CommandCodeKeySource;
+            if (selected is null || current is null || current.Id != selected.Id || current.Destination != selected.Destination) SelectSource();
+        }
+        UpdateConnection();
+    }
+
+    private CommandCodeKeySource? CurrentSource => sources.SelectedItem is CommandCodeKeySource selected
+        ? available.FirstOrDefault(item => item.Id == selected.Id && item.Destination == selected.Destination) : null;
+
+    private void UpdateConnection()
+    {
+        var source = CurrentSource;
+        connection.Text = T(source?.Destination is null ? "commandCodeLocal" : source.Connected ? "commandCodeConnected" : "commandCodeDisconnected");
+        save.IsEnabled = !busy && source is { Connected: true };
+        remove.IsEnabled = !busy && source is { Connected: true };
+    }
+
+    private async void SelectSource()
+    {
+        password.Clear();
+        await Run("get");
+    }
+
+    private async Task Run(string operation)
+    {
+        pending?.Cancel(); pending?.Dispose();
+        var cancellation = pending = new CancellationTokenSource();
+        var source = CurrentSource;
+        if (source is null) return;
+        var key = operation == "set" ? password.Password : null;
+        if (operation != "get") password.Clear();
+        if (operation == "set" && !CommandCodeCredentials.ValidKey(key))
+        {
+            status.Text = T("commandCodeKeyInvalid"); return;
+        }
+        busy = true; password.IsEnabled = operation == "get";
+        status.Text = T("commandCodeWorking"); UpdateConnection();
+        try
+        {
+            var result = await operate(source, operation, key, cancellation.Token);
+            var current = CurrentSource;
+            if (closed || cancellation.IsCancellationRequested || current is null || current.Id != source.Id || current.Destination != source.Destination) return;
+            status.Text = T(result.MessageKey);
+            if (operation == "set" && result.MessageKey == "commandCodeSavedVerified") Close();
+        }
+        catch (OperationCanceledException) { }
+        catch (TimeoutException) { if (!closed && !cancellation.IsCancellationRequested) status.Text = T("commandCodeRemoteTimeout"); }
+        catch (Exception error) when (error is IOException or CommandCodeCredentialException or ObjectDisposedException or ArgumentException)
+        {
+            if (!closed && !cancellation.IsCancellationRequested) status.Text = T(source.Destination is not null ? "commandCodeRemoteError" : "commandCodeKeyStorage");
+        }
+        finally
+        {
+            key = null;
+            if (!closed && pending == cancellation)
+            {
+                busy = false; password.IsEnabled = true; UpdateConnection();
+            }
+        }
+    }
+}
