+TEST(CollectorCommandCodeKeys, StoreRoundTripPrecedenceAndReadOnlyOfficialFile) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    auto p = home.paths();
+    home.commandCodeAuth("file-key");
+    auto fromFile = q::credentials("commandcode", p); ASSERT_TRUE(fromFile);
+    EXPECT_EQ(fromFile->token, "file-key"); EXPECT_EQ(fromFile->context, "commandcode:local");
+    setenv("COMMAND_CODE_API_KEY", "environment-key", 1);
+    auto fromEnvironment = q::credentials("commandcode", p); ASSERT_TRUE(fromEnvironment);
+    EXPECT_EQ(fromEnvironment->token, "environment-key");
+    const auto store = home.root + "/.agent-speed/quota/commandcode.json";
+    auto missing = q::manageCommandCodeCredentials(p, "get");
+    ASSERT_TRUE(missing.ok); EXPECT_FALSE(missing.configured);
+    EXPECT_FALSE(fs::exists(home.root + "/.agent-speed"));
+    ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+    auto metadata = q::manageCommandCodeCredentials(p, "get");
+    ASSERT_TRUE(metadata.ok); EXPECT_TRUE(metadata.configured);
+    auto saved = q::credentials("commandcode", p); ASSERT_TRUE(saved);
+    EXPECT_EQ(saved->token, "saved-key"); // Saved key wins over environment and CLI file.
+    EXPECT_EQ(saved->revision.size(), 32u);
+    EXPECT_EQ(saved->context.substr(0, 12), "agent-speed:");
+    EXPECT_EQ(saved->context, "agent-speed:" + saved->revision + ":" + sha256("saved-key"));
+    struct stat st{};
+    ASSERT_EQ(stat((home.root + "/.agent-speed").c_str(), &st), 0); EXPECT_EQ(st.st_mode & 07777, 0700);
+    ASSERT_EQ(stat((home.root + "/.agent-speed/quota").c_str(), &st), 0); EXPECT_EQ(st.st_mode & 07777, 0700);
+    ASSERT_EQ(stat(store.c_str(), &st), 0);
+    EXPECT_EQ(st.st_mode & 07777, 0600); EXPECT_EQ(st.st_nlink, 1u); EXPECT_EQ(st.st_uid, geteuid());
+    // Only the key and its internal nonce are stored; neither is returned by metadata.
+    std::ifstream storeInput(store); std::string stored((std::istreambuf_iterator<char>(storeInput)), {});
+    Document doc; ASSERT_TRUE(doc.parse(stored)); ASSERT_TRUE(doc.root().isObject()); EXPECT_EQ(doc.root().size(), 2u);
+    EXPECT_EQ(doc.root()["apiKey"].string(), std::optional<std::string>("saved-key"));
+    EXPECT_EQ(doc.root()["revision"].string(), std::optional<std::string>(saved->revision));
+    std::ifstream officialInput(home.paths().commandCodeAuth);
+    std::string official((std::istreambuf_iterator<char>(officialInput)), {});
+    ASSERT_FALSE(official.empty());
+    ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+    auto resaved = q::credentials("commandcode", p); ASSERT_TRUE(resaved);
+    EXPECT_NE(resaved->revision, saved->revision);
+    EXPECT_NE(resaved->context, saved->context);
+    EXPECT_TRUE(q::manageCommandCodeCredentials(p, "get").configured);
+    std::ifstream officialAfterInput(home.paths().commandCodeAuth);
+    std::string officialAfter((std::istreambuf_iterator<char>(officialAfterInput)), {});
+    EXPECT_EQ(officialAfter, official);
+    // Deleting returns to the remaining sources without touching the CLI file.
+    ASSERT_TRUE(q::manageCommandCodeCredentials(p, "delete").ok);
+    EXPECT_FALSE(q::manageCommandCodeCredentials(p, "get").configured);
+    EXPECT_FALSE(fs::exists(store));
+    auto fallback = q::credentials("commandcode", p); ASSERT_TRUE(fallback);
+    EXPECT_EQ(fallback->token, "environment-key");
+    unsetenv("COMMAND_CODE_API_KEY");
+    fallback = q::credentials("commandcode", p); ASSERT_TRUE(fallback);
+    EXPECT_EQ(fallback->token, "file-key");
+    // Removing an absent store is a successful no-op and invalid keys never create one.
+    Home empty; auto emptyPaths = empty.paths();
+    EXPECT_TRUE(q::manageCommandCodeCredentials(emptyPaths, "delete").ok);
+    EXPECT_FALSE(fs::exists(empty.root + "/.agent-speed"));
+    for (const std::string key : {std::string(), std::string("has space"), std::string("tab	key"), std::string(1, '\x7f'), std::string(1, '\x80'), std::string(4097, 'a')}) {
+        EXPECT_FALSE(q::manageCommandCodeCredentials(emptyPaths, "set", key).ok);
+        EXPECT_FALSE(fs::exists(empty.root + "/.agent-speed"));
+    }
+    ASSERT_TRUE(q::manageCommandCodeCredentials(emptyPaths, "set", std::string(4096, 'a')).ok);
+    ASSERT_TRUE(q::credentials("commandcode", emptyPaths));
+    EXPECT_EQ(q::credentials("commandcode", emptyPaths)->token.size(), 4096u);
+}
+
+TEST(CollectorCommandCodeKeys, CorruptStoreContentIsNeverAUsableOrFallbackCredential) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    for (const auto* attack : {"malformed", "missing-revision", "extra", "empty-key", "non-hex-revision", "duplicate-member"}) {
+        SCOPED_TRACE(attack); Home home; home.commandCodeAuth("file-key");
+        setenv("COMMAND_CODE_API_KEY", "environment-key", 1);
+        const auto p = home.paths();
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+        const auto file = fs::path(home.root + "/.agent-speed/quota/commandcode.json");
+        const std::string kind = attack;
+        if (kind == "malformed") put(file, "malformed");
+        else if (kind == "missing-revision") put(file, R"({"apiKey":"saved-key"})");
+        else if (kind == "extra") put(file, R"({"apiKey":"saved-key","revision":"0123456789abcdef0123456789abcdef","region":"china"})");
+        else if (kind == "empty-key") put(file, R"({"apiKey":"","revision":"0123456789abcdef0123456789abcdef"})");
+        else if (kind == "non-hex-revision") put(file, R"({"apiKey":"saved-key","revision":"0123456789ABCDEF0123456789abcdef"})");
+        else put(file, R"({"apiKey":"saved-key","apiKey":"other-key","revision":"0123456789abcdef0123456789abcdef"})");
+        EXPECT_FALSE(q::manageCommandCodeCredentials(p, "get").ok);
+        // The environment token and CLI file stay available but must not be used.
+        EXPECT_FALSE(q::credentials("commandcode", p));
+        q::Provider provider("commandcode", p, [](const auto&, const auto&, bool) { return q::HttpReply{}; }, [] { return now; });
+        auto rejected = provider.read(false);
+        EXPECT_TRUE(rejected.configured); EXPECT_EQ(rejected.status, "needsAuth"); EXPECT_EQ(rejected.windows.size(), 0u);
+    }
+}
+
+TEST(CollectorCommandCodeKeys, UnsafeStoresNeverFallBackToOtherSources) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    for (const auto* attack : {"file-mode", "file-symlink", "file-hardlink", "file-directory", "app-mode", "quota-mode", "app-symlink", "quota-symlink", "home-mode"}) {
+        SCOPED_TRACE(attack); Home home; home.commandCodeAuth("file-key");
+        setenv("COMMAND_CODE_API_KEY", "environment-key", 1);
+        const auto p = home.paths();
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+        const fs::path app = home.root + "/.agent-speed", quota = app / "quota", file = quota / "commandcode.json";
+        const std::string kind = attack;
+        if (kind == "file-mode") ASSERT_EQ(chmod(file.c_str(), 0644), 0);
+        else if (kind == "file-hardlink") fs::create_hard_link(file, quota / "second");
+        else if (kind == "file-symlink") { fs::rename(file, quota / "original"); fs::create_symlink(quota / "original", file); }
+        else if (kind == "file-directory") { fs::remove(file); fs::create_directory(file); }
+        else if (kind == "app-mode") ASSERT_EQ(chmod(app.c_str(), 0755), 0);
+        else if (kind == "quota-mode") ASSERT_EQ(chmod(quota.c_str(), 0755), 0);
+        else if (kind == "app-symlink") { fs::rename(app, home.root + "/other-app"); fs::create_directory_symlink(home.root + "/other-app", app); }
+        else if (kind == "quota-symlink") { fs::rename(quota, app / "other-quota"); fs::create_directory_symlink(app / "other-quota", quota); }
+        else ASSERT_EQ(chmod(home.root.c_str(), 0770), 0);
+        EXPECT_FALSE(q::manageCommandCodeCredentials(p, "get").ok);
+        EXPECT_FALSE(q::manageCommandCodeCredentials(p, "set", "replacement").ok);
+        EXPECT_FALSE(q::manageCommandCodeCredentials(p, "delete").ok);
+        EXPECT_FALSE(q::credentials("commandcode", p));
+    }
+}
+
+TEST(CollectorCommandCodeProvider, ConfiguredTracksEveryCredentialSource) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    {
+        Home home; int calls = 0;
+        q::Provider provider("commandcode", home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+        // No managed key, environment token or CLI file: honestly unconfigured.
+        auto absent = provider.read(false);
+        EXPECT_FALSE(absent.configured); EXPECT_EQ(absent.status, "needsAuth"); EXPECT_TRUE(absent.windows.empty()); EXPECT_EQ(calls, 0);
+    }
+    {
+        Home home; home.commandCodeAuth("file-key");
+        q::Provider provider("commandcode", home.paths(), success, [] { return now; });
+        EXPECT_TRUE(provider.read(false).configured);
+    }
+    {
+        Home home; setenv("COMMAND_CODE_API_KEY", "environment-key", 1);
+        q::Provider provider("commandcode", home.paths(), success, [] { return now; });
+        EXPECT_TRUE(provider.read(false).configured);
+        unsetenv("COMMAND_CODE_API_KEY");
+    }
+    {
+        Home home; home.commandCodeAuth(); const auto p = home.paths();
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+        std::vector<std::string> tokens;
+        q::Provider provider("commandcode", p, [&](const std::string& url, const q::Credential& c, bool reset) { tokens.push_back(c.token); return success(url, c, reset); }, [] { return now; });
+        auto observed = provider.read(true);
+        EXPECT_TRUE(observed.configured); EXPECT_EQ(observed.status, "ok");
+        ASSERT_FALSE(tokens.empty()); EXPECT_EQ(tokens.front(), "saved-key");
+        // Removing only our key leaves the CLI file behind, so the host stays configured.
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "delete").ok);
+        EXPECT_TRUE(provider.read(false).configured);
+    }
+    {
+        Home home; home.commandCodeAuth("file-key"); const auto p = home.paths(); int calls = 0;
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "saved-key").ok);
+        put(home.root + "/.agent-speed/quota/commandcode.json", "malformed");
+        q::Provider provider("commandcode", p, [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+        auto rejected = provider.read(false);
+        // A corrupt managed store is a credential error on a configured host, never a
+        // silent switch to the CLI file or the environment.
+        EXPECT_TRUE(rejected.configured); EXPECT_EQ(rejected.status, "needsAuth");
+        EXPECT_TRUE(rejected.windows.empty()); EXPECT_FALSE(rejected.observedAt); EXPECT_EQ(calls, 0);
+    }
+}
+
+TEST(CollectorCommandCodeProvider, ResavingSameKeyResetsRejectionAndBackoff) {
+    Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    {
+        Home home; const auto p = home.paths(); int calls = 0;
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "synthetic-cc").ok);
+        auto reject = [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{401, "", ""}; };
+        { q::Provider provider("commandcode", p, reject, [] { return now; }); EXPECT_EQ(provider.read(true).status, "needsAuth"); }
+        EXPECT_EQ(calls, 1);
+        // The rejected identity is persisted, so a restart does not spend another request.
+        q::Provider restored("commandcode", p, reject, [] { return now; });
+        EXPECT_EQ(restored.read(true).status, "needsAuth"); EXPECT_EQ(calls, 1);
+        // Re-saving the identical key is an explicit credential change.
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "synthetic-cc").ok);
+        q::Provider resaved("commandcode", p, success, [] { return now; });
+        EXPECT_EQ(resaved.read(true).status, "ok"); EXPECT_EQ(calls, 1);
+    }
+    {
+        Home home; const auto p = home.paths(); auto time = now; int calls = 0;
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "synthetic-paced").ok);
+        q::Provider limited("commandcode", p, [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{429, "", "1200"}; }, [&] { return time; });
+        auto paced = limited.read(true);
+        EXPECT_EQ(paced.status, "error"); ASSERT_EQ(paced.nextAllowedAt, now + 1200000); EXPECT_EQ(calls, 1);
+        EXPECT_EQ(limited.read(true).nextAllowedAt, paced.nextAllowedAt); EXPECT_EQ(calls, 1);
+        ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "synthetic-paced").ok);
+        q::Provider resaved("commandcode", p, success, [&] { return time; });
+        EXPECT_EQ(resaved.read(true).status, "ok"); EXPECT_EQ(calls, 1);
+    }
+}
+
+TEST(CollectorCommandCodeKeys, ProtocolStrictnessMetadataAndInvalidation) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    std::atomic<int> calls{0};
+    q::Service service(home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+    auto exchange = [&](const std::string& command) {
+        EXPECT_TRUE(service.control(command, 42)); auto out = replies(service, 1);
+        EXPECT_EQ(out.size(), 1u); if (out.empty()) return std::string();
+        EXPECT_EQ(out[0].first, 42u); EXPECT_EQ(out[0].second.find("synthetic"), std::string::npos); return out[0].second;
+    };
+    Document doc;
+    auto saved = exchange(R"({"type":"commandcode_credentials","requestId":"save_1","operation":"set","apiKey":"synthetic-wire"})");
+    ASSERT_TRUE(doc.parse(saved));
+    EXPECT_TRUE(doc.root()["type"].equals("commandcode_credentials_result"));
+    EXPECT_TRUE(doc.root()["requestId"].equals("save_1")); EXPECT_TRUE(doc.root()["status"].equals("ok"));
+    EXPECT_TRUE(doc.root()["configured"].isTrue()); EXPECT_EQ(doc.root().size(), 4u);
+    EXPECT_FALSE(doc.root()["apiKey"].valid()); EXPECT_FALSE(doc.root()["region"].valid());
+    ASSERT_TRUE(doc.parse(exchange(R"({"type":"commandcode_credentials","requestId":"get-1","operation":"get"})")));
+    EXPECT_TRUE(doc.root()["configured"].isTrue()); EXPECT_EQ(doc.root().size(), 4u);
+    for (const auto* fields : {R"("operation":"get","apiKey":"synthetic-extra")", R"("operation":"get","region":"china")", R"("operation":"set")", R"("operation":"set","apiKey":"bad key")", R"("operation":"set","apiKey":"")", R"("operation":"other")", R"("operation":"get","operation":"delete")"}) {
+        ASSERT_TRUE(doc.parse(exchange(std::string("{\"type\":\"commandcode_credentials\",\"requestId\":\"invalid\",") + fields + "}")));
+        EXPECT_TRUE(doc.root()["errorCode"].equals("invalid_request")); EXPECT_EQ(doc.root().size(), 4u);
+        EXPECT_FALSE(doc.root()["configured"].valid());
+    }
+    EXPECT_FALSE(service.control(R"({"type":"commandcode_credentials","requestId":"unsafe id","operation":"get"})", 42));
+    EXPECT_FALSE(service.control(std::string(16385, 'x'), 42));
+    ASSERT_TRUE(doc.parse(exchange(R"({"type":"commandcode_credentials","requestId":"delete","operation":"delete"})")));
+    EXPECT_TRUE(doc.root()["status"].equals("ok")); EXPECT_FALSE(doc.root()["configured"].isTrue()); EXPECT_EQ(doc.root().size(), 4u);
+    EXPECT_EQ(calls, 0);
+    EXPECT_FALSE(fs::exists(home.root + "/.agent-speed/quota/commandcode.json"));
+    EXPECT_TRUE(service.control(R"({"type":"commandcode_credentials","requestId":"disconnected","operation":"get"})", 99));
+    service.disconnected(99);
+    EXPECT_TRUE(service.control(R"({"type":"commandcode_credentials","requestId":"alive","operation":"get"})", 42));
+    auto out = replies(service, 1); ASSERT_EQ(out.size(), 1u); EXPECT_EQ(out[0].first, 42u);
+}
+
+TEST(CollectorCommandCodeKeys, CredentialChangeInvalidatesInFlightAndCachedObservations) {
+    Home home; Environment environment("COMMAND_CODE_API_KEY"); unsetenv("COMMAND_CODE_API_KEY");
+    home.commandCodeAuth(); const auto p = home.paths();
+    ASSERT_TRUE(q::manageCommandCodeCredentials(p, "set", "synthetic-blocked").ok);
+    std::mutex mutex; std::condition_variable cv; bool started = false, release = false;
+    q::Service service(p, [&](const std::string& url, const q::Credential& credential, bool reset) {
+        if (url.find("api.commandcode.ai") != std::string::npos) {
+            std::unique_lock<std::mutex> lock(mutex); started = true; cv.notify_all();
+            cv.wait_for(lock, std::chrono::seconds(10), [&] { return release; });
+        }
+        return success(url, credential, reset);
+    }, [] { return now; });
+    ASSERT_TRUE(service.control(command("inflight", true, "\"commandcode\""), 1));
+    { std::unique_lock<std::mutex> lock(mutex); if (!cv.wait_for(lock, std::chrono::seconds(3), [&] { return started; })) { release = true; cv.notify_all(); FAIL() << "Command Code request did not start"; } }
+    EXPECT_TRUE(service.control(R"({"type":"commandcode_credentials","requestId":"replace","operation":"set","apiKey":"synthetic-replacement"})", 2));
+    EXPECT_TRUE(service.control(command("other-supplier", false, "\"codex\""), 3));
+    auto independent = replies(service, 2); EXPECT_EQ(independent.size(), 2u);
+    std::set<std::uint64_t> subscribers; for (const auto& item : independent) subscribers.insert(item.first);
+    EXPECT_EQ(subscribers, (std::set<std::uint64_t>{2, 3}));
+    { std::lock_guard<std::mutex> lock(mutex); release = true; } cv.notify_all();
+    auto old = replies(service, 1); ASSERT_EQ(old.size(), 1u); Document doc; ASSERT_TRUE(doc.parse(old[0].second));
+    EXPECT_EQ(old[0].first, 1u); EXPECT_EQ(doc.root()["snapshots"].at(0)["windows"].size(), 0u);
+    EXPECT_TRUE(doc.root()["snapshots"].at(0)["observedAt"].isNull());
+    EXPECT_TRUE(service.control(command("after-replace", false, "\"commandcode\""), 1));
+    auto cleared = replies(service, 1); ASSERT_EQ(cleared.size(), 1u); ASSERT_TRUE(doc.parse(cleared[0].second));
+    EXPECT_EQ(doc.root()["snapshots"].at(0)["windows"].size(), 0u);
+    EXPECT_TRUE(doc.root()["snapshots"].at(0)["observedAt"].isNull());
+}
+
 } // namespace
