index 00000000..836f18f2
--- /dev/null
+++ b/windows/src/AgentSpeed.Core/CommandCodeCredentialStore.cs
@@ -0,0 +1,180 @@
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace AgentSpeed.Core;
+
+public sealed record CommandCodeCredentialMetadata(bool Configured);
+
+/// <summary>Only providers read secrets. Settings use GetMetadata, which never decrypts a saved key.</summary>
+public interface ICommandCodeCredentialStore
+{
+    CommandCodeCredentialMetadata GetMetadata();
+    CommandCodeApiCredential? Read();
+    void Set(string apiKey);
+    void Delete();
+}
+
+public sealed class CommandCodeApiCredential(string apiKey, string revision)
+{
+    public string ApiKey { get; } = apiKey;
+    public string Revision { get; } = revision;
+    public override string ToString() => "Command Code API credential";
+}
+
+public sealed class CommandCodeCredentialException : Exception
+{
+    public CommandCodeCredentialException() : base("Command Code key storage is unavailable. Save the key again or remove it in Settings.") { }
+}
+
+public static class CommandCodeCredentials
+{
+    public static bool ValidKey(string? key) => key is { Length: > 0 and <= 4096 } && key.All(c => c is >= '!' and <= '~');
+}
+
+/// <summary>Current-user DPAPI with a dedicated quota context, never a reporting device identity.
+/// A small non-secret header carries the per-save revision that lets a re-saved key reset rejection and backoff.
+/// The protected payload binds that header to the key. No plaintext fallback exists, including on portable hosts.</summary>
+public sealed partial class CommandCodeCredentialStore : ICommandCodeCredentialStore
+{
+    private const int RevisionLength = 16;
+    private static readonly byte[] Entropy = Encoding.ASCII.GetBytes("AgentSpeed/CommandCode/subscription-key/v1");
+    private readonly string path;
+    private readonly object gate = new();
+    public CommandCodeCredentialStore(string? path = null) => this.path = path ?? Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota", "commandcode.key");
+
+    private bool IsAbsent()
+    {
+        try { File.GetAttributes(path); return false; }
+        catch (FileNotFoundException) { return true; }
+        catch (DirectoryNotFoundException) { return true; }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new CommandCodeCredentialException(); }
+    }
+
+    public CommandCodeCredentialMetadata GetMetadata()
+    {
+        lock (gate)
+        {
+            try
+            {
+                using var stream = File.OpenRead(path);
+                if (stream.Length is < 1 + RevisionLength or > 16384) throw new CommandCodeCredentialException();
+                if (stream.ReadByte() != 1) throw new CommandCodeCredentialException();
+                var revision = new byte[RevisionLength];
+                stream.ReadExactly(revision);
+                return new(true);
+            }
+            catch (FileNotFoundException) { if (!IsAbsent()) throw new CommandCodeCredentialException(); return new(false); }
+            catch (DirectoryNotFoundException) { if (!IsAbsent()) throw new CommandCodeCredentialException(); return new(false); }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new CommandCodeCredentialException(); }
+        }
+    }
+
+    public CommandCodeApiCredential? Read()
+    {
+        lock (gate)
+        {
+            byte[]? plain = null;
+            try
+            {
+                using var stream = File.OpenRead(path);
+                if (stream.Length is < 1 + RevisionLength or > 16384) throw new CommandCodeCredentialException();
+                if (stream.ReadByte() != 1) throw new CommandCodeCredentialException();
+                var revision = new byte[RevisionLength];
+                stream.ReadExactly(revision);
+                var sealedData = new byte[(int)stream.Length - 1 - RevisionLength];
+                stream.ReadExactly(sealedData);
+                plain = Transform(sealedData, protect: false);
+                if (plain.Length is < RevisionLength + 1 or > RevisionLength + 4096 ||
+                    !plain.AsSpan(0, RevisionLength).SequenceEqual(revision) ||
+                    plain.AsSpan(RevisionLength).ContainsAnyExceptInRange((byte)33, (byte)126)) throw new CommandCodeCredentialException();
+                return new(Encoding.ASCII.GetString(plain, RevisionLength, plain.Length - RevisionLength),
+                    Convert.ToHexString(revision).ToLowerInvariant());
+            }
+            catch (FileNotFoundException) { if (!IsAbsent()) throw new CommandCodeCredentialException(); return null; }
+            catch (DirectoryNotFoundException) { if (!IsAbsent()) throw new CommandCodeCredentialException(); return null; }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException or CryptographicException) { throw new CommandCodeCredentialException(); }
+            finally { if (plain is not null) CryptographicOperations.ZeroMemory(plain); }
+        }
+    }
+
+    public void Set(string apiKey)
+    {
+        if (!CommandCodeCredentials.ValidKey(apiKey)) throw new ArgumentException("Invalid Command Code key.");
+        lock (gate)
+        {
+            var revision = RandomNumberGenerator.GetBytes(RevisionLength);
+            var plain = new byte[RevisionLength + apiKey.Length];
+            revision.CopyTo(plain, 0);
+            Encoding.ASCII.GetBytes(apiKey, plain.AsSpan(RevisionLength));
+            var temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+            try
+            {
+                var sealedData = Transform(plain, protect: true);
+                Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+                using (var stream = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, FileOptions.WriteThrough))
+                {
+                    stream.WriteByte(1);
+                    stream.Write(revision);
+                    stream.Write(sealedData);
+                    stream.Flush(flushToDisk: true);
+                }
+                File.Move(temporary, path, overwrite: true);
+            }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException or CryptographicException) { throw new CommandCodeCredentialException(); }
+            finally
+            {
+                CryptographicOperations.ZeroMemory(plain);
+                try { File.Delete(temporary); } catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+            }
+        }
+    }
+
+    public void Delete()
+    {
+        lock (gate)
+        {
+            try { File.Delete(path); }
+            catch (DirectoryNotFoundException) { }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new CommandCodeCredentialException(); }
+        }
+    }
+
+    private static unsafe byte[] Transform(byte[] bytes, bool protect)
+    {
+        if (!OperatingSystem.IsWindows()) throw new CommandCodeCredentialException();
+        fixed (byte* data = bytes)
+        fixed (byte* salt = Entropy)
+        {
+            var input = new DataBlob { Length = bytes.Length, Data = (nint)data };
+            var entropy = new DataBlob { Length = Entropy.Length, Data = (nint)salt };
+            DataBlob output;
+            var ok = protect ? CryptProtectData(ref input, 0, ref entropy, 0, 0, 1, out output)
+                : CryptUnprotectData(ref input, 0, ref entropy, 0, 0, 1, out output);
+            if (!ok) throw new CommandCodeCredentialException();
+            try
+            {
+                var result = new byte[output.Length];
+                Marshal.Copy(output.Data, result, 0, result.Length);
+                return result;
+            }
+            finally
+            {
+                if (!protect) new Span<byte>((void*)output.Data, output.Length).Clear();
+                LocalFree(output.Data);
+            }
+        }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct DataBlob { public int Length; public nint Data; }
+    [LibraryImport("crypt32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static partial bool CryptProtectData(ref DataBlob dataIn, nint description, ref DataBlob entropy, nint reserved, nint prompt, int flags, out DataBlob dataOut);
+    [LibraryImport("crypt32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static partial bool CryptUnprotectData(ref DataBlob dataIn, nint description, ref DataBlob entropy, nint reserved, nint prompt, int flags, out DataBlob dataOut);
+    [LibraryImport("kernel32.dll")]
+    private static partial nint LocalFree(nint memory);
+}
