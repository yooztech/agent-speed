+using System.IO;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Services;
+using AgentSpeed.Settings;
+
+namespace AgentSpeed.Windows.Tests;
+
+public sealed class CommandCodeKeySettingsTests
+{
+    [Fact]
+    public void SettingsMetadataNeverReadsSecretAndIncludesDisabledQuotaSourcesAndDisconnectedHosts() => RunSta(() =>
+    {
+        using var settings = new SettingsService(Dispatcher.CurrentDispatcher); settings.MakeEphemeral();
+        var host = new RemoteHost(Guid.NewGuid(), "Build", "build", true);
+        settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = false,
+            QuotaAllSources = false, QuotaSources = [], RemoteHosts = [host, new(Guid.NewGuid(), "Disabled", "disabled", false)] });
+        var store = new Store(); store.Set("private-key");
+        using var surface = new QuotaSurface(settings, Loc(), false, providerFactory: _ => new Provider(), commandCodeKeys: store);
+        var sources = surface.CommandCodeKeySources();
+        Assert.Equal(2, sources.Count); Assert.True(sources[0].Connected); Assert.False(sources[1].Connected);
+        Assert.Equal("commandcode", sources[0].Id);
+        Assert.Equal(QuotaProviders.RemoteSourceId(host.Id, "commandcode"), sources[1].Id);
+        var metadata = surface.OperateCommandCodeKeyAsync(sources[0], "get", null, default).GetAwaiter().GetResult();
+        Assert.Equal(new CommandCodeCredentialMetadata(true), metadata.Metadata);
+        Assert.Equal(0, store.SecretReads);
+        Assert.DoesNotContain("private-key", metadata.ToString());
+        Assert.Throws<IOException>(() => surface.OperateCommandCodeKeyAsync(sources[1], "get", null, default).GetAwaiter().GetResult());
+    });
+
+    [Fact]
+    public void SavingWithoutConsentDoesNotVerifyAndRemovingDoesNotRediscoverCliAutomatically() => RunSta(() =>
+    {
+        using var settings = new SettingsService(Dispatcher.CurrentDispatcher); settings.MakeEphemeral();
+        settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = false, QuotaAllSources = false, QuotaSources = [] });
+        var store = new Store(); var calls = new List<string>();
+        var provider = new Provider();
+        using var surface = new QuotaSurface(settings, Loc(), false, providerFactory: id => { calls.Add(id); return provider; }, commandCodeKeys: store);
+        var source = surface.CommandCodeKeySources()[0];
+        var saved = surface.OperateCommandCodeKeyAsync(source, "set", "new-key", default).GetAwaiter().GetResult();
+        Assert.Equal("commandCodeSavedUnverified", saved.MessageKey); Assert.True(saved.Metadata.Configured);
+        Assert.Equal(0, provider.Refreshes);
+        Assert.All(calls, id => Assert.Equal("commandcode", id));
+        var removed = surface.OperateCommandCodeKeyAsync(source, "delete", null, default).GetAwaiter().GetResult();
+        Assert.Equal("commandCodeRemoved", removed.MessageKey); Assert.False(store.GetMetadata().Configured);
+        Assert.Equal(0, provider.Refreshes); Assert.Equal(0, store.SecretReads);
+    });
+
+    [Theory]
+    [InlineData(QuotaStatus.Ok, "commandCodeSavedVerified")]
+    [InlineData(QuotaStatus.NeedsAuth, "commandCodeSavedRejected")]
+    [InlineData(QuotaStatus.Error, "commandCodeSavedUnverified")]
+    public void SaveVerifiesOnlySelectedCommandCodeEvenWhenQuotaSourceDisabled(QuotaStatus status, string message) => RunSta(() =>
+    {
+        using var settings = new SettingsService(Dispatcher.CurrentDispatcher); settings.MakeEphemeral();
+        settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = true, QuotaAllSources = false, QuotaSources = [] });
+        var store = new Store(); var provider = new Provider { Status = status };
+        using var surface = new QuotaSurface(settings, Loc(), false, providerFactory: id => { Assert.Equal("commandcode", id); return provider; }, commandCodeKeys: store);
+        var result = surface.OperateCommandCodeKeyAsync(surface.CommandCodeKeySources()[0], "set", "new-key", default).GetAwaiter().GetResult();
+        Assert.Equal(message, result.MessageKey); Assert.True(result.Metadata.Configured); Assert.Equal(1, provider.Refreshes);
+    });
+
+    [Fact]
+    public void SeparateEditorPreservesTypedKeyAcrossQuotaUpdatesAndClearsOnSourceChangeAndClose() => RunSta(() =>
+    {
+        var local = new CommandCodeKeySource("commandcode", "Local", null, true);
+        var remote = new CommandCodeKeySource("remote", "Remote", "host", false);
+        var requests = new List<string>();
+        var dialog = new CommandCodeKeyDialog(Loc(), [local, remote], (source, operation, _, _) =>
+        {
+            requests.Add(operation);
+            return Task.FromResult(new CommandCodeKeyResult(new(true), "commandCodeConfigured"));
+        });
+        var panel = Assert.IsType<StackPanel>(dialog.Content);
+        var password = Assert.Single(panel.Children.OfType<PasswordBox>());
+        var combo = Assert.Single(panel.Children.OfType<ComboBox>());
+        Assert.Equal("", password.Password);
+        password.Password = "typed-not-saved";
+        dialog.UpdateSources([local, remote with { Connected = true }]);
+        Assert.Equal("typed-not-saved", password.Password); Assert.Single(requests);
+        combo.SelectedIndex = 1; Assert.Equal("", password.Password); Assert.Equal(2, requests.Count);
+        password.Password = "clear-on-destination-change";
+        dialog.UpdateSources([local, remote with { Destination = "replacement" }]);
+        Assert.Equal("", password.Password);
+        password.Password = "clear-on-close";
+        dialog.Close(); Assert.Equal("", password.Password);
+    });
+
+    [Theory]
+    [InlineData(false, "commandCodeSavedVerified", true)]
+    [InlineData(true, "commandCodeSavedVerified", true)]
+    [InlineData(false, "commandCodeSavedUnverified", false)]
+    [InlineData(true, "commandCodeSavedRejected", false)]
+    public void EditorDismissesOnlyAfterSuccessfulSaveAndVerification(bool remote, string message, bool shouldClose) => RunSta(() =>
+    {
+        var source = new CommandCodeKeySource("commandcode", "Source", remote ? "host" : null, true);
+        var operations = new List<string>();
+        var dialog = new CommandCodeKeyDialog(Loc(), [source], (_, operation, _, _) =>
+        {
+            operations.Add(operation);
+            return Task.FromResult(new CommandCodeKeyResult(new(true), operation == "set" ? message : "commandCodeConfigured"));
+        });
+        var closed = false;
+        dialog.Closed += (_, _) => closed = true;
+        var panel = Assert.IsType<StackPanel>(dialog.Content);
+        var password = Assert.Single(panel.Children.OfType<PasswordBox>());
+        password.Password = "new-key";
+        var buttons = Assert.Single(panel.Children.OfType<StackPanel>());
+        Assert.IsType<Button>(buttons.Children[0]).RaiseEvent(new RoutedEventArgs(Button.ClickEvent));
+        Assert.Equal(new[] { "get", "set" }, operations);
+        Assert.Equal(shouldClose, closed);
+        Assert.Equal("", password.Password);
+        if (!shouldClose)
+        {
+            Assert.Contains(panel.Children.OfType<TextBlock>(), item => item.Text == Loc()["win.quota." + message]);
+            dialog.Close();
+        }
+    });
+
+    [Theory]
+    [InlineData("invalid", "commandCodeKeyInvalid")]
+    [InlineData("storage", "commandCodeKeyStorage")]
+    [InlineData("timeout", "commandCodeRemoteTimeout")]
+    public void EditorKeepsValidationAndStorageOrNetworkFailuresVisible(string failure, string message) => RunSta(() =>
+    {
+        var requests = 0;
+        var dialog = new CommandCodeKeyDialog(Loc(), [new("commandcode", "Local", null, true)], (_, operation, _, _) =>
+        {
+            requests++;
+            return operation == "get"
+                ? Task.FromResult(new CommandCodeKeyResult(new(false), "commandCodeNotConfigured"))
+                : Task.FromException<CommandCodeKeyResult>(failure == "timeout" ? new TimeoutException() : new CommandCodeCredentialException());
+        });
+        var closed = false;
+        dialog.Closed += (_, _) => closed = true;
+        var panel = Assert.IsType<StackPanel>(dialog.Content);
+        Assert.Single(panel.Children.OfType<PasswordBox>()).Password = failure == "invalid" ? "" : "new-key";
+        var buttons = Assert.Single(panel.Children.OfType<StackPanel>());
+        Assert.IsType<Button>(buttons.Children[0]).RaiseEvent(new RoutedEventArgs(Button.ClickEvent));
+        Assert.False(closed);
+        Assert.Contains(panel.Children.OfType<TextBlock>(), item => item.Text == Loc()["win.quota." + message]);
+        if (failure == "invalid") Assert.Equal(1, requests);
+        dialog.Close();
+    });
+
+    [Fact]
+    public void DpapiStoreRoundTripsAtomicallyWithoutPlaintextAndMetadataSurvivesWithoutDecrypting()
+    {
+        if (!OperatingSystem.IsWindows()) return;
+        var root = Path.Combine(Path.GetTempPath(), "commandcode-dpapi-" + Guid.NewGuid().ToString("N"));
+        var path = Path.Combine(root, "commandcode.key");
+        try
+        {
+            var store = new CommandCodeCredentialStore(path);
+            store.Set("synthetic-dpapi-key");
+            Assert.DoesNotContain("synthetic-dpapi-key", System.Text.Encoding.UTF8.GetString(File.ReadAllBytes(path)));
+            var restarted = new CommandCodeCredentialStore(path);
+            Assert.True(restarted.GetMetadata().Configured);
+            var first = restarted.Read()!;
+            Assert.Equal("synthetic-dpapi-key", first.ApiKey);
+            restarted.Set("synthetic-dpapi-key");
+            var second = restarted.Read()!;
+            Assert.Equal("synthetic-dpapi-key", second.ApiKey);
+            Assert.NotEqual(first.Revision, second.Revision);
+            // The header alone is enough for metadata; a damaged protected blob is never decrypted by Settings.
+            using (var stream = new FileStream(path, FileMode.Open, FileAccess.Write))
+            {
+                stream.Position = 17;
+                stream.Write(Enumerable.Repeat((byte)0xA5, 16).ToArray());
+            }
+            Assert.True(new CommandCodeCredentialStore(path).GetMetadata().Configured);
+            Assert.Throws<CommandCodeCredentialException>(() => new CommandCodeCredentialStore(path).Read());
+            restarted.Delete(); Assert.False(restarted.GetMetadata().Configured);
+            Assert.Empty(Directory.GetFiles(root));
+        }
+        finally { if (Directory.Exists(root)) Directory.Delete(root, true); }
+    }
+
+    private static Localizer Loc() => new(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+    private sealed class Store : ICommandCodeCredentialStore
+    {
+        private CommandCodeCredentialMetadata metadata = new(false);
+        public int SecretReads;
+        public CommandCodeCredentialMetadata GetMetadata() => metadata;
+        public CommandCodeApiCredential? Read() { SecretReads++; throw new InvalidOperationException("Settings must not read saved secrets."); }
+        public void Set(string apiKey) => metadata = new(true);
+        public void Delete() => metadata = new(false);
+    }
+    private sealed class Provider : IQuotaProvider
+    {
+        public int Refreshes;
+        public QuotaStatus Status = QuotaStatus.Ok;
+        public QuotaSnapshot ReadCachedSnapshot() => new("commandcode", "Command Code", "official", Status, [], null, null, null, null, null, "command-code · local credentials", null, null, false);
+        public Task<QuotaSnapshot> RefreshAsync() { Refreshes++; return Task.FromResult(ReadCachedSnapshot()); }
+        public Task<QuotaSnapshot> RefreshStartupAsync() => RefreshAsync();
+        public void Cancel() { }
+        public void Dispose() { }
+    }
+    private static void RunSta(Action action)
+    {
+        Exception? failure = null;
+        var thread = new Thread(() => { try { action(); } catch (Exception error) { failure = error; } });
+        thread.SetApartmentState(ApartmentState.STA); thread.Start(); thread.Join();
+        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+    }
+}
