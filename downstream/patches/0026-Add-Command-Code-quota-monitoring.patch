+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemoteCommandCodeCredentialsTests
+{
+    [Fact]
+    public async Task SetGetDeleteAreCorrelatedAndNeverReadBackKey()
+    {
+        var commands = new List<string>();
+        using var session = new RemoteQuotaSession((line, _) => { commands.Add(line); return Task.FromResult(true); });
+        var saved = session.SetCommandCodeCredentialsAsync("only-on-stdin", default);
+        using (var command = JsonDocument.Parse(commands[0]))
+        {
+            Assert.Equal("commandcode_credentials", command.RootElement.GetProperty("type").GetString());
+            Assert.Equal("set", command.RootElement.GetProperty("operation").GetString());
+            Assert.Equal("only-on-stdin", command.RootElement.GetProperty("apiKey").GetString());
+            Assert.Equal(4, command.RootElement.EnumerateObject().Count());
+            Assert.False(command.RootElement.TryGetProperty("region", out _));
+        }
+        Assert.True(session.Receive(Reply("unrelated", true)));
+        Assert.False(saved.IsCompleted);
+        Assert.True(session.Receive(Reply(Id(commands[0]), true)));
+        Assert.Equal(new CommandCodeCredentialMetadata(true), await saved);
+        var get = session.GetCommandCodeCredentialsAsync(default);
+        AssertNoSecretFields(commands[1], "get");
+        session.Receive(Reply(Id(commands[1]), true));
+        Assert.True((await get).Configured);
+        var delete = session.DeleteCommandCodeCredentialsAsync(default);
+        AssertNoSecretFields(commands[2], "delete");
+        session.Receive(Reply(Id(commands[2]), false));
+        Assert.Equal(new CommandCodeCredentialMetadata(false), await delete);
+        Assert.True(session.Receive(Reply(Id(commands[2]), false)));
+    }
+
+    [Theory]
+    [InlineData("storage_error")]
+    [InlineData("invalid_request")]
+    [InlineData("secret-raw-error")]
+    public async Task ErrorsExposeOnlyFixedSafeMessages(string code)
+    {
+        string? command = null;
+        using var session = new RemoteQuotaSession((line, _) => { command = line; return Task.FromResult(true); });
+        var pending = session.GetCommandCodeCredentialsAsync(default);
+        session.Receive(JsonSerializer.Serialize(new { type = "commandcode_credentials_result", requestId = Id(command!), status = "error", errorCode = code, message = "secret-key/path/raw-exception", apiKey = "never-returned" }));
+        var error = await Assert.ThrowsAsync<IOException>(() => pending);
+        Assert.DoesNotContain("secret", error.ToString()); Assert.DoesNotContain("never-returned", error.ToString());
+        Assert.Null(error.InnerException);
+        Assert.Equal(code == "invalid_request"
+            ? "Remote key management rejected the request. Update the collector."
+            : "Remote Command Code key storage is unavailable.", error.Message);
+    }
+
+    [Fact]
+    public async Task CancellationDisconnectAndConnectionGenerationCannotCompleteNewRequest()
+    {
+        string? oldCommand = null;
+        using var oldSession = new RemoteQuotaSession((line, _) => { oldCommand = line; return Task.FromResult(true); });
+        using var cancel = new CancellationTokenSource();
+        var canceled = oldSession.GetCommandCodeCredentialsAsync(cancel.Token); cancel.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => canceled);
+        Assert.True(oldSession.Receive(Reply(Id(oldCommand!), true)));
+        var disconnected = oldSession.GetCommandCodeCredentialsAsync(default);
+        var staleId = Id(oldCommand!);
+        oldSession.Dispose();
+        await Assert.ThrowsAnyAsync<IOException>(() => disconnected);
+        string? newCommand = null;
+        using var newSession = new RemoteQuotaSession((line, _) => { newCommand = line; return Task.FromResult(true); });
+        var current = newSession.GetCommandCodeCredentialsAsync(default);
+        newSession.Receive(Reply(staleId, true)); Assert.False(current.IsCompleted);
+        newSession.Receive(Reply(Id(newCommand!), false)); Assert.False((await current).Configured);
+    }
+
+    [Fact]
+    public async Task OlderCollectorAndBlockedTransportTimeoutHonestly()
+    {
+        using var session = new RemoteQuotaSession((_, _) => Task.FromResult(true), credentialTimeout: TimeSpan.FromMilliseconds(20));
+        var error = await Assert.ThrowsAsync<TimeoutException>(() => session.GetCommandCodeCredentialsAsync(default));
+        Assert.Contains("Update the collector", error.Message);
+        using var blocked = new RemoteQuotaSession(async (_, token) => { await Task.Delay(Timeout.Infinite, token); return true; }, credentialTimeout: TimeSpan.FromMilliseconds(20));
+        await Assert.ThrowsAsync<TimeoutException>(() => blocked.GetCommandCodeCredentialsAsync(default));
+        using var disconnectBlocked = new RemoteQuotaSession(async (_, token) => { await Task.Delay(Timeout.Infinite, token); return true; });
+        var task = disconnectBlocked.GetCommandCodeCredentialsAsync(default);
+        disconnectBlocked.Dispose();
+        await Assert.ThrowsAnyAsync<IOException>(() => task);
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("has space")]
+    [InlineData("has\nnewline")]
+    [InlineData("非ASCII")]
+    public async Task InvalidKeysNeverEnterTransport(string key)
+    {
+        var calls = 0;
+        using var session = new RemoteQuotaSession((_, _) => { calls++; return Task.FromResult(true); });
+        await Assert.ThrowsAsync<ArgumentException>(() => session.SetCommandCodeCredentialsAsync(key, default));
+        Assert.Equal(0, calls);
+    }
+
+    [Fact]
+    public async Task MaximumEscapedAsciiKeyFitsExistingCommandBound()
+    {
+        string? command = null;
+        using var session = new RemoteQuotaSession((line, _) => { command = line; return Task.FromResult(true); });
+        var key = string.Concat(Enumerable.Repeat("\"\\<>'&", 682)) + "!!!!";
+        Assert.Equal(4096, key.Length);
+        var pending = session.SetCommandCodeCredentialsAsync(key, default);
+        Assert.True(Encoding.UTF8.GetByteCount(command!) < 16 * 1024);
+        using var parsed = JsonDocument.Parse(command!);
+        Assert.Equal(key, parsed.RootElement.GetProperty("apiKey").GetString());
+        session.Receive(Reply(Id(command!), true)); await pending;
+    }
+
+    private static string Id(string command)
+    {
+        using var document = JsonDocument.Parse(command);
+        var id = document.RootElement.GetProperty("requestId").GetString()!;
+        Assert.InRange(id.Length, 1, 128);
+        Assert.All(id, c => Assert.True(char.IsAsciiLetterOrDigit(c) || c is '_' or '-'));
+        return id;
+    }
+    private static string Reply(string id, bool configured) => JsonSerializer.Serialize(new { type = "commandcode_credentials_result", requestId = id, status = "ok", configured });
+    private static void AssertNoSecretFields(string command, string operation)
+    {
+        using var document = JsonDocument.Parse(command);
+        Assert.Equal(operation, document.RootElement.GetProperty("operation").GetString());
+        Assert.False(document.RootElement.TryGetProperty("apiKey", out _));
+        Assert.False(document.RootElement.TryGetProperty("region", out _));
+        Assert.Equal(3, document.RootElement.EnumerateObject().Count());
+    }
+}
