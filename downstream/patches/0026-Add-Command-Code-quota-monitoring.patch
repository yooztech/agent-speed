+
+    public QuotaSnapshot ReadCachedSnapshot()
+    {
+        lock (gate)
+        {
+            if (disposed) return Empty(QuotaStatus.NeedsAuth, block: SignInReason);
+            if (ReadCredentials() is not { } credential) return Empty(QuotaStatus.NeedsAuth, block: SignInReason);
+            var schedule = GetSchedule(credential.Key);
+            if (schedule.RejectedToken == credential.Key) return Empty(QuotaStatus.NeedsAuth, block: RejectedReason);
+            if (schedule.UnsupportedReason is { } reason && schedule.NextAllowedAt is { } until && now() < until)
+                return Empty(QuotaStatus.Unsupported, until, reason);
+            return StaleOrError(schedule);
+        }
+    }
+
+    public Task<QuotaSnapshot> RefreshAsync() => StartRefresh();
+    public Task<QuotaSnapshot> RefreshStartupAsync() => StartRefresh();
+
+    private Task<QuotaSnapshot> StartRefresh()
+    {
+        lock (gate)
+        {
+            if (disposed) return Task.FromResult(Empty(QuotaStatus.Error));
+            if (inFlight is { IsCompleted: false }) return inFlight;
+            activeCancellation?.Dispose();
+            activeCancellation = new CancellationTokenSource();
+            return inFlight = RefreshCoreAsync(activeCancellation.Token);
+        }
+    }
+
+    public void Cancel() { lock (gate) activeCancellation?.Cancel(); }
+    public void Dispose() { lock (gate) { disposed = true; activeCancellation?.Cancel(); client.Dispose(); } }
+
+    private async Task<QuotaSnapshot> RefreshCoreAsync(CancellationToken cancellationToken)
+    {
+        if (ReadCredentials() is not { } credential) return Empty(QuotaStatus.NeedsAuth, block: SignInReason);
+        var key = credential.Key;
+        Schedule schedule;
+        lock (gate)
+        {
+            schedule = GetSchedule(key).Copy();
+            if (schedule.RejectedToken == key) return Empty(QuotaStatus.NeedsAuth, block: RejectedReason);
+            if (schedule.UnsupportedReason is { } reason && schedule.NextAllowedAt is { } until && now() < until)
+                return Empty(QuotaStatus.Unsupported, until, reason);
+            if (schedule.NextAllowedAt is { } next && now() < next) return StaleOrError(schedule);
+            schedule.UnsupportedReason = null;
+        }
+        QuotaSnapshot result;
+        try
+        {
+            var whoami = await Get(WhoAmI, credential.Token, cancellationToken).ConfigureAwait(false);
+            var orgId = Organization(whoami);
+            var credits = await Get(Billing("credits", orgId), credential.Token, cancellationToken).ConfigureAwait(false);
+            var subscriptions = await Get(Billing("subscriptions", orgId), credential.Token, cancellationToken).ConfigureAwait(false);
+            result = Parse(whoami, credits, subscriptions, now());
+            if (result.Status == QuotaStatus.Unsupported) RejectPlan(schedule, result.Block ?? NoMeteredUsageReason);
+            else
+            {
+                schedule.Snapshot = result;
+                schedule.NextAllowedAt = null;
+                schedule.Failures = 0;
+                schedule.ColdFailures = 0;
+            }
+            result = result with { NextAllowedAt = schedule.NextAllowedAt };
+        }
+        catch (HttpStatusException error)
+        {
+            var completed = now();
+            if (error.Status is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+            {
+                schedule.Snapshot = null;
+                schedule.UnsupportedReason = null;
+                schedule.NextAllowedAt = null;
+                schedule.Failures = 0;
+                schedule.ColdFailures = 0;
+                schedule.RejectedToken = key;
+                result = Empty(QuotaStatus.NeedsAuth, block: RejectedReason);
+            }
+            else if (error.Status == HttpStatusCode.NotFound)
