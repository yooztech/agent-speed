+import Foundation
+import Testing
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+private final class ControllerCommandCodeStore: CommandCodeAPIKeyStoring, @unchecked Sendable {
+    private let lock = NSLock()
+    private var value: CommandCodeAPIKey?
+    func read() -> CommandCodeAPIKey? { lock.withLock { value } }
+    func save(apiKey: String) throws {
+        let newValue = try CommandCodeAPIKey(apiKey: apiKey, revision: CommandCodeAPIKey.randomRevision())
+        lock.withLock { value = newValue }
+    }
+    func delete() { lock.withLock { value = nil } }
+    func current() -> CommandCodeAPIKey? { lock.withLock { value } }
+}
+
+private final class ControllerCommandCodeHTTP: @unchecked Sendable {
+    private let lock = NSLock()
+    private var calls = 0
+    func count() -> Int { lock.withLock { calls } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock { calls += 1 }
+        let body: String
+        switch request.url?.path {
+        case "/alpha/whoami": body = #"{"org":{"id":"org-1","login":"octo"},"user":{"userName":"octocat"}}"#
+        case "/alpha/billing/credits": body = #"{"credits":{"monthlyCredits":70,"monthlyCreditsGranted":100,"planId":"pro"}}"#
+        default: body = #"{"planId":"Pro","currentPeriodStart":"2027-01-01T00:00:00Z","currentPeriodEnd":"2027-02-01T00:00:00Z"}"#
+        }
+        return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!)
+    }
+}
+
+@MainActor
+private final class CommandCodeControllerFixture {
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let directory: URL
+    let store = ControllerCommandCodeStore()
+    let http = ControllerCommandCodeHTTP()
+    let provider: CommandCodeQuotaProvider
+    let controller: QuotaController
+    init(selected: Bool = false) throws {
+        defaults = UserDefaults(suiteName: suite)!
+        defaults.set(false, forKey: "quota.autoRefreshEnabled")
+        defaults.set(false, forKey: "quota.allSourcesEnabled")
+        defaults.set(selected ? ["commandcode"] : [], forKey: "quota.enabledProviderIDs")
+        directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let http = self.http
+        provider = CommandCodeQuotaProvider(environment: [:],
+            authURL: directory.appendingPathComponent("absent-cli.json"),
+            cacheDirectory: directory.appendingPathComponent("cache"), keyStore: store,
+            now: { Date(timeIntervalSince1970: 1_800_000_000) }, transport: { http.fetch($0) })
+        controller = QuotaController(defaults: defaults, providers: [provider], commandCodeKeyStore: store)
+    }
+    func clean() {
+        controller.dispose()
+        defaults.removePersistentDomain(forName: suite)
+        try? FileManager.default.removeItem(at: directory)
+    }
+}
+
+@Suite("Command Code key settings controller")
