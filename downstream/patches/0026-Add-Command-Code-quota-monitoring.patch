+        new HttpClient(new HttpClientHandler { AllowAutoRedirect = false }), () => DateTimeOffset.UtcNow,
+        () => Environment.GetEnvironmentVariable("COMMAND_CODE_API_KEY")) { }
+
+    internal CommandCodeQuotaProvider(string credentialPath, string scheduleDirectory, HttpClient client, Func<DateTimeOffset> now,
+        Func<string?>? apiKeyFromEnvironment = null)
+    {
+        this.credentialPath = credentialPath;
+        this.scheduleDirectory = scheduleDirectory;
+        this.client = client;
+        this.now = now;
+        this.apiKeyFromEnvironment = apiKeyFromEnvironment ?? (() => Environment.GetEnvironmentVariable("COMMAND_CODE_API_KEY"));
+    }
+
+    internal static string CredentialsPath() => Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".commandcode", "auth.json");
+
+    private sealed record Credential(string Token)
+    {
+        public string Key => Digest(Token);
+    }
+
+    private Credential? ReadCredentials()
