+using System.Globalization;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class CommandCodeQuotaProviderTests
+{
+    private static readonly DateTimeOffset Time = new(2026, 11, 15, 0, 0, 0, TimeSpan.Zero);
+    private const string Whoami = """{"org":{"id":"org_123","login":"Acme"},"user":{"userName":"casey"}}""";
+    private const string Credits = """
+        {"credits":{"monthlyCredits":75,"monthlyCreditsGranted":100,"purchasedCredits":5,"freeCredits":2.5,"planId":"individual-pro"},
+        "windowLimits":{"weekly":{"used":3,"cap":10,"resetAt":1795305600000},
+        "fiveHour":{"used":12,"cap":10,"resetAt":1794718800000}}}
+        """;
+    private const string Subscription = """
+        {"data":{"planId":"individual-pro","status":"active","currentPeriodStart":"2026-11-01T00:00:00Z","currentPeriodEnd":"2026-12-01T00:00:00Z"}}
+        """;
+
+    [Fact]
+    public void ParserKeepsMonthlyWeeklyAndFiveHourWindowsWithExtraCreditsSeparate()
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse(Whoami, Credits, Subscription, Time);
+        Assert.Equal("commandcode", snapshot.Id);
+        Assert.Equal("Command Code", snapshot.DisplayName);
+        Assert.Equal("command-code · local credentials", snapshot.Source);
+        Assert.Equal(QuotaStatus.Ok, snapshot.Status);
+        Assert.Equal("Acme", snapshot.Account);
+        Assert.Null(snapshot.AccountIdentity);
+        Assert.Equal("Pro", snapshot.Plan);
+        Assert.Equal("monthly", snapshot.HeadlineId);
+        Assert.Equal(3, snapshot.Windows.Count);
+
+        var monthly = Assert.Single(snapshot.Windows, window => window.Id == "monthly");
+        Assert.Equal("Monthly limit", monthly.Label);
+        Assert.Equal(.25, monthly.UsedFraction);
+        Assert.Equal(.75, monthly.Remaining);
+        Assert.Equal(.25, monthly.Used);
+        Assert.Equal(DateTimeOffset.Parse("2026-12-01T00:00:00Z"), monthly.ResetAt);
+        Assert.Equal(TimeSpan.FromDays(30), monthly.Duration);
+
+        var weekly = Assert.Single(snapshot.Windows, window => window.Id == "weekly");
+        Assert.Equal("Weekly limit", weekly.Label);
+        Assert.Equal(.3, weekly.UsedFraction);
+        Assert.Equal(.7, weekly.Remaining!.Value, 12);
+        Assert.Equal(TimeSpan.FromDays(7), weekly.Duration);
+        Assert.Equal(DateTimeOffset.Parse("2026-11-22T00:00:00Z"), weekly.ResetAt);
+
+        var fiveHour = Assert.Single(snapshot.Windows, window => window.Id == "fiveHour");
+        Assert.Equal("5h limit", fiveHour.Label);
+        Assert.Equal(1.2, fiveHour.UsedFraction!.Value, 12);
+        Assert.Equal(-.2, fiveHour.Remaining!.Value, 12);
+        Assert.Equal(TimeSpan.FromHours(5), fiveHour.Duration);
+        Assert.Equal(DateTimeOffset.Parse("2026-11-15T05:00:00Z"), fiveHour.ResetAt);
+
+        var credits = Assert.IsType<QuotaCredits>(snapshot.Credits);
+        Assert.Equal("7.5", credits.Balance);
+        Assert.True(credits.HasCredits);
+        Assert.False(credits.Unlimited);
+        Assert.Null(credits.Limit);
+        Assert.Null(credits.Used);
+        Assert.Null(credits.UsedFraction);
+        Assert.Null(credits.ResetAt);
+        Assert.DoesNotContain(snapshot.Windows, window => window.Label.Contains("credit", StringComparison.OrdinalIgnoreCase));
+    }
+
+    [Fact]
+    public void ZeroAndOverLimitValuesSurviveWithoutClamping()
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse("""{"org":{"login":"Acme"}}""",
+            """{"credits":{"monthlyCredits":150,"monthlyCreditsGranted":100},"windowLimits":{"weekly":{"used":0,"cap":10},"fiveHour":{"used":99,"cap":10,"resetAt":0}}}""",
+            """{"planId":"individual-max-20x","currentPeriodStart":"2026-11-01T00:00:00Z","currentPeriodEnd":"2026-12-01T00:00:00Z"}""", Time);
+        var monthly = Assert.Single(snapshot.Windows, window => window.Id == "monthly");
+        Assert.Equal(-.5, monthly.UsedFraction);
+        Assert.Equal(1.5, monthly.Remaining);
+        var weekly = Assert.Single(snapshot.Windows, window => window.Id == "weekly");
+        Assert.Equal(0, weekly.UsedFraction);
+        Assert.Equal(1, weekly.Remaining);
+        Assert.Null(weekly.ResetAt);
+        var fiveHour = Assert.Single(snapshot.Windows, window => window.Id == "fiveHour");
+        Assert.Equal(9.9, fiveHour.UsedFraction!.Value, 12);
+        Assert.Equal(-8.9, fiveHour.Remaining!.Value, 12);
+        Assert.Null(fiveHour.ResetAt);
+        Assert.Equal("Max 20x", snapshot.Plan);
+        Assert.Equal("monthly", snapshot.HeadlineId);
+    }
+
+    [Theory]
+    [InlineData("individual-go", 10)]
+    [InlineData("individual-go-v1", 10)]
+    [InlineData("individual-goat", 100)]
+    [InlineData("individual-pro", 110)]
+    [InlineData("individual-provider", 15)]
+    [InlineData("individual-max-10x", 150)]
+    [InlineData("individual-max-20x", 300)]
+    [InlineData("team-pro", 40)]
+    public void KnownPlansSupplyOnlyTheDocumentedMonthlyAllowance(string plan, double grant)
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse("""{}""",
+            $$$$"""{"credits":{"monthlyCredits":{{{{(grant / 2).ToString(CultureInfo.InvariantCulture)}}}}}}""",
+            $$$$"""{"data":{"planId":"{{{{plan}}}}"}}""", Time);
+        var monthly = Assert.Single(snapshot.Windows);
+        Assert.Equal(.5, monthly.UsedFraction);
+        Assert.Equal(.5, monthly.Remaining);
+    }
+
+    [Fact]
+    public void UltraIsNamedButNeverGivenAnInventedMonthlyAllowance()
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse("""{}""",
+            """{"credits":{"monthlyCredits":20}}""", """{"data":{"planId":"individual-ultra"}}""", Time);
+        Assert.Equal(QuotaStatus.Unsupported, snapshot.Status);
+        Assert.Empty(snapshot.Windows);
+        Assert.Null(snapshot.ObservedAt);
+        Assert.Equal("Ultra", snapshot.Plan);
+        Assert.Null(snapshot.Credits);
+    }
+
+    [Fact]
+    public void MonthlyOnlyNeverCreatesACreditsFooter()
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse("""{}""",
+            """{"credits":{"monthlyCredits":75}}""", """{"data":{"planId":"individual-pro"}}""", Time);
+        Assert.Single(snapshot.Windows, window => window.Id == "monthly");
+        Assert.Null(snapshot.Credits);
+    }
+
+    [Fact]
+    public void ReturnedGrantAndUnknownPlanNeverInventMonthlyPercentage()
+    {
+        var overridden = CommandCodeQuotaProvider.Parse("""{}""",
+            """{"credits":{"monthlyCredits":25,"monthlyCreditsGranted":50}}""", """{"data":{"planId":"individual-pro"}}""", Time);
+        Assert.Equal(.5, Assert.Single(overridden.Windows, window => window.Id == "monthly").UsedFraction);
+
+        var unknown = CommandCodeQuotaProvider.Parse("""{}""",
+            """{"credits":{"monthlyCredits":20}}""", """{"data":{"planId":"mystery"}}""", Time);
+        Assert.Equal(QuotaStatus.Unsupported, unknown.Status);
+        Assert.Empty(unknown.Windows);
+        Assert.Null(unknown.HeadlineId);
+        Assert.Null(unknown.ObservedAt);
+        Assert.Equal("mystery", unknown.Plan);
+        Assert.Null(unknown.Credits);
+    }
+
+    [Fact]
+    public void CreditsOnlyAndNoCreditsAreDifferentObservations()
+    {
+        var zero = CommandCodeQuotaProvider.Parse("""{}""", """{"credits":{"monthlyCredits":0}}""", """{}""", Time);
+        Assert.Equal(QuotaStatus.Unsupported, zero.Status);
+        Assert.Empty(zero.Windows);
+        Assert.Null(zero.HeadlineId);
+        Assert.Null(zero.ObservedAt);
+        Assert.Null(zero.Credits);
+
+        var empty = CommandCodeQuotaProvider.Parse("""{}""", """{"credits":{},"windowLimits":{}}""", """{}""", Time);
+        Assert.Equal(QuotaStatus.Unsupported, empty.Status);
+        Assert.Empty(empty.Windows);
+        Assert.Null(empty.Credits);
+        Assert.Equal(CommandCodeQuotaProvider.NoMeteredUsageReason, empty.Block);
+    }
+
+    [Fact]
+    public void SubscriptionMayBeRootAndAccountFallsBackToUserName()
+    {
+        var snapshot = CommandCodeQuotaProvider.Parse("""{"org":{"id":"o"},"user":{"userName":"casey"}}""",
+            """{"credits":{"monthlyCredits":10,"monthlyCreditsGranted":20}}""",
+            """{"planId":"individual-goat","currentPeriodStart":"2026-11-01T00:00:00Z","currentPeriodEnd":"2026-11-30T00:00:00Z"}""", Time);
+        Assert.Equal("casey", snapshot.Account);
+        Assert.Equal("GOAT", snapshot.Plan);
+        Assert.Equal(TimeSpan.FromDays(29), Assert.Single(snapshot.Windows).Duration);
+    }
+
+    [Theory]
+    [InlineData("not json")]
+    [InlineData("[]")]
+    public void MalformedDocumentsAreDecodeFailuresNotZero(string json) =>
+        Assert.ThrowsAny<JsonException>(() => CommandCodeQuotaProvider.Parse(json, json, json, Time));
+
+    [Fact]
+    public async Task EnvironmentKeyWinsAndWhitespaceFallsBackToTheReadOnlyFile()
+    {
+        using var fixture = new Fixture();
+        using (var provider = fixture.Provider(() => "  environment-key  "))
+        {
+            var snapshot = await provider.RefreshAsync();
+            Assert.Equal(QuotaStatus.Ok, snapshot.Status);
+            Assert.Equal("environment-key", fixture.Handler.Token);
+            Assert.Equal(new[] { "/alpha/whoami", "/alpha/billing/credits", "/alpha/billing/subscriptions" },
+                fixture.Handler.Paths.Select(path => path.Split('?')[0]));
+        }
+        fixture.Handler.Token = null;
+        using (var provider = fixture.Provider(() => "   "))
+        {
+            Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+            Assert.Equal("file-key", fixture.Handler.Token);
+        }
+        Assert.Equal(6, fixture.Handler.Calls);
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("{}")]
+    [InlineData("""{"apiKey":""}""")]
+    [InlineData("""{"apiKey":123}""")]
+    [InlineData("[]")]
+    [InlineData("not json")]
+    public async Task MissingOrMalformedAuthNeedsSignInWithoutHttp(string? content)
+    {
+        using var fixture = new Fixture();
+        if (content is not null) File.WriteAllText(fixture.Auth, content);
+        else File.Delete(fixture.Auth);
