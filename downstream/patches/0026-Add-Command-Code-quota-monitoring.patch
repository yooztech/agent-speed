+public sealed class CommandCodeQuotaProvider : IQuotaProvider
+{
+    private static readonly Uri WhoAmI = new("https://api.commandcode.ai/alpha/whoami?limits=1");
+    private static readonly Uri Origin = new("https://api.commandcode.ai");
+    public const string SignInReason = "Command Code credentials not found. Sign in with the Command Code CLI or set COMMAND_CODE_API_KEY.";
+    public const string RejectedReason = "Command Code credentials were rejected. Sign in again or set a new COMMAND_CODE_API_KEY.";
+    public const string NoSubscriptionReason = "No Command Code subscription on this account";
+    public const string NoMeteredUsageReason = "Command Code has no usage limits on this account yet";
+    private const string Source = "command-code · local credentials";
+    private readonly string credentialPath, scheduleDirectory;
+    private readonly HttpClient client;
+    private readonly Func<DateTimeOffset> now;
+    private readonly Func<string?> apiKeyFromEnvironment;
+    private readonly object gate = new();
+    private readonly Dictionary<string, Schedule> schedules = new(StringComparer.Ordinal);
+    private Task<QuotaSnapshot>? inFlight;
+    private CancellationTokenSource? activeCancellation;
+    private bool disposed;
+
+    public CommandCodeQuotaProvider() : this(CredentialsPath(),
