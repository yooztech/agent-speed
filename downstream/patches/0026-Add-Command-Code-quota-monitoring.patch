+CommandCodeProfile parseCommandCodeProfile(const std::string& json) {
+    Document doc; if (json.size() > kBody || !doc.parse(json) || !doc.root().isObject()) throw std::runtime_error("quota response");
+    auto root = doc.root(); CommandCodeProfile profile;
+    if (auto id = scalar(root["org"]["id"]); id && header(*id)) profile.organization = *id;
+    for (auto candidate : {text(root["org"]["login"]), text(root["user"]["userName"])}) {
+        if (!profile.account && candidate && header(*candidate)) {
+            auto value = trim(*candidate);
+            if (!value.empty()) profile.account = std::move(value.substr(0, 120));
+        }
+    }
+    return profile;
+}
+std::string commandCodeUrl(const std::string& path, const std::string& organization) {
+    std::string url = "https://api.commandcode.ai" + path;
+    if (!organization.empty()) url += (path.find('?') == std::string::npos ? "?" : "&") + std::string("orgId=") + queryEscape(organization);
+    return url;
+}
+Snapshot parseCommandCode(const std::string& whoami, const std::string& credits, const std::string& subscriptions, std::int64_t now) {
+    auto profile = parseCommandCodeProfile(whoami);
+    Document creditDoc, subscriptionDoc;
+    if (credits.size() > kBody || !creditDoc.parse(credits) || !creditDoc.root().isObject() ||
+        subscriptions.size() > kBody || !subscriptionDoc.parse(subscriptions) || !subscriptionDoc.root().isObject())
+        throw std::runtime_error("quota response");
+    auto creditRoot = creditDoc.root(), subscriptionRoot = subscriptionDoc.root();
+    // Billing routes answer at the root or under a data envelope depending on the
+    // alpha revision; the documented fields may live on the credits object.
+    auto envelope = creditRoot["data"];
+    auto creditsData = creditRoot["credits"];
+    if (!creditsData.isObject()) creditsData = envelope["credits"];
+    auto field = [&](const char* name) {
+        auto value = creditsData[name];
+        if (!value.valid() || value.isNull()) value = envelope[name];
+        if (!value.valid() || value.isNull()) value = creditRoot[name];
+        return value;
+    };
+    auto subscriptionValue = subscriptionRoot["data"].isObject() ? subscriptionRoot["data"] : subscriptionRoot;
+    std::optional<std::string> plan;
+    for (auto candidate : {text(subscriptionValue["planId"]), text(creditsData["planId"]), text(creditRoot["planId"]), text(envelope["planId"])}) {
+        if (candidate && !candidate->empty()) { plan = candidate; break; }
+    }
+    auto monthly = number(field("monthlyCredits"), true);
+    auto granted = number(field("monthlyCreditsGranted"), true);
+    auto purchased = number(field("purchasedCredits"), true);
+    auto free = number(field("freeCredits"), true);
+    auto parsedPlan = commandCodePlan(plan);
+    std::optional<double> grant = granted && *granted >= 0 ? granted : parsedPlan.credits;
+    Snapshot s = empty("commandcode", "ok");
+    s.account = profile.account; s.plan = parsedPlan.name;
+    const auto periodEnd = date(subscriptionValue["currentPeriodEnd"]);
+    if (grant && *grant > 0 && monthly) {
+        const double usedFraction = (*grant - *monthly) / *grant;
+        std::optional<double> duration;
+        if (auto start = date(subscriptionValue["currentPeriodStart"]); start && periodEnd && *periodEnd > *start)
+            duration = static_cast<double>(*periodEnd - *start) / 1000.0;
+        s.windows.push_back(window("monthly", "Monthly limit", usedFraction, periodEnd, duration));
+        s.headlineId = "monthly";
+    }
+    auto windowLimits = creditRoot["windowLimits"].isObject() ? creditRoot["windowLimits"] : creditsData["windowLimits"];
+    if (!windowLimits.isObject()) windowLimits = envelope["windowLimits"];
+    struct Rolling { const char* key; const char* id; const char* label; double duration; };
+    for (auto rolling : {Rolling{"weekly", "weekly", "Weekly limit", 604800}, Rolling{"fiveHour", "fiveHour", "5h limit", 18000}}) {
+        auto limits = windowLimits[rolling.key];
+        auto used = number(limits["used"], true), cap = number(limits["cap"], true);
+        if (!used || !cap || *cap <= 0) continue;
+        const double usedFraction = *used / *cap;
+        s.windows.push_back(window(rolling.id, rolling.label, usedFraction, milliseconds(limits["resetAt"]), rolling.duration));
+        if (!s.headlineId) s.headlineId = rolling.id;
+        else if (std::string(rolling.id) == "fiveHour" && s.headlineId == "weekly") s.headlineId = "fiveHour";
+    }
+    // Extras are an on-demand balance, never a fabricated window or reset, and
+    // never an additional credits object when only included monthly credits exist.
+    const bool hasExtras = purchased.has_value() || free.has_value();
+    if (hasExtras) {
+        const double extras = purchased.value_or(0) + free.value_or(0);
+        Credits value;
+        value.hasCredits = (monthly.value_or(0) + extras) > 0;
+        value.unlimited = false;
+        value.balance = Json::number(extras, 8);
+        s.credits = value;
+    }
+    if (s.windows.empty() && !hasExtras) {
+        s.status = "unsupported"; s.block = "Command Code has no usage limits on this account yet";
+        return s;
+    }
+    s.observedAt = now;
+    return s;
+}
