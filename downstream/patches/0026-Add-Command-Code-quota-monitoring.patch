+import Foundation
+import Testing
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+@testable import AgentSpeedCore
+
+private final class CommandCodeFixture: @unchecked Sendable {
+    static let whoami = "/alpha/whoami"
+    static let credits = "/alpha/billing/credits"
+    static let subscriptions = "/alpha/billing/subscriptions"
+    private let lock = NSLock()
+    private var time = Date(timeIntervalSince1970: 1_800_000_000)
+    private var requests: [URLRequest] = []
+    private var queues: [String: [Int]] = [:]
+    private var defaults: [String: Int] = [
+        CommandCodeFixture.whoami: 200, CommandCodeFixture.credits: 200, CommandCodeFixture.subscriptions: 200
+    ]
+    private var retry: [String: String] = [:]
+    private var bodies: [String: String] = [
+        CommandCodeFixture.whoami: #"{"org":{"id":"org-1","login":"octo"},"user":{"userName":"octocat"}}"#,
+        CommandCodeFixture.credits: #"{"credits":{"monthlyCredits":70,"monthlyCreditsGranted":100,"purchasedCredits":3.5,"freeCredits":1.5,"planId":"pro","windowLimits":{"weekly":{"used":30,"cap":100,"resetAt":1800604800000},"fiveHour":{"used":2,"cap":10,"resetAt":1800003600000}}}}"#,
+        CommandCodeFixture.subscriptions: #"{"planId":"Pro","status":"active","currentPeriodStart":"2027-01-01T00:00:00Z","currentPeriodEnd":"2027-02-01T00:00:00Z"}"#
+    ]
+
+    func now() -> Date { lock.withLock { time } }
+    func advance(_ seconds: TimeInterval) { lock.withLock { time = time.addingTimeInterval(seconds) } }
+    func captured() -> [URLRequest] { lock.withLock { requests } }
+    func polls() -> Int { lock.withLock { requests.filter { $0.url?.path == Self.whoami }.count } }
+    func respond(_ status: Int, path: String = CommandCodeFixture.whoami) { lock.withLock { defaults[path] = status } }
+    func enqueue(_ status: Int, path: String) { lock.withLock { queues[path, default: []].append(status) } }
+    func retryAfter(_ value: String, path: String = CommandCodeFixture.whoami) { lock.withLock { retry[path] = value } }
+    func body(_ value: String, path: String) { lock.withLock { bodies[path] = value } }
+
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock {
+            requests.append(request)
+            let path = request.url!.path
+            let status: Int
+            if var queue = queues[path], !queue.isEmpty {
+                status = queue.removeFirst()
+                queues[path] = queue
+            } else {
+                status = defaults[path] ?? 200
+            }
+            let body = bodies[path] ?? "{}"
+            return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil,
+                                                     headerFields: retry[path].map { ["Retry-After": $0] })!)
+        }
+    }
+}
+
+private actor CommandCodeGate {
+    private var release: CheckedContinuation<Void, Never>?
+    let entered: AsyncStream<Void>
+    private let events: AsyncStream<Void>.Continuation
+
+    init() {
+        let stream = AsyncStream<Void>.makeStream()
+        entered = stream.stream
+        events = stream.continuation
+    }
+
+    func suspend() async {
+        await withCheckedContinuation { continuation in
+            release = continuation
+            events.yield(())
+        }
+    }
+
+    func resume() {
+        release?.resume()
+        release = nil
+        events.finish()
+    }
+}
+
+@Suite("Command Code quota")
+struct CommandCodeQuotaProviderTests {
+    private func temporaryDirectory() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    private func writeAuth(_ directory: URL, token: String = "command-key") throws {
+        try JSONSerialization.data(withJSONObject: ["apiKey": token])
+            .write(to: directory.appendingPathComponent("auth.json"), options: .atomic)
+    }
+
+    private func provider(_ directory: URL, _ fixture: CommandCodeFixture,
+                          environment: [String: String] = [:]) -> CommandCodeQuotaProvider {
+        CommandCodeQuotaProvider(environment: environment, authURL: directory.appendingPathComponent("auth.json"),
+                                 cacheDirectory: directory.appendingPathComponent("cache"),
+                                 now: { fixture.now() }, transport: { fixture.fetch($0) })
+    }
+
+    private func parse(_ whoami: String? = nil, credits: String, subscription: String = "{}") throws -> QuotaSnapshot {
+        try CommandCodeUsage.parse(whoami: Data((whoami ?? #"{"org":{"id":"org-1","login":"octo"},"user":{"userName":"octocat"}}"#).utf8),
+                                   credits: Data(credits.utf8), subscription: Data(subscription.utf8),
+                                   at: Date(timeIntervalSince1970: 1_800_000_000))
+    }
+
+    @Test func registryOffersCommandCodeAsTheFourthLocalProvider() {
+        #expect(QuotaProviderRegistry.makeProviders().map(\.id) == ["codex", "opencode-go", "kimi", "commandcode"])
+        #expect(QuotaSourceIdentity.providers == ["codex", "opencode-go", "kimi", "commandcode"])
+        #expect(CommandCodeCredentials.authURL(home: URL(fileURLWithPath: "/Users/example"))
+            == URL(fileURLWithPath: "/Users/example/.commandcode/auth.json"))
+    }
+
+    @Test func monthlyWeeklyAndFiveHourMapWithoutClampingAndKeepExtrasSeparate() throws {
+        let value = try parse(credits: #"{"credits":{"monthlyCredits":70,"monthlyCreditsGranted":100,"purchasedCredits":3.5,"freeCredits":1.5,"planId":"pro","windowLimits":{"weekly":{"used":30,"cap":100,"resetAt":1800604800000},"fiveHour":{"used":2,"cap":10,"resetAt":1800003600000}}}}"#,
+                              subscription: #"{"planId":"Pro","currentPeriodStart":"2027-01-01T00:00:00Z","currentPeriodEnd":"2027-02-01T00:00:00Z"}"#)
+        #expect(value.id == "commandcode" && value.displayName == "Command Code")
+        #expect(value.source == "command-code · local credentials")
+        #expect(value.status == .ok && value.account == "octo" && value.plan == "Pro")
+        #expect(value.windows.map(\.id) == ["monthly", "weekly", "fiveHour"])
+        #expect(value.windows.map(\.label) == ["Monthly limit", "Weekly limit", "5h limit"])
+        #expect(value.windows.map(\.duration) == [2_678_400, 604_800, 18_000])
+        #expect(value.headlineId == "monthly")
+        #expect(value.windows[0].usedFraction == 0.3 && value.windows[0].remaining == 0.7)
+        #expect(value.windows[0].used == 0.3 && value.windows[1].used == 0.3)
+        #expect(value.windows[1].usedFraction == 0.3 && value.windows[1].remainingFraction == 0.7)
+        #expect(value.windows[2].usedFraction == 0.2 && value.windows[2].remaining == 0.8)
+        #expect(value.windows[0].resetAt == ISO8601DateFormatter().date(from: "2027-02-01T00:00:00Z"))
+        #expect(value.windows[1].resetAt == Date(timeIntervalSince1970: 1_800_604_800))
+        #expect(value.windows[2].resetAt == Date(timeIntervalSince1970: 1_800_003_600))
+        #expect(value.credits?.balance == "5")
+        #expect(value.credits?.hasCredits == true && value.credits?.unlimited == false)
+        #expect(value.credits?.limit == nil && value.credits?.used == nil)
+        #expect(value.credits?.usedFraction == nil && value.credits?.resetAt == nil)
+        #expect(value.accountIdentity == nil)
+    }
+
+    @Test func overuseKeepsExactFractionAndCreditsOnlySuccessHasNoFakeWindow() throws {
+        let overuse = try parse(credits: #"{"credits":{"monthlyCredits":0,"monthlyCreditsGranted":100,"windowLimits":{"weekly":{"used":125,"cap":100},"fiveHour":{"used":0,"cap":0}}}}"#)
+        #expect(overuse.windows.map(\.id) == ["monthly", "weekly"])
+        #expect(overuse.windows[0].usedFraction == 1 && overuse.windows[0].remaining == 0)
+        #expect(overuse.windows[1].usedFraction == 1.25 && overuse.windows[1].remaining == -0.25)
+        #expect(overuse.windows[1].resetAt == nil)
+        // Monthly-only readings never grow a redundant credit footer.
+        #expect(overuse.credits == nil)
+
+        let extras = try parse(credits: #"{"credits":{"purchasedCredits":2,"freeCredits":0.5}}"#)
+        #expect(extras.status == .ok && extras.windows.isEmpty && extras.headlineId == nil)
+        #expect(extras.credits?.balance == "2.5" && extras.credits?.hasCredits == true)
+        #expect(extras.credits?.limit == nil && extras.credits?.usedFraction == nil && extras.credits?.resetAt == nil)
+
+        // A monthly window alone must not create a credit footer.
+        let monthlyOnly = try parse(credits: #"{"credits":{"monthlyCredits":40}}"#,
+                                    subscription: #"{"planId":"individual-go"}"#)
+        #expect(monthlyOnly.windows.map(\.id) == ["monthly"])
+        #expect(monthlyOnly.credits == nil)
+
+        let zero = try parse(credits: #"{"credits":{"monthlyCredits":0,"purchasedCredits":0,"freeCredits":0}}"#)
+        #expect(zero.status == .ok && zero.windows.isEmpty)
+        #expect(zero.credits?.balance == "0" && zero.credits?.hasCredits == false)
+    }
+
+    @Test func planAllowanceFallbackMatchesPrefixedPlanIdsAndUnknownPlansNeverInventMonthly() throws {
+        // Plan ids are tier-prefixed in the wild; the allowance matches on the suffix.
+        let expected: [(String, Double, String)] = [
+            ("individual-go", 10, "Go"),
+            ("individual-go-v1", 10, "Go"),
+            ("individual-pro-v2", 110, "Pro"),
+            ("individual-max-10x-v12", 150, "Max 10x"),
+            ("individual-goat", 100, "GOAT"),
+            ("individual-pro", 110, "Pro"),
+            ("individual-provider", 15, "Provider"),
+            ("individual-max-10x", 150, "Max 10x"),
+            ("team-pro", 40, "Team Pro")
+        ]
+        for (planID, grant, name) in expected {
+            let value = try parse(credits: #"{"credits":{"monthlyCredits":\#(grant / 2)}}"#,
+                                  subscription: #"{"planId":"\#(planID)"}"#)
+            #expect(value.windows.map(\.id) == ["monthly"], "\(planID) must fall back to its plan allowance")
+            #expect(value.windows[0].usedFraction == 0.5, "\(planID) uses its own allowance")
+            #expect(value.plan == name)
+            #expect(value.credits == nil, "\(planID) monthly-only must not show a credit footer")
+        }
+        // Fields outside `data.credits` still count when the credits object exists.
+        let envelope = try parse(credits: #"{"data":{"credits":{"monthlyCredits":70},"monthlyCreditsGranted":100,"purchasedCredits":2,"windowLimits":{"weekly":{"used":25,"cap":100,"resetAt":1800604800000}}}}"#)
+        #expect(envelope.status == .ok && envelope.windows.map(\.id) == ["monthly", "weekly"])
+        #expect(envelope.windows[0].usedFraction == 0.3 && envelope.windows[0].used == 0.3)
+        #expect(envelope.windows[1].usedFraction == 0.25 && envelope.windows[1].used == 0.25)
+        #expect(envelope.credits?.balance == "2")
+
