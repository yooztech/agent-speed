+            var status = path.EndsWith("/whoami", StringComparison.Ordinal) || BillingStatus == 200 ? Status : BillingStatus;
+            var response = new HttpResponseMessage((HttpStatusCode)status);
+            if (status == 429 && Retry is { } seconds) response.Headers.RetryAfter = new RetryConditionHeaderValue(TimeSpan.FromSeconds(seconds));
