+            throw new IOException("Command Code source is no longer available.");
+        if (operation == "set" && !CommandCodeCredentials.ValidKey(apiKey))
+            throw new ArgumentException("Invalid Command Code key.");
+        if (operation is not ("get" or "set" or "delete")) throw new ArgumentException("Invalid Command Code credential operation.");
+        var mutation = new object();
+        if (operation != "get") _credentialOperations[source.Id] = mutation;
+        try
+        {
+            if (operation != "get") InvalidateCommandCodeSource(source.Id);
+            CommandCodeCredentialMetadata metadata;
+            if (source.Id == "commandcode")
+            {
+                if (operation == "set") _commandCodeKeys.Set(apiKey!);
+                else if (operation == "delete") _commandCodeKeys.Delete();
+                metadata = _commandCodeKeys.GetMetadata();
+            }
+            else
+            {
+                if (_remote is null || !QuotaProviders.TryRemoteSource(source.Id, out var host, out _)) throw new IOException("Remote collector is offline.");
+                metadata = await _remote.RequestCommandCodeCredentialsAsync(host, source.Destination!, operation, apiKey, cancellationToken);
+            }
+            apiKey = null;
+            cancellationToken.ThrowIfCancellationRequested();
+            if (operation == "get") return new(metadata, metadata.Configured ? "commandCodeConfigured" : "commandCodeNotConfigured");
+            if (!_credentialOperations.TryGetValue(source.Id, out var active) || !ReferenceEquals(active, mutation))
+                throw new OperationCanceledException();
+            InvalidateCommandCodeSource(source.Id);
+            if (operation == "delete") return new(metadata, "commandCodeRemoved");
+            if (!_settings.Current.NetworkEnabled) return new(metadata, "commandCodeSavedUnverified");
+            // Verify this destination alone, even if it is not enabled for quota display.
+            var owned = !_readers.TryGetValue(source.Id, out var reader);
+            var provider = reader?.Provider ?? _providerFactory(source.Id);
+            var generation = reader?.Generation;
+            var before = reader?.Snapshot ?? provider.ReadCachedSnapshot();
+            var startedAt = _now();
+            if (reader is not null) { reader.Busy = true; Render(); }
+            try
+            {
+                using var cancel = cancellationToken.Register(provider.Cancel);
+                var snapshot = await provider.RefreshAsync();
+                cancellationToken.ThrowIfCancellationRequested();
+                if (_disposed || !CommandCodeKeySources().Any(item => item.Id == source.Id && item.Destination == source.Destination))
+                    throw new IOException("Command Code source is no longer available.");
+                if (!_credentialOperations.TryGetValue(source.Id, out active) || !ReferenceEquals(active, mutation))
+                    throw new OperationCanceledException();
+                if (!_settings.Current.NetworkEnabled) return new(metadata, "commandCodeSavedUnverified");
+                if (reader is not null && reader.Generation == generation && _readers.TryGetValue(source.Id, out var current) && ReferenceEquals(reader, current))
+                {
+                    reader.Snapshot = snapshot;
+                    if (_settings.Current.AutoRefreshQuota)
+                    {
+                        reader.Retry.Complete(before, snapshot, startedAt, _now());
+                        ScheduleRetry(source.Id, reader);
+                    }
+                }
+                return new(metadata, snapshot.Status == QuotaStatus.Ok ? "commandCodeSavedVerified" :
+                    snapshot.Status is QuotaStatus.NeedsAuth or QuotaStatus.AccessDenied ? "commandCodeSavedRejected" : "commandCodeSavedUnverified");
+            }
+            finally
+            {
+                if (owned) provider.Dispose();
+                if (reader is not null && reader.Generation == generation) reader.Busy = false;
+                CollectSnapshots(); Render();
+            }
+        }
+        finally
+        {
+            if (_credentialOperations.TryGetValue(source.Id, out var current) && ReferenceEquals(current, mutation))
+                _credentialOperations.Remove(source.Id);
+        }
+    }
+
     private void SetSource(string id, bool enabled)
     {
         if (!_available.Any(p => p.Id == id)) return;
diff --git a/windows/tests/AgentSpeed.Core.Tests/CommandCodeApiKeyTests.cs b/windows/tests/AgentSpeed.Core.Tests/CommandCodeApiKeyTests.cs
new file mode 100644
index 00000000..f41fda3c
--- /dev/null
+++ b/windows/tests/AgentSpeed.Core.Tests/CommandCodeApiKeyTests.cs
@@ -0,0 +1,222 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class CommandCodeApiKeyTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 11, 18, 0, 0, 0, TimeSpan.Zero);
+    private const string Whoami = """{"org":{"id":"org_1","login":"Acme"}}""";
+    private const string Credits = """{"credits":{"monthlyCredits":75,"monthlyCreditsGranted":100}}""";
+    private const string Subscription = """{"data":{"planId":"individual-pro"}}""";
+
+    [Fact]
+    public async Task ManagedKeyWinsOverEnvironmentAndOfficialFileWithoutLeaking()
+    {
+        using var fixture = new Fixture();
+        fixture.Environment = "environment-key";
+        fixture.Store.Set("managed-key");
+        using var provider = fixture.Provider();
+        var result = await provider.RefreshAsync();
+        Assert.Equal(QuotaStatus.Ok, result.Status);
+        Assert.True(result.Configured);
+        Assert.Equal(3, fixture.Handler.Tokens.Count);
+        Assert.All(fixture.Handler.Tokens, token => Assert.Equal("managed-key", token));
+        var schedules = fixture.ScheduleFiles();
+        Assert.DoesNotContain("managed-key", string.Join("", schedules.Select(File.ReadAllText)));
+        Assert.DoesNotContain("managed-key", fixture.Store.Read()!.ToString());
+        Assert.DoesNotContain("managed-key", (await provider.RefreshAsync()).ToString());
+    }
+
+    [Fact]
+    public async Task EnvironmentThenOfficialFileAreUsedOnlyWithoutAManagedKey()
+    {
+        using var fixture = new Fixture();
+        fixture.Environment = "environment-key";
+        using (var provider = fixture.Provider())
+        {
+            Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+            Assert.All(fixture.Handler.Tokens, token => Assert.Equal("environment-key", token));
+        }
+        fixture.Environment = null;
+        fixture.Handler.Tokens.Clear();
+        using (var provider = fixture.Provider())
+        {
+            Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+            Assert.All(fixture.Handler.Tokens, token => Assert.Equal("cli-key", token));
+        }
+    }
+
+    [Theory]
+    [InlineData("malformed", CommandCodeQuotaProvider.KeyInvalidReason)]
+    [InlineData("missing-revision", CommandCodeQuotaProvider.KeyInvalidReason)]
+    [InlineData("unreadable", CommandCodeQuotaProvider.KeyStorageReason)]
+    public async Task ConfiguredButInvalidOrUnreadableNeverFallsBackToEnvironmentOrCli(string failure, string reason)
+    {
+        using var fixture = new Fixture();
+        fixture.Environment = "environment-key";
+        fixture.Store.Value = new(failure == "malformed" ? "key with space" : "key", failure == "missing-revision" ? "" : "revision");
+        fixture.Store.FailRead = failure == "unreadable";
+        using var provider = fixture.Provider();
+        var result = await provider.RefreshAsync();
+        Assert.Empty(result.Windows);
+        Assert.Equal(reason, result.Block);
+        Assert.Equal(0, fixture.Handler.Calls);
+        // The unusable store still identifies configuration, so the account card stays visible.
+        Assert.True(provider.ReadCachedSnapshot().Configured);
+    }
+
+    [Fact]
+    public async Task RejectionIsRevisionIsolatedAndResavingTheSameKeyResetsBackoff()
+    {
+        using var fixture = new Fixture();
+        fixture.Environment = "environment-key";
+        fixture.Store.Set("same-key");
+        fixture.Handler.Override = _ => new(HttpStatusCode.Unauthorized);
+        using var provider = fixture.Provider();
+        Assert.Equal(CommandCodeQuotaProvider.KeyRejectedReason, (await provider.RefreshAsync()).Block);
+        var calls = fixture.Handler.Calls;
+        await provider.RefreshAsync();
+        Assert.Equal(calls, fixture.Handler.Calls);
+        Assert.Equal(CommandCodeQuotaProvider.KeyRejectedReason, provider.ReadCachedSnapshot().Block);
+        fixture.Handler.Override = null;
+        fixture.Store.Set("same-key");
+        Assert.NotEqual(CommandCodeQuotaProvider.KeyRejectedReason, provider.ReadCachedSnapshot().Block);
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        Assert.Equal(3, fixture.Handler.Calls - calls);
+        fixture.Store.Delete();
+        fixture.Handler.Tokens.Clear();
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        Assert.All(fixture.Handler.Tokens, token => Assert.Equal("environment-key", token));
+    }
+
+    [Fact]
+    public async Task CredentialsChangedDiscardsEvenSameKeyReinstalledDuringRequest()
+    {
+        using var fixture = new Fixture();
+        fixture.Store.Set("same-key");
+        fixture.Handler.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var provider = fixture.Provider();
+        var old = provider.RefreshAsync();
+        fixture.Store.Set("same-key");
+        provider.CredentialsChanged();
+        fixture.Handler.Block.SetResult();
+        Assert.Empty((await old).Windows);
+        Assert.Empty(fixture.ScheduleFiles());
+        fixture.Handler.Block = null;
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        provider.CredentialsChanged();
+        fixture.Store.Delete();
+        Assert.Empty(provider.ReadCachedSnapshot().Windows);
+    }
+
+    [Fact]
+    public void ConfiguredReflectsAnySourceAndRemovingManagedKeyKeepsOfficialCredentials()
+    {
+        using var fixture = new Fixture();
+        File.Delete(Path.Combine(fixture.Root, "auth.json"));
+        using var provider = fixture.Provider();
+        Assert.False(provider.ReadCachedSnapshot().Configured);
+        fixture.Store.Set("managed-key");
+        Assert.True(provider.ReadCachedSnapshot().Configured);
+        fixture.Store.Delete();
+        Assert.False(provider.ReadCachedSnapshot().Configured);
+        File.WriteAllText(Path.Combine(fixture.Root, "auth.json"), JsonSerializer.Serialize(new { apiKey = "cli-key" }));
+        Assert.True(provider.ReadCachedSnapshot().Configured);
+        fixture.Environment = "environment-key";
+        Assert.True(provider.ReadCachedSnapshot().Configured);
+    }
+
+    [Fact]
+    public async Task DefaultConstructorLeavesAnAbsentManagedStoreToEnvironmentAndCli()
+    {
+        var defaultPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+            "AgentSpeed", "quota", "commandcode.key");
+        if (File.Exists(defaultPath)) return;
+        using var fixture = new Fixture();
+        fixture.Environment = "environment-key";
+        using var provider = fixture.Provider(keyStore: null);
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        Assert.All(fixture.Handler.Tokens, token => Assert.Equal("environment-key", token));
+    }
+
+    [Fact]
+    public void PortableStoreNeverWritesPlaintextAndUnreadablePresenceIsNotAbsence()
+    {
+        if (OperatingSystem.IsWindows()) return;
+        using var fixture = new Fixture();
+        var path = Path.Combine(fixture.Root, "secure.key");
+        var store = new CommandCodeCredentialStore(path);
+        Assert.False(store.GetMetadata().Configured);
+        Assert.Throws<CommandCodeCredentialException>(() => store.Set("never-plaintext"));
+        Assert.False(File.Exists(path));
+        File.WriteAllBytes(path, Header(Enumerable.Repeat((byte)7, 12).ToArray()));
+        Assert.True(store.GetMetadata().Configured);
+        Assert.Throws<CommandCodeCredentialException>(() => store.Read());
+        File.WriteAllBytes(path, [2, 1, 2]);
+        Assert.Throws<CommandCodeCredentialException>(() => store.GetMetadata());
+        File.WriteAllBytes(path, []);
+        Assert.Throws<CommandCodeCredentialException>(() => store.GetMetadata());
+    }
+
+    private static byte[] Header(byte[] payload) =>
+        [1, .. Enumerable.Range(0, 16).Select(index => (byte)index), .. payload];
+
+    private sealed class Store : ICommandCodeCredentialStore
+    {
+        public CommandCodeApiCredential? Value;
+        public bool FailRead;
+        public CommandCodeCredentialMetadata GetMetadata() => new(Value is not null);
+        public CommandCodeApiCredential? Read() => FailRead ? throw new CommandCodeCredentialException() : Value;
+        public void Set(string apiKey) => Value = new(apiKey, Guid.NewGuid().ToString("N"));
+        public void Delete() => Value = null;
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        public readonly string Root = Path.Combine(Path.GetTempPath(), "commandcode-key-tests-" + Guid.NewGuid().ToString("N"));
+        public readonly Store Store = new();
+        public readonly Handler Handler = new();
+        public string? Environment;
+        public DateTimeOffset Clock = Now;
+        public Fixture()
+        {
+            Directory.CreateDirectory(Root);
+            File.WriteAllText(Path.Combine(Root, "auth.json"), JsonSerializer.Serialize(new { apiKey = "cli-key" }));
+        }
+        public CommandCodeQuotaProvider Provider() => Provider(Store);
+        public CommandCodeQuotaProvider Provider(ICommandCodeCredentialStore? keyStore) => new(
+            Path.Combine(Root, "auth.json"), Path.Combine(Root, "schedule"),
+            new HttpClient(Handler, false), () => Clock, () => Environment, keyStore);
+        public string[] ScheduleFiles()
+        {
+            var directory = Path.Combine(Root, "schedule");
+            return Directory.Exists(directory) ? Directory.GetFiles(directory) : [];
+        }
+        public void Dispose() { Handler.Dispose(); Directory.Delete(Root, true); }
+    }
+
+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls;
+        public readonly List<string> Tokens = [];
+        public TaskCompletionSource? Block;
+        public Func<HttpRequestMessage, HttpResponseMessage>? Override;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Calls++;
+            Tokens.Add(request.Headers.Authorization?.Parameter ?? "");
+            // Intentionally ignore cancellation so the provider's commit-time generation check is exercised.
+            if (Block is { } block) await block.Task;
+            if (Override is { } custom) return custom(request);
+            var body = request.RequestUri!.AbsolutePath switch
+            {
+                "/alpha/whoami" => Whoami,
+                "/alpha/billing/credits" => Credits,
+                _ => Subscription
+            };
+            return new(HttpStatusCode.OK) { Content = new StringContent(body, Encoding.UTF8, "application/json") };
+        }
+    }
+}
