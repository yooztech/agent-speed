+    private async Task<string> Get(Uri uri, string token, CancellationToken cancellationToken)
+    {
+        // Each request gets its own fifteen-second budget, matching the native
+        // and collector transports; a slow whoami must not starve the billing calls.
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        timeout.CancelAfter(TimeSpan.FromSeconds(15));
+        using var request = new HttpRequestMessage(HttpMethod.Get, uri);
+        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
+        using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, timeout.Token).ConfigureAwait(false);
+        if (!response.IsSuccessStatusCode)
+            throw new HttpStatusException(response.StatusCode, RetrySeconds(response, now()));
+        return await response.Content.ReadAsStringAsync(timeout.Token).ConfigureAwait(false);
+    }
+
+    private static double RetrySeconds(HttpResponseMessage response, DateTimeOffset time) => Math.Max(0,
+        response.Headers.RetryAfter?.Delta?.TotalSeconds ?? (response.Headers.RetryAfter?.Date - time)?.TotalSeconds ?? 0);
+
+    private sealed class HttpStatusException(HttpStatusCode status, double retrySeconds) : Exception
+    {
+        public HttpStatusCode Status { get; } = status;
+        public double RetrySeconds { get; } = retrySeconds;
+    }
+
+    private static Uri Billing(string resource, string? organization) =>
+        new(Origin, "/alpha/billing/" + resource +
+            (string.IsNullOrEmpty(organization) ? "" : "?orgId=" + Uri.EscapeDataString(organization)));
+
+    private static string? Organization(string json)
+    {
+        using var document = JsonDocument.Parse(json);
+        if (document.RootElement.ValueKind != JsonValueKind.Object) throw new JsonException("Invalid Command Code account response.");
+        return Scalar(Property(document.RootElement, "org"), "id");
+    }
+
+    private static string? Label(string? value)
+    {
+        if (string.IsNullOrWhiteSpace(value)) return null;
+        var builder = new StringBuilder(value.Length);
+        foreach (var character in value.Trim())
+            if (!char.IsControl(character)) builder.Append(character);
+        if (builder.Length > 120) builder.Length = 120;
+        var text = builder.ToString().Trim();
+        return text.Length == 0 ? null : text;
+    }
+
+    internal static QuotaSnapshot Parse(string whoamiJson, string creditsJson, string subscriptionsJson, DateTimeOffset time)
+    {
+        using var whoamiDocument = JsonDocument.Parse(whoamiJson);
+        if (whoamiDocument.RootElement.ValueKind != JsonValueKind.Object) throw new JsonException("Invalid Command Code account response.");
+        var whoami = whoamiDocument.RootElement;
