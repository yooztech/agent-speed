+                    error.Status == HttpStatusCode.TooManyRequests, (int)error.Status >= 500);
+                result = StaleOrError(schedule);
+            }
+        }
+        catch (Exception error) when (error is HttpRequestException or IOException or OperationCanceledException or
+            InvalidOperationException or FormatException or JsonException or NotSupportedException)
+        {
+            Backoff(schedule, now(), 0);
+            result = StaleOrError(schedule);
+        }
+        lock (gate)
+        {
+            // Cancellation, disposal or a credential change must never commit another account's response.
+            if (disposed || cancellationToken.IsCancellationRequested || !Equals(ReadCredentials(), credential)) return ReadCachedSnapshot();
+            schedules[key] = schedule;
+            Save(key, schedule);
+            return result;
+        }
+    }
