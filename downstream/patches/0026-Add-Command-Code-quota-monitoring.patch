+++ b/macos/Sources/AgentSpeed/App/CommandCodeCredentialResponse.swift
@@ -0,0 +1,32 @@
+import Foundation
+import AgentSpeedCore
+
+/// A host answers with presence only; an echoed key or any unknown field is rejected,
+/// so a credential can never enter the app through this channel.
+struct CommandCodeCredentialResponse: Decodable, Sendable {
+    let type: String
+    let requestId: String
+    let status: String
+    let configured: Bool?
+    let errorCode: String?
+
+    static func decode(_ data: Data) -> Self? {
+        guard data.count <= 16_384,
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              Set(root.keys).isSubset(of: ["type", "requestId", "status", "configured", "errorCode"]),
+              let value = try? JSONDecoder().decode(Self.self, from: data),
+              value.type == "commandcode_credentials_result", (1...128).contains(value.requestId.utf8.count),
+              value.requestId.utf8.allSatisfy({ (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 45 || $0 == 95 }) else { return nil }
+        switch value.status {
+        case "ok":
+            guard value.configured != nil, value.errorCode == nil else { return nil }
+        case "error":
+            guard let code = value.errorCode, ["invalid_request", "storage_error"].contains(code), value.configured == nil else { return nil }
+        default: return nil
+        }
+        return value
+    }
+}
+
+enum CommandCodeCredentialOperation: String, Sendable { case get, set, delete }
+enum CommandCodeCredentialFailure: Error, Equatable { case invalidRequest, storageError, disconnected, unsupported, cancelled }
