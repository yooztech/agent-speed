+
+private final class KeyStoreFixture: KimiAPIKeyStoring, @unchecked Sendable {
+    private let lock = NSLock()
+    private var value: KimiAPIKey?
+    private var unreadable = false
+    func read() throws -> KimiAPIKey? {
+        try lock.withLock {
+            if unreadable { throw KimiKeyStoreError.storageError }
+            return value
+        }
+    }
+    func save(region: KimiRegion, apiKey: String) throws {
+        let newValue = try KimiAPIKey(region: region, apiKey: apiKey)
+        lock.withLock { value = newValue; unreadable = false }
+    }
+    func delete() { lock.withLock { value = nil; unreadable = false } }
+    func failRead() { lock.withLock { unreadable = true } }
+}
+
+private final class KeyHTTPFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var requests: [URLRequest] = []
+    var status = 200
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock { requests.append(request) }
+        return (Data(#"{"usages":{"limit_5h":{"used_ratio":0.25}}}"#.utf8),
+                HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!)
+    }
+    func captured() -> [URLRequest] { lock.withLock { requests } }
