+++ b/windows/src/AgentSpeed.Core/KimiCredentialStore.cs
@@ -0,0 +1,176 @@
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace AgentSpeed.Core;
+
+public sealed record KimiCredentialMetadata(bool Configured, string? Region);
+
+/// <summary>Only providers read secrets. Settings use GetMetadata, which never decrypts a saved key.</summary>
+public interface IKimiCredentialStore
+{
+    KimiCredentialMetadata GetMetadata();
+    KimiApiCredential? Read();
+    void Set(string region, string apiKey);
+    void Delete();
+}
+
+public sealed class KimiApiCredential(string region, string apiKey)
+{
+    public string Region { get; } = region;
+    public string ApiKey { get; } = apiKey;
+    public override string ToString() => "Kimi API credential";
+}
+
+public sealed class KimiCredentialException : Exception
+{
+    public KimiCredentialException() : base("Kimi key storage is unavailable. Save the key again or remove it in Settings.") { }
+}
+
+public static class KimiCredentials
+{
+    public static bool ValidRegion(string? region) => region is "china" or "international";
+    public static bool ValidKey(string? key) => key is { Length: > 0 and <= 4096 } && key.All(c => c is >= '!' and <= '~');
+}
+
+/// <summary>Current-user DPAPI, like ReportKeyStore but with a dedicated quota context, never a reporting device identity.
+/// A small non-secret header permits metadata-only Settings reads. The protected payload binds that header to the key.
+/// No plaintext fallback exists, including on portable hosts.</summary>
+public sealed partial class KimiCredentialStore : IKimiCredentialStore
+{
+    private static readonly byte[] Entropy = Encoding.ASCII.GetBytes("AgentSpeed/Kimi/subscription-key/v1");
+    private readonly string path;
+    private readonly object gate = new();
+    public KimiCredentialStore(string? path = null) => this.path = path ?? Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota", "kimi.key");
+
+    private bool IsAbsent()
+    {
+        try { File.GetAttributes(path); return false; }
+        catch (FileNotFoundException) { return true; }
+        catch (DirectoryNotFoundException) { return true; }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new KimiCredentialException(); }
+    }
+
+    public KimiCredentialMetadata GetMetadata()
+    {
+        lock (gate)
+        {
+            try
+            {
+                using var stream = File.OpenRead(path);
+                var version = stream.ReadByte();
+                var region = stream.ReadByte();
+                if (version != 1 || region is not (0 or 1) || stream.Length is < 3 or > 16384) throw new KimiCredentialException();
+                return new(true, region == 0 ? "china" : "international");
+            }
+            catch (FileNotFoundException) { if (!IsAbsent()) throw new KimiCredentialException(); return new(false, null); }
+            catch (DirectoryNotFoundException) { if (!IsAbsent()) throw new KimiCredentialException(); return new(false, null); }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new KimiCredentialException(); }
+        }
+    }
+
+    public KimiApiCredential? Read()
+    {
+        lock (gate)
+        {
+            byte[]? plain = null;
+            try
+            {
+                using var stream = File.OpenRead(path);
+                if (stream.Length is < 3 or > 16384) throw new KimiCredentialException();
+                var version = stream.ReadByte();
+                var region = stream.ReadByte();
+                if (version != 1 || region is not (0 or 1)) throw new KimiCredentialException();
+                var sealedData = new byte[(int)stream.Length - 2];
+                stream.ReadExactly(sealedData);
+                plain = Transform(sealedData, protect: false);
+                if (plain.Length is < 2 or > 4097 || plain[0] != region ||
+                    plain.AsSpan(1).ContainsAnyExceptInRange((byte)33, (byte)126)) throw new KimiCredentialException();
+                return new(region == 0 ? "china" : "international", Encoding.ASCII.GetString(plain, 1, plain.Length - 1));
+            }
+            catch (FileNotFoundException) { if (!IsAbsent()) throw new KimiCredentialException(); return null; }
+            catch (DirectoryNotFoundException) { if (!IsAbsent()) throw new KimiCredentialException(); return null; }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException or CryptographicException) { throw new KimiCredentialException(); }
+            finally { if (plain is not null) CryptographicOperations.ZeroMemory(plain); }
+        }
+    }
+
+    public void Set(string region, string apiKey)
+    {
+        if (!KimiCredentials.ValidRegion(region) || !KimiCredentials.ValidKey(apiKey)) throw new ArgumentException("Invalid Kimi key or region.");
+        lock (gate)
+        {
+            var plain = new byte[apiKey.Length + 1];
+            plain[0] = (byte)(region == "china" ? 0 : 1);
+            Encoding.ASCII.GetBytes(apiKey, plain.AsSpan(1));
+            var temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+            try
+            {
+                var sealedData = Transform(plain, protect: true);
+                Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+                using (var stream = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, FileOptions.WriteThrough))
+                {
+                    stream.WriteByte(1);
+                    stream.WriteByte(plain[0]);
+                    stream.Write(sealedData);
+                    stream.Flush(flushToDisk: true);
+                }
+                File.Move(temporary, path, overwrite: true);
+            }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException or CryptographicException) { throw new KimiCredentialException(); }
+            finally
+            {
+                CryptographicOperations.ZeroMemory(plain);
+                try { File.Delete(temporary); } catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+            }
+        }
+    }
+
+    public void Delete()
+    {
+        lock (gate)
+        {
+            try { File.Delete(path); }
+            catch (DirectoryNotFoundException) { }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { throw new KimiCredentialException(); }
+        }
+    }
+
+    private static unsafe byte[] Transform(byte[] bytes, bool protect)
+    {
+        if (!OperatingSystem.IsWindows()) throw new KimiCredentialException();
+        fixed (byte* data = bytes)
+        fixed (byte* salt = Entropy)
+        {
+            var input = new DataBlob { Length = bytes.Length, Data = (nint)data };
+            var entropy = new DataBlob { Length = Entropy.Length, Data = (nint)salt };
+            DataBlob output;
+            var ok = protect ? CryptProtectData(ref input, 0, ref entropy, 0, 0, 1, out output)
+                : CryptUnprotectData(ref input, 0, ref entropy, 0, 0, 1, out output);
+            if (!ok) throw new KimiCredentialException();
+            try
+            {
+                var result = new byte[output.Length];
+                Marshal.Copy(output.Data, result, 0, result.Length);
+                return result;
+            }
+            finally
+            {
+                if (!protect) new Span<byte>((void*)output.Data, output.Length).Clear();
+                LocalFree(output.Data);
+            }
+        }
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct DataBlob { public int Length; public nint Data; }
+    [LibraryImport("crypt32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static partial bool CryptProtectData(ref DataBlob dataIn, nint description, ref DataBlob entropy, nint reserved, nint prompt, int flags, out DataBlob dataOut);
+    [LibraryImport("crypt32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static partial bool CryptUnprotectData(ref DataBlob dataIn, nint description, ref DataBlob entropy, nint reserved, nint prompt, int flags, out DataBlob dataOut);
+    [LibraryImport("kernel32.dll")]
+    private static partial nint LocalFree(nint memory);
+}
