+++ b/macos/Sources/AgentSpeedCore/KimiUsage.swift
@@ -0,0 +1,84 @@
+import Foundation
+import CoreFoundation
+
+// Adapted from Codenotch KimiUsage at 835550a342871779135b6484d6899161c5222f7c.
+// Copyright (c) 2026 Vinz, MIT. Full notice: Resources/Codenotch-LICENSE.txt.
+enum KimiUsage {
+    static let endpoint = URL(string: "https://api.kimi.com/coding/v1/usages")!
+    enum ParseError: Error { case noLimits }
+
+    static func parse(_ data: Data, at time: Date) throws -> QuotaSnapshot {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw URLError(.cannotParseResponse)
+        }
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let plain = ISO8601DateFormatter()
+        func date(_ raw: Any?) -> Date? {
+            (raw as? String).flatMap { fractional.date(from: $0) ?? plain.date(from: $0) }
+        }
+        var windows: [String: QuotaWindow] = [:]
+        func legacy(_ detail: [String: Any], id: String, label: String, duration: TimeInterval) -> QuotaWindow? {
+            let limit = number(detail["limit"])
+            let remaining = number(detail["remaining"])
+            let used: Double
+            if let reported = number(detail["used"]), reported >= 0 { used = reported }
+            else if let limit, limit > 0, let remaining, remaining >= 0, remaining <= limit { used = limit - remaining }
+            else { return nil }
+            let fraction = limit.flatMap { $0 > 0 ? used / $0 : nil }.flatMap { $0.isFinite ? $0 : nil }
+            return QuotaWindow(id: id, label: label, usedFraction: fraction,
+                               remaining: remaining, used: used, resetAt: date(detail["resetTime"]), duration: duration)
+        }
+        if let summary = root["usage"] as? [String: Any] {
+            windows["weekly"] = legacy(summary, id: "weekly", label: "Weekly limit", duration: 604_800)
+        }
+        for entry in root["limits"] as? [[String: Any]] ?? [] {
+            guard let window = entry["window"] as? [String: Any], let duration = number(window["duration"]),
+                  let unit = window["timeUnit"] as? String, let detail = entry["detail"] as? [String: Any] else { continue }
+            let id: String
+            switch (duration, unit) {
+            case (300, "TIME_UNIT_MINUTE"), (5, "TIME_UNIT_HOUR"): id = "rolling"
+            case (1, "TIME_UNIT_WEEK"): id = "weekly"
+            default: continue
+            }
+            if let row = legacy(detail, id: id, label: id == "rolling" ? "5h limit" : "Weekly limit",
+                                duration: id == "rolling" ? 18_000 : 604_800) { windows[id] = row }
+        }
+        let kinds: [(String, String, String, TimeInterval?)] = [
+            ("limit_5h", "rolling", "5h limit", 18_000),
+            ("limit_7d", "weekly", "Weekly limit", 604_800),
+            ("limit_month_total", "monthly-total", "Monthly limit", nil),
+            ("limit_month_code", "monthly-code", "Monthly code limit", nil)
+        ]
+        if let usages = root["usages"] as? [String: Any] {
+            for (key, id, label, duration) in kinds {
+                guard let detail = usages[key] as? [String: Any],
+                      let ratio = number(detail["used_ratio"]), ratio >= 0 else { continue }
+                windows[id] = QuotaWindow(id: id, label: label, usedFraction: ratio, remaining: nil, used: nil,
+                                          resetAt: date(detail["reset_time"]), duration: duration)
+            }
+        }
+        guard !windows.isEmpty else { throw ParseError.noLimits }
+        var plan: String?
+        if let user = root["user"] as? [String: Any], let membership = user["membership"] as? [String: Any],
+           let level = membership["level"] as? String {
+            let name = (level.hasPrefix("LEVEL_") ? String(level.dropFirst(6)) : level)
+                .replacingOccurrences(of: "_", with: " ").trimmingCharacters(in: .whitespacesAndNewlines)
+            if !name.isEmpty { plan = name.lowercased().capitalized }
+        }
+        return QuotaSnapshot(id: "kimi", displayName: "Kimi Code", fidelity: "official", status: .ok,
+                             windows: kinds.compactMap { windows[$0.1] }, headlineId: "rolling", block: nil,
+                             account: nil, plan: plan, observedAt: time, source: "Kimi Code", credits: nil,
+                             nextAllowedAt: nil, waitingForRefresh: false)
+    }
+
+    private static func number(_ raw: Any?) -> Double? {
+        let value: Double?
+        if let number = raw as? NSNumber {
+            guard CFGetTypeID(number) != CFBooleanGetTypeID() else { return nil }
+            value = number.doubleValue
+        } else if let text = raw as? String { value = Double(text) }
+        else { return nil }
+        return value.flatMap { $0.isFinite ? $0 : nil }
+    }
+}
