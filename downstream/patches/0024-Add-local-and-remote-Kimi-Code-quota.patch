+        fixture.Clock = Time.AddSeconds(expected); fixture.Handler.Reply = _ => Response(200);
+        Assert.Null((await restarted.RefreshAsync()).NextAllowedAt); Assert.Equal(2, fixture.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task DateRetryAndCorruptObservationKeepIndependentCooldown()
+    {
+        using var fixture = new Fixture();
+        fixture.Handler.Reply = _ => { var response = Response(429); response.Headers.RetryAfter = new RetryConditionHeaderValue(Time.AddMinutes(12)); return response; };
