+TEST(CollectorKimiKeys, RemovalInvalidatesKimiWhileAnotherSupplierDelaysAnAssembledReply) {
+    Home home; home.codexAuth(); home.kimiAuth(); const auto p = home.paths();
+    ASSERT_TRUE(q::manageKimiCredentials(p, "set", "china", "synthetic-assembled").ok);
+    std::mutex mutex; std::condition_variable cv; bool codexStarted = false, release = false;
+    q::Service service(p, [&](const std::string& url, const auto& credential, bool reset) {
+        if (url.find("chatgpt.com") != std::string::npos && !reset) {
+            std::unique_lock<std::mutex> lock(mutex); codexStarted = true; cv.notify_all();
+            cv.wait_for(lock, std::chrono::seconds(10), [&] { return release; });
+        }
+        return success(url, credential, reset);
+    }, [] { return now; });
+    ASSERT_TRUE(service.control(command("assembled", true, "\"codex\",\"kimi\""), 1));
+    { std::unique_lock<std::mutex> lock(mutex); if (!cv.wait_for(lock, std::chrono::seconds(3), [&] { return codexStarted; })) { release = true; cv.notify_all(); FAIL() << "Codex request did not start"; } }
+    // This cache job is behind the aggregate's Kimi refresh. Its reply proves
+    // that the pending aggregate already contains the old Kimi observation.
+    EXPECT_TRUE(service.control(command("probe", false, "\"kimi\""), 2));
+    auto probe = replies(service, 1); EXPECT_EQ(probe.size(), 1u);
+    Document doc;
+    if (!probe.empty()) { EXPECT_TRUE(doc.parse(probe[0].second)); EXPECT_GT(doc.root()["snapshots"].at(0)["windows"].size(), 0u); }
+    EXPECT_TRUE(service.control(R"({"type":"kimi_credentials","requestId":"remove-assembled","operation":"delete"})", 3));
+    auto removed = replies(service, 1); EXPECT_EQ(removed.size(), 1u);
+    if (!removed.empty()) EXPECT_EQ(removed[0].first, 3u);
+    { std::lock_guard<std::mutex> lock(mutex); release = true; } cv.notify_all();
+    auto aggregate = replies(service, 1); ASSERT_EQ(aggregate.size(), 1u); ASSERT_TRUE(doc.parse(aggregate[0].second));
+    EXPECT_EQ(aggregate[0].first, 1u); EXPECT_GT(doc.root()["snapshots"].at(0)["windows"].size(), 0u);
+    EXPECT_EQ(doc.root()["snapshots"].at(1)["windows"].size(), 0u); EXPECT_TRUE(doc.root()["snapshots"].at(1)["observedAt"].isNull());
+}
