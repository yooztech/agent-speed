+// Shared only for short filesystem operations, never supplier HTTP. Holding it
+// through the provider's final currentness check and commit closes set/delete races.
+std::recursive_mutex credentialMutex;
+bool keyRegion(const std::string& region) { return region == "china" || region == "international"; }
+bool apiKeyValid(const std::string& key) {
+    return !key.empty() && key.size() <= 4096 && std::all_of(key.begin(), key.end(), [](unsigned char c) { return c >= 33 && c <= 126; });
+}
+bool privateRegular(const struct stat& st) {
+    return S_ISREG(st.st_mode) && st.st_uid == geteuid() && (st.st_mode & 07777) == 0600 && st.st_nlink == 1;
+}
+// -2 means true absence. Any unsafe/unreadable containing directory is an error,
+// not absence, and must never enable the CLI OAuth fallback.
+int keyDirectory(const std::string& home, bool create) {
+    Fd root(open(home.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW)); struct stat st{};
+    if (root.value < 0 || fstat(root.value, &st) || st.st_uid != geteuid() || (st.st_mode & 0022)) return -1;
+    auto child = [&](int parent, const char* name) {
+        if (create) {
+            if (mkdirat(parent, name, 0700) == 0) { if (fsync(parent)) return -1; }
+            else if (errno != EEXIST) return -1;
+        }
+        int fd = openat(parent, name, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        if (fd < 0) return errno == ENOENT && !create ? -2 : -1;
+        if (fstat(fd, &st) || st.st_uid != geteuid() || (st.st_mode & 07777) != 0700) { close(fd); return -1; }
+        return fd;
+    };
+    Fd app(child(root.value, ".agent-speed"));
+    return app.value < 0 ? app.value : child(app.value, "quota");
+}
+struct StoredKimi { bool ok = false, present = true; std::optional<Credential> credential; };
+StoredKimi storedKimi(const Paths& paths) {
+    Fd directory(keyDirectory(paths.home, false));
+    if (directory.value == -2) return {true, false, {}};
+    if (directory.value < 0) return {};
+    Fd fd(openat(directory.value, "kimi.json", O_RDONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW));
+    if (fd.value < 0) return errno == ENOENT ? StoredKimi{true, false, {}} : StoredKimi{};
+    struct stat st{};
+    if (fstat(fd.value, &st) || !privateRegular(st) || st.st_size <= 0 || st.st_size > 16384) return {};
+    std::string body; body.reserve(static_cast<std::size_t>(st.st_size)); char buffer[4096];
+    for (;;) {
+        const auto n = ::read(fd.value, buffer, sizeof(buffer));
+        if (n < 0) { if (errno == EINTR) continue; return {}; }
+        if (n == 0) break;
+        if (body.size() + static_cast<std::size_t>(n) > 16384) return {};
+        body.append(buffer, static_cast<std::size_t>(n));
+    }
+    Document doc; if (!doc.parse(body) || !doc.root().isObject() || doc.root().size() != 3) return {};
+    std::set<std::string> names;
+    for (const auto& member : doc.root().members()) if ((member.first != "region" && member.first != "apiKey" && member.first != "revision") || !names.insert(member.first).second) return {};
+    auto region = text(doc.root()["region"]), token = text(doc.root()["apiKey"]), revision = text(doc.root()["revision"]);
+    if (!region || !keyRegion(*region) || !token || !apiKeyValid(*token) || !revision || revision->size() != 32 ||
+        !std::all_of(revision->begin(), revision->end(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); })) return {};
+    Credential c; c.region = *region; c.token = *token;
+    c.context = "api:" + c.region + ":" + digest(c.token);
+    // Filesystems may reuse both inode and timestamps during delete/set ABA.
+    // A persisted random per-set nonce tracks mutations without changing the
+    // logical mode/region/key identity used for supplier pacing and caches.
+    c.revision = *revision;
+    return {true, true, std::move(c)};
+}
+bool keyTargetSafe(int directory) {
+    struct stat st{};
+    if (fstatat(directory, "kimi.json", &st, AT_SYMLINK_NOFOLLOW)) return errno == ENOENT;
+    return privateRegular(st);
+}
+bool storeKimi(int directory, const std::string& body) {
+    if (!keyTargetSafe(directory)) return false;
+    static std::atomic<std::uint64_t> sequence{0};
+    const auto temporary = ".kimi." + std::to_string(getpid()) + "." + std::to_string(++sequence) + ".tmp";
+    Fd fd(openat(directory, temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600));
+    if (fd.value < 0) return false;
+    struct stat st{}; bool ok = !fstat(fd.value, &st) && privateRegular(st); std::size_t offset = 0;
+    while (ok && offset < body.size()) {
+        auto n = ::write(fd.value, body.data() + offset, body.size() - offset);
+        if (n > 0) offset += static_cast<std::size_t>(n);
+        else if (n < 0 && errno == EINTR) continue;
+        else ok = false;
+    }
+    ok = ok && fsync(fd.value) == 0 && keyTargetSafe(directory) && renameat(directory, temporary.c_str(), directory, "kimi.json") == 0;
+    if (!ok) { unlinkat(directory, temporary.c_str(), 0); return false; }
+    return fsync(directory) == 0;
+}
