diff --git a/macos/Sources/AgentSpeedCore/KimiAPIKeyStore.swift b/macos/Sources/AgentSpeedCore/KimiAPIKeyStore.swift
new file mode 100644
index 00000000..01867fc0
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/KimiAPIKeyStore.swift
@@ -0,0 +1,99 @@
+import Foundation
+#if canImport(Security)
+import Security
+#endif
+
+public enum KimiRegion: String, Codable, CaseIterable, Sendable {
+    case china, international
+    public var endpoint: URL {
+        URL(string: self == .china ? "https://api.kimi.com/coding/v1/usages" : "https://api.kimi.ai/coding/v1/usages")!
+    }
+}
+
+public struct KimiKeyMetadata: Equatable, Sendable {
+    public let configured: Bool
+    public let region: KimiRegion?
+    public init(configured: Bool, region: KimiRegion?) { self.configured = configured; self.region = region }
+}
+
+public enum KimiKeyStoreError: Error, Sendable { case invalidRequest, storageError }
+
+public struct KimiAPIKey: Codable, Sendable {
+    public let region: KimiRegion
+    public let apiKey: String
+    public init(region: KimiRegion, apiKey: String) throws {
+        guard Self.isValid(apiKey) else { throw KimiKeyStoreError.invalidRequest }
+        self.region = region
+        self.apiKey = apiKey
+    }
+    public static func isValid(_ key: String) -> Bool {
+        !key.isEmpty && key.utf8.count <= 4096 && key.utf8.allSatisfy { (33...126).contains($0) }
+    }
+}
+
+/// Only nil means absence. Errors and malformed configured items must never enable OAuth fallback.
+public protocol KimiAPIKeyStoring: Sendable {
+    func read() throws -> KimiAPIKey?
+    func metadata() throws -> KimiKeyMetadata
+    func save(region: KimiRegion, apiKey: String) throws
+    func delete() throws
+}
+
+public extension KimiAPIKeyStoring {
+    func metadata() throws -> KimiKeyMetadata {
+        let value = try read()
+        return KimiKeyMetadata(configured: value != nil, region: value?.region)
+    }
+}
+
+/// A single Keychain item atomically binds the region and key. No UserDefaults or file fallback.
+public struct KimiKeychainStore: KimiAPIKeyStoring {
+    public init() {}
+    #if canImport(Security)
+    private var query: [String: Any] {
+        [kSecClass as String: kSecClassGenericPassword,
+         kSecAttrService as String: "com.agent-speed.subscription.kimi",
+         kSecAttrAccount as String: "api-key",
+         kSecAttrSynchronizable as String: false]
+    }
+    public func read() throws -> KimiAPIKey? {
+        var lookup = query
+        lookup[kSecReturnData as String] = true
+        lookup[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(lookup as CFDictionary, &result)
+        if status == errSecItemNotFound { return nil }
+        guard status == errSecSuccess, let data = result as? Data,
+              let key = try? JSONDecoder().decode(KimiAPIKey.self, from: data), KimiAPIKey.isValid(key.apiKey) else {
+            throw KimiKeyStoreError.storageError
+        }
+        return key
+    }
+    public func save(region: KimiRegion, apiKey: String) throws {
+        let value = try KimiAPIKey(region: region, apiKey: apiKey)
+        let data = try JSONEncoder().encode(value)
+        let status = SecItemUpdate(query as CFDictionary, [kSecValueData as String: data] as CFDictionary)
+        if status == errSecSuccess { return }
+        guard status == errSecItemNotFound else { throw KimiKeyStoreError.storageError }
+        var item = query
+        item[kSecValueData as String] = data
+        item[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        guard SecItemAdd(item as CFDictionary, nil) == errSecSuccess else { throw KimiKeyStoreError.storageError }
+    }
+    public func delete() throws {
+        let status = SecItemDelete(query as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else { throw KimiKeyStoreError.storageError }
+    }
+    #else
+    public func read() throws -> KimiAPIKey? { throw KimiKeyStoreError.storageError }
+    public func save(region: KimiRegion, apiKey: String) throws { throw KimiKeyStoreError.storageError }
+    public func delete() throws { throw KimiKeyStoreError.storageError }
+    #endif
+}
+
+/// Explicit dependency for OAuth-only portable fixtures; production always uses Keychain.
+struct AbsentKimiAPIKeyStore: KimiAPIKeyStoring {
+    func read() -> KimiAPIKey? { nil }
+    func save(region: KimiRegion, apiKey: String) throws { throw KimiKeyStoreError.storageError }
+    func delete() throws { throw KimiKeyStoreError.storageError }
+}
