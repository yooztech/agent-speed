diff --git a/windows/tests/AgentSpeed.Core.Tests/KimiApiKeyTests.cs b/windows/tests/AgentSpeed.Core.Tests/KimiApiKeyTests.cs
new file mode 100644
index 00000000..a3b4035a
--- /dev/null
+++ b/windows/tests/AgentSpeed.Core.Tests/KimiApiKeyTests.cs
@@ -0,0 +1,158 @@
+using System.Net;
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class KimiApiKeyTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 11, 16, 0, 0, 0, TimeSpan.Zero);
+    private const string Reading = "{\"usages\":{\"limit_5h\":{\"used_ratio\":0.25}}}";
+
+    [Theory]
+    [InlineData("china", "api.kimi.com")]
+    [InlineData("international", "api.kimi.ai")]
+    public async Task ExplicitKeyOverridesCliWithFixedRegionAndNoExpiryOrSuccessFloor(string region, string host)
+    {
+        using var fixture = new Fixture();
+        fixture.Store.Set(region, "subscription-key");
+        fixture.Handler.Reply = request =>
+        {
+            Assert.Equal(host, request.RequestUri!.Host);
+            Assert.Equal("/coding/v1/usages", request.RequestUri.AbsolutePath);
+            Assert.Equal("subscription-key", request.Headers.Authorization!.Parameter);
+            return new(HttpStatusCode.OK) { Content = new StringContent(Reading) };
+        };
+        using var provider = fixture.Provider();
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        fixture.Clock = Now.AddYears(5);
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        Assert.Equal(2, fixture.Handler.Calls);
+        Assert.DoesNotContain("subscription-key", string.Join("", Directory.GetFiles(fixture.Schedule).Select(File.ReadAllText)));
+        Assert.DoesNotContain("subscription-key", fixture.Store.Read()!.ToString());
+    }
+
+    [Theory]
+    [InlineData("malformed")]
+    [InlineData("region")]
+    [InlineData("unreadable")]
+    public async Task ConfiguredButInvalidOrUnreadableNeverFallsBackToValidCli(string failure)
+    {
+        using var fixture = new Fixture();
+        fixture.Store.Value = new(failure == "region" ? "other" : "china", failure == "malformed" ? "key with space" : "key");
+        fixture.Store.FailRead = failure == "unreadable";
+        using var provider = fixture.Provider();
+        var result = await provider.RefreshAsync();
+        Assert.Empty(result.Windows);
+        Assert.Equal(failure == "unreadable" ? KimiQuotaProvider.KeyStorageReason : KimiQuotaProvider.KeyInvalidReason, result.Block);
+        Assert.DoesNotContain("/login", result.Block!);
+        Assert.Equal(0, fixture.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task RejectionIsKeyAndRegionIsolatedAndOnlyTrueAbsenceUsesCli()
+    {
+        using var fixture = new Fixture();
+        fixture.Store.Set("china", "same-key");
+        fixture.Handler.Reply = _ => new(HttpStatusCode.Unauthorized);
+        using (var provider = fixture.Provider())
+        {
+            var denied = await provider.RefreshAsync();
+            Assert.Equal(KimiQuotaProvider.KeyRejectedReason, denied.Block);
+            Assert.DoesNotContain("/login", denied.Block!);
+            await provider.RefreshAsync(); Assert.Equal(1, fixture.Handler.Calls);
+        }
+        using var restarted = fixture.Provider();
+        Assert.Equal(KimiQuotaProvider.KeyRejectedReason, restarted.ReadCachedSnapshot().Block);
+        await restarted.RefreshAsync(); Assert.Equal(1, fixture.Handler.Calls);
+        fixture.Store.Set("international", "same-key");
+        fixture.Handler.Reply = _ => new(HttpStatusCode.OK) { Content = new StringContent(Reading) };
+        Assert.Empty(restarted.ReadCachedSnapshot().Windows);
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshAsync()).Status);
+        fixture.Store.Set("international", "new-key");
+        Assert.Empty(restarted.ReadCachedSnapshot().Windows);
+        await restarted.RefreshAsync();
+        fixture.Store.Delete();
+        fixture.Handler.Reply = request =>
+        {
+            Assert.Equal("cli-token", request.Headers.Authorization!.Parameter);
+            Assert.Equal("api.kimi.com", request.RequestUri!.Host);
+            return new(HttpStatusCode.OK) { Content = new StringContent(Reading) };
+        };
+        Assert.Empty(restarted.ReadCachedSnapshot().Windows);
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshAsync()).Status);
+        Assert.Equal(4, fixture.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task MutationGenerationDiscardsEvenSameKeyReinstalledDuringRequest()
+    {
+        using var fixture = new Fixture(); fixture.Store.Set("china", "same-key");
+        fixture.Handler.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var provider = fixture.Provider();
+        var old = provider.RefreshAsync();
+        fixture.Store.Delete(); provider.CredentialsChanged();
+        fixture.Store.Set("china", "same-key"); provider.CredentialsChanged();
+        fixture.Handler.Block.SetResult();
+        Assert.Empty((await old).Windows);
+        Assert.False(Directory.Exists(fixture.Schedule) && Directory.EnumerateFiles(fixture.Schedule).Any());
+        fixture.Handler.Block = null;
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        provider.CredentialsChanged(); fixture.Store.Delete();
+        Assert.Empty(provider.ReadCachedSnapshot().Windows);
+    }
+
+    [Fact]
+    public void PortableStoreNeverWritesPlaintextAndUnreadablePresenceIsNotAbsence()
+    {
+        if (OperatingSystem.IsWindows()) return;
+        using var fixture = new Fixture();
+        var path = Path.Combine(fixture.Root, "secure.key");
+        var store = new KimiCredentialStore(path);
+        Assert.False(store.GetMetadata().Configured);
+        Assert.Throws<KimiCredentialException>(() => store.Set("china", "never-plaintext"));
+        Assert.False(File.Exists(path));
+        File.WriteAllBytes(path, [1, 1, 42]);
+        Assert.Equal(new KimiCredentialMetadata(true, "international"), store.GetMetadata());
+        Assert.Throws<KimiCredentialException>(() => store.Read());
+        File.WriteAllText(path, "invalid-file");
+        Assert.Throws<KimiCredentialException>(() => store.GetMetadata());
+    }
+
+    private sealed class Store : IKimiCredentialStore
+    {
+        public KimiApiCredential? Value;
+        public bool FailRead;
+        public KimiCredentialMetadata GetMetadata() => new(Value is not null, Value?.Region);
+        public KimiApiCredential? Read() => FailRead ? throw new KimiCredentialException() : Value;
+        public void Set(string region, string apiKey) => Value = new(region, apiKey);
+        public void Delete() => Value = null;
+    }
+    private sealed class Fixture : IDisposable
+    {
+        public readonly string Root = Path.Combine(Path.GetTempPath(), "kimi-key-tests-" + Guid.NewGuid().ToString("N"));
+        public string Schedule => Path.Combine(Root, "schedule");
+        public readonly Store Store = new();
+        public readonly Handler Handler = new();
+        public DateTimeOffset Clock = Now;
+        public Fixture()
+        {
+            Directory.CreateDirectory(Root);
+            File.WriteAllText(Path.Combine(Root, "cli.json"), JsonSerializer.Serialize(new { access_token = "cli-token", refresh_token = "cli-session", expires_at = Now.AddHours(1).ToUnixTimeSeconds() }));
+        }
+        public KimiQuotaProvider Provider() => new(Path.Combine(Root, "cli.json"), Schedule, new HttpClient(Handler, false), () => Clock, Store);
+        public void Dispose() { Handler.Dispose(); Directory.Delete(Root, true); }
+    }
+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls;
+        public TaskCompletionSource? Block;
+        public Func<HttpRequestMessage, HttpResponseMessage> Reply = _ => new(HttpStatusCode.OK) { Content = new StringContent(Reading) };
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Calls++;
+            // Intentionally ignore cancellation so the provider's commit-time generation check is exercised.
+            if (Block is { } block) await block.Task;
+            return Reply(request);
+        }
+    }
+}
