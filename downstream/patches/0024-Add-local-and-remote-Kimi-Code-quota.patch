new file mode 100644
index 00000000..29b4464b
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/KimiCredentials.swift
@@ -0,0 +1,60 @@
+import Foundation
+import CoreFoundation
+#if canImport(CryptoKit)
+import CryptoKit
+#else
+import Crypto
+#endif
+
+// Adapted from Codenotch KimiCredentials at 835550a342871779135b6484d6899161c5222f7c.
+// Copyright (c) 2026 Vinz, MIT. Full notice: Resources/Codenotch-LICENSE.txt.
+// Kimi Code CLI owns OAuth login and renewal. This reader never writes credentials.
+struct KimiCredentials: Sendable {
+    let accessToken: String
+    let expiresAt: Date
+    let identity: String
+    let revision: String
+    var region: KimiRegion = .china
+    var isAPIKey = false
+    var authReason: String { isAPIKey ? KimiQuotaProvider.apiKeyReason : KimiQuotaProvider.renewalReason }
+
+    static func apiKey(_ key: KimiAPIKey) -> KimiCredentials {
+        let identity = digest("api-key\u{0}" + key.region.rawValue + "\u{0}" + key.apiKey)
+        return KimiCredentials(accessToken: key.apiKey, expiresAt: .distantFuture,
+                               identity: identity, revision: identity, region: key.region, isAPIKey: true)
+    }
+
+    static var authURL: URL {
+        authURL(environment: ProcessInfo.processInfo.environment, home: URL(fileURLWithPath: NSHomeDirectory()))
+    }
+
+    static func authURL(environment: [String: String], home: URL) -> URL {
+        let root = environment["KIMI_CODE_HOME"].flatMap { $0.isEmpty ? nil : URL(fileURLWithPath: $0) }
+            ?? home.appendingPathComponent(".kimi-code")
+        return root.appendingPathComponent("credentials/kimi-code.json")
+    }
+
+    static func load(from url: URL) -> KimiCredentials? {
+        guard let data = try? Data(contentsOf: url),
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let token = root["access_token"] as? String,
+              !token.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              let expires = root["expires_at"] as? NSNumber,
+              CFGetTypeID(expires) != CFBooleanGetTypeID(),
+              expires.doubleValue.isFinite, expires.doubleValue > 0 else { return nil }
+        // A CLI refresh credential is the stable session identity when available.
+        // Otherwise isolate by access token; never infer an account from token claims.
+        let stable: String
+        if let refresh = root["refresh_token"] as? String, !refresh.isEmpty {
+            stable = "refresh\u{0}" + refresh
+        } else {
+            stable = "access\u{0}" + token
+        }
+        return KimiCredentials(accessToken: token, expiresAt: Date(timeIntervalSince1970: expires.doubleValue),
+                               identity: digest(url.standardizedFileURL.path + "\u{0}" + stable), revision: digest(token))
+    }
+
+    private static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/KimiQuotaProvider.swift b/macos/Sources/AgentSpeedCore/KimiQuotaProvider.swift
new file mode 100644
index 00000000..21e893f9
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/KimiQuotaProvider.swift
@@ -0,0 +1,217 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+// Adapted from Codenotch KimiProvider at 835550a342871779135b6484d6899161c5222f7c.
+// Copyright (c) 2026 Vinz, MIT. Full notice: Resources/Codenotch-LICENSE.txt.
+public actor KimiQuotaProvider: QuotaProvider {
+    public nonisolated let id = "kimi"
+    static let renewalReason = "Kimi Code session expired. Open Kimi Code CLI and run /login to renew."
+    public static let apiKeyReason = "Kimi API key unavailable or rejected. Check the saved region and API key in Settings."
+    typealias Transport = @Sendable (URLRequest) async throws -> (Data, HTTPURLResponse)
+    private struct Schedule: Codable {
+        var next: Date?
+        var failures = 0
+        var coldFailures: Int?
+        var rejectedRevision: String?
+        var status: QuotaStatus?
+        var observation: QuotaPersistedObservation?
+    }
+    private let authURL: URL
+    private let keyStore: any KimiAPIKeyStoring
+    private let now: @Sendable () -> Date
+    private let transport: Transport
+    private let persistence: QuotaPersistence
+    private var schedules: [String: Schedule] = [:]
+    private var cached: [String: QuotaSnapshot] = [:]
+    private var inFlight: Task<QuotaSnapshot, Never>?
+    private var generation = 0
+
+    public init(keyStore: any KimiAPIKeyStoring = KimiKeychainStore()) {
+        self.keyStore = keyStore
+        authURL = KimiCredentials.authURL
+        now = { Date() }
+        transport = Self.request
+        persistence = QuotaPersistence(directory: QuotaPersistence.directory.appendingPathComponent("kimi"))
+    }
+
+    init(authURL: URL, cacheDirectory: URL, keyStore: any KimiAPIKeyStoring = AbsentKimiAPIKeyStore(),
+         now: @escaping @Sendable () -> Date, transport: @escaping Transport) {
+        self.keyStore = keyStore
+        self.authURL = authURL
+        self.now = now
+        self.transport = transport
+        persistence = QuotaPersistence(directory: cacheDirectory)
+    }
+
+    public func readCachedSnapshot() -> QuotaSnapshot {
+        let resolved = credentials()
+        guard let credential = resolved.value else { return snapshot(.needsAuth, reason: resolved.keyConfigured ? Self.apiKeyReason : nil) }
+        guard credential.expiresAt > now() else { return snapshot(.needsAuth, reason: credential.authReason) }
+        let schedule = load(credential.identity)
+        guard schedule.rejectedRevision != credential.revision else { return snapshot(.needsAuth, reason: credential.authReason) }
+        if schedule.status == .unsupported { return snapshot(.unsupported, next: schedule.next) }
+        return stale(credential.identity, next: schedule.next)
+    }
+
+    public func refreshStartup() async -> QuotaSnapshot { await refresh() }
+
+    public func refresh() async -> QuotaSnapshot {
+        if let inFlight { return await inFlight.value }
+        let current = generation
+        let task = Task { await self.performRefresh() }
+        inFlight = task
+        let result = await task.value
+        if current == generation { inFlight = nil }
+        return result
+    }
+
+    public func cancel() {
+        generation += 1
+        inFlight?.cancel()
+        inFlight = nil
+    }
+
+    /// Drop all observations when credentials change, including a remove/re-add of the same key.
+    public func credentialsChanged() {
+        cancel()
+        schedules.removeAll()
+        cached.removeAll()
+        persistence.removeAll()
+    }
+
+    private func credentials() -> (value: KimiCredentials?, keyConfigured: Bool) {
+        do {
+            if let key = try keyStore.read() {
+                return (KimiAPIKey.isValid(key.apiKey) ? .apiKey(key) : nil, true)
+            }
+            return (KimiCredentials.load(from: authURL), false)
+        } catch { return (nil, true) }
+    }
+
+    private func load(_ identity: String) -> Schedule {
+        let schedule = schedules[identity] ?? persistence.load(Schedule.self, key: identity) ?? Schedule()
+        schedules[identity] = schedule
+        if cached[identity] == nil, let observation = schedule.observation?.validated(accountKey: identity, id: id, source: "Kimi Code") {
+            cached[identity] = observation.copying(status: .stale, next: schedule.next)
+        }
+        return schedule
+    }
+
+    private func isCurrent(_ credential: KimiCredentials, generation expected: Int) -> Bool {
+        guard generation == expected, !Task.isCancelled, let current = credentials().value else { return false }
+        return current.identity == credential.identity && current.revision == credential.revision
+            && current.expiresAt == credential.expiresAt && current.expiresAt > now()
+    }
+
+    private func performRefresh() async -> QuotaSnapshot {
+        guard !Task.isCancelled else { return readCachedSnapshot() }
+        let expected = generation
+        let resolved = credentials()
+        guard let credential = resolved.value else { return snapshot(.needsAuth, reason: resolved.keyConfigured ? Self.apiKeyReason : nil) }
+        guard credential.expiresAt > now() else { return snapshot(.needsAuth, reason: credential.authReason) }
+        let identity = credential.identity
+        var schedule = load(identity)
+        guard schedule.rejectedRevision != credential.revision else { return snapshot(.needsAuth, reason: credential.authReason) }
+        if let next = schedule.next, now() < next {
+            if schedule.status == .unsupported { return snapshot(.unsupported, next: next) }
+            return stale(identity, next: next)
+        }
+        var request = URLRequest(url: credential.region.endpoint)
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(credential.accessToken)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        var retry: TimeInterval?
+        do {
+            let (data, response) = try await transport(request)
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            retry = OpenCodeGoQuotaProvider.retryAfter(response.value(forHTTPHeaderField: "Retry-After"), now: now())
+            switch response.statusCode {
+            case 200...299:
+                do {
+                    let result = try KimiUsage.parse(data, at: now())
+                    guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+                    schedule = Schedule(observation: QuotaPersistedObservation(accountKey: identity, snapshot: result))
+                    save(schedule, key: identity)
+                    cached[identity] = result
+                    // No successful manual-read floor. Automatic refresh uses the app's 300s cadence.
+                    return result
+                } catch KimiUsage.ParseError.noLimits {
+                    guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+                    return unsupported(identity, schedule: &schedule)
+                }
+            case 401, 403:
+                schedule = Schedule(rejectedRevision: credential.revision)
+                save(schedule, key: identity)
+                cached.removeValue(forKey: identity)
+                return snapshot(.needsAuth, reason: credential.authReason)
+            case 404:
+                return unsupported(identity, schedule: &schedule)
+            case 429:
+                return failure(identity, schedule: &schedule, retryAfter: retry, rateLimited: true)
+            default:
+                return failure(identity, schedule: &schedule, retryAfter: retry)
+            }
+        } catch {
+            guard isCurrent(credential, generation: expected) else { return readCachedSnapshot() }
+            return failure(identity, schedule: &schedule, retryAfter: retry)
+        }
+    }
+
+    private func unsupported(_ identity: String, schedule: inout Schedule) -> QuotaSnapshot {
+        schedule = Schedule(next: now().addingTimeInterval(300), status: .unsupported)
+        save(schedule, key: identity)
+        cached.removeValue(forKey: identity)
+        return snapshot(.unsupported, next: schedule.next)
+    }
+
+    private func failure(_ identity: String, schedule: inout Schedule, retryAfter: TimeInterval? = nil,
+                         rateLimited: Bool = false) -> QuotaSnapshot {
+        let cold = schedule.observation?.validated(accountKey: identity, id: id, source: "Kimi Code") == nil
+        let wait: TimeInterval
+        if cold && !rateLimited {
+            let attempt = min((schedule.coldFailures ?? 0) + 1, 4)
+            schedule.coldFailures = attempt
+            wait = max(min(30, 5 * pow(2, Double(attempt - 1))), retryAfter ?? 0)
+        } else {
+            wait = OpenCodeGoQuotaProvider.backoff(attempt: schedule.failures, retryAfter: retryAfter)
+        }
+        schedule.failures = min(5, schedule.failures + 1)
+        schedule.next = now().addingTimeInterval(wait)
+        schedule.status = .error
+        save(schedule, key: identity)
+        return stale(identity, next: schedule.next)
+    }
+
+    private func stale(_ identity: String, next: Date?) -> QuotaSnapshot {
+        guard let value = cached[identity] else { return snapshot(.error, next: next) }
+        return value.copying(status: .stale, next: next)
+    }
+
+    private func save(_ schedule: Schedule, key: String) {
+        schedules[key] = schedule
+        persistence.save(schedule, key: key)
+    }
+
+    private func snapshot(_ status: QuotaStatus, next: Date? = nil, reason: String? = nil) -> QuotaSnapshot {
+        let resolved = credentials()
+        return QuotaSnapshot(id: id, displayName: "Kimi Code", fidelity: "official", status: status,
+                      windows: [], headlineId: "rolling", block: reason, account: nil, plan: nil,
+                      observedAt: nil, source: "Kimi Code", credits: nil, nextAllowedAt: next, waitingForRefresh: false,
+                      configured: resolved.value != nil || resolved.keyConfigured)
+    }
+
+    private final class NoRedirect: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+        func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                        newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) { completionHandler(nil) }
+    }
+
+    private static func request(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {
+        let session = URLSession(configuration: .ephemeral, delegate: NoRedirect(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let (data, response) = try await session.data(for: request)
+        guard let response = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        return (data, response)
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/KimiUsage.swift b/macos/Sources/AgentSpeedCore/KimiUsage.swift
new file mode 100644
index 00000000..5c50d9c3
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/KimiUsage.swift
@@ -0,0 +1,84 @@
+import Foundation
+import CoreFoundation
+
+// Adapted from Codenotch KimiUsage at 835550a342871779135b6484d6899161c5222f7c.
+// Copyright (c) 2026 Vinz, MIT. Full notice: Resources/Codenotch-LICENSE.txt.
+enum KimiUsage {
+    static let endpoint = URL(string: "https://api.kimi.com/coding/v1/usages")!
+    enum ParseError: Error { case noLimits }
+
+    static func parse(_ data: Data, at time: Date) throws -> QuotaSnapshot {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw URLError(.cannotParseResponse)
+        }
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let plain = ISO8601DateFormatter()
+        func date(_ raw: Any?) -> Date? {
+            (raw as? String).flatMap { fractional.date(from: $0) ?? plain.date(from: $0) }
+        }
+        var windows: [String: QuotaWindow] = [:]
+        func legacy(_ detail: [String: Any], id: String, label: String, duration: TimeInterval) -> QuotaWindow? {
+            let limit = number(detail["limit"])
+            let remaining = number(detail["remaining"])
+            let used: Double
+            if let reported = number(detail["used"]), reported >= 0 { used = reported }
+            else if let limit, limit > 0, let remaining, remaining >= 0, remaining <= limit { used = limit - remaining }
+            else { return nil }
+            let fraction = limit.flatMap { $0 > 0 ? used / $0 : nil }.flatMap { $0.isFinite ? $0 : nil }
+            return QuotaWindow(id: id, label: label, usedFraction: fraction,
+                               remaining: remaining, used: used, resetAt: date(detail["resetTime"]), duration: duration)
+        }
+        if let summary = root["usage"] as? [String: Any] {
+            windows["weekly"] = legacy(summary, id: "weekly", label: "Weekly limit", duration: 604_800)
+        }
+        for entry in root["limits"] as? [[String: Any]] ?? [] {
+            guard let window = entry["window"] as? [String: Any], let duration = number(window["duration"]),
+                  let unit = window["timeUnit"] as? String, let detail = entry["detail"] as? [String: Any] else { continue }
+            let id: String
+            switch (duration, unit) {
+            case (300, "TIME_UNIT_MINUTE"), (5, "TIME_UNIT_HOUR"): id = "rolling"
+            case (1, "TIME_UNIT_WEEK"): id = "weekly"
+            default: continue
+            }
+            if let row = legacy(detail, id: id, label: id == "rolling" ? "5h limit" : "Weekly limit",
+                                duration: id == "rolling" ? 18_000 : 604_800) { windows[id] = row }
+        }
+        let kinds: [(String, String, String, TimeInterval?)] = [
+            ("limit_5h", "rolling", "5h limit", 18_000),
+            ("limit_7d", "weekly", "Weekly limit", 604_800),
+            ("limit_month_total", "monthly-total", "Monthly limit", nil),
+            ("limit_month_code", "monthly-code", "Monthly code limit", nil)
+        ]
+        if let usages = root["usages"] as? [String: Any] {
+            for (key, id, label, duration) in kinds {
+                guard let detail = usages[key] as? [String: Any],
+                      let ratio = number(detail["used_ratio"]), ratio >= 0 else { continue }
+                windows[id] = QuotaWindow(id: id, label: label, usedFraction: ratio, remaining: nil, used: nil,
+                                          resetAt: date(detail["reset_time"]), duration: duration)
+            }
+        }
+        guard !windows.isEmpty else { throw ParseError.noLimits }
+        var plan: String?
+        if let user = root["user"] as? [String: Any], let membership = user["membership"] as? [String: Any],
+           let level = membership["level"] as? String {
+            let name = (level.hasPrefix("LEVEL_") ? String(level.dropFirst(6)) : level)
+                .replacingOccurrences(of: "_", with: " ").trimmingCharacters(in: .whitespacesAndNewlines)
+            if !name.isEmpty { plan = name.lowercased().capitalized }
+        }
+        return QuotaSnapshot(id: "kimi", displayName: "Kimi Code", fidelity: "official", status: .ok,
+                             windows: kinds.compactMap { windows[$0.1] }, headlineId: "rolling", block: nil,
+                             account: nil, plan: plan, observedAt: time, source: "Kimi Code", credits: nil,
+                             nextAllowedAt: nil, waitingForRefresh: false, configured: true)
+    }
+
+    private static func number(_ raw: Any?) -> Double? {
+        let value: Double?
+        if let number = raw as? NSNumber {
+            guard CFGetTypeID(number) != CFBooleanGetTypeID() else { return nil }
+            value = number.doubleValue
+        } else if let text = raw as? String { value = Double(text) }
+        else { return nil }
+        return value.flatMap { $0.isFinite ? $0 : nil }
+    }
+}
