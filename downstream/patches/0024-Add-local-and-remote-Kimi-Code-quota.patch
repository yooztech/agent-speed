+    [Fact]
+    public void DpapiStoreRoundTripsAtomicallyWithoutPlaintextAndMetadataSurvivesRestart()
+    {
+        if (!OperatingSystem.IsWindows()) return;
+        var root = Path.Combine(Path.GetTempPath(), "kimi-dpapi-" + Guid.NewGuid().ToString("N"));
+        var path = Path.Combine(root, "kimi.key");
+        try
+        {
+            var store = new KimiCredentialStore(path);
+            store.Set("international", "synthetic-dpapi-key");
+            Assert.DoesNotContain("synthetic-dpapi-key", System.Text.Encoding.UTF8.GetString(File.ReadAllBytes(path)));
+            var restarted = new KimiCredentialStore(path);
+            Assert.Equal(new KimiCredentialMetadata(true, "international"), restarted.GetMetadata());
+            Assert.Equal("synthetic-dpapi-key", restarted.Read()!.ApiKey);
+            restarted.Set("china", "replacement"); Assert.Equal("china", restarted.Read()!.Region);
+            restarted.Delete(); Assert.Null(restarted.Read()); Assert.False(restarted.GetMetadata().Configured);
+            Assert.Empty(Directory.GetFiles(root));
+        }
+        finally { if (Directory.Exists(root)) Directory.Delete(root, true); }
+    }
