+Snapshot parseKimi(const std::string& json, std::int64_t now) {
+    Document doc; if (json.size() > kBody || !doc.parse(json) || !doc.root().isObject()) throw std::runtime_error("quota response");
+    auto root = doc.root(); Snapshot s = empty("kimi", "ok"); s.headlineId = "rolling";
+    auto count = [](Value v) -> std::optional<double> {
+        auto n = number(v, true); return n && *n >= 0 && std::floor(*n) == *n ? n : std::nullopt;
+    };
+    auto add = [&](Window w) {
+        auto found = std::find_if(s.windows.begin(), s.windows.end(), [&](const auto& existing) { return existing.id == w.id; });
+        if (found == s.windows.end()) s.windows.push_back(std::move(w)); else *found = std::move(w);
+    };
+    auto legacy = [&](Value detail, const char* id, const char* label, double duration) {
+        if (!detail.isObject()) return;
+        auto limit = count(detail["limit"]), used = count(detail["used"]);
+        if (!used && limit && *limit > 0) if (auto remaining = count(detail["remaining"]); remaining && *remaining <= *limit) used = *limit - *remaining;
+        if (!used) return;
+        if (limit && *limit > 0) add(window(id, label, *used / *limit, date(detail["resetTime"]), duration));
+        else add({id, label, std::nullopt, std::nullopt, used, duration, date(detail["resetTime"])});
+    };
+    legacy(root["usage"], "weekly", "Weekly limit", 604800);
+    if (root["limits"].isArray()) for (auto entry : root["limits"].elements()) {
+        auto raw = entry["window"]; auto duration = count(raw["duration"]);
+        if (!duration) continue;
+        if ((*duration == 300 && raw["timeUnit"].equals("TIME_UNIT_MINUTE")) || (*duration == 5 && raw["timeUnit"].equals("TIME_UNIT_HOUR")))
+            legacy(entry["detail"], "rolling", "5h limit", 18000);
+        else if (*duration == 1 && raw["timeUnit"].equals("TIME_UNIT_WEEK")) legacy(entry["detail"], "weekly", "Weekly limit", 604800);
+    }
+    struct Quota { const char* key; const char* id; const char* label; std::optional<double> duration; };
+    const Quota quotas[] = {{"limit_5h", "rolling", "5h limit", 18000}, {"limit_7d", "weekly", "Weekly limit", 604800},
+        {"limit_month_total", "monthly-total", "Monthly limit", std::nullopt}, {"limit_month_code", "monthly-code", "Monthly code limit", std::nullopt}};
+    for (const auto& quota : quotas) {
+        auto detail = root["usages"][quota.key]; auto used = number(detail["used_ratio"], true);
+        if (used && *used >= 0) add(window(quota.id, quota.label, used, date(detail["reset_time"]), quota.duration));
+    }
+    if (s.windows.empty()) { s.status = "unsupported"; s.block = "No Kimi Code usage limits on this account"; return s; }
+    s.observedAt = now;
+    if (auto level = text(root["user"]["membership"]["level"]); level && !level->empty()) {
+        std::string plan = level->rfind("LEVEL_", 0) == 0 ? level->substr(6) : *level;
+        bool first = true;
+        for (char& c : plan) {
+            if (c == '_') c = ' ';
+            const auto byte = static_cast<unsigned char>(c);
+            c = static_cast<char>(first ? std::toupper(byte) : std::tolower(byte)); first = c == ' ' || c == '-';
+        }
+        if (!plan.empty()) s.plan = std::move(plan);
+    }
+    return s;
+}
