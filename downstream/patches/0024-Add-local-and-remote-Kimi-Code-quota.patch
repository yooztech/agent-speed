+TEST(CollectorKimiKeys, ConfigurationCompletesDuringBlockedHttpAndInvalidatesQueuedOldObservations) {
+    Home home; home.kimiAuth(); home.codexAuth(); const auto p = home.paths();
+    ASSERT_TRUE(q::manageKimiCredentials(p, "set", "china", "synthetic-blocked").ok);
+    std::mutex mutex; std::condition_variable cv; bool started = false, release = false;
+    q::Service service(p, [&](const std::string& url, const auto& credential, bool reset) {
+        if (url.find("kimi") != std::string::npos) {
+            std::unique_lock<std::mutex> lock(mutex); started = true; cv.notify_all(); cv.wait_for(lock, std::chrono::seconds(10), [&] { return release; });
+            return q::HttpReply{200, kimi, ""};
+        }
+        return success(url, credential, reset);
+    }, [] { return now; });
+    ASSERT_TRUE(service.control(command("inflight", true, "\"kimi\""), 1));
+    { std::unique_lock<std::mutex> lock(mutex); if (!cv.wait_for(lock, std::chrono::seconds(3), [&] { return started; })) { release = true; cv.notify_all(); FAIL() << "Kimi request did not start"; } }
+    EXPECT_TRUE(service.control(R"({"type":"kimi_credentials","requestId":"remove","operation":"delete"})", 2));
+    EXPECT_TRUE(service.control(command("other-supplier", false, "\"codex\""), 3));
+    auto independent = replies(service, 2); EXPECT_EQ(independent.size(), 2u);
+    std::set<std::uint64_t> subscribers; for (const auto& item : independent) subscribers.insert(item.first);
+    EXPECT_EQ(subscribers, (std::set<std::uint64_t>{2, 3}));
+    { std::lock_guard<std::mutex> lock(mutex); release = true; } cv.notify_all();
+    auto old = replies(service, 1); ASSERT_EQ(old.size(), 1u); Document doc; ASSERT_TRUE(doc.parse(old[0].second));
+    EXPECT_EQ(old[0].first, 1u); EXPECT_EQ(doc.root()["snapshots"].at(0)["windows"].size(), 0u);
+    EXPECT_TRUE(service.control(command("after-remove", false, "\"kimi\""), 1));
+    auto cleared = replies(service, 1); ASSERT_EQ(cleared.size(), 1u); ASSERT_TRUE(doc.parse(cleared[0].second));
+    EXPECT_EQ(doc.root()["snapshots"].at(0)["windows"].size(), 0u);
+}
