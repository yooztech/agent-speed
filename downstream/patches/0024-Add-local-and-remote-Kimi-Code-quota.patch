diff --git a/macos/Sources/AgentSpeed/App/KimiCredentialResponse.swift b/macos/Sources/AgentSpeed/App/KimiCredentialResponse.swift
new file mode 100644
index 00000000..4b868920
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/KimiCredentialResponse.swift
@@ -0,0 +1,32 @@
+import Foundation
+import AgentSpeedCore
+
+struct KimiCredentialResponse: Decodable, Sendable {
+    let type: String
+    let requestId: String
+    let status: String
+    let configured: Bool?
+    let region: KimiRegion?
+    let errorCode: String?
+
+    static func decode(_ data: Data) -> Self? {
+        guard data.count <= 16_384,
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              Set(root.keys).isSubset(of: ["type", "requestId", "status", "configured", "region", "errorCode"]),
+              let value = try? JSONDecoder().decode(Self.self, from: data),
+              value.type == "kimi_credentials_result", (1...128).contains(value.requestId.utf8.count),
+              value.requestId.utf8.allSatisfy({ (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 45 || $0 == 95 }) else { return nil }
+        switch value.status {
+        case "ok":
+            guard let configured = value.configured, value.errorCode == nil,
+                  configured == (value.region != nil), root.keys.contains("region") else { return nil }
+        case "error":
+            guard let code = value.errorCode, ["invalid_request", "storage_error"].contains(code), value.configured == nil, value.region == nil else { return nil }
+        default: return nil
+        }
+        return value
+    }
+}
+
+enum KimiCredentialOperation: String, Sendable { case get, set, delete }
+enum KimiCredentialFailure: Error, Equatable { case invalidRequest, storageError, disconnected, unsupported, cancelled }
