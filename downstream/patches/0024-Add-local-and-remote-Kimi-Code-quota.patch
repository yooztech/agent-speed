+            for (auto& [fd, c] : clients) for (auto it = c.output.begin(); it != c.output.end();) {
+                agentspeed::json::Document doc; bool oldKimi = false;
+                if (doc.parse(it->data) && doc.root()["type"].equals("quota"))
+                    for (auto snapshot : doc.root()["snapshots"].elements()) if (snapshot["id"].equals("kimi")) { oldKimi = true; break; }
+                if (!oldKimi) { ++it; continue; }
+                // A partly transmitted JSON line cannot safely be replaced. Disconnect
