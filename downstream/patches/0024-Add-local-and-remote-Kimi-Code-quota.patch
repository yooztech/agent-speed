+TEST(CollectorKimiKeys, ProtocolStrictnessMetadataAndSubscriberIsolation) {
+    Home home; std::atomic<int> calls{0};
+    q::Service service(home.paths(), [&](const auto&, const auto&, bool) { ++calls; return q::HttpReply{}; }, [] { return now; });
+    auto exchange = [&](const std::string& command) {
+        EXPECT_TRUE(service.control(command, 42)); auto out = replies(service, 1);
+        EXPECT_EQ(out.size(), 1u); if (out.empty()) return std::string();
+        EXPECT_EQ(out[0].first, 42u); EXPECT_EQ(out[0].second.find("synthetic"), std::string::npos); return out[0].second;
+    };
+    auto saved = exchange(R"({"type":"kimi_credentials","requestId":"save_1","operation":"set","region":"international","apiKey":"synthetic-wire"})");
+    Document doc; ASSERT_TRUE(doc.parse(saved)); EXPECT_TRUE(doc.root()["status"].equals("ok")); EXPECT_TRUE(doc.root()["configured"].isTrue()); EXPECT_TRUE(doc.root()["region"].equals("international"));
+    EXPECT_EQ(doc.root().size(), 5u); EXPECT_FALSE(doc.root()["apiKey"].valid());
+    ASSERT_TRUE(doc.parse(exchange(R"({"type":"kimi_credentials","requestId":"get-1","operation":"get"})")));
+    EXPECT_TRUE(doc.root()["configured"].isTrue()); EXPECT_TRUE(doc.root()["region"].equals("international"));
+    for (const auto* fields : {R"("operation":"get","apiKey":"synthetic-extra")", R"("operation":"get","region":"china")", R"("operation":"delete","unknown":true)", R"("operation":"set","region":"other","apiKey":"synthetic-invalid")", R"("operation":"set","region":"china","apiKey":"bad key")", R"("operation":"get","operation":"delete")"}) {
+        ASSERT_TRUE(doc.parse(exchange(std::string("{\"type\":\"kimi_credentials\",\"requestId\":\"invalid\",") + fields + "}")));
+        EXPECT_TRUE(doc.root()["errorCode"].equals("invalid_request")); EXPECT_FALSE(doc.root()["configured"].valid());
+    }
+    EXPECT_FALSE(service.control(R"({"type":"kimi_credentials","requestId":"unsafe id","operation":"get"})", 42));
+    EXPECT_FALSE(service.control(std::string(16385, 'x'), 42));
+    ASSERT_TRUE(doc.parse(exchange(R"({"type":"kimi_credentials","requestId":"delete","operation":"delete"})")));
+    EXPECT_TRUE(doc.root()["status"].equals("ok")); EXPECT_FALSE(doc.root()["configured"].isTrue()); EXPECT_TRUE(doc.root()["region"].isNull());
+    EXPECT_EQ(calls, 0);
+    EXPECT_TRUE(service.control(R"({"type":"kimi_credentials","requestId":"disconnected","operation":"get"})", 99));
+    service.disconnected(99);
+    EXPECT_TRUE(service.control(R"({"type":"kimi_credentials","requestId":"alive","operation":"get"})", 42));
+    auto out = replies(service, 1); ASSERT_EQ(out.size(), 1u); EXPECT_EQ(out[0].first, 42u);
+}
