+private final class KimiFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var time = Date(timeIntervalSince1970: 1_800_000_000)
+    private var requests: [URLRequest] = []
+    private var statuses: [Int]
+    let body: Data
+    let retryAfter: String?
+
+    init(_ statuses: [Int] = [200], body: String = #"{"usages":{"limit_5h":{"used_ratio":0.125}}}"#, retryAfter: String? = nil) {
+        self.statuses = statuses
+        self.body = Data(body.utf8)
+        self.retryAfter = retryAfter
+    }
+    func now() -> Date { lock.withLock { time } }
+    func advance(_ seconds: TimeInterval) { lock.withLock { time = time.addingTimeInterval(seconds) } }
+    func captured() -> [URLRequest] { lock.withLock { requests } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        let status = lock.withLock {
+            requests.append(request)
+            return statuses.count > 1 ? statuses.removeFirst() : statuses[0]
+        }
+        return (body, HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil,
+                                      headerFields: retryAfter.map { ["Retry-After": $0] })!)
+    }
+}
