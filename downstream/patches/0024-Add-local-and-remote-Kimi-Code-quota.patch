+TEST(CollectorQuotaService, KimiHasAnIndependentWorkerAndCoalescesAcrossSubscribers) {
+    Home home; home.codexAuth(); home.goAuth(); home.kimiAuth(); std::mutex mutex; std::condition_variable cv;
+    bool started = false, release = false; std::atomic<int> kimiCalls{0};
+    q::Service service(home.paths(), [&](const std::string& url, const q::Credential& c, bool reset) {
+        if (url.find("api.kimi.com") != std::string::npos) {
+            ++kimiCalls; std::unique_lock<std::mutex> lock(mutex); started = true; cv.notify_all(); cv.wait(lock, [&] { return release; });
+        }
+        return success(url, c, reset);
+    }, [] { return now; });
+    ASSERT_TRUE(service.control(command("removed", true, "\"kimi\""), 10));
+    { std::unique_lock<std::mutex> lock(mutex); if (!cv.wait_for(lock, std::chrono::seconds(3), [&] { return started; })) { release = true; cv.notify_all(); FAIL() << "Kimi worker did not start"; } }
+    EXPECT_TRUE(service.control(command("all", true), 11)); EXPECT_TRUE(service.control(command("independent", true, "\"codex\",\"opencode-go\""), 12));
+    auto independent = replies(service, 1); EXPECT_EQ(independent.size(), 1u); if (!independent.empty()) EXPECT_EQ(independent[0].first, 12u);
+    service.disconnected(10);
+    { std::lock_guard<std::mutex> lock(mutex); release = true; } cv.notify_all();
+    auto out = replies(service, 1); ASSERT_EQ(out.size(), 1u); EXPECT_EQ(out[0].first, 11u); EXPECT_EQ(kimiCalls, 1);
+    Document doc; ASSERT_TRUE(doc.parse(out[0].second)); ASSERT_EQ(doc.root()["snapshots"].size(), 3u); EXPECT_TRUE(doc.root()["snapshots"].at(2)["id"].equals("kimi")); EXPECT_TRUE(doc.root()["snapshots"].at(2)["status"].equals("ok"));
+}
