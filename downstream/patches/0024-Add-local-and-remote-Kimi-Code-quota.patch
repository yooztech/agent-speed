diff --git a/macos/Tests/AgentSpeedAppTests/KimiCredentialTransportTests.swift b/macos/Tests/AgentSpeedAppTests/KimiCredentialTransportTests.swift
new file mode 100644
index 00000000..d4eca66c
--- /dev/null
+++ b/macos/Tests/AgentSpeedAppTests/KimiCredentialTransportTests.swift
@@ -0,0 +1,109 @@
+import Foundation
+import Testing
+@testable import AgentSpeed
+import AgentSpeedCore
+
+@MainActor
+private final class CredentialChannel {
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let transport: RemoteQuotaTransport
+    let host = RemoteHost(label: "Linux", destination: "user@host", enabled: true)
+    let connection = UUID()
+    let commands: AsyncStream<Data>
+    private let events: AsyncStream<Data>.Continuation
+    init() {
+        defaults = UserDefaults(suiteName: suite)!
+        transport = RemoteQuotaTransport(defaults: defaults)
+        let stream = AsyncStream<Data>.makeStream(); commands = stream.stream; events = stream.continuation
+        transport.configure(hosts: [host], connections: [host.id: connection])
+        transport.send = { [events] _, data in events.yield(data); return true }
+    }
+    func clean() { events.finish(); defaults.removePersistentDomain(forName: suite) }
+    func response(_ id: String, configured: Bool = true, region: String = "international") throws -> KimiCredentialResponse {
+        let root: [String: Any] = ["type": "kimi_credentials_result", "requestId": id, "status": "ok",
+                                   "configured": configured, "region": configured ? region as Any : NSNull()]
+        return try #require(KimiCredentialResponse.decode(JSONSerialization.data(withJSONObject: root)))
+    }
+}
+
+@Suite("Kimi remote credential protocol")
+@MainActor
+struct KimiCredentialTransportTests {
+    @Test func validatesMetadataResponsesWithoutAcceptingSecretsOrUnknownFields() throws {
+        let valid = #"{"type":"kimi_credentials_result","requestId":"safe_ID-1","status":"ok","configured":true,"region":"china"}"#
+        #expect(KimiCredentialResponse.decode(Data(valid.utf8))?.region == .china)
+        let absent = #"{"type":"kimi_credentials_result","requestId":"safe_ID-1","status":"ok","configured":false,"region":null}"#
+        #expect(KimiCredentialResponse.decode(Data(absent.utf8))?.configured == false)
+        for json in [
+            #"{"type":"kimi_credentials_result","requestId":"unsafe id","status":"ok","configured":false,"region":null}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"ok","configured":false,"region":"china"}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"ok","configured":true,"region":null}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"ok","configured":false}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"ok","configured":true,"region":"china","apiKey":"never-accept"}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"error","errorCode":"raw_exception"}"#,
+            #"{"type":"kimi_credentials_result","requestId":"x","status":"error","errorCode":"storage_error","configured":true}"#
+        ] { #expect(KimiCredentialResponse.decode(Data(json.utf8)) == nil) }
+        #expect(KimiCredentialResponse.decode(Data(#"{"type":"kimi_credentials_result","requestId":"x","status":"error","errorCode":"storage_error"}"#.utf8))?.errorCode == "storage_error")
+    }
+
+    @Test func sendsExactCommandsAndCorrelatesHostConnectionAndSubscriber() async throws {
+        let channel = CredentialChannel(); defer { channel.clean() }
+        var commands = channel.commands.makeAsyncIterator()
+        for operation in [KimiCredentialOperation.get, .set, .delete] {
+            let pending = Task {
+                await channel.transport.credentials(hostID: channel.host.id, operation: operation,
+                    region: operation == .set ? .international : nil, apiKey: operation == .set ? "transient-secret" : nil)
+            }
+            let bytes = try #require(await commands.next())
+            #expect(bytes.last == 10 && bytes.count <= 16_384)
+            let root = try #require(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
+            #expect(root["type"] as? String == "kimi_credentials")
+            #expect(root["operation"] as? String == operation.rawValue)
+            #expect(Set(root.keys) == (operation == .set ? ["type", "requestId", "operation", "region", "apiKey"] : ["type", "requestId", "operation"]))
+            let id = try #require(root["requestId"] as? String)
+            let response = try channel.response(id, configured: operation != .delete)
+            channel.transport.receiveCredentials(response, hostID: UUID(), connection: channel.connection)
+            channel.transport.receiveCredentials(response, hostID: channel.host.id, connection: UUID())
+            channel.transport.receiveCredentials(response, hostID: channel.host.id, connection: channel.connection)
+            let value = try (await pending.value).get()
+            #expect(value.configured == (operation != .delete))
+            #expect(value.region == (operation == .delete ? nil : .international))
+            #expect(!channel.defaults.dictionaryRepresentation().description.contains("transient-secret"))
+        }
+    }
+
+    @Test func disconnectDestinationChangeCancellationAndTimeoutNeverReportSaved() async throws {
+        for reason in ["disconnect", "destination", "cancel", "timeout"] {
+            let channel = CredentialChannel(); defer { channel.clean() }
+            var commands = channel.commands.makeAsyncIterator()
+            let pending = Task { await channel.transport.credentials(hostID: channel.host.id, operation: .set, region: .china, apiKey: "secret") }
+            let bytes = try #require(await commands.next())
+            let root = try #require(JSONSerialization.jsonObject(with: bytes) as? [String: Any])
+            let id = try #require(root["requestId"] as? String)
+            if reason == "disconnect" { channel.transport.configure(hosts: [channel.host], connections: [:]) }
+            if reason == "destination" {
+                var changed = channel.host; changed.destination = "other@host"
+                channel.transport.configure(hosts: [changed], connections: [changed.id: UUID()])
+            }
+            if reason == "cancel" { pending.cancel() }
+            if reason == "timeout" { channel.transport.expireCredentials(id) }
+            let result = await pending.value
+            guard case .failure(let error) = result else { Issue.record("Unconfirmed command reported success"); continue }
+            #expect(error == (reason == "timeout" ? .unsupported : reason == "cancel" ? .cancelled : .disconnected))
+            // A late reply cannot resurrect a cancelled subscriber or change persisted quota.
+            channel.transport.receiveCredentials(try channel.response(id), hostID: channel.host.id, connection: channel.connection)
+            #expect(!channel.defaults.dictionaryRepresentation().description.contains("secret"))
+        }
+    }
+
+    @Test func disconnectedHostIsListedWithoutStartingConnectionOrSendingCommands() async throws {
+        let channel = CredentialChannel(); defer { channel.clean() }
+        channel.transport.configure(hosts: [channel.host], connections: [:])
+        #expect(channel.transport.sources.contains { $0.id == QuotaSourceIdentity.remote(hostID: channel.host.id, providerID: "kimi") })
+        #expect(!channel.transport.isConnected(hostID: channel.host.id))
+        if case .failure(.disconnected) = await channel.transport.credentials(hostID: channel.host.id, operation: .get) {} else {
+            Issue.record("Disconnected host accepted a credential command")
+        }
+    }
+}
