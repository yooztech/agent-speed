--- /dev/null
+++ b/macos/Sources/AgentSpeed/SettingsWindow/Panes/KimiKeyEditor.swift
@@ -0,0 +1,141 @@
+import AgentSpeedCore
+import SwiftUI
+
+/// This sheet owns transient input; quota snapshots and the app's observable model never contain it.
+struct KimiKeyEditor: View {
+    let quota: QuotaController
+    let l10n: Localizer
+    @Environment(\.dismiss) private var dismiss
+    @State private var sourceID = "kimi"
+    @State private var region: KimiRegion = .china
+    @State private var apiKey = ""
+    @State private var metadata: KimiKeyMetadata?
+    @State private var message: String?
+    @State private var busy = false
+    @State private var operation: Task<Void, Never>?
+
+    private var connected: Bool { quota.kimiSourceConnected(sourceID) }
+    private var destinationRevision: String { sourceID + ":" + (quota.kimiConnections[sourceID]?.uuidString ?? "local-or-disconnected") }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            Text(l10n("mac.quota.kimi.keyTitle")).font(.headline)
+            Form {
+                Picker(l10n("mac.quota.source"), selection: $sourceID) {
+                    ForEach(quota.kimiSources) { source in
+                        Text(source.id == "kimi" ? l10n("orbs.sources.local") : source.name).tag(source.id)
+                    }
+                }
+                if sourceID != "kimi" {
+                    Text(l10n(connected ? "mac.quota.kimi.connected" : "mac.quota.kimi.disconnected"))
+                        .foregroundStyle(.secondary)
+                }
+                Picker(l10n("mac.quota.kimi.region"), selection: $region) {
+                    Text(l10n("mac.quota.kimi.china")).tag(KimiRegion.china)
+                    Text(l10n("mac.quota.kimi.international")).tag(KimiRegion.international)
+                }
+                .disabled(busy || !connected)
+                SecureField(l10n("mac.quota.kimi.apiKey"), text: $apiKey)
+                    .textContentType(nil)
+                    .autocorrectionDisabled()
+                    .disabled(busy || !connected)
+                if let metadata {
+                    Text(l10n(metadata.configured ? "mac.quota.kimi.configured" : "mac.quota.kimi.notConfigured"))
+                        .foregroundStyle(.secondary)
+                }
+            }.formStyle(.grouped)
+            Text(l10n("mac.quota.kimi.keyHint")).font(.footnote).foregroundStyle(.secondary)
+            if let message { Text(l10n(message)).font(.footnote).textSelection(.enabled) }
+            HStack {
+                if busy { ProgressView().controlSize(.small) }
+                Button(l10n("orbs.remove.button"), role: .destructive) { remove() }
+                    .disabled(!connected || busy || metadata?.configured == false)
+                Spacer()
+                Button(l10n("history.cancel")) { close() }.keyboardShortcut(.cancelAction)
+                Button(l10n("mac.quota.kimi.saveVerify")) { save() }
+                    .keyboardShortcut(.defaultAction)
+                    .disabled(!connected || busy || !KimiAPIKey.isValid(apiKey))
+            }
+        }
+        .padding(20)
+        .frame(width: 490)
+        .task(id: destinationRevision) { await loadMetadata() }
+        .onChange(of: sourceID) { apiKey = ""; operation?.cancel() }
+        .onDisappear { apiKey = ""; operation?.cancel(); operation = nil }
+    }
+
+    private func loadMetadata() async {
+        operation?.cancel()
+        operation = nil
+        apiKey = ""
+        metadata = nil
+        message = nil
+        busy = true
+        let result = await quota.kimiMetadata(sourceID: sourceID)
+        guard !Task.isCancelled else { return }
+        busy = false
+        switch result {
+        case .success(let value): metadata = value; region = value.region ?? .china
+        case .failure(let error): message = kimiCredentialMessage(error)
+        }
+    }
+
+    private func save() {
+        let submitted = apiKey, source = sourceID, selectedRegion = region
+        apiKey = ""
+        busy = true
+        message = nil
+        operation = Task {
+            let result = await quota.saveKimi(sourceID: source, region: selectedRegion, apiKey: submitted)
+            guard !Task.isCancelled else { return }
+            busy = false
+            switch result {
+            case .success(let outcome):
+                metadata = KimiKeyMetadata(configured: true, region: selectedRegion)
+                message = completeKimiSave(outcome, dismiss: close)
+            case .failure(let error): message = kimiCredentialMessage(error)
+            }
+            operation = nil
+        }
+    }
+
+    private func remove() {
+        apiKey = ""
+        busy = true
+        message = nil
+        let source = sourceID
+        operation = Task {
+            let result = await quota.removeKimi(sourceID: source)
+            guard !Task.isCancelled else { return }
+            busy = false
+            switch result {
+            case .success(let value): metadata = value; message = "mac.quota.kimi.removed"
+            case .failure(let error): message = kimiCredentialMessage(error)
+            }
+            operation = nil
+        }
+    }
+
+    private func close() { apiKey = ""; operation?.cancel(); operation = nil; dismiss() }
+}
+
+@MainActor
+func completeKimiSave(_ outcome: QuotaController.KimiSaveOutcome, dismiss: () -> Void) -> String? {
+    switch outcome {
+    case .verified:
+        dismiss()
+        return nil
+    case .savedOffline: return "mac.quota.kimi.savedOffline"
+    case .savedVerificationFailed: return "mac.quota.kimi.savedVerificationFailed"
+    }
+}
+
+func kimiCredentialMessage(_ error: KimiCredentialFailure) -> String {
+    switch error {
+    case .invalidRequest: "mac.quota.kimi.invalidKey"
+    case .storageError: "mac.quota.kimi.storageError"
+    case .disconnected: "mac.quota.kimi.disconnected"
+    case .unsupported: "mac.quota.kimi.updateCollector"
+    case .cancelled: "mac.quota.kimi.cancelled"
+    }
+}
