+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class KimiQuotaProviderTests
+{
+    private static readonly DateTimeOffset Time = new(2026, 11, 15, 0, 0, 0, TimeSpan.Zero);
+    private const string Reading = """
+        {"user":{"membership":{"level":"LEVEL_ADVANCED"}},"usage":{"limit":"100","used":"2","remaining":"98"},
+        "limits":[{"window":{"duration":300,"timeUnit":"TIME_UNIT_MINUTE"},"detail":{"limit":"100","used":"8","resetTime":"2026-11-15T05:00:00.123456Z"}}],
+        "usages":{"limit_5h":{"used_ratio":"0.08123456789","reset_time":"2026-11-15T05:00:00.123456Z"},
+        "limit_7d":{"used_ratio":0},"limit_month_total":{"used_ratio":1.25,"reset_time":"unknown"},"limit_month_code":{"used_ratio":"0.25"}},
+        "boosterWallet":{"balance":"100"}}
+        """;
+
+    [Fact]
+    public void ModernPrecisionOverridesLegacyAndKeepsAllWindowsZeroOveruseAndUnknownResets()
+    {
+        var snapshot = KimiQuotaProvider.Parse(Reading, Time);
+        Assert.Equal("kimi", snapshot.Id); Assert.Equal("Kimi Code", snapshot.DisplayName);
+        Assert.Equal("Kimi Code", snapshot.Source); Assert.Equal("rolling", snapshot.HeadlineId);
+        Assert.Equal("Advanced", snapshot.Plan); Assert.Null(snapshot.Account); Assert.Null(snapshot.Credits);
+        Assert.Equal(4, snapshot.Windows.Count);
+        var rolling = Assert.Single(snapshot.Windows, window => window.Id == "rolling");
+        Assert.Equal(.08123456789, rolling.UsedFraction); Assert.Equal(TimeSpan.FromHours(5), rolling.Duration);
+        Assert.Equal(Time.AddHours(5).AddTicks(1234560), rolling.ResetAt);
+        Assert.Equal(0, Assert.Single(snapshot.Windows, window => window.Id == "weekly").UsedFraction);
+        Assert.Equal(TimeSpan.FromDays(7), snapshot.Windows.Single(window => window.Id == "weekly").Duration);
+        var monthly = Assert.Single(snapshot.Windows, window => window.Id == "monthly-total");
+        Assert.Equal(1.25, monthly.UsedFraction); Assert.Null(monthly.Duration); Assert.Null(monthly.ResetAt);
+        Assert.Null(snapshot.Windows.Single(window => window.Id == "monthly-code").Duration);
+    }
+
+    [Theory]
+    [InlineData(300, "TIME_UNIT_MINUTE")]
+    [InlineData(5, "TIME_UNIT_HOUR")]
+    public void LegacyCountsAndRemainingFallbackStayReadable(int duration, string unit)
+    {
+        var snapshot = KimiQuotaProvider.Parse($$$$"""
+            {"usage":{"limit":"100","remaining":"75"},"limits":[
+            {"window":{"duration":{{{{duration}}}},"timeUnit":"{{{{unit}}}}"},"detail":{"limit":100,"used":125,"resetTime":"bad"}},
+            {"window":{"duration":1,"timeUnit":"TIME_UNIT_WEEK"},"detail":{"used":"7"}},
+            {"window":{"duration":1,"timeUnit":"TIME_UNIT_HOUR"},"detail":{"limit":100,"used":1}}]}
+            """, Time);
+        Assert.Equal(2, snapshot.Windows.Count);
+        var weekly = snapshot.Windows.Single(window => window.Id == "weekly");
+        Assert.Null(weekly.UsedFraction); Assert.Equal(7, weekly.Used);
+        var rolling = snapshot.Windows.Single(window => window.Id == "rolling");
+        Assert.Equal(1.25, rolling.UsedFraction); Assert.Null(rolling.ResetAt);
+        var summary = KimiQuotaProvider.Parse("""{"usage":{"limit":"100","remaining":"75"}}""", Time);
+        Assert.Equal(.25, Assert.Single(summary.Windows).UsedFraction);
+    }
+
+    [Theory]
+    [InlineData("true")]
+    [InlineData("false")]
+    [InlineData("null")]
+    [InlineData("-0.1")]
+    [InlineData("\"NaN\"")]
+    [InlineData("\"Infinity\"")]
+    [InlineData("{}")]
+    public void InvalidModernSiblingCannotEraseValidLegacyOrOtherModernMeter(string ratio)
+    {
+        var snapshot = KimiQuotaProvider.Parse($$$$"""
+            {"usage":{"limit":"100","used":"5"},"usages":{"limit_7d":{"used_ratio":{{{{ratio}}}}},"limit_month_code":{"used_ratio":".2"}}}
+            """, Time);
+        Assert.Equal(.05, snapshot.Windows.Single(window => window.Id == "weekly").UsedFraction);
+        Assert.Equal(.2, snapshot.Windows.Single(window => window.Id == "monthly-code").UsedFraction);
+    }
+
+    [Theory]
+    [InlineData("{}")]
+    [InlineData("{\"boosterWallet\":{\"balance\":100}}")]
+    [InlineData("{\"usages\":{\"limit_5h\":{\"used_ratio\":true}}}")]
+    [InlineData("{\"usage\":{\"limit\":true,\"used\":false}}")]
+    public void NoValidMetersIsUnsupportedNotZero(string json)
+    {
+        var snapshot = KimiQuotaProvider.Parse(json, Time);
+        Assert.Equal(QuotaStatus.Unsupported, snapshot.Status); Assert.Empty(snapshot.Windows);
+        Assert.Equal(KimiQuotaProvider.NoLimitsReason, snapshot.Block);
+    }
+
+    [Theory]
+    [InlineData("{}")]
+    [InlineData("{\"access_token\":\"token\"}")]
+    [InlineData("{\"access_token\":\"\",\"expires_at\":9999999999}")]
+    [InlineData("{\"access_token\":\"token\",\"expires_at\":true}")]
+    [InlineData("{\"access_token\":\"token\",\"expires_at\":\"9999999999\"}")]
+    [InlineData("{\"access_token\":\"token\",\"expires_at\":0}")]
+    [InlineData("{\"access_token\":\"token\",\"expires_at\":1e300}")]
+    [InlineData("{\"api_key\":\"moonshot-key\",\"expires_at\":9999999999}")]
+    public async Task InvalidCredentialsAndStaticKeysNeverSendHttp(string json)
+    {
+        using var fixture = new Fixture(); File.WriteAllText(fixture.Auth, json);
+        using var provider = fixture.Provider();
+        Assert.Equal(QuotaStatus.NeedsAuth, provider.ReadCachedSnapshot().Status);
+        Assert.Equal(QuotaStatus.NeedsAuth, (await provider.RefreshAsync()).Status);
+        Assert.Equal(0, fixture.Handler.Calls); Assert.False(Directory.Exists(fixture.Schedule));
+        Assert.Equal(json, File.ReadAllText(fixture.Auth));
+    }
+
+    [Fact]
+    public async Task ExpiredSessionHidesPreviousObservationAndRequiresCliRenewalWithoutHttp()
+    {
+        using var fixture = new Fixture(); using var provider = fixture.Provider();
+        await provider.RefreshAsync(); fixture.Clock = Time.AddHours(2);
+        var result = await provider.RefreshAsync();
+        Assert.Equal(QuotaStatus.NeedsAuth, result.Status); Assert.Empty(result.Windows);
+        Assert.Null(result.Account); Assert.Null(result.ObservedAt); Assert.Equal(KimiQuotaProvider.ExpiredReason, result.Block);
+        Assert.Equal(KimiQuotaProvider.ExpiredReason, provider.ReadCachedSnapshot().Block);
+        Assert.Equal(1, fixture.Handler.Calls);
+        fixture.Credentials("renewed-access", "session-one", fixture.Clock.AddHours(1));
+        Assert.Equal(QuotaStatus.Stale, provider.ReadCachedSnapshot().Status);
+        Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status); Assert.Equal(2, fixture.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task SuccessHasNoHardFloorAndRestartsFromSecretFreeSessionIsolatedCache()
+    {
+        using var fixture = new Fixture();
+        using (var provider = fixture.Provider())
+        {
+            Assert.Equal(QuotaStatus.Error, provider.ReadCachedSnapshot().Status);
+            var result = await provider.RefreshAsync(); Assert.Equal(QuotaStatus.Ok, result.Status); Assert.Null(result.NextAllowedAt);
+            await provider.RefreshStartupAsync(); await provider.RefreshAsync(); Assert.Equal(3, fixture.Handler.Calls);
+        }
+        var cache = File.ReadAllText(Assert.Single(Directory.GetFiles(fixture.Schedule)));
+        Assert.DoesNotContain("access-one", cache); Assert.DoesNotContain("session-one", cache); Assert.DoesNotContain(fixture.Auth, cache);
+        using var restarted = fixture.Provider(); Assert.Equal(QuotaStatus.Stale, restarted.ReadCachedSnapshot().Status);
+        fixture.Credentials("access-two", "session-one"); Assert.Equal(QuotaStatus.Stale, restarted.ReadCachedSnapshot().Status);
+        fixture.Credentials("access-other", "session-other"); Assert.Empty(restarted.ReadCachedSnapshot().Windows);
+        await restarted.RefreshAsync(); Assert.Equal(4, fixture.Handler.Calls);
+        Assert.Equal(2, Directory.GetFiles(fixture.Schedule).Length);
+        File.Delete(fixture.Auth); Assert.Equal(QuotaStatus.NeedsAuth, restarted.ReadCachedSnapshot().Status);
+    }
+
+    [Fact]
+    public async Task OpaqueAccessOnlyIdentityNeverReusesPreviousTokensObservation()
+    {
+        using var fixture = new Fixture(); fixture.Credentials("access-one", null);
+        using var provider = fixture.Provider(); await provider.RefreshAsync();
+        fixture.Credentials("access-two", null); Assert.Empty(provider.ReadCachedSnapshot().Windows);
+    }
+
+    [Theory]
+    [InlineData(401, QuotaStatus.NeedsAuth)]
+    [InlineData(403, QuotaStatus.NeedsAuth)]
+    [InlineData(404, QuotaStatus.Unsupported)]
+    public async Task RejectionClearsPreviousAccountAndPersistsWithoutLeakingValues(int status, QuotaStatus expected)
+    {
+        using var fixture = new Fixture();
+        using (var provider = fixture.Provider())
+        {
+            await provider.RefreshAsync(); fixture.Handler.Reply = _ => Response(status);
+            var result = await provider.RefreshAsync(); Assert.Equal(expected, result.Status);
+            Assert.Empty(result.Windows); Assert.Null(result.ObservedAt); Assert.Null(result.Plan);
+        }
+        using var restarted = fixture.Provider(); Assert.Equal(expected, restarted.ReadCachedSnapshot().Status);
+        Assert.Empty((await restarted.RefreshAsync()).Windows); Assert.Equal(2, fixture.Handler.Calls);
+        fixture.Handler.Reply = _ => Response(200);
+        fixture.Credentials("renewed-token", "session-one");
+        if (status == 404) fixture.Clock = Time.AddMinutes(5);
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshAsync()).Status); Assert.Equal(3, fixture.Handler.Calls);
+    }
+
+    [Theory]
