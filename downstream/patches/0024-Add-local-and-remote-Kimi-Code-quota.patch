+import Foundation
+import Testing
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+private final class ControllerKeyStore: KimiAPIKeyStoring, @unchecked Sendable {
+    private let lock = NSLock()
+    private var key: KimiAPIKey?
+    func read() -> KimiAPIKey? { lock.withLock { key } }
+    func save(region: KimiRegion, apiKey: String) throws {
+        let value = try KimiAPIKey(region: region, apiKey: apiKey)
+        lock.withLock { key = value }
+    }
+    func delete() { lock.withLock { key = nil } }
+}
+
+private final class ControllerKeyHTTP: @unchecked Sendable {
+    private let lock = NSLock()
+    private var calls = 0
+    func count() -> Int { lock.withLock { calls } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock { calls += 1 }
+        return (Data(#"{"usages":{"limit_5h":{"used_ratio":0.5}}}"#.utf8),
+                HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!)
+    }
+}
+
+@MainActor
+private final class KeyControllerFixture {
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let directory: URL
+    let store = ControllerKeyStore()
+    let http = ControllerKeyHTTP()
+    let provider: KimiQuotaProvider
+    let controller: QuotaController
+    init(selected: Bool = false) throws {
+        defaults = UserDefaults(suiteName: suite)!
+        defaults.set(false, forKey: "quota.autoRefreshEnabled")
+        defaults.set(false, forKey: "quota.allSourcesEnabled")
+        defaults.set(selected ? ["kimi"] : [], forKey: "quota.enabledProviderIDs")
+        directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let http = self.http
+        provider = KimiQuotaProvider(authURL: directory.appendingPathComponent("absent-cli.json"),
+            cacheDirectory: directory.appendingPathComponent("cache"), keyStore: store,
+            now: { Date(timeIntervalSince1970: 1_800_000_000) }, transport: { http.fetch($0) })
+        controller = QuotaController(defaults: defaults, providers: [provider], kimiKeyStore: store)
+    }
+    func clean() { controller.dispose(); defaults.removePersistentDomain(forName: suite); try? FileManager.default.removeItem(at: directory) }
+}
+
+@Suite("Kimi key settings controller")
+@MainActor
+struct KimiKeyControllerTests {
+    @Test func verifiedSaveDismissesEditorExactlyOnceWithoutAnInlineSuccessMessage() {
+        var dismissals = 0
+        let message = completeKimiSave(.verified) { dismissals += 1 }
+        #expect(dismissals == 1)
+        #expect(message == nil)
+    }
+
+    @Test func savedButUnverifiedKeepsEditorOpenWithTheSpecificMessage() {
+        var dismissals = 0
+        let offline = completeKimiSave(.savedOffline) { dismissals += 1 }
+        let failed = completeKimiSave(.savedVerificationFailed) { dismissals += 1 }
+        #expect(dismissals == 0)
+        #expect(offline == "mac.quota.kimi.savedOffline")
+        #expect(failed == "mac.quota.kimi.savedVerificationFailed")
+    }
+
+    @Test func savingWithoutNetworkConsentPersistsMetadataButDoesNotVerify() async throws {
+        let fixture = try KeyControllerFixture(); defer { fixture.clean() }
+        let result = try (await fixture.controller.saveKimi(sourceID: "kimi", region: .international, apiKey: "secret-local")).get()
+        if case .savedOffline = result {} else { Issue.record("Offline save was reported as verified") }
+        #expect(fixture.http.count() == 0)
+        #expect(try (await fixture.controller.kimiMetadata(sourceID: "kimi")).get() == KimiKeyMetadata(configured: true, region: .international))
+        #expect(!fixture.defaults.dictionaryRepresentation().description.contains("secret-local"))
+        #expect(fixture.controller.snapshots.isEmpty)
+    }
+
+    @Test func saveVerifiesOnlySelectedDestinationEvenWhenQuotaSourceIsDisabled() async throws {
+        let fixture = try KeyControllerFixture(); defer { fixture.clean() }
+        fixture.controller.setNetworkEnabled(true)
+        #expect(fixture.controller.enabledProviderIDs.isEmpty)
+        let result = try (await fixture.controller.saveKimi(sourceID: "kimi", region: .china, apiKey: "verify-key")).get()
+        if case .verified = result {} else { Issue.record("Supplier validation did not report verified") }
+        #expect(fixture.http.count() == 1)
+        #expect(fixture.controller.enabledProviderIDs.isEmpty && !fixture.controller.allSourcesEnabled)
+        #expect(fixture.controller.snapshots.isEmpty)
+    }
+
+    @Test func removalClearsVisibleOldQuotaAndDoesNotAutomaticallyReadOAuth() async throws {
+        let fixture = try KeyControllerFixture(selected: true); defer { fixture.clean() }
+        fixture.controller.setNetworkEnabled(true)
+        _ = try (await fixture.controller.saveKimi(sourceID: "kimi", region: .china, apiKey: "old-key")).get()
+        #expect(fixture.controller.snapshots.first?.status == .ok)
+        let calls = fixture.http.count()
+        let removed = try (await fixture.controller.removeKimi(sourceID: "kimi")).get()
+        #expect(!removed.configured && removed.region == nil)
+        #expect(fixture.controller.snapshots.isEmpty)
+        #expect(fixture.http.count() == calls)
+        #expect(await fixture.provider.readCachedSnapshot().windows.isEmpty)
+        let restarted = QuotaController(defaults: fixture.defaults, providers: [fixture.provider], kimiKeyStore: fixture.store)
+        await restarted.operationBarrier().value
+        #expect(restarted.snapshots.allSatisfy { $0.windows.isEmpty && $0.observedAt == nil })
+        restarted.dispose()
+    }
+
+    @Test func keySourcesIncludeEveryEnabledHostWithoutChangingQuotaSelection() async throws {
+        let fixture = try KeyControllerFixture(); defer { fixture.clean() }
+        let transport = RemoteQuotaTransport(defaults: fixture.defaults)
+        let enabled = RemoteHost(label: "Enabled", destination: "enabled", enabled: true)
+        let disabled = RemoteHost(label: "Disabled", destination: "disabled", enabled: false)
+        transport.configure(hosts: [enabled, disabled], connections: [:])
+        fixture.controller.updateRemoteSources(transport)
+        #expect(Set(fixture.controller.kimiSources.map(\.id)) == ["kimi", QuotaSourceIdentity.remote(hostID: enabled.id, providerID: "kimi")])
+        #expect(fixture.controller.enabledProviderIDs.isEmpty)
+        #expect(!fixture.controller.kimiSourceConnected(QuotaSourceIdentity.remote(hostID: enabled.id, providerID: "kimi")))
+        #expect(fixture.http.count() == 0)
+    }
+}
