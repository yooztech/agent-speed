+using System.Globalization;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core;
+
+/// <remarks>Adapted from Codenotch (MIT), commit 835550a342871779135b6484d6899161c5222f7c,
+/// Sources/Providers/KimiCredentials.swift, KimiProvider.swift and KimiUsage.swift.
+/// See QuotaNotch.LICENSE.txt. OAuth login and renewal belong exclusively to Kimi Code CLI.</remarks>
+public sealed class KimiQuotaProvider : IQuotaProvider
+{
+    private static readonly Uri ChinaEndpoint = new("https://api.kimi.com/coding/v1/usages");
+    private static readonly Uri InternationalEndpoint = new("https://api.kimi.ai/coding/v1/usages");
+    public const string KeyRejectedReason = "Kimi API key was rejected. Replace it or check its region in Settings.";
+    public const string KeyStorageReason = "Kimi key storage is unavailable. Save the key again or remove it in Settings.";
+    public const string KeyInvalidReason = "Kimi API key or region is invalid. Replace it in Settings.";
+    internal const string ExpiredReason = "Kimi Code session expired. Open Kimi Code CLI and run /login to renew.";
+    internal const string SignInReason = "Open Kimi Code CLI and run /login to sign in.";
+    internal const string NoPlanReason = "No Kimi Code plan on this account";
+    internal const string NoLimitsReason = "No Kimi Code usage limits on this account";
+    private const string Source = "Kimi Code";
+    private readonly string credentialPath, scheduleDirectory;
+    private readonly HttpClient client;
+    private readonly Func<DateTimeOffset> now;
+    private readonly IKimiCredentialStore keyStore;
+    private readonly object gate = new();
+    private readonly Dictionary<string, Schedule> schedules = new(StringComparer.Ordinal);
+    private Task<QuotaSnapshot>? inFlight;
+    private CancellationTokenSource? activeCancellation;
+    private bool disposed;
+    private int credentialGeneration;
+
+    public KimiQuotaProvider(IKimiCredentialStore? keyStore = null) : this(CredentialsPath(),
+        Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota", "kimi"),
+        new HttpClient(new HttpClientHandler { AllowAutoRedirect = false }), () => DateTimeOffset.UtcNow, keyStore) { }
+
+    internal KimiQuotaProvider(string credentialPath, string scheduleDirectory, HttpClient client, Func<DateTimeOffset> now,
+        IKimiCredentialStore? keyStore = null)
+    {
+        this.credentialPath = credentialPath;
+        this.scheduleDirectory = scheduleDirectory;
+        this.client = client;
+        this.now = now;
+        this.keyStore = keyStore ?? new KimiCredentialStore();
+    }
+
+    internal static string CredentialsPath() => Path.Combine(
+        Environment.GetEnvironmentVariable("KIMI_CODE_HOME") is { Length: > 0 } root ? root :
+            Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".kimi-code"), "credentials", "kimi-code.json");
+
+    private sealed record Credential(string Token, DateTimeOffset Expires, string Key, string Region = "china", bool ApiKey = false)
+    {
+        public string TokenKey => Digest((ApiKey ? "key:" : "oauth:") + Region + ":" + Token);
+        public string RejectedReason => ApiKey ? KeyRejectedReason : SignInReason;
+        public override string ToString() => "Kimi credential";
+    }
+
+    private Credential? ReadCredentials()
+    {
+        var stored = keyStore.Read();
+        if (stored is not null)
+        {
+            if (!KimiCredentials.ValidRegion(stored.Region) || !KimiCredentials.ValidKey(stored.ApiKey))
+                throw new InvalidKimiKeyException();
+            return new(stored.ApiKey, DateTimeOffset.MaxValue, Digest("key:" + stored.Region + ":" + stored.ApiKey), stored.Region, true);
+        }
+        try
+        {
+            using var document = JsonDocument.Parse(File.ReadAllText(credentialPath));
+            var root = document.RootElement;
+            var token = Text(root, "access_token");
+            var expires = Number(root, "expires_at");
+            if (string.IsNullOrWhiteSpace(token) || token.Any(char.IsControl) || expires is not > 0 || expires > 253402300799) return null;
+            var refresh = Text(root, "refresh_token");
+            // A CLI-owned refresh session survives access-token rotation. Opaque sessions without one
+            // deliberately miss cache after rotation rather than guessing an account from provider responses.
+            var identity = !string.IsNullOrWhiteSpace(refresh) ? "refresh:" + refresh : "access:" + token;
+            return new(token, DateTimeOffset.UnixEpoch.AddSeconds(expires.Value), Digest("oauth:china:" + identity));
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or JsonException or ArgumentException)
+        { return null; }
+    }
+
+    private sealed class InvalidKimiKeyException : Exception { }
+
+    private Credential? ReadSafe(out QuotaSnapshot? error)
+    {
+        error = null;
+        try { return ReadCredentials(); }
+        catch (KimiCredentialException) { error = Empty(QuotaStatus.Error, block: KeyStorageReason); }
+        catch (InvalidKimiKeyException) { error = Empty(QuotaStatus.NeedsAuth, block: KeyInvalidReason); }
+        return null;
+    }
+
+    public QuotaSnapshot ReadCachedSnapshot()
+    {
+        lock (gate)
+        {
+            var credential = ReadSafe(out var error);
+            if (error is not null) return error;
+            if (disposed || credential is null) return Empty(QuotaStatus.NeedsAuth, block: SignInReason);
+            if (credential.Expires <= now()) return Empty(QuotaStatus.NeedsAuth, block: ExpiredReason);
+            var schedule = GetSchedule(credential.Key);
+            if (schedule.RejectedToken == credential.TokenKey) return Empty(QuotaStatus.NeedsAuth, block: credential.RejectedReason);
+            if (schedule.UnsupportedReason is { } reason && schedule.NextAllowedAt > now())
+                return Empty(QuotaStatus.Unsupported, schedule.NextAllowedAt, reason);
+            return StaleOrError(schedule);
+        }
+    }
+
+    public Task<QuotaSnapshot> RefreshAsync() => StartRefresh();
+    public Task<QuotaSnapshot> RefreshStartupAsync() => StartRefresh();
+    private Task<QuotaSnapshot> StartRefresh()
+    {
+        lock (gate)
+        {
+            if (disposed) return Task.FromResult(Empty(QuotaStatus.Error));
+            if (inFlight is { IsCompleted: false }) return inFlight;
+            activeCancellation?.Dispose();
+            activeCancellation = new CancellationTokenSource();
+            return inFlight = RefreshCoreAsync(activeCancellation.Token);
+        }
+    }
+    public void Cancel() { lock (gate) activeCancellation?.Cancel(); }
+    public void Dispose() { lock (gate) { disposed = true; activeCancellation?.Cancel(); client.Dispose(); } }
+
+    /// <summary>Called after an explicit key mutation, before rendering or verifying the new account.</summary>
+    public void CredentialsChanged()
+    {
+        lock (gate)
+        {
+            credentialGeneration++;
+            activeCancellation?.Cancel();
+            inFlight = null;
+            schedules.Clear();
+            try
+            {
+                if (Directory.Exists(scheduleDirectory))
+                    foreach (var path in Directory.EnumerateFiles(scheduleDirectory, "*.json")) File.Delete(path);
+            }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        }
+    }
+    private async Task<QuotaSnapshot> RefreshCoreAsync(CancellationToken cancellationToken)
+    {
+        int generation;
+        lock (gate) generation = credentialGeneration;
+        var credential = ReadSafe(out var credentialError);
+        if (credentialError is not null) return credentialError;
+        if (credential is null) return Empty(QuotaStatus.NeedsAuth, block: SignInReason);
+        if (credential.Expires <= now()) return Empty(QuotaStatus.NeedsAuth, block: ExpiredReason);
+        Schedule schedule;
+        lock (gate)
+        {
+            schedule = GetSchedule(credential.Key).Copy();
+            if (schedule.RejectedToken == credential.TokenKey) return Empty(QuotaStatus.NeedsAuth, block: credential.RejectedReason);
+            if (schedule.NextAllowedAt is { } next && now() < next)
+                return schedule.UnsupportedReason is { } reason ? Empty(QuotaStatus.Unsupported, next, reason) : StaleOrError(schedule);
+            schedule.RejectedToken = null;
+            schedule.UnsupportedReason = null;
+        }
+        QuotaSnapshot result;
+        try
+        {
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            timeout.CancelAfter(TimeSpan.FromSeconds(15));
+            using var request = new HttpRequestMessage(HttpMethod.Get, credential.Region == "international" ? InternationalEndpoint : ChinaEndpoint);
+            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", credential.Token);
+            request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
+            using var response = await client.SendAsync(request, timeout.Token).ConfigureAwait(false);
+            if (response.IsSuccessStatusCode)
+            {
+                result = Parse(await response.Content.ReadAsStringAsync(timeout.Token).ConfigureAwait(false), now());
+                if (result.Status == QuotaStatus.Unsupported) RejectPlan(schedule, result.Block!);
+                else
+                {
+                    schedule.Snapshot = result;
+                    schedule.NextAllowedAt = null;
+                    schedule.Failures = 0;
+                    schedule.ColdFailures = 0;
+                }
+                result = result with { NextAllowedAt = schedule.NextAllowedAt };
+            }
+            else if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+            {
+                schedule.Snapshot = null;
+                schedule.NextAllowedAt = null;
+                schedule.Failures = 0;
+                schedule.ColdFailures = 0;
+                schedule.RejectedToken = credential.TokenKey;
+                result = Empty(QuotaStatus.NeedsAuth, block: credential.RejectedReason);
+            }
+            else if (response.StatusCode == HttpStatusCode.NotFound)
+            {
+                RejectPlan(schedule, NoPlanReason);
+                result = Empty(QuotaStatus.Unsupported, schedule.NextAllowedAt, NoPlanReason);
+            }
+            else
+            {
+                var completed = now();
+                Backoff(schedule, completed,
+                    Math.Max(response.StatusCode == HttpStatusCode.TooManyRequests ? 60 : 0,
+                        response.Headers.RetryAfter?.Delta?.TotalSeconds ?? (response.Headers.RetryAfter?.Date - completed)?.TotalSeconds ?? 0),
+                    response.StatusCode == HttpStatusCode.TooManyRequests, (int)response.StatusCode >= 500);
+                result = StaleOrError(schedule);
+            }
+        }
+        catch (Exception error) when (error is HttpRequestException or IOException or OperationCanceledException or
+            InvalidOperationException or FormatException or JsonException)
+        {
+            Backoff(schedule, now(), 0);
+            result = StaleOrError(schedule);
+        }
+        lock (gate)
+        {
+            // Never commit an old account's response, including a CLI renewal or cancellation mid-request.
+            var current = ReadSafe(out var currentError);
+            if (disposed || generation != credentialGeneration || cancellationToken.IsCancellationRequested || currentError is not null || current != credential) return ReadCachedSnapshot();
+            if (credential.Expires <= now()) return Empty(QuotaStatus.NeedsAuth, block: ExpiredReason);
+            schedules[credential.Key] = schedule;
+            Save(credential.Key, schedule);
+            return result;
+        }
+    }
+
+    private void RejectPlan(Schedule schedule, string reason)
+    {
+        schedule.Snapshot = null;
+        schedule.UnsupportedReason = reason;
+        schedule.NextAllowedAt = now().AddMinutes(5);
+        schedule.Failures = 0;
+        schedule.ColdFailures = 0;
+    }
+    private static void Backoff(Schedule schedule, DateTimeOffset time, double retrySeconds, bool rateLimited = false, bool transient = true)
+    {
+        schedule.Failures = Math.Min(schedule.Failures + 1, 6);
+        var seconds = Math.Min(900, 60 * Math.Pow(2, schedule.Failures - 1));
+        if (schedule.Snapshot?.ObservedAt is null && transient && !rateLimited)
+        {
+            schedule.ColdFailures = Math.Min(schedule.ColdFailures + 1, 4);
+            seconds = Math.Min(5 * (1 << (schedule.ColdFailures - 1)), 30);
+        }
+        seconds = Math.Max(seconds, retrySeconds);
+        schedule.NextAllowedAt = seconds >= (DateTimeOffset.MaxValue - time).TotalSeconds ? DateTimeOffset.MaxValue : time.AddSeconds(seconds);
+    }
+
+    internal static QuotaSnapshot Parse(string json, DateTimeOffset time)
+    {
+        using var document = JsonDocument.Parse(json);
+        var root = document.RootElement;
+        if (root.ValueKind != JsonValueKind.Object) throw new JsonException("Invalid Kimi usage response.");
+        var windows = new List<QuotaWindow>(4);
+        void Replace(QuotaWindow? window)
+        {
+            if (window is null) return;
+            var index = windows.FindIndex(item => item.Id == window.Id);
+            if (index < 0) windows.Add(window); else windows[index] = window;
+        }
+        Replace(LegacyRow(Property(root, "usage"), "weekly", "Weekly limit", TimeSpan.FromDays(7)));
+        if (Property(root, "limits") is { ValueKind: JsonValueKind.Array } limits)
+            foreach (var entry in limits.EnumerateArray())
+            {
+                var window = Property(entry, "window");
+                var duration = Count(window, "duration");
+                var unit = Text(window, "timeUnit");
+                if (unit == "TIME_UNIT_MINUTE" && duration == 300 || unit == "TIME_UNIT_HOUR" && duration == 5)
+                    Replace(LegacyRow(Property(entry, "detail"), "rolling", "5h limit", TimeSpan.FromHours(5)));
+                else if (unit == "TIME_UNIT_WEEK" && duration == 1)
+                    Replace(LegacyRow(Property(entry, "detail"), "weekly", "Weekly limit", TimeSpan.FromDays(7)));
+            }
+        var usages = Property(root, "usages");
+        Modern("limit_5h", "rolling", "5h limit", TimeSpan.FromHours(5));
+        Modern("limit_7d", "weekly", "Weekly limit", TimeSpan.FromDays(7));
+        Modern("limit_month_total", "monthly-total", "Monthly limit", null);
+        Modern("limit_month_code", "monthly-code", "Monthly code limit", null);
+        void Modern(string key, string id, string label, TimeSpan? duration)
+        {
+            var detail = Property(usages, key);
+            if (Numeric(detail, "used_ratio") is not { } ratio || ratio < 0) return;
+            Replace(new(id, label, ratio, null, null, ResetDate(detail, "reset_time"), duration));
+        }
+        if (windows.Count == 0) return Empty(QuotaStatus.Unsupported, block: NoLimitsReason);
+        var level = Text(Property(Property(root, "user"), "membership"), "level");
+        if (level?.StartsWith("LEVEL_", StringComparison.Ordinal) == true) level = level[6..];
+        var plan = string.IsNullOrWhiteSpace(level) ? null : CultureInfo.InvariantCulture.TextInfo.ToTitleCase(level.Replace('_', ' ').ToLowerInvariant());
+        return new("kimi", "Kimi Code", "official", QuotaStatus.Ok, windows, "rolling", null, null, plan, time, Source, null, null, false,
+            Configured: true);
+    }
+
+    private static QuotaWindow? LegacyRow(JsonElement detail, string id, string label, TimeSpan duration)
+    {
+        var limit = Count(detail, "limit");
+        var used = Count(detail, "used");
+        var remaining = Count(detail, "remaining");
+        if (used is null && limit is > 0 && remaining >= 0 && remaining <= limit) used = limit - remaining;
+        if (used is null) return null;
+        return new(id, label, limit is > 0 ? used / limit : null, remaining, used, ResetDate(detail, "resetTime"), duration);
+    }
+
+    private sealed class Schedule
+    {
+        public DateTimeOffset? NextAllowedAt;
+        public int Failures;
+        public int ColdFailures;
+        public string? RejectedToken, UnsupportedReason;
+        public QuotaSnapshot? Snapshot;
+        public Schedule Copy() => (Schedule)MemberwiseClone();
+    }
+    private Schedule GetSchedule(string key)
+    {
+        if (!schedules.TryGetValue(key, out var schedule)) schedules.Add(key, schedule = Load(key));
+        return schedule;
+    }
+    private Schedule Load(string key)
+    {
+        var schedule = new Schedule();
+        try
+        {
+            using var document = JsonDocument.Parse(File.ReadAllText(Path.Combine(scheduleDirectory, key + ".json")));
+            var root = document.RootElement;
+            if (Number(root, "version") != 1 || Text(root, "contextKey") != key) return schedule;
+            schedule.NextAllowedAt = Date(root, "nextAllowedAt");
+            schedule.Failures = (int)Math.Clamp(Number(root, "failures") ?? 0, 0, 6);
+            schedule.ColdFailures = (int)Math.Clamp(Number(root, "coldFailures") ?? 0, 0, 4);
+            schedule.RejectedToken = Text(root, "rejectedToken");
+            var reason = Text(root, "unsupportedReason");
+            if (reason is NoPlanReason or NoLimitsReason) schedule.UnsupportedReason = reason;
+            try
+            {
+                var snapshot = Property(root, "snapshot").Deserialize(QuotaSnapshotJsonContext.Default.QuotaSnapshot);
+                if (schedule.RejectedToken is null && schedule.UnsupportedReason is null && snapshot is
+                    { Id: "kimi", DisplayName: "Kimi Code", Source: Source, Status: QuotaStatus.Ok, ObservedAt: not null, Account: null, Windows: not null } &&
+                    snapshot.Windows.Count is > 0 and <= 4 && snapshot.Windows.All(window => window is not null &&
+                        window.Id is "rolling" or "weekly" or "monthly-total" or "monthly-code" &&
+                        (window.UsedFraction is null || double.IsFinite(window.UsedFraction.Value) && window.UsedFraction >= 0)))
+                    schedule.Snapshot = snapshot;
+            }
+            catch (Exception error) when (error is JsonException or NotSupportedException or InvalidOperationException) { }
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or JsonException or ArgumentException) { }
+        return schedule;
+    }
+    private void Save(string key, Schedule schedule)
+    {
+        var path = Path.Combine(scheduleDirectory, key + ".json");
+        var temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            if (OperatingSystem.IsWindows()) Directory.CreateDirectory(scheduleDirectory);
+            else Directory.CreateDirectory(scheduleDirectory, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+            var options = new FileStreamOptions { Mode = FileMode.CreateNew, Access = FileAccess.Write, Share = FileShare.None };
+            if (!OperatingSystem.IsWindows()) options.UnixCreateMode = UnixFileMode.UserRead | UnixFileMode.UserWrite;
+            using (var stream = new FileStream(temporary, options))
+            {
+                using var writer = new Utf8JsonWriter(stream);
+                writer.WriteStartObject();
+                writer.WriteNumber("version", 1);
+                writer.WriteString("contextKey", key);
+                if (schedule.NextAllowedAt is { } next) writer.WriteString("nextAllowedAt", next);
+                writer.WriteNumber("failures", schedule.Failures);
+                writer.WriteNumber("coldFailures", schedule.ColdFailures);
+                if (schedule.RejectedToken is { } rejected) writer.WriteString("rejectedToken", rejected);
+                if (schedule.UnsupportedReason is { } reason) writer.WriteString("unsupportedReason", reason);
+                if (schedule.Snapshot is { } snapshot)
+                {
+                    writer.WritePropertyName("snapshot");
+                    JsonSerializer.Serialize(writer, snapshot, QuotaSnapshotJsonContext.Default.QuotaSnapshot);
+                }
+                writer.WriteEndObject();
+                writer.Flush();
+                stream.Flush(flushToDisk: true);
+            }
+            File.Move(temporary, path, overwrite: true);
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        finally
+        {
+            try { File.Delete(temporary); }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        }
+    }
+
+    private static QuotaSnapshot StaleOrError(Schedule schedule) => schedule.Snapshot is { ObservedAt: not null } snapshot
+        ? snapshot with { Status = QuotaStatus.Stale, NextAllowedAt = schedule.NextAllowedAt, WaitingForRefresh = false }
+        : Empty(QuotaStatus.Error, schedule.NextAllowedAt);
+    private QuotaSnapshot Empty(QuotaStatus status, DateTimeOffset? next = null, string? block = null) =>
+        new("kimi", "Kimi Code", "official", status, [], "rolling", block, null, null, null, Source, null, next, false,
+            Configured: HasIdentifiedCredentials());
+
+    /// <summary>Identified configuration includes a stored key and any readable CLI session, even expired.</summary>
+    private bool HasIdentifiedCredentials()
+    {
+        try { return ReadCredentials() is not null; }
+        catch { return true; }
+    }
+    private static string Digest(string value) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value))).ToLowerInvariant();
+    private static JsonElement Property(JsonElement value, string name) => value.ValueKind == JsonValueKind.Object && value.TryGetProperty(name, out var property) ? property : default;
+    private static string? Text(JsonElement value, string name) => Property(value, name) is { ValueKind: JsonValueKind.String } property ? property.GetString() : null;
+    private static double? Number(JsonElement value, string name) => Property(value, name) is { ValueKind: JsonValueKind.Number } property && property.TryGetDouble(out var number) && double.IsFinite(number) ? number : null;
+    private static double? Numeric(JsonElement value, string name) => Number(value, name) ??
+        (double.TryParse(Text(value, name), NumberStyles.Float, CultureInfo.InvariantCulture, out var number) && double.IsFinite(number) ? number : null);
+    private static double? Count(JsonElement value, string name) => Numeric(value, name) is { } number && number >= 0 && Math.Truncate(number) == number ? number : null;
+    private static DateTimeOffset? Date(JsonElement value, string name) => DateTimeOffset.TryParse(Text(value, name), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var date) ? date : null;
+    private static DateTimeOffset? ResetDate(JsonElement value, string name) => Text(value, name) is { } stamp &&
+        stamp.Contains('T') && (stamp.EndsWith('Z') || stamp.Length >= 25 && stamp[^6] is '+' or '-') ? Date(value, name) : null;
+}
