+    private static Localizer Loc() => new(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+    private sealed class Store : IKimiCredentialStore
+    {
+        private KimiCredentialMetadata metadata = new(false, null);
+        public int SecretReads;
+        public KimiCredentialMetadata GetMetadata() => metadata;
+        public KimiApiCredential? Read() { SecretReads++; throw new InvalidOperationException("Settings must not read saved secrets."); }
+        public void Set(string region, string apiKey) => metadata = new(true, region);
+        public void Delete() => metadata = new(false, null);
+    }
+    private sealed class Provider : IQuotaProvider
+    {
+        public int Refreshes;
+        public QuotaStatus Status = QuotaStatus.Ok;
+        public QuotaSnapshot ReadCachedSnapshot() => new("kimi", "Kimi Code", "official", Status, [], null, null, null, null, null, "Kimi Code", null, null, false);
+        public Task<QuotaSnapshot> RefreshAsync() { Refreshes++; return Task.FromResult(ReadCachedSnapshot()); }
+        public Task<QuotaSnapshot> RefreshStartupAsync() => RefreshAsync();
+        public void Cancel() { }
+        public void Dispose() { }
+    }
+    private static void RunSta(Action action)
+    {
+        Exception? failure = null;
+        var thread = new Thread(() => { try { action(); } catch (Exception error) { failure = error; } });
+        thread.SetApartmentState(ApartmentState.STA); thread.Start(); thread.Join();
+        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+    }
