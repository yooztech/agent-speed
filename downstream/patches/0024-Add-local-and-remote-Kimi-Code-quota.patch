+                if (it->offset) { c.dead = true; break; }
+                c.bytes -= it->data.size(); it = c.output.erase(it);
+            }
+        }
+        for (auto& reply : quotaReplies) for (auto& [fd, c] : clients) if (c.id == reply.first && c.handshaken && !c.dead) { enqueue(c, std::move(reply.second)); break; }
         for (auto& [fd, c] : clients) if (!c.handshaken && steady >= c.deadline) c.dead = true;
         for (auto it = clients.begin(); it != clients.end();) { if (it->second.dead) { publisher.disconnected(it->second.id); widgets.disconnected(it->second.id); quotas.disconnected(it->second.id); it = clients.erase(it); } else ++it; }
         if (!clients.empty() || publisher.authorized(now) || widgets.authorized(now)) idle = steady;
