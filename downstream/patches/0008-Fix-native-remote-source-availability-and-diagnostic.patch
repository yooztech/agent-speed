diff --git a/macos/Tests/AgentSpeedAppTests/RemoteHostStatusTests.swift b/macos/Tests/AgentSpeedAppTests/RemoteHostStatusTests.swift
new file mode 100644
index 00000000..05e31ad8
--- /dev/null
+++ b/macos/Tests/AgentSpeedAppTests/RemoteHostStatusTests.swift
@@ -0,0 +1,30 @@
+import Foundation
+import Testing
+@testable import AgentSpeed
+
+@Suite("Remote host connection status")
+struct RemoteHostStatusTests {
+    @Test func statusReflectsEnabledAndConnectionState() {
+        var host = RemoteHost(label: "Server", destination: "server")
+        var state = RemoteHostState()
+        state.online = true
+        #expect(RemoteHostConnectionStatus(host: host, state: state) == .disabled)
+        host.enabled = true
+        #expect(RemoteHostConnectionStatus(host: host, state: nil) == .offline)
+        #expect(RemoteHostConnectionStatus(host: host, state: state) == .online)
+        state.disconnected()
+        state.error = "SSH authentication failed"
+        #expect(RemoteHostConnectionStatus(host: host, state: state) == .offline)
+        host.enabled = false
+        #expect(RemoteHostConnectionStatus(host: host, state: state) == .disabled)
+    }
+
+    @Test func successfulSnapshotClearsConnectionError() throws {
+        var state = RemoteHostState()
+        state.error = "SSH authentication failed"
+        let message = try #require(RemoteMessage.decode(Data(#"{"version":1,"type":"snapshot"}"#.utf8)))
+        state.apply(message)
+        #expect(state.online)
+        #expect(state.error == nil)
+    }
+}
