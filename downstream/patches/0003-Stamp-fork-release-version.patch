From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yooztech <service@yooztech.com>
Subject: [PATCH] Stamp fork release version across platforms

Keep platform numeric versions separate from the visible release version.

---
diff --git a/VERSION b/VERSION
--- a/VERSION
+++ b/VERSION
@@ -1 +1 @@
-1.6.1
+1.6.1-fork.1
diff --git a/linux/app/CMakeLists.txt b/linux/app/CMakeLists.txt
--- a/linux/app/CMakeLists.txt
+++ b/linux/app/CMakeLists.txt
@@ -156,7 +156,8 @@
     agentspeed_core Qt6::Core Qt6::Gui Qt6::Network Qt6::OpenGL Qt6::WebSockets Qt6::Widgets Qt6::Qml Qt6::Quick Qt6::QuickControls2 PkgConfig::XCB)
 target_include_directories(agent-speed PRIVATE src)
-# The release version (a tag v1.6.0 builds 1.6.0); local builds keep the project's.
+# Default to the release version; packagers can still override it.
-set(AGENTSPEED_VERSION "${PROJECT_VERSION}" CACHE STRING "The version the app reports")
+file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/../../VERSION" AGENTSPEED_DEFAULT_VERSION LIMIT_COUNT 1)
+set(AGENTSPEED_VERSION "${AGENTSPEED_DEFAULT_VERSION}" CACHE STRING "The version the app reports")
 target_compile_definitions(agent-speed PRIVATE AGENTSPEED_VERSION="${AGENTSPEED_VERSION}")
 
 install(TARGETS agent-speed RUNTIME DESTINATION bin)
