+namespace {
+// The service relay publishes the repository table without its own `tests` member.
+std::string withoutTests(std::string text) {
+    const auto key = text.find("\"tests\"");
+    if (key == std::string::npos) return text;
+    const auto open = text.find('[', key);
+    if (open == std::string::npos) return text;
+    int depth = 0;
+    bool inString = false, escaped = false;
+    std::size_t close = std::string::npos;
+    for (std::size_t i = open; i < text.size(); ++i) {
+        const char c = text[i];
+        if (inString) {
+            if (escaped) escaped = false;
+            else if (c == '\\') escaped = true;
+            else if (c == '"') inString = false;
+            continue;
+        }
+        if (c == '"') inString = true;
+        else if (c == '[') ++depth;
+        else if (c == ']' && --depth == 0) { close = i; break; }
+    }
+    if (close == std::string::npos) return text;
+    std::size_t end = close + 1;
+    while (end < text.size() && (text[end] == ' ' || text[end] == '\n' || text[end] == '\r' || text[end] == '\t')) ++end;
+    if (end < text.size() && text[end] == ',') ++end;
+    std::size_t start = key;
+    while (start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\n' || text[start - 1] == '\r' || text[start - 1] == '\t')) --start;
+    if (start > 0 && text[start - 1] == ',') --start;
+    return text.erase(start, end - start);
+}
+}
+
+// Validation rule 4 is vacuous for a table without its own `tests`, like the relay's: it must load.
+TEST(Pricing, AcceptsATableWithoutItsOwnTests) {
+    const auto bundled = PriceBook::bundled();
+    ASSERT_TRUE(bundled);
+    const auto text = withoutTests(bundled->data());
+    ASSERT_LT(text.size(), bundled->data().size());
+    TableError error;
+    const auto table = PriceTable::load(text, &error);
+    ASSERT_TRUE(table) << error.describe();
+    EXPECT_EQ(table->version(), bundled->version());
+    EXPECT_EQ(table->models().size(), bundled->models().size());
+}
