+import Foundation
+import Testing
+@testable import AgentSpeedCore
+
+@Suite("Remote quota wire and identity")
+struct RemoteQuotaTests {
+    private let host = UUID(uuidString: "55AB9F50-1B94-4672-A6FD-55C246EC6383")!
+    private let reading = #"{"id":"codex","displayName":"Codex","fidelity":"official","status":"ok","windows":[{"id":"five","label":"","usedFraction":0.25,"remaining":null,"used":null,"resetAt":"2026-11-15T13:00:00.125Z","duration":18000}],"headlineId":"five","block":null,"account":"same@example.test","plan":"plus","observedAt":"2026-11-15T12:00:00Z","source":"official","credits":null,"nextAllowedAt":null,"waitingForRefresh":false,"resetCreditsAvailable":2,"resetCreditsNextExpiry":"2026-11-16T12:00:00Z"}"#
+
+    @Test func scopedIdentityNeverMergesAccountsAndPreservesBranding() throws {
+        let data = Data("{\"type\":\"quota\",\"requestId\":\"request-1\",\"snapshots\":[\(reading)]}".utf8)
+        let response = try #require(RemoteQuotaResponse.decode(data))
+        let raw = try #require(response.snapshots.first)
+        let scoped = raw.scopedToRemote(hostID: host, hostName: "build")
+        #expect(scoped.id == "remote:55AB9F50-1B94-4672-A6FD-55C246EC6383:codex")
+        #expect(QuotaSourceIdentity.providerID(scoped.id) == "codex")
+        #expect(QuotaSourceIdentity.providerID("opencode-go") == "opencode-go")
+        #expect(QuotaSourceIdentity.providerID("remote:not-a-uuid:codex") == "remote:not-a-uuid:codex")
+        #expect(scoped.id != raw.id)
+        #expect(scoped.account == raw.account)
+        #expect(scoped.displayName == "Codex · build")
+        #expect(scoped.source.contains("SSH build"))
+        #expect(scoped.windows == raw.windows)
+        #expect(scoped.resetCreditsAvailable == 2)
+        #expect(scoped.resetCreditsNextExpiry != nil)
+        #expect(scoped.windows.first?.resetAt?.timeIntervalSince1970.truncatingRemainder(dividingBy: 1) == 0.125)
+        let stale = scoped.withRemoteStatus(.stale)
+        #expect(stale.observedAt == raw.observedAt)
+        #expect(stale.windows == raw.windows)
+        #expect(stale.withRemoteHostName("renamed").displayName == "Codex · renamed")
+        #expect(raw.scopedToRemote(hostID: UUID(), hostName: "build").id != scoped.id)
+    }
+
+    @Test func optionalAccountIdentitySurvivesCopiesAndPersistence() throws {
+        let old = reading.replacingOccurrences(of: "\"account\":\"same@example.test\"", with: "\"account\":null")
+            .replacingOccurrences(of: "\"duration\":18000}]", with: "\"duration\":18000},{\"id\":\"daily\",\"label\":\"Daily\",\"usedFraction\":0.5,\"remaining\":null,\"used\":null,\"resetAt\":\"2026-11-16T00:00:00Z\",\"duration\":86400}]")
+        func decode(_ row: String) throws -> QuotaSnapshot {
+            let data = Data("{\"type\":\"quota\",\"requestId\":\"one\",\"snapshots\":[\(row)]}".utf8)
+            return try #require(RemoteQuotaResponse.decode(data)?.snapshots.first)
+        }
+        #expect(try decode(old).accountIdentity == nil)
+        let nullIdentity = old.replacingOccurrences(of: "\"account\":null", with: "\"account\":null,\"accountIdentity\":null")
+        #expect(try decode(nullIdentity).accountIdentity == nil)
+        let identified = old.replacingOccurrences(of: "\"account\":null", with: "\"account\":null,\"accountIdentity\":{\"id\":\"opaque-id\",\"displayName\":\"Work\"}")
+        let snapshot = try decode(identified)
+        #expect(snapshot.account == nil)
+        #expect(snapshot.accountIdentity?.id == "opaque-id")
+        #expect(snapshot.accountIdentity?.displayName == "Work")
+        #expect(snapshot.windows == (try decode(old)).windows)
+        #expect(snapshot.windows.count == 2)
+        #expect(snapshot.windows[1].duration == 86400)
+        #expect(snapshot.windows[1].resetAt != nil)
+        #expect(snapshot.resetCreditsAvailable == 2)
+        #expect(snapshot.resetCreditsNextExpiry != nil)
+        let scoped = snapshot.scopedToRemote(hostID: host, hostName: "build")
+        #expect(scoped.accountIdentity == snapshot.accountIdentity)
+        #expect(scoped.withRemoteStatus(.stale).withRemoteHostName("new").accountIdentity == snapshot.accountIdentity)
+        #expect(scoped.copying(status: .stale, next: nil).accountIdentity == snapshot.accountIdentity)
+        let restored = try JSONDecoder().decode(QuotaSnapshot.self, from: JSONEncoder().encode(scoped))
+        #expect(restored == scoped)
+    }
+
+    @Test func boundedEnvelopeRejectsWrongTypesDuplicateProvidersAndInvalidCorrelation() {
+        func decode(_ type: String = "quota", request: String = "one", readings: String? = nil) -> RemoteQuotaResponse? {
+            RemoteQuotaResponse.decode(Data("{\"type\":\"\(type)\",\"requestId\":\"\(request)\",\"snapshots\":[\(readings ?? reading)]}".utf8))
+        }
+        #expect(decode() != nil)
+        #expect(decode("snapshot") == nil)
+        #expect(decode(request: "") == nil)
+        #expect(decode(request: String(repeating: "x", count: 129)) == nil)
+        #expect(decode(request: "non-ascii-读") == nil)
+        #expect(decode(readings: "") == nil)
+        #expect(decode(readings: "\(reading),\(reading)") == nil)
+        #expect(decode(readings: reading.replacingOccurrences(of: "\"id\":\"codex\"", with: "\"id\":\"unknown\"")) == nil)
+        #expect(decode(readings: reading.replacingOccurrences(of: "2026-11-15T12:00:00Z", with: "invalid")) == nil)
+        #expect(RemoteQuotaResponse.decode(Data(repeating: 32, count: 262_145)) == nil)
+    }
+}
