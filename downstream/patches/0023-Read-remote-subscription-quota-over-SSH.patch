+    {
+        Bridge bridge(home.path, AGENTSPEED_COLLECTOR_PATH, true); ASSERT_GT(bridge.pid, 0);
+        first = identity(bridge); ASSERT_TRUE(first);
+        bridge.closeInput(); ASSERT_TRUE(bridge.wait(5000));
+    }
+    auto deadline = Clock::now() + std::chrono::seconds(5);
+    while (fs::exists(home.runtime() / "collector.sock") && Clock::now() < deadline) std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    ASSERT_FALSE(fs::exists(home.runtime() / "collector.sock"));
+    auth("synthetic-rotated-token", "synthetic-account-a");
+    Bridge restarted(home.path, AGENTSPEED_COLLECTOR_PATH, true); ASSERT_GT(restarted.pid, 0);
+    EXPECT_EQ(identity(restarted), first);
+    auth("synthetic-other-token", "synthetic-account-b"); auto other = identity(restarted); ASSERT_TRUE(other); EXPECT_NE(other, first);
+    fs::remove(home.path / ".codex/auth.json"); EXPECT_FALSE(identity(restarted));
+    auth("synthetic-login-again", "synthetic-account-a"); EXPECT_EQ(identity(restarted), first);
+}
