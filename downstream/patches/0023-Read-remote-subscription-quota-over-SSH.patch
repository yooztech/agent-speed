+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public sealed class RemoteQuotaSourcesTests
+{
+    [Fact]
+    public void AllSourcesIncludesEnabledHostsAndFutureHostsWithoutLocalCredentials()
+    {
+        var first = new RemoteHost(Guid.NewGuid(), "Build", "one", true);
+        var second = new RemoteHost(Guid.NewGuid(), "Build", "two", true);
+        var settings = AppSettings.Default with { RemoteHosts = [first, second] };
+        var sources = QuotaSources.Available(settings);
+        Assert.Equal(6, sources.Count);
+        Assert.Contains(sources, source => source.Id == QuotaProviders.RemoteSourceId(first.Id, "codex") && source.DisplayName == "Codex · Build (one)");
+        Assert.Contains(sources, source => source.Id == QuotaProviders.RemoteSourceId(second.Id, "opencode-go") && source.DisplayName == "OpenCode Go · Build (two)");
+        Assert.Equal(6, QuotaSources.Selected(settings).Length);
+        settings = settings with { RemoteHosts = [first, second with { Enabled = false }] };
+        Assert.Equal(4, QuotaSources.Selected(settings).Length);
+        settings = settings with { RemoteHosts = [first, second, new(Guid.NewGuid(), "Future", "three", true)] };
+        Assert.Equal(8, QuotaSources.Selected(settings).Length);
+    }
+
+    [Fact]
+    public void ExplicitHostScopedSelectionRoundTripsAndSurvivesTemporaryRemoval()
+    {
+        var first = new RemoteHost(Guid.NewGuid(), "Server", "one", true);
+        var second = new RemoteHost(Guid.NewGuid(), "Server", "two", true);
+        var id = QuotaProviders.RemoteSourceId(first.Id, "opencode-go");
+        var settings = AppSettings.Default with { RemoteHosts = [first, second], QuotaAllSources = false, QuotaSources = [id, id, "unknown"] };
+        var restored = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(settings));
+        Assert.Equal(new[] { id }, restored.QuotaSources);
+        Assert.Equal(new[] { id }, QuotaSources.Selected(restored));
+        var unavailable = restored with { RemoteHosts = [second] };
+        unavailable = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(unavailable));
+        Assert.Equal(new[] { id }, unavailable.QuotaSources);
+        Assert.Empty(QuotaSources.Selected(unavailable));
+        Assert.Equal(new[] { id }, QuotaSources.Selected(unavailable with { RemoteHosts = [first, second] }));
+        Assert.True(QuotaProviders.TryRemoteSource(id, out var hostId, out var provider));
+        Assert.Equal(first.Id, hostId);
+        Assert.Equal("opencode-go", provider);
+        Assert.False(QuotaProviders.IsSourceId($"remote:{first.Id}:unknown"));
+    }
+}
