+++ b/windows/src/AgentSpeed.Core/RemoteQuotaSession.cs
@@ -0,0 +1,146 @@
+using System.Buffers;
+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core;
+
+/// <summary>One collector connection's bounded, correlated quota replies. Never owns credentials.</summary>
+public sealed class RemoteQuotaSession : IDisposable
+{
+    private readonly object gate = new();
+    private readonly Dictionary<string, (string Provider, TaskCompletionSource<QuotaSnapshot> Reply)> pending = new(StringComparer.Ordinal);
+    private readonly Func<string, CancellationToken, Task<bool>> send;
+    private readonly TimeSpan timeout;
+    private bool disposed;
+
+    public RemoteQuotaSession(Func<string, CancellationToken, Task<bool>> send, TimeSpan? timeout = null)
+    {
+        this.send = send;
+        this.timeout = timeout ?? TimeSpan.FromSeconds(45);
+    }
+
+    public async Task<QuotaSnapshot> RequestAsync(string provider, bool refresh, CancellationToken cancellationToken)
+    {
+        if (!QuotaProviders.Supported.Any(item => item.Id == provider)) throw new ArgumentOutOfRangeException(nameof(provider));
+        var id = Guid.NewGuid().ToString("N");
+        var reply = new TaskCompletionSource<QuotaSnapshot>(TaskCreationOptions.RunContinuationsAsynchronously);
+        lock (gate)
+        {
+            ObjectDisposedException.ThrowIf(disposed, this);
+            pending.Add(id, (provider, reply));
+        }
+        try
+        {
+            var command = CreateCommand(id, provider, refresh);
+            // Include transport backpressure in the command deadline, not only the response wait.
+            using var deadline = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            deadline.CancelAfter(timeout);
+            try
+            {
+                if (!await send(command, deadline.Token).ConfigureAwait(false)) throw new IOException("Remote collector is not connected");
+                return await reply.Task.WaitAsync(deadline.Token).ConfigureAwait(false);
+            }
+            catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)
+            {
+                throw new TimeoutException("Remote collector did not answer quota within 45 seconds; update the collector");
+            }
+        }
+        finally { lock (gate) pending.Remove(id); }
+    }
+
+    private static string CreateCommand(string requestId, string provider, bool refresh)
+    {
+        var buffer = new ArrayBufferWriter<byte>(192);
+        using (var writer = new Utf8JsonWriter(buffer))
+        {
+            writer.WriteStartObject();
+            writer.WriteString("type", "quota");
+            writer.WriteString("requestId", requestId);
+            writer.WriteStartArray("providers");
+            writer.WriteStringValue(provider);
+            writer.WriteEndArray();
+            writer.WriteBoolean("refresh", refresh);
+            writer.WriteEndObject();
+        }
+        return Encoding.UTF8.GetString(buffer.WrittenSpan);
+    }
+
+    public bool Receive(string line)
+    {
+        if (line.Length > 524_288) return false;
+        try
+        {
+            using var document = JsonDocument.Parse(line, new JsonDocumentOptions { MaxDepth = 32 });
+            var root = document.RootElement;
+            if (root.ValueKind != JsonValueKind.Object || Text(root, "type") != "quota") return false;
+            var id = Text(root, "requestId");
+            lock (gate)
+            {
+                if (disposed || id is null || !pending.TryGetValue(id, out var request)) return true;
+                if (!root.TryGetProperty("snapshots", out var snapshots) || snapshots.ValueKind != JsonValueKind.Array || snapshots.GetArrayLength() > 2)
+                    return true;
+                foreach (var value in snapshots.EnumerateArray())
+                {
+                    if (Text(value, "id") != request.Provider) continue;
+                    request.Reply.TrySetResult(ParseSnapshot(value));
+                    break;
+                }
+            }
+            return true;
+        }
+        catch (Exception error) when (error is JsonException or InvalidOperationException or FormatException or ArgumentOutOfRangeException)
+        {
+            return false;
+        }
+    }
+
+    private static QuotaSnapshot ParseSnapshot(JsonElement value)
+    {
+        var status = Text(value, "status") switch
+        {
+            "ok" => QuotaStatus.Ok, "stale" => QuotaStatus.Stale, "needsAuth" => QuotaStatus.NeedsAuth,
+            "accessDenied" => QuotaStatus.AccessDenied, "unsupported" => QuotaStatus.Unsupported, _ => QuotaStatus.Error
+        };
+        var windows = new List<QuotaWindow>();
+        if (value.TryGetProperty("windows", out var array) && array.ValueKind == JsonValueKind.Array)
+        {
+            if (array.GetArrayLength() > 32) throw new JsonException("Too many quota windows");
+            foreach (var window in array.EnumerateArray())
+                windows.Add(new(Text(window, "id") ?? "", Text(window, "label") ?? "", Number(window, "usedFraction"),
+                    Number(window, "remaining"), Number(window, "used"), Date(window, "resetAt"),
+                    Number(window, "duration") is { } duration && duration >= 0 && duration <= TimeSpan.MaxValue.TotalSeconds / 2 ? TimeSpan.FromSeconds(duration) : null));
+        }
+        QuotaCredits? credits = null;
+        if (value.TryGetProperty("credits", out var c) && c.ValueKind == JsonValueKind.Object)
+            credits = new(Boolean(c, "hasCredits"), Boolean(c, "unlimited"), Number(c, "limit"), Number(c, "used"),
+                Number(c, "usedFraction"), Date(c, "resetAt"), Text(c, "balance"));
+        var resetCredits = value.TryGetProperty("resetCreditsAvailable", out var reset) && reset.ValueKind == JsonValueKind.Number && reset.TryGetInt32(out var count) ? count : (int?)null;
+        QuotaAccountIdentity? accountIdentity = null;
+        if (value.TryGetProperty("accountIdentity", out var identity) && identity.ValueKind == JsonValueKind.Object &&
+            Text(identity, "id") is { } accountId && Text(identity, "displayName") is { } accountName)
+            accountIdentity = new(accountId, accountName);
+        // Authentication rejection must never retain values belonging to an earlier account.
+        var rejected = status is QuotaStatus.NeedsAuth or QuotaStatus.AccessDenied;
+        return new(Text(value, "id")!, Text(value, "displayName") ?? "", Text(value, "fidelity") ?? "unknown", status,
+            rejected ? [] : windows, rejected ? null : Text(value, "headlineId"), Text(value, "block"),
+            rejected ? null : Text(value, "account"), rejected ? null : Text(value, "plan"), rejected ? null : Date(value, "observedAt"),
+            Text(value, "source") ?? "", rejected ? null : credits, Date(value, "nextAllowedAt"), Boolean(value, "waitingForRefresh") ?? false,
+            rejected ? null : resetCredits, rejected ? null : Date(value, "resetCreditsNextExpiry"), rejected ? null : accountIdentity);
+    }
+
+    private static string? Text(JsonElement value, string name) => value.TryGetProperty(name, out var item) && item.ValueKind == JsonValueKind.String ? item.GetString() : null;
+    private static double? Number(JsonElement value, string name) => value.TryGetProperty(name, out var item) && item.ValueKind == JsonValueKind.Number && item.TryGetDouble(out var number) && double.IsFinite(number) ? number : null;
+    private static bool? Boolean(JsonElement value, string name) => value.TryGetProperty(name, out var item) ? item.ValueKind switch { JsonValueKind.True => true, JsonValueKind.False => false, _ => null } : null;
+    private static DateTimeOffset? Date(JsonElement value, string name) => Text(value, name) is { } text && DateTimeOffset.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var date) ? date : null;
+
+    public void Dispose()
+    {
+        lock (gate)
+        {
+            if (disposed) return;
+            disposed = true;
+            foreach (var request in pending.Values) request.Reply.TrySetException(new IOException("Remote collector disconnected"));
+            pending.Clear();
+        }
+    }
+}
