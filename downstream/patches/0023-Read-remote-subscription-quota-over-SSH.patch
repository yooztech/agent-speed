+TEST(CollectorQuotaProvider, ColdTransportCallsFollowPersistedDeadlinesCapAndReturnToWarmPacing) {
+    for (const auto* id : {"codex", "opencode-go"}) {
+        SCOPED_TRACE(id);
+        Home home; home.codexAuth(); home.goAuth(); auto time = now;
+        int usageCalls = 0, resetCalls = 0;
+        auto transport = [&](const std::string& url, const q::Credential& c, bool reset) -> q::HttpReply {
+            if (reset) { ++resetCalls; return success(url, c, reset); }
+            ++usageCalls;
+            if (usageCalls == 1) throw std::runtime_error("synthetic network failure");
+            if (usageCalls == 2) return {};
+            if (usageCalls == 3 || usageCalls == 5 || usageCalls > 6) return {503, "", ""};
+            if (usageCalls == 4) return {200, "[", ""};
+            return success(url, c, reset);
+        };
+        for (auto delay : {5000, 10000, 20000, 30000, 30000}) {
+            q::Provider provider(id, home.paths(), transport, [&] { return time; });
+            auto before = usageCalls;
+            auto failure = provider.read(true);
+            EXPECT_EQ(usageCalls, before + 1); EXPECT_EQ(failure.status, "error"); EXPECT_FALSE(failure.observedAt);
+            EXPECT_TRUE(failure.windows.empty()); ASSERT_EQ(failure.nextAllowedAt, time + delay);
+            time += delay - 1;
+            q::Provider restored(id, home.paths(), transport, [&] { return time; });
+            EXPECT_EQ(restored.read(false).nextAllowedAt, failure.nextAllowedAt);
+            EXPECT_EQ(restored.read(true).nextAllowedAt, failure.nextAllowedAt); EXPECT_EQ(usageCalls, before + 1);
+            ++time;
+        }
+        q::Provider recovered(id, home.paths(), transport, [&] { return time; });
+        auto value = recovered.read(true); ASSERT_EQ(value.status, "ok"); ASSERT_EQ(value.observedAt, time);
+        EXPECT_EQ(usageCalls, 6); EXPECT_EQ(resetCalls, std::string(id) == "codex" ? 1 : 0);
+        const auto observed = time;
+        if (value.nextAllowedAt) time = *value.nextAllowedAt;
+        // A validated persisted observation is warm even after process restart.
+        q::Provider warm(id, home.paths(), transport, [&] { return time; });
+        EXPECT_EQ(warm.read(false).observedAt, observed); EXPECT_EQ(usageCalls, 6);
+        auto failure = warm.read(true); EXPECT_EQ(usageCalls, 7); EXPECT_EQ(failure.status, "stale");
+        EXPECT_EQ(failure.observedAt, observed); EXPECT_EQ(failure.nextAllowedAt, time + 60000);
+        time += 59999; EXPECT_EQ(warm.read(true).nextAllowedAt, failure.nextAllowedAt); EXPECT_EQ(usageCalls, 7);
+        ++time; failure = warm.read(true); EXPECT_EQ(usageCalls, 8); EXPECT_EQ(failure.nextAllowedAt, time + 120000);
+    }
+}
