+TEST(CollectorQuotaAccounts, PrivateStorageFailuresNeverPublishEphemeralOrUnsafeIds) {
+    for (int failure = 0; failure < 6; ++failure) {
+        SCOPED_TRACE(failure); Home home; home.codexAuth();
+        q::Provider provider("codex", home.paths(), success, [] { return now; });
+        ASSERT_TRUE(publicIdentity(provider.read(false)));
+        const fs::path directory = home.root + "/.agent-speed/quota-accounts";
+        fs::path mapping; for (const auto& entry : fs::directory_iterator(directory)) mapping = entry.path();
+        ASSERT_FALSE(mapping.empty());
+        if (failure == 0) chmod(directory.c_str(), 0755);
+        else if (failure == 1) chmod(mapping.c_str(), 0644);
+        else if (failure == 2) { fs::remove(mapping); fs::create_symlink(home.paths().codexAuth, mapping); }
+        else if (failure == 3) { fs::remove_all(directory); put(directory, "not a directory"); }
+        else if (failure == 4) put(mapping, "qa1_invalid");
+        else fs::create_hard_link(mapping, directory / "shared.id");
+        EXPECT_FALSE(publicIdentity(provider.read(false)));
+        q::Provider restarted("codex", home.paths(), success, [] { return now; }); EXPECT_FALSE(publicIdentity(restarted.read(false)));
+    }
