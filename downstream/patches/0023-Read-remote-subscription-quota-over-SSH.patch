+std::int64_t retryDelay(const std::string& hint, std::int64_t now) {
+    char* end = nullptr; double seconds = std::strtod(hint.c_str(), &end);
+    if (!hint.empty() && end == hint.c_str() + hint.size() && std::isfinite(seconds) && seconds >= 0)
