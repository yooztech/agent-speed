diff --git a/macos/Sources/AgentSpeed/App/RemoteQuotaProvider.swift b/macos/Sources/AgentSpeed/App/RemoteQuotaProvider.swift
new file mode 100644
index 0000000000000000000000000000000000000000..84f0010a82a90f2926774e6dedf69a0b60a3f4b0
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/RemoteQuotaProvider.swift
@@ -0,0 +1,185 @@
+import AgentSpeedCore
+import Foundation
+
+/// Uses the existing collector channel. Only snapshots, never remote credentials, are persisted.
+@MainActor
+final class RemoteQuotaTransport {
+    private struct Pending {
+        let hostID: UUID
+        let connection: UUID
+        let providerID: String
+        let continuation: CheckedContinuation<QuotaSnapshot, Never>
+        let timeout: Task<Void, Never>
+    }
+    private struct Cached: Codable {
+        let destination: String
+        let snapshot: QuotaSnapshot
+    }
+    private let defaults: UserDefaults
+    private var hosts: [RemoteHost] = []
+    private var connections: [UUID: UUID] = [:]
+    private var cache: [String: QuotaSnapshot] = [:]
+    var onChange: ((Set<UUID>) -> Void)?
+    var send: ((UUID, Data) -> Bool)?
+    private var pending: [String: Pending] = [:]
+    private let timeoutSeconds: TimeInterval
+
+    init(defaults: UserDefaults, timeoutSeconds: TimeInterval = 45) {
+        self.defaults = defaults
+        self.timeoutSeconds = timeoutSeconds
+    }
+
+    var sources: [QuotaSourceDefinition] {
+        hosts.flatMap { host in
+            quotaSources.map { QuotaSourceDefinition(id: QuotaSourceIdentity.remote(hostID: host.id, providerID: $0.id),
+                                                    name: "\($0.name) · \(host.displayName(in: hosts))") }
+        }
+    }
+    func configure(hosts newHosts: [RemoteHost], connections newConnections: [UUID: UUID]) {
+        let enabled = newHosts.filter(\.enabled)
+        let affected = Set((hosts + enabled).map(\.id).filter { id in
+            hosts.first(where: { $0.id == id }) != enabled.first(where: { $0.id == id }) || connections[id] != newConnections[id]
+                || hosts.first(where: { $0.id == id })?.displayName(in: hosts) != enabled.first(where: { $0.id == id })?.displayName(in: enabled)
+        })
+        guard !affected.isEmpty else { return }
+        for old in hosts {
+            let current = enabled.first { $0.id == old.id }
+            if current == nil || current?.destination != old.destination {
+                for provider in QuotaSourceIdentity.providers {
+                    let id = QuotaSourceIdentity.remote(hostID: old.id, providerID: provider)
+                    cache.removeValue(forKey: id)
+                    defaults.removeObject(forKey: "quota.remote.\(id)")
+                }
+            }
+        }
+        hosts = enabled
+        connections = newConnections
+        for (id, request) in pending where affected.contains(request.hostID) {
+            finish(id, result: fallback(for: request.hostID, providerID: request.providerID))
+        }
+        for (id, value) in cache where affected.contains(where: { id.hasPrefix("remote:\($0.uuidString):") }) && value.status == .ok {
+            cache[id] = value.withRemoteStatus(.stale)
+        }
+        onChange?(affected)
+    }
+
+    func providers() -> [any QuotaProvider] {
+        hosts.flatMap { host in QuotaSourceIdentity.providers.map { RemoteQuotaProvider(hostID: host.id, providerID: $0, transport: self) } }
+    }
+
+    func cached(sourceID: String) -> QuotaSnapshot? {
+        let providerID = QuotaSourceIdentity.providerID(sourceID)
+        guard providerID != sourceID,
+              let host = hosts.first(where: { QuotaSourceIdentity.remote(hostID: $0.id, providerID: providerID) == sourceID }) else { return nil }
+        return cached(hostID: host.id, providerID: providerID)
+    }
+
+    func cached(hostID: UUID, providerID: String) -> QuotaSnapshot {
+        let id = QuotaSourceIdentity.remote(hostID: hostID, providerID: providerID)
+        guard let host = hosts.first(where: { $0.id == hostID }) else { return empty(hostID: hostID, providerID: providerID) }
+        if let value = cache[id] { return value.withRemoteHostName(host.displayName(in: hosts)) }
+        if let data = defaults.data(forKey: "quota.remote.\(id)"),
+           let value = try? JSONDecoder().decode(Cached.self, from: data), value.destination == host.destination,
+           value.snapshot.id == id {
+            let snapshot = (value.snapshot.status == .ok ? value.snapshot.withRemoteStatus(.stale) : value.snapshot)
+                .withRemoteHostName(host.displayName(in: hosts))
+            cache[id] = snapshot
+            return snapshot
+        }
+        return empty(hostID: hostID, providerID: providerID)
+    }
+
+    func request(hostID: UUID, providerID: String, refresh: Bool) async -> QuotaSnapshot {
+        guard !Task.isCancelled, let connection = connections[hostID], hosts.contains(where: { $0.id == hostID }) else {
+            return fallback(for: hostID, providerID: providerID)
+        }
+        let id = UUID().uuidString
+        let command: [String: Any] = ["type": "quota", "requestId": id, "providers": [providerID], "refresh": refresh]
+        guard var data = try? JSONSerialization.data(withJSONObject: command) else { return fallback(for: hostID, providerID: providerID) }
+        data.append(10)
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in
+                let timeout = Task { [weak self] in
+                    try? await Task.sleep(for: .seconds(self?.timeoutSeconds ?? 45))
+                    guard !Task.isCancelled else { return }
+                    self?.expire(id)
+                }
+                pending[id] = Pending(hostID: hostID, connection: connection, providerID: providerID,
+                                      continuation: continuation, timeout: timeout)
+                if Task.isCancelled || send?(hostID, data) != true { expire(id) }
+            }
+        } onCancel: {
+            Task { @MainActor [weak self] in self?.expire(id) }
+        }
+    }
+
+    func cancel(sourceID: String) {
+        for (id, request) in pending where QuotaSourceIdentity.remote(hostID: request.hostID, providerID: request.providerID) == sourceID {
+            expire(id)
+        }
+    }
+
+    func cancel(hostID: UUID, providerID: String) {
+        for (id, request) in pending where request.hostID == hostID && request.providerID == providerID { expire(id) }
+    }
+
+    func receive(_ response: RemoteQuotaResponse, hostID: UUID, connection: UUID) {
+        guard let request = pending[response.requestId], request.hostID == hostID,
+              request.connection == connection, connections[hostID] == connection,
+              response.snapshots.count == 1, let value = response.snapshots.first, value.id == request.providerID,
+              let host = hosts.first(where: { $0.id == hostID }) else { return }
+        let snapshot = value.scopedToRemote(hostID: hostID, hostName: host.displayName(in: hosts))
+        cache[snapshot.id] = snapshot
+        if let data = try? JSONEncoder().encode(Cached(destination: host.destination, snapshot: snapshot)) {
+            defaults.set(data, forKey: "quota.remote.\(snapshot.id)")
+        }
+        finish(response.requestId, result: snapshot)
+    }
+
+    /// Explicit timeout entry point also permits deterministic tests without wall-clock sleeps.
+    func expire(_ id: String) {
+        guard let request = pending[id] else { return }
+        finish(id, result: fallback(for: request.hostID, providerID: request.providerID))
+    }
+
+    private func finish(_ id: String, result: QuotaSnapshot) {
+        guard let request = pending.removeValue(forKey: id) else { return }
+        request.timeout.cancel()
+        request.continuation.resume(returning: result)
+    }
+
+    private func fallback(for hostID: UUID, providerID: String) -> QuotaSnapshot {
+        let value = cached(hostID: hostID, providerID: providerID)
+        let result = value.withRemoteStatus(value.observedAt == nil ? .error : .stale)
+        if hosts.contains(where: { $0.id == hostID }) { cache[result.id] = result }
+        return result
+    }
+
+    private func empty(hostID: UUID, providerID: String) -> QuotaSnapshot {
+        let name = quotaSources.first { $0.id == providerID }?.name ?? providerID
+        let hostName = hosts.first { $0.id == hostID }?.displayName(in: hosts) ?? hostID.uuidString
+        return QuotaSnapshot(id: providerID, displayName: name, fidelity: "official", status: .error,
+                             windows: [], headlineId: nil, block: nil, account: nil, plan: nil, observedAt: nil,
+                             source: "remote collector", credits: nil, nextAllowedAt: nil, waitingForRefresh: false)
+            .scopedToRemote(hostID: hostID, hostName: hostName)
+    }
+}
+
+@MainActor
+private final class RemoteQuotaProvider: QuotaProvider {
+    nonisolated let id: String
+    private let hostID: UUID
+    private let providerID: String
+    private let transport: RemoteQuotaTransport
+
+    init(hostID: UUID, providerID: String, transport: RemoteQuotaTransport) {
+        self.hostID = hostID
+        self.providerID = providerID
+        self.transport = transport
+        id = QuotaSourceIdentity.remote(hostID: hostID, providerID: providerID)
+    }
+    func readCachedSnapshot() async -> QuotaSnapshot { transport.cached(hostID: hostID, providerID: providerID) }
+    func refreshStartup() async -> QuotaSnapshot { await refresh() }
+    func refresh() async -> QuotaSnapshot { await transport.request(hostID: hostID, providerID: providerID, refresh: true) }
+    func cancel() async { transport.cancel(hostID: hostID, providerID: providerID) }
+}
