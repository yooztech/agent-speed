new file mode 100644
index 0000000000000000000000000000000000000000..305ee12bfc4c9a584a770df656bf3662592c1bb1
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/RemoteQuota.swift
@@ -0,0 +1,71 @@
+import Foundation
+
+/// Source identity is independent of provider branding and account labels.
+public enum QuotaSourceIdentity {
+    public static let providers = ["codex", "opencode-go"]
+
+    public static func remote(hostID: UUID, providerID: String) -> String {
+        "remote:\(hostID.uuidString):\(providerID)"
+    }
+
+    public static func providerID(_ sourceID: String) -> String {
+        let parts = sourceID.split(separator: ":", omittingEmptySubsequences: false)
+        guard parts.count == 3, parts[0] == "remote", UUID(uuidString: String(parts[1])) != nil,
+              providers.contains(String(parts[2])) else { return sourceID }
+        return String(parts[2])
+    }
+}
+
+public struct RemoteQuotaResponse: Decodable, Sendable {
+    public let type: String
+    public let requestId: String
+    public let snapshots: [QuotaSnapshot]
+    private static let fractionalDate = Date.ISO8601FormatStyle(includingFractionalSeconds: true)
+    private static let plainDate = Date.ISO8601FormatStyle()
+
+    public static func decode(_ data: Data) -> RemoteQuotaResponse? {
+        guard data.count <= 262_144 else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .custom { decoder in
+            let value = try decoder.singleValueContainer().decode(String.self)
+            if let date = try? fractionalDate.parse(value) { return date }
+            guard let date = try? plainDate.parse(value) else {
+                throw DecodingError.dataCorrupted(.init(codingPath: decoder.codingPath, debugDescription: "Invalid quota date"))
+            }
+            return date
+        }
+        guard let response = try? decoder.decode(Self.self, from: data), response.type == "quota",
+              !response.requestId.isEmpty, response.requestId.utf8.count <= 128,
+              response.requestId.utf8.allSatisfy({ (32...126).contains($0) }),
+              (1...2).contains(response.snapshots.count),
+              Set(response.snapshots.map(\.id)).count == response.snapshots.count,
+              response.snapshots.allSatisfy({ QuotaSourceIdentity.providers.contains($0.id) }) else { return nil }
+        return response
+    }
+}
+
+public extension QuotaSnapshot {
+    func scopedToRemote(hostID: UUID, hostName: String) -> QuotaSnapshot {
+        replacingIdentity(id: QuotaSourceIdentity.remote(hostID: hostID, providerID: id),
+                          displayName: "\(displayName) · \(hostName)", source: "\(source) · SSH \(hostName)", status: status)
+    }
+
+    func withRemoteStatus(_ status: QuotaStatus) -> QuotaSnapshot {
+        replacingIdentity(id: id, displayName: displayName, source: source, status: status)
+    }
+
+    func withRemoteHostName(_ hostName: String) -> QuotaSnapshot {
+        let provider = QuotaSourceIdentity.providerID(id)
+        let providerName = provider == "codex" ? "Codex" : "OpenCode Go"
+        return replacingIdentity(id: id, displayName: "\(providerName) · \(hostName)",
+                                 source: "remote collector · SSH \(hostName)", status: status)
+    }
+
+    private func replacingIdentity(id: String, displayName: String, source: String, status: QuotaStatus) -> QuotaSnapshot {
+        QuotaSnapshot(id: id, displayName: displayName, fidelity: fidelity, status: status,
+                      windows: windows, headlineId: headlineId, block: block, account: account, plan: plan,
+                      observedAt: observedAt, source: source, credits: credits, nextAllowedAt: nextAllowedAt,
+                      waitingForRefresh: waitingForRefresh, resetCreditsAvailable: resetCreditsAvailable,
+                      resetCreditsNextExpiry: resetCreditsNextExpiry, accountIdentity: accountIdentity)
+    }
+}
