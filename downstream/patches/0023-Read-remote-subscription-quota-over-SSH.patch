diff --git a/linux/collector/quota.cpp b/linux/collector/quota.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..40fc425e7d3baea26e2f648513c4e997b2ce9239
--- /dev/null
+++ b/linux/collector/quota.cpp
@@ -0,0 +1,625 @@
+// Provider integration adapted from Codenotch, MIT, commit
+// 835550a342871779135b6484d6899161c5222f7c. See quota.LICENSE.txt.
+#include "quota.hpp"
+#include "agentspeed/json.hpp"
+#include "agentspeed/rfc3339.hpp"
+#include <curl/curl.h>
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+#include <sqlite3.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <cctype>
+#include <cstdio>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <ctime>
+#include <deque>
+#include <fcntl.h>
+#include <linux/fs.h>
+#include <map>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <thread>
+#include <unistd.h>
+
+namespace collector::quota {
+namespace {
+using agentspeed::json::Document;
+using agentspeed::json::Value;
+using Json = agentspeed::report::Json;
+constexpr std::size_t kFile = 1024 * 1024, kBody = 1024 * 1024, kWindows = 128;
+constexpr std::int64_t kMaxDate = 253402300799000LL;
+std::int64_t clockNow() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count(); }
+struct Fd {
+    int value;
+    explicit Fd(int fd = -1) : value(fd) {}
+    ~Fd() { if (value >= 0) close(value); }
+    Fd(const Fd&) = delete;
+    Fd& operator=(const Fd&) = delete;
+};
+std::optional<std::string> text(Value v) {
+    auto s = v.string();
+    return s && s->size() <= 4096 ? s : std::nullopt;
+}
+std::optional<double> number(Value v, bool strings = false) {
+    if (auto n = v.finiteNumber()) return n;
+    if (strings) if (auto s = v.string(); s && !s->empty() && s->size() <= 128) {
+        char* end = nullptr; errno = 0;
+        double n = std::strtod(s->c_str(), &end);
+        if (!errno && end == s->c_str() + s->size() && std::isfinite(n)) return n;
+    }
+    return std::nullopt;
+}
+std::optional<bool> boolean(Value v) { return v.isBool() ? std::optional<bool>(v.isTrue()) : std::nullopt; }
+bool header(const std::string& s) {
+    return !s.empty() && s.size() <= 16384 && !agentspeed::json::isBlank(s) &&
+        std::none_of(s.begin(), s.end(), [](unsigned char c) { return c < 32 || c == 127; });
+}
+std::optional<std::string> fileAt(int dir, const std::string& name, bool privateFile = false) {
+    Fd fd(openat(dir, name.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW));
+    struct stat st{};
+    if (fd.value < 0 || fstat(fd.value, &st) || !S_ISREG(st.st_mode) || st.st_size < 0 ||
+        st.st_size > static_cast<off_t>(kFile) || st.st_uid != geteuid() ||
+        (privateFile && ((st.st_mode & 07777) != 0600 || st.st_nlink != 1))) return std::nullopt;
+    std::string out; out.reserve(static_cast<std::size_t>(st.st_size));
+    char buf[8192];
+    for (;;) {
+        ssize_t n = ::read(fd.value, buf, sizeof(buf));
+        if (n == 0) return out;
+        if (n < 0) { if (errno == EINTR) continue; return std::nullopt; }
+        if (out.size() + static_cast<std::size_t>(n) > kFile) return std::nullopt;
+        out.append(buf, static_cast<std::size_t>(n));
+    }
+}
+std::string digest(const std::string& value) {
+    unsigned char out[EVP_MAX_MD_SIZE]; unsigned int size = 0;
+    if (EVP_Digest(value.data(), value.size(), out, &size, EVP_sha256(), nullptr) != 1 || size != 32) throw std::runtime_error("quota digest");
+    std::string result; result.reserve(64); const char hex[] = "0123456789abcdef";
+    for (unsigned int i = 0; i < size; ++i) { result += hex[out[i] >> 4]; result += hex[out[i] & 15]; }
+    return result;
+}
+std::optional<std::int64_t> epoch(std::optional<double> seconds) {
+    if (!seconds || *seconds < 0 || *seconds > kMaxDate / 1000.0) return std::nullopt;
+    return static_cast<std::int64_t>(*seconds * 1000);
+}
+std::optional<std::int64_t> date(Value v) {
+    auto s = text(v); if (!s || s->size() < 20) return std::nullopt;
+    auto result = agentspeed::parseTimestamp(*s);
+    return result && *result >= 0 && *result <= kMaxDate ? result : std::nullopt;
+}
+std::string iso(std::int64_t ms) {
+    std::time_t seconds = ms / 1000; std::tm tm{}; gmtime_r(&seconds, &tm);
+    char result[40]; std::strftime(result, sizeof(result), "%Y-%m-%dT%H:%M:%S", &tm);
+    char tail[10]; std::snprintf(tail, sizeof(tail), ".%03dZ", static_cast<int>(ms % 1000));
+    return std::string(result) + tail;
+}
+Json str(const std::optional<std::string>& s) { return s ? Json::of(*s) : Json::null(); }
+Json num(std::optional<double> n) { return n && std::isfinite(*n) ? Json::decimal(*n, 15) : Json::null(); }
+Json integer(std::optional<std::int64_t> n) { return n ? Json::of(*n) : Json::null(); }
+Json bit(std::optional<bool> b) { return b ? Json::of(*b) : Json::null(); }
+Json stamp(std::optional<std::int64_t> t) { return t ? Json::of(iso(*t)) : Json::null(); }
