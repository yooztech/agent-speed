+std::optional<double> monthDuration(std::int64_t ms) {
+    std::time_t seconds = ms / 1000; std::tm tm{}; gmtime_r(&seconds, &tm);
+    int year = tm.tm_year + 1900, month = tm.tm_mon + 1;
+    if (month == 1) { --year; month = 12; } else --month;
+    if (year < 1) return std::nullopt;
+    const int lengths[] = {31,28,31,30,31,30,31,31,30,31,30,31};
+    int days = lengths[month - 1] + (month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0));
+    auto previous = agentspeed::daysFromCivil(year, month, std::min(tm.tm_mday, days));
+    auto current = agentspeed::daysFromCivil(tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday);
+    return static_cast<double>((current - previous) * 86400);
