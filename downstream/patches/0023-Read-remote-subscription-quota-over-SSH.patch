+TEST(CollectorQuotaService, ColdRetriesCoalesceActualRequestsOnlyAtDeadlineForEverySupplier) {
+    for (const auto* id : {"codex", "opencode-go"}) {
+        SCOPED_TRACE(id);
+        Home home; home.codexAuth(); home.goAuth(); std::atomic<std::int64_t> time{now};
+        std::mutex mutex; std::condition_variable cv; bool started = false, release = false;
+        std::atomic<int> usageCalls{0}; const auto providers = "\"" + std::string(id) + "\"";
+        q::Service service(home.paths(), [&](const std::string& url, const q::Credential& c, bool reset) {
+            if (reset) return success(url, c, reset);
+            auto attempt = ++usageCalls;
+            { std::unique_lock<std::mutex> lock(mutex); started = true; cv.notify_all(); cv.wait(lock, [&] { return release; }); }
+            return attempt == 1 ? q::HttpReply{503, "", ""} : success(url, c, reset);
+        }, [&] { return time.load(); });
+        auto pair = [&](const std::string& request, bool network) {
+            if (network) { std::lock_guard<std::mutex> lock(mutex); started = false; release = false; }
+            EXPECT_TRUE(service.control(command(request + "-a", true, providers), 1));
+            if (network) {
+                std::unique_lock<std::mutex> lock(mutex);
+                if (!cv.wait_for(lock, std::chrono::seconds(3), [&] { return started; })) {
+                    release = true; cv.notify_all(); ADD_FAILURE() << "quota transport did not start"; return;
+                }
+            }
+            EXPECT_TRUE(service.control(command(request + "-b", true, providers), 2));
+            if (network) { { std::lock_guard<std::mutex> lock(mutex); release = true; } cv.notify_all(); }
+            auto out = replies(service, 2); ASSERT_EQ(out.size(), 2u);
+            std::set<std::uint64_t> subscribers;
+            for (const auto& [subscriber, line] : out) {
+                subscribers.insert(subscriber); Document doc; ASSERT_TRUE(doc.parse(line));
+                const auto snapshot = doc.root()["snapshots"].at(0);
+                EXPECT_TRUE(snapshot["id"].equals(id));
+                if (time < now + 5000) {
+                    EXPECT_TRUE(snapshot["status"].equals("error")); EXPECT_TRUE(snapshot["observedAt"].isNull());
+                    auto deadline = snapshot["nextAllowedAt"].string(); ASSERT_TRUE(deadline);
+                    EXPECT_EQ(agentspeed::parseTimestamp(*deadline), now + 5000);
+                } else EXPECT_TRUE(snapshot["status"].equals("ok"));
+            }
+            EXPECT_EQ(subscribers, (std::set<std::uint64_t>{1, 2}));
+        };
+        pair("cold", true); EXPECT_EQ(usageCalls, 1);
+        time = now + 4999; pair("early", false); EXPECT_EQ(usageCalls, 1);
+        time = now + 5000; pair("retry", true); EXPECT_EQ(usageCalls, 2);
+    }
+}
