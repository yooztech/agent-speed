+    Document doc; if (json.size() > kBody || !doc.parse(json) || !doc.root()["usage"].isObject()) throw std::runtime_error("quota response");
+    Snapshot s = empty("opencode-go", "ok"); s.observedAt = now; s.plan = "Go"; bool measured = false;
+    for (const auto& [name, v] : doc.root()["usage"].members()) {
+        if (!v.isObject()) continue;
+        auto used = fraction(v["percent"]); auto at = date(v["resetsAt"]); auto status = text(v["status"]);
+        if (!used && !at && !status) continue;
+        if (name.size() > 4096 || s.windows.size() == kWindows) throw std::runtime_error("quota windows");
+        measured |= used.has_value(); if (status == "rate-limited") s.block = "rate-limited";
+        std::optional<double> duration;
+        if (name == "rolling") duration = 18000; else if (name == "weekly") duration = 604800; else if (name == "monthly" && at) duration = monthDuration(*at);
+        s.windows.push_back(window("go:" + name, name == "rolling" || name == "weekly" || name == "monthly" ? "OpenCode Go" : name, used, at, duration));
+    }
+    if (!measured) throw std::runtime_error("quota meters");
+    return s;
+}
+std::pair<std::optional<std::int64_t>, std::optional<std::int64_t>> parseResetCredits(const std::string& json) {
+    Document doc; if (json.size() > kBody || !doc.parse(json)) return {};
+    auto root = doc.root(); auto count = root["available_count"].ordinal(); std::optional<std::int64_t> expiry;
+    if (root["credits"].isArray()) {
+        std::int64_t available = 0; bool complete = true;
+        for (auto credit : root["credits"].elements()) {
+            if (credit["status"].equals("available")) { ++available; auto at = date(credit["expires_at"]); if (at && (!expiry || *at < *expiry)) expiry = at; }
+            else if (!credit["status"].equals("used") && !credit["status"].equals("consumed") && !credit["status"].equals("expired")) complete = false;
+        }
+        if (!count && complete) count = available;
+    }
+    if (count == 0) expiry.reset();
+    return {count, expiry};
+}
+
+struct Provider::Impl {
+    std::string id; Paths paths; Transport transport; Now now; Fd directory;
+    std::string key, rejectedToken, resetRejectedToken, rejectedStatus;
+    std::optional<std::int64_t> next, retry;
+    int failures = 0, coldFailures = 0; bool success = false;
+    std::optional<Snapshot> snapshot;
+    Impl(std::string providerId, Paths providerPaths, Transport providerTransport, Now providerNow) : id(std::move(providerId)), paths(std::move(providerPaths)), transport(providerTransport ? std::move(providerTransport) : http), now(providerNow ? std::move(providerNow) : clockNow), directory(cacheDirectory(paths.home)) {}
+    std::string accountKey(const Credential& c) const { return digest(id + "\n" + (id == "codex" ? c.account : c.context + "\n" + c.organization + "\n" + c.token + "\n" + (c.oauth ? "oauth" : "api") + "\n" + c.console)); }
+    void load(const std::string& newKey) {
+        if (key == newKey) return;
+        key = newKey; rejectedToken.clear(); resetRejectedToken.clear(); rejectedStatus.clear(); next.reset(); retry.reset(); failures = 0; coldFailures = 0; success = false; snapshot.reset();
+        if (directory.value < 0) return;
+        auto data = fileAt(directory.value, id + "-" + key + ".json", true); Document doc;
+        if (!data || !doc.parse(*data)) return;
+        auto v = doc.root(); if (v["version"].raw() != "1" || !v["contextKey"].equals(key)) return;
+        next = date(v["nextAllowedAt"]); retry = date(v["retryNotBefore"]);
+        failures = static_cast<int>(std::clamp<std::int64_t>(v["failures"].ordinal().value_or(0), 0, 6));
+        coldFailures = static_cast<int>(std::clamp<std::int64_t>(v["coldFailures"].ordinal().value_or(0), 0, 4));
+        rejectedToken = text(v["rejectedToken"]).value_or(""); resetRejectedToken = text(v["resetRejectedToken"]).value_or("");
+        auto status = text(v["rejectedStatus"]); if (status == "unsupported" || status == "needsAuth" || status == "accessDenied") rejectedStatus = *status;
+        success = v["successfulObservation"].isTrue();
+        if (rejectedStatus.empty() && rejectedToken.empty()) snapshot = cachedSnapshot(v["snapshot"], id);
+    }
+    void save() {
+        Json observation;
+        if (snapshot) { auto s = *snapshot; s.status = "ok"; s.nextAllowedAt.reset(); observation = s.json(); }
+        saveFile(directory.value, id + "-" + key + ".json", Json::object({{"version", Json::of(1)}, {"contextKey", Json::of(key)}, {"nextAllowedAt", stamp(next)}, {"retryNotBefore", stamp(retry)}, {"failures", Json::of(failures)}, {"coldFailures", Json::of(coldFailures)}, {"successfulObservation", Json::of(success)}, {"rejectedToken", Json::of(rejectedToken)}, {"resetRejectedToken", Json::of(resetRejectedToken)}, {"rejectedStatus", Json::of(rejectedStatus)}, {"snapshot", std::move(observation)}}).compact());
+    }
+    Snapshot retained() const {
+        auto s = snapshot.value_or(empty(id)); s.nextAllowedAt = next;
+        // Hydration and unsuccessful refresh never turn a persisted observation fresh.
+        if (snapshot) s.status = "stale";
+        s.waitingForRefresh = !snapshot && success && next && *next > now(); return s;
+    }
+    void backoff(std::int64_t delay = 0, bool rateLimited = false, bool transient = true) {
+        failures = std::min(failures + 1, 6); success = false;
+        auto floor = std::min<std::int64_t>(id == "codex" ? 1920000 : 900000, 60000LL << (failures - 1));
+        if (!snapshot && transient && !rateLimited) {
+            // Only failures without a validated observation use first-data pacing.
+            // Supplier throttling must not advance this independent sequence.
+            constexpr std::array<std::int64_t, 4> cold{5000, 10000, 20000, 30000};
+            coldFailures = std::min(coldFailures + 1, 4); floor = cold[coldFailures - 1];
+        }
+        const auto observed = now();
+        next = observed + std::min(kMaxDate - observed, std::max(floor, delay)); retry = next;
+    }
+    Snapshot read(bool refresh) {
+        auto current = credentials(id, paths);
+        auto result = readUsage(refresh, current);
+        // Discovery is independent of a successful usage observation. Never turn
+        // token/session/cache context into an account, or bind rejected auth.
+        if (id == "codex" && current && current->accountIdentityReliable && result.status != "needsAuth" && directory.value >= 0)
+            result.accountIdentity = accountIdentity(paths.home, key);
+        if (credentials(id, paths) != current) return read(false);
+        return result;
+    }
+    Snapshot readUsage(bool refresh, const std::optional<Credential>& c) {
+        if (!c) { snapshot.reset(); key.clear(); return empty(id, "needsAuth"); }
+        load(accountKey(*c)); const auto token = digest(c->token);
+        // Refuse network work if the private, persistent pacing store is unavailable.
+        if (refresh && directory.value < 0) return empty(id);
+        if (rejectedToken == token || rejectedStatus == "needsAuth") return empty(id, "needsAuth");
+        if (!rejectedStatus.empty() && (!next || *next > now())) { auto s = empty(id, rejectedStatus); s.nextAllowedAt = next; return s; }
+        if (!refresh) return retained();
+        if (next && *next > now()) { auto s = success && snapshot ? *snapshot : retained(); s.nextAllowedAt = next; return s; }
+        rejectedToken.clear(); rejectedStatus.clear(); Snapshot result; std::int64_t serverDelay = 0;
+        try {
+            const std::string url = id == "codex" ? "https://chatgpt.com/backend-api/wham/usage" : c->oauth ? "https://opencode.ai/inference/go/v1/usage" : "https://opencode.ai/zen/go/v1/usage";
+            auto reply = transport(url, *c, false);
+            if (!reply.retryAfter.empty()) serverDelay = retryDelay(reply.retryAfter, now());
+            if (reply.status >= 200 && reply.status < 300) {
+                auto observed = now(); result = id == "codex" ? parseCodex(reply.body, observed) : parseGo(reply.body, observed);
+                next = id == "codex" ? std::optional<std::int64_t>(std::min(kMaxDate, observed + 300000)) : std::nullopt;
+                retry.reset(); failures = 0; coldFailures = 0; success = true;
+                if (id == "codex" && resetRejectedToken != token) {
+                    // Optional endpoint failure never destroys a successfully parsed usage observation.
+                    try {
+                        auto reset = transport("https://chatgpt.com/backend-api/wham/rate-limit-reset-credits", *c, true);
+                        if (reset.status >= 200 && reset.status < 300) {
+                            auto reading = parseResetCredits(reset.body); result.resetCreditsAvailable = reading.first; result.resetCreditsNextExpiry = reading.second;
+                        } else if (reset.status == 401 || reset.status == 403) resetRejectedToken = token;
+                        else if (reset.status == 429 || !reset.retryAfter.empty()) { next = std::max(next.value_or(0), std::min(kMaxDate, now() + retryDelay(reset.retryAfter, now()))); retry = next; }
+                    } catch (...) { /* Optional reading remains unknown. */ }
+                }
+                result.nextAllowedAt = next; snapshot = result;
+            } else if (reply.status == 401 || reply.status == 403) {
+                bool noPlan = id == "opencode-go" && reply.status == 403;
+                if (id == "opencode-go" && c->oauth && reply.status == 401) {
+                    auto probe = transport(c->console + "/api/user", *c, false);
+                    if (probe.status == 200) noPlan = true;
+                    else if (probe.status != 401 && probe.status != 403) { backoff(probe.retryAfter.empty() ? 0 : retryDelay(probe.retryAfter, now()), probe.status == 429); result = retained(); }
+                    else result = empty(id, "needsAuth");
+                    if (!noPlan && probe.status != 401 && probe.status != 403) {
+                        if (credentials(id, paths) != c) { key.clear(); snapshot.reset(); return read(false); }
+                        save(); return result;
+                    }
+                }
+                if (noPlan) { snapshot.reset(); success = false; coldFailures = 0; rejectedStatus = "unsupported"; next = std::min(kMaxDate, now() + 300000); retry = next; result = empty(id, "unsupported"); result.nextAllowedAt = next; }
+                else if (id == "opencode-go" && c->expires && *c->expires <= now()) { backoff(0, false, false); result = snapshot ? retained() : empty(id, "needsAuth"); result.nextAllowedAt = next; }
+                else { snapshot.reset(); success = false; coldFailures = 0; rejectedToken = token; result = empty(id, "needsAuth"); }
+            } else { backoff(serverDelay, reply.status == 429); result = retained(); }
+        } catch (...) { backoff(serverDelay); result = retained(); }
+        // Never commit or reply with an old account after a concurrent auth/workspace change.
+        if (credentials(id, paths) != c) { key.clear(); snapshot.reset(); return read(false); }
+        save(); return result;
+    }
+};
+Provider::Provider(std::string id, Paths paths, Transport transport, Now now) : impl_(std::make_unique<Impl>(std::move(id), std::move(paths), std::move(transport), std::move(now))) {}
+Provider::~Provider() = default;
+Snapshot Provider::read(bool refresh) { return impl_->read(refresh); }
+
+struct Service::Impl {
+    struct Request { std::uint64_t subscriber; std::string id; std::vector<std::string> providers; std::map<std::string, std::shared_ptr<const std::string>> snapshots; };
+    struct Job { bool refresh; std::vector<std::uint64_t> requests; bool running = false; };
+    std::mutex mutex; std::condition_variable changed; bool stopping = false;
+    std::array<std::deque<std::shared_ptr<Job>>, 2> jobs;
+    std::map<std::uint64_t, Request> pending; std::uint64_t sequence = 0;
+    std::vector<std::pair<std::uint64_t, std::string>> output;
+    std::array<std::thread, 2> workers;
+    Impl(Paths paths, Transport transport, Now now) {
+        for (std::size_t i = 0; i < 2; ++i) workers[i] = std::thread([this, i, paths, transport, now] {
+            const std::string id = i == 0 ? "codex" : "opencode-go";
+            Provider provider(id, paths, transport, now);
+            for (;;) {
+                std::shared_ptr<Job> job;
+                { std::unique_lock<std::mutex> lock(mutex); changed.wait(lock, [&] { return stopping || !jobs[i].empty(); }); if (stopping) return; job = jobs[i].front(); job->running = true; }
+                Snapshot result; try { result = provider.read(job->refresh); } catch (...) { result = empty(id); }
+                // Serialize once outside the queue mutex, not once per subscriber.
+                auto serialized = std::make_shared<const std::string>(result.json().compact());
+                if (serialized->size() > 256 * 1024) serialized = std::make_shared<const std::string>(empty(id).json().compact());
+                { std::lock_guard<std::mutex> lock(mutex);
+                    for (auto requestId : job->requests) {
+                        auto it = pending.find(requestId); if (it == pending.end()) continue;
+                        auto& request = it->second; request.snapshots[id] = serialized;
+                        if (request.snapshots.size() != request.providers.size()) continue;
+                        std::string line = "{\"type\":\"quota\",\"requestId\":" + Json::quoted(request.id) + ",\"snapshots\":[";
+                        bool first = true;
+                        for (const auto& wanted : request.providers) { if (!first) line += ','; first = false; line += *request.snapshots.at(wanted); }
+                        line += "]}";
+                        output.emplace_back(request.subscriber, std::move(line));
+                        pending.erase(it);
+                    }
+                    jobs[i].pop_front();
+                }
+            }
+        });
+    }
+    ~Impl() { { std::lock_guard<std::mutex> lock(mutex); stopping = true; } changed.notify_all(); for (auto& worker : workers) if (worker.joinable()) worker.join(); }
+};
+Service::Service(Paths paths, Transport transport, Now now) : impl_(std::make_unique<Impl>(std::move(paths), std::move(transport), std::move(now))) {}
+Service::~Service() = default;
+bool Service::control(const std::string& line, std::uint64_t subscriber) {
+    if (line.size() > 16384) return false;
+    Document doc; if (!doc.parse(line)) return false; auto v = doc.root();
+    if (!v["type"].equals("quota") || !v["refresh"].isBool() || !v["providers"].isArray() || v["providers"].size() == 0 || v["providers"].size() > 2) return false;
+    auto requestId = text(v["requestId"]);
+    if (!requestId || requestId->empty() || requestId->size() > 128 || std::any_of(requestId->begin(), requestId->end(), [](unsigned char c) { return c < 32 || c > 126; })) return false;
+    std::vector<std::string> providers;
+    for (auto p : v["providers"].elements()) { auto id = p.string(); if (!id || (*id != "codex" && *id != "opencode-go") || std::find(providers.begin(), providers.end(), *id) != providers.end()) return false; providers.push_back(*id); }
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    // Bounded pending requests plus bounded completed replies. A flooding client
+    // is disconnected by the daemon, never allowed to starve ordinary readers.
+    std::size_t count = 0;
+    for (const auto& reply : impl_->output) if (reply.first == subscriber) ++count;
+    for (const auto& [key, request] : impl_->pending) if (request.subscriber == subscriber) { if (request.id == *requestId) return false; ++count; }
+    if (count >= 4 || impl_->pending.size() + impl_->output.size() >= 256) return false;
+    auto key = ++impl_->sequence;
+    impl_->pending.emplace(key, Impl::Request{subscriber, *requestId, providers, {}});
+    for (const auto& id : providers) {
+        auto& queue = impl_->jobs[id == "codex" ? 0 : 1];
+        std::shared_ptr<Impl::Job> job;
+        // Concurrent explicit refreshes coalesce; cache-only requests never upgrade to HTTP.
+        for (auto& candidate : queue) if (candidate->refresh == v["refresh"].isTrue()) { job = candidate; break; }
+        if (!job) { job = std::make_shared<Impl::Job>(); job->refresh = v["refresh"].isTrue(); queue.push_back(job); }
+        job->requests.push_back(key);
+    }
+    impl_->changed.notify_all(); return true;
+}
+void Service::disconnected(std::uint64_t subscriber) {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    for (auto it = impl_->pending.begin(); it != impl_->pending.end();) if (it->second.subscriber == subscriber) it = impl_->pending.erase(it); else ++it;
+    impl_->output.erase(std::remove_if(impl_->output.begin(), impl_->output.end(), [&](const auto& reply) { return reply.first == subscriber; }), impl_->output.end());
+    for (auto& queue : impl_->jobs) for (auto it = queue.begin(); it != queue.end();) {
+        auto& job = **it;
+        job.requests.erase(std::remove_if(job.requests.begin(), job.requests.end(), [&](auto key) { return impl_->pending.count(key) == 0; }), job.requests.end());
+        if (!job.running && job.requests.empty()) it = queue.erase(it); else ++it;
+    }
+}
+std::vector<std::pair<std::uint64_t, std::string>> Service::replies() { std::lock_guard<std::mutex> lock(impl_->mutex); std::vector<std::pair<std::uint64_t, std::string>> result; result.swap(impl_->output); return result; }
