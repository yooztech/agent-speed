+        q::Provider rotating(id, home.paths(), [&](const auto&, const auto&, bool) {
+            ++calls;
+            if (std::string(id) == "codex") home.codexAuth("new-token", "new-account");
+            else home.goAuth(R"({"opencode-go":"new-token"})");
+            return q::HttpReply{503, "", "1200"};
+        }, [] { return now; });
+        auto discarded = rotating.read(true); EXPECT_EQ(calls, 1); EXPECT_EQ(discarded.status, "error");
