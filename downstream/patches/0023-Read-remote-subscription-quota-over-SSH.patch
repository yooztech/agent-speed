+std::optional<std::string> publicIdentity(const q::Snapshot& snapshot) {
+    Document doc;
+    if (!doc.parse(snapshot.json().compact())) { ADD_FAILURE() << "invalid quota JSON"; return std::nullopt; }
+    EXPECT_TRUE(doc.root()["account"].isNull()); // Legacy decoders still expect null/string.
+    auto value = doc.root()["accountIdentity"];
+    EXPECT_TRUE(value.valid());
+    if (value.isNull()) return std::nullopt;
+    EXPECT_TRUE(value.isObject()); EXPECT_EQ(value.size(), 2u);
+    auto id = value["id"].string(), label = value["displayName"].string();
+    if (!id || !label) { ADD_FAILURE() << "invalid account identity"; return std::nullopt; }
+    EXPECT_EQ(id->size(), 36u); EXPECT_EQ(id->substr(0, 4), "qa1_");
+    EXPECT_EQ(*label, "Codex account " + id->substr(28));
+    return id;
+}
+std::string sha256(const std::string& value) {
+    unsigned char hash[EVP_MAX_MD_SIZE]; unsigned int size = 0;
+    if (EVP_Digest(value.data(), value.size(), hash, &size, EVP_sha256(), nullptr) != 1) return {};
+    std::string result; constexpr char hex[] = "0123456789abcdef";
+    for (unsigned int i = 0; i < size; ++i) { result += hex[hash[i] >> 4]; result += hex[hash[i] & 15]; }
+    return result;
+}
