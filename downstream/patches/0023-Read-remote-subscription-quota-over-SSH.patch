+    auto raw = root["credits"], spend = root["spend_control"]["individual_limit"];
+    if (raw.isObject() || spend.isObject()) {
+        auto balance = text(raw["balance"]); if (!balance && raw["balance"].isNumber() && number(raw["balance"])) balance = std::string(raw["balance"].raw());
