+std::optional<AccountIdentity> accountIdentity(const std::string& home, const std::string& key) {
+    // Only Codex supplies a reliable nonsecret account_id. This private mapping is
+    // independent of usage caches and tokens: token rotation/relogin to the same
+    // account preserves it; deleting quota-accounts deliberately resets bindings.
+    // Never publish the private logical-account digest, even as an ID suffix.
+    Fd root(open(home.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    if (root.value < 0) return std::nullopt;
+    Fd app(privateDirectory(root.value, ".agent-speed"));
+    if (app.value < 0) return std::nullopt;
+    Fd directory(privateDirectory(app.value, "quota-accounts"));
+    if (directory.value < 0) return std::nullopt;
+    const auto name = "codex-" + key + ".id";
+    auto value = fileAt(directory.value, name, true);
+    if (!value) {
+        // Do not repair unsafe/corrupt existing mappings or follow their links.
+        struct stat st{};
+        if (fstatat(directory.value, name.c_str(), &st, AT_SYMLINK_NOFOLLOW) == 0 || errno != ENOENT) return std::nullopt;
+        std::array<unsigned char, 16> random{};
+        if (RAND_bytes(random.data(), static_cast<int>(random.size())) != 1) return std::nullopt;
+        std::string generated = "qa1_"; generated.reserve(36);
+        constexpr char hex[] = "0123456789abcdef";
+        for (auto byte : random) { generated += hex[byte >> 4]; generated += hex[byte & 15]; }
+        const auto temporary = generated + ".tmp";
+        Fd fd(openat(directory.value, temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600));
+        if (fd.value < 0) return std::nullopt;
+        std::size_t pos = 0;
+        while (pos < generated.size()) {
+            auto n = ::write(fd.value, generated.data() + pos, generated.size() - pos);
+            if (n > 0) pos += static_cast<std::size_t>(n);
+            else if (n < 0 && errno == EINTR) continue;
+            else break;
+        }
+        // Publish a completely written file without replacing another process's
+        // winner. Consumers see a stable ID only after private persistence works.
+        bool durable = pos == generated.size() && fsync(fd.value) == 0;
+        if (durable && syscall(SYS_renameat2, directory.value, temporary.c_str(), directory.value, name.c_str(), RENAME_NOREPLACE) != 0 && errno != EEXIST) durable = false;
+        if (unlinkat(directory.value, temporary.c_str(), 0) != 0 && errno != ENOENT) durable = false;
+        if (fsync(directory.value) != 0) durable = false;
+        if (!durable) return std::nullopt;
+        value = fileAt(directory.value, name, true);
+    }
+    if (!value || value->size() != 36 || value->compare(0, 4, "qa1_") != 0 ||
+        !std::all_of(value->begin() + 4, value->end(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); })) return std::nullopt;
+    // No trustworthy human label is present in the CLI file. A safe random
+    // suffix distinguishes local bindings without disclosing account claims.
+    return AccountIdentity{*value, "Codex account " + value->substr(28)};
+}
+void saveFile(int directory, const std::string& name, const std::string& body) {
+    if (directory < 0 || body.size() > kFile) return;
+    static std::atomic<std::uint64_t> sequence{0};
+    auto temporary = name + "." + std::to_string(getpid()) + "." + std::to_string(++sequence) + ".tmp";
+    Fd fd(openat(directory, temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600));
+    if (fd.value < 0) return;
+    std::size_t pos = 0; bool ok = true;
+    while (pos < body.size()) { ssize_t n = write(fd.value, body.data() + pos, body.size() - pos); if (n > 0) pos += static_cast<std::size_t>(n); else if (n < 0 && errno == EINTR) continue; else { ok = false; break; } }
