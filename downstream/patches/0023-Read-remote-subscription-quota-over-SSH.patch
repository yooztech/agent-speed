+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core;
+
+/// <summary>Credential-free observations partitioned by host UUID, SSH destination and provider.</summary>
+public sealed class RemoteQuotaStore
+{
+    private const int MaxSnapshotBytes = 524_288;
+    private readonly string root;
+
+    public RemoteQuotaStore(string? root = null) => this.root = root ?? Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota", "remote");
+
+    private static string DestinationKey(string destination) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(destination))).ToLowerInvariant();
+
+    private string SnapshotPath(string sourceId, string destination)
+    {
+        if (!QuotaProviders.TryRemoteSource(sourceId, out var hostId, out var provider)) throw new ArgumentOutOfRangeException(nameof(sourceId));
+        return Path.Combine(root, hostId.ToString("D"), DestinationKey(destination), provider + ".json");
+    }
+
+    public QuotaSnapshot? Read(string sourceId, string destination)
+    {
+        try
+        {
+            using var stream = new FileStream(SnapshotPath(sourceId, destination), FileMode.Open, FileAccess.Read, FileShare.Read);
+            if (stream.Length is <= 0 or > MaxSnapshotBytes) return null;
+            var bytes = new byte[(int)stream.Length];
+            stream.ReadExactly(bytes);
+            if (stream.ReadByte() != -1) return null;
+            var snapshot = JsonSerializer.Deserialize(bytes, QuotaSnapshotJsonContext.Default.QuotaSnapshot);
+            if (snapshot is not { ObservedAt: not null, Windows: not null, Status: QuotaStatus.Ok or QuotaStatus.Stale } ||
+                snapshot.Id != sourceId || snapshot.Windows.Count > 32 || snapshot.Windows.Any(window => window is null || string.IsNullOrEmpty(window.Id))) return null;
+            return snapshot with { Status = QuotaStatus.Stale, WaitingForRefresh = false };
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or JsonException or NotSupportedException or InvalidOperationException)
+        {
+            return null;
+        }
+    }
+
+    public void Save(string destination, QuotaSnapshot snapshot)
+    {
+        var path = SnapshotPath(snapshot.Id, destination);
+        if (snapshot.ObservedAt is null || snapshot.Status is not (QuotaStatus.Ok or QuotaStatus.Stale))
+        {
+            DeleteFile(path);
+            return;
+        }
+        var temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            var directory = Path.GetDirectoryName(path)!;
+            if (OperatingSystem.IsWindows()) Directory.CreateDirectory(directory);
+            else Directory.CreateDirectory(directory, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+            var options = new FileStreamOptions { Mode = FileMode.CreateNew, Access = FileAccess.Write, Share = FileShare.None };
+            if (!OperatingSystem.IsWindows()) options.UnixCreateMode = UnixFileMode.UserRead | UnixFileMode.UserWrite;
+            using (var stream = new FileStream(temporary, options))
+            {
+                JsonSerializer.Serialize(stream, snapshot, QuotaSnapshotJsonContext.Default.QuotaSnapshot);
+                if (stream.Length > MaxSnapshotBytes) return;
+                stream.Flush(flushToDisk: true);
+            }
+            File.Move(temporary, path, overwrite: true);
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        finally { DeleteFile(temporary); }
+    }
+
+    /// <summary>Run after readers are revoked; removed hosts and changed destinations cannot be restored later.</summary>
+    public void Reconcile(IReadOnlyDictionary<Guid, string> destinations)
+    {
+        try
+        {
+            if (!Directory.Exists(root)) return;
+            foreach (var hostDirectory in Directory.EnumerateDirectories(root))
+            {
+                if (!Guid.TryParseExact(Path.GetFileName(hostDirectory), "D", out var hostId)) continue;
+                if (!destinations.TryGetValue(hostId, out var destination))
+                {
+                    DeleteDirectory(hostDirectory);
+                    continue;
