+using System.Text.Json;
+using System.Text.Json.Nodes;
+using AgentSpeed.Core;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemoteQuotaTests
+{
+    [Fact]
+    public async Task RepliesAreCorrelatedAndParseSecondsNullableCreditsAndUnclampedUsage()
+    {
+        var commands = new List<string>();
+        using var session = new RemoteQuotaSession((line, _) => { commands.Add(line); return Task.FromResult(true); });
+        var codex = session.RequestAsync("codex", true, CancellationToken.None);
+        var go = session.RequestAsync("opencode-go", false, CancellationToken.None);
+        Assert.Equal(2, commands.Count);
+        using var command = JsonDocument.Parse(commands[1]);
+        Assert.False(command.RootElement.GetProperty("refresh").GetBoolean());
+        Assert.Equal(new[] { "opencode-go" }, command.RootElement.GetProperty("providers").EnumerateArray().Select(value => value.GetString()));
+        Assert.False(command.RootElement.TryGetProperty("credentials", out _));
+        Assert.True(session.Receive(Response(commands[1], "opencode-go")));
+        Assert.False(codex.IsCompleted);
+        var snapshot = await go;
+        Assert.Equal(QuotaStatus.Ok, snapshot.Status);
+        Assert.Equal(1.25, Assert.Single(snapshot.Windows).UsedFraction);
+        Assert.Equal(TimeSpan.FromDays(7), snapshot.Windows[0].Duration);
+        Assert.Null(snapshot.ResetCreditsAvailable);
+        Assert.Null(snapshot.AccountIdentity);
+        Assert.Equal(Observed, snapshot.ObservedAt);
+        Assert.True(session.Receive(Response(commands[0], "codex")));
+        Assert.Equal("codex", (await codex).Id);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task OptionalAccountIdentityPreservesLegacyAccountAndQuotaData(bool hasIdentity)
+    {
+        string command = "";
+        using var session = new RemoteQuotaSession((line, _) => { command = line; return Task.FromResult(true); });
+        var request = session.RequestAsync("codex", false, CancellationToken.None);
+        var response = JsonNode.Parse(Response(command, "codex"))!;
+        var row = response["snapshots"]![0]!;
+        row["account"] = null;
+        if (hasIdentity) row["accountIdentity"] = new JsonObject { ["id"] = "opaque-id", ["displayName"] = "Work" };
+        else row["accountIdentity"] = null;
+        row["resetCreditsAvailable"] = 2;
+        row["resetCreditsNextExpiry"] = "2026-11-16T12:00:00Z";
+        row["windows"]!.AsArray().Add(JsonNode.Parse("{\"id\":\"daily\",\"label\":\"Daily\",\"usedFraction\":0.5,\"resetAt\":\"2026-11-16T00:00:00Z\",\"duration\":86400}"));
+        Assert.True(session.Receive(response.ToJsonString()));
+        var snapshot = await request;
+        Assert.Null(snapshot.Account);
+        Assert.Equal(hasIdentity ? new QuotaAccountIdentity("opaque-id", "Work") : null, snapshot.AccountIdentity);
+        Assert.Equal(2, snapshot.Windows.Count);
+        Assert.Equal(1.25, snapshot.Windows[0].UsedFraction);
+        Assert.Equal(TimeSpan.FromDays(1), snapshot.Windows[1].Duration);
+        Assert.Equal(DateTimeOffset.Parse("2026-11-16T00:00:00Z"), snapshot.Windows[1].ResetAt);
+        Assert.Equal(2, snapshot.ResetCreditsAvailable);
+        Assert.Equal(DateTimeOffset.Parse("2026-11-16T12:00:00Z"), snapshot.ResetCreditsNextExpiry);
+        Assert.Equal(snapshot.AccountIdentity, (snapshot with { Id = "remote" }).AccountIdentity);
+    }
+
+    [Fact]
+    public async Task CancellationDisconnectAndTimeoutCannotAcceptLateReplies()
+    {
+        string command = "";
+        using var session = new RemoteQuotaSession((line, _) => { command = line; return Task.FromResult(true); });
+        using var consent = new CancellationTokenSource();
+        var cancelled = session.RequestAsync("codex", true, consent.Token);
+        var oldCommand = command;
+        consent.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => cancelled);
+        var current = session.RequestAsync("codex", true, CancellationToken.None);
+        Assert.True(session.Receive(Response(oldCommand, "codex")));
+        Assert.False(current.IsCompleted);
+        Assert.True(session.Receive(Response(command, "codex")));
+        await current;
+        var disconnected = session.RequestAsync("codex", true, CancellationToken.None);
+        session.Dispose();
+        await Assert.ThrowsAsync<IOException>(() => disconnected);
+        Assert.True(session.Receive(Response(command, "codex")));
+        using var oldCollector = new RemoteQuotaSession((_, _) => Task.FromResult(true), TimeSpan.FromMilliseconds(1));
+        await Assert.ThrowsAsync<TimeoutException>(() => oldCollector.RequestAsync("codex", true, CancellationToken.None));
+    }
+
+    [Fact]
+    public async Task AuthenticationRejectionStripsPreviousAccountFields()
+    {
+        string command = "";
+        using var session = new RemoteQuotaSession((line, _) => { command = line; return Task.FromResult(true); });
+        var request = session.RequestAsync("codex", true, CancellationToken.None);
+        var response = JsonNode.Parse(Response(command, "codex", "needsAuth"))!;
+        response["snapshots"]![0]!["accountIdentity"] = new JsonObject { ["id"] = "opaque-id", ["displayName"] = "Work" };
+        session.Receive(response.ToJsonString());
+        var rejected = await request;
+        Assert.Equal(QuotaStatus.NeedsAuth, rejected.Status);
+        Assert.Empty(rejected.Windows);
+        Assert.Null(rejected.ObservedAt);
+        Assert.Null(rejected.Account);
+        Assert.Null(rejected.Plan);
+        Assert.Null(rejected.Credits);
+        Assert.Null(rejected.AccountIdentity);
+    }
+
+    [Fact]
+    public async Task RemoteProviderScopesIdentityPreservesStaleTimestampAndRejectsRevokedResult()
+    {
+        var host = Guid.NewGuid();
+        var id = QuotaProviders.RemoteSourceId(host, "codex");
+        var completion = new TaskCompletionSource<QuotaSnapshot>(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var provider = new RemoteQuotaProvider(new(id, "Codex · Production", "CX", "Production · SSH"), (_, _) => completion.Task);
+        Assert.Null(provider.ReadCachedSnapshot().ObservedAt);
+        var refresh = provider.RefreshAsync();
+        completion.SetResult(Snapshot());
+        var observation = await refresh;
+        Assert.Equal(id, observation.Id);
+        Assert.Equal("codex", QuotaProviders.ProviderId(observation.Id));
+        Assert.Contains("Production", observation.DisplayName);
+        provider.Disconnected();
+        Assert.Equal(QuotaStatus.Stale, provider.ReadCachedSnapshot().Status);
+        Assert.Equal(Observed, provider.ReadCachedSnapshot().ObservedAt);
+
+        var late = new TaskCompletionSource<QuotaSnapshot>(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var revoked = new RemoteQuotaProvider(new(id, "Codex · Production", "CX", "Production · SSH"), (_, _) => late.Task);
+        var pending = revoked.RefreshAsync();
+        revoked.Cancel();
+        late.SetResult(Snapshot());
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => pending);
+        Assert.Null(revoked.ReadCachedSnapshot().ObservedAt);
+    }
+
+    [Fact]
+    public async Task TransportFailureRetainsObservationRatherThanRefreshingItsTimestamp()
+    {
+        var fail = false;
+        using var provider = new RemoteQuotaProvider(new(QuotaProviders.RemoteSourceId(Guid.NewGuid(), "codex"), "Codex · host", "CX", "host · SSH"),
+            (_, _) => fail ? Task.FromException<QuotaSnapshot>(new IOException("offline")) : Task.FromResult(Snapshot()));
+        await provider.RefreshAsync();
+        fail = true;
+        var stale = await provider.RefreshAsync();
+        Assert.Equal(QuotaStatus.Stale, stale.Status);
+        Assert.Equal(Observed, stale.ObservedAt);
+        Assert.Single(stale.Windows);
+    }
+
+    private static readonly DateTimeOffset Observed = new(2026, 11, 15, 0, 0, 0, TimeSpan.Zero);
+    private static QuotaSnapshot Snapshot() => new("codex", "Codex", "exact", QuotaStatus.Ok,
+        [new("weekly", "Weekly", 1.25, null, null, null, TimeSpan.FromDays(7))], "weekly", null, "account", "plus", Observed, "codex-cli", null, null, false);
+
+    private static string Response(string command, string provider, string status = "ok")
+    {
+        using var request = JsonDocument.Parse(command);
+        return JsonSerializer.Serialize(new { type = "quota", requestId = request.RootElement.GetProperty("requestId").GetString(), snapshots = new[] {
+            new { id = provider, displayName = "Provider", fidelity = "exact", status, windows = new[] {
+                new { id = "weekly", label = "Weekly", usedFraction = 1.25, remaining = (double?)null, used = (double?)null,
+                    resetAt = (string?)null, duration = 604800 } }, headlineId = "weekly", block = (string?)null, account = "account", plan = "plus",
+                observedAt = Observed, source = "remote credentials", credits = (object?)null, nextAllowedAt = (string?)null, waitingForRefresh = false,
+                resetCreditsAvailable = (int?)null, resetCreditsNextExpiry = (string?)null } } });
+    }
+}
