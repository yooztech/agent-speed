@@ -0,0 +1,101 @@
+namespace AgentSpeed.Core;
+
+/// <summary>A host-scoped observation reader; all supplier access remains in the collector.</summary>
+public sealed class RemoteQuotaProvider : IQuotaProvider
+{
+    private readonly object gate = new();
+    private readonly Func<bool, CancellationToken, Task<QuotaSnapshot>> request;
+    private readonly RemoteQuotaStore? store;
+    private readonly string? destination;
+    private QuotaProviderDefinition definition;
+    private QuotaSnapshot snapshot;
+    private CancellationTokenSource cancellation = new();
+    private int generation;
+    private bool disposed;
+
+    public RemoteQuotaProvider(QuotaProviderDefinition definition, Func<bool, CancellationToken, Task<QuotaSnapshot>> request,
+        RemoteQuotaStore? store = null, string? destination = null)
+    {
+        this.definition = definition;
+        this.request = request;
+        this.store = store;
+        this.destination = store is null ? null : destination ?? throw new ArgumentNullException(nameof(destination));
+        snapshot = store?.Read(definition.Id, this.destination!) is { } cached
+            ? cached with { DisplayName = definition.DisplayName, Source = definition.Source }
+            : new(definition.Id, definition.DisplayName, "unknown", QuotaStatus.Error, [], null,
+                "Waiting for remote collector", null, null, null, definition.Source, null, null, false);
+    }
+
+    public QuotaSnapshot ReadCachedSnapshot() { lock (gate) return snapshot; }
+    public Task<QuotaSnapshot> RefreshAsync() => ReadAsync(true);
+    public Task<QuotaSnapshot> RefreshStartupAsync() => ReadAsync(true);
+
+    private async Task<QuotaSnapshot> ReadAsync(bool refresh)
+    {
+        int current;
+        CancellationToken token;
+        lock (gate)
+        {
+            ObjectDisposedException.ThrowIf(disposed, this);
+            current = generation;
+            token = cancellation.Token;
+        }
+        QuotaSnapshot result;
+        try { result = await request(refresh, token).ConfigureAwait(false); }
+        catch (Exception error) when (error is IOException or TimeoutException or ObjectDisposedException)
+        {
+            lock (gate)
+                result = snapshot with { Status = snapshot.ObservedAt.HasValue ? QuotaStatus.Stale : QuotaStatus.Error,
+                    Block = error.Message, WaitingForRefresh = false };
+        }
+        lock (gate)
+        {
+            token.ThrowIfCancellationRequested();
+            if (disposed || generation != current) throw new OperationCanceledException();
+            snapshot = result with { Id = definition.Id, DisplayName = definition.DisplayName,
+                Source = string.IsNullOrEmpty(result.Source) ? definition.Source : result.Source.StartsWith(definition.Source, StringComparison.Ordinal)
+                    ? result.Source : $"{definition.Source} · {result.Source}" };
+            store?.Save(destination!, snapshot);
+            return snapshot;
+        }
+    }
+
+    public void UpdateDefinition(QuotaProviderDefinition value)
+    {
+        lock (gate)
+        {
+            definition = value;
+            snapshot = snapshot with { DisplayName = value.DisplayName, Source = value.Source };
+        }
+    }
+
+    public void Disconnected(string? reason = null)
+    {
+        Cancel();
+        lock (gate) snapshot = snapshot with { Status = snapshot.ObservedAt.HasValue ? QuotaStatus.Stale : QuotaStatus.Error,
+            Block = reason ?? "Remote collector disconnected", WaitingForRefresh = false };
+    }
+
+    public void Cancel()
+    {
+        lock (gate)
+        {
+            generation++;
+            cancellation.Cancel();
+            cancellation.Dispose();
+            cancellation = new();
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (gate)
+        {
+            if (disposed) return;
+            disposed = true;
+            generation++;
+            cancellation.Cancel();
+            cancellation.Dispose();
+        }
+    }
+}
