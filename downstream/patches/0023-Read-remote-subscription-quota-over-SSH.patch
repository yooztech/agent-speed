@@ -0,0 +1,20 @@
+using AgentSpeed.Core;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Local providers and enabled SSH hosts share one subscription source list.</summary>
+public static class QuotaSources
+{
+    public static IReadOnlyList<QuotaProviderDefinition> Available(AppSettings settings) =>
+        QuotaProviders.Supported.Concat(settings.RemoteHosts.Where(host => host.Enabled).SelectMany(host =>
+            QuotaProviders.Supported.Select(provider => provider with
+            {
+                Id = QuotaProviders.RemoteSourceId(host.Id, provider.Id),
+                DisplayName = $"{provider.DisplayName} · {host.DisplayName(settings.RemoteHosts)}",
+                Source = $"{host.DisplayName(settings.RemoteHosts)} · SSH · {host.Destination}"
+            }))).ToArray();
+
+    public static string[] Selected(AppSettings settings) => Available(settings)
+        .Where(provider => settings.QuotaAllSources || settings.QuotaSources.Contains(provider.Id, StringComparer.Ordinal))
+        .Select(provider => provider.Id).ToArray();
+}
