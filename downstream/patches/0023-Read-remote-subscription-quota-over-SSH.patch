+int privateDirectory(int parent, const char* name) {
+    if (mkdirat(parent, name, 0700) && errno != EEXIST) return -1;
+    int fd = openat(parent, name, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW); struct stat st{};
