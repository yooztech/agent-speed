@@ -0,0 +1,105 @@
+using AgentSpeed.Core;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemoteQuotaPersistenceTests
+{
+    [Fact]
+    public async Task NewOfflineReaderHydratesStructuredObservationWithoutRequestOrTimestampAdvance()
+    {
+        using var fixture = new Fixture();
+        using (var online = fixture.Reader((_, _) => Task.FromResult(Observation()))) await online.RefreshAsync();
+        var requests = 0;
+        using var offline = fixture.Reader((_, _) => { requests++; throw new InvalidOperationException("Offline hydration must not request remote data"); });
+        var snapshot = offline.ReadCachedSnapshot();
+        Assert.Equal(0, requests);
+        Assert.Equal(fixture.Definition.Id, snapshot.Id);
+        Assert.Equal("Codex · Build", snapshot.DisplayName);
+        Assert.Equal(QuotaStatus.Stale, snapshot.Status);
+        Assert.Equal(Observed, snapshot.ObservedAt);
+        Assert.Equal(.75, Assert.Single(snapshot.Windows).UsedFraction);
+        Assert.Equal("account-label", snapshot.Account);
+        Assert.Equal("Build · SSH", snapshot.Source);
+        Assert.False(snapshot.WaitingForRefresh);
+        var files = Directory.GetFiles(fixture.Root, "*", SearchOption.AllDirectories);
+        Assert.Single(files);
+        Assert.EndsWith("codex.json", files[0]);
+        Assert.DoesNotContain("destination-original", File.ReadAllText(files[0]), StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task DestinationChangeAndHostRemovalPurgeOldReadingsAcrossReaderLifetimes()
+    {
+        using var fixture = new Fixture();
+        using (var original = fixture.Reader((_, _) => Task.FromResult(Observation()))) await original.RefreshAsync();
+        Assert.Null(fixture.Store.Read(fixture.Definition.Id, "destination-new"));
+        fixture.Store.Reconcile(new Dictionary<Guid, string> { [fixture.HostId] = "destination-new" });
+        Assert.Null(fixture.Store.Read(fixture.Definition.Id, fixture.Destination));
+        using (var changed = fixture.Reader((_, _) => Task.FromResult(Observation()), "destination-new"))
+        {
+            Assert.Null(changed.ReadCachedSnapshot().ObservedAt);
+            await changed.RefreshAsync();
+        }
+        Assert.NotNull(fixture.Store.Read(fixture.Definition.Id, "destination-new"));
+        fixture.Store.Reconcile(new Dictionary<Guid, string>());
+        using var restoredHost = fixture.Reader((_, _) => throw new InvalidOperationException(), "destination-new");
+        Assert.Null(restoredHost.ReadCachedSnapshot().ObservedAt);
+        Assert.Empty(Directory.GetFiles(fixture.Root, "*", SearchOption.AllDirectories));
+    }
+
+    [Theory]
+    [InlineData(QuotaStatus.NeedsAuth)]
+    [InlineData(QuotaStatus.AccessDenied)]
+    public async Task AuthenticationRejectionRemovesPreviousAccountFromDisk(QuotaStatus status)
+    {
+        using var fixture = new Fixture();
+        var reject = false;
+        using var reader = fixture.Reader((_, _) => Task.FromResult(reject
+            ? Observation() with { Status = status, ObservedAt = null, Windows = [], Account = null, Plan = null }
+            : Observation()));
+        await reader.RefreshAsync();
+        Assert.NotNull(fixture.Store.Read(fixture.Definition.Id, fixture.Destination));
+        reject = true;
+        await reader.RefreshAsync();
+        using var restarted = fixture.Reader((_, _) => throw new InvalidOperationException());
+        Assert.Null(restarted.ReadCachedSnapshot().ObservedAt);
+        Assert.Null(restarted.ReadCachedSnapshot().Account);
+        Assert.Empty(Directory.GetFiles(fixture.Root, "*", SearchOption.AllDirectories));
+    }
+
+    [Fact]
+    public async Task RevokedLateResultCannotRecreateDeletedHostCache()
+    {
+        using var fixture = new Fixture();
+        var completion = new TaskCompletionSource<QuotaSnapshot>(TaskCreationOptions.RunContinuationsAsynchronously);
+        var reader = fixture.Reader((_, _) => completion.Task);
+        var request = reader.RefreshAsync();
+        reader.Dispose();
+        fixture.Store.Reconcile(new Dictionary<Guid, string>());
+        completion.SetResult(Observation());
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => request);
+        Assert.Null(fixture.Store.Read(fixture.Definition.Id, fixture.Destination));
+    }
+
+    private static readonly DateTimeOffset Observed = new(2026, 11, 15, 1, 0, 0, TimeSpan.Zero);
+    private static QuotaSnapshot Observation() => new("codex", "Codex", "exact", QuotaStatus.Ok,
+        [new("weekly", "Weekly", .75, null, null, Observed.AddDays(7), TimeSpan.FromDays(7))], "weekly", null,
+        "account-label", "plus", Observed, "codex-cli", null, null, false);
+
+    private sealed class Fixture : IDisposable
+    {
+        public string Root { get; } = Path.Combine(Path.GetTempPath(), "remote-quota-store-" + Guid.NewGuid().ToString("N"));
+        public Guid HostId { get; } = Guid.NewGuid();
+        public string Destination => "destination-original";
+        public RemoteQuotaStore Store { get; }
+        public QuotaProviderDefinition Definition { get; }
+        public Fixture()
+        {
+            Store = new(Root);
+            Definition = new(QuotaProviders.RemoteSourceId(HostId, "codex"), "Codex · Build", "CX", "Build · SSH");
+        }
+        public RemoteQuotaProvider Reader(Func<bool, CancellationToken, Task<QuotaSnapshot>> request, string? destination = null) =>
+            new(Definition, request, Store, destination ?? Destination);
+        public void Dispose() { if (Directory.Exists(Root)) Directory.Delete(Root, recursive: true); }
+    }
+}
