+@MainActor
+private final class RemoteQuotaFixture {
+    struct Command: Decodable, Sendable {
+        let type: String
+        let requestId: String
+        let providers: [String]
+        let refresh: Bool
+    }
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let transport: RemoteQuotaTransport
+    let controller: QuotaController
+    let commands: AsyncStream<Command>
+    private let events: AsyncStream<Command>.Continuation
+    private(set) var sent = 0
+    let host = RemoteHost(id: UUID(uuidString: "55AB9F50-1B94-4672-A6FD-55C246EC6383")!, label: "build", destination: "user@build", enabled: true)
+    let connection = UUID()
+
+    init() {
+        defaults = UserDefaults(suiteName: suite)!
+        defaults.set(false, forKey: "quota.autoRefreshEnabled")
+        transport = RemoteQuotaTransport(defaults: defaults)
+        controller = QuotaController(defaults: defaults, providers: [])
+        let stream = AsyncStream<Command>.makeStream()
+        commands = stream.stream
+        events = stream.continuation
+        transport.send = { [weak self] _, data in
+            guard let self, let command = try? JSONDecoder().decode(Command.self, from: data) else { return false }
+            self.sent += 1
+            self.events.yield(command)
+            return true
+        }
+        transport.onChange = { [weak self] changed in
+            guard let self else { return }
+            self.controller.updateRemoteSources(self.transport, changedHosts: changed)
+        }
+        controller.updateRemoteSources(transport)
+    }
+
+    var codex: String { QuotaSourceIdentity.remote(hostID: host.id, providerID: "codex") }
+    var go: String { QuotaSourceIdentity.remote(hostID: host.id, providerID: "opencode-go") }
+
+    func connect() { transport.configure(hosts: [host], connections: [host.id: connection]) }
+    func next() async throws -> Command {
+        var iterator = commands.makeAsyncIterator()
+        return try #require(await iterator.next())
+    }
+    func response(_ command: Command, status: QuotaStatus = .ok, fraction: Double = 0.25) throws -> RemoteQuotaResponse {
+        let snapshot = QuotaSnapshot(id: command.providers[0], displayName: command.providers[0] == "codex" ? "Codex" : "OpenCode Go",
+            fidelity: "official", status: status,
+            windows: status == .needsAuth ? [] : [QuotaWindow(id: "five", label: "", usedFraction: fraction, remaining: nil, used: nil, resetAt: nil, duration: 18_000)],
+            headlineId: status == .needsAuth ? nil : "five", block: nil, account: status == .needsAuth ? nil : "same@example.test", plan: nil,
+            observedAt: status == .needsAuth ? nil : Date(timeIntervalSince1970: 1_800_000_000), source: "official", credits: nil,
+            nextAllowedAt: nil, waitingForRefresh: false)
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        let snapshots = String(decoding: try encoder.encode([snapshot]), as: UTF8.self)
+        return try #require(RemoteQuotaResponse.decode(Data("{\"type\":\"quota\",\"requestId\":\"\(command.requestId)\",\"snapshots\":\(snapshots)}".utf8)))
+    }
+    func close() async {
+        controller.setNetworkEnabled(false)
+        controller.enabledProviderIDs = []
+        transport.configure(hosts: [], connections: [:])
+        await controller.operationBarrier().value
+        events.finish()
+        defaults.removePersistentDomain(forName: suite)
+    }
+}
