@@ -0,0 +1,25 @@
+import Foundation
+
+struct RemoteHost: Codable, Identifiable, Equatable {
+    var id: UUID = UUID()
+    var label: String
+    var destination: String
+    var enabled: Bool = false
+
+    // A destination is passed as one ssh argument, never interpolated into a shell command.
+    var validDestination: Bool {
+        !destination.isEmpty && !destination.hasPrefix("-") &&
+            destination.unicodeScalars.allSatisfy { CharacterSet.alphanumerics.union(CharacterSet(charactersIn: "._-@:")).contains($0) }
+    }
+}
+
+extension RemoteHost {
+    /// Labels need not be unique. Add the connection target, then the stable ID only when still ambiguous.
+    func displayName(in hosts: [RemoteHost]) -> String {
+        let name = label.isEmpty ? destination : label
+        guard hosts.filter({ ($0.label.isEmpty ? $0.destination : $0.label) == name }).count > 1 else { return name }
+        let targetName = label.isEmpty ? destination : "\(label) · \(destination)"
+        let ambiguous = hosts.filter { ($0.label.isEmpty ? $0.destination : "\($0.label) · \($0.destination)") == targetName }.count > 1
+        return ambiguous ? "\(targetName) · \(id.uuidString)" : targetName
+    }
+}
