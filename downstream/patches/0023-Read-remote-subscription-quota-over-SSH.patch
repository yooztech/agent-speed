+std::vector<std::pair<std::uint64_t, std::string>> replies(q::Service& service, std::size_t count) {
+    std::vector<std::pair<std::uint64_t, std::string>> out;
+    auto end = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+    while (out.size() < count && std::chrono::steady_clock::now() < end) {
+        auto batch = service.replies(); for (auto& item : batch) out.push_back(std::move(item));
+        std::this_thread::yield();
+    }
