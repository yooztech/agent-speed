@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Exercise release version parsing without requiring macOS build tools."""
+import plistlib
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class ReleaseVersionTests(unittest.TestCase):
+    def parse(self, *args):
+        script = (ROOT / "macos/scripts/build-app.sh").read_text()
+        script = script.split('[[ "$(uname -s)" == "Darwin" ]]', 1)[0]
+        script += "\nprintf '%s\\n' \"$VERSION|$NUMERIC_VERSION|$BUILD_NUMBER\"\n"
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            path = root / "macos/scripts/build-app.sh"
+            path.parent.mkdir(parents=True)
+            path.write_text(script)
+            (root / "VERSION").write_text((ROOT / "VERSION").read_text())
+            return subprocess.run(["bash", str(path), *args], text=True, capture_output=True)
+
+    def test_fork_default_and_numeric_bundle_versions(self):
+        result = self.parse()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout.strip(), "1.6.1-fork.3|1.6.1|1.6.1")
+        template = (ROOT / "macos/Resources/Info.plist").read_text()
+        info = plistlib.loads(template.replace("__VERSION__", "1.6.1-fork.3")
+                              .replace("__NUMERIC_VERSION__", "1.6.1")
+                              .replace("__BUILD__", "1.6.1").encode())
+        self.assertEqual(info["AgentSpeedVersion"], "1.6.1-fork.3")
+        self.assertEqual(info["CFBundleShortVersionString"], "1.6.1")
+        self.assertEqual(info["CFBundleVersion"], "1.6.1")
+
+    def test_explicit_version_and_build(self):
+        result = self.parse("--version", "v2.3.4-rc.1", "--build", "42")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout.strip(), "2.3.4-rc.1|2.3.4|42")
+
+    def test_rejects_invalid_versions_and_builds(self):
+        for args in (("--version", "1.6.1-"), ("--version", "1.6.1-x/y"),
+                     ("--build", "1.6.1-fork.1")):
+            with self.subTest(args=args):
+                self.assertNotEqual(self.parse(*args).returncode, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
