+        let changed = first.snapshot
+        #expect(changed.live.output == 27 && changed.today.output == 27)
+        #expect(Set(changed.sourceInstances.compactMap(\.hostID)) == Set([b.id, other.id]))
+        #expect(Set(changed.agents.compactMap(\.hostID)) == Set([b.id, other.id]))
+        #expect(TodayCostSummary(model: model, snapshot: changed).total.costMicroUsd == 27)
+        #expect(changed.history.first?.measured.output == 27)
+        #expect(!changed.peakTodayAvailable && changed.averageToday == nil)
+        #expect(second.snapshot.live.output == 5)
+        #expect(global.snapshot == globalSnapshot)
+        #expect(model.snapshot == globalSnapshot)
+        #expect(first.feed !== second.feed && first.feed !== global.feed)
