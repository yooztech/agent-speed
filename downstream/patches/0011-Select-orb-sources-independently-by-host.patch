+         "timezone":"\(TimeZone.current.identifier)","sources":[{"source":"\(source)","enabled":true,
+         "available":true,"sessions":1,"active_agents":1,"live_output":\(value),"live_total":\(value),
+         "today_input":0,"today_output":\(value),"today_requests":1,"today_cached_input":0,
+         "today_cache_write_input":0,"today_reasoning":0,"today_cost_micro_usd":\(value),"unpriced_requests":0}],
