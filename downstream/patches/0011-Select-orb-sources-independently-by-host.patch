@@ -0,0 +1,56 @@
+using System.Collections.Immutable;
+using AgentSpeed.Core;
+using AgentSpeed.Core.Traffic;
+
+namespace AgentSpeed.Presentation.Orb;
+
+/// <summary>A dashboard is explicitly global or bound to one visible orb; a missing binding never becomes global.</summary>
+public sealed class OrbDashboardContext
+{
+    public string? OrbId { get; set; }
+
+    private readonly OrbFeed _globalFeed = new("global-dashboard");
+    private ImmutableArray<OrbSourceInstance> _globalExclusions = [];
+    private double _now;
+
+    public IReadOnlyList<OrbSourceInstance> GlobalExcludedSources => _globalFeed.ExcludedSources;
+
+    public void ConfigureGlobal(ImmutableArray<OrbSourceInstance> exclusions, SpeedMetric metric, double redline, double now)
+    {
+        _now = now;
+        if (_globalExclusions == exclusions && _globalFeed.Metric == metric && _globalFeed.Redline == redline) return;
+        _globalExclusions = exclusions;
+        _globalFeed.Configure(null, metric, redline, (long)(now * 1000), exclusions: exclusions);
+    }
+
+    public bool TryResolve(SpeedSnapshot snapshot, Func<string, OrbFeed?> findFeed,
+        out SpeedSnapshot view, out OrbFeed? feed)
+    {
+        feed = OrbId is { } id ? findFeed(id) : GlobalExcludedSources.Count == 0 ? null : _globalFeed;
+        if (OrbId is not null && feed is null)
+        {
+            view = SpeedSnapshot.Empty;
+            return false;
+        }
+        if (ReferenceEquals(feed, _globalFeed)) _globalFeed.Update(snapshot, _now);
+        view = feed is null ? snapshot : OrbSubset.Project(snapshot, feed.Sources, feed.ExcludedSources);
+        return true;
+    }
+
+    /// <summary>Filter attributed rows and agent suffixes; the machine totals and machine chart stay machine-wide.</summary>
+    public TrafficSnapshot ProjectTraffic(TrafficSnapshot traffic, SpeedSnapshot view)
+    {
+        if (OrbId is null && GlobalExcludedSources.Count == 0) return traffic;
+        var sources = view.Sources.Select(s => new OrbSourceInstance(s.HostId, s.Kind)).ToHashSet();
+        var agents = view.Agents.Select(a => a.Id).ToHashSet(StringComparer.Ordinal);
+        TrafficSnapshot Filter(TrafficSnapshot snapshot, Guid? hostId) => snapshot with
+        {
+            Sources = snapshot.Sources.Where(pair => sources.Contains(new OrbSourceInstance(hostId, pair.Key)))
+                .ToDictionary(pair => pair.Key, pair => pair.Value),
+            SourceHistory = snapshot.SourceHistory.Where(pair => sources.Contains(new OrbSourceInstance(hostId, pair.Key)))
+                .ToDictionary(pair => pair.Key, pair => pair.Value),
+            Agents = snapshot.Agents.Where(pair => agents.Contains(pair.Key)).ToDictionary(pair => pair.Key, pair => pair.Value),
+        };
+        return Filter(traffic, null);
+    }
+}
