+import Foundation
+import Testing
+@testable import AgentSpeedCore
+
+@Suite("Orb instance dashboard projection")
+struct OrbInstanceProjectionTests {
+    private let a = UUID(uuidString: "00000000-0000-0000-0000-000000000001")!
+    private let b = UUID(uuidString: "00000000-0000-0000-0000-000000000002")!
+    private let other = UUID(uuidString: "00000000-0000-0000-0000-000000000003")!
+
+    private func source(_ kind: SourceKind = .codex, _ value: Int) -> SourceStatus {
+        SourceStatus(kind: kind, enabled: true, rootPath: "fixture", available: true, sessionCount: 1,
+                     live: Rate(output: Double(value), total: Double(value * 2)),
+                     today: TokenTotals(requests: 1, output: value), activeAgents: 1,
+                     liveCost: LiveCost(microUsdPerSecond: Double(value), knownOutput: Double(value)),
+                     todayCost: CostTally(costMicroUsd: Int64(value)))
+    }
+
+    private func agent(_ id: String, host: UUID?, source: SourceKind = .codex, parent: String? = nil) -> AgentStatus {
+        var agent = AgentStatus(id: id, source: source, project: "fixture", model: nil, phase: .generating,
+                                isSubagent: parent != nil, live: .zero, recentSpeed: nil,
+                                lastActivity: Date(timeIntervalSince1970: 100), parentId: parent)
+        agent.hostID = host
+        return agent
+    }
+
+    private var fixture: SpeedSnapshot {
+        var snapshot = SpeedSnapshot.empty
+        snapshot.state = .running
+        snapshot.timestamp = Date(timeIntervalSince1970: 100)
+        snapshot.live = Rate(output: 999, total: 999)
+        snapshot.today = TokenTotals(requests: 999, output: 999)
+        snapshot.peakToday = Rate(output: 999, total: 999)
+        snapshot.history = [HistoryPoint(time: Date(timeIntervalSince1970: 99), measured: Rate(output: 999), estimated: .zero)]
+        snapshot.sources = [source(.codex, 999)]
+        let first = SourceInstance(hostID: a, status: source(.codex, 10), machineID: "same-machine")
+        snapshot.sourceInstances = [SourceInstance(hostID: nil, status: source(.codex, 5)), first, first,
+            SourceInstance(hostID: b, status: source(.codex, 20), machineID: "same-machine"),
+            SourceInstance(hostID: other, status: source(.omp, 7), machineID: "other-machine")]
+        snapshot.agents = [agent("local", host: nil), agent("a", host: a), agent("b", host: b, parent: "a"),
+                           agent("other", host: other, source: .omp)]
+        return snapshot
+    }
+
+    @Test func selectionFiltersBeforeMachineDeduplicationAndClearsExcludedParents() {
+        let snapshot = fixture
+        let all = OrbSubset.instanceSnapshot(snapshot, sources: nil, excluded: [])
+        #expect(all.live.output == 22)
+        #expect(all.today.output == 22)
+        #expect(all.sourceInstances.map(\.hostID) == [nil, a, other])
+        #expect(all.agents.map(\.id) == ["local", "a", "other"])
+        #expect(OrbSubset.instanceCost(snapshot, sources: nil, excluded: [], billable: .everything).today.costMicroUsd == 22)
+
+        let excluded = [OrbSourceExclusion(hostID: nil, source: "codex"), OrbSourceExclusion(hostID: a, source: "codex")]
+        // Deliberately reuse exactly the same snapshot; there is no engine tick after changing the selection.
