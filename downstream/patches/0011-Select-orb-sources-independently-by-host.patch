+        snapshot.today = TokenTotals(requests: 1, output: 5)
+        snapshot.sources = [SourceStatus(kind: .codex, enabled: true, rootPath: "fixture", available: true,
+            sessionCount: 1, live: snapshot.live, today: snapshot.today, activeAgents: 1,
+            liveCost: LiveCost(microUsdPerSecond: 5, knownOutput: 5), todayCost: CostTally(costMicroUsd: 5))]
+        snapshot.agents = [AgentStatus(id: "local", source: .codex, project: "fixture", model: nil, phase: .generating,
+            isSubagent: false, live: snapshot.live, recentSpeed: nil, lastActivity: snapshot.timestamp)]
+        snapshot.history = [HistoryPoint(time: Date(timeIntervalSince1970: 99), measured: Rate(output: 999), estimated: .zero)]
+        return snapshot
+    }
+
+    @Test func existingContextsImmediatelyReprojectWithoutAnotherSnapshotAndStayIsolated() throws {
+        // Match main.swift: activation installs the application appearance observer synchronously.
+        _ = NSApplication.shared
+        let suite = "OrbDashboardContextTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let a = RemoteHost(label: "Server", destination: "primary", enabled: true)
+        let b = RemoteHost(label: "Server", destination: "alternate", enabled: true)
+        let other = RemoteHost(label: "Other", destination: "other", enabled: true)
+        defaults.set(try JSONEncoder().encode([a, b, other]), forKey: "remoteHosts.v1")
+        defaults.set(OrbsDocument(orbs: [OrbConfig(id: "first"), OrbConfig(id: "second", sources: .explicit([.codex]),
+            excludedSources: [OrbSourceExclusion(hostID: a.id, source: "codex"), OrbSourceExclusion(hostID: b.id, source: "codex")])]).data(), forKey: OrbsController.documentKey)
+        let hosts = RemoteHosts(defaults: defaults, states: [a.id: try state(machine: "same", source: "codex", value: 10, time: 100000),
+            b.id: try state(machine: "same", source: "codex", value: 20, time: 99000),
+            other.id: try state(machine: "other", source: "omp", value: 7, time: 100000)])
+        let model = AppModel(settings: AppSettings(defaults: defaults), remoteHosts: hosts)
+        model.activate(live: false)
+        defer { model.shutdown() }
+        model.store.publishLive(local())
+        let global = DashboardContext(model: model)
+        let first = DashboardContext(model: model, orbID: "first")
+        let second = DashboardContext(model: model, orbID: "second")
+        let globalSnapshot = global.snapshot
+        #expect(first.snapshot.live.output == 22)
+        #expect(second.snapshot.live.output == 5)
+        #expect(first.snapshot.sourceInstances.count == 3)
+        #expect(model.orbSnapshot.sourceInstances.contains { $0.hostID == b.id })
+        #expect(orbSourceKinds(hostID: b.id, instances: model.orbSnapshot.sourceInstances, excluded: []).contains(.codex))
+
+        // All assertions below reuse the same published sample; no collector update is allowed to rescue the view.
