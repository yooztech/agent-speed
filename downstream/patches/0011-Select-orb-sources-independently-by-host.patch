@@ -0,0 +1,26 @@
+import Foundation
+
+/// The global popup's own host/source selection. Empty exclusions preserve the existing all-source projection;
+/// this value never changes monitoring, an orb's configuration or the independent Usage History window.
+public struct DashboardSources: Codable, Equatable, Sendable {
+    public private(set) var excluded: [OrbSourceExclusion]
+
+    public init(excluded: [OrbSourceExclusion] = []) {
+        self.excluded = excluded
+    }
+
+    public func isEnabled(hostID: UUID?, source: SourceKind) -> Bool {
+        OrbSubset.includes(hostID: hostID, source: source, sources: nil, excluded: excluded)
+    }
+
+    public mutating func setEnabled(_ enabled: Bool, hostID: UUID?, source: SourceKind) {
+        let key = OrbSourceExclusion(hostID: hostID, source: source.rawValue)
+        if enabled { excluded.removeAll { $0 == key } }
+        else if !excluded.contains(key) { excluded.append(key) }
+    }
+
+    public func snapshot(_ global: SpeedSnapshot, candidates: SpeedSnapshot, unknownHosts: [UUID] = []) -> SpeedSnapshot {
+        guard !excluded.isEmpty else { return global }
+        return OrbSubset.instanceSnapshot(candidates, sources: nil, excluded: excluded, unknownHosts: unknownHosts)
+    }
+}
