+import Foundation
+
+/// Keeps the live chart's accounting separate for every connection/source, including alternates. Selection-only
+/// changes project these existing samples; they never rewrite old aggregate samples as if they belonged to a subset.
+public struct OrbInstanceHistory: Sendable {
+    private var histories: [OrbSourceExclusion: CombinedLiveHistory] = [:]
+    private var identities: [OrbSourceExclusion: String] = [:]
+
+    public init() {}
+
+    public mutating func record(_ snapshot: SpeedSnapshot) {
+        let keys = Set(snapshot.sourceInstances.map { OrbSourceExclusion(hostID: $0.hostID, source: $0.status.kind.rawValue) })
+        histories = histories.filter { keys.contains($0.key) }
+        identities = identities.filter { keys.contains($0.key) }
+        var seen = Set<OrbSourceExclusion>()
+        for instance in snapshot.sourceInstances {
+            let key = OrbSourceExclusion(hostID: instance.hostID, source: instance.status.kind.rawValue)
+            guard seen.insert(key).inserted else { continue }
+            let identity = instance.machineID ?? instance.hostID?.uuidString ?? "local"
+            if identities[key] != identity {
+                histories[key] = CombinedLiveHistory()
+                identities[key] = identity
+            }
+            var sample = SpeedSnapshot.empty
+            sample.timestamp = snapshot.timestamp
+            sample.live = instance.status.live
+            sample.liveEstimatedShare = sample.live.output > 0 ? instance.status.liveEstimated.output / sample.live.output : 0
+            sample.liveRateAvailable = instance.status.liveRateAvailable
+            _ = histories[key, default: CombinedLiveHistory()].record(snapshot: sample)
+        }
+    }
+
+    public func attaching(to snapshot: SpeedSnapshot) -> SpeedSnapshot {
+        var result = snapshot
+        for index in result.sourceInstances.indices {
+            let instance = result.sourceInstances[index]
+            let key = OrbSourceExclusion(hostID: instance.hostID, source: instance.status.kind.rawValue)
+            let identity = instance.machineID ?? instance.hostID?.uuidString ?? "local"
+            result.sourceInstances[index].history = identities[key] == identity ? histories[key]?.points : nil
+        }
+        return result
+    }
+}
