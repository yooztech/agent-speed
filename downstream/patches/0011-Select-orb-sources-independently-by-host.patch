+        let duplicate = RemoteHost(label: "Same", destination: "a")
+        let hosts = [a, b, duplicate]
+        #expect(a.displayName(in: hosts).contains(a.destination))
+        #expect(a.displayName(in: hosts) != b.displayName(in: hosts))
+        #expect(a.displayName(in: hosts) != duplicate.displayName(in: hosts))
+        #expect(a.displayName(in: hosts).contains(a.id.uuidString))
+        let suite = "OrbDashboardUnknown.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let model = AppModel(settings: AppSettings(defaults: defaults))
+        var snapshot = local()
