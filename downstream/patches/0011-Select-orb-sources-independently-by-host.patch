+    @Test func globalPopupOwnSelectionPersistsAndImmediatelyUpdatesWithoutChangingOrbsOrMonitoring() throws {
+        _ = NSApplication.shared
+        let suite = "GlobalDashboardContextTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let a = RemoteHost(label: "Code", destination: "primary", enabled: true)
+        let b = RemoteHost(label: "Code", destination: "alternate", enabled: true)
