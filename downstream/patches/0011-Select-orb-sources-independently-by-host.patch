+/// Unseen remote hosts may contain any source, so all kinds must be available for exclusion.
+func orbSourceKinds(hostID: UUID?, instances: [SourceInstance], excluded: [OrbSourceExclusion]) -> [SourceKind] {
+    let unseenRemote = hostID != nil && !instances.contains { $0.hostID == hostID }
+    return SourceKind.allCases.filter { kind in
+        unseenRemote || excluded.contains(OrbSourceExclusion(hostID: hostID, source: kind.rawValue)) ||
+        instances.contains { $0.hostID == hostID && $0.status.kind == kind && ($0.status.producedToday || $0.status.today.requests > 0 || $0.status.activeAgents > 0) }
+    }
