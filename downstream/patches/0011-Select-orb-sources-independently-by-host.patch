+        model.orbs.setSourceEnabled(false, hostID: b.id, source: .codex, of: "first")
+        #expect(first.snapshot.live.output == 7)
+        #expect(model.orbs.orb("first")?.excludedSources.contains(OrbSourceExclusion(hostID: other.id, source: "omp")) == false)
+        model.orbs.setVisible(false, of: "first")
+        #expect(!first.isAvailable && second.isAvailable && global.isAvailable)
