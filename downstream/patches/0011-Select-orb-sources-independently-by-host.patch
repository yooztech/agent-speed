+        #expect(TodayCostSummary(model: model, snapshot: snapshot).amountText == "–")
+        var connected = a
+        connected.enabled = true
+        let traffic = TrafficSnapshot(timestamp: snapshot.timestamp, enabled: true, processState: .standby)
+        let rows = TrafficSection.rows(traffic,
+            instances: [SourceInstance(hostID: connected.id, status: snapshot.sources[0])],
+            hosts: [connected], states: [:], enabled: SourceSet(.codex), includeTools: true, preserveUnknown: true)
+        #expect(rows.count == 2)
+        #expect(rows.allSatisfy { !$0.hasToday && $0.traffic.live(includeTools: true) == nil })
