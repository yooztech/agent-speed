+++ b/macos/Sources/AgentSpeed/Dashboard/DashboardContext.swift
@@ -0,0 +1,54 @@
+import AgentSpeedCore
+import AgentSpeedOrbModel
+import SwiftUI
+
+/// The popover's origin is immutable. Its projection reads the current orb configuration, not a copy captured
+/// when the popover opened, so changing sources immediately updates every section without another sample.
+@MainActor
+final class DashboardContext {
+    let model: AppModel
+    let orbID: String?
+    private let missingFeed = OrbFeed()
+
+    init(model: AppModel, orbID: String? = nil) {
+        self.model = model
+        self.orbID = orbID
+    }
+
+    var isAvailable: Bool {
+        guard let orbID else { return true }
+        return model.orbs.shownOrbs.contains { $0.id == orbID }
+    }
+
+    var snapshot: SpeedSnapshot {
+        guard let orbID else { return model.dashboardSnapshot }
+        guard let orb = model.orbs.orb(orbID) else {
+            var missing = SpeedSnapshot.empty
+            missing.liveRateAvailable = false
+            missing.liveCostRateAvailable = false
+            missing.todayAvailable = false
+            missing.peakTodayAvailable = false
+            return missing
+        }
+        return OrbSubset.instanceSnapshot(model.orbSnapshot, sources: orb.sources.sourceSet,
+                                           excluded: orb.excludedSources, unknownHosts: model.unknownOrbHosts)
+    }
+
+    var feed: OrbFeed {
+        guard let orbID else {
+            return model.settings.dashboardSources.excluded.isEmpty ? model.mainFeed : model.dashboardFeed
+        }
+        guard let runtime = model.orbs.runtime(orbID) else { return missingFeed }
+        return runtime.feed
+    }
+
+    func hostName(_ hostID: UUID?) -> String {
+        guard let hostID else { return model.l10n("orbs.sources.local") }
+        return model.remoteHosts.hosts.first { $0.id == hostID }?.displayName(in: model.remoteHosts.hosts) ?? hostID.uuidString
+    }
+
+}
+
+extension EnvironmentValues {
+    @Entry var dashboardContext: DashboardContext?
+}
