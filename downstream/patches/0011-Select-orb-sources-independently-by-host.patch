+++ b/macos/Tests/AgentSpeedAppTests/RemoteCompletionOwnershipTests.swift
@@ -0,0 +1,60 @@
+import Foundation
+import Testing
+@testable import AgentSpeed
+import AgentSpeedCore
+
+@Suite("Remote completion ownership")
+struct RemoteCompletionOwnershipTests {
+    private func snapshot(machine: String, now: Int, source: String = "codex") throws -> RemoteHostState {
+        let zone = TimeZone.current.identifier
+        let wire = #"{"version":1,"type":"snapshot","machine_id":"\#(machine)","now_ms":\#(now),"timezone":"\#(zone)","today_input":4,"today_cached_input":1,"today_cache_write_input":0,"today_reasoning":0,"today_output":10,"today_requests":1,"live_output":2,"live_total":3,"sources":[{"source":"\#(source)","enabled":true,"available":true,"sessions":1,"active_agents":1,"live_output":2,"live_total":3,"today_input":4,"today_cached_input":1,"today_cache_write_input":0,"today_reasoning":0,"today_output":10,"today_requests":1}]}"#
+        var state = RemoteHostState()
+        state.apply(try #require(RemoteMessage.decode(Data(wire.utf8))))
+        return state
+    }
+
+    @Test @MainActor func duplicateCompletionUsesMergedSourceOwner() throws {
+        let suite = "RemoteCompletionOwnership.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let a = UUID(), b = UUID()
+        let configured = [RemoteHost(id: a, label: "A", destination: "a", enabled: true),
+                          RemoteHost(id: b, label: "B", destination: "b", enabled: true)]
+        defaults.set(try JSONEncoder().encode(configured), forKey: "remoteHosts.v1")
+        let localState = try snapshot(machine: "local", now: 1)
+        let hosts = RemoteHosts(defaults: defaults, states: [a: try snapshot(machine: "shared", now: 20),
+                                                             b: try snapshot(machine: "shared", now: 10)])
+        let merged = hosts.combinedSnapshot(try #require(localState.dashboardSnapshot))
+        let owner = try #require(merged.sourceInstances.first { $0.hostID != nil && $0.status.kind == .codex }?.hostID)
+        #expect(owner == a)
+        var completions: [UUID] = []
+        hosts.onCompletion = { id, _, _, _ in completions.append(id) }
+        let completion = try #require(RemoteMessage.decode(Data(#"{"version":1,"type":"completion","response_id":"one","source":"codex","output":42}"#.utf8)))
+        hosts.receiveMessage(completion, hostID: b)
+        hosts.receiveMessage(completion, hostID: a)
+        #expect(completions == [owner])
+    }
+
+    @Test @MainActor func sourcesOnSameMachineCanHaveDifferentOwners() throws {
+        let suite = "RemoteCompletionOwnership.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let a = UUID(), b = UUID()
+        defaults.set(try JSONEncoder().encode([
+            RemoteHost(id: a, label: "A", destination: "a", enabled: true),
+            RemoteHost(id: b, label: "B", destination: "b", enabled: true),
+        ]), forKey: "remoteHosts.v1")
+        let local = try snapshot(machine: "local", now: 1)
+        let hosts = RemoteHosts(defaults: defaults, states: [a: try snapshot(machine: "shared", now: 20),
+                                                             b: try snapshot(machine: "shared", now: 10, source: "gemini")])
+        let merged = hosts.combinedSnapshot(try #require(local.dashboardSnapshot))
+        let owner = try #require(merged.sourceInstances.first { $0.hostID != nil && $0.status.kind == .gemini }?.hostID)
+        #expect(owner == b)
+        var completions: [UUID] = []
+        hosts.onCompletion = { id, _, _, _ in completions.append(id) }
+        let completion = try #require(RemoteMessage.decode(Data(#"{"version":1,"type":"completion","response_id":"two","source":"gemini","output":42}"#.utf8)))
+        hosts.receiveMessage(completion, hostID: a)
+        hosts.receiveMessage(completion, hostID: b)
+        #expect(completions == [owner])
+    }
+}
