From 590faee6268656d59a89a0fa93d9c4ccf7d439e4 Mon Sep 17 00:00:00 2001
From: Downstream Patch Queue <downstream@localhost>
Date: Thu, 19 Nov 2026 12:10:42 +0800
Subject: [PATCH 28/28] Update the About page branding and drop its repository
 link

The About page no longer offers GitHub navigation on any platform, and the
macOS footer credits yooztech. Removes the now-unused repository helpers
(AppInfo.repositoryURL, AppPaths.RepositoryUrl, OpenRepositoryCommand and the
trailing-icon label style) while keeping the MIT license links.
---
 linux/app/qml/AboutPage.qml                   | 13 ---------
 .../AgentSpeed/Localization/StringTable.swift |  2 +-
 .../SettingsWindow/Panes/AboutPane.swift      | 27 +++----------------
 .../Sources/AgentSpeed/Support/AppInfo.swift  |  2 --
 windows/src/AgentSpeed/App/AppPaths.cs        |  1 -
 .../AgentSpeed/Settings/Pages/AboutPage.xaml  |  3 +--
 .../AgentSpeed/Settings/SettingsViewModel.cs  |  3 ---
 7 files changed, 6 insertions(+), 45 deletions(-)

diff --git a/linux/app/qml/AboutPage.qml b/linux/app/qml/AboutPage.qml
index 82333fb9..838fe889 100644
--- a/linux/app/qml/AboutPage.qml
+++ b/linux/app/qml/AboutPage.qml
@@ -26,19 +26,6 @@ SettingsPage {
                 color: Theme.ink2
                 font.pixelSize: 12
             }
-            Text {
-                text: S.tr2(S.rev, "settings.about.github")
-                color: Theme.accent
-                font.pixelSize: 12
-                font.underline: linkArea.containsMouse
-                MouseArea {
-                    id: linkArea
-                    anchors.fill: parent
-                    hoverEnabled: true
-                    cursorShape: Qt.PointingHandCursor
-                    onClicked: catalog.openUrl("https://github.com/zoefix/agent-speed")
-                }
-            }
             Text {
                 Layout.topMargin: 4
                 text: S.tr2(S.rev, "settings.about.update")
