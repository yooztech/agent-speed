+    const auto utc = TimeZone::utc();
+    const auto losAngeles = TimeZone::load("America/Los_Angeles");
+    ASSERT_TRUE(losAngeles);
+    const auto database = (temp.path / "shared.sqlite").string();
+    Projection beforeUtc, beforeLocal;
+    {
+        auto store = Store::open(database);
+        ASSERT_TRUE(store);
+        Analyzer analyzer(*store, std::make_shared<pricing::PriceBook>());
+        const auto report = analyzer.runShared(locations, enabled, utc, "UTC");
+        ASSERT_EQ(report.filesAnalyzed, 1);
+        ASSERT_EQ(report.filesUnreadable, 0);
+        beforeUtc = analyzer.project(utc);
+        beforeLocal = analyzer.project(losAngeles);
+    }
+    ASSERT_EQ(beforeUtc.days.size(), 1u);
+    ASSERT_EQ(beforeLocal.days.size(), 1u);
+    ASSERT_EQ(beforeUtc.days[0].key.day, "2026-10-20");
+    ASSERT_EQ(beforeLocal.days[0].key.day, "2026-10-19");
+    ASSERT_GT(beforeUtc.days[0].totals.input, 0);
+    fs::remove(file);
+
+    auto store = Store::open(database);
+    ASSERT_TRUE(store);
+    Analyzer restarted(*store, std::make_shared<pricing::PriceBook>());
+    const auto report = restarted.runShared(locations, enabled, utc, "UTC");
+    EXPECT_EQ(report.filesAnalyzed, 0);
+    EXPECT_GT(report.filesUnreadable, 0);
+    const auto check = [](const Projection& expected, const Projection& actual) {
+        EXPECT_TRUE(actual.complete);
+        ASSERT_EQ(actual.days.size(), expected.days.size());
+        for (std::size_t i = 0; i < expected.days.size(); ++i) {
+            EXPECT_EQ(actual.days[i].key.day, expected.days[i].key.day);
+            EXPECT_EQ(actual.days[i].key.source, expected.days[i].key.source);
+            const auto& a = actual.days[i].totals;
+            const auto& e = expected.days[i].totals;
+            EXPECT_EQ(a.requests, e.requests);
+            EXPECT_EQ(a.input, e.input);
+            EXPECT_EQ(a.cachedInput, e.cachedInput);
+            EXPECT_EQ(a.output, e.output);
+            EXPECT_EQ(a.reasoning, e.reasoning);
+            EXPECT_EQ(a.costMicroUsd, e.costMicroUsd);
+            EXPECT_EQ(a.unpricedRequests, e.unpricedRequests);
+        }
+        ASSERT_EQ(actual.perfRecords.size(), expected.perfRecords.size());
+        for (std::size_t i = 0; i < expected.perfRecords.size(); ++i) {
+            EXPECT_EQ(actual.perfRecords[i].day, expected.perfRecords[i].day);
+            EXPECT_EQ(actual.perfRecords[i].source, expected.perfRecords[i].source);
+            EXPECT_EQ(actual.perfRecords[i].model, expected.perfRecords[i].model);
+            EXPECT_EQ(actual.perfRecords[i].record, expected.perfRecords[i].record);
+        }
+        ASSERT_EQ(actual.unpricedParts.size(), expected.unpricedParts.size());
+        for (std::size_t i = 0; i < expected.unpricedParts.size(); ++i) {
+            EXPECT_EQ(actual.unpricedParts[i].day, expected.unpricedParts[i].day);
+            EXPECT_EQ(actual.unpricedParts[i].source, expected.unpricedParts[i].source);
+            EXPECT_EQ(actual.unpricedParts[i].requests, expected.unpricedParts[i].requests);
+            EXPECT_EQ(actual.unpricedParts[i].noCostData, expected.unpricedParts[i].noCostData);
+            EXPECT_EQ(actual.unpricedParts[i].derived, expected.unpricedParts[i].derived);
+            EXPECT_EQ(actual.unpricedParts[i].facts, expected.unpricedParts[i].facts);
+        }
+    };
+    check(beforeUtc, restarted.project(utc));
+    check(beforeLocal, restarted.project(losAngeles));
+}
