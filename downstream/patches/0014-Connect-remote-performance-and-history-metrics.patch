+// A subscriber decides whether to resend the whole projection by comparing one integer, so the
+// sampler must advance that generation exactly when the projection text changes: re-deriving the
+// same days must not look like a new projection, and each view has its own generation.
+TEST(CollectorSampler, ProjectionGenerationTracksTheProjectionText) {
+    char home[] = "/tmp/agentspeed-sampler-generation-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    struct TempHome {
+        const char* path;
+        ~TempHome() { std::filesystem::remove_all(path); }
+    } tempHome{home};
+    ScopedEnv homeEnv("HOME", home);
+    ScopedEnv agentEnv("PI_CODING_AGENT_DIR", nullptr);
+    ScopedEnv sessionEnv("PI_CODING_AGENT_SESSION_DIR", nullptr);
+    ScopedEnv configEnv("PI_CONFIG_DIR", ".omp");
+    ScopedEnv codexEnv("CODEX_HOME", nullptr);
+    ScopedEnv claudeEnv("CLAUDE_CONFIG_DIR", nullptr);
+    ScopedEnv deepseekEnv("DSH_HOME", nullptr);
+    ScopedEnv xdgEnv("XDG_DATA_HOME", nullptr);
+    ScopedEnv geminiEnv("GEMINI_CLI_HOME", nullptr);
+    ScopedEnv tzEnv("TZ", "UTC");
+
+    auto formatStamp = [](std::int64_t ms) {
+        const std::time_t seconds = static_cast<std::time_t>(ms / 1000);
+        std::tm utc{};
+        gmtime_r(&seconds, &utc);
+        char text[32];
+        std::strftime(text, sizeof(text), "%Y-%m-%dT%H:%M:%S.000Z", &utc);
+        return std::string(text);
+    };
+    using namespace std::chrono;
+    const auto today = floor<days>(system_clock::now());
+    const auto noon = today + hours{12};
+    const auto ms = duration_cast<milliseconds>(noon.time_since_epoch()).count();
+    const auto nowMs = duration_cast<milliseconds>((today + hours{13}).time_since_epoch()).count();
+
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-generation-project";
+    std::filesystem::create_directories(dir);
+    std::ofstream(dir / "session.jsonl")
+        << R"({"type":"session","version":3,"id":"generation-session","timestamp":")" << formatStamp(ms)
+        << R"(","cwd":"/project"})" << '\n'
+        << R"({"type":"message","id":"generation-response","parentId":null,"timestamp":")" << formatStamp(ms)
+        << R"(","message":{"role":"assistant","content":[],"api":"openai-responses","provider":"openai","model":"gpt-5.5","usage":{"input":300,"output":410,"cacheRead":40,"cacheWrite":20,"reasoningTokens":70,"totalTokens":770},"stopReason":"stop","timestamp":)"
+        << ms << R"(,"duration":3000}})" << '\n';
+
+    std::atomic<std::int64_t> clock{nowMs};
+    collector::Sampler sampler(home, std::string(64, 'a'), [&] { return clock.load(); });
+    sampler.poll(nowMs);
+    const collector::View utc{std::string("UTC"), agentspeed::TimeZone::utc()};
+    sampler.sample(nowMs, utc);
+
+    std::uint64_t first = 0;
+    for (int i = 0; i < 500 && !(first = sampler.historyGeneration(utc)); ++i)
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    ASSERT_NE(first, 0u);
+    const auto text = sampler.history(utc);
+    ASSERT_FALSE(text.empty());
+
+    for (int i = 0; i < 20; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        EXPECT_EQ(sampler.historyGeneration(utc), first);
+    }
+
+    sampler.requestHistoryRefresh();
+    std::this_thread::sleep_for(std::chrono::milliseconds(3000));
+    const auto refreshed = sampler.history(utc);
+    const auto refreshedGeneration = sampler.historyGeneration(utc);
+    EXPECT_EQ(refreshed, text);
+    EXPECT_EQ(refreshedGeneration, first);
+
+    const auto tokyo = agentspeed::TimeZone::load("Asia/Tokyo");
+    ASSERT_TRUE(tokyo);
+    const collector::View east{std::string("Asia/Tokyo"), tokyo};
+    std::uint64_t eastGeneration = 0;
+    for (int i = 0; i < 500 && !(eastGeneration = sampler.historyGeneration(east)); ++i)
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    ASSERT_NE(eastGeneration, 0u);
+    EXPECT_NE(sampler.history(east), text);
+}
