+Projection Analyzer::project(std::shared_ptr<const TimeZone> zone, const std::set<SourceKind>* sources,
+                             const std::map<std::string, double>* livePeaks, bool includeStoredPeaks) {
+    const bool baselineZone = zone && legacyZone_ && zone->identity() == legacyZone_->identity();
+    std::map<std::string, StoredFile> projected;
+    bool complete = true;
+    const DayLabeler labeler(std::move(zone));
+    for (const auto& [path, entry] : entries_) {
+        const auto it = canonical_.find(path);
+        if (it == canonical_.end()) {
+            complete = false;
+            if (baselineZone) projected.emplace(path, entry);
+            continue;
+        }
+        StoredFile copy;
+        copy.id = entry.id;
+        copy.path = entry.path;
+        copy.family = entry.family;
+        copy.size = entry.size;
+        copy.modified = entry.modified;
+        copy.version = entry.version;
+        it->second(copy, labeler);
+        projected.emplace(path, std::move(copy));
+    }
+    std::map<std::string, double> savedPeaks;
+    if (!includeStoredPeaks) peaks_.swap(savedPeaks);
+    entries_.swap(projected);
+    struct Restore {
+        std::map<std::string, StoredFile>& entries;
+        std::map<std::string, StoredFile>& original;
+        std::map<std::string, double>& peaks;
+        std::map<std::string, double>& savedPeaks;
+        bool restorePeaks;
+        ~Restore() {
+            entries.swap(original);
+            if (restorePeaks) peaks.swap(savedPeaks);
+        }
+    } restore{entries_, projected, peaks_, savedPeaks, !includeStoredPeaks};
