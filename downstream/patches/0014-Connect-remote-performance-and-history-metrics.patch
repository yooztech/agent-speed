+    ASSERT_TRUE(bridge.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"UTC\"}\n"));
+    bridge.timezone = "UTC";
+    ASSERT_TRUE(bridge.lineType("history", 15000));
+    bridge.timezone = "Asia/Tokyo";
+    ASSERT_TRUE(bridge.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"Asia/Tokyo\"}\n"));
