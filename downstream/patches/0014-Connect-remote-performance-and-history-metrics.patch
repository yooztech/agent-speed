+TEST(CollectorPublisher, EarliestDueLeasePreventsStarvation) {
+    std::atomic<std::int64_t> now{1000000};
+    std::atomic<bool> ready{false};
+    std::atomic<int> calls{0};
+    std::mutex mutex;
+    std::vector<std::string> hosts;
+    collector::Publisher* publisherPtr = nullptr;
+    std::vector<collector::View> views;
+    collector::Publisher::Options options;
+    options.clock = [&] { return now.load(); };
+    options.transport = [&](const auto&, const auto& body) {
+        while (!ready.load()) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        agentspeed::json::Document doc;
+        if (doc.parse(body)) {
+            std::lock_guard<std::mutex> lock(mutex);
+            hosts.push_back(doc.root()["snapshot"]["hostId"].string().value_or(""));
+        }
+        auto call = ++calls;
+        now += 6000;
+        if (call < 4) {
+            collector::Sample newer;
+            newer.snapshot.nowMs = now;
+            for (const auto& view : views) publisherPtr->sample(view, newer);
+        }
+        return collector::Publisher::Result{200};
+    };
+    collector::Publisher publisher(options);
+    publisherPtr = &publisher;
+    const std::string oldActivity = "\"activityId\":\"a\"";
+    const std::string oldHost = "\"hostId\":\"host\"";
+    for (int i = 0; i < 4; ++i) {
+        auto suffix = std::to_string(i);
+        auto request = subscribe("r" + suffix, "l" + suffix);
+        request.replace(request.find(oldActivity), oldActivity.size(), "\"activityId\":\"a" + suffix + "\"");
+        request.replace(request.find(oldHost), oldHost.size(), "\"hostId\":\"host" + suffix + "\"");
+        EXPECT_TRUE(publisher.control(request, i + 1, now).empty());
+    }
+    views = publisher.views();
+    EXPECT_EQ(views.size(), 4u);
+    collector::Sample first;
+    first.snapshot.nowMs = now;
+    for (const auto& view : views) publisher.sample(view, first);
+    ready = true;
+    ASSERT_TRUE(eventually([&] { return calls.load() >= 4; }));
+    std::lock_guard<std::mutex> lock(mutex);
+    ASSERT_GE(hosts.size(), 4u);
+    EXPECT_EQ(hosts[0], "host0");
+    EXPECT_EQ(hosts[1], "host1");
+    EXPECT_EQ(hosts[2], "host2");
+    EXPECT_EQ(hosts[3], "host3");
+}
