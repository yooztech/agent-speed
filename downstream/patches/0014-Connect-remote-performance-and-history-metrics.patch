+    now += 1000; sample(-1, 0); unchanged(2); // unknown does not become idle
+    now += 1000; sample(0, 0); ASSERT_TRUE(eventually([&] { return calls == 3; }));
+    now += 1000; sample(1, -1); ASSERT_TRUE(eventually([&] { return calls == 4; }));
+    now += 9999; sample(2, 0); unchanged(4);
