+// An idle machine must not keep spending relay requests and APNs. One frame carries the quiet
+// state; after the relay accepts it the collector stops until work appears.
+TEST(CollectorPublisher, QuietMachinePublishesOnceThenStaysSilent) {
+    std::atomic<std::int64_t> now{1000000};
+    std::atomic<int> calls{0};
+    collector::Publisher::Options options;
+    options.clock = [&] { return now.load(); };
+    options.transport = [&](const auto&, const auto&) { ++calls; return collector::Publisher::Result{200}; };
+    collector::Publisher publisher(options);
+    ASSERT_TRUE(publisher.control(subscribe(), 1, now).empty());
+    auto view = publisher.views().at(0);
+    auto sample = [&](double speed, int generating, std::int64_t today) {
+        collector::Sample s;
+        s.snapshot.nowMs = now;
+        s.snapshot.liveRateComplete = true;
+        s.snapshot.liveOutput = speed;
+        s.snapshot.generating = generating;
+        s.snapshot.tools = 0;
+        s.snapshot.todayOutput = today;
+        publisher.sample(view, s);
+    };
+    sample(0, 0, 100);
+    ASSERT_TRUE(eventually([&] { return calls == 1; }));
+    // Ten minutes of idle samples cost nothing more.
+    for (int i = 0; i < 60; ++i) { now += 10000; sample(0, 0, 100); }
+    std::this_thread::sleep_for(std::chrono::milliseconds(150));
+    EXPECT_EQ(calls.load(), 1);
+    // Work starts again: the transition is sent immediately.
+    now += 1000;
+    sample(120, 1, 100);
+    ASSERT_TRUE(eventually([&] { return calls == 2; }));
+}
