+                if (bin.ValueKind == JsonValueKind.Number && bin.TryGetInt64(out var count) && count >= 0) s.LatencyBins[i++] = count;
+                else { valid = false; break; }
+            if (valid) result.Add(new PerfRecord(day, source, model, s));
+        }
+        return result;
+    }
+}
