+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemotePerformanceTests
+{
+    private static string Zone => TimeZoneInfo.TryConvertWindowsIdToIanaId(TimeZoneInfo.Local.Id, out var iana) ? iana : TimeZoneInfo.Local.Id;
+    private static string Snapshot(string machine, bool performance, string baseline = "null")
+    {
+        var components = string.Join(",", new[] { "T", "L", "N", "R", "H", "U", "S" }.Select(id => $$"""{"id":"{{id}}","present":false,"reason":"fewSamples","samples":0,"measure":null,"ratio":null}"""));
+        var perf = performance ? """, "perf":{"form":"live","score":1234,"n":4,"tools":2,"active_ms":3000,"span_start_ms":10,"model":"model-a","components":[__COMPONENTS__],"baseline":__BASELINE__,"work_signals":{"looping":3,"repeating":null,"novelty":0.5,"failed":1,"recovered":0}}""".Replace("__COMPONENTS__", components).Replace("__BASELINE__", baseline) : "";
+        return """{"version":1,"type":"snapshot","machine_id":__MACHINE__,"timezone":__ZONE__,"today_day":"2026-01-15","sources":[{"source":"pi","enabled":true,"available":true,"live_output":1,"live_total":1}],"agents":[{"id":"a","source":"pi","phase":"generating"__PERF__}]}"""
+            .Replace("__MACHINE__", JsonSerializer.Serialize(machine)).Replace("__ZONE__", JsonSerializer.Serialize(Zone)).Replace("__PERF__", perf);
+    }
+
+    private static string History(string timezone, long n)
+    {
+        var bins = string.Join(",", Enumerable.Repeat("0", 64));
+        return $$"""{"version":1,"type":"history","timezone":{{JsonSerializer.Serialize(timezone)}},"days":[{"day":"2026-01-14","source":"pi","measured_ms":99999}],"perf_records":[{"day":"2026-01-14","source":"pi","model":"model-a","n":{{n}},"output_sum":1000,"duration_ms_sum":10000,"latency_bins":[{{bins}}],"reason_n":0,"reason_output":0,"reason_duration_ms_sum":0,"cache_n":0,"cache_input":0,"cache_cached":0,"tool_n":0,"tool_ln_sum":0,"tool_failed":0,"active_ms":10000}]}""";
+    }
+
+    [Fact]
+    public async Task RemoteEvaluationAndWorkReachAgentAndSource()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "remote", true, json: Snapshot("one", true));
+        var agent = Assert.Single(hub.Snapshot.Agents, a => a.HostId == id);
+        Assert.Equal(1234, agent.Perf!.Score);
+        Assert.Equal(3, agent.Work.Looping);
+        Assert.Equal(1234, agent.Intelligence.Score.Score);
+        Assert.Equal(1234, Assert.Single(hub.Snapshot.Sources, s => s.HostId == id).Intelligence.Score.Score);
+        hub.UpdateRemoteHost(id, "remote", true, json: Snapshot("one", false));
+        Assert.Null(Assert.Single(hub.Snapshot.Agents, a => a.HostId == id).Perf);
+    }
+
+    [Fact]
+    public async Task HistoryRecordsAreHostScopedAndNeverDerivedFromUsageTiming()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var first = Guid.NewGuid();
+        var second = Guid.NewGuid();
+        hub.UpdateRemoteHost(first, "first", true, json: Snapshot("one", true));
+        hub.UpdateRemoteHost(second, "second", true, json: Snapshot("two", false));
+        hub.UpdateRemoteHost(first, "first", true, json: History(Zone, 7));
+        var hosts = hub.Snapshot.RemoteHosts;
+        var record = Assert.Single(hosts.Single(h => h.Id == first).PerfRecords!);
+        Assert.Equal(7, record.Sums.N);
+        Assert.Equal(10000, record.Sums.DurationMsSum);
+        Assert.Null(hosts.Single(h => h.Id == second).PerfRecords);
+        hub.UpdateRemoteHost(first, "first", true, json: $$"""{"version":1,"type":"history","timezone":{{JsonSerializer.Serialize(Zone)}},"days":[{"day":"2026-01-14","source":"pi","measured_ms":99999}]}""");
+        Assert.Null(hub.Snapshot.RemoteHosts.Single(h => h.Id == first).PerfRecords);
+    }
+
+    [Fact]
+    public async Task ForeignTimezoneHistoryDoesNotReplaceRequestedTimezoneRecords()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "remote", true, json: Snapshot("one", true));
+        hub.UpdateRemoteHost(id, "remote", true, json: History(Zone, 7));
+        hub.UpdateRemoteHost(id, "remote", true, json: History(Zone + "-other", 20));
+        Assert.Equal(7, Assert.Single(hub.Snapshot.RemoteHosts.Single(h => h.Id == id).PerfRecords!).Sums.N);
+    }
+
+    [Fact]
+    public async Task CollectorBaselineSurvivesRequestedZoneHistory()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var first = Guid.NewGuid();
+        var second = Guid.NewGuid();
+        hub.UpdateRemoteHost(first, "first", true, json: Snapshot("one", true, "900"));
+        hub.UpdateRemoteHost(second, "second", true, json: Snapshot("two", true, "1100"));
+        hub.UpdateRemoteHost(first, "first", true, json: History(Zone, 20));
+        Assert.Equal(900, hub.Snapshot.Agents.Single(a => a.HostId == first).Perf!.Baseline);
+        Assert.Equal(1100, hub.Snapshot.Agents.Single(a => a.HostId == second).Perf!.Baseline);
+    }
+}
