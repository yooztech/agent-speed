+    ASSERT_FALSE(data.empty());
+    replaceAll(data, "2026-10-20T10:", "2026-10-20T00:");
+    writeFile(file, data);
+
+    SourceLocations locations;
+    locations.codexRoot = root.string();
+    const std::set<SourceKind> enabled{SourceKind::Codex};
+    const auto utc = TimeZone::utc();
+    const auto losAngeles = TimeZone::load("America/Los_Angeles");
+    ASSERT_TRUE(losAngeles);
+    auto store = Store::open((temp.path / "shared.sqlite").string());
+    ASSERT_TRUE(store);
+    Analyzer analyzer(*store, std::make_shared<pricing::PriceBook>());
+
+    const auto first = analyzer.runShared(locations, enabled, utc, "UTC");
+    ASSERT_EQ(first.filesUnreadable, 0);
+    ASSERT_EQ(first.filesAnalyzed, 1);
+    const auto moved = temp.path / "temporarily-unavailable.jsonl";
+    fs::rename(file, moved);
+    const auto utcView = analyzer.project(utc);
+    const auto localView = analyzer.project(losAngeles);
+    const auto utcAgain = analyzer.project(utc);
+    ASSERT_EQ(utcView.days.size(), 1u);
+    ASSERT_EQ(localView.days.size(), 1u);
+    ASSERT_EQ(utcAgain.days.size(), 1u);
+    EXPECT_EQ(utcView.days[0].key.day, "2026-10-20");
+    EXPECT_EQ(localView.days[0].key.day, "2026-10-19");
+    EXPECT_EQ(utcView.days[0].totals.input, localView.days[0].totals.input);
+    EXPECT_EQ(utcView.days[0].totals.input, utcAgain.days[0].totals.input);
+    EXPECT_GT(utcView.days[0].totals.input, 0);
+    fs::rename(moved, file);
+
+    const auto unchanged = analyzer.runShared(locations, enabled, utc, "UTC");
+    EXPECT_EQ(unchanged.filesAnalyzed, 0);
+    replaceAll(data, "10400", "114000");
