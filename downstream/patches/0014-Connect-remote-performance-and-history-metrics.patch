+using Clock = std::chrono::steady_clock;
+
+std::string digest(const fs::path& executable) {
+    std::ifstream input(executable, std::ios::binary);
+    EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+    if (!ctx || !input || EVP_DigestInit_ex(ctx, EVP_sha256(), nullptr) != 1) {
+        EVP_MD_CTX_free(ctx); return {};
+    }
+    char buffer[16384];
+    while (input.read(buffer, sizeof(buffer)) || input.gcount())
+        if (EVP_DigestUpdate(ctx, buffer, static_cast<std::size_t>(input.gcount())) != 1) {
+            EVP_MD_CTX_free(ctx); return {};
+        }
+    unsigned char hash[EVP_MAX_MD_SIZE]; unsigned int size = 0;
+    bool ok = input.eof() && EVP_DigestFinal_ex(ctx, hash, &size) == 1;
+    EVP_MD_CTX_free(ctx);
+    if (!ok) return {};
+    const char hex[] = "0123456789abcdef"; std::string result;
+    for (unsigned int i = 0; i < size; ++i) { result += hex[hash[i] >> 4]; result += hex[hash[i] & 15]; }
+    return result;
+}
+
+pid_t socketPeer(const fs::path& directory) {
+    int dir = open(directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dir < 0) return -1;
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    sockaddr_un address{}; address.sun_family = AF_UNIX;
+    std::string path = "/proc/self/fd/" + std::to_string(dir) + "/collector.sock";
+    std::strcpy(address.sun_path, path.c_str());
+    ucred cred{}; socklen_t size = sizeof(cred);
+    bool ok = fd >= 0 && connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0 &&
+              getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &size) == 0;
+    if (fd >= 0) close(fd);
+    close(dir);
+    return ok ? cred.pid : -1;
+}
+
+class Home {
+public:
+    Home() {
+        char name[] = "/tmp/as-daemon-XXXXXX";
+        if (char* p = mkdtemp(name)) path = p;
+    }
+    ~Home() {
+        // The test daemon has a one-second idle timeout; do not remove its lock
+        // while it still owns it, even when an assertion terminates a test early.
+        auto end = Clock::now() + std::chrono::seconds(8);
+        while (!path.empty() && Clock::now() < end) {
+            bool found = false; std::error_code ec;
+            for (const auto& entry : fs::recursive_directory_iterator(path, fs::directory_options::skip_permission_denied, ec))
+                if (entry.path().filename() == "collector.sock" && entry.is_socket(ec)) found = true;
+            if (!found) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+        if (!path.empty()) { std::error_code ec; fs::remove_all(path, ec); }
+    }
+    fs::path runtime() const { return path / ".agent-speed/daemons" / digest(AGENTSPEED_COLLECTOR_PATH); }
+    void makeRuntime() const { fs::create_directories(runtime()); chmod((path / ".agent-speed").c_str(), 0700); chmod((path / ".agent-speed/daemons").c_str(), 0700); chmod(runtime().c_str(), 0700); }
+    fs::path path;
+};
+
+class Bridge {
+public:
+    Bridge(const fs::path& home, const fs::path& executable = AGENTSPEED_COLLECTOR_PATH) {
+        int in[2], out[2];
+        if (pipe2(in, O_CLOEXEC)) return;
+        if (pipe2(out, O_CLOEXEC)) { close(in[0]); close(in[1]); return; }
+        pid = fork();
+        if (pid == 0) {
+            dup2(in[0], STDIN_FILENO); dup2(out[1], STDOUT_FILENO);
+            close(in[0]); close(in[1]); close(out[0]); close(out[1]);
+            setenv("HOME", home.c_str(), 1);
+            unsetenv("PI_CODING_AGENT_DIR"); unsetenv("PI_CONFIG_DIR");
+            execl(executable.c_str(), executable.c_str(), static_cast<char*>(nullptr));
+            _exit(127);
+        }
+        close(in[0]); close(out[1]);
+        if (pid < 0) { close(in[1]); close(out[0]); return; }
+        input = in[1]; output = out[0];
+    }
+    ~Bridge() {
+        closeInput();
+        if (output >= 0) close(output);
+        if (pid > 0 && !wait(3000)) {
+            kill(pid, SIGKILL);
+            while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+        }
+    }
+    void closeInput() { if (input >= 0) { close(input); input = -1; } }
+    bool send(const std::string& message) {
+        std::size_t offset = 0;
+        while (offset < message.size()) {
+            ssize_t n = write(input, message.data() + offset, message.size() - offset);
+            if (n > 0) offset += static_cast<std::size_t>(n);
+            else if (n < 0 && errno == EINTR) continue;
+            else return false;
+        }
+        return true;
+    }
+    bool wait(int ms) {
+        if (pid <= 0) return true;
+        auto end = Clock::now() + std::chrono::milliseconds(ms);
+        do {
+            pid_t r = waitpid(pid, &status, WNOHANG);
+            if (r == pid) { pid = -1; return true; }
+            if (r < 0 && errno != EINTR) { pid = -1; return true; }
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        } while (Clock::now() < end);
+        return false;
+    }
+    bool failed(int ms = 5000) { return wait(ms) && WIFEXITED(status) && WEXITSTATUS(status) != 0; }
+    bool lineType(const std::string& type, int timeout = 12000) {
+        auto end = Clock::now() + std::chrono::milliseconds(timeout);
+        while (Clock::now() < end) {
+            auto newline = buffer.find('\n');
+            if (newline != std::string::npos) {
+                std::string line = buffer.substr(0, newline); buffer.erase(0, newline + 1);
+                agentspeed::json::Document doc;
+                if (doc.parse(line) && doc.root()["type"].string() == type &&
+                    (timezone.empty() || doc.root()["timezone"].string() == timezone)) return true;
+                continue;
+            }
+            auto left = std::chrono::duration_cast<std::chrono::milliseconds>(end - Clock::now()).count();
+            pollfd fd{output, POLLIN, 0};
+            int r = poll(&fd, 1, static_cast<int>(left));
+            if (r < 0 && errno == EINTR) continue;
+            if (r <= 0) return false;
+            char data[8192]; ssize_t n = read(output, data, sizeof(data));
+            if (n <= 0) return false;
+            buffer.append(data, static_cast<std::size_t>(n));
+        }
+        return false;
+    }
+    bool capabilities(const std::string& request) {
+        return send("{\"version\":1,\"type\":\"capabilities\",\"requestId\":\"" + request + "\"}\n") && lineType("capabilities");
+    }
+    // Reads frames for `ms` and reports how many snapshots and history projections arrived.
+    std::pair<int, int> countFrames(int ms) {
+        auto end = Clock::now() + std::chrono::milliseconds(ms);
+        int snapshots = 0, histories = 0;
+        while (Clock::now() < end) {
+            auto newline = buffer.find('\n');
+            if (newline != std::string::npos) {
+                std::string line = buffer.substr(0, newline); buffer.erase(0, newline + 1);
+                agentspeed::json::Document doc;
+                if (doc.parse(line)) {
+                    const auto type = doc.root()["type"].string();
+                    if (type && *type == "snapshot") ++snapshots;
+                    if (type && *type == "history") ++histories;
+                }
+                continue;
+            }
+            auto left = std::chrono::duration_cast<std::chrono::milliseconds>(end - Clock::now()).count();
+            if (left <= 0) break;
+            pollfd fd{output, POLLIN, 0};
+            int r = poll(&fd, 1, static_cast<int>(left));
+            if (r < 0 && errno == EINTR) continue;
+            if (r <= 0) break;
+            char data[8192]; ssize_t n = read(output, data, sizeof(data));
+            if (n <= 0) break;
+            buffer.append(data, static_cast<std::size_t>(n));
+        }
+        return {snapshots, histories};
+    }
+    pid_t pid = -1;
+    int input = -1, output = -1, status = 0;
+    std::string timezone;
+    std::string buffer;
+};
+
+class DaemonProcessTest : public ::testing::Test {
+protected:
+    void SetUp() override { oldPipe = std::signal(SIGPIPE, SIG_IGN); ASSERT_FALSE(home.path.empty()); }
+    void TearDown() override { std::signal(SIGPIPE, oldPipe); }
+    Home home;
+    using Handler = void (*)(int);
+    Handler oldPipe = SIG_DFL;
+};
+
+TEST_F(DaemonProcessTest, ConcurrentColdBridgesAndIndependentEof) {
+    Bridge first(home.path), second(home.path);
+    ASSERT_GT(first.pid, 0); ASSERT_GT(second.pid, 0);
+    ASSERT_TRUE(first.capabilities("first"));
+    ASSERT_TRUE(second.capabilities("second"));
+    ASSERT_TRUE(first.lineType("snapshot"));
+    ASSERT_TRUE(second.lineType("snapshot"));
+    first.closeInput();
+    ASSERT_TRUE(first.wait(5000));
+    EXPECT_TRUE(WIFEXITED(first.status)); EXPECT_EQ(WEXITSTATUS(first.status), 0);
+    EXPECT_TRUE(second.capabilities("after-eof"));
+    EXPECT_TRUE(second.lineType("snapshot"));
+}
+
+TEST_F(DaemonProcessTest, ColdStartScanDoesNotBlockTheHandshake) {
+    // The first scan is forced to take eight seconds. A client must still complete the daemon handshake and its
+    // capabilities exchange within the five-second budget the bridge and the app rely on.
+    setenv("AGENTSPEED_COLLECTOR_TEST_SLOW_FIRST_POLL_MS", "8000", 1);
+    const auto started = Clock::now();
+    Bridge bridge(home.path);
+    unsetenv("AGENTSPEED_COLLECTOR_TEST_SLOW_FIRST_POLL_MS");
+    ASSERT_GT(bridge.pid, 0);
+    ASSERT_TRUE(bridge.capabilities("slow-cold-start"));
+    EXPECT_LT(Clock::now() - started, std::chrono::seconds(5));
+}
+
+TEST_F(DaemonProcessTest, TimezoneChangesStayLocalToSubscriber) {
+    Bridge changing(home.path), stable(home.path);
+    ASSERT_TRUE(changing.capabilities("changing"));
+    ASSERT_TRUE(stable.capabilities("stable"));
+    ASSERT_TRUE(changing.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"UTC\"}\n"));
+    ASSERT_TRUE(stable.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"America/New_York\"}\n"));
+    changing.timezone = "UTC";
+    stable.timezone = "America/New_York";
+    ASSERT_TRUE(changing.lineType("history", 15000));
+    ASSERT_TRUE(stable.lineType("history", 15000));
+    ASSERT_TRUE(changing.lineType("snapshot", 5000));
+    ASSERT_TRUE(stable.lineType("snapshot", 5000));
+    ASSERT_TRUE(changing.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"Asia/Tokyo\"}\n"));
+    changing.timezone = "Asia/Tokyo";
+    EXPECT_TRUE(changing.lineType("history", 15000));
+    EXPECT_TRUE(changing.lineType("snapshot", 5000));
+    EXPECT_TRUE(stable.lineType("snapshot", 5000));
+}
+
+TEST_F(DaemonProcessTest, RejectsSymlinkLockAndSocketWithoutTouchingTargets) {
+    home.makeRuntime();
+    const auto target = home.path / "target";
+    { std::ofstream file(target); file << "preserve"; }
+    const auto lock = home.runtime() / "collector.lock";
