+TEST_F(DaemonProcessTest, UnchangedProjectionIsNotResentEachTick) {
+    Bridge bridge(home.path);
+    ASSERT_GT(bridge.pid, 0);
+    ASSERT_TRUE(bridge.capabilities("projection-generation"));
+    ASSERT_TRUE(bridge.send("{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"UTC\"}\n"));
+    bridge.timezone = "UTC";
+    // The first projection is delivered as soon as it exists.
+    ASSERT_TRUE(bridge.lineType("history", 15000));
+    // Ticks keep flowing, but the unchanged projection stays unsent: the daemon compares the
+    // view's projection generation rather than copying and comparing the projection text.
+    const auto [snapshots, histories] = bridge.countFrames(4000);
+    EXPECT_GE(snapshots, 2);
+    EXPECT_EQ(histories, 0);
