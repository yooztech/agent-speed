+        foreach (var r in records.EnumerateArray())
+        {
+            if (r.Text("day") is not { } day || RemoteHostData.Kind(r.Text("source")) is not { } source || r.Text("model") is not { } model ||
+                r.Array("latency_bins") is not { } bins || bins.GetArrayLength() != LatencyBins.Count) continue;
+            string[] names = ["n", "output_sum", "duration_ms_sum", "reason_n", "reason_output", "reason_duration_ms_sum", "cache_n", "cache_input", "cache_cached", "tool_n", "tool_failed", "active_ms"];
+            var values = names.Select(name => Integer(r, name)).ToArray();
+            if (values.Any(v => v is null or < 0) || r.NullableNumber("tool_ln_sum") is not double ln) continue;
+            var s = new PerfSums { N = values[0]!.Value, OutputSum = values[1]!.Value, DurationMsSum = values[2]!.Value,
+                ReasonN = values[3]!.Value, ReasonOutput = values[4]!.Value, ReasonDurationMsSum = values[5]!.Value,
+                CacheN = values[6]!.Value, CacheInput = values[7]!.Value, CacheCached = values[8]!.Value,
+                ToolN = values[9]!.Value, ToolLnSum = ln, ToolFailed = values[10]!.Value, ActiveMs = values[11]!.Value };
+            var i = 0;
+            bool valid = true;
