+/// <summary>Selected performance records and whether every selected machine supplied history.</summary>
+public sealed record PerfHistorySources(IReadOnlyList<PerfRecord> Records, bool Complete)
+{
+    public static PerfHistorySources Select(IReadOnlyList<PerfRecord> local, IEnumerable<RemoteHostStatus> remotes, Guid? hostId, bool allHosts)
+    {
+        var hosts = remotes.Where(h => allHosts || h.Id == hostId)
+            .OrderByDescending(h => h.Online).ThenByDescending(h => h.HistoryCurrent).ToList();
+        var complete = (hostId is null || hosts.Count > 0)
+            && hosts.GroupBy(h => h.MachineId).All(group => group.Any(h => h.PerfRecords is not null));
+        var records = new List<PerfRecord>();
+        if (hostId is null) records.AddRange(local);
+        var seen = new HashSet<(string, SourceKind)>();
+        foreach (var host in hosts)
+        {
+            if (host.PerfRecords is null) continue;
+            var sources = host.PerfRecords.Select(r => r.Source).Distinct()
+                .Where(source => seen.Add((host.MachineId, source))).ToHashSet();
+            records.AddRange(host.PerfRecords.Where(r => sources.Contains(r.Source)));
+        }
+        return new(records, complete);
+    }
+}
