+constexpr std::string_view kHeader = "ASHC\x02";
+constexpr std::string_view kLegacyHeader = "ASHC\x01";
+
+class Writer {
+public:
+    std::string bytes = std::string(kHeader);
+
+    void byte(std::uint8_t value) { bytes.push_back(static_cast<char>(value)); }
+    void number(std::uint64_t value) {
+        for (int i = 0; i < 8; ++i) byte(static_cast<std::uint8_t>(value >> (i * 8)));
+    }
+    void integer(std::int64_t value) { number(std::bit_cast<std::uint64_t>(value)); }
+    void text(const std::string& value) { number(value.size()); bytes.append(value); }
+    void boolean(bool value) { byte(value ? 1 : 0); }
+    template <typename T, typename F> void optional(const std::optional<T>& value, F put) {
+        boolean(value.has_value());
+        if (value) put(*value);
+    }
+    void optText(const std::optional<std::string>& value) { optional(value, [this](const auto& v) { text(v); }); }
+    void optInteger(const std::optional<std::int64_t>& value) { optional(value, [this](auto v) { integer(v); }); }
+
+    void response(const ParsedResponse& r) {
+        text(r.key); byte(static_cast<std::uint8_t>(r.source)); text(r.agentId); optText(r.model);
+        optInteger(r.startMs); integer(r.endMs); optInteger(r.firstMs);
+        integer(r.tokens.input); integer(r.tokens.cachedInput); integer(r.tokens.cacheWriteInput);
+        integer(r.tokens.output); integer(r.tokens.reasoning); integer(r.tokens.cacheWrite1hInput);
+        boolean(r.final); optText(r.provider); boolean(r.fast); integer(r.requestCount);
+        number(r.modes.facts().size());
+        for (const auto& f : r.modes.facts()) {
+            byte(static_cast<std::uint8_t>(f.kind)); text(f.value); text(f.raw);
+            byte(static_cast<std::uint8_t>(f.evidence)); optText(f.provider); byte(static_cast<std::uint8_t>(f.scope));
+        }
+    }
+    void action(const work::Action& a) {
+        integer(a.callMs); optInteger(a.resultMs); text(a.tool); text(a.digest);
+        optional(a.failed, [this](bool v) { boolean(v); }); optText(a.model);
+        boolean(a.seeded); number(a.serial);
+    }
+};
+
+class Reader {
+public:
+    explicit Reader(std::string_view data) : data_(data) {}
+    bool done() const { return ok_ && data_.empty(); }
+    bool ok() const { return ok_; }
+    std::uint8_t byte() {
+        if (data_.empty()) { ok_ = false; return 0; }
+        const auto result = static_cast<std::uint8_t>(data_.front());
+        data_.remove_prefix(1);
+        return result;
+    }
+    std::uint64_t number() {
+        std::uint64_t value = 0;
+        for (int i = 0; i < 8; ++i) value |= std::uint64_t{byte()} << (i * 8);
+        return value;
+    }
+    std::int64_t integer() { return std::bit_cast<std::int64_t>(number()); }
+    bool boolean() {
+        auto value = byte();
+        if (value > 1) ok_ = false;
+        return value == 1;
+    }
+    std::string text() {
+        const auto size = number();
+        if (!ok_ || size > data_.size()) { ok_ = false; return {}; }
+        std::string result(data_.substr(0, static_cast<std::size_t>(size)));
+        data_.remove_prefix(static_cast<std::size_t>(size));
+        return result;
+    }
+    template <typename T, typename F> std::optional<T> optional(F get) {
+        if (!boolean()) return std::nullopt;
+        return get();
+    }
+    std::optional<std::string> optText() { return optional<std::string>([this] { return text(); }); }
+    std::optional<std::int64_t> optInteger() { return optional<std::int64_t>([this] { return integer(); }); }
+    template <typename E> E enumeration(std::uint8_t maximum) {
+        auto value = byte();
+        if (value > maximum) ok_ = false;
+        return static_cast<E>(value);
+    }
+    std::uint64_t count() {
+        auto n = number();
+        // Every encoded element occupies at least one byte.
+        if (!ok_ || n > data_.size()) { ok_ = false; return 0; }
+        return n;
+    }
+    ParsedResponse response() {
+        ParsedResponse r;
+        r.key = text(); r.source = enumeration<SourceKind>(static_cast<std::uint8_t>(SourceKind::Droid));
+        r.agentId = text(); r.model = optText(); r.startMs = optInteger(); r.endMs = integer(); r.firstMs = optInteger();
+        r.tokens.input = integer(); r.tokens.cachedInput = integer(); r.tokens.cacheWriteInput = integer();
+        r.tokens.output = integer(); r.tokens.reasoning = integer(); r.tokens.cacheWrite1hInput = integer();
+        r.final = boolean(); r.provider = optText(); r.fast = boolean(); r.requestCount = integer();
+        auto n = count();
+        if (n > ExecutionModes::kMaxFacts) { ok_ = false; return r; }
+        std::vector<ModeFact> facts;
+        facts.reserve(static_cast<std::size_t>(n));
+        for (std::uint64_t i = 0; i < n && ok_; ++i) {
+            ModeFact f;
+            f.kind = enumeration<ModeKind>(static_cast<std::uint8_t>(ModeKind::Effort));
+            f.value = text(); f.raw = text();
+            f.evidence = enumeration<ModeEvidence>(static_cast<std::uint8_t>(ModeEvidence::Served));
+            f.provider = optText(); f.scope = enumeration<ModeScope>(static_cast<std::uint8_t>(ModeScope::Response));
+            facts.push_back(std::move(f));
+        }
+        r.modes = ExecutionModes(facts);
+        if (r.modes.facts() != facts) ok_ = false;
+        return r;
+    }
+    work::Action action() {
+        work::Action a;
+        a.callMs = integer(); a.resultMs = optInteger(); a.tool = text(); a.digest = text();
+        a.failed = optional<bool>([this] { return boolean(); }); a.model = optText();
+        a.seeded = boolean(); a.serial = number();
+        return a;
+    }
+private:
+    std::string_view data_;
+    bool ok_ = true;
+};
+
+}  // namespace
+
+std::string serialize(const File& file) {
+    Writer w;
+    w.byte(static_cast<std::uint8_t>(file.source)); w.text(file.agent); w.optText(file.onlyAgent); w.boolean(file.emitted);
+    w.optText(file.hermesSourceZone);
+    w.number(file.items.size());
+    for (const auto& item : file.items) w.response(item);
+    w.number(file.perfItems.size());
+    for (const auto& item : file.perfItems) w.response(item);
+    w.number(file.events.size());
+    for (const auto& event : file.events) {
+        w.text(event.key);
+        w.optional(event.action, [&w](const auto& action) { w.action(action); });
+    }
+    return std::move(w.bytes);
+}
+
+std::optional<File> deserialize(std::string_view bytes) {
+    const bool legacy = bytes.starts_with(kLegacyHeader);
+    if (!legacy && !bytes.starts_with(kHeader)) return std::nullopt;
+    Reader r(bytes.substr(kHeader.size()));
+    File file;
+    file.source = r.enumeration<SourceKind>(static_cast<std::uint8_t>(SourceKind::Droid));
+    file.agent = r.text(); file.onlyAgent = r.optText(); file.emitted = r.boolean();
+    if (!legacy) file.hermesSourceZone = r.optText();
+    auto n = r.count();
+    for (std::uint64_t i = 0; i < n && r.ok(); ++i) file.items.push_back(r.response());
+    n = r.count();
+    for (std::uint64_t i = 0; i < n && r.ok(); ++i) file.perfItems.push_back(r.response());
+    n = r.count();
+    for (std::uint64_t i = 0; i < n && r.ok(); ++i) {
+        Event event;
+        event.key = r.text();
+        event.action = r.optional<work::Action>([&r] { return r.action(); });
+        file.events.push_back(std::move(event));
+    }
+    if (!r.done()) return std::nullopt;
+    return file;
+}
