+internal static class RemotePerformance
+{
+    private static long? Integer(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt64(out var n) ? n : null;
+    private static int? Int(JsonElement e, string name) => Integer(e, name) is long n && n >= 0 && n <= int.MaxValue ? (int)n : null;
+    private static JsonElement? Object(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Object ? v : null;
