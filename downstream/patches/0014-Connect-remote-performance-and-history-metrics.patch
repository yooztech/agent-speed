+TEST(CollectorPublisher, ConfirmedLeaseSurvivesTransientFailuresAndRecovers) {
+    std::atomic<std::int64_t> now{1000000};
+    std::atomic<int> calls{0};
+    std::mutex mutex;
+    std::vector<std::int64_t> timestamps;
+    collector::Publisher::Options options;
+    options.clock = [&] { return now.load(); };
+    options.transport = [&](const auto&, const auto& body) {
+        agentspeed::json::Document doc;
+        if (doc.parse(body)) {
+            std::lock_guard<std::mutex> lock(mutex);
+            timestamps.push_back(doc.root()["snapshot"]["sampledAt"].truncated().value_or(0));
+        }
+        int call = ++calls;
+        return collector::Publisher::Result{call == 1 || call == 11 ? 200L : 502L};
+    };
+    collector::Publisher publisher(options);
+    ASSERT_TRUE(publisher.control(subscribe(), 1, now).empty());
+    auto views = publisher.views();
+    ASSERT_EQ(views.size(), 1u);
+    collector::Sample sample;
+    sample.snapshot.liveRateComplete = true;
+    sample.snapshot.liveOutput = 5;  // Work present: this test is about backoff, not quiet suppression.
+    for (int i = 0; i < 11; ++i) {
+        if (i) now += 61000;
+        sample.snapshot.nowMs = now;
+        publisher.sample(views[0], sample);
+        ASSERT_TRUE(eventually([&] { return calls.load() == i + 1; }));
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        EXPECT_TRUE(publisher.authorized(now));
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    ASSERT_EQ(timestamps.size(), 11u);
+    for (std::size_t i = 1; i < timestamps.size(); ++i) EXPECT_GT(timestamps[i], timestamps[i - 1]);
+}
