+import Foundation
+import Testing
+import AgentSpeedCore
+@testable import AgentSpeedOrbModel
+
+@Suite("Orb host source persistence")
+struct OrbHostSourceCodingTests {
+    @Test func defaultsAndRoundTrip() throws {
+        let decoder = JSONDecoder()
+        let old = try decoder.decode(OrbConfig.self, from: Data(#"{"id":"old"}"#.utf8))
+        #expect(old.excludedSources.isEmpty)
+        let exclusions = [OrbSourceExclusion(hostID: nil, source: "codex"), OrbSourceExclusion(hostID: UUID(), source: "future-source")]
+        let orb = OrbConfig(id: "a", excludedSources: exclusions)
+        let restored = try decoder.decode(OrbConfig.self, from: JSONEncoder().encode(orb))
+        #expect(restored.excludedSources == exclusions)
+        let doc = OrbEditing.setExcludedSources(exclusions, of: "a", in: OrbsDocument.fresh(id: "a"))
+        #expect(doc.orb("a")?.excludedSources == exclusions)
+    }
+}
