@@ -0,0 +1,58 @@
+import Foundation
+import Testing
+@testable import AgentSpeedCore
+
+@Suite("Orb host source selection")
+struct OrbHostSelectionTests {
+    @Test func filtersReadingsCostsAndCompletenessByInstance() {
+        let host = UUID()
+        var local = SourceStatus(kind: .codex, enabled: true, rootPath: "local", available: true, sessionCount: 1,
+                                 live: Rate(output: 10, total: 10), today: TokenTotals(requests: 1, output: 20), activeAgents: 0)
+        local.liveCost = LiveCost(microUsdPerSecond: 2, knownOutput: 10)
+        var remote = local
+        remote.live = Rate(output: 30, total: 30)
+        remote.liveCost = LiveCost(microUsdPerSecond: 6, knownOutput: 30)
+        remote.liveRateAvailable = false
+        remote.todayAvailable = false
+        var snapshot = SpeedSnapshot.empty
+        snapshot.sourceInstances = [SourceInstance(hostID: nil, status: local), SourceInstance(hostID: host, status: remote)]
+        let exclusion = OrbSourceExclusion(hostID: host, source: SourceKind.codex.rawValue)
+        let reading = OrbSubset.instanceReading(snapshot, sources: nil, excluded: [exclusion])
+        #expect(reading.live.output == 10)
+        #expect(reading.today.output == 20)
+        #expect(reading.liveRateAvailable && reading.todayAvailable)
+        #expect(reading.measuredPeakOutput == nil)
+        #expect(OrbSubset.instanceCost(snapshot, sources: nil, excluded: [exclusion], billable: .everything).microUsdPerSecond == 2)
+        #expect(!OrbSubset.instanceReading(snapshot, sources: nil, excluded: []).liveRateAvailable)
+        #expect(OrbSubset.instanceReading(snapshot, sources: SourceSet([.claudeCode]), excluded: []).state == .allNotFound)
+    }
+
+    @Test func localAndRemoteExclusionsAreIndependent() {
+        let host = UUID()
+        let status = SourceStatus(kind: .codex, enabled: true, rootPath: "", available: true, sessionCount: 0,
+                                  live: Rate(output: 5, total: 5), today: .zero, activeAgents: 0)
+        var snapshot = SpeedSnapshot.empty
+        snapshot.sourceInstances = [SourceInstance(hostID: nil, status: status), SourceInstance(hostID: host, status: status)]
+        let local = OrbSourceExclusion(hostID: nil, source: SourceKind.codex.rawValue)
+        #expect(OrbSubset.instanceReading(snapshot, sources: nil, excluded: [local]).live.output == 5)
+        #expect(OrbSubset.instances(snapshot, sources: nil, excluded: [local]).first?.hostID == host)
+    }
+    @Test func completionSelectionUsesHostAndKind() {
+        let host = UUID()
+        let exclusion = OrbSourceExclusion(hostID: host, source: SourceKind.codex.rawValue)
+        #expect(!OrbSubset.includes(hostID: host, source: .codex, sources: nil, excluded: [exclusion]))
+        #expect(OrbSubset.includes(hostID: nil, source: .codex, sources: nil, excluded: [exclusion]))
+        #expect(OrbSubset.includes(hostID: host, source: .claudeCode, sources: nil, excluded: [exclusion]))
+        #expect(!OrbSubset.includes(hostID: nil, source: .codex, sources: SourceSet([.claudeCode]), excluded: []))
+    }
+
+    @Test func unknownHostOnlyMattersForIncludedKinds() {
+        let host = UUID()
+        let set = SourceSet([.codex, .claudeCode])
+        let codex = OrbSourceExclusion(hostID: host, source: SourceKind.codex.rawValue)
+        let claude = OrbSourceExclusion(hostID: host, source: SourceKind.claudeCode.rawValue)
+        #expect(OrbSubset.hasUnknownSources(hosts: [host], sources: set, excluded: [codex]))
+        #expect(!OrbSubset.hasUnknownSources(hosts: [host], sources: set, excluded: [codex, claude]))
+        #expect(!OrbSubset.hasUnknownSources(hosts: [], sources: nil, excluded: []))
+    }
+}
