@@ -1,5 +1,16 @@
 import Foundation
 
+/// A source excluded from one orb; a nil host identifies this computer.
+public struct OrbSourceExclusion: Codable, Hashable, Sendable {
+    public var hostID: UUID?
+    public var source: String
+
+    public init(hostID: UUID?, source: String) {
+        self.hostID = hostID
+        self.source = source
+    }
+}
+
 /// Whether a floating orb's sources can show anything (DESIGN 2b, "Unavailable sources").
 public enum SubsetState: Equatable, Sendable {
     /// At least one source is available.
@@ -117,6 +128,60 @@ public struct CostReading: Equatable, Sendable {
 
 /// Per-orb views of a snapshot (METRICS 6.8, DESIGN 2b).
 public enum OrbSubset {
+    public static func includes(hostID: UUID?, source: SourceKind, sources: SourceSet?, excluded: [OrbSourceExclusion]) -> Bool {
+        (sources?.contains(source) ?? true) && !excluded.contains(OrbSourceExclusion(hostID: hostID, source: source.rawValue))
+    }
+
+    /// An unseen host can contain any kind that the orb has not explicitly excluded.
+    public static func hasUnknownSources(hosts: [UUID], sources: SourceSet?, excluded: [OrbSourceExclusion]) -> Bool {
+        hosts.contains { host in
+            SourceKind.allCases.contains { includes(hostID: host, source: $0, sources: sources, excluded: excluded) }
+        }
+    }
+
+    /// Select by source kind and host, retaining offline instances.
+    public static func instances(_ snapshot: SpeedSnapshot, sources: SourceSet?, excluded: [OrbSourceExclusion]) -> [SourceInstance] {
+        let instances = snapshot.sourceInstances.isEmpty ? snapshot.sources.map { SourceInstance(hostID: nil, status: $0) } : snapshot.sourceInstances
+        let exclusions = Set(excluded)
+        return instances.filter { (sources?.contains($0.status.kind) ?? true) && !exclusions.contains(OrbSourceExclusion(hostID: $0.hostID, source: $0.status.kind.rawValue)) }
+    }
+
+    public static func instanceReading(_ snapshot: SpeedSnapshot, sources: SourceSet?, excluded: [OrbSourceExclusion]) -> SubsetReading {
+        let selected = instances(snapshot, sources: sources, excluded: excluded)
