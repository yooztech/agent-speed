+import AgentSpeedCore
+import Testing
+
+@Suite("Speed store display integration")
+@MainActor
+struct SpeedStoreDisplayTests {
+    @Test func displayTransformDoesNotChangeLiveReportingOrPreview() {
+        let store = SpeedStore()
+        var reported = SpeedSnapshot.empty
+        store.addLiveListener { reported = $0 }
+        store.displaySnapshot = { local in
+            var result = local
+            result.live.output += 10
+            return result
+        }
+        var local = SpeedSnapshot.empty
+        local.live.output = 2
+        store.publishLive(local)
+        #expect(store.snapshot.live.output == 12)
+        #expect(store.liveSnapshot.live.output == 2)
+        #expect(reported.live.output == 2)
+
+        store.beginPreview()
+        var preview = SpeedSnapshot.empty
+        preview.live.output = 30
+        store.publishPreview(preview)
+        local.live.output = 4
+        store.publishLive(local)
+        store.refreshDisplay()
+        #expect(store.snapshot.live.output == 30)
+        #expect(reported.live.output == 4)
+        store.endPreview()
+        #expect(store.snapshot.live.output == 14)
+    }
+}
