+std::optional<std::string> scopedIdentity(const std::string& machineId, std::uint64_t uid) {
+    if (machineId.size() != 32 || machineId == std::string(32, '0')) return std::nullopt;
+    for (char c : machineId)
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return std::nullopt;
+    const auto identity = "agentspeed:account:v1:" + machineId + ':' + std::to_string(uid);
+    return agentspeed::report::sha256Hex(identity);
+}
