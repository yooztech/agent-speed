@@ -0,0 +1,55 @@
+import AgentSpeedCore
+import Foundation
+import Testing
+@testable import AgentSpeed
+
+@Suite("Live chart availability")
+struct LiveChartAvailabilityTests {
+    private func point(_ second: Double, _ value: Double, available: Bool = true) -> HistoryPoint {
+        HistoryPoint(time: Date(timeIntervalSince1970: second), measured: Rate(output: value, total: value), estimated: .zero, isAvailable: available)
+    }
+
+    @Test func unavailableSamplesSplitTheChartAndAreNotZeroValues() {
+        var snapshot = SpeedSnapshot.empty
+        snapshot.timestamp = Date(timeIntervalSince1970: 105)
+        snapshot.history = [point(101, 4), point(102, 99, available: false), point(103, 6)]
+        snapshot.liveRateAvailable = false
+        let series = ChartSeries(snapshot: snapshot, range: .oneMinute, metric: .output)
+        #expect(series.availableRuns == [0...0, 2...2])
+        #expect(series.maxTotal == 6)
+        #expect(series.live == nil)
+        #expect(series.nearestIndex(to: 102.5) == nil)
+    }
+
+    @Test func missingSecondsDoNotConnectAndUnavailableBucketStaysMissing() {
+        var snapshot = SpeedSnapshot.empty
+        snapshot.timestamp = Date(timeIntervalSince1970: 110)
+        snapshot.history = [point(100, 4), point(101, 5, available: false), point(106, 8), point(107, 10)]
+        snapshot.liveRateAvailable = false
+        let series = ChartSeries(snapshot: snapshot, range: .fiveMinutes, metric: .output)
+        #expect(!series.samples[0].isAvailable)
+        #expect(series.availableRuns == [1...1])
+        #expect(series.maxTotal == 9)
+    }
+
+    @Test func missingOneSecondMakesTwoSecondBucketUnavailable() {
+        var snapshot = SpeedSnapshot.empty
+        snapshot.timestamp = Date(timeIntervalSince1970: 110)
+        snapshot.history = [point(100, 4), point(101, 6), point(102, 20), point(104, 8), point(105, 10)]
+        snapshot.liveRateAvailable = false
+        let series = ChartSeries(snapshot: snapshot, range: .fiveMinutes, metric: .output)
+        #expect(series.samples.map(\.isAvailable) == [true, false, true, false])
+        #expect(series.availableRuns == [0...0, 2...2])
+        #expect(series.maxTotal == 9)
+    }
+
+    @Test func localHistoryRemainsAvailableByDefault() {
+        var snapshot = SpeedSnapshot.empty
+        snapshot.timestamp = Date(timeIntervalSince1970: 104)
+        snapshot.history = [point(101, 4), point(102, 6)]
+        snapshot.live = Rate(output: 8, total: 8)
+        let series = ChartSeries(snapshot: snapshot, range: .oneMinute, metric: .output)
+        #expect(series.availableRuns == [0...2])
+        #expect(series.live?.total == 8)
+    }
+}
