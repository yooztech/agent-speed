+std::string TimeZone::identity() const {
+    // TZif may describe UTC with redundant transitions or a zero-offset footer.
+    if (std::all_of(offsets_.begin(), offsets_.end(), [](auto offset) { return offset == 0; }) &&
+        (!rule_ || (rule_->stdOffset == 0 && (!rule_->hasDst || rule_->dstOffset == 0)))) return "UTC";
+    std::string result = "tz1;";
+    const auto append = [&](auto value) { result += std::to_string(value); result += ';'; };
+    append(transitions_.size());
+    for (auto value : transitions_) append(value);
+    append(indices_.size());
+    for (auto value : indices_) append(value);
+    append(offsets_.size());
+    for (auto value : offsets_) append(value);
+    append(isDst_.size());
+    for (bool value : isDst_) append(value);
+    append(rule_.has_value());
+    if (rule_) {
+        append(rule_->stdOffset); append(rule_->dstOffset); append(rule_->hasDst);
+        const auto date = [&](const Rule::Date& d) {
+            append(static_cast<int>(d.kind)); append(d.month); append(d.week); append(d.day); append(d.timeSeconds);
+        };
+        date(rule_->start); date(rule_->end);
+    }
+    return result;
+}
