+TEST(CollectorIntegration, ViewerTimezoneIsAppliedToSnapshotAndHistory) {
+    char home[] = "/tmp/agentspeed-collector-zone-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    int input[2], output[2];
+    ASSERT_EQ(pipe(input), 0);
+    ASSERT_EQ(pipe(output), 0);
+    const auto pid = fork();
+    ASSERT_GE(pid, 0);
+    if (pid == 0) {
+        dup2(input[0], STDIN_FILENO);
+        dup2(output[1], STDOUT_FILENO);
+        close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+        setenv("HOME", home, 1);
+        execl(AGENTSPEED_COLLECTOR_PATH, AGENTSPEED_COLLECTOR_PATH, nullptr);
+        _exit(127);
+    }
+    close(input[0]); close(output[1]);
+    const std::string request = "{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"UTC\"}\n";
+    EXPECT_EQ(write(input[1], request.data(), request.size()), static_cast<ssize_t>(request.size()));
+    std::string data;
+    bool snapshot = false, history = false;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(25);
+    while (std::chrono::steady_clock::now() < deadline && !(snapshot && history)) {
+        pollfd fd{output[0], POLLIN, 0};
+        if (poll(&fd, 1, 1000) <= 0) continue;
+        char bytes[8192];
+        const auto n = read(output[0], bytes, sizeof(bytes));
+        if (n <= 0) break;
+        data.append(bytes, static_cast<std::size_t>(n));
+        std::size_t end;
+        while ((end = data.find('\n')) != std::string::npos) {
+            agentspeed::json::Document doc;
+            const auto line = data.substr(0, end);
+            data.erase(0, end + 1);
+            if (!doc.parse(line) || doc.root()["timezone"].string() != "UTC") continue;
+            if (doc.root()["type"].string() == "snapshot") snapshot = true;
+            if (doc.root()["type"].string() == "history") history = true;
+        }
+    }
+    close(input[1]); close(output[0]);
+    int status = 0;
+    waitpid(pid, &status, 0);
+    EXPECT_TRUE(snapshot);
+    EXPECT_TRUE(history);
+    EXPECT_TRUE(WIFEXITED(status));
+    std::filesystem::remove_all(home);
+}
