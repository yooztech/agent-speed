+std::int64_t todayStart(std::int64_t now, const agentspeed::TimeZone& zone) {
+    constexpr std::int64_t day = 86400000;
+    const auto wall = now + zone.offsetMs(now);
+    const auto midnight = (wall >= 0 ? wall / day : (wall - day + 1) / day) * day;
+    auto start = midnight - zone.offsetMs(now);
+    for (int i = 0; i < 3; ++i) start = midnight - zone.offsetMs(start);
+    if (start + zone.offsetMs(start) != midnight) {
+        // A timezone transition can skip midnight; find the first instant on this local day.
+        auto low = now - 2 * day, high = now;
+        while (low + 1 < high) {
+            const auto mid = low + (high - low) / 2;
+            if (mid + zone.offsetMs(mid) < midnight) low = mid; else high = mid;
+        }
+        start = high;
+    }
+    return start;
+}
