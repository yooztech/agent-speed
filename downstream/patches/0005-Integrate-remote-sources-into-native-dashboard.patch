diff --git a/macos/Sources/AgentSpeedCore/CombinedLiveHistory.swift b/macos/Sources/AgentSpeedCore/CombinedLiveHistory.swift
new file mode 100644
index 00000000..fc158cad
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CombinedLiveHistory.swift
@@ -0,0 +1,30 @@
+import Foundation
+
+/// Rolling samples of the displayed combined rate. Missing seconds remain absent, not zero.
+public struct CombinedLiveHistory: Sendable {
+    private var points: [HistoryPoint] = []
+
+    public init() {}
+
+    public mutating func record(snapshot: SpeedSnapshot) -> [HistoryPoint] {
+        let second = floor(snapshot.timestamp.timeIntervalSince1970)
+        guard second.isFinite else { return points }
+        let time = Date(timeIntervalSince1970: second)
+        let share = snapshot.liveEstimatedShare.isFinite ? min(1, max(0, snapshot.liveEstimatedShare)) : 0
+        let rate = snapshot.live
+        let point = HistoryPoint(
+            time: time,
+            measured: Rate(output: rate.output * (1 - share), total: rate.total * (1 - share)),
+            estimated: Rate(output: rate.output * share, total: rate.total * share),
+            isAvailable: snapshot.liveRateAvailable
+        )
+        // A clock correction must not make the history unordered or reuse future samples.
+        while let last = points.last, last.time >= time { points.removeLast() }
+        points.append(point)
+        let cutoff = time.addingTimeInterval(-299)
+        if let first = points.firstIndex(where: { $0.time >= cutoff }), first > 0 {
+            points.removeFirst(first)
+        }
+        return points
+    }
+}
