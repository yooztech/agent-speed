From 686b3dddb8ec6e4fab2f8681d5fcbad22a28e828 Mon Sep 17 00:00:00 2001
From: yooztech <service@yooztech.com>
Date: Thu, 5 Nov 2026 18:44:25 +0800
Subject: [PATCH] Stamp fork.2 release version

---
 VERSION                       | 2 +-
 tests/test_release_version.py | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/VERSION b/VERSION
index e4ed8def..3e4fc41d 100644
--- a/VERSION
+++ b/VERSION
@@ -1 +1 @@
-1.6.1-fork.1
+1.6.1-fork.2
diff --git a/tests/test_release_version.py b/tests/test_release_version.py
index d36187ff..008cbe17 100644
--- a/tests/test_release_version.py
+++ b/tests/test_release_version.py
@@ -25,12 +25,12 @@ class ReleaseVersionTests(unittest.TestCase):
     def test_fork_default_and_numeric_bundle_versions(self):
         result = self.parse()
         self.assertEqual(result.returncode, 0, result.stderr)
-        self.assertEqual(result.stdout.strip(), "1.6.1-fork.1|1.6.1|1.6.1")
+        self.assertEqual(result.stdout.strip(), "1.6.1-fork.2|1.6.1|1.6.1")
         template = (ROOT / "macos/Resources/Info.plist").read_text()
-        info = plistlib.loads(template.replace("__VERSION__", "1.6.1-fork.1")
+        info = plistlib.loads(template.replace("__VERSION__", "1.6.1-fork.2")
                               .replace("__NUMERIC_VERSION__", "1.6.1")
                               .replace("__BUILD__", "1.6.1").encode())
-        self.assertEqual(info["AgentSpeedVersion"], "1.6.1-fork.1")
+        self.assertEqual(info["AgentSpeedVersion"], "1.6.1-fork.2")
         self.assertEqual(info["CFBundleShortVersionString"], "1.6.1")
         self.assertEqual(info["CFBundleVersion"], "1.6.1")
 
