+TEST(CollectorProtocol, ConnectionIdsAreStableAndIndependent) {
+    collector::Protocol first, second;
+    agentspeed::Snapshot snapshot;
+    agentspeed::AgentRow a;
+    a.id = "private-a";
+    snapshot.agents.push_back(a);
+    agentspeed::json::Document one;
+    const auto oneWire = first.snapshot(snapshot);
+    ASSERT_TRUE(one.parse(oneWire));
+    EXPECT_EQ(one.root()["agents"].at(0)["id"].string(), "1");
+    snapshot.agents[0].id = "private-b";
+    agentspeed::json::Document two;
+    const auto twoWire = first.snapshot(snapshot);
+    ASSERT_TRUE(two.parse(twoWire));
+    EXPECT_EQ(two.root()["agents"].at(0)["id"].string(), "2");
+    agentspeed::json::Document reconnected;
+    const auto reconnectWire = second.snapshot(snapshot);
+    ASSERT_TRUE(reconnected.parse(reconnectWire));
+    EXPECT_EQ(reconnected.root()["agents"].at(0)["id"].string(), "1");
+}
