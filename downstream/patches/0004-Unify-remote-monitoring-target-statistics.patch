--- /dev/null
+++ b/macos/Sources/AgentSpeed/Dashboard/RemoteDashboard.swift
@@ -0,0 +1,143 @@
+import AgentSpeedCore
+import SwiftUI
+
+/// Remote values are shown independently of the local gauge, traffic and accounting pipelines.
+struct RemoteDashboard: View {
+    let model: AppModel
+    let hostID: UUID
+
+    var body: some View {
+        let host = model.remoteHosts.hosts.first { $0.id == hostID }
+        let state = model.remoteHosts.states[hostID]
+        ScrollView {
+            VStack(alignment: .leading, spacing: DashboardLayout.sectionSpacing) {
+                HStack {
+                    Text(host.map { $0.label.isEmpty ? $0.destination : $0.label } ?? "Remote host")
+                        .font(.headline)
+                    Spacer()
+                    Text(host?.enabled != true ? "DISABLED" : state?.online == true ? "LIVE" : "OFFLINE · STALE")
+                        .font(.caption.weight(.semibold))
+                        .foregroundStyle(state?.online == true && host?.enabled == true ? Color.green : Color.secondary)
+                }
+                if let error = state?.error { Text(error).font(.caption).foregroundStyle(.secondary) }
+                if let state, let message = state.snapshot {
+                    remoteContents(message, state: state)
+                } else {
+                    Text("Remote data unavailable").foregroundStyle(.secondary)
+                }
+                if !model.remoteHosts.hosts.isEmpty {
+                    SectionDivider()
+                    RemoteHostsView(model: model)
+                }
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+    }
+
+    @ViewBuilder
+    private func remoteContents(_ message: RemoteMessage, state: RemoteHostState) -> some View {
+        let l10n = model.l10n
+        VStack(alignment: .leading, spacing: Spacing.xs) {
+            Text(l10n("unit.tokS")).font(.caption).foregroundStyle(.secondary)
+            Text(rate(model.settings.metric == .output ? message.liveOutput : message.liveTotal))
+                .font(.system(size: 32, weight: .semibold, design: .rounded))
+            if let share = message.estimatedShare, share > 0 {
+                Text("Includes estimated live output").font(.caption).foregroundStyle(.secondary)
+            }
+            Text("Generating: \(message.generating.map(String.init) ?? "unavailable") · Tools: \(message.tools.map(String.init) ?? "unavailable")")
+                .font(.caption).foregroundStyle(.secondary)
+        }
+        SectionDivider()
+        unavailable(l10n("mac.dashboard.chart"), detail: "Remote live history unavailable")
+        SectionDivider()
+        VStack(alignment: .leading, spacing: Spacing.xs) {
+            SectionTitle(text: l10n("dashboard.sources"), latin: model.dashboardLatinCaps)
+            if let sources = message.sources {
+                if sources.isEmpty { Text(l10n("dashboard.sources.empty")).foregroundStyle(.secondary) }
+                ForEach(sources.indices, id: \.self) { index in
+                    let source = sources[index]
+                    HStack {
+                        Text(source.source)
+                        Spacer()
+                        Text(SpeedFormat.tokens(source.todayOutput))
+                        Text(rate(model.settings.metric == .output ? source.liveOutput : source.liveTotal))
+                            .monospacedDigit().foregroundStyle(.secondary)
+                    }.font(DashboardFont.row)
+                    Text("Input: \(SpeedFormat.tokens(source.todayInput)) · Requests: \(source.todayRequests) · Sessions: \(source.sessions) · Active: \(source.activeAgents)")
+                        .font(.caption).foregroundStyle(.secondary)
+                    if let cost = source.todayCostMicroUsd, let unpriced = source.unpricedRequests {
+                        Text("Cost: \(Double(cost) / 1_000_000, format: .currency(code: "USD")) · Unpriced requests: \(unpriced)")
+                            .font(.caption).foregroundStyle(.secondary)
+                    } else {
+                        Text("Cost unavailable").font(.caption).foregroundStyle(.secondary)
+                    }
+                }
+            } else { Text("Unavailable").foregroundStyle(.secondary) }
+        }
+        SectionDivider()
+        VStack(alignment: .leading, spacing: Spacing.xs) {
+            SectionTitle(text: l10n("dashboard.agents"), latin: model.dashboardLatinCaps)
+            if let agents = message.agents {
+                if agents.isEmpty { Text("No active agents").foregroundStyle(.secondary) }
+                ForEach(agents) { agent in
+                    VStack(alignment: .leading, spacing: 2) {
+                        HStack {
+                            Text(agent.source).fontWeight(.medium)
+                            Text(agent.phase).foregroundStyle(.secondary)
+                            Spacer()
+                            Text(rate(model.settings.metric == .output ? agent.liveOutput : agent.liveTotal))
+                                .monospacedDigit()
+                        }
+                        Text([agent.model ?? "Model unavailable", agent.effort, agent.speed].compactMap { $0 }.joined(separator: " · "))
+                            .font(.caption).foregroundStyle(.secondary)
+                    }.font(DashboardFont.row)
+                }
+                Text("Project details unavailable").font(.caption).foregroundStyle(.secondary)
+            } else { Text("Unavailable").foregroundStyle(.secondary) }
+        }
+        SectionDivider()
+        VStack(alignment: .leading, spacing: Spacing.xs) {
+            HStack {
+                SectionTitle(text: l10n("dashboard.today"), latin: model.dashboardLatinCaps)
+                Spacer()
+                Button(l10n("mac.dashboard.history")) { model.commands?.showHistory(source: nil) }
+                    .buttonStyle(DashboardInlineButtonStyle())
+            }
+            if let day = message.todayDay { Text(day).font(.caption).foregroundStyle(.secondary) }
+            if message.partialHistory == true {
+                Text("History is partial").font(.caption).foregroundStyle(.secondary)
+            }
+            remoteMetric(l10n("today.output"), message.todayOutput.map(SpeedFormat.tokens))
+            remoteMetric(l10n("today.input"), message.todayInput.map(SpeedFormat.tokens))
+            remoteMetric(l10n("today.requests"), message.todayRequests.map(String.init))
+            remoteMetric(l10n("today.average"), message.todayAverage.map(SpeedFormat.speed))
+            remoteMetric("\(l10n("today.peak")) (output)", message.peakToday.map(SpeedFormat.speed))
+            if state.capabilities.cost, let snapshot = state.dashboardSnapshot, let requests = message.todayRequests {
+                remoteMetric("Cost", model.cost.tallyText(snapshot.todayCost, requests: requests))
+            } else {
+                remoteMetric("Cost", nil)
+            }
+            Text("Token breakdown unavailable").font(.caption).foregroundStyle(.secondary)
+        }
+        if model.settings.trafficEnabled {
+            SectionDivider()
+            unavailable("Traffic", detail: "Remote traffic unavailable")
+        }
+    }
+
+    private func rate(_ value: Double?) -> String {
+        value.map(SpeedFormat.speed) ?? "Unavailable"
+    }
+
+    private func remoteMetric(_ label: String, _ value: String?) -> some View {
+        HStack { Text(label); Spacer(); Text(value ?? "Unavailable").monospacedDigit() }
+            .font(DashboardFont.row)
+    }
+
+    private func unavailable(_ title: String, detail: String) -> some View {
+        VStack(alignment: .leading, spacing: Spacing.xs) {
+            SectionTitle(text: title, latin: model.dashboardLatinCaps)
+            Text(detail).font(DashboardFont.row).foregroundStyle(.secondary)
+        }
+    }
+}
