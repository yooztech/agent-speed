--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/RemoteSnapshot.swift
@@ -0,0 +1,116 @@
+import Foundation
+import AgentSpeedCore
+
+/// Availability is separate from the non-optional fields of the native display model.
+struct RemoteCapabilities {
+    var live = false
+    var sources = false
+    var peak = false
+    var cost = false
+    var history = false
+    var todayStart = false
+    let traffic = false
+    let todayBreakdown = false
+    let chart = false
+    let agentProject = false
+    let liveCost = false
+}
+
+extension RemoteHostState {
+    var capabilities: RemoteCapabilities {
+        var result = RemoteCapabilities()
+        if let snapshot {
+            result.live = snapshot.liveOutput != nil && snapshot.liveTotal != nil
+            result.sources = snapshot.sources != nil
+            result.peak = snapshot.peakToday != nil
+            result.cost = snapshot.todayCostMicroUsd != nil && snapshot.todayUnpricedRequests != nil
+            result.todayStart = snapshot.todayStartMs != nil
+        }
+        result.history = historyUsage != nil
+        return result
+    }
+
+    var dashboardSnapshot: SpeedSnapshot? {
+        guard let message = snapshot else { return nil }
+        let timestamp = message.nowMs.map { Date(timeIntervalSince1970: $0 / 1000) } ?? .distantPast
+        let sources = (message.sources ?? []).compactMap { source -> SourceStatus? in
+            guard let kind = SourceKind(rawValue: source.source) else { return nil }
+            let live = Rate(output: source.liveOutput ?? 0, total: source.liveTotal ?? 0)
+            let share = source.estimatedShare ?? 0
+            return SourceStatus(kind: kind, enabled: source.enabled, rootPath: "", available: source.available,
+                sessionCount: source.sessions, live: live,
+                today: TokenTotals(requests: source.todayRequests, input: source.todayInput, output: source.todayOutput),
+                activeAgents: source.activeAgents,
+                liveEstimated: Rate(output: live.output * share, total: live.total * share),
+                todayCost: CostTally(costMicroUsd: source.todayCostMicroUsd ?? 0, unpricedRequests: source.unpricedRequests ?? source.todayRequests))
+        }
+        let agents = (message.agents ?? []).compactMap { agent -> AgentStatus? in
+            guard let source = SourceKind(rawValue: agent.source), let phase = AgentPhase(rawValue: agent.phase) else { return nil }
+            func modes(configured: Bool) -> ExecutionModes {
+                let evidence: ExecutionModeEvidence = configured ? .configured : .selected
+                let scope: ExecutionModeScope = configured ? .configuration : .session
+                var facts: [ExecutionModeFact] = []
+                if (agent.effortConfigured == true) == configured, let effort = agent.effort,
+                   let fact = ExecutionModeFact(kind: .effort, rawValue: effort, evidence: evidence, scope: scope) { facts.append(fact) }
+                if (agent.speedConfigured == true) == configured, let speed = agent.speed,
+                   let fact = ExecutionModeFact(kind: .serviceTier, rawValue: speed, evidence: evidence, scope: scope) { facts.append(fact) }
+                return ExecutionModes(facts)
+            }
+            var status = AgentStatus(id: agent.id, source: source, project: "", model: agent.model, phase: phase,
+                isSubagent: agent.subagent, live: Rate(output: agent.liveOutput ?? 0, total: agent.liveTotal ?? 0),
+                recentSpeed: nil, lastActivity: agent.lastLineMs.map { Date(timeIntervalSince1970: $0 / 1000) } ?? timestamp,
+                parentId: agent.parentId, modes: modes(configured: false))
+            status.configuredModes = modes(configured: true)
+            return status
+        }
+        return SpeedSnapshot(timestamp: timestamp, state: .running,
+            live: Rate(output: message.liveOutput ?? 0, total: message.liveTotal ?? 0),
+            liveEstimatedShare: message.estimatedShare ?? 0,
+            peakToday: Rate(output: message.peakToday ?? 0), peakTodayAt: nil,
+            averageToday: message.todayAverage,
+            today: TokenTotals(requests: message.todayRequests ?? 0, input: message.todayInput ?? 0, output: message.todayOutput ?? 0),
+            sources: sources, agents: agents, generatingCount: message.generating ?? 0, toolsCount: message.tools ?? 0,
+            history: [], lastResponse: nil, warnings: message.partialHistory == true ? [.partialHistory] : [],
+            dayStart: message.todayStartMs.map { Date(timeIntervalSince1970: $0 / 1000) } ?? .distantPast,
+            todayCost: CostTally(costMicroUsd: message.todayCostMicroUsd ?? 0, unpricedRequests: message.todayUnpricedRequests ?? (message.todayRequests ?? 0)))
+    }
+
+    var historyUsage: [DailyUsage]? {
+        guard historyPartial != nil else { return nil }
+        var result: [DailyUsage] = []
+        for day in days {
+            guard let source = SourceKind(rawValue: day.source), let unfinalized = day.unfinalized,
+                  let agents = day.agents, let models = day.models, let modes = day.modes,
+                  let unpriced = day.unpriced, day.measuredMs.isFinite, day.measuredMs >= 0,
+                  day.measuredMs < Double(Int64.max) else { return nil }
+            let modelUsage = models.map { model in
+                ModelUsage(model: model.model, requests: model.requests, output: model.output,
+                    measuredOutput: model.measuredOutput, measuredMs: model.measuredMs,
+                    cost: remoteCost(model.costMicroUsd, model.unpricedRequests))
+            }
+            var modeUsage: [ExecutionModeUsage] = []
+            for mode in modes {
+                guard let kind = ExecutionModeKind(rawValue: mode.kind) else { return nil }
+                modeUsage.append(ExecutionModeUsage(model: mode.model,
+                    attribution: ExecutionModeAttribution(kind: kind, mode: mode.mode, evidence: mode.evidence, provider: mode.provider),
+                    requests: mode.requests, output: mode.output, measuredOutput: mode.measuredOutput, measuredMs: mode.measuredMs))
+            }
+            let facts = unpriced.map { fact in
+                UnpricedFact(key: UnpricedFactKey(model: fact.model, provider: fact.provider, fast: fact.fast, noDate: fact.noDate), requests: fact.count)
+            }
+            let cost = remoteCost(day.costMicroUsd, day.unpricedRequests)
+            result.append(DailyUsage(day: day.day, source: source,
+                totals: TokenTotals(requests: day.requests, input: day.input, cachedInput: day.cachedInput,
+                    cacheWriteInput: day.cacheWriteInput, output: day.output, reasoning: day.reasoning),
+                measuredOutput: day.measuredOutput, measuredMs: Int64(day.measuredMs), unfinalized: unfinalized,
+                agents: agents, peak: day.peak, models: modelUsage, cost: cost, modeUsage: modeUsage,
+                unpriced: UnpricedReading(requests: day.requests, noCostData: cost == nil ? day.requests : 0, facts: facts)))
+        }
+        return result
+    }
+}
+
+private func remoteCost(_ cost: Int64?, _ unpriced: Int?) -> CostTally? {
+    guard let cost, let unpriced else { return nil }
+    return CostTally(costMicroUsd: cost, unpricedRequests: unpriced)
+}
