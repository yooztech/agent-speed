+        #expect(motion.frame.reveal == painted.reveal && motion.frame.disc == painted.disc)
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: false, now: 11, reducedMotion: false)
+        motion.sample(20)
+        #expect(motion.frame.reveal == 1 && motion.frame.disc == 0 && !motion.active)
+    }
+
+
+    @Test func acquiredIntentSurvivesClassificationChangesUntilDeparture() {
+        let outside = CGPoint(x: 10, y: 10)
+        let inside = CGPoint(x: 20, y: 20)
+        var intent = QuotaGripIntent()
+        let initiallyAcquired = intent.update(outside, entry: false, envelope: false)
+        #expect(!initiallyAcquired)
+        let acquiredOnEntry = intent.update(inside, entry: true, envelope: true)
+        #expect(acquiredOnEntry)
+        let remainsAcquired = intent.update(inside, entry: false, envelope: true)
+        #expect(remainsAcquired)
+        let acquiredAfterDeparture = intent.update(outside, entry: false, envelope: false)
+        #expect(!acquiredAfterDeparture)
+        let acquiredWithoutMovement = intent.update(outside, entry: true, envelope: true)
+        #expect(!acquiredWithoutMovement)
+        let reacquiredOnEntry = intent.update(inside, entry: true, envelope: true)
+        #expect(reacquiredOnEntry)
+        let acquiredWhileHeld = intent.update(outside, entry: false, envelope: false, held: true)
+        #expect(acquiredWhileHeld)
+        let acquiredAfterRelease = intent.update(outside, entry: false, envelope: false)
+        #expect(!acquiredAfterRelease)
+        let acquiredAgain = intent.update(inside, entry: true, envelope: true)
+        #expect(acquiredAgain)
+        intent.reset()
+        #expect(!intent.acquired)
+        let acquiredAfterReset = intent.update(inside, entry: true, envelope: true)
+        #expect(!acquiredAfterReset)
+    }
+
+    @Test func stationaryPointerCannotAcquireFromClassificationChange() {
+        let point = CGPoint(x: 10, y: 10)
+        var intent = QuotaGripIntent()
+        let initiallyAcquired = intent.update(point, entry: false, envelope: false)
+        #expect(!initiallyAcquired)
+        let acquiredWithoutMovement = intent.update(point, entry: true, envelope: true)
+        #expect(!acquiredWithoutMovement)
+    }
+
+    @Test func pressRetainsPaintedPoseAndReducedMotionSettlesWithoutFrames() {
+        var motion = QuotaGripMotion()
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: false, now: 0, reducedMotion: true)
+        #expect(motion.frame.reveal == 1 && !motion.active)
+        let painted = motion.frame
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: true, now: 0.01, reducedMotion: true)
+        #expect(motion.frame.reveal == painted.reveal && motion.frame.squeeze == 1 && !motion.active)
+        motion.setTargets(expanded: false, reveal: false, hover: false, held: false, now: 1, reducedMotion: true)
+        #expect(motion.frame.arc == 0 && motion.frame.reveal == 0 && !motion.active)
+    }
+
+    @Test func tooltipTraversalUsesOne250MillisecondGrace() {
+        let clock = Clock()
+        let hover = QuotaNotchHover(scheduler: clock)
+        var changes = 0
+        hover.onChange = { changes += 1 }
+        #expect(!hover.keepExpanded && !hover.expanded)
+        hover.move(to: .cell("codex"))
+        hover.move(to: .outside)
+        clock.advance(0.15)
+        #expect(hover.activeSource == "codex" && hover.expanded)
+        hover.move(to: .tooltip)
+        clock.advance(0.3)
+        #expect(hover.activeSource == "codex" && hover.expanded && !hover.graceActive)
+        hover.move(to: .outside)
+        clock.advance(0.1)
+        hover.move(to: .bar)
+        hover.move(to: .outside)
+        #expect(clock.items.count == 2, "Crossing non-cell regions must not restart the same grace")
+        clock.advance(0.149)
+        #expect(hover.activeSource == "codex" && hover.expanded && hover.graceActive)
+        let beforeExpiry = changes
+        clock.advance(0.001)
+        #expect(hover.activeSource == nil && !hover.expanded && !hover.graceActive)
+        #expect(changes == beforeExpiry + 1, "Expiry must notify the native card/collapse consumer")
+        clock.advance(0.25)
+        #expect(changes == beforeExpiry + 1, "The grace expires only once")
+        hover.reset()
+    }
+
+    @Test func sourceSwitchAndKeepExpandedNeverFreezeTheOldTooltip() {
+        let clock = Clock()
+        let hover = QuotaNotchHover(scheduler: clock)
+        hover.keepExpanded = true
+        hover.move(to: .cell("codex")); hover.move(to: .outside)
+        clock.advance(0.1)
+        hover.move(to: .cell("test-source"))
+        clock.advance(0.15)
+        #expect(hover.activeSource == "test-source" && !hover.graceActive)
+        hover.move(to: .outside)
+        clock.advance(0.249)
+        #expect(hover.activeSource == "test-source" && hover.graceActive)
+        clock.advance(0.001)
+        #expect(hover.expanded && hover.activeSource == nil && !hover.graceActive)
+        hover.reset()
+        #expect(hover.expanded)
+        hover.keepExpanded = false
+        #expect(!hover.expanded)
+    }
+
+    @Test func hidingCancelsPendingInteractionAndCanReopen() {
+        let clock = Clock()
+        let hover = QuotaNotchHover(scheduler: clock)
+        hover.move(to: .cell("codex")); hover.move(to: .outside)
+        clock.advance(0.1)
+        hover.reset()
+        #expect(!hover.expanded && hover.activeSource == nil && !hover.graceActive)
+        hover.move(to: .bar)
+        #expect(hover.expanded)
+        hover.move(to: .cell("test-source")); hover.move(to: .outside)
+        clock.advance(0.15)
+        #expect(hover.activeSource == "test-source" && hover.expanded && hover.graceActive,
+                "The cancelled pre-hide expiry must not clear a reopened card")
+        clock.advance(0.1)
+        #expect(hover.activeSource == nil && !hover.expanded && !hover.graceActive)
+        hover.reset()
+    }
+
+}
