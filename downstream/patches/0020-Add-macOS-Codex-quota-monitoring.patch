index 00000000..ed1c6a9c
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift
@@ -0,0 +1,832 @@
+import Foundation
+#if canImport(SwiftUI)
+import AgentSpeedCore
+import AppKit
+import SwiftUI
+#endif
+
+enum NotchEdge: String, CaseIterable, Sendable {
+    case right, left, top, bottom
+    var isVertical: Bool { self == .right || self == .left }
+}
+
+/// An orthogonal edge transform, also used by the portable production mask.
+struct QuotaGripTransform {
+    var a: CGFloat = 1, b: CGFloat = 0, c: CGFloat = 0, d: CGFloat = 1, tx: CGFloat = 0, ty: CGFloat = 0
+    func point(_ p: CGPoint) -> CGPoint { CGPoint(x: a * p.x + c * p.y + tx, y: b * p.x + d * p.y + ty) }
+    func inverse(_ p: CGPoint) -> CGPoint {
+        let x = p.x - tx, y = p.y - ty
+        return CGPoint(x: a * x + b * y, y: c * x + d * y)
+    }
+    func followed(by t: Self) -> Self {
+        Self(a: t.a * a + t.c * b, b: t.b * a + t.d * b,
+             c: t.a * c + t.c * d, d: t.b * c + t.d * d,
+             tx: t.a * tx + t.c * ty + t.tx, ty: t.b * tx + t.d * ty + t.ty)
+    }
+}
+
+extension QuotaGripTransform {
+    init(edge: NotchEdge, depth: CGFloat, offset: CGFloat) {
+        switch edge {
+        case .left: self.init(ty: offset)
+        case .right: self.init(a: -1, tx: depth, ty: offset)
+        case .top: self.init(a: 0, b: 1, c: 1, d: 0, tx: offset)
+        case .bottom: self.init(a: 0, b: -1, c: 1, d: 0, tx: offset, ty: depth)
+        }
+    }
+}
+
+/// Keep filled components and clips separate. SwiftUI Path's CSG normalization
+/// can turn a stroked arc intersected with a circle into the whole clip circle.
+/// These are the actual primitives used for both drawing and source-mask coverage.
+enum QuotaGripContour {
+    case ellipse(CGRect)
+    case rect(CGRect)
+    case arc(center: CGPoint, radius: CGFloat, from: CGFloat, to: CGFloat, width: CGFloat)
+    case strand(CGPoint, CGPoint, basis: CGFloat, pinch: CGFloat, top: CGFloat)
+
+    var bounds: CGRect {
+        switch self {
+        case let .ellipse(rect), let .rect(rect): return rect
+        case let .arc(center, radius, from, to, width):
+            let start = -CGFloat.pi + from * .pi / 2, end = -CGFloat.pi + to * .pi / 2
+            let x0 = center.x + radius * cos(start), x1 = center.x + radius * cos(end)
+            let y0 = center.y + radius * sin(start), y1 = center.y + radius * sin(end)
+            return CGRect(x: min(x0, x1) - width / 2, y: min(y0, y1) - width / 2,
+                          width: abs(x1 - x0) + width, height: abs(y1 - y0) + width)
+        case let .strand(from, to, basis, pinch, top):
+            let half = max(basis, pinch, top)
+            return CGRect(x: min(from.x, to.x) - half, y: min(from.y, to.y) - half,
+                          width: abs(to.x - from.x) + 2 * half, height: abs(to.y - from.y) + 2 * half)
+        }
+    }
+    func contains(_ p: CGPoint) -> Bool {
+        switch self {
+        case let .ellipse(rect):
+            guard rect.width > 0 && rect.height > 0 else { return false }
+            let x = (p.x - rect.midX) / (rect.width / 2), y = (p.y - rect.midY) / (rect.height / 2)
+            return x * x + y * y <= 1
+        case let .rect(rect): return rect.contains(p)
+        case let .arc(center, radius, from, to, width):
+            let x = p.x - center.x, y = p.y - center.y
+            let start = -CGFloat.pi + from * .pi / 2, end = -CGFloat.pi + to * .pi / 2
+            let angle = atan2(y, x)
+            let inSector = (angle >= start && angle <= end) || (angle == .pi && start == -.pi)
+            if inSector && abs(hypot(x, y) - radius) <= width / 2 { return true }
+            let half = width / 2
+            return hypot(x - radius * cos(start), y - radius * sin(start)) <= half
+                || hypot(x - radius * cos(end), y - radius * sin(end)) <= half
+        case let .strand(from, to, basis, pinch, top):
+            // In the strand's basis the two quadratic sides share a linear
+            // longitudinal coordinate. Their exact half-width is quadratic.
+            let dx = to.x - from.x, dy = to.y - from.y, distance = hypot(dx, dy)
+            guard distance > 0 else { return false }
+            let x = p.x - from.x, y = p.y - from.y
+            let t = (x * dx + y * dy) / (distance * distance)
+            guard t >= 0 && t <= 1 else { return false }
+            let half = (1 - t) * (1 - t) * basis + 2 * (1 - t) * t * pinch + t * t * top
+            return abs((-dy * x + dx * y) / distance) <= half * distance / max(distance, 0.001)
+        }
+    }
+    func outlined(_ width: CGFloat) -> Self {
+        switch self {
+        case let .ellipse(rect): return .ellipse(rect.insetBy(dx: -width / 2, dy: -width / 2))
+        case let .arc(center, radius, from, to, thickness): return .arc(center: center, radius: radius, from: from, to: to, width: thickness + width)
+        // Strands and rectangles are input routes or liquid source only, never
+        // outlined vector paint. Keep their original contour.
+        case .strand, .rect: return self
+        }
+    }
+}
+
+struct QuotaGripFootprint {
+    struct Clip {
+        var contour: QuotaGripContour
+        var transform = QuotaGripTransform()
+        func contains(_ point: CGPoint) -> Bool { contour.contains(transform.inverse(point)) }
+    }
+    struct Part {
+        var contour: QuotaGripContour
+        var clip: Clip?
+        var transform = QuotaGripTransform()
+        func contains(_ point: CGPoint) -> Bool {
+            contour.contains(transform.inverse(point)) && (clip?.contains(point) ?? true)
+        }
+    }
+    var parts: [Part] = []
+    init() {}
+    init(_ contour: QuotaGripContour) { parts = [Part(contour: contour)] }
+    var isEmpty: Bool { parts.isEmpty }
+    var boundingRect: CGRect {
+        func mapped(_ box: CGRect, _ transform: QuotaGripTransform) -> CGRect {
+            let p = transform.point(CGPoint(x: box.minX, y: box.minY))
+            let q = transform.point(CGPoint(x: box.maxX, y: box.maxY))
+            return CGRect(x: min(p.x, q.x), y: min(p.y, q.y), width: abs(q.x - p.x), height: abs(q.y - p.y))
+        }
+        return parts.reduce(CGRect.null) { result, part in
+            var box = mapped(part.contour.bounds, part.transform)
+            if let clip = part.clip { box = box.intersection(mapped(clip.contour.bounds, clip.transform)) }
+            return result.union(box)
+        }
+    }
+    func contains(_ point: CGPoint) -> Bool { parts.contains { $0.contains(point) } }
+    func union(_ other: Self) -> Self { var result = self; result.parts.append(contentsOf: other.parts); return result }
+    func clipped(to clip: QuotaGripContour) -> Self {
+        var result = self
+        for index in result.parts.indices { result.parts[index].clip = Clip(contour: clip) }
+        return result
+    }
+    func outlined(_ width: CGFloat) -> Self {
+        var result = self
+        for index in result.parts.indices { result.parts[index].contour = result.parts[index].contour.outlined(width) }
+        return result
+    }
+    func applying(_ transform: QuotaGripTransform) -> Self {
+        var result = self
+        for index in result.parts.indices {
+            result.parts[index].transform = result.parts[index].transform.followed(by: transform)
+            if let clip = result.parts[index].clip {
+                result.parts[index].clip?.transform = clip.transform.followed(by: transform)
+            }
+        }
+        return result
+    }
+    mutating func addEllipse(in rect: CGRect) { parts.append(Part(contour: .ellipse(rect))) }
+    mutating func addRect(_ rect: CGRect) { parts.append(Part(contour: .rect(rect))) }
+}
+
+#if canImport(SwiftUI)
+extension QuotaGripTransform {
+    init(_ t: CGAffineTransform) { self.init(a: t.a, b: t.b, c: t.c, d: t.d, tx: t.tx, ty: t.ty) }
+    var affine: CGAffineTransform { CGAffineTransform(a: a, b: b, c: c, d: d, tx: tx, ty: ty) }
+}
+extension QuotaGripContour {
+    var path: Path {
+        switch self {
+        case let .ellipse(rect): return Path(ellipseIn: rect)
+        case let .rect(rect): return Path(rect)
+        case let .arc(center, radius, from, to, width):
+            var path = Path()
+            path.addArc(center: center, radius: radius, startAngle: .radians(-.pi + Double(from) * .pi / 2),
+                        endAngle: .radians(-.pi + Double(to) * .pi / 2), clockwise: false)
+            return quotaStrokeOutline(path, width: width, rounded: true)
+        case let .strand(from, to, basis, pinch, top):
+            let dx = to.x - from.x, dy = to.y - from.y, length = max(hypot(dx, dy), 0.001)
+            let px = -dy / length, py = dx / length
+            let middle = CGPoint(x: (from.x + to.x) / 2, y: (from.y + to.y) / 2)
+            func side(_ point: CGPoint, _ half: CGFloat, _ sign: CGFloat) -> CGPoint { CGPoint(x: point.x + px * half * sign, y: point.y + py * half * sign) }
+            var path = Path()
+            path.move(to: side(from, basis, 1)); path.addQuadCurve(to: side(to, top, 1), control: side(middle, pinch, 1))
+            path.addLine(to: side(to, top, -1)); path.addQuadCurve(to: side(from, basis, -1), control: side(middle, pinch, -1)); path.closeSubpath()
+            return path
+        }
+    }
+}
+extension QuotaGripFootprint {
+    func applying(_ transform: CGAffineTransform) -> Self { applying(QuotaGripTransform(transform)) }
+}
+#endif
+
+// Codenotch 835550a342871779135b6484d6899161c5222f7c, Vinz, MIT.
+// Measurements and timelines mirror Windows QuotaNotchGeometry / GripMotion.
+enum NotchLayout {
+    static let curlRadius: CGFloat = 38.7
+    static let arcRadius: CGFloat = 28.5 * 0.9
+    static let arcFill: CGFloat = 6.8 * 0.9
+    static let discRadius: CGFloat = 23.3 * 0.9
+    static let gripPitch: CGFloat = 12.5
+
+    static let ringStroke: CGFloat = 4
+
+    static func outerDiameter(_ count: Int) -> CGFloat { 52 + CGFloat(max(0, count - 1)) * 16 }
+    #if canImport(SwiftUI)
+    static func periodColor(_ window: QuotaWindow) -> Color {
+        switch window.period {
+        case .month: Color(red: 67 / 255, green: 143 / 255, blue: 229 / 255)
+        case .week: Color(red: 34 / 255, green: 217 / 255, blue: 148 / 255)
+        case .fiveHours: Color(red: 161 / 255, green: 138 / 255, blue: 217 / 255)
+        case .other: window.periodDuration == nil ? Color(red: 164 / 255, green: 164 / 255, blue: 173 / 255)
+            : Color(red: 109 / 255, green: 184 / 255, blue: 196 / 255)
+        }
+    }
+    #endif
+}
+
+struct QuotaGripFrame: Equatable {
+    var reveal: CGFloat = 0
+    var hover: CGFloat = 0
+    var squeeze: CGFloat = 0
+    var arc: CGFloat = 0
+    var disc: CGFloat = 0
+    var returning = false
+    var quick = false
+    var entryArc: CGFloat = 0
+    var entryReturning = false
+    var entryQuick = false
+}
+
+func quotaSmooth(_ value: CGFloat) -> CGFloat {
+    let t = min(max(value, 0), 1)
+    return t * t * (3 - 2 * t)
+}
+
+#if canImport(SwiftUI)
+// Native drawing widens the same primitive arcs used by analytic membership.
+// No Path union/intersection normalization is used for paint or input.
+func quotaStrokeOutline(_ path: Path, width: CGFloat, rounded: Bool = false) -> Path {
+    guard width > 0 else { return Path() }
+    return Path(path.cgPath.copy(strokingWithWidth: width,
+                                 lineCap: rounded ? .round : .butt,
+                                 lineJoin: rounded ? .round : .miter, miterLimit: 10))
+}
+#endif
+
+struct QuotaMotionTrack {
+    private(set) var value: CGFloat = 0
+    private(set) var from: CGFloat = 0
+    private(set) var target: CGFloat = 0
+    private var start: TimeInterval = 0
+    private var duration: TimeInterval = 0
+    private var x1: CGFloat = 0.42
+    private var x2: CGFloat = 0.58
+    private(set) var active = false
+
+    mutating func to(_ target: CGFloat, now: TimeInterval, delay: TimeInterval = 0,
+                     duration: TimeInterval, x1: CGFloat = 0.42, x2: CGFloat = 0.58) {
+        from = value; self.target = target; start = now + delay; self.duration = duration
+        self.x1 = x1; self.x2 = x2; active = from != target
+    }
+    mutating func sample(_ now: TimeInterval) {
+        guard active else { return }
+        guard now > start else { value = from; return }
+        let x = CGFloat(min(max((now - start) / duration, 0), 1))
+        if x >= 1 { snap(target); return }
+        var low: CGFloat = 0, high: CGFloat = 1, t = x
+        for _ in 0..<24 {
+            t = (low + high) / 2
+            let at = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t
+            if at < x { low = t } else { high = t }
+        }
+        value = from + (target - from) * quotaSmooth(t)
+    }
+    mutating func snap(_ value: CGFloat) { self.value = value; from = value; target = value; active = false }
+}
+
+/// Closed-form damped oscillator, including velocity, matching the Windows spring.
+private struct QuotaGripSpring {
+    var value: CGFloat = 0
+    var velocity: CGFloat = 0
+    let response: CGFloat
+    let damping: CGFloat
+    mutating func step(_ target: CGFloat, dt: CGFloat) {
+        let omega = 2 * CGFloat.pi / response
+        let wd = omega * sqrt(1 - damping * damping)
+        let offset = value - target
+        let c = (velocity + damping * omega * offset) / wd
+        let decay = exp(-damping * omega * dt)
+        let cosine = cos(wd * dt), sine = sin(wd * dt)
+        value = target + decay * (offset * cosine + c * sine)
+        velocity = decay * ((c * wd - damping * omega * offset) * cosine - (offset * wd + damping * omega * c) * sine)
+        if settled(target) { value = target; velocity = 0 }
+    }
+    func settled(_ target: CGFloat) -> Bool { abs(value - target) < 0.002 && abs(velocity) < 0.002 }
+    mutating func snap(_ target: CGFloat) { value = target; velocity = 0 }
+}
+
+/// Intent follows physical pointer entry, never animation moving under a pointer.
+struct QuotaGripIntent {
+    private(set) var acquired = false
+    private var previous: CGPoint?
+    mutating func update(_ point: CGPoint, entry: Bool, envelope: Bool, held: Bool = false) -> Bool {
+        let moved = previous != nil && previous != point
+        previous = point
+        if acquired { acquired = held || envelope }
+        else if moved && entry { acquired = true }
+        return acquired
+    }
+    mutating func reset() { acquired = false; previous = nil }
+}
+
+struct QuotaGripMotion {
+    private var arc = QuotaMotionTrack(), disc = QuotaMotionTrack(), reveal = QuotaMotionTrack()
+    private var hover = QuotaGripSpring(response: 0.22, damping: 0.55)
+    private var squeeze = QuotaGripSpring(response: 0.26, damping: 0.7)
+    private var last: TimeInterval?
+    private var expanded = false, out = false, hovered = false, held = false
+    private var entryArc: CGFloat = 0
+    private var entryReturning = false, entryQuick = false
+    private(set) var frame = QuotaGripFrame()
+    var active: Bool { arc.active || disc.active || reveal.active || !hover.settled(hovered ? 1 : 0) || !squeeze.settled(held ? 1 : 0) }
+
+    mutating func setTargets(expanded: Bool, reveal show: Bool, hover hovering: Bool, held holding: Bool,
+                             now: TimeInterval, reducedMotion: Bool) {
+        let painted = frame
+        if !holding || held { sample(now) }
+        if self.expanded != expanded {
+            self.expanded = expanded
+            let first = expanded && arc.value <= 0.001
+            arc.to(expanded ? 1 : 0, now: now, delay: first ? 0.34 : 0,
+                   duration: first ? 0.95 : expanded ? 0.35 : 0.26, x1: expanded ? 0.35 : 0.42, x2: expanded ? 0.25 : 0.58)
