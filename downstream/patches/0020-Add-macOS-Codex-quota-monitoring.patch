+@MainActor @Observable
+final class QuotaNotchHover {
+    enum Region { case outside, bar, cell, tooltip, settings }
+    private(set) var expanded = false
+    private(set) var tooltip = false
+    private(set) var settingsHovered = false
+    private(set) var handlesTuckedAway = true
+    private(set) var region = Region.outside
+    @ObservationIgnored private var folding: Task<Void, Never>?
+    @ObservationIgnored private var dismissal: Task<Void, Never>?
+    @ObservationIgnored private var settingsReturnDeadline: ContinuousClock.Instant?
+
+    func move(to next: Region) {
+        guard next != region else { return }
+        if region == .settings && next != .settings {
+            settingsReturnDeadline = ContinuousClock().now.advanced(by: .milliseconds(500))
+        } else if next == .settings {
+            settingsReturnDeadline = nil
+        }
+        region = next
+        settingsHovered = next == .settings
+        folding?.cancel()
+        if next != .outside { expanded = true; handlesTuckedAway = false }
+        if next == .cell || next == .tooltip {
+            dismissal?.cancel()
+            tooltip = true
+        } else {
+            dismissal?.cancel()
+            if tooltip {
+                dismissal = Task { @MainActor [weak self] in
+                    try? await Task.sleep(for: .milliseconds(250))
+                    guard !Task.isCancelled else { return }
+                    self?.tooltip = false
+                }
+            }
+        }
+        if next == .outside {
+            let returnDeadline = settingsReturnDeadline
+            // The 500ms DiscToArc return precedes the 450ms fold grace. Preserve
+            // its deadline even if the pointer briefly crosses the bar on exit.
+            if returnDeadline == nil { handlesTuckedAway = true }
+            folding = Task { @MainActor [weak self] in
+                if let returnDeadline {
+                    try? await ContinuousClock().sleep(until: returnDeadline)
+                    guard !Task.isCancelled else { return }
+                    self?.handlesTuckedAway = true
+                }
+                try? await Task.sleep(for: .milliseconds(450))
+                guard !Task.isCancelled else { return }
+                self?.expanded = false
+            }
+        }
+    }
+
+    func reset() {
+        folding?.cancel(); dismissal?.cancel()
+        folding = nil; dismissal = nil
+        settingsReturnDeadline = nil
+        handlesTuckedAway = true
+        region = .outside; expanded = false; tooltip = false; settingsHovered = false
+    }
+
+    deinit { folding?.cancel(); dismissal?.cancel() }
+}
