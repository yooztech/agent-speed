+        case .left: transform = CGAffineTransform(translationX: 0, y: offset)
+        case .right: transform = CGAffineTransform(a: -1, b: 0, c: 0, d: 1, tx: envelopeDepth, ty: offset)
+        case .top: transform = CGAffineTransform(a: 0, b: 1, c: 1, d: 0, tx: offset, ty: 0)
+        case .bottom: transform = CGAffineTransform(a: 0, b: -1, c: 1, d: 0, tx: offset, ty: envelopeDepth)
+        }
+        var path = Path()
+        if t == 0 {
+            path.move(to: .zero); path.addLine(to: CGPoint(x: 4, y: 0))
+            path.addQuadCurve(to: CGPoint(x: 10, y: 6), control: CGPoint(x: 10, y: 0))
+            path.addLine(to: CGPoint(x: 10, y: 73)); path.addQuadCurve(to: CGPoint(x: 4, y: 79), control: CGPoint(x: 10, y: 79))
+            path.addLine(to: CGPoint(x: 0, y: 79)); path.closeSubpath()
+        } else {
+            let radius = 6 + 14 * t
+            path.move(to: .zero)
