+    }
+    private static func into(_ center: CGPoint, _ distance: CGFloat) -> CGPoint { CGPoint(x: center.x - s * distance, y: center.y - s * distance) }
+    private static func stroke(_ path: QuotaGripFootprint, _ width: CGFloat) -> QuotaGripFootprint { path.outlined(width) }
+    static func goo(_ center: CGPoint, separation: CGFloat, returning: Bool, quick: Bool) -> QuotaOrbShape {
