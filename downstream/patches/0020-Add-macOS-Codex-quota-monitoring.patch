+            : fill * 0.4 * quotaSmooth(t / 0.15) * (1 - quotaSmooth((t - 0.6) / 0.35))
+        let slide: CGFloat = rq ? 0 : returning
+            ? buried * (1 - t) + (t < 0.85 ? rest * 1.2 * sin(.pi * t / 0.85) : 0)
+            : buried * (1 - t) + (t < 0.8 ? rest * 2.1 * sin(.pi * t / 0.8) : 0)
+        let unrolled = rq ? quotaSmooth((t - 0.05) / 0.9) : returning ? quotaSmooth((t - 0.6) / 0.35) : quotaSmooth((t - 0.52) / 0.43)
