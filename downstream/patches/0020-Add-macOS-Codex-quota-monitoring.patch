+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+import Testing
+@testable import AgentSpeedCore
+
+private final class ColdQuotaHTTP: @unchecked Sendable {
+    private let lock = NSLock()
+    private var time = Date(timeIntervalSince1970: 1_800_000_000)
+    private var status = 503
+    private var retry: String?
+    private var malformed = false
+    private var calls = 0
+    func now() -> Date { lock.withLock { time } }
+    func advance(_ seconds: TimeInterval) { lock.withLock { time.addTimeInterval(seconds) } }
+    func count() -> Int { lock.withLock { calls } }
+    func respond(_ status: Int, retry: String? = nil, malformed: Bool = false) {
+        lock.withLock { self.status = status; self.retry = retry; self.malformed = malformed }
+    }
+    func fetch(_ request: URLRequest) throws -> (Data, HTTPURLResponse) {
+        try lock.withLock {
+            let reset = request.url!.path.hasSuffix("rate-limit-reset-credits")
+            if !reset { calls += 1 }
+            if !reset && status == 599 { throw URLError(.notConnectedToInternet) }
+            let body = reset ? #"{"available_count":2}"# : malformed ? "not-json"
+                : #"{"rate_limit":{"primary_window":{"used_percent":25}}}"#
+            return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: reset ? 200 : status,
+                httpVersion: nil, headerFields: reset ? nil : retry.map { ["Retry-After": $0] })!)
+        }
+    }
+}
+
+private struct ColdQuotaHarness: Sendable {
+    let id: String
+    let directory: URL
+    let suite = UUID().uuidString
+    let http = ColdQuotaHTTP()
+    init(_ id: String) throws {
+        self.id = id
+        directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let auth: String
+        switch id {
+        case "codex": auth = #"{"tokens":{"access_token":"fixture-token","account_id":"fixture-account"}}"#
+        default: preconditionFailure("Unsupported quota fixture source")
+        }
+        try Data(auth.utf8).write(to: directory.appendingPathComponent("auth.json"))
+    }
+    func provider() -> any QuotaProvider {
+        let auth = directory.appendingPathComponent("auth.json"), cache = directory.appendingPathComponent("cache")
+        switch id {
+        case "codex":
+            return CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!,
+                now: { http.now() }, cacheDirectory: cache, transport: { try http.fetch($0) })
+        default:
+            preconditionFailure("Unsupported quota fixture source")
+        }
+    }
+    func close() {
+        try? FileManager.default.removeItem(at: directory)
+        UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite)
+    }
+}
+
+@Suite("Quota cold-start actual HTTP pacing")
+struct QuotaColdStartTests {
+    @Test(arguments: ["codex"])
+    func coldTransportRequestsFollowSequenceAcrossRestartsThenUseWarmPacing(_ id: String) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        for (index, delay) in [TimeInterval(5), 10, 20, 30, 30, 30].enumerated() {
+            // Exercise transport errors, server failures and decoding failures through the real provider seam.
+            http.respond(index % 3 == 0 ? 599 : index % 3 == 1 ? 503 : 200, malformed: index % 3 == 2)
+            let reader = harness.provider()
+            let result = await reader.refreshStartup()
+            #expect(result.status == .error && result.observedAt == nil && result.windows.isEmpty)
+            #expect(result.nextAllowedAt == http.now().addingTimeInterval(delay))
+            #expect(http.count() == index + 1)
+            let restarted = harness.provider()
+            #expect(await restarted.readCachedSnapshot().observedAt == nil)
+            #expect(await restarted.refreshStartup().nextAllowedAt == result.nextAllowedAt)
+            http.advance(delay - 1)
+            _ = await restarted.refresh()
+            #expect(http.count() == index + 1, "No real HTTP request before the persisted deadline")
+            http.advance(1)
+        }
+        http.respond(200)
+        let successful = await harness.provider().refresh()
+        #expect(successful.status == .ok && successful.observedAt == http.now())
+        #expect(http.count() == 7)
+        let warm = harness.provider()
+        #expect(await warm.readCachedSnapshot().observedAt == successful.observedAt)
+        http.advance(300)
+        http.respond(503)
+        let failed = await warm.refresh()
+        #expect(failed.status == .stale && failed.observedAt == successful.observedAt)
+        #expect(failed.nextAllowedAt == http.now().addingTimeInterval(60))
+        #expect(http.count() == 8)
+        let restartedWarm = harness.provider()
+        _ = await restartedWarm.refreshStartup()
+        #expect(http.count() == 8, "A validated persisted observation remains warm after restart")
+        http.advance(60)
+        #expect(await restartedWarm.refresh().nextAllowedAt == http.now().addingTimeInterval(120))
+        #expect(http.count() == 9)
+    }
+
+    @Test(arguments: ["codex"], [429, 503])
+    func explicitRetryAfterRemainsHardFloorAcrossRestart(_ id: String, _ status: Int) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        http.respond(status, retry: "900")
+        let failed = await harness.provider().refresh()
+        #expect(failed.nextAllowedAt == http.now().addingTimeInterval(900))
+        let restarted = harness.provider()
+        http.respond(200)
+        http.advance(899)
+        #expect(await restarted.refreshStartup().nextAllowedAt == failed.nextAllowedAt)
+        #expect(http.count() == 1)
+        http.advance(1)
+        #expect(await restarted.refresh().status == .ok)
+        #expect(http.count() == 2)
+    }
+
+    @Test(arguments: ["codex"])
+    func headerless429KeepsSupplierFloorWithoutCountingAsColdTransient(_ id: String) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        http.respond(429)
+        #expect(await harness.provider().refresh().nextAllowedAt == http.now().addingTimeInterval(60))
+        http.advance(59)
+        _ = await harness.provider().refreshStartup()
+        #expect(http.count() == 1)
+        http.advance(1)
+        http.respond(503)
+        #expect(await harness.provider().refresh().nextAllowedAt == http.now().addingTimeInterval(5))
+        #expect(http.count() == 2)
+        http.advance(5)
+        http.respond(429)
+        #expect(await harness.provider().refresh().nextAllowedAt == http.now().addingTimeInterval(240))
+        #expect(http.count() == 3)
+    }
+
+    @Test(arguments: ["codex"])
+    func legacyUnknownDeadlineIsNeverShortenedAndResumesColdOnlyAfterExpiry(_ id: String) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        _ = await harness.provider().refresh()
+        let cache = harness.directory.appendingPathComponent("cache")
+        let file = try #require(FileManager.default.contentsOfDirectory(at: cache, includingPropertiesForKeys: nil).first)
+        var schedule = try #require(JSONSerialization.jsonObject(with: Data(contentsOf: file)) as? [String: Any])
+        schedule.removeValue(forKey: "coldFailures")
+        // A legacy success flag without a validated observation does not prove successful data.
+        schedule["successfulObservation"] = true
+        schedule[id == "codex" ? "nextAllowedAt" : "next"] = http.now().addingTimeInterval(900).timeIntervalSinceReferenceDate
+        try JSONSerialization.data(withJSONObject: schedule).write(to: file)
+        let restarted = harness.provider()
+        #expect(await restarted.refreshStartup().nextAllowedAt == http.now().addingTimeInterval(900))
+        http.advance(899)
+        _ = await restarted.refresh()
+        #expect(http.count() == 1)
+        http.advance(1)
+        let failed = await restarted.refresh()
+        #expect(failed.observedAt == nil)
+        #expect(failed.nextAllowedAt == http.now().addingTimeInterval(5))
+        #expect(http.count() == 2)
+    }
+    @Test(arguments: ["codex"])
+    func cancellingReaderPreservesColdFloorAndNextAttempt(_ id: String) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        let reader = harness.provider()
+        #expect(await reader.refresh().nextAllowedAt == http.now().addingTimeInterval(5))
+        await reader.cancel()
+        let restarted = harness.provider()
+        _ = await restarted.refreshStartup()
+        #expect(http.count() == 1)
+        http.advance(5)
+        #expect(await restarted.refresh().nextAllowedAt == http.now().addingTimeInterval(10))
+        #expect(http.count() == 2)
+    }
+
+    @Test(arguments: ["codex"])
+    func replacingAccountNeverInheritsAnotherAccountsColdCounterOrFloor(_ id: String) async throws {
+        let harness = try ColdQuotaHarness(id), http = harness.http
+        defer { harness.close() }
+        let reader = harness.provider()
+        _ = await reader.refresh()
+        http.advance(5)
+        #expect(await reader.refresh().nextAllowedAt == http.now().addingTimeInterval(10))
+        let auth: String
+        switch id {
+        case "codex": auth = #"{"tokens":{"access_token":"fixture-other","account_id":"other-account"}}"#
+        default: auth = #"{"access_token":"fixture-other","refresh_token":"other-session","expires_at":1900000000}"#
+        }
+        try Data(auth.utf8).write(to: harness.directory.appendingPathComponent("auth.json"))
+        let other = await reader.readCachedSnapshot()
+        #expect(other.observedAt == nil && other.nextAllowedAt == nil)
+        #expect(await reader.refresh().nextAllowedAt == http.now().addingTimeInterval(5))
+        #expect(http.count() == 3)
+    }
+}
