+/// Geometry and hit testing use the same top-left coordinate system as the
+/// flipped NSHostingView. The tooltip's tail stays aimed at the ring even when
+/// its card is clamped away from a display boundary.
+struct QuotaNotchGeometry {
+    let edge: NotchEdge
+    let size: CGSize
+    let expanded: Bool
+    let tooltip: Bool
+    let settingsHovered: Bool
+    let handlesTuckedAway: Bool
+    let bodyRect: CGRect
+    let ringCenter: CGPoint
+    let orbCenter: CGPoint
+    let cardRect: CGRect
+    let tailRect: CGRect
+    let bodyPath: Path
+    let tooltipPath: Path
+    let orbPath: Path
+
+    init(edge: NotchEdge, expanded: Bool, tooltip: Bool, settingsHovered: Bool,
+         cardHeight: CGFloat, available: CGSize = CGSize(width: 1_000, height: 1_000),
+         actualSize: CGSize? = nil, handlesTuckedAway: Bool = false) {
+        self.edge = edge
+        self.expanded = expanded
+        self.tooltip = tooltip
+        self.settingsHovered = settingsHovered
+        self.handlesTuckedAway = handlesTuckedAway
+        let depth = NotchLayout.bodyDepth(for: edge)
+        let length = NotchLayout.shapeLength(for: edge)
+        let alongRoom = max(length + NotchLayout.orbDiameter, edge.isVertical ? cardHeight + 8 : NotchLayout.cardWidth + 8)
+        let acrossRoom = depth + NotchLayout.tailGap + NotchLayout.tailLength
+            + (edge.isVertical ? NotchLayout.cardWidth : cardHeight) + 4
+        // AppKit rounds window frames to whole points. Draw against that same
+        // size, then let the controller reconcile against actual content bounds.
+        let panelSize = actualSize ?? CGSize(
+            width: min(available.width.rounded(.down), (edge.isVertical ? acrossRoom : alongRoom).rounded(.up)),
+            height: min(available.height.rounded(.down), (edge.isVertical ? alongRoom : acrossRoom).rounded(.up)))
+        size = panelSize
+        let panelLength = edge.isVertical ? panelSize.height : panelSize.width
+        let start = (panelLength - length - NotchLayout.orbDiameter / 2) / 2
+        func point(_ along: CGFloat, _ across: CGFloat) -> CGPoint {
+            switch edge {
+            case .right: CGPoint(x: panelSize.width - across, y: along)
+            case .left: CGPoint(x: across, y: along)
+            case .top: CGPoint(x: along, y: across)
+            case .bottom: CGPoint(x: along, y: panelSize.height - across)
+            }
+        }
+        let bodyLength = expanded ? length : NotchLayout.pillHeight
+        let bodyDepth = expanded ? depth : NotchLayout.pillWidth
+        let bodyStart = start + (length - bodyLength) / 2
+        let origin = point(bodyStart, (edge == .right || edge == .bottom) ? bodyDepth : 0)
+        bodyRect = CGRect(origin: origin, size: edge.isVertical
+                          ? CGSize(width: bodyDepth, height: bodyLength)
+                          : CGSize(width: bodyLength, height: bodyDepth))
+        let ringInset = NotchLayout.ringMargin + NotchLayout.ringDiameter / 2
+        ringCenter = point(start + NotchLayout.ringAlong(for: edge), edge == .bottom ? depth - ringInset : ringInset)
+        orbCenter = point(start + length, NotchLayout.curlRadius)
+        let height = min(cardHeight, max(1, edge.isVertical ? size.height - 8
+                                        : size.height - depth - NotchLayout.tailGap - NotchLayout.tailLength - 4))
+        func clamp(_ value: CGFloat, _ low: CGFloat, _ high: CGFloat) -> CGFloat {
+            min(max(value, low), max(low, high))
+        }
+        if edge.isVertical {
+            let y = clamp(ringCenter.y - height / 2, 4, size.height - height - 4)
+            let x = edge == .right ? size.width - depth - NotchLayout.tailGap - NotchLayout.tailLength - NotchLayout.cardWidth
+                : depth + NotchLayout.tailGap + NotchLayout.tailLength
+            cardRect = CGRect(x: x, y: y, width: NotchLayout.cardWidth, height: height)
+            let tailY = clamp(ringCenter.y - NotchLayout.tailHeight / 2,
+                              y + NotchLayout.cardCorner, y + height - NotchLayout.cardCorner - NotchLayout.tailHeight)
+            tailRect = CGRect(x: edge == .right ? cardRect.maxX : cardRect.minX - NotchLayout.tailLength,
+                              y: tailY, width: NotchLayout.tailLength, height: NotchLayout.tailHeight)
+        } else {
+            let x = clamp(ringCenter.x - NotchLayout.cardWidth / 2, 4, size.width - NotchLayout.cardWidth - 4)
+            let y = edge == .top ? depth + NotchLayout.tailGap + NotchLayout.tailLength
+                : size.height - depth - NotchLayout.tailGap - NotchLayout.tailLength - height
+            cardRect = CGRect(x: x, y: y, width: NotchLayout.cardWidth, height: height)
+            let tailX = clamp(ringCenter.x - NotchLayout.tailHeight / 2,
+                              x + NotchLayout.cardCorner, x + NotchLayout.cardWidth - NotchLayout.cardCorner - NotchLayout.tailHeight)
+            tailRect = CGRect(x: tailX, y: edge == .top ? cardRect.minY - NotchLayout.tailLength : cardRect.maxY,
+                              width: NotchLayout.tailHeight, height: NotchLayout.tailLength)
+        }
+        bodyPath = SideNotchShape(edge: edge).path(in: bodyRect)
+        tooltipPath = RoundedRectangle(cornerRadius: NotchLayout.cardCorner, style: .circular).path(in: cardRect)
+            .union(QuotaTooltipTail(edge: edge).path(in: tailRect))
+        if handlesTuckedAway {
+            orbPath = Path()
+        } else if settingsHovered {
+            orbPath = Path(ellipseIn: CGRect(x: orbCenter.x - NotchLayout.orbDiameter / 2,
+                                            y: orbCenter.y - NotchLayout.orbDiameter / 2,
+                                            width: NotchLayout.orbDiameter, height: NotchLayout.orbDiameter))
+        } else {
+            orbPath = QuotaSettingsArc.path(center: orbCenter, edge: edge)
+                .strokedPath(StrokeStyle(lineWidth: NotchLayout.orbStroke, lineCap: .round))
+        }
+    }
+
+    func hits(_ point: CGPoint) -> Bool {
+        bodyPath.contains(point) || (expanded && orbPath.contains(point)) || (tooltip && tooltipPath.contains(point))
+    }
+    func region(at point: CGPoint) -> QuotaNotchHover.Region {
+        if tooltip && tooltipPath.contains(point) { return .tooltip }
+        if expanded {
+            // Observe the reference's generous wake disc without intercepting
+            // its transparent area. This also prevents arc/disc hover flicker.
+            if hypot(point.x - orbCenter.x, point.y - orbCenter.y) <= NotchLayout.orbHotZone / 2 { return .settings }
+            let cell = CGRect(x: ringCenter.x - NotchLayout.ringDiameter / 2,
+                              y: ringCenter.y - NotchLayout.ringDiameter / 2,
+                              width: NotchLayout.ringDiameter, height: NotchLayout.cellExtent)
+            if cell.contains(point) && bodyPath.contains(point) { return .cell }
+            return bodyPath.contains(point) ? .bar : .outside
+        }
+        // A larger wake region is observed, never made mouse-intercepting.
+        let wake = bodyRect.insetBy(dx: edge.isVertical ? -NotchLayout.pillHotZone / 2 : 0,
+                                   dy: edge.isVertical ? 0 : -NotchLayout.pillHotZone / 2)
+        return wake.contains(point) ? .bar : .outside
+    }
+
+    func panelFrame(on screen: CGRect) -> CGRect {
+        let origin: CGPoint
+        switch edge {
+        case .right: origin = CGPoint(x: screen.maxX - size.width, y: screen.midY - size.height / 2)
+        case .left: origin = CGPoint(x: screen.minX, y: screen.midY - size.height / 2)
+        case .top: origin = CGPoint(x: screen.midX - size.width / 2, y: screen.maxY - size.height)
+        case .bottom: origin = CGPoint(x: screen.midX - size.width / 2, y: screen.minY)
+        }
+        return CGRect(x: origin.x.rounded(), y: origin.y.rounded(), width: size.width, height: size.height)
+    }
+}
+
+/// Original TooltipTail control points, with the card direction derived from
+/// its screen edge. Both drawing and hit testing use this precise curve.
+struct QuotaTooltipTail: Shape {
+    let edge: NotchEdge
+    func path(in rect: CGRect) -> Path {
+        let tip, a, b, aShoulder, aTip, bTip, bShoulder: CGPoint
+        switch edge {
+        case .right:
+            tip = CGPoint(x: rect.maxX, y: rect.midY)
+            a = CGPoint(x: rect.minX, y: rect.minY); b = CGPoint(x: rect.minX, y: rect.maxY)
+            aShoulder = CGPoint(x: rect.minX, y: rect.minY + rect.height * 0.25)
+            aTip = CGPoint(x: rect.maxX - rect.width * 0.42, y: rect.midY - rect.height * 0.12)
+            bTip = CGPoint(x: rect.maxX - rect.width * 0.42, y: rect.midY + rect.height * 0.12)
+            bShoulder = CGPoint(x: rect.minX, y: rect.maxY - rect.height * 0.25)
+        case .left:
+            tip = CGPoint(x: rect.minX, y: rect.midY)
+            a = CGPoint(x: rect.maxX, y: rect.minY); b = CGPoint(x: rect.maxX, y: rect.maxY)
+            aShoulder = CGPoint(x: rect.maxX, y: rect.minY + rect.height * 0.25)
+            aTip = CGPoint(x: rect.minX + rect.width * 0.42, y: rect.midY - rect.height * 0.12)
+            bTip = CGPoint(x: rect.minX + rect.width * 0.42, y: rect.midY + rect.height * 0.12)
+            bShoulder = CGPoint(x: rect.maxX, y: rect.maxY - rect.height * 0.25)
+        case .top:
+            tip = CGPoint(x: rect.midX, y: rect.minY)
+            a = CGPoint(x: rect.minX, y: rect.maxY); b = CGPoint(x: rect.maxX, y: rect.maxY)
+            aShoulder = CGPoint(x: rect.minX + rect.width * 0.25, y: rect.maxY)
+            aTip = CGPoint(x: rect.midX - rect.width * 0.12, y: rect.minY + rect.height * 0.42)
+            bTip = CGPoint(x: rect.midX + rect.width * 0.12, y: rect.minY + rect.height * 0.42)
+            bShoulder = CGPoint(x: rect.maxX - rect.width * 0.25, y: rect.maxY)
+        case .bottom:
+            tip = CGPoint(x: rect.midX, y: rect.maxY)
+            a = CGPoint(x: rect.minX, y: rect.minY); b = CGPoint(x: rect.maxX, y: rect.minY)
+            aShoulder = CGPoint(x: rect.minX + rect.width * 0.25, y: rect.minY)
+            aTip = CGPoint(x: rect.midX - rect.width * 0.12, y: rect.maxY - rect.height * 0.42)
+            bTip = CGPoint(x: rect.midX + rect.width * 0.12, y: rect.maxY - rect.height * 0.42)
+            bShoulder = CGPoint(x: rect.maxX - rect.width * 0.25, y: rect.minY)
+        }
+        var path = Path()
+        path.move(to: a)
+        path.addCurve(to: tip, control1: aShoulder, control2: aTip)
+        path.addCurve(to: b, control1: bTip, control2: bShoulder)
+        path.closeSubpath()
+        return path
+    }
+}
+
+enum QuotaSettingsArc {
+    static func trim(for edge: NotchEdge) -> ClosedRange<CGFloat> {
+        switch edge {
+        case .right: 0.75...1
+        case .left, .top: 0.5...0.75
+        case .bottom: 0.25...0.5
+        }
+    }
+
+    static func point(_ share: CGFloat, center: CGPoint, edge: NotchEdge,
+                      offset: CGFloat = NotchLayout.orbClearance) -> CGPoint {
+        let trim = trim(for: edge)
+        func direction(_ t: CGFloat) -> CGPoint { CGPoint(x: cos(2 * .pi * t), y: sin(2 * .pi * t)) }
+        let a = direction(trim.lowerBound), b = direction(trim.upperBound), out = edge.outward
+        let aFacesBezel = a.x * out.x + a.y * out.y >= b.x * out.x + b.y * out.y
+        let bezel = aFacesBezel ? a : b, side = aFacesBezel ? b : a
+        let walk = QuotaFlareWalk.steps
+        let step = walk[min(walk.count - 1, max(0, Int((share * CGFloat(walk.count - 1)).rounded())))]
+        let flare = NotchLayout.curlRadius, gap = offset
+        let nx = -sin(step.heading) * side.x - cos(step.heading) * bezel.x
+        let ny = -sin(step.heading) * side.y - cos(step.heading) * bezel.y
+        return CGPoint(x: center.x + flare * (1 - step.v) * bezel.x + flare * step.u * side.x + nx * gap,
+                       y: center.y + flare * (1 - step.v) * bezel.y + flare * step.u * side.y + ny * gap)
+    }
+
+    static func path(center: CGPoint, edge: NotchEdge, offset: CGFloat = NotchLayout.orbClearance) -> Path {
+        var path = Path()
+        for index in QuotaFlareWalk.steps.indices {
+            let at = point(CGFloat(index) / CGFloat(QuotaFlareWalk.steps.count - 1), center: center, edge: edge, offset: offset)
+            if index == 0 { path.move(to: at) } else { path.addLine(to: at) }
+        }
+        return path
+    }
+}
