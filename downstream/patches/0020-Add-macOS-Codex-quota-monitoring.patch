+/// Do not let NSHostingView's intrinsic content size resize the panel. Returning
+/// nil here also prevents this otherwise transparent container claiming clicks.
+@MainActor
+private final class QuotaNotchContainer: NSView {
+    override func hitTest(_ point: NSPoint) -> NSView? {
+        let local = convert(point, from: superview)
+        guard bounds.contains(local) else { return nil }
+        return subviews.reversed().lazy.compactMap { $0.hitTest(local) }.first
+    }
+}
