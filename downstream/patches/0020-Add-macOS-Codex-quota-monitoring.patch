+import Crypto
+#endif
+import Testing
+@testable import AgentSpeedCore
+
+private final class LifecycleQuotaFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var requests: [URLRequest] = []
+    var usageStatus = 200
+    var resetStatus = 200
+    var time = Date(timeIntervalSince1970: 1_800_000_000)
+    func now() -> Date { lock.withLock { time } }
+    func count() -> Int { lock.withLock { requests.filter { $0.url?.path.hasSuffix("/usage") == true }.count } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock {
+            requests.append(request)
+            let reset = request.url?.path.hasSuffix("rate-limit-reset-credits") == true
+            let body = reset ? #"{"available_count":2,"credits":[{"status":"available","expires_at":"2028-01-01T00:00:00Z"}]}"#
+                : #"{"rate_limit":{"primary_window":{"used_percent":25,"limit_window_seconds":18000}}}"#
+            return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: reset ? resetStatus : usageStatus,
+                httpVersion: nil, headerFields: ["Retry-After": "900"])!)
+        }
+    }
+}
+
+private actor QuotaResponseGate {
+    private var request: CheckedContinuation<Void, Never>?
+    private var observer: CheckedContinuation<Void, Never>?
+    func pause() async {
+        await withCheckedContinuation { continuation in
+            request = continuation
+            observer?.resume()
+            observer = nil
+        }
+    }
+    func waitForRequest() async {
+        if request != nil { return }
+        await withCheckedContinuation { observer = $0 }
+    }
+    func release() { request?.resume(); request = nil }
+}
+
+@Suite("Quota cache and startup lifecycle")
+struct QuotaLifecycleTests {
+    private func directory() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+    private func writeCodex(_ auth: URL, token: String = "borrowed-token", account: String = "account-a") throws {
+        try JSONSerialization.data(withJSONObject: ["tokens": ["access_token": token, "account_id": account]]).write(to: auth)
+    }
+    private func codex(_ auth: URL, suite: String, fixture: LifecycleQuotaFixture) -> CodexQuotaProvider {
+        CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { fixture.now() }, transport: { fixture.fetch($0) })
+    }
+
+    @Test func startupBypassesOnlyOneTrustedSuccessFloorAndRetainsObservationTime() async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        let original = await codex(auth, suite: suite, fixture: fixture).refresh()
+        #expect(original.resetCreditsAvailable == 2)
+        #expect(original.resetCreditsNextExpiry != nil)
+        let restarted = codex(auth, suite: suite, fixture: fixture)
+        let cached = await restarted.readCachedSnapshot()
+        #expect(cached.status == .stale)
+        #expect(cached.observedAt == original.observedAt)
+        #expect(cached.resetCreditsAvailable == 2)
+        #expect(fixture.count() == 1)
+        #expect(await restarted.refreshStartup().status == .ok)
+        #expect(fixture.count() == 2)
+        _ = await restarted.refreshStartup()
+        _ = await restarted.refresh()
+        #expect(fixture.count() == 2)
+    }
+
+    @Test(arguments: [429, 503])
+    func startupCannotBypassFailureCooldown(status: Int) async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
