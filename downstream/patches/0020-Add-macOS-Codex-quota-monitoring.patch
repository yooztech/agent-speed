+++ b/macos/Tests/AgentSpeedAppTests/QuotaNotchTests.swift
@@ -0,0 +1,343 @@
+import AppKit
+import SwiftUI
+import Testing
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+@Suite("Native quota notch", .serialized)
+@MainActor
+struct QuotaNotchTests {
+    private let now = Date(timeIntervalSince1970: 1_800_000_000)
+
+    private func snapshot(_ fraction: Double? = 0.21, status: CodexQuotaStatus = .ok,
+                          headlineID: String? = "main:18000") -> CodexQuotaSnapshot {
+        let windows = [
+            CodexQuotaWindow(id: "main:18000", label: "Codex", usedFraction: fraction,
+                             remaining: fraction.map { 1 - $0 }, used: fraction,
+                             resetAt: now.addingTimeInterval(3_060), duration: 18_000),
+            CodexQuotaWindow(id: "main:604800", label: "Codex", usedFraction: 0.52,
+                             remaining: 0.48, used: 0.52, resetAt: now.addingTimeInterval(100_000), duration: 604_800),
+        ]
+        return CodexQuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: status,
+                                  windows: windows, headlineId: headlineID, block: nil, account: nil,
+                                  plan: "Plus", observedAt: now.addingTimeInterval(-300), source: "local",
+                                  credits: nil, nextAllowedAt: nil, waitingForRefresh: false)
+    }
+
+    private func reading(_ snapshot: CodexQuotaSnapshot? = nil, enabled: Bool = true) -> QuotaNotchReading {
+        QuotaNotchReading(snapshot: snapshot, networkEnabled: enabled, l10n: Localizer(preference: .en))
+    }
+
+    @Test func macReferenceMeasurementsAndTypographyAreNotWindowsSizes() {
+        #expect(NotchLayout.ringDiameter == 44)
+        #expect(abs(NotchLayout.sideBodyDepth - 186 * 44.0 / 117) < 0.000_001)
+        #expect(abs(NotchLayout.fontSize(27) - (27 * 44.0 / 117 / 0.714)) < 0.000_001)
+        #expect(NotchLayout.barHeight == 4)
+        #expect(NotchLayout.bodyDepth(for: .top) == NotchLayout.bodyDepth(for: .bottom))
+        #expect(NotchLayout.bodyDepth(for: .top) > NotchLayout.bodyDepth(for: .right))
+        #expect(NotchLayout.cellExtent == 44 + NotchLayout.ringLabelGap + NotchLayout.percentLineHeight)
+        #expect(QuotaFlareWalk.steps.count == 97)
+        #expect(QuotaFlareWalk.steps.first?.u == 0)
+        #expect(QuotaFlareWalk.steps.last?.u == 1)
+        #expect(QuotaFlareWalk.steps.last?.v == 1)
+    }
+
+    @Test func snapshotIdentityUnknownAndStaleRemainTruthful() {
+        let weekly = reading(snapshot(headlineID: "main:604800"))
+        #expect(weekly.fraction == 0.52)
+        #expect(weekly.percentage == "52%")
+        let unknown = reading()
+        #expect(unknown.fraction == nil)
+        #expect(unknown.percentage == "—")
+        #expect(unknown.stale)
+        #expect(unknown.status == unknown.l10n("mac.quota.empty"))
+        let stale = reading(snapshot(0.73, status: .stale))
+        #expect(stale.fraction == 0.73)
+        #expect(stale.percentage == "73%")
+        #expect(stale.stale)
+        #expect(stale.status == stale.l10n("mac.quota.status.stale"))
+        let offline = reading(snapshot(), enabled: false)
+        #expect(offline.status == offline.l10n("mac.quota.offline"))
+        #expect(offline.stale)
+        #expect(offline.observationDate == now.addingTimeInterval(-300))
+        #expect(stale.observationDate == now.addingTimeInterval(-300))
+        #expect(reading(snapshot()).observationDate == nil)
+        // Offline is not manufactured zero usage, nor a fabricated activity.
+        #expect(offline.fraction == 0.21)
+        #expect(reading(snapshot(nil)).fraction == nil)
+    }
+
+    @Test func resetCopyUsesTheMacReferenceRoundingAndWeekBoundary() {
+        let value = reading(snapshot())
+        #expect(value.resetText(now.addingTimeInterval(-1), now: now) == "Resetting…")
+        #expect(value.resetText(now.addingTimeInterval(42), now: now) == "Resets in 42 sec")
+        #expect(value.resetText(now.addingTimeInterval(3_040), now: now) == "Resets in 51 min")
+        #expect(!value.resetText(now.addingTimeInterval(3_599), now: now).contains("60 min"))
+        #expect(!value.resetText(now.addingTimeInterval(26 * 86_400), now: now).contains(":"))
+    }
+
+    @Test func everyEdgeKeepsItsRingLabelTailAndSeparateOrbInsideItsMonitor() {
+        let value = reading(snapshot())
+        let screen = CGRect(x: -1_440, y: -900, width: 1_440, height: 900)
+        for edge in NotchEdge.allCases {
+            let geometry = QuotaNotchGeometry(edge: edge, expanded: true, tooltip: true, settingsHovered: false,
+                                             cardHeight: value.cardHeight, available: screen.size)
+            #expect(screen.contains(geometry.panelFrame(on: screen)))
+            #expect(geometry.bodyPath.contains(geometry.ringCenter))
+            let labelBottom = geometry.ringCenter.y + NotchLayout.ringDiameter / 2
+                + NotchLayout.ringLabelGap + NotchLayout.percentLineHeight
+            #expect(labelBottom <= geometry.bodyRect.maxY)
+            #expect(geometry.hits(geometry.ringCenter))
+            #expect(geometry.region(at: geometry.ringCenter) == .cell)
+            #expect(!geometry.bodyPath.contains(geometry.orbCenter))
+            // The hole in the resting arc is not a giant circular hit target.
+            #expect(!geometry.hits(geometry.orbCenter))
+            #expect(geometry.region(at: geometry.orbCenter) == .settings)
+            let arcMiddle = QuotaSettingsArc.point(0.5, center: geometry.orbCenter, edge: edge)
+            #expect(geometry.hits(arcMiddle))
+            #expect(geometry.region(at: arcMiddle) == .settings)
+            #expect(geometry.tooltipPath.contains(CGPoint(x: geometry.cardRect.midX, y: geometry.cardRect.midY)))
+            #expect(!geometry.tooltipPath.contains(CGPoint(x: geometry.cardRect.minX + 1, y: geometry.cardRect.minY + 1)))
+            if edge.isVertical {
+                #expect(abs(geometry.tailRect.midY - geometry.ringCenter.y) < 0.000_001)
+                #expect(abs(geometry.bodyRect.height - NotchLayout.shapeLength(for: edge)) < 0.000_001)
+            } else {
+                #expect(abs(geometry.tailRect.midX - geometry.ringCenter.x) < 0.000_001)
+                #expect(abs(geometry.bodyRect.width - NotchLayout.shapeLength(for: edge)) < 0.000_001)
+            }
+        }
+    }
+
+    @Test func stationaryPointerRetargetsTheExposedCellAfterOpening() {
+        for edge in NotchEdge.allCases {
+            let value = reading(snapshot())
+            let folded = QuotaNotchGeometry(edge: edge, expanded: false, tooltip: false, settingsHovered: false,
+                                           cardHeight: value.cardHeight)
+            let opened = QuotaNotchGeometry(edge: edge, expanded: true, tooltip: false, settingsHovered: false,
+                                           cardHeight: value.cardHeight)
+            let wake = folded.bodyRect.insetBy(dx: edge.isVertical ? -NotchLayout.pillHotZone / 2 : 0,
+                                               dy: edge.isVertical ? 0 : -NotchLayout.pillHotZone / 2)
+            let cell = CGRect(x: opened.ringCenter.x - NotchLayout.ringDiameter / 2,
+                              y: opened.ringCenter.y - NotchLayout.ringDiameter / 2,
+                              width: NotchLayout.ringDiameter, height: NotchLayout.cellExtent)
+            let overlap = wake.intersection(cell)
+            #expect(!overlap.isNull)
+            let stationary = CGPoint(x: overlap.midX, y: overlap.midY)
+            let hover = QuotaNotchHover()
+            hover.move(to: folded.region(at: stationary))
+            #expect(hover.expanded && !hover.tooltip)
+            // The controller does this immediately after applying new bounds,
+            // using the same pointer, not waiting for a second mouse event.
+            hover.move(to: opened.region(at: stationary))
+            #expect(hover.region == .cell)
+            #expect(hover.tooltip)
+            hover.reset()
+        }
+    }
