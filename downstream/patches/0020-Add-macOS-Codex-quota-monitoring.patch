+import Observation
+import AgentSpeedCore
+import SwiftUI
+
+struct QuotaPane: View {
+    let model: AppModel
+    @State private var clock = QuotaDisplayClock()
+    @State private var activity = OrbPaneActivity()
+
+    var body: some View {
+        let quota = model.quota
+        let l10n = model.l10n
+        Form {
+            Section(l10n("mac.quota.account")) {
+                HStack {
+                    if !quota.networkEnabled { Footnote(l10n("mac.quota.offline")) }
+                    Spacer()
+                    if quota.isRefreshing { ProgressView().controlSize(.small) }
+                    Button(l10n("mac.quota.refresh")) { quota.refresh() }
+                        .disabled(!quota.networkEnabled || quota.isRefreshing)
+                }
+                let configured = quotaEnabledSources(quota).filter { !quota.unconfiguredProviderIDs.contains($0.id) }
+                if quotaEnabledSources(quota).isEmpty { Footnote(l10n("mac.quota.enableSource")) }
+                ForEach(configured, id: \.id) { provider in
+                    let accounts = quota.snapshots.filter { $0.id == provider.id }
+                    if accounts.isEmpty {
+                        VStack(alignment: .leading, spacing: 12) {
+                            Text(provider.name).font(.headline)
+                            Footnote(l10n(!quota.networkEnabled ? "mac.quota.offline" : quota.isRefreshing ? "mac.quota.refreshing" : "mac.quota.initial"))
+                        }.padding(12).frame(maxWidth: .infinity, alignment: .leading)
+                    }
+                    ForEach(accounts, id: \.id) { account in
+                        QuotaAccountCard(account: account, l10n: l10n, networkEnabled: quota.networkEnabled,
+                                         autoRefresh: quota.autoRefreshEnabled, now: clock.now)
+                    }
+                }
+            }
+            Section(l10n("mac.quota.preferences")) {
+                Toggle(l10n("mac.quota.autoRefresh"), isOn: Binding(get: { quota.autoRefreshEnabled }, set: { quota.autoRefreshEnabled = $0 }))
+                Toggle(l10n("mac.quota.floating"), isOn: Binding(get: { quota.floatingVisible }, set: { quota.floatingVisible = $0 }))
+                Toggle(l10n("mac.quota.keepExpanded"), isOn: Binding(get: { quota.keepExpanded }, set: { quota.keepExpanded = $0 }))
+            }
+            Section(l10n("mac.quota.source")) {
+                Toggle(isOn: Binding(get: { quota.allSourcesEnabled }, set: { quota.allSourcesEnabled = $0 })) {
+                    VStack(alignment: .leading, spacing: 4) {
+                        Text(l10n("mac.quota.allSources"))
+                        Footnote(l10n("mac.quota.allSourcesHint"))
+                    }
+                }
+                ForEach(quotaSources, id: \.id) { provider in
+                    Toggle(isOn: Binding(get: { quota.allSourcesEnabled || quota.enabledProviderIDs.contains(provider.id) }, set: { enabled in
+                        if enabled { quota.enabledProviderIDs.insert(provider.id) }
+                        else { quota.enabledProviderIDs.remove(provider.id) }
+                    })) {
+                        HStack {
+                            Circle().fill(provider.id == "codex" ? Color(red: 52 / 255, green: 211 / 255, blue: 153 / 255) : Color(red: 244 / 255, green: 177 / 255, blue: 62 / 255))
+                                .frame(width: 8, height: 8)
+                            Text(provider.name)
+                        }
+                    }.disabled(quota.allSourcesEnabled)
+                }
+            }
+        }
+        .settingsForm()
+        .background(OrbPaneActivityReader(activity: $activity))
+        .onAppear { updateClock() }
+        .onChange(of: quota.snapshots) { updateClock() }
+        .onChange(of: quota.networkEnabled) { updateClock() }
+        .onChange(of: activity) { updateClock() }
+        .onDisappear { clock.stop() }
+    }
+
+    private func updateClock() {
+        clock.start(observedAt: nil, enabled: activity.visible && model.quota.networkEnabled && model.quota.snapshots.contains {
+            $0.windows.contains { $0.resetAt != nil } || $0.credits?.resetAt != nil
+        })
+    }
+}
+
+struct QuotaSourceDefinition: Identifiable, Sendable {
+    let id: String
+    let name: String
+}
+
+let quotaSources = [QuotaSourceDefinition(id: "codex", name: "Codex")]
+
+@MainActor func quotaEnabledSources(_ quota: QuotaController) -> [QuotaSourceDefinition] {
+    quotaSources.filter { quota.allSourcesEnabled || quota.enabledProviderIDs.contains($0.id) }
+}
+
+struct QuotaAccountCard: View {
+    let account: QuotaSnapshot
+    let l10n: Localizer
+    let networkEnabled: Bool
+    let autoRefresh: Bool
+    let now: Date
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Text(account.displayName).font(.headline)
+                Spacer()
+                if let plan = account.plan, quotaHasData(account) { Text(plan).font(.caption).foregroundStyle(.secondary) }
+            }
+            if let name = account.account { Text(name).font(.caption).foregroundStyle(.secondary) }
+            if !quotaHasData(account) && !(account.status == .ok && account.observedAt != nil) {
+                Text(quotaInitialStatus(account, l10n, networkEnabled: networkEnabled, autoRefresh: autoRefresh))
+                    .foregroundStyle(.secondary)
+            } else {
+                if !networkEnabled || account.status != .ok || account.waitingForRefresh {
+                    Text(quotaDisplayStatus(account, l10n, networkEnabled: networkEnabled, now: now)).font(.caption).foregroundStyle(.secondary)
+                }
+                if let block = account.block { Text(block).font(.caption).foregroundStyle(.secondary) }
+                ForEach(QuotaWindow.ordered(account.windows), id: \.id) { window in
+                    VStack(alignment: .leading, spacing: 8) {
+                        HStack {
+                            Text(quotaWindowLabel(window, l10n, providerName: account.displayName))
+                            Spacer()
+                            Text(window.remainingFraction.map { l10n("mac.quota.remaining", quotaPercent($0, locale: l10n.locale)) } ?? l10n("mac.quota.unavailable"))
+                                .fontWeight(.semibold).monospacedDigit()
+                                .foregroundStyle((window.usedFraction ?? 0) >= 0.9 ? Color.orange : Color.primary)
+                        }
+                        switch quotaUsageIndicatorState(window) {
+                        case .known(let remaining):
+                            ProgressView(value: remaining).tint(NotchLayout.periodColor(window))
+                        case .indeterminate:
+                            ProgressView().progressViewStyle(.linear).tint(NotchLayout.periodColor(window))
+                        }
+                        if let reset = window.resetAt { Text(quotaResetTime(reset, l10n, now: now)).font(.caption).foregroundStyle(.secondary) }
+                    }.padding(.top, 6)
+                }
+                if account.windows.isEmpty && account.observedAt != nil && account.status == .ok { Text(l10n("mac.quota.noReadings")).foregroundStyle(.secondary) }
+                if let credits = account.credits {
+                    if credits.limit != nil || credits.used != nil || credits.usedFraction != nil || credits.resetAt != nil {
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(l10n("mac.quota.spendAllowance")).fontWeight(.semibold)
+                            if let used = credits.used, let limit = credits.limit {
+                                Text(l10n("mac.quota.usedOf", quotaNumber(used, l10n), quotaNumber(limit, l10n)))
+                            } else if let used = credits.used { Text(l10n("mac.quota.used", quotaNumber(used, l10n))) }
+                            else if let limit = credits.limit { Text(l10n("mac.quota.creditsLimit") + ": " + quotaNumber(limit, l10n)) }
+                            if let fraction = credits.usedFraction { Text(l10n("mac.quota.used", quotaPercent(fraction, locale: l10n.locale))) }
+                            if let reset = credits.resetAt { Text(quotaResetTime(reset, l10n, now: now)) }
+                        }.font(.caption).foregroundStyle(.secondary)
+                    }
+                }
+                if quotaCreditBalance(account.credits, l10n) != nil || quotaResetCards(account, l10n) != nil || account.observedAt != nil {
+                    Divider()
+                    HStack(alignment: .top) {
+                        VStack(alignment: .leading, spacing: 4) {
+                            if let balance = quotaCreditBalance(account.credits, l10n) { Text(l10n("mac.quota.credits") + " " + balance) }
+                            if let cards = quotaResetCards(account, l10n) { Text(cards) }
+                        }
+                        Spacer(minLength: 12)
+                        if let observed = account.observedAt { Text(l10n("mac.quota.updatedAt", quotaDate(observed, locale: l10n.locale))).fixedSize() }
+                    }.font(.caption).foregroundStyle(.secondary)
+                }
+            }
+        }
+        .padding(16)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(.quaternary.opacity(0.35), in: RoundedRectangle(cornerRadius: 10))
+    }
+}
+
+func quotaHasData(_ account: QuotaSnapshot) -> Bool {
+    account.observedAt != nil || !account.windows.isEmpty || account.resetCreditsAvailable != nil || account.resetCreditsNextExpiry != nil ||
+        account.credits.map { $0.unlimited != nil || $0.hasCredits != nil || $0.balance != nil || $0.limit != nil || $0.used != nil || $0.usedFraction != nil || $0.resetAt != nil } == true
+}
+
+enum QuotaUsageIndicatorState: Equatable {
+    case known(Double)
+    case indeterminate
+}
+
+func quotaUsageIndicatorState(_ window: QuotaWindow) -> QuotaUsageIndicatorState {
+    guard let remaining = window.remainingFraction else { return .indeterminate }
+    return .known(min(max(remaining, 0), 1))
+}
+
+@MainActor func quotaNumber(_ number: Double, _ l10n: Localizer) -> String { number.formatted(.number.locale(l10n.locale)) }
+
+@MainActor func quotaCreditBalance(_ credits: QuotaCredits?, _ l10n: Localizer) -> String? {
+    guard let credits else { return nil }
+    if credits.unlimited == true { return l10n("mac.quota.unlimited") }
+    return credits.balance ?? credits.hasCredits.map { l10n($0 ? "mac.quota.yes" : "mac.quota.no") }
+}
+
+@MainActor func quotaResetCards(_ account: QuotaSnapshot, _ l10n: Localizer) -> String? {
+    var text = account.resetCreditsAvailable.map { l10n("mac.quota.resetCards") + " " + $0.formatted(.number.locale(l10n.locale)) }
+    if account.resetCreditsAvailable != 0, let expiry = account.resetCreditsNextExpiry {
+        text = (text ?? l10n("mac.quota.resetCards")) + " · " + l10n("mac.quota.resetCardsNextExpiry", quotaDate(expiry, locale: l10n.locale))
+    }
+    return text
+}
+
+@MainActor func quotaInitialStatus(_ account: QuotaSnapshot, _ l10n: Localizer, networkEnabled: Bool, autoRefresh: Bool) -> String {
+    let message: String
+    if !networkEnabled { message = l10n("mac.quota.offline") }
+    else if account.waitingForRefresh { message = l10n(autoRefresh ? "mac.quota.providerWait" : "mac.quota.providerWaitManual") }
+    else if account.status == .ok { message = l10n("mac.quota.initial") }
+    else if account.status == .needsAuth && account.id == "codex" { message = l10n("mac.quota.codexSignIn") }
+    else { message = quotaStatus(account, l10n) }
+    return account.block.map { $0 == message ? message : message + " · " + $0 } ?? message
+}
+
+
+
+@MainActor func quotaObservationDelay(_ dates: [Date], now: Date) -> TimeInterval {
+    dates.map { QuotaDisplayClock.delay(observedAt: $0, now: now) }.min() ?? 60
+}
+
+func quotaIsProviderLabel(_ label: String, providerName: String?) -> Bool {
+    guard !label.isEmpty, let providerName else { return label.isEmpty }
+    if label == providerName { return true }
+    return quotaSources.contains { $0.name == label } && providerName.hasPrefix(label + " · ")
+}
+
+@MainActor func quotaWindowLabel(_ window: QuotaWindow, _ l10n: Localizer, providerName: String? = nil) -> String {
+    let period: String
+    switch window.period {
+    case .month: period = l10n("mac.quota.monthly")
+    case .week: period = l10n("mac.quota.weekly")
+    case .fiveHours: period = l10n("mac.quota.fiveHoursLimit")
+    case .other:
+        if let duration = window.periodDuration {
+            period = duration <= 86_400 ? l10n("mac.quota.session") + (duration < 86_400 ? " · " + l10n("mac.quota.hours", quotaNumber(duration / 3_600, l10n)) : "")
+                : l10n("mac.quota.window") + " · " + l10n("mac.quota.days", quotaNumber(duration / 86_400, l10n))
+        } else { period = l10n("mac.quota.window") }
+    }
+    return quotaIsProviderLabel(window.label, providerName: providerName) ? period : "\(window.label) · \(period)"
+}
+
+func quotaDate(_ date: Date, locale: Locale) -> String {
+    date.formatted(Date.FormatStyle(date: .abbreviated, time: .shortened).locale(locale))
+}
+
+func quotaPercent(_ fraction: Double, locale: Locale) -> String {
+    fraction.formatted(.percent.precision(.fractionLength(0...2)).locale(locale))
+}
+
+@MainActor func quotaStatus(_ account: QuotaSnapshot, _ l10n: Localizer) -> String {
+    if account.waitingForRefresh { return l10n("mac.quota.status.waiting") }
+    return switch account.status {
+    case .ok: l10n("mac.quota.status.ok")
+    case .stale: l10n("mac.quota.status.stale")
+    case .needsAuth: l10n("mac.quota.status.needsAuth")
+    case .accessDenied: l10n("mac.quota.status.accessDenied")
+    case .unsupported: l10n("mac.quota.status.unsupported")
+    case .error: l10n("mac.quota.status.error")
+    }
+}
+
+@MainActor func quotaDisplayStatus(_ account: QuotaSnapshot?, _ l10n: Localizer, networkEnabled: Bool, now: Date) -> String {
+    guard networkEnabled else { return l10n("mac.quota.offline") }
+    guard let account else { return l10n("mac.quota.empty") }
+    guard account.status == .ok && !account.waitingForRefresh else { return quotaStatus(account, l10n) }
+    guard let observed = account.observedAt else { return l10n("mac.quota.unknown") }
+    let age = max(0, now.timeIntervalSince(observed))
+    if age < 60 { return l10n("mac.quota.justNow") }
+    let (key, count) = age < 3_600 ? ("minutesAgo", Int(age / 60)) : age < 86_400 ? ("hoursAgo", Int(age / 3_600)) : ("daysAgo", Int(age / 86_400))
+    return l10n("mac.quota." + key, count.formatted(.number.locale(l10n.locale)))
+}
+
+@MainActor func quotaResetTime(_ reset: Date, _ l10n: Localizer, now: Date) -> String {
+    let seconds = reset.timeIntervalSince(now)
+    let countdown: String
+    if seconds <= 0 { countdown = l10n("mac.quota.resetPendingRefresh") }
+    else if seconds < 60 { countdown = l10n("mac.quota.resetUnderMinute") }
+    else {
+        let minutes = Int(seconds / 60)
+        let parts = [("countdownDays", minutes / 1_440), ("countdownHours", minutes / 60 % 24), ("countdownMinutes", minutes % 60)]
+            .filter { $0.1 > 0 }.map { l10n("mac.quota." + $0.0, $0.1.formatted(.number.locale(l10n.locale))) }
+        countdown = l10n("mac.quota.resetIn", parts.joined(separator: l10n("mac.quota.durationSeparator")))
+    }
+    return l10n("mac.quota.resetWithCountdown", quotaDate(reset, locale: l10n.locale), countdown)
+}
+
+/// A single local-only wakeup. It belongs to the visible view, not the HTTP polling controller.
+@MainActor @Observable final class QuotaDisplayClock {
+    private(set) var now = Date()
+    @ObservationIgnored private var task: Task<Void, Never>?
+
+    var isActive: Bool { task != nil }
+    nonisolated static func delay(observedAt: Date?, now: Date) -> TimeInterval {
+        let age = max(0, observedAt.map { now.timeIntervalSince($0) } ?? 0)
+        return max(0.001, 60 - age.truncatingRemainder(dividingBy: 60))
+    }
+
+    func start(observedAt: Date?, enabled: Bool = true) {
+        start(observationDates: observedAt.map { [$0] } ?? [], enabled: enabled)
+    }
+
+    func start(observationDates: [Date], enabled: Bool = true) {
+        stop()
+        now = Date()
+        guard enabled else { return }
+        task = Task { @MainActor [weak self] in
+            while !Task.isCancelled {
+                let delay = quotaObservationDelay(observationDates, now: Date())
+                try? await Task.sleep(for: .seconds(delay))
+                guard !Task.isCancelled, let self else { return }
+                self.now = Date()
+            }
+        }
+    }
+
+    func stop() { task?.cancel(); task = nil }
+    deinit { task?.cancel() }
+}
