diff --git a/macos/Sources/AgentSpeed/App/QuotaController.swift b/macos/Sources/AgentSpeed/App/QuotaController.swift
new file mode 100644
index 00000000..ac424756
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaController.swift
@@ -0,0 +1,64 @@
+import AgentSpeedCore
+import Foundation
+import Observation
+
+/// UI lifetime and visibility are separate from the provider; no credentials are persisted here.
+@MainActor @Observable
+final class QuotaController {
+    private let defaults: UserDefaults
+    private let provider = CodexQuotaProvider()
+    private var task: Task<Void, Never>?
+    private var timer: Timer?
+    private(set) var snapshots: [CodexQuotaSnapshot] = []
+    private(set) var isRefreshing = false
+    private(set) var networkEnabled = false
+    var visible: Bool {
+        didSet {
+            defaults.set(visible, forKey: "quota.panelVisible")
+            if visible && !oldValue { refresh() }
+        }
+    }
+
+    init(defaults: UserDefaults) {
+        self.defaults = defaults
+        visible = defaults.bool(forKey: "quota.panelVisible")
+    }
+
+    func setNetworkEnabled(_ enabled: Bool) {
+        guard networkEnabled != enabled else { return }
+        networkEnabled = enabled
+        if !enabled {
+            task?.cancel()
+            Task { [provider] in await provider.cancel() }
+            task = nil
+            isRefreshing = false
+            timer?.invalidate()
+            timer = nil
+        } else {
+            refresh()
+        }
+    }
+
+    func refresh() {
+        guard networkEnabled, !isRefreshing else { return }
+        isRefreshing = true
+        task = Task { [weak self, provider] in
+            let snapshot = await provider.refresh()
+            guard !Task.isCancelled, let self else { return }
+            self.snapshots = [snapshot]
+            self.isRefreshing = false
+            self.task = nil
+            self.scheduleRefresh()
+        }
+    }
+
+    private func scheduleRefresh() {
+        timer?.invalidate()
+        let timer = Timer(timeInterval: 300, repeats: false) { [weak self] _ in
+            MainActor.assumeIsolated { self?.refresh() }
+        }
+        timer.tolerance = 15
+        RunLoop.main.add(timer, forMode: .common)
+        self.timer = timer
+    }
+}
diff --git a/macos/Sources/AgentSpeed/App/QuotaPanelController.swift b/macos/Sources/AgentSpeed/App/QuotaPanelController.swift
new file mode 100644
index 00000000..226a7009
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaPanelController.swift
@@ -0,0 +1,95 @@
+import AgentSpeedCore
+import AppKit
+import SwiftUI
+
+/// A utility panel, independent of the dashboard and the orb windows. Closing it persists the choice.
+@MainActor
+final class QuotaPanelController: NSObject, NSWindowDelegate {
+    private let model: AppModel
+    private let panel: NSPanel
+    private var visibilityLoop: ObservationLoop?
+
+    init(model: AppModel) {
+        self.model = model
+        panel = NSPanel(contentRect: NSRect(x: 0, y: 0, width: 300, height: 240),
+                        styleMask: [.titled, .closable, .utilityWindow, .nonactivatingPanel],
+                        backing: .buffered, defer: false)
+        super.init()
+        panel.title = model.l10n("mac.quota.title")
+        panel.isReleasedWhenClosed = false
+        panel.hidesOnDeactivate = false
+        panel.level = .floating
+        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
+        panel.isMovableByWindowBackground = true
+        panel.contentView = NSHostingView(rootView: QuotaPanelView(model: model))
+        panel.delegate = self
+        panel.setFrameAutosaveName("QuotaPanel")
+        visibilityLoop = ObservationLoop { [weak self] in
+            guard let self else { return }
+            if self.model.quota.visible {
+                if !self.panel.isVisible { self.panel.orderFrontRegardless() }
+            } else if self.panel.isVisible {
+                self.panel.orderOut(nil)
+            }
+        }
+    }
+
+    func windowShouldClose(_ sender: NSWindow) -> Bool {
+        model.quota.visible = false
+        return true
+    }
+}
+
+private struct QuotaPanelView: View {
+    let model: AppModel
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 12) {
+                if !model.quota.networkEnabled || model.quota.snapshots.isEmpty {
+                    Button(model.l10n(model.quota.networkEnabled ? "mac.quota.empty" : "mac.quota.offline")) {
+                        model.commands?.showSettings(.quota)
+                    }
+                    .buttonStyle(.plain)
+                    .foregroundStyle(.secondary)
+                }
+                ForEach(model.quota.snapshots, id: \.id) { account in
+                    Button {
+                        model.commands?.showSettings(.quota)
+                    } label: {
+                        let window = account.windows.first { $0.id == account.headlineId }
+                        HStack(spacing: 12) {
+                            ZStack {
+                                Circle().stroke(.quaternary, lineWidth: 5)
+                                if let fraction = window?.usedFraction {
+                                    Circle().trim(from: 0, to: max(0, min(1, fraction)))
+                                        .stroke(.tint, style: StrokeStyle(lineWidth: 5, lineCap: .round))
+                                        .rotationEffect(.degrees(-90))
+                                }
+                            }
+                            .frame(width: 34, height: 34)
+                            VStack(alignment: .leading, spacing: 2) {
+                                Text(account.displayName).fontWeight(.semibold)
+                                if let window {
+                                    Text(window.label + " · " + (window.usedFraction.map { quotaPercent($0, locale: model.l10n.locale) } ?? model.l10n("mac.quota.unknown")))
+                                    if let reset = window.resetAt { Text(model.l10n("mac.quota.reset", quotaDate(reset, locale: model.l10n.locale))) }
+                                }
+                                Text(quotaStatus(account, model.l10n))
+                                if account.waitingForRefresh, let next = account.nextAllowedAt {
+                                    Text(model.l10n("mac.quota.next") + ": " + quotaDate(next, locale: model.l10n.locale))
+                                }
+                            }
+                            .font(.caption)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                        }
+                        .contentShape(Rectangle())
+                    }
+                    .buttonStyle(.plain)
+                    .help(model.l10n("mac.quota.title"))
+                }
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .padding(14)
+        }
+    }
+}
