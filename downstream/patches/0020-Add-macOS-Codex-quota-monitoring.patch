+private struct QuotaNotchCell: View {
+    let reading: QuotaNotchReading
+    let dark: Bool
+    var body: some View {
+        VStack(spacing: QuotaNotchContentLayout.readingGap) {
+            ZStack {
+                Circle().fill(dark ? Color(white: 42 / 255) : .white)
+                    .overlay(Circle().stroke(dark ? Color(white: 57 / 255) : Color(white: 214 / 255), lineWidth: 0.5))
+                    .frame(width: 36, height: 36)
+                if reading.windows.isEmpty {
+                    Circle().stroke(Color(white: 164 / 255).opacity(0.38), style: StrokeStyle(lineWidth: NotchLayout.ringStroke, dash: [1, 4]))
+                        .frame(width: 48, height: 48)
+                }
+                ForEach(Array(reading.windows.enumerated()), id: \.element.id) { index, window in
+                    let diameter = reading.outerDiameter - NotchLayout.ringStroke - CGFloat(index) * 16
+                    let unknown = window.usedFraction == nil || reading.snapshot?.status == .needsAuth
+                    let color = NotchLayout.periodColor(window)
+                    Circle().stroke(color.opacity(unknown ? 0.38 : 0.22), style: StrokeStyle(lineWidth: NotchLayout.ringStroke, dash: unknown ? [1, 4] : []))
+                        .frame(width: diameter, height: diameter)
+                    if !unknown, let remaining = window.remainingFraction {
+                        Circle().trim(from: 0, to: min(max(remaining, 0), 1))
+                            .stroke(color, style: StrokeStyle(lineWidth: NotchLayout.ringStroke, lineCap: .round)).rotationEffect(.degrees(-90))
+                            .frame(width: diameter, height: diameter)
+                    }
+                }
+                QuotaSourceLogo(providerID: reading.providerID, ink: dark ? .white : Color(white: 0.12)).frame(width: 22, height: 22)
+            }.frame(width: reading.outerDiameter, height: reading.outerDiameter)
+            HStack(spacing: 9) {
+                ForEach(reading.readings.indices, id: \.self) { index in
+                    HStack(spacing: 4) {
+                        if reading.windows.count > 1 { Circle().fill(NotchLayout.periodColor(reading.windows[index])).frame(width: 5, height: 5) }
+                        Text(reading.readings[index]).fixedSize()
+                    }
+                }
+            }.font(.system(size: reading.windows.count > 1 ? 11 : 15, weight: .semibold))
+        }
+        .fixedSize()
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(reading.displayName + ", " + reading.readings.joined(separator: ", "))
+    }
+}
