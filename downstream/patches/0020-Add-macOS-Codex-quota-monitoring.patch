+import Foundation
+import Testing
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+@Suite("Quota presentation")
+@MainActor
+struct QuotaPresentationTests {
+    private func window(_ used: Double?, duration: TimeInterval? = 18_000, label: String = "Codex") -> CodexQuotaWindow {
+        CodexQuotaWindow(id: "window", label: label, usedFraction: used, remaining: used.map { 1 - $0 },
+                         used: used, resetAt: nil, duration: duration)
+    }
+
+    private func account(_ id: String, status: CodexQuotaStatus = .ok, windows: [CodexQuotaWindow] = [],
+                         block: String? = nil) -> CodexQuotaSnapshot {
+        CodexQuotaSnapshot(id: id, displayName: id, fidelity: "official", status: status, windows: windows,
+                           headlineId: windows.first?.id, block: block, account: nil, plan: nil,
+                           observedAt: nil, source: "local", credits: nil, nextAllowedAt: nil,
+                           waitingForRefresh: false)
+    }
+
+    @Test func flyoutShowsOnlyWarningsAndLimitsRows() {
+        let normal = account("normal", windows: [window(0.899)])
+        let unknown = account("unknown", windows: [window(nil)])
+        let empty = account("empty")
+        #expect(quotaWarningAccounts([normal, unknown, empty]).isEmpty)
+        let near = account("near", windows: [window(0.9)])
+        let blocked = account("blocked", block: "Paused")
+        let auth = account("auth", status: .needsAuth)
+        #expect(quotaWarningAccounts([normal, near, blocked, auth]).map(\.id) == ["near", "blocked"])
+        #expect(quotaWarningAccounts([auth]).map(\.id) == ["auth"])
+    }
+
+    @Test func persistedCooldownShowsWaitingAfterProviderRestart() async throws {
+        let suite = "QuotaPresentationTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        let auth = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer {
+            defaults.removePersistentDomain(forName: suite)
+            try? FileManager.default.removeItem(at: auth)
+        }
+        try Data(#"{"tokens":{"access_token":"test-token","account_id":"test-account"}}"#.utf8).write(to: auth)
+        let now = Date(timeIntervalSince1970: 1_700_000_000)
+        let first = CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { now }) { request in
+            let response = HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!
+            return (Data(#"{"rate_limit":{"primary_window":{"used_percent":10}}}"#.utf8), response)
+        }
+        #expect(await first.refresh().status == .ok)
+        let restarted = CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { now }) { _ in
+            throw URLError(.cannotConnectToHost)
+        }
+        let waiting = await restarted.refresh()
+        #expect(waiting.status == .error)
+        #expect(waiting.waitingForRefresh)
+        let l10n = Localizer(preference: .en)
+        #expect(quotaStatus(waiting, l10n) == l10n("mac.quota.status.waiting"))
+    }
+
+    @Test func windowLabelsUseLocalizedDurationsAndKeepAdditionalNames() {
+        let english = Localizer(preference: .en)
+        let fiveHours = quotaWindowLabel(window(0.5), english)
+        let weekly = quotaWindowLabel(window(0.5, duration: 604_800), english)
+        #expect(fiveHours.contains("5"))
+        #expect(!fiveHours.contains("18000"))
+        #expect(weekly.contains("7"))
+        #expect(!weekly.contains("604800"))
+        #expect(quotaWindowLabel(window(nil, duration: nil, label: "Spark"), english) == "Spark")
+        #expect(quotaWindowLabel(window(nil, duration: 18_000, label: "Spark"), english).hasPrefix("Spark · "))
+    }
+
+    @Test func statusAndUnknownReadingsRemainDistinct() {
+        let english = Localizer(preference: .en)
+        #expect(quotaStatus(account("signed-out", status: .needsAuth), english) == english("mac.quota.status.needsAuth"))
+        #expect(quotaStatus(account("stale", status: .stale, windows: [window(0.2)]), english) == english("mac.quota.status.stale"))
+        #expect(window(nil).usedFraction == nil)
+        #expect(quotaPercent(0, locale: english.locale) != english("mac.quota.unknown"))
+    }
+
+    @Test func floatingVisibilitySurvivesControllerRecreation() throws {
+        let suite = "QuotaPresentationTests.visibility.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let first = QuotaController(defaults: defaults)
+        #expect(first.floatingVisible)
+        first.floatingVisible = false
+        let restored = QuotaController(defaults: defaults)
+        #expect(!restored.floatingVisible)
+        restored.floatingVisible = true
+        #expect(QuotaController(defaults: defaults).floatingVisible)
+    }
+}
