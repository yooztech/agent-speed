@@ -0,0 +1,83 @@
+import Foundation
+#if canImport(Darwin)
+import Darwin
+#else
+import Glibc
+#endif
+
+/// A schedule and its account-bound observation are replaced as one private file.
+/// No borrowed credential or raw server response is written to disk.
+struct QuotaPersistence: Sendable {
+    let directory: URL
+
+    static var directory: URL {
+        if let path = ProcessInfo.processInfo.environment["AGENT_SPEED_APP_DATA"], !path.isEmpty {
+            return URL(fileURLWithPath: path, isDirectory: true).appendingPathComponent("quota")
+        }
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("AgentSpeed/quota", isDirectory: true)
+    }
+
+    func load<T: Decodable>(_ type: T.Type, key: String) -> T? {
+        guard let data = try? Data(contentsOf: directory.appendingPathComponent(key + ".json")) else { return nil }
+        if let value = try? JSONDecoder().decode(type, from: data) { return value }
+        // A broken observation schema must not erase an independent 429/auth schedule.
+        guard var root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              root.removeValue(forKey: "observation") != nil,
+              let schedule = try? JSONSerialization.data(withJSONObject: root) else { return nil }
+        return try? JSONDecoder().decode(type, from: schedule)
+    }
+
+    @discardableResult
+    func save<T: Encodable>(_ value: T, key: String) -> Bool {
+        let file = directory.appendingPathComponent(key + ".json")
+        let temporary = directory.appendingPathComponent(UUID().uuidString + ".tmp")
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true,
+                                                    attributes: [.posixPermissions: 0o700])
+            try FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: directory.path)
+            let data = try JSONEncoder().encode(value)
+            guard FileManager.default.createFile(atPath: temporary.path, contents: data,
+                                                 attributes: [.posixPermissions: 0o600]) else { return false }
+            // POSIX rename atomically replaces the old schedule on the same volume.
+            guard rename(temporary.path, file.path) == 0 else {
+                try? FileManager.default.removeItem(at: temporary)
+                return false
+            }
+            return true
+        } catch {
+            try? FileManager.default.removeItem(at: temporary)
+            return false
+        }
+    }
+}
+
+struct QuotaPersistedObservation: Codable, Sendable {
+    let version: Int
+    let accountKey: String
+    let snapshot: QuotaSnapshot
+
+    init(accountKey: String, snapshot: QuotaSnapshot) {
+        version = 1
+        self.accountKey = accountKey
+        self.snapshot = snapshot
+    }
+
+    func validated(accountKey: String, id: String, source: String) -> QuotaSnapshot? {
+        guard version == 1, self.accountKey == accountKey, snapshot.id == id,
+              snapshot.source == source, snapshot.status == .ok, snapshot.account == nil,
+              snapshot.observedAt != nil, snapshot.windows.allSatisfy({ !$0.id.isEmpty }) else { return nil }
+        return snapshot
+    }
+}
+
+extension QuotaSnapshot {
+    func copying(status: QuotaStatus, next: Date?) -> QuotaSnapshot {
+        QuotaSnapshot(id: id, displayName: displayName, fidelity: fidelity, status: status,
+                      windows: windows, headlineId: headlineId, block: block, account: account,
+                      plan: plan, observedAt: observedAt, source: source, credits: credits,
+                      nextAllowedAt: next, waitingForRefresh: false,
+                      resetCreditsAvailable: resetCreditsAvailable, resetCreditsNextExpiry: resetCreditsNextExpiry,
+                      configured: configured)
+    }
+}
