diff --git a/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift b/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift
new file mode 100644
index 00000000..d1995bac
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift
@@ -0,0 +1,278 @@
+import Foundation
+import CryptoKit
+
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+// Protocol and parsing informed by Codenotch, Copyright (c) 2026 Vinz,
+// https://github.com/vinzdg/codenotch (MIT License). No credentials are modified.
+public enum CodexQuotaStatus: String, Sendable, Codable {
+    case ok, stale, needsAuth, accessDenied, unsupported, error
+}
+
+public struct CodexQuotaWindow: Sendable, Equatable {
+    public let id: String
+    public let label: String
+    public let usedFraction: Double?
+    public let remaining: Double?
+    public let used: Double?
+    public let resetAt: Date?
+    public let duration: TimeInterval?
+}
+
+public struct CodexQuotaCredits: Sendable, Equatable {
+    public let hasCredits: Bool?
+    public let unlimited: Bool?
+    public let limit: Double?
+    public let used: Double?
+    public let usedFraction: Double?
+    public let resetAt: Date?
+    public let balance: String?
+}
+
+public struct CodexQuotaSnapshot: Sendable, Equatable {
+    public let id: String
+    public let displayName: String
+    public let fidelity: String
+    public let status: CodexQuotaStatus
+    public let windows: [CodexQuotaWindow]
+    public let headlineId: String?
+    public let block: String?
+    public let account: String?
+    public let plan: String?
+    public let observedAt: Date?
+    public let source: String
+    public let credits: CodexQuotaCredits?
+    public let nextAllowedAt: Date?
+    /// No observation is available because a previously successful poll is still throttled.
+    public let waitingForRefresh: Bool
+}
+
+private struct QuotaCredentials: Decodable, Sendable {
+    struct Tokens: Decodable, Sendable { let access_token: String; let account_id: String }
+    let tokens: Tokens
+}
+
+private struct QuotaSchedule: Codable {
+    var nextAllowedAt: Date?
+    var failures: Int = 0
+    var rejectedToken: String?
+    var successfulObservation: Bool? = nil
+}
+
+private final class QuotaRedirectDelegate: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        // Do not send bearer credentials to a redirect target, even on the same host.
+        completionHandler(nil)
+    }
+}
+
+public actor CodexQuotaProvider {
+    typealias Transport = @Sendable (URLRequest) async throws -> (Data, HTTPURLResponse)
+    private let credentialURL: URL
+    private let defaults: UserDefaults
+    private let now: @Sendable () -> Date
+    private let transport: Transport
+    private var inFlight: Task<CodexQuotaSnapshot, Never>?
+    private var cached: [String: CodexQuotaSnapshot] = [:]
+
+    public init() {
+        let env = ProcessInfo.processInfo.environment
+        let home = env["CODEX_HOME"].flatMap { $0.isEmpty ? nil : $0 }
+            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".codex").path
+        credentialURL = URL(fileURLWithPath: home, isDirectory: true).appendingPathComponent("auth.json")
+        defaults = .standard
+        now = { Date() }
+        transport = Self.request
+    }
+
+    init(credentialURL: URL, defaults: UserDefaults, now: @escaping @Sendable () -> Date,
+         transport: @escaping Transport) {
+        self.credentialURL = credentialURL
+        self.defaults = defaults
+        self.now = now
+        self.transport = transport
+    }
+
+    public func refresh() async -> CodexQuotaSnapshot {
+        if let inFlight { return await inFlight.value }
+        let task = Task { await self.performRefresh() }
+        inFlight = task
+        let result = await task.value
+        inFlight = nil
+        return result
+    }
+
+    /// Cancels an active request when quota networking is disabled.
+    public func cancel() {
+        inFlight?.cancel()
+    }
+
+    private func performRefresh() async -> CodexQuotaSnapshot {
+        guard !Task.isCancelled else { return snapshot(status: .error) }
+        let time = now()
+        guard let data = try? Data(contentsOf: credentialURL),
+              let credentials = try? JSONDecoder().decode(QuotaCredentials.self, from: data),
+              !credentials.tokens.access_token.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              !credentials.tokens.account_id.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            return snapshot(status: .needsAuth)
+        }
+        let account = credentials.tokens.account_id
+        let accountKey = Self.digest(account)
+        let tokenKey = Self.digest(credentials.tokens.access_token)
+        let key = "codex.quota.schedule." + accountKey
+        var schedule = defaults.data(forKey: key).flatMap { try? JSONDecoder().decode(QuotaSchedule.self, from: $0) } ?? QuotaSchedule()
+        if schedule.rejectedToken == tokenKey { return snapshot(status: .needsAuth) }
+        if schedule.rejectedToken != nil { schedule.rejectedToken = nil; schedule.nextAllowedAt = nil; schedule.failures = 0 }
+        if let next = schedule.nextAllowedAt, time < next {
+            return cached[accountKey] ?? snapshot(status: .error, next: next, waiting: schedule.successfulObservation == true)
+        }
+        var request = URLRequest(url: URL(string: "https://chatgpt.com/backend-api/wham/usage")!)
+        request.setValue("Bearer \(credentials.tokens.access_token)", forHTTPHeaderField: "Authorization")
+        request.setValue(account, forHTTPHeaderField: "ChatGPT-Account-Id")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        guard !Task.isCancelled else {
+            return staleOrError(accountKey, next: nil)
+        }
+        do {
+            let (body, response) = try await transport(request)
+            let completed = now()
+            switch response.statusCode {
+            case 200...299:
+                schedule = QuotaSchedule(nextAllowedAt: completed.addingTimeInterval(300), failures: 0, rejectedToken: nil)
+                guard let parsed = try? Self.parse(body, at: completed) else {
+                    save(schedule, key: key)
+                    let result = staleOrError(accountKey, next: schedule.nextAllowedAt)
+                    cached[accountKey] = result
+                    return result
+                }
+                schedule.successfulObservation = true
+                save(schedule, key: key)
+                let result = withStatus(parsed, status: .ok, next: schedule.nextAllowedAt)
+                cached[accountKey] = result
+                return result
+            case 401, 403:
+                schedule.rejectedToken = tokenKey
+                schedule.nextAllowedAt = nil
+                save(schedule, key: key)
+                cached.removeValue(forKey: accountKey)
+                return snapshot(status: .needsAuth)
+            case 429:
+                schedule.failures = min(schedule.failures + 1, 6)
+                let exponential = min(1800.0, 60.0 * pow(2.0, Double(schedule.failures - 1)))
+                let retry = Self.retryAfter(response.value(forHTTPHeaderField: "Retry-After"), now: completed)
+                schedule.successfulObservation = false
+                schedule.nextAllowedAt = completed.addingTimeInterval(max(exponential, retry))
+                save(schedule, key: key)
+                let result = staleOrError(accountKey, next: schedule.nextAllowedAt)
+                cached[accountKey] = result
+                return result
+            default:
+                return staleOrError(accountKey, next: nil)
+            }
+        } catch {
+            return staleOrError(accountKey, next: nil)
+        }
+    }
+
+    private func save(_ schedule: QuotaSchedule, key: String) {
+        if let data = try? JSONEncoder().encode(schedule) { defaults.set(data, forKey: key) }
+    }
+
+    private static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func request(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {
+        let session = URLSession(configuration: .ephemeral, delegate: QuotaRedirectDelegate(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let (data, response) = try await session.data(for: request)
+        guard let response = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        return (data, response)
+    }
+
+    static func retryAfter(_ value: String?, now: Date) -> TimeInterval {
+        guard let value else { return 60 }
+        if let seconds = Double(value.trimmingCharacters(in: .whitespaces)), seconds.isFinite { return max(60, seconds) }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(secondsFromGMT: 0)
+        formatter.dateFormat = "EEE',' dd MMM yyyy HH':'mm':'ss zzz"
+        return max(60, formatter.date(from: value)?.timeIntervalSince(now) ?? 60)
+    }
+
+    static func parse(_ data: Data, at time: Date) throws -> CodexQuotaSnapshot {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any] else { throw URLError(.cannotParseResponse) }
+        var windows: [CodexQuotaWindow] = []
+        func add(_ limits: [String: Any]?, prefix: String, label: String) {
+            guard let limits else { return }
+            for slot in ["primary", "secondary"] {
+                guard let window = limits[slot + "_window"] as? [String: Any] else { continue }
+                let duration = (window["limit_window_seconds"] as? NSNumber)?.doubleValue
+                let validDuration = duration.flatMap { $0.isFinite && $0 >= 0 ? $0 : nil }
+                let percent = (window["used_percent"] as? NSNumber)?.doubleValue
+                let fraction = percent.flatMap { $0.isFinite ? $0 / 100 : nil }
+                let absolute = (window["reset_at"] as? NSNumber)?.doubleValue
+                let relative = (window["reset_after_seconds"] as? NSNumber)?.doubleValue
+                let reset = absolute.flatMap { $0.isFinite && $0 >= 0 ? Date(timeIntervalSince1970: $0) : nil }
+                    ?? relative.flatMap { $0.isFinite && $0 >= 0 ? time.addingTimeInterval($0) : nil }
+                let identity = validDuration.map { String($0) } ?? "unknown:\(slot)"
+                let baseID = "\(prefix):\(identity)"
+                let id = windows.contains(where: { $0.id == baseID }) ? "\(baseID):\(slot)" : baseID
+                windows.append(CodexQuotaWindow(id: id, label: label, usedFraction: fraction,
+                                               remaining: fraction.map { 1 - $0 }, used: fraction, resetAt: reset, duration: validDuration))
+            }
+        }
+        add(root["rate_limit"] as? [String: Any], prefix: "main", label: "Codex")
+        if let extras = root["additional_rate_limits"] as? [Any] {
+            for (index, value) in extras.enumerated() {
+                guard let extra = value as? [String: Any] else { continue }
+                let name = (extra["limit_name"] as? String) ?? (extra["metered_feature"] as? String) ?? "Extra \(index + 1)"
+                let identity = (extra["metered_feature"] as? String) ?? name
+                add(extra["rate_limit"] as? [String: Any], prefix: "extra:\(identity)", label: name)
+            }
+        }
+        add(root["code_review_rate_limit"] as? [String: Any], prefix: "code_review", label: "Code review")
+        let rawCredits = root["credits"] as? [String: Any]
+        let balance: String? = (rawCredits?["balance"] as? String) ?? (rawCredits?["balance"] as? NSNumber)?.stringValue
+        func number(_ value: Any?) -> Double? {
+            if let number = value as? NSNumber { return number.doubleValue }
+            if let text = value as? String { return Double(text) }
+            return nil
+        }
+        let spend = (root["spend_control"] as? [String: Any])?["individual_limit"] as? [String: Any]
+        let creditPercent = number(spend?["used_percent"])
+        let creditReset = number(spend?["reset_at"])
+        let credits = (rawCredits != nil || spend != nil) ? CodexQuotaCredits(
+            hasCredits: rawCredits?["has_credits"] as? Bool, unlimited: rawCredits?["unlimited"] as? Bool,
+            limit: number(spend?["limit"]), used: number(spend?["used"]),
+            usedFraction: creditPercent.map { $0 / 100 },
+            resetAt: creditReset.map { Date(timeIntervalSince1970: $0) }, balance: balance) : nil
+        return CodexQuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: .ok,
+                                  windows: windows, headlineId: windows.first(where: { $0.id.hasPrefix("main:") })?.id, block: nil, account: nil,
+                                  plan: root["plan_type"] as? String, observedAt: time, source: "wham/usage",
+                                  credits: credits, nextAllowedAt: nil, waitingForRefresh: false)
+    }
+
+    private func staleOrError(_ accountKey: String, next: Date?) -> CodexQuotaSnapshot {
+        guard let value = cached[accountKey], value.observedAt != nil else {
+            return snapshot(status: .error, next: next)
+        }
+        return withStatus(value, status: .stale, next: next)
+    }
+
+    private func snapshot(status: CodexQuotaStatus, next: Date? = nil, waiting: Bool = false) -> CodexQuotaSnapshot {
+        CodexQuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: status,
+                           windows: [], headlineId: nil, block: nil, account: nil, plan: nil, observedAt: nil,
+                           source: "wham/usage", credits: nil, nextAllowedAt: next, waitingForRefresh: waiting)
+    }
+
+    private func withStatus(_ value: CodexQuotaSnapshot, status: CodexQuotaStatus, next: Date?) -> CodexQuotaSnapshot {
+        CodexQuotaSnapshot(id: value.id, displayName: value.displayName, fidelity: value.fidelity, status: status,
+                           windows: value.windows, headlineId: value.headlineId, block: value.block, account: value.account,
+                           plan: value.plan, observedAt: value.observedAt, source: value.source, credits: value.credits, nextAllowedAt: next,
+                           waitingForRefresh: false)
+    }
+}
diff --git a/macos/Tests/AgentSpeedCoreTests/CodexQuotaProviderTests.swift b/macos/Tests/AgentSpeedCoreTests/CodexQuotaProviderTests.swift
