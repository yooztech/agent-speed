+enum QuotaGripGeometry {
+    private static let s = sqrt(CGFloat(0.5))
+    static func quarter(_ center: CGPoint, radius: CGFloat, from: CGFloat = 0, to: CGFloat = 1, shift: CGFloat = 0) -> QuotaGripFootprint {
