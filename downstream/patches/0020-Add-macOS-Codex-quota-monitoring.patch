+struct QuotaGlyph: Shape {
+    private static let outline: Path = {
+        var path = Path()
+        for loop in QuotaGlyphOutline.openai {
+            guard let first = loop.first else { continue }
+            path.move(to: first)
+            for point in loop.dropFirst() { path.addLine(to: point) }
+            path.closeSubpath()
+        }
+        return path
+    }()
+    func path(in rect: CGRect) -> Path {
+        Self.outline.applying(CGAffineTransform(a: rect.width, b: 0, c: 0, d: rect.height, tx: rect.minX, ty: rect.minY))
+    }
+}
