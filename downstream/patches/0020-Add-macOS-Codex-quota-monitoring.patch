index dacd9698..41d38d53 100644
--- a/macos/Sources/AgentSpeed/Dashboard/DashboardView.swift
+++ b/macos/Sources/AgentSpeed/Dashboard/DashboardView.swift
@@ -145,8 +145,77 @@ private struct DashboardDetails: View {
                     .padding(.top, DashboardLayout.sectionSpacing)
                     .transition(.opacity)
             }
+            QuotaDashboardSummary(model: model)
         }
         .animation(model.dashboardMotion, value: warnings.isEmpty)
         .animation(model.dashboardMotion, value: model.settings.trafficEnabled)
     }
 }
+
+/// Every selected account's latest observation, including healthy ones; the existing Settings page holds the details.
+private struct QuotaDashboardSummary: View {
+    let model: AppModel
+    @State private var clock = QuotaDisplayClock()
+
+    private var accounts: [QuotaSnapshot] { model.quota.snapshots }
+
+    var body: some View {
+        if !accounts.isEmpty {
+            SectionDivider()
+            Button {
+                model.commands?.showSettings(.quota)
+            } label: {
+                VStack(alignment: .leading, spacing: 10) {
+                    Text(model.l10n("mac.quota.title")).font(.headline)
+                    ForEach(accounts, id: \.id) { account in
+                        VStack(alignment: .leading, spacing: 4) {
+                            HStack {
+                                QuotaSourceLogo(providerID: account.id, ink: .primary).frame(width: 14, height: 14)
+                                Text(account.displayName)
+                                Spacer()
+                                if let plan = account.plan { Text(plan).foregroundStyle(.secondary) }
+                            }
+                            ForEach(QuotaWindow.ordered(account.windows), id: \.id) { window in
+                                HStack {
+                                    Text(quotaWindowLabel(window, model.l10n, providerName: account.displayName))
+                                    Spacer()
+                                    Text(window.remainingFraction.map { model.l10n("mac.quota.remaining", quotaPercent($0, locale: model.l10n.locale)) }
+                                         ?? model.l10n("mac.quota.unknown")).monospacedDigit()
+                                }
+                                switch quotaUsageIndicatorState(window) {
+                                case .known(let remaining):
+                                    ProgressView(value: remaining).tint(NotchLayout.periodColor(window))
+                                case .indeterminate:
+                                    ProgressView().progressViewStyle(.linear).tint(NotchLayout.periodColor(window))
+                                }
+                                if let reset = window.resetAt {
+                                    Text(quotaResetTime(reset, model.l10n, now: clock.now))
+                                        .foregroundStyle(.secondary)
+                                }
+                            }
+                            Text(quotaDisplayStatus(account, model.l10n, networkEnabled: model.quota.networkEnabled, now: clock.now))
+                                .font(.caption).foregroundStyle(.secondary)
+                            if let block = account.block {
+                                Text(block).font(.caption).foregroundStyle(.secondary)
+                            }
+
+                        }
+                        .font(.caption)
+                    }
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+            .onAppear { updateClock() }
+            .onChange(of: accounts) { updateClock() }
+            .onChange(of: model.quota.networkEnabled) { updateClock() }
+            .onChange(of: model.isDashboardShown) { updateClock() }
+            .onDisappear { clock.stop() }
+        }
+    }
+
+    private func updateClock() {
+        clock.start(observationDates: accounts.compactMap(\.observedAt), enabled: model.isDashboardShown && model.quota.networkEnabled && !accounts.isEmpty)
+    }
+}
