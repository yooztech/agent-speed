@@ -0,0 +1,93 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+import Testing
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+private final class WarmStartupTransport: @unchecked Sendable {
+    private let lock = NSLock()
+    private var time = Date(timeIntervalSince1970: 1_800_000_000)
+    private var calls = 0
+    func now() -> Date { lock.lock(); defer { lock.unlock() }; return time }
+    func advance(_ seconds: TimeInterval) { lock.lock(); defer { lock.unlock() }; time.addTimeInterval(seconds) }
+    func count() -> Int { lock.lock(); defer { lock.unlock() }; return calls }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.lock(); defer { lock.unlock() }
+        let usage = request.url!.path.hasSuffix("/usage")
+        if usage { calls += 1 }
+        let status = usage && calls == 2 ? 503 : 200
+        let body = usage
+            ? #"{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":25,"limit_window_seconds":18000}}}"#
+            : #"{"available_count":2}"#
+        return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!)
+    }
+}
+
+@MainActor
+private final class WarmStartupScheduler: QuotaRefreshScheduling {
+    private(set) var delay: TimeInterval?
+    private var retry: (@MainActor () -> Void)?
+    func start(every interval: TimeInterval, tick: @escaping @MainActor () -> Void) { }
+    func stop() { }
+    func scheduleRetry(for sourceID: String, after delay: TimeInterval, tick: @escaping @MainActor () -> Void) {
+        self.delay = delay; retry = tick
+    }
+    func cancelRetry(for sourceID: String) { delay = nil; retry = nil }
+    func stopRetries() { delay = nil; retry = nil }
+    func fire() {
+        let tick = retry
+        delay = nil; retry = nil
+        tick?()
+    }
+}
+
+@Suite("Warm Codex startup recovery", .timeLimit(.minutes(1)))
+@MainActor
+struct QuotaWarmStartupTests {
+    @Test func cachedStartupFailureKeepsReadingAndRetriesActualHttpAtSixtySeconds() async throws {
+        let suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(suite)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer {
+            defaults.removePersistentDomain(forName: suite)
+            try? FileManager.default.removeItem(at: directory)
+        }
+        let auth = directory.appendingPathComponent("auth.json")
+        try Data(#"{"tokens":{"access_token":"fixture","account_id":"fixture-account"}}"#.utf8).write(to: auth)
+        let transport = WarmStartupTransport()
+        func provider() -> CodexQuotaProvider {
+            CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { transport.now() },
+                cacheDirectory: directory.appendingPathComponent("schedule"), transport: { transport.fetch($0) })
+        }
+        let seed = provider()
+        let successful = await seed.refresh()
+        #expect(successful.status == .ok)
+        #expect(transport.count() == 1)
+        let restored = provider()
+        #expect(await restored.readCachedSnapshot().observedAt == successful.observedAt)
+        let scheduler = WarmStartupScheduler()
+        let controller = QuotaController(defaults: defaults, providers: [restored], scheduler: scheduler, now: { transport.now() })
+        defer { controller.dispose() }
+        controller.setNetworkEnabled(true)
+        await controller.operationBarrier().value
+        #expect(transport.count() == 2, "Startup must bypass only the cached successful polling floor")
+        #expect(controller.snapshots.first?.status == .stale)
+        #expect(controller.snapshots.first?.observedAt == successful.observedAt)
+        #expect(controller.snapshots.first?.windows == successful.windows)
+        #expect(scheduler.delay == 60, "A validated cached account uses warm backoff, not the five-minute tick")
+        transport.advance(59)
+        scheduler.fire()
+        #expect(transport.count() == 2)
+        #expect(scheduler.delay == 1)
+        transport.advance(1)
+        scheduler.fire()
+        await controller.operationBarrier().value
+        #expect(transport.count() == 3)
+        #expect(controller.snapshots.first?.status == .ok)
+        #expect(controller.snapshots.first?.observedAt == transport.now())
+        #expect(scheduler.delay == nil)
+    }
+}
