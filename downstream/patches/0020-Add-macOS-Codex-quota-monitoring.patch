+@MainActor
+final class QuotaNotchController {
+    private let model: AppModel
+    private let panel = QuotaNotchPanel(frame: .zero)
+    private let container = QuotaNotchContainer(frame: .zero)
+    private let hover = QuotaNotchHover()
+    private let pointer = OrbWindowPointerTracker()
+    private var hosting: QuotaNotchHostingView?
+    private var geometry: QuotaNotchGeometry?
+    private var displayID: UInt32?
+    private var edge: NotchEdge
+    private var stopped = false
+    private var revision = 0
+    nonisolated(unsafe) private var screenObserver: NSObjectProtocol?
+
+    init(model: AppModel) {
+        self.model = model
+        edge = UserDefaults.standard.string(forKey: "quota.notchEdge").flatMap(NotchEdge.init(rawValue:)) ?? .right
+        let screen = NSScreen.screens.first { $0.frame.contains(NSEvent.mouseLocation) } ?? NSScreen.main
+        displayID = screen.flatMap(Self.id)
+        panel.contentView = container
+        pointer.onMove = { [weak self] point, _ in self?.pointerMoved(point) }
+        screenObserver = NotificationCenter.default.addObserver(forName: NSApplication.didChangeScreenParametersNotification,
+                                                               object: nil, queue: .main) { [weak self] _ in
+            MainActor.assumeIsolated { self?.update() }
+        }
+        update()
+    }
+
+    func stop() {
+        stopped = true
+        revision += 1
+        pointer.stop()
+        hover.reset()
+        panel.orderOut(nil)
+        if let screenObserver { NotificationCenter.default.removeObserver(screenObserver) }
+        screenObserver = nil
+    }
+
+    deinit {
+        if let screenObserver { NotificationCenter.default.removeObserver(screenObserver) }
+    }
+
+    private static func id(_ screen: NSScreen) -> UInt32? {
+        (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.uint32Value
+    }
+
+    private func update() {
+        guard !stopped else { return }
+        revision += 1
+        let current = revision
+        if !model.quota.floatingVisible { hover.reset() }
+        withObservationTracking {
+            let visible = model.quota.floatingVisible
+            let reading = QuotaNotchReading(snapshot: model.quota.snapshots.first,
+                                           networkEnabled: model.quota.networkEnabled, l10n: model.l10n)
+            let expanded = hover.expanded, tooltip = hover.tooltip, settings = hover.settingsHovered
+            let tucked = hover.handlesTuckedAway
+            // Resolve the original monitor by identity, not NSScreen.main (which
+            // follows the focused app and would move this nonactivating panel).
+            guard let screen = NSScreen.screens.first(where: { Self.id($0) == displayID }) ?? NSScreen.screens.first else {
+                pointer.stop(); panel.orderOut(nil); return
+            }
+            displayID = Self.id(screen)
+            let requested = QuotaNotchGeometry(edge: edge, expanded: expanded, tooltip: tooltip,
+                                              settingsHovered: settings, cardHeight: reading.cardHeight,
+                                              available: screen.frame.size, handlesTuckedAway: tucked)
+            panel.setFrame(requested.panelFrame(on: screen.frame), display: true)
+            let geometry = QuotaNotchGeometry(edge: edge, expanded: expanded, tooltip: tooltip,
+                                             settingsHovered: settings, cardHeight: reading.cardHeight,
+                                             actualSize: container.bounds.size, handlesTuckedAway: tucked)
+            self.geometry = geometry
+            let view = QuotaNotchView(reading: reading, geometry: geometry,
+                                     onSettings: { [weak self] in self?.model.commands?.showSettings(.quota) },
+                                     onEdge: { [weak self] edge in
+                                         guard let self else { return }
+                                         self.edge = edge
+                                         UserDefaults.standard.set(edge.rawValue, forKey: "quota.notchEdge")
+                                         self.hover.reset()
+                                         self.update()
+                                     }, onHide: { [weak self] in self?.model.quota.floatingVisible = false })
+            if let hosting {
+                hosting.rootView = view
+                hosting.geometry = geometry
+            } else {
+                let hosting = QuotaNotchHostingView(rootView: view)
+                hosting.sizingOptions = []
+                hosting.autoresizingMask = [.width, .height]
+                hosting.geometry = geometry
+                container.addSubview(hosting)
+                self.hosting = hosting
+            }
+            hosting?.frame = container.bounds
+            if visible {
+                panel.orderFrontRegardless()
+                pointer.start()
+            } else {
+                pointer.stop()
+                panel.ignoresMouseEvents = true
+                panel.orderOut(nil)
+            }
+        } onChange: { [weak self] in
+            Task { @MainActor [weak self] in
+                guard let self, self.revision == current else { return }
+                self.update()
+            }
+        }
+        // Opening changes the target under a stationary pointer. Reclassify
+        // only after observation is armed, so entering the newly exposed cell
+        // schedules its tooltip without requiring another physical mouse move.
+        pointerMoved(NSEvent.mouseLocation)
+    }
+
+    private func localPoint(_ point: CGPoint) -> CGPoint {
+        CGPoint(x: point.x - panel.frame.minX, y: panel.frame.maxY - point.y)
+    }
+
+    private func updateMouseInterception(at point: CGPoint) {
+        // A nil NSView hit test alone does NOT pass a window's click through to
+        // the desktop. The window itself must ignore the mouse in every hole.
+        panel.ignoresMouseEvents = pointer.isForeignDragActive || geometry?.hits(localPoint(point)) != true
+    }
+
+    private func pointerMoved(_ point: CGPoint) {
+        guard panel.isVisible, let geometry else { return }
+        updateMouseInterception(at: point)
+        guard !pointer.isForeignDragActive else { return }
+        hover.move(to: panel.frame.contains(point) ? geometry.region(at: localPoint(point)) : .outside)
+    }
+}
