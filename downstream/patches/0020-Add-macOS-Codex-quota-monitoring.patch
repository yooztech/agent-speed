+    mutating func to(_ target: CGFloat, now: TimeInterval, delay: TimeInterval = 0,
+                     duration: TimeInterval, x1: CGFloat = 0.42, x2: CGFloat = 0.58) {
+        from = value; self.target = target; start = now + delay; self.duration = duration
+        self.x1 = x1; self.x2 = x2; active = from != target
+    }
+    mutating func sample(_ now: TimeInterval) {
+        guard active else { return }
+        guard now > start else { value = from; return }
+        let x = CGFloat(min(max((now - start) / duration, 0), 1))
+        if x >= 1 { snap(target); return }
+        var low: CGFloat = 0, high: CGFloat = 1, t = x
+        for _ in 0..<24 {
+            t = (low + high) / 2
