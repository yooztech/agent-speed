 }
+
+func quotaWarningAccounts(_ snapshots: [CodexQuotaSnapshot]) -> [CodexQuotaSnapshot] {
+    Array(snapshots.filter { account in
+        account.status == .needsAuth || account.block != nil ||
+            account.windows.contains { ($0.usedFraction ?? -1) >= 0.9 }
+    }.prefix(2))
+}
+
+/// A glanceable warning, not a second quota list; the existing Settings page holds the details.
+private struct QuotaDashboardSummary: View {
+    let model: AppModel
+
+    private var accounts: [CodexQuotaSnapshot] { quotaWarningAccounts(model.quota.snapshots) }
+
+    var body: some View {
+        if !accounts.isEmpty {
+            SectionDivider()
+            Button {
+                model.commands?.showSettings(.quota)
+            } label: {
+                VStack(alignment: .leading, spacing: 10) {
+                    Text(model.l10n("mac.quota.title")).font(.headline)
+                    ForEach(accounts, id: \.id) { account in
+                        let window = account.windows.first { $0.id == account.headlineId }
+                        VStack(alignment: .leading, spacing: 4) {
+                            HStack {
+                                Text(account.displayName + (window.map { " · " + quotaWindowLabel($0, model.l10n) } ?? ""))
+                                Spacer()
+                                Text(window?.usedFraction.map { quotaPercent($0, locale: model.l10n.locale) } ?? model.l10n("mac.quota.unknown"))
+                                    .monospacedDigit()
+                            }
+                            if let used = window?.usedFraction {
+                                ProgressView(value: max(0, min(1, used)))
+                                    .tint(quotaAccent(used))
+                            }
+                            if account.status != .ok {
+                                Text(quotaStatus(account, model.l10n))
+                                    .font(.caption).foregroundStyle(.secondary)
+                            }
+                            if account.status == .stale, let observed = account.observedAt {
+                                Text(model.l10n("mac.quota.observed") + ": " + quotaAge(observed, locale: model.l10n.locale))
+                                    .font(.caption).foregroundStyle(.secondary)
+                            }
+                            if let block = account.block {
+                                Text(block).font(.caption).foregroundStyle(.secondary)
+                            }
+                            HStack {
+                                if let reset = window?.resetAt {
+                                    Text(model.l10n("mac.quota.reset", quotaDate(reset, locale: model.l10n.locale)))
+                                }
+                                Spacer()
+                                if let plan = account.plan { Text(plan) }
+                            }
+                            .font(.caption).foregroundStyle(.secondary)
+                        }
+                        .font(.caption)
+                    }
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+        }
+    }
+}
