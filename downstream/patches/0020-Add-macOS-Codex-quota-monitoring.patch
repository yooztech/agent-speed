diff --git a/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift b/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift
new file mode 100644
index 00000000..25152a26
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/CodexQuotaProvider.swift
@@ -0,0 +1,346 @@
+import Foundation
+#if canImport(CryptoKit)
+import CryptoKit
+#else
+import Crypto
+#endif
+
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+// Protocol and parsing informed by Codenotch, Copyright (c) 2026 Vinz,
+// https://github.com/vinzdg/codenotch (MIT License). No credentials are modified.
+
+private struct QuotaCredentials: Decodable, Sendable, Equatable {
+    struct Tokens: Decodable, Sendable, Equatable { let access_token: String; let account_id: String }
+    let tokens: Tokens
+}
+
+private struct QuotaSchedule: Codable {
+    var nextAllowedAt: Date?
+    var failures: Int = 0
+    var rejectedToken: String?
+    var successfulObservation: Bool? = nil
+    var retryNotBefore: Date?
+    var resetRejectedToken: String?
+    var observation: QuotaPersistedObservation?
+}
+
+private final class QuotaRedirectDelegate: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) {
+        // Do not send bearer credentials to a redirect target, even on the same host.
+        completionHandler(nil)
+    }
+}
+
+public actor CodexQuotaProvider: QuotaProvider {
+    public nonisolated let id = "codex"
+    typealias Transport = @Sendable (URLRequest) async throws -> (Data, HTTPURLResponse)
+    private let credentialURL: URL
+    private let defaults: UserDefaults
+    private let now: @Sendable () -> Date
+    private let transport: Transport
+    private var inFlight: Task<QuotaSnapshot, Never>?
+    private var cached: [String: QuotaSnapshot] = [:]
+    private var schedules: [String: QuotaSchedule] = [:]
+    private let persistence: QuotaPersistence
+    private var startupRequested = false
+    private var generation = 0
+
+    public init() {
+        let env = ProcessInfo.processInfo.environment
+        let home = env["CODEX_HOME"].flatMap { $0.isEmpty ? nil : $0 }
+            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".codex").path
+        credentialURL = URL(fileURLWithPath: home, isDirectory: true).appendingPathComponent("auth.json")
+        defaults = .standard
+        now = { Date() }
+        persistence = QuotaPersistence(directory: QuotaPersistence.directory.appendingPathComponent("codex"))
+        transport = Self.request
+    }
+
+    init(credentialURL: URL, defaults: UserDefaults, now: @escaping @Sendable () -> Date,
+         cacheDirectory: URL? = nil, transport: @escaping Transport) {
+        self.credentialURL = credentialURL
+        self.defaults = defaults
+        self.now = now
+        self.transport = transport
+        persistence = QuotaPersistence(directory: cacheDirectory ?? credentialURL.appendingPathExtension("quota-cache"))
+    }
+
+    public func readCachedSnapshot() -> QuotaSnapshot {
+        guard let credentials = readCredentials() else { return snapshot(status: .needsAuth) }
+        let account = Self.digest(credentials.tokens.account_id)
+        let schedule = load(account)
+        guard schedule.rejectedToken != Self.digest(credentials.tokens.access_token) else { return snapshot(status: .needsAuth) }
+        return staleOrError(account, next: schedule.nextAllowedAt)
+    }
+
+    public func refresh() async -> QuotaSnapshot { await startRefresh(startup: false) }
+    public func refreshStartup() async -> QuotaSnapshot { await startRefresh(startup: true) }
+
+    private func startRefresh(startup: Bool) async -> QuotaSnapshot {
+        let bypass = startup && !startupRequested
+        if startup { startupRequested = true }
+        if let inFlight { return await inFlight.value }
+        let current = generation
+        let task = Task { await self.performRefresh(bypassSuccessFloor: bypass) }
+        inFlight = task
+        let result = await task.value
+        if current == generation { inFlight = nil }
+        return result
+    }
+
+    public func cancel() {
+        generation += 1
+        inFlight?.cancel()
+        inFlight = nil
+    }
+
+    private func readCredentials() -> QuotaCredentials? {
+        guard let data = try? Data(contentsOf: credentialURL),
+              let credentials = try? JSONDecoder().decode(QuotaCredentials.self, from: data),
+              [credentials.tokens.access_token, credentials.tokens.account_id].allSatisfy({
+                  !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && !$0.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains)
+              }) else { return nil }
+        return credentials
+    }
+
+    private func load(_ account: String) -> QuotaSchedule {
+        let schedule = schedules[account] ?? persistence.load(QuotaSchedule.self, key: account)
+            ?? defaults.data(forKey: "codex.quota.schedule." + account).flatMap { try? JSONDecoder().decode(QuotaSchedule.self, from: $0) }
+            ?? QuotaSchedule()
+        schedules[account] = schedule
+        if cached[account] == nil, let value = schedule.observation?.validated(accountKey: account, id: id, source: "wham/usage") {
+            cached[account] = value.copying(status: .stale, next: schedule.nextAllowedAt)
+        }
+        return schedule
+    }
+
+    private func performRefresh(bypassSuccessFloor: Bool) async -> QuotaSnapshot {
+        guard !Task.isCancelled else { return readCachedSnapshot() }
+        guard let credentials = readCredentials() else { return snapshot(status: .needsAuth) }
+        let account = credentials.tokens.account_id
+        let accountKey = Self.digest(account)
+        let tokenKey = Self.digest(credentials.tokens.access_token)
+        var schedule = load(accountKey)
+        if schedule.rejectedToken == tokenKey { return snapshot(status: .needsAuth) }
+        // Rotation removes only the token-specific ban, never account-wide pacing.
+        schedule.rejectedToken = nil
+        let time = now()
+        let trustedSuccess = schedule.successfulObservation == true &&
+            schedule.observation?.validated(accountKey: accountKey, id: id, source: "wham/usage") != nil
+        if let next = schedule.nextAllowedAt, time < next,
+           !(bypassSuccessFloor && trustedSuccess && !(schedule.retryNotBefore.map { time < $0 } ?? false)) {
+            return cached[accountKey] ?? snapshot(status: .error, next: next, waiting: schedule.successfulObservation == true)
+        }
+        var request = Self.authorizedRequest("https://chatgpt.com/backend-api/wham/usage", credentials: credentials)
+        request.timeoutInterval = 15
+        var result: QuotaSnapshot
+        do {
+            let (body, response) = try await transport(request)
+            guard !Task.isCancelled, readCredentials() == credentials else { return readCachedSnapshot() }
+            let completed = now()
+            switch response.statusCode {
+            case 200...299:
+                let parsed = try Self.parse(body, at: completed)
+                schedule.nextAllowedAt = completed.addingTimeInterval(300)
+                schedule.retryNotBefore = nil
+                schedule.failures = 0
+                schedule.successfulObservation = true
+                var reset: (available: Int?, expiry: Date?) = (nil, nil)
+                if schedule.resetRejectedToken != tokenKey {
+                    var resetRequest = Self.authorizedRequest("https://chatgpt.com/backend-api/wham/rate-limit-reset-credits", credentials: credentials)
+                    resetRequest.setValue("no-cache, no-store", forHTTPHeaderField: "Cache-Control")
+                    resetRequest.setValue("codex-1", forHTTPHeaderField: "OpenAI-Beta")
+                    do {
+                        let (data, response) = try await transport(resetRequest)
+                        guard !Task.isCancelled, readCredentials() == credentials else { return readCachedSnapshot() }
+                        if response.statusCode == 401 || response.statusCode == 403 { schedule.resetRejectedToken = tokenKey }
+                        if response.statusCode == 429 {
+                            let retry = now().addingTimeInterval(Self.retryAfter(response.value(forHTTPHeaderField: "Retry-After"), now: now()))
+                            schedule.nextAllowedAt = max(schedule.nextAllowedAt!, retry)
+                            schedule.retryNotBefore = schedule.nextAllowedAt
+                        }
+                        if (200...299).contains(response.statusCode) { reset = (try? Self.parseResetCredits(data)) ?? (nil, nil) }
+                    } catch { /* The optional endpoint cannot invalidate a successful usage observation. */ }
+                }
+                result = QuotaSnapshot(id: parsed.id, displayName: parsed.displayName, fidelity: parsed.fidelity, status: .ok,
+                    windows: parsed.windows, headlineId: parsed.headlineId, block: parsed.block, account: parsed.account,
+                    plan: parsed.plan, observedAt: parsed.observedAt, source: parsed.source, credits: parsed.credits,
+                    nextAllowedAt: schedule.nextAllowedAt, waitingForRefresh: false,
+                    resetCreditsAvailable: reset.available, resetCreditsNextExpiry: reset.expiry)
+                schedule.observation = QuotaPersistedObservation(accountKey: accountKey, snapshot: result)
+            case 401, 403:
+                schedule.rejectedToken = tokenKey
+                schedule.successfulObservation = false
+                result = snapshot(status: .needsAuth)
+            default:
+                backoff(&schedule, at: completed, retry: response.statusCode == 429 ? Self.retryAfter(response.value(forHTTPHeaderField: "Retry-After"), now: completed) : 0)
+                result = staleOrError(accountKey, next: schedule.nextAllowedAt)
+            }
+        } catch {
+            guard !Task.isCancelled, readCredentials() == credentials else { return readCachedSnapshot() }
+            backoff(&schedule, at: now(), retry: 0)
+            result = staleOrError(accountKey, next: schedule.nextAllowedAt)
+        }
+        guard !Task.isCancelled, readCredentials() == credentials else { return readCachedSnapshot() }
+        save(schedule, key: accountKey)
+        if result.status == .needsAuth { cached.removeValue(forKey: accountKey) }
+        else { cached[accountKey] = result }
+        return result
+    }
+
+    private func backoff(_ schedule: inout QuotaSchedule, at time: Date, retry: TimeInterval) {
+        schedule.failures = min(schedule.failures + 1, 6)
+        schedule.nextAllowedAt = time.addingTimeInterval(max(60 * pow(2, Double(schedule.failures - 1)), retry))
+        schedule.retryNotBefore = schedule.nextAllowedAt
+        schedule.successfulObservation = false
+    }
+
+    private static func authorizedRequest(_ endpoint: String, credentials: QuotaCredentials) -> URLRequest {
+        var request = URLRequest(url: URL(string: endpoint)!)
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(credentials.tokens.access_token)", forHTTPHeaderField: "Authorization")
+        request.setValue(credentials.tokens.account_id, forHTTPHeaderField: "ChatGPT-Account-Id")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+
+    private func save(_ schedule: QuotaSchedule, key: String) {
+        schedules[key] = schedule
+        if persistence.save(schedule, key: key) { defaults.removeObject(forKey: "codex.quota.schedule." + key) }
+    }
+
+    static func parseResetCredits(_ data: Data) throws -> (available: Int?, expiry: Date?) {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any] else { throw URLError(.cannotParseResponse) }
+        let explicit = (root["available_count"] as? NSNumber).flatMap { number -> Int? in
+            let value = number.doubleValue
+            guard String(cString: number.objCType) != "c", value.isFinite, value >= 0,
+                  value <= Double(Int32.max), value.rounded(.towardZero) == value else { return nil }
+            return Int(value)
+        }
+        guard let credits = root["credits"] as? [Any] else { return (explicit, nil) }
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let plain = ISO8601DateFormatter()
+        var count = 0
+        var complete = true
+        var expiry: Date?
+        for value in credits {
+            let credit = value as? [String: Any]
+            switch credit?["status"] as? String {
+            case "available":
+                count += 1
+                if let text = credit?["expires_at"] as? String,
+                   let date = fractional.date(from: text) ?? plain.date(from: text) {
+                    expiry = expiry.map { min($0, date) } ?? date
+                }
+            case "used", "consumed", "expired": break
+            default: complete = false
+            }
+        }
+        return (explicit ?? (complete ? count : nil), expiry)
+    }
+
+    private static func digest(_ value: String) -> String {
+        SHA256.hash(data: Data(value.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func request(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {
+        let session = URLSession(configuration: .ephemeral, delegate: QuotaRedirectDelegate(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let (data, response) = try await session.data(for: request)
+        guard let response = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        return (data, response)
+    }
+
+    static func retryAfter(_ value: String?, now: Date) -> TimeInterval {
+        guard let value else { return 60 }
+        if let seconds = Double(value.trimmingCharacters(in: .whitespaces)), seconds.isFinite { return max(60, seconds) }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(secondsFromGMT: 0)
+        formatter.dateFormat = "EEE',' dd MMM yyyy HH':'mm':'ss zzz"
+        return max(60, formatter.date(from: value)?.timeIntervalSince(now) ?? 60)
+    }
+
+    static func parse(_ data: Data, at time: Date) throws -> QuotaSnapshot {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any] else { throw URLError(.cannotParseResponse) }
+        var windows: [QuotaWindow] = []
+        func add(_ limits: [String: Any]?, prefix: String, label: String) {
+            guard let limits else { return }
+            let known = ["primary_window", "secondary_window"]
+            let keys = known + limits.keys.filter { $0.hasSuffix("_window") && !known.contains($0) }.sorted()
+            for windowKey in keys {
+                let slot = String(windowKey.dropLast("_window".count))
+                guard let window = limits[windowKey] as? [String: Any] else { continue }
+                let duration = (window["limit_window_seconds"] as? NSNumber)?.doubleValue
+                let validDuration = duration.flatMap { $0.isFinite && $0 >= 0 ? $0 : nil }
+                let percent = (window["used_percent"] as? NSNumber)?.doubleValue
+                let fraction = percent.flatMap { $0.isFinite ? $0 / 100 : nil }
+                let absolute = (window["reset_at"] as? NSNumber)?.doubleValue
+                let relative = (window["reset_after_seconds"] as? NSNumber)?.doubleValue
+                let reset = absolute.flatMap { $0.isFinite && $0 >= 0 ? Date(timeIntervalSince1970: $0) : nil }
+                    ?? relative.flatMap { $0.isFinite && $0 >= 0 ? time.addingTimeInterval($0) : nil }
+                let identity = validDuration.map { String($0) } ?? "unknown:\(slot)"
+                let baseID = "\(prefix):\(identity)"
+                var id = baseID
+                var collision = 0
+                while windows.contains(where: { $0.id == id }) {
+                    collision += 1
+                    id = "\(baseID):\(slot):\(collision)"
+                }
+                windows.append(QuotaWindow(id: id, label: label, usedFraction: fraction,
+                                               remaining: fraction.map { 1 - $0 }, used: fraction, resetAt: reset, duration: validDuration))
+            }
+        }
+        add(root["rate_limit"] as? [String: Any], prefix: "main", label: "")
+        if let extras = root["additional_rate_limits"] as? [Any] {
+            for (index, value) in extras.enumerated() {
+                guard let extra = value as? [String: Any] else { continue }
+                let name = (extra["limit_name"] as? String) ?? (extra["metered_feature"] as? String) ?? "Extra \(index + 1)"
+                let identity = (extra["metered_feature"] as? String) ?? name
+                add(extra["rate_limit"] as? [String: Any], prefix: "extra:\(identity)", label: name)
+            }
+        }
+        add(root["code_review_rate_limit"] as? [String: Any], prefix: "code_review", label: "Code review")
+        let rawCredits = root["credits"] as? [String: Any]
+        let balance: String? = (rawCredits?["balance"] as? String) ?? (rawCredits?["balance"] as? NSNumber)?.stringValue
+        func number(_ value: Any?) -> Double? {
+            if let number = value as? NSNumber { return number.doubleValue }
+            if let text = value as? String { return Double(text) }
+            return nil
+        }
+        let spend = (root["spend_control"] as? [String: Any])?["individual_limit"] as? [String: Any]
+        let creditPercent = number(spend?["used_percent"])
+        let creditReset = number(spend?["reset_at"])
+        let credits = (rawCredits != nil || spend != nil) ? QuotaCredits(
+            hasCredits: rawCredits?["has_credits"] as? Bool, unlimited: rawCredits?["unlimited"] as? Bool,
+            limit: number(spend?["limit"]), used: number(spend?["used"]),
+            usedFraction: creditPercent.map { $0 / 100 },
+            resetAt: creditReset.map { Date(timeIntervalSince1970: $0) }, balance: balance) : nil
+        return QuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: .ok,
+                                  windows: windows, headlineId: windows.first(where: { $0.id.hasPrefix("main:") })?.id, block: nil, account: nil,
+                                  plan: root["plan_type"] as? String, observedAt: time, source: "wham/usage",
+                                  credits: credits, nextAllowedAt: nil, waitingForRefresh: false)
+    }
+
+    private func staleOrError(_ accountKey: String, next: Date?) -> QuotaSnapshot {
+        guard let value = cached[accountKey], value.observedAt != nil else {
+            return snapshot(status: .error, next: next)
+        }
+        return withStatus(value, status: .stale, next: next)
+    }
+
+    private func snapshot(status: QuotaStatus, next: Date? = nil, waiting: Bool = false) -> QuotaSnapshot {
+        QuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: status,
+                           windows: [], headlineId: nil, block: nil, account: nil, plan: nil, observedAt: nil,
+                           source: "wham/usage", credits: nil, nextAllowedAt: next, waitingForRefresh: waiting)
+    }
+
+    private func withStatus(_ value: QuotaSnapshot, status: QuotaStatus, next: Date?) -> QuotaSnapshot {
+        value.copying(status: status, next: next)
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/Quota.swift b/macos/Sources/AgentSpeedCore/Quota.swift
new file mode 100644
index 00000000..68383153
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/Quota.swift
@@ -0,0 +1,138 @@
+import Foundation
+
+public enum QuotaStatus: String, Sendable, Codable {
+    case ok, stale, needsAuth, accessDenied, unsupported, error
+}
+
+public struct QuotaWindow: Sendable, Equatable, Codable {
+    public let id: String
+    public let label: String
+    public let usedFraction: Double?
+    public let remaining: Double?
+    public let used: Double?
+    public let resetAt: Date?
+    public let duration: TimeInterval?
+
+    public init(id: String, label: String, usedFraction: Double?, remaining: Double?, used: Double?,
+                resetAt: Date?, duration: TimeInterval?) {
+        self.id = id
+        self.label = label
+        self.usedFraction = usedFraction
+        self.remaining = remaining
+        self.used = used
+        self.resetAt = resetAt
+        self.duration = duration
+    }
+}
+
+public struct QuotaCredits: Sendable, Equatable, Codable {
+    public let hasCredits: Bool?
+    public let unlimited: Bool?
+    public let limit: Double?
+    public let used: Double?
+    public let usedFraction: Double?
+    public let resetAt: Date?
+    public let balance: String?
+}
+
+public struct QuotaSnapshot: Sendable, Equatable, Codable {
+    public let id: String
+    public let displayName: String
+    public let fidelity: String
+    public let status: QuotaStatus
+    public let windows: [QuotaWindow]
+    public let headlineId: String?
+    public let block: String?
+    public let account: String?
+    public let plan: String?
+    public let observedAt: Date?
+    public let source: String
+    public let credits: QuotaCredits?
+    public let nextAllowedAt: Date?
+    /// No observation is available because a previously successful poll is still throttled.
+    public let waitingForRefresh: Bool
+    public let resetCreditsAvailable: Int?
+    public let resetCreditsNextExpiry: Date?
+
+    public init(id: String, displayName: String, fidelity: String, status: QuotaStatus,
+                windows: [QuotaWindow], headlineId: String?, block: String?, account: String?,
+                plan: String?, observedAt: Date?, source: String, credits: QuotaCredits?,
+                nextAllowedAt: Date?, waitingForRefresh: Bool,
+                resetCreditsAvailable: Int? = nil, resetCreditsNextExpiry: Date? = nil) {
+        self.id = id
+        self.displayName = displayName
+        self.fidelity = fidelity
+        self.status = status
+        self.windows = windows
+        self.headlineId = headlineId
+        self.block = block
+        self.account = account
+        self.plan = plan
+        self.observedAt = observedAt
+        self.source = source
+        self.credits = credits
+        self.nextAllowedAt = nextAllowedAt
+        self.waitingForRefresh = waitingForRefresh
+        self.resetCreditsAvailable = resetCreditsAvailable
+        self.resetCreditsNextExpiry = resetCreditsNextExpiry
+    }
+}
+
+/// Providers own credentials, account isolation and persisted polling schedules.
+public protocol QuotaProvider: Sendable {
+    var id: String { get }
+    func readCachedSnapshot() async -> QuotaSnapshot
+    func refreshStartup() async -> QuotaSnapshot
+    func refresh() async -> QuotaSnapshot
+    func cancel() async
+}
+
+public enum QuotaPeriod: String, Sendable {
+    case month, week, fiveHours, other
+}
+
+extension QuotaWindow {
+    public var periodDuration: TimeInterval? {
+        if let duration, duration.isFinite, duration > 0 { return duration }
+        switch id.split(separator: ":").last?.lowercased() {
+        case "monthly", "month": return 30 * 86_400
+        case "weekly", "week": return 604_800
+        case "rolling", "session", "5h": return 18_000
+        default: return nil
+        }
+    }
+
+    public var period: QuotaPeriod {
+        guard let duration = periodDuration else { return .other }
+        if duration == 18_000 { return .fiveHours }
+        if duration == 604_800 { return .week }
+        if duration >= 2_419_200 && duration <= 2_678_400 { return .month }
+        return .other
+    }
+
+    /// Exact readings remain unclamped, including negative remaining after overuse.
+    public var remainingFraction: Double? {
+        if let usedFraction, usedFraction.isFinite { return 1 - usedFraction }
+        return nil
+    }
+
+    public static func ordered(_ windows: [QuotaWindow]) -> [QuotaWindow] {
+        windows.enumerated().sorted { lhs, rhs in
+            let a = lhs.element.periodDuration
+            let b = rhs.element.periodDuration
+            if a != b {
+                if let a, let b { return a > b }
+                return a != nil
+            }
+            if lhs.element.id != rhs.element.id { return lhs.element.id < rhs.element.id }
+            if lhs.element.label != rhs.element.label { return lhs.element.label < rhs.element.label }
+            return lhs.offset < rhs.offset
+        }.map(\.element)
+    }
+}
+
+public enum QuotaProviderRegistry {
+    public static func makeProviders() -> [any QuotaProvider] {
+        [CodexQuotaProvider()]
+    }
+}
