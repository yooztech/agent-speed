+/// The reference's separate SettingsOrb, not a gear inserted into the notch.
+/// At rest the arc is parallel to the *fluid* flare (not a quarter circle).
+/// DiscToArc's original curve rolls the disc back into that arc on departure.
+struct QuotaSettingsOrb: View {
+    let isHovered: Bool
+    let isTuckedAway: Bool
+    let edge: NotchEdge
+    let action: () -> Void
+    let label: String
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var release: CGFloat = 1
+    @State private var releasing = false
+    @State private var spins = 0
+
+    var body: some View {
+        Button {
+            spins += 1
+            action()
+        } label: {
+            ZStack {
+                QuotaOrbReturn(progress: releasing ? release : (isHovered ? 0 : 1), edge: edge)
+                    .opacity(isTuckedAway || (!isHovered && !releasing) ? 0 : 1)
+                QuotaOrbMerge(separation: isTuckedAway ? 0 : 1, edge: edge)
+                    .opacity(isHovered || releasing ? 0 : 1)
+                    .animation(reduceMotion ? nil : .easeIn(duration: 0.2), value: isTuckedAway)
+                Image(systemName: "gearshape.fill")
+                    .font(.system(size: NotchLayout.orbGlyph, weight: .regular))
+                    .foregroundStyle(.white).opacity(isHovered ? 1 : 0)
+                    .scaleEffect(isHovered ? 1 : 0.5)
+                    .rotationEffect(.degrees((isHovered ? 0 : -60) + Double(spins) * 360))
+                    .animation(reduceMotion ? nil : .spring(response: 0.55, dampingFraction: 0.72), value: spins)
+            }
+            .frame(width: 2 * NotchLayout.orbArcRadius + NotchLayout.orbStroke,
+                   height: 2 * NotchLayout.orbArcRadius + NotchLayout.orbStroke)
+            .contentShape(Circle().size(width: NotchLayout.orbDiameter, height: NotchLayout.orbDiameter)
+                .offset(x: NotchLayout.orbArcRadius + NotchLayout.orbStroke / 2 - NotchLayout.orbDiameter / 2,
+                        y: NotchLayout.orbArcRadius + NotchLayout.orbStroke / 2 - NotchLayout.orbDiameter / 2))
+        }
+        .buttonStyle(.plain).accessibilityLabel(label)
+        .onChange(of: isHovered) { _, hovered in
+            guard !reduceMotion else { return }
+            if hovered { releasing = false; return }
+            var still = Transaction(); still.disablesAnimations = true
+            withTransaction(still) { release = 0; releasing = true }
+            withAnimation(.timingCurve(0.3, 0, 0.2, 1, duration: 0.4).delay(0.1)) {
+                release = 1
+            } completion: {
+                if !isHovered { releasing = false }
+            }
+        }
+        .animation(reduceMotion ? nil : .spring(response: 0.36, dampingFraction: 0.7), value: isHovered)
+        .keyframeAnimator(initialValue: CGFloat(1), trigger: spins) { orb, scale in
+            orb.scaleEffect(scale)
+        } keyframes: { _ in
+            SpringKeyframe(reduceMotion ? 1 : 0.84, duration: 0.09, spring: .snappy)
+            SpringKeyframe(1, duration: 0.34, spring: .bouncy)
+        }
+    }
+}
+
+struct QuotaOrbReturn: View, Animatable {
+    var progress: CGFloat
+    let edge: NotchEdge
+    var animatableData: CGFloat {
+        get { progress }
+        set { progress = newValue }
+    }
+    private func step(_ x: CGFloat) -> CGFloat {
+        let t = min(max(x, 0), 1)
+        return t * t * (3 - 2 * t)
+    }
+    var body: some View {
+        Canvas { context, size in
+            let p = min(max(progress, 0), 1)
+            let center = CGPoint(x: size.width / 2, y: size.height / 2)
+            if p <= 0.001 {
+                context.fill(Path(ellipseIn: CGRect(x: center.x - NotchLayout.orbDiameter / 2,
+                                                    y: center.y - NotchLayout.orbDiameter / 2,
+                                                    width: NotchLayout.orbDiameter, height: NotchLayout.orbDiameter)), with: .color(.black))
+                return
+            }
+            if p >= 0.999 {
+                context.stroke(QuotaSettingsArc.path(center: center, edge: edge), with: .color(.black),
+                               style: StrokeStyle(lineWidth: NotchLayout.orbStroke, lineCap: .round, lineJoin: .round))
+                return
+            }
+            let middle = QuotaSettingsArc.point(0.5, center: center, edge: edge)
+            let onto = step(p / 0.55)
+            let shift = CGPoint(x: (center.x - middle.x) * (1 - onto), y: (center.y - middle.y) * (1 - onto))
+            let half = 0.5 * step((p - 0.08) / 0.82)
+            let width = NotchLayout.orbDiameter + (NotchLayout.orbStroke - NotchLayout.orbDiameter) * step(p / 0.8)
+            var line = Path()
+            for i in 0...64 {
+                let share = 0.5 - half + 2 * half * CGFloat(i) / 64
+                let q = QuotaSettingsArc.point(share, center: center, edge: edge)
+                let at = CGPoint(x: q.x + shift.x, y: q.y + shift.y)
+                if i == 0 { line.move(to: at) } else { line.addLine(to: at) }
+            }
+            context.stroke(line, with: .color(.black), style: StrokeStyle(lineWidth: width, lineCap: .round, lineJoin: .round))
+        }
+        .allowsHitTesting(false)
+    }
+}
+
+/// The returning branch of Codenotch's GooArc. The arc rolls up, grows a
+/// pinched neck onto the original fluid flare, then disappears inside the
+/// still-open notch. Folding starts only after this 200ms merge has finished.
+struct QuotaOrbMerge: View, Animatable {
+    var separation: CGFloat
+    let edge: NotchEdge
+    var animatableData: CGFloat {
+        get { separation }
+        set { separation = newValue }
+    }
+    private func step(_ x: CGFloat) -> CGFloat {
+        let t = min(max(x, 0), 1)
+        return t * t * (3 - 2 * t)
+    }
+    var body: some View {
+        let stroke = NotchLayout.orbStroke
+        let flare = NotchLayout.curlRadius
+        let side = 2 * (flare + 2 * stroke)
+        Canvas { context, size in
+            let t = min(max(separation, 0), 1)
+            let center = CGPoint(x: size.width / 2, y: size.height / 2)
+            let rest = NotchLayout.orbClearance
+            let buried = -(rest + stroke * 1.4)
+            let past = rest * 1.2 * sin(.pi * min(t / 0.85, 1)) * (t < 0.85 ? 1 : 0)
+            let slide = buried * (1 - t) + past
+            let trim = QuotaSettingsArc.trim(for: edge)
+            let a = CGPoint(x: cos(2 * .pi * trim.lowerBound), y: sin(2 * .pi * trim.lowerBound))
+            let b = CGPoint(x: cos(2 * .pi * trim.upperBound), y: sin(2 * .pi * trim.upperBound))
+            let away = CGPoint(x: -(a.x + b.x) / sqrt(2), y: -(a.y + b.y) / sqrt(2))
+            let whole = QuotaSettingsArc.path(center: center, edge: edge)
+                .offsetBy(dx: away.x * slide, dy: away.y * slide)
+            let unrolled = step((t - 0.6) / 0.35)
+            let half = max(0.004, unrolled / 2)
+            let arc = unrolled >= 0.999 ? whole : whole.trimmedPath(from: 0.5 - half, to: 0.5 + half)
+            let width = (stroke * 2.3 + (stroke - stroke * 2.3) * unrolled) * step(t / 0.35)
+            guard width >= 0.4 else { return }
+            let home = 1 + 0.8 * (1 - step((t - 0.04) / 0.32))
+            let goo = stroke * 0.45 * home * step((0.93 - t) / 0.15) * step(t / 0.05)
+            guard goo > 0.2 else {
+                context.stroke(arc, with: .color(.black), style: StrokeStyle(lineWidth: width, lineCap: .round))
+                return
+            }
+            context.addFilter(.alphaThreshold(min: 0.5, color: .black))
+            context.addFilter(.blur(radius: goo))
+            context.drawLayer { layer in
+                layer.stroke(arc, with: .color(.black), style: StrokeStyle(lineWidth: width + goo * 0.4, lineCap: .round))
+                let neck = stroke * 1.1 * step((0.94 - t) / 0.1)
+                if neck > stroke * 0.18 {
+                    let from = QuotaSettingsArc.point(0.5, center: center, edge: edge, offset: -stroke)
+                    let drop = QuotaSettingsArc.point(0.5, center: center, edge: edge, offset: rest + slide)
+                    let reach = step((0.92 - t) / 0.32)
+                    let to = CGPoint(x: from.x + (drop.x - from.x) * reach, y: from.y + (drop.y - from.y) * reach)
+                    let dx = to.x - from.x, dy = to.y - from.y
+                    let length = max(hypot(dx, dy), 0.001)
+                    let px = -dy / length, py = dx / length
+                    func sidePoint(_ at: CGPoint, _ half: CGFloat, _ sign: CGFloat) -> CGPoint {
+                        CGPoint(x: at.x + px * half * sign, y: at.y + py * half * sign)
+                    }
+                    let middle = CGPoint(x: from.x + dx * 0.5, y: from.y + dy * 0.5)
+                    let base = stroke * 2.6 / 2, pinch = neck / 2, top = stroke * 1.4 / 2
+                    var strand = Path()
+                    strand.move(to: sidePoint(from, base, 1))
+                    strand.addQuadCurve(to: sidePoint(to, top, 1), control: sidePoint(middle, pinch, 1))
+                    strand.addLine(to: sidePoint(to, top, -1))
+                    strand.addQuadCurve(to: sidePoint(from, base, -1), control: sidePoint(middle, pinch, -1))
+                    strand.closeSubpath()
+                    layer.fill(strand, with: .color(.black))
+                }
+                let band = stroke + goo * 1.6
+                let body = QuotaSettingsArc.path(center: center, edge: edge, offset: -band / 2)
+                layer.stroke(body, with: .color(.black), style: StrokeStyle(lineWidth: band, lineCap: .round))
+            }
+        }
+        .frame(width: side, height: side)
+        .frame(width: 2 * NotchLayout.orbArcRadius + stroke, height: 2 * NotchLayout.orbArcRadius + stroke)
+        .allowsHitTesting(false)
+    }
+}
diff --git a/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift b/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift
new file mode 100644
index 00000000..17cf0edc
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift
@@ -0,0 +1,94 @@
+import SwiftUI
+
+// Adapted from Codenotch at 835550a342871779135b6484d6899161c5222f7c,
+// Copyright (c) 2026 Vinz, MIT. See Resources/Codenotch-LICENSE.txt.
+// Only the freestanding edge notch is needed here; hardware-hole joins and
+// provider-specific drag machinery are deliberately not part of this port.
+struct SideNotchShape: Shape {
+    var edge: NotchEdge = .right
+    var curlRadius: CGFloat = NotchLayout.curlRadius
+    var cornerRadius: CGFloat = NotchLayout.cornerRadius
+
+    var animatableData: AnimatablePair<CGFloat, CGFloat> {
+        get { AnimatablePair(curlRadius, cornerRadius) }
+        set { curlRadius = newValue.first; cornerRadius = newValue.second }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        let depth = edge.isVertical ? rect.width : rect.height
+        let length = edge.isVertical ? rect.height : rect.width
+        // The corner claims half the depth first. Reversing this order makes
+        // the folded tab square, because its flare would consume all its depth.
+        let wanted = max(0, min(cornerRadius, depth / 2))
+        let curl = max(0, min(curlRadius, depth - wanted))
+        let corner = max(0, min(wanted, (length - 2 * curl) / 2))
+        var path = Path()
+        path.move(to: CGPoint(x: depth, y: 0))
+        fluidTurn(&path, to: CGPoint(x: depth - curl, y: curl),
+                  leaving: CGVector(dx: 0, dy: 1), arriving: CGVector(dx: -1, dy: 0))
+        path.addLine(to: CGPoint(x: corner, y: curl))
+        turn(&path, to: CGPoint(x: 0, y: curl + corner),
+             leaving: CGVector(dx: -1, dy: 0), arriving: CGVector(dx: 0, dy: 1))
+        path.addLine(to: CGPoint(x: 0, y: length - curl - corner))
+        turn(&path, to: CGPoint(x: corner, y: length - curl),
+             leaving: CGVector(dx: 0, dy: 1), arriving: CGVector(dx: 1, dy: 0))
+        path.addLine(to: CGPoint(x: depth - curl, y: length - curl))
+        fluidTurn(&path, to: CGPoint(x: depth, y: length),
+                  leaving: CGVector(dx: 1, dy: 0), arriving: CGVector(dx: 0, dy: 1))
+        path.closeSubpath()
+        return path.applying(Self.transform(for: edge, depth: depth))
+            .applying(CGAffineTransform(translationX: rect.minX, y: rect.minY))
+    }
+
+    static func transform(for edge: NotchEdge, depth: CGFloat) -> CGAffineTransform {
+        switch edge {
+        case .right: .identity
+        case .left: CGAffineTransform(a: -1, b: 0, c: 0, d: 1, tx: depth, ty: 0)
+        case .top: CGAffineTransform(a: 0, b: -1, c: 1, d: 0, tx: 0, ty: depth)
+        case .bottom: CGAffineTransform(a: 0, b: 1, c: 1, d: 0, tx: 0, ty: 0)
+        }
+    }
+
+    private func turn(_ path: inout Path, to: CGPoint, leaving: CGVector, arriving: CGVector) {
+        guard let from = path.currentPoint else { return }
+        let dx = to.x - from.x, dy = to.y - from.y
+        let out = abs(dx * leaving.dx + dy * leaving.dy) * 0.5523
+        let into = abs(dx * arriving.dx + dy * arriving.dy) * 0.5523
+        path.addCurve(to: to,
+                      control1: CGPoint(x: from.x + leaving.dx * out, y: from.y + leaving.dy * out),
+                      control2: CGPoint(x: to.x - arriving.dx * into, y: to.y - arriving.dy * into))
+    }
+
+    private func fluidTurn(_ path: inout Path, to: CGPoint, leaving: CGVector, arriving: CGVector) {
+        guard let from = path.currentPoint else { return }
+        let along = (to.x - from.x) * leaving.dx + (to.y - from.y) * leaving.dy
+        let across = (to.x - from.x) * arriving.dx + (to.y - from.y) * arriving.dy
+        for step in QuotaFlareWalk.steps.dropFirst() {
+            path.addLine(to: CGPoint(x: from.x + leaving.dx * step.u * along + arriving.dx * step.v * across,
+                                     y: from.y + leaving.dy * step.u * along + arriving.dy * step.v * across))
+        }
+    }
+}
+
+/// Codenotch's 96-step, curvature-ramped quarter turn, shared by the body and
+/// the parallel settings arc. Computed once, not allocated on every draw.
+enum QuotaFlareWalk {
+    static let steps: [(u: CGFloat, v: CGFloat, heading: CGFloat)] = {
+        let p: CGFloat = 0.5, count = 96
+        let bend = (CGFloat.pi / 2) / (1 - p)
+        var heading: CGFloat = 0, u: CGFloat = 0, v: CGFloat = 0
+        var walk: [(u: CGFloat, v: CGFloat, heading: CGFloat)] = [(0, 0, 0)]
+        walk.reserveCapacity(count + 1)
+        for i in 0..<count {
+            let s = (CGFloat(i) + 0.5) / CGFloat(count)
+            let share = s < p ? s / p : (s > 1 - p ? (1 - s) / p : 1)
+            let before = heading
+            heading += bend * share / CGFloat(count)
+            u += cos(heading) / CGFloat(count)
+            v += sin(heading) / CGFloat(count)
+            walk.append((u, v, (before + heading) / 2))
+        }
+        let end = walk[walk.count - 1]
+        return walk.map { ($0.u / end.u, $0.v / end.v, $0.heading) }
+    }()
+}
