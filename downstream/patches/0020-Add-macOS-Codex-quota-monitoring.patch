+import AppKit
+import SwiftUI
+import Testing
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+@Suite("Native quota notch", .serialized)
+@MainActor
+struct QuotaNotchTests {
+    private let now = Date(timeIntervalSince1970: 1_800_000_000)
+
+    private func snapshot(_ id: String = "codex", status: QuotaStatus = .ok, used: Double? = 0.21) -> QuotaSnapshot {
+        let windows = [
+            QuotaWindow(id: "rolling", label: "", usedFraction: used, remaining: nil, used: nil, resetAt: now.addingTimeInterval(3_060), duration: 18_000),
+            QuotaWindow(id: "weekly", label: "", usedFraction: 0.52, remaining: nil, used: nil, resetAt: now.addingTimeInterval(100_000), duration: 604_800),
+            QuotaWindow(id: "monthly", label: "", usedFraction: 1.2, remaining: nil, used: nil, resetAt: nil, duration: nil),
+        ]
+        return QuotaSnapshot(id: id, displayName: id == "codex" ? "Codex" : "Test source", fidelity: "official", status: status,
+                             windows: windows, headlineId: "rolling", block: nil, account: "account", plan: "Plus",
+                             observedAt: now.addingTimeInterval(-300), source: "local", credits: nil, nextAllowedAt: nil, waitingForRefresh: false)
+    }
+    private func reading(_ snapshot: QuotaSnapshot? = nil, enabled: Bool = true) -> QuotaNotchReading {
+        QuotaNotchReading(snapshot: snapshot, networkEnabled: enabled, l10n: Localizer(preference: .en))
+    }
+    private func geometry(_ edge: NotchEdge, expanded: Bool = true, count: Int = 2) -> QuotaNotchGeometry {
+        QuotaNotchGeometry(edge: edge, expansion: expanded ? 1 : 0, count: count, cellSize: CGSize(width: 300, height: 108), ringSize: NotchLayout.outerDiameter(3))
+    }
+
+    @Test func everyProviderRetainsAllPeriodsWithoutFollowingHeadline() {
+        let accounts = [reading(snapshot()), reading(snapshot("test-source"))]
+        #expect(accounts.map(\.providerID) == ["codex", "test-source"])
+        for value in accounts {
+            #expect(value.windows.map(\.id) == ["monthly", "weekly", "rolling"])
+            #expect(value.readings.count == 3)
+            #expect(value.readings.first?.contains("-20%") == true)
+            #expect(value.readings.last?.contains("79%") == true)
+            #expect(value.outerDiameter == 88)
+        }
+        let unknown = reading(snapshot(used: nil))
+        #expect(unknown.readings.last?.contains("Unknown") == true)
+        #expect(reading().readings == ["—"])
+        #expect(reading(snapshot(status: .needsAuth)).readings.allSatisfy { $0.contains("Unknown") })
+    }
+
+    @Test func failedOrOfflineReadingsDoNotBecomeUpdatedAges() {
+        for status in [QuotaStatus.stale, .error, .needsAuth, .accessDenied, .unsupported] {
+            let value = reading(snapshot(status: status))
+            #expect(value.status(at: now) == quotaStatus(value.snapshot!, value.l10n))
+            #expect(reading(snapshot(status: status), enabled: false).status(at: now) == value.l10n("mac.quota.offline"))
+        }
+        #expect(reading(snapshot()).status(at: now) == "Updated 5m ago")
+        #expect(!reading(snapshot()).stale(at: now))
+        #expect(reading(snapshot()).stale(at: now.addingTimeInterval(601)))
+        #expect(reading(snapshot(), enabled: false).stale(at: now))
+    }
+
+    @Test func notchResetCopyUsesRoundedMinutesAndCalendarBoundary() throws {
+        let value = reading(snapshot())
+        #expect(value.resetText(now.addingTimeInterval(-1), now: now) == "Resetting…")
+        #expect(value.resetText(now.addingTimeInterval(42), now: now) == "Resets in 1 min")
+        #expect(value.resetText(now.addingTimeInterval(3_040), now: now) == "Resets in 51 min")
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = try #require(TimeZone(secondsFromGMT: 0))
+        let start = try #require(calendar.date(from: DateComponents(year: 2027, month: 1, day: 15, hour: 13, minute: 17)))
+        #expect(value.resetText(start.addingTimeInterval(3_599), now: start, calendar: calendar) == "Resets at 2:16 PM")
+        #expect(value.resetText(start.addingTimeInterval(7 * 86_400), now: start, calendar: calendar) == "Resets Jan 22")
+    }
+
+    @Test func allCellsAndUprightLabelsFitEveryEdge() {
+        let monitor = CGRect(x: -1_920, y: -1_080, width: 1_920, height: 1_080)
+        for edge in NotchEdge.allCases {
+            let shape = geometry(edge)
+            #expect(shape.centers.count == 2 && shape.cellRects.count == 2)
+            #expect(monitor.contains(shape.panelFrame(on: monitor, along: 0.5)))
+            for center in shape.centers { #expect(shape.bodyPath.contains(center)) }
+            #expect(shape.cellRects[0].width == 300)
+            #expect(shape.cellRects[0].height == 108)
+            #expect(!shape.cellRects[0].intersects(shape.cellRects[1]))
+            for along in [CGFloat(0), 0.5, 1] {
+                let frame = shape.panelFrame(on: monitor, along: along)
+                #expect(monitor.contains(frame))
+                switch edge {
+                case .left: #expect(frame.minX == monitor.minX)
+                case .right: #expect(frame.maxX == monitor.maxX)
+                case .top: #expect(frame.maxY == monitor.maxY)
+                case .bottom: #expect(frame.minY == monitor.minY)
+                }
+            }
+        }
+    }
+
+    @Test func collapsedTabDoesNotClaimTheExpandedEnvelope() {
+        for edge in NotchEdge.allCases {
+            let closed = geometry(edge, expanded: false)
+            let bounds = closed.bodyPath.boundingRect
+            #expect(abs((edge.isVertical ? bounds.width : bounds.height) - 10) < 0.001)
+            #expect(abs((edge.isVertical ? bounds.height : bounds.width) - 79) < 0.001)
+            #expect(closed.bodyPath.contains(CGPoint(x: bounds.midX, y: bounds.midY)))
+            #expect(!closed.bodyPath.contains(CGPoint(x: 1, y: 1)))
+            let grip = QuotaGripPaint(geometry: closed, frame: QuotaGripFrame(arc: 1), filter: QuotaGripFilter(), scale: 2)
+            #expect(grip.hit.isEmpty && grip.contours.isEmpty)
+        }
+    }
+
+    @Test func restingArcAcceptsPaintedPointsAndPassesThroughItsCenter() {
+        _ = NSApplication.shared
+        for edge in NotchEdge.allCases {
+            let shape = geometry(edge)
+            let grip = QuotaGripPaint(geometry: shape, frame: QuotaGripFrame(arc: 1), filter: QuotaGripFilter(), scale: 2)
+            let host = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
+            let bounds = CGRect(origin: .zero, size: shape.size)
+            let container = NSView(frame: bounds)
+            host.frame = bounds
+            host.input = shape.bodyPath.union(quotaStrokeOutline(shape.bodyPath, width: 1)).union(grip.hit)
+            container.addSubview(host)
+            let center = shape.orbCenter.applying(shape.transform)
+            #expect(!grip.hit.contains(center))
+            #expect(host.hitTest(host.convert(center, to: container)) == nil)
+            for step in 0...8 {
+                let angle = -.pi + CGFloat(step) * .pi / 16
+                let point = CGPoint(x: shape.orbCenter.x + NotchLayout.arcRadius * cos(angle), y: shape.orbCenter.y + NotchLayout.arcRadius * sin(angle)).applying(shape.transform)
+                #expect(grip.hit.contains(point))
+                #expect(grip.contours.contains { $0.contains(point) })
+                #expect(!shape.bodyPath.contains(point))
+                #expect(host.hitTest(host.convert(point, to: container)) != nil)
+            }
+        }
+    }
+
+    @Test func revealedControlHasSixIndependentPaintedDrops() {
+        for edge in NotchEdge.allCases {
+            let shape = geometry(edge)
+            let grip = QuotaGripPaint(geometry: shape, frame: QuotaGripFrame(reveal: 1, arc: 1), filter: QuotaGripFilter(), scale: 2)
+            for index in 0..<6 {
+                let point = CGPoint(x: shape.orbCenter.x + CGFloat(index % 3 - 1) * 12.5,
+                                    y: shape.orbCenter.y + 8 + CGFloat(index / 3 * 2 - 1) * 6.25).applying(shape.transform)
+                #expect(grip.hit.contains(point))
+                #expect(grip.contours.contains { $0.contains(point) })
+                #expect(!shape.bodyPath.contains(point))
+            }
+        }
+    }
+
+    @Test func gripMotionUsesApprovedDiscAndDropDelaysThenBecomesIdle() {
+        var motion = QuotaGripMotion()
+        motion.setTargets(expanded: true, reveal: false, hover: false, held: false, now: 0, reducedMotion: false)
+        motion.sample(0.3)
+        #expect(motion.frame.arc == 0 && motion.active)
+        motion.sample(1.3)
+        #expect(motion.frame.arc == 1 && !motion.active)
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: false, now: 2, reducedMotion: false)
+        motion.sample(2.22)
+        #expect(motion.frame.reveal == 0 && abs(motion.frame.disc - 1) < 0.001)
+        motion.sample(2.67)
+        #expect(motion.frame.reveal == 1 && motion.frame.disc == 0)
+        motion.sample(10)
+        #expect(!motion.active)
+        motion.setTargets(expanded: true, reveal: false, hover: false, held: false, now: 11, reducedMotion: false)
+        motion.sample(11.21)
+        #expect(motion.frame.reveal == 0)
+        motion.sample(20)
+        #expect(motion.frame.disc == 0 && motion.frame.arc == 1 && !motion.active)
+    }
+
+    @Test func pressRetainsPaintedPoseAndReducedMotionSettlesWithoutFrames() {
+        var motion = QuotaGripMotion()
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: false, now: 0, reducedMotion: true)
+        #expect(motion.frame.reveal == 1 && !motion.active)
+        let painted = motion.frame
+        motion.setTargets(expanded: true, reveal: true, hover: true, held: true, now: 0.01, reducedMotion: true)
+        #expect(motion.frame.reveal == painted.reveal && motion.frame.squeeze == 1 && !motion.active)
+        motion.setTargets(expanded: false, reveal: false, hover: false, held: false, now: 1, reducedMotion: true)
+        #expect(motion.frame.arc == 0 && motion.frame.reveal == 0 && !motion.active)
+    }
+
+    @Test func tooltipTraversalUsesOne250MillisecondGrace() async throws {
+        let hover = QuotaNotchHover()
+        #expect(!hover.keepExpanded && !hover.expanded)
+        hover.move(to: .cell("codex"))
+        hover.move(to: .outside)
+        try await Task.sleep(for: .milliseconds(150))
+        #expect(hover.activeSource == "codex" && hover.expanded)
+        hover.move(to: .tooltip)
+        try await Task.sleep(for: .milliseconds(300))
+        #expect(hover.activeSource == "codex" && hover.expanded)
+        hover.move(to: .outside)
+        try await Task.sleep(for: .milliseconds(300))
+        #expect(hover.activeSource == nil && !hover.expanded)
+        hover.reset()
+    }
+
+    @Test func sourceSwitchAndKeepExpandedNeverFreezeTheOldTooltip() async throws {
+        let hover = QuotaNotchHover()
+        hover.keepExpanded = true
+        hover.move(to: .cell("codex")); hover.move(to: .cell("test-source"))
+        #expect(hover.activeSource == "test-source")
+        hover.move(to: .outside)
+        try await Task.sleep(for: .milliseconds(300))
+        #expect(hover.expanded && hover.activeSource == nil)
+        hover.reset()
+        #expect(hover.expanded)
+        hover.keepExpanded = false
+        #expect(!hover.expanded)
+    }
+
+    @Test func hidingCancelsPendingInteractionAndCanReopen() async throws {
+        let hover = QuotaNotchHover()
+        hover.move(to: .cell("codex")); hover.move(to: .outside); hover.reset()
+        try await Task.sleep(for: .milliseconds(300))
+        #expect(!hover.expanded && hover.activeSource == nil && !hover.graceActive)
+        hover.move(to: .bar)
+        #expect(hover.expanded)
+        hover.reset()
+    }
+
+    @Test func nativeHostingRejectsTransparentTailCorners() {
+        _ = NSApplication.shared
+        let rect = CGRect(x: 0, y: 0, width: 28.2, height: 32.72)
+        let tail = QuotaTooltipTail(edge: .right).path(in: rect)
+        let host = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
+        let container = NSView(frame: rect)
+        host.frame = rect; host.input = tail; container.addSubview(host)
+        let hole = CGPoint(x: 27, y: 1), ink = CGPoint(x: 8, y: 16)
+        #expect(!tail.contains(hole) && tail.contains(ink))
+        #expect(host.hitTest(host.convert(hole, to: container)) == nil)
+        #expect(host.hitTest(host.convert(ink, to: container)) != nil)
+    }
+}
