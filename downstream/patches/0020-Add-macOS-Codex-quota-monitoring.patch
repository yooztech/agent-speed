+@MainActor
+final class QuotaNotchHostingView: NSHostingView<QuotaNotchView> {
+    var geometry: QuotaNotchGeometry?
+    override func hitTest(_ point: NSPoint) -> NSView? {
+        guard geometry?.hits(convert(point, from: superview)) == true else { return nil }
+        return super.hitTest(point)
+    }
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+}
