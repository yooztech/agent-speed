+    @Test func hostingViewRejectsTransparentCornersAndTailBoundingBox() {
+        let value = reading(snapshot())
+        let hover = QuotaNotchHover()
+        hover.move(to: .cell)
+        let geometry = QuotaNotchGeometry(edge: .right, expanded: true, tooltip: true, settingsHovered: false,
+                                         cardHeight: value.cardHeight)
+        let view = QuotaNotchView(reading: value, geometry: geometry,
+                                 onSettings: {}, onEdge: { _ in }, onHide: {})
+        let container = NSView(frame: CGRect(origin: .zero, size: geometry.size))
+        let host = QuotaNotchHostingView(rootView: view)
+        host.geometry = geometry
+        host.sizingOptions = []
+        host.frame = container.bounds
+        container.addSubview(host)
+        let cardCorner = CGPoint(x: geometry.cardRect.minX + 1, y: geometry.cardRect.minY + 1)
+        let tailCorner = CGPoint(x: geometry.tailRect.maxX - 1, y: geometry.tailRect.minY + 1)
+        for point in [CGPoint(x: 1, y: 1), cardCorner, tailCorner] {
+            #expect(!geometry.hits(point))
+            #expect(host.hitTest(host.convert(point, to: container)) == nil)
+        }
+        hover.reset()
+    }
+
+    /// Native SwiftUI/AppKit rendering, not an SVG/HTML approximation. Set the
+    /// output directory to retain every 2x PNG for reference-image comparison:
+    /// AGENT_SPEED_NOTCH_ARTIFACTS=/tmp/quota-notch-native swift test --package-path macos --filter QuotaNotchTests
+    @Test func nativeOffscreenRenderingPreservesShapeAlphaAndUsageInk() throws {
+        _ = NSApplication.shared
+        let destination = ProcessInfo.processInfo.environment["AGENT_SPEED_NOTCH_ARTIFACTS"].map {
+            URL(fileURLWithPath: $0, isDirectory: true)
+        }
+        if let destination { try FileManager.default.createDirectory(at: destination, withIntermediateDirectories: true) }
+        for edge in NotchEdge.allCases {
+            for state in ["folded", "expanded", "tooltip", "gear", "stale", "unknown", "offline", "tucked"] {
+                let value = reading(state == "unknown" ? nil : snapshot(0.21, status: state == "stale" ? .stale : .ok),
+                                    enabled: state != "offline")
+                let hover = QuotaNotchHover()
+                if state == "tooltip" || state == "stale" || state == "unknown" || state == "offline" { hover.move(to: .cell) }
+                else if state == "gear" { hover.move(to: .settings) }
+                else if state != "folded" { hover.move(to: .bar) }
+                let geometry = QuotaNotchGeometry(edge: edge, expanded: hover.expanded, tooltip: hover.tooltip,
+                                                 settingsHovered: hover.settingsHovered, cardHeight: value.cardHeight,
+                                                 handlesTuckedAway: state == "tucked")
+                let content = QuotaNotchView(reading: value, geometry: geometry,
+                                            onSettings: {}, onEdge: { _ in }, onHide: {})
+                    .environment(\.accessibilityReduceMotion, true)
+                    .environment(\.accessibilityReduceTransparency, false)
+                let renderer = ImageRenderer(content: content)
+                renderer.scale = 2
+                renderer.isOpaque = false
+                let image = try #require(renderer.cgImage, "Native rendering must produce an image, not skip to a fixture")
+                let bitmap = NSBitmapImageRep(cgImage: image)
+                #expect(image.width == Int((geometry.size.width * 2).rounded(.up)))
+                #expect(image.height == Int((geometry.size.height * 2).rounded(.up)))
+                let corner = try #require(bitmap.colorAt(x: 1, y: 1)?.usingColorSpace(.sRGB))
+                #expect(corner.alphaComponent < 0.01)
+                let bodyCenter = try #require(bitmap.colorAt(x: Int(geometry.bodyRect.midX * 2),
+                                                              y: Int(geometry.bodyRect.midY * 2)))
+                #expect(bodyCenter.alphaComponent > 0.99)
+                if geometry.tooltip {
+                    let tailInk = try #require(bitmap.colorAt(x: Int(geometry.tailRect.midX * 2),
+                                                               y: Int(geometry.tailRect.midY * 2)))
+                    let tailHole = try #require(bitmap.colorAt(x: Int((geometry.tailRect.maxX - 1) * 2),
+                                                                y: Int((geometry.tailRect.minY + 1) * 2)))
+                    #expect(tailInk.alphaComponent > 0.99)
+                    #expect(tailHole.alphaComponent < 0.01)
+                }
+                if geometry.expanded {
+                    let centerInk = try #require(bitmap.colorAt(x: Int(geometry.orbCenter.x * 2),
+                                                                 y: Int(geometry.orbCenter.y * 2)))
+                    if geometry.settingsHovered {
+                        #expect(centerInk.alphaComponent > 0.99)
+                    } else {
+                        #expect(centerInk.alphaComponent < 0.01)
+                        let arc = QuotaSettingsArc.point(0.5, center: geometry.orbCenter, edge: edge)
+                        let arcInk = try #require(bitmap.colorAt(x: Int(arc.x * 2), y: Int(arc.y * 2)))
+                        #expect(geometry.handlesTuckedAway ? arcInk.alphaComponent < 0.01 : arcInk.alphaComponent > 0.99)
+                    }
+                }
+                if state != "folded" {
+                    let radius = (NotchLayout.ringDiameter - NotchLayout.trackStroke) / 2
+                    let x = Int((geometry.ringCenter.x + sin(0.3) * radius) * 2)
+                    let y = Int((geometry.ringCenter.y - cos(0.3) * radius) * 2)
+                    let ink = try #require(bitmap.colorAt(x: x, y: y)?.usingColorSpace(.sRGB))
+                    #expect(ink.alphaComponent > 0.99)
+                    if state == "unknown" {
+                        #expect(abs(ink.redComponent - ink.greenComponent) < 0.03)
+                    } else if state == "stale" || state == "offline" {
+                        #expect(ink.greenComponent > 0.35 && ink.greenComponent < 0.55)
+                    } else {
+                        #expect(ink.greenComponent > 0.9)
+                        #expect(ink.redComponent < 0.1)
+                    }
+                }
+                if let destination {
+                    let png = try #require(bitmap.representation(using: .png, properties: [:]))
+                    try png.write(to: destination.appendingPathComponent("native-notch-\(edge.rawValue)-\(state)@2x.png"))
+                }
+                hover.reset()
+            }
+        }
+        if let destination { print("Native notch PNGs: \(destination.path) — \(ProcessInfo.processInfo.operatingSystemVersionString)") }
+    }
+}
