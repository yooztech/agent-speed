+                            .stroke(color, style: StrokeStyle(lineWidth: 5, lineCap: .round)).rotationEffect(.degrees(-90))
+                            .frame(width: diameter, height: diameter)
+                    }
+                }
+                QuotaSourceLogo(providerID: reading.providerID, ink: dark ? .white : Color(white: 0.12)).frame(width: 26, height: 26)
+                if reading.windows.contains(where: { ($0.usedFraction ?? 0) >= 0.9 }) {
+                    Circle().fill(Color(red: 229 / 255, green: 104 / 255, blue: 104 / 255)).frame(width: 5, height: 5).offset(x: 15, y: 15)
+                }
+            }.frame(width: reading.outerDiameter, height: reading.outerDiameter)
