+        #expect(fiveHours.contains("5"))
+        #expect(!fiveHours.contains("18000"))
+        #expect(weekly == english("mac.quota.weekly"))
+        #expect(!weekly.contains("604800"))
+        #expect(quotaWindowLabel(window(nil, duration: nil, label: "Spark"), english) == "Spark · Window")
+        #expect(quotaWindowLabel(window(nil, duration: 18_000, label: "Spark"), english).hasPrefix("Spark · "))
+    }
+
+    @Test func compactAndDetailFiveHourLabelsAcrossLanguages() {
+        for (language, detail) in [(LanguagePreference.zhHans, "5小时额度"), (.zhHant, "5小時額度"), (.en, "5h limit"), (.ja, "5時間の上限")] {
+            let l10n = Localizer(preference: language)
+            let ordinary = window(0.5, label: "Codex")
+            #expect(quotaCompactWindowLabel(ordinary, l10n, providerName: "Codex") == "5h")
+            #expect(quotaWindowLabel(ordinary, l10n, providerName: "Codex") == detail)
+            #expect(quotaCompactWindowLabel(window(0.5, label: "Code review"), l10n, providerName: "Codex").contains("Code review"))
+            #expect(quotaCompactWindowLabel(window(0.5, duration: 36_000), l10n, providerName: nil).contains("10"))
+        }
+    }
+
+    @Test func statusAndUnknownReadingsRemainDistinct() {
+        let english = Localizer(preference: .en)
+        #expect(quotaStatus(account("signed-out", status: .needsAuth), english) == english("mac.quota.status.needsAuth", "signed-out"))
+        #expect(quotaStatus(account("stale", status: .stale, windows: [window(0.2)]), english) == english("mac.quota.status.stale"))
+        #expect(window(nil).usedFraction == nil)
+        #expect(quotaPercent(0, locale: english.locale) != english("mac.quota.unknown"))
+        #expect(quotaPercent(-0.25, locale: english.locale) == "-25%")
+        #expect(quotaPercent(0.6267, locale: english.locale) == "62.67%")
+    }
+
+    @Test func usageIndicatorKeepsKnownFractionsAndMarksUnknownIndeterminate() {
+        #expect(quotaUsageIndicatorState(window(0.25)) == .known(0.75))
+        #expect(quotaUsageIndicatorState(window(1.25)) == .known(0))
+        #expect(quotaUsageIndicatorState(window(nil)) == .indeterminate)
+        #expect(quotaUsageIndicatorState(window(.nan)) == .indeterminate)
+    }
+
+    @Test func floatingVisibilitySurvivesControllerRecreation() throws {
+        let suite = "QuotaPresentationTests.visibility.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let first = QuotaController(defaults: defaults)
+        #expect(first.floatingVisible)
+        first.floatingVisible = false
+        let restored = QuotaController(defaults: defaults)
+        #expect(!restored.floatingVisible)
+        restored.floatingVisible = true
+        #expect(QuotaController(defaults: defaults).floatingVisible)
+    }
+
+    @Test func resetTimeUsesAbsoluteObservationAndLocalCountdown() {
+        let l10n = Localizer(preference: .en)
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        let at = now.addingTimeInterval(90_060)
+        #expect(quotaResetTime(at, l10n, now: now) == l10n("mac.quota.resetWithCountdown", quotaDate(at, locale: l10n.locale), l10n("mac.quota.resetIn", "1d 1h 1m")))
+        #expect(quotaResetTime(now, l10n, now: now).contains(l10n("mac.quota.resetPendingRefresh")))
+        #expect(quotaResetTime(now.addingTimeInterval(59), l10n, now: now).contains(l10n("mac.quota.resetUnderMinute")))
+        #expect(quotaResetTime(now.addingTimeInterval(60), l10n, now: now).contains("In 1m"))
+        #expect(quotaResetTime(at, l10n, now: now.addingTimeInterval(60)).contains(quotaDate(at, locale: l10n.locale)))
+    }
+
+    @Test func displayClockUsesObservationBoundariesAndStopsWhenHiddenOrOffline() {
+        let observed = Date(timeIntervalSince1970: 1_800_000_000)
+        let now = observed.addingTimeInterval(58.75)
+        #expect(abs(QuotaDisplayClock.delay(observedAt: observed, now: now) - 1.25) < 0.0001)
+        #expect(QuotaDisplayClock.delay(observedAt: observed, now: observed.addingTimeInterval(60)) == 60)
+        #expect(QuotaDisplayClock.delay(observedAt: observed.addingTimeInterval(100), now: observed) == 60)
+        #expect(quotaObservationDelay([observed, observed.addingTimeInterval(-1)], now: now) == 0.25)
+        let clock = QuotaDisplayClock()
+        clock.start(observedAt: observed)
+        #expect(clock.isActive)
+        // Settings and dashboard pass enabled: false synchronously when consent is revoked.
+        clock.start(observedAt: observed, enabled: false)
+        #expect(!clock.isActive)
+        clock.start(observedAt: observed)
+        #expect(clock.isActive)
+        clock.stop()
+        #expect(!clock.isActive)
+    }
+
+    @Test func transportStatesNeverBecomeSuccessfulUpdatedAges() {
+        let l10n = Localizer(preference: .en)
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        func snapshot(_ status: QuotaStatus, waiting: Bool = false) -> QuotaSnapshot {
+            QuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: status, windows: [], headlineId: nil,
+                          block: nil, account: nil, plan: nil, observedAt: now.addingTimeInterval(-70), source: "local", credits: nil,
+                          nextAllowedAt: nil, waitingForRefresh: waiting)
+        }
+        #expect(quotaDisplayStatus(snapshot(.ok), l10n, networkEnabled: true, now: now) == l10n("mac.quota.minutesAgo", "1"))
+        #expect(quotaDisplayStatus(snapshot(.ok, waiting: true), l10n, networkEnabled: true, now: now) == l10n("mac.quota.status.waiting"))
+        for status in [QuotaStatus.stale, .needsAuth, .error, .accessDenied, .unsupported] {
+            #expect(quotaDisplayStatus(snapshot(status), l10n, networkEnabled: true, now: now) == quotaStatus(snapshot(status), l10n))
+            #expect(quotaDisplayStatus(snapshot(status), l10n, networkEnabled: false, now: now) == l10n("mac.quota.offline"))
+        }
+    }
+
+    @Test func resetCardExpiryStaysVisibleWithoutCountButNotForZeroCards() {
+        let l10n = Localizer(preference: .en)
+        let expiry = Date(timeIntervalSince1970: 1_800_000_000)
+        func snapshot(_ count: Int?) -> QuotaSnapshot {
+            QuotaSnapshot(id: "codex", displayName: "Codex", fidelity: "official", status: .ok, windows: [], headlineId: nil,
+                          block: nil, account: nil, plan: nil, observedAt: nil, source: "local", credits: nil, nextAllowedAt: nil,
+                          waitingForRefresh: false, resetCreditsAvailable: count, resetCreditsNextExpiry: expiry)
