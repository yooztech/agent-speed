+/// Windows GaussianBlur → clamp(18 * alpha - 8.5) → square erosion.
+/// Float convolution and ties-to-even byte conversion match the portable reference.
+/// Buffers grow only when necessary; no per-pixel allocation or binary re-thresholding.
+final class QuotaGripAlphaFilter {
+    private(set) var outer: [UInt8] = []
+    private(set) var inner: [UInt8] = []
+    private var working: [Float] = [], horizontal: [Float] = [], kernel: [Float] = []
+    private var minimum: [UInt8] = []
+
+    static func threshold(_ value: Float) -> UInt8 {
+        UInt8(min(max(18 * value - 8.5 * 255, 0), 255).rounded(.toNearestOrEven))
+    }
+
+    /// Premultiplied BGRA, exactly the Windows QuotaNotchGoo composition contract.
+    static func composite(outer: UInt8, inner: UInt8, rim: SIMD3<UInt8>, fill: SIMD3<UInt8>) -> SIMD4<UInt8> {
+        let outside = Double(outer) / 255, inside = Double(inner) / 255
+        let under = outside * (1 - inside)
+        func byte(_ value: Double) -> UInt8 { UInt8(min(max(value.rounded(.toNearestOrEven), 0), 255)) }
+        return SIMD4(byte(Double(fill.z) * inside + Double(rim.z) * under),
+                     byte(Double(fill.y) * inside + Double(rim.y) * under),
+                     byte(Double(fill.x) * inside + Double(rim.x) * under),
+                     byte((inside + under) * 255))
+    }
+
+    func apply(width: Int, height: Int, sigma: Double, scale: Double, source: [UInt8]) {
+        let count = width * height, deviation = sigma * scale
+        let radius = Int(ceil(3 * deviation)), erosion = Int(ceil(scale))
+        if outer.count < count {
+            outer = [UInt8](repeating: 0, count: count)
+            inner = [UInt8](repeating: 0, count: count); minimum = [UInt8](repeating: 0, count: count)
+            working = [Float](repeating: 0, count: count); horizontal = [Float](repeating: 0, count: count)
+        }
+        if radius == 0 {
+            for index in 0..<count { outer[index] = Self.threshold(Float(source[index])) }
+        } else {
+            let kernelSize = 2 * radius + 1
+            if kernel.count < kernelSize { kernel = [Float](repeating: 0, count: kernelSize) }
+            var total: Double = 0
+            for offset in -radius...radius {
+                let value = exp(-0.5 * Double(offset * offset) / (deviation * deviation))
+                kernel[offset + radius] = Float(value); total += value
+            }
+            for index in 0..<kernelSize { kernel[index] = Float(Double(kernel[index]) / total) }
+            for index in 0..<count { working[index] = Float(source[index]) }
+            for y in 0..<height {
+                let row = y * width
+                for x in 0..<width {
+                    var sum: Float = 0
+                    for offset in max(-radius, -x)...min(radius, width - 1 - x) {
+                        let product = working[row + x + offset] * kernel[offset + radius]
+                        sum += product
+                    }
+                    horizontal[row + x] = sum
+                }
+            }
+            for y in 0..<height {
+                for x in 0..<width {
+                    var sum: Float = 0
+                    for offset in max(-radius, -y)...min(radius, height - 1 - y) {
+                        let product = horizontal[(y + offset) * width + x] * kernel[offset + radius]
+                        sum += product
+                    }
+                    outer[y * width + x] = Self.threshold(sum)
+                }
+            }
+        }
+        if erosion >= width - erosion || erosion >= height - erosion {
+            for index in 0..<count { inner[index] = 0 }
+            return
+        }
+        for y in 0..<height {
+            for x in 0..<width {
+                var value: UInt8 = 0
+                if x >= erosion && x < width - erosion {
+                    value = 255
+                    for offset in -erosion...erosion { value = min(value, outer[y * width + x + offset]) }
+                }
+                minimum[y * width + x] = value
+            }
+        }
+        for y in 0..<height {
+            for x in 0..<width {
+                var value: UInt8 = 0
+                if x >= erosion && x < width - erosion && y >= erosion && y < height - erosion {
+                    value = 255
+                    for offset in -erosion...erosion { value = min(value, minimum[(y + offset) * width + x]) }
+                }
+                inner[y * width + x] = value
+            }
+        }
+    }
+}
