+            cell
+                .opacity(geometry.expanded ? 1 : 0)
+                .accessibilityHidden(!geometry.expanded)
+                .animation(reduceMotion ? nil : .spring(response: 0.48, dampingFraction: 0.8), value: geometry.expanded)
+                .allowsHitTesting(false)
+            if geometry.expanded {
+                QuotaSettingsOrb(isHovered: geometry.settingsHovered, isTuckedAway: geometry.handlesTuckedAway,
+                                 edge: geometry.edge, action: onSettings, label: reading.l10n("mac.quota.title"))
+                    .position(geometry.orbCenter)
+            }
+            if geometry.tooltip {
+                geometry.tooltipPath.fill(.black).allowsHitTesting(false)
+                TimelineView(.periodic(from: .now, by: 1)) { clock in
+                    ScrollView(.vertical) {
+                        QuotaNotchTooltipContent(reading: reading, now: clock.date)
+                            .padding(NotchLayout.cardPadding)
+                            .frame(width: NotchLayout.cardWidth, alignment: .topLeading)
+                    }
+                }
+                .scrollIndicators(.never)
+                .frame(width: geometry.cardRect.width, height: geometry.cardRect.height)
+                .clipShape(RoundedRectangle(cornerRadius: NotchLayout.cardCorner, style: .circular))
+                .overlay {
+                    if reduceTransparency {
+                        RoundedRectangle(cornerRadius: NotchLayout.cardCorner, style: .circular)
+                            .strokeBorder(NotchLayout.ringTrack, lineWidth: 1)
+                    }
+                }
+                .position(x: geometry.cardRect.midX, y: geometry.cardRect.midY)
+                .transition(.opacity)
+            }
+        }
+        .frame(width: geometry.size.width, height: geometry.size.height)
+        .foregroundStyle(.white)
+        .environment(\.colorScheme, .dark)
+        .animation(reduceMotion ? nil : .spring(response: 0.62, dampingFraction: 0.72), value: geometry.expanded)
+        .animation(reduceMotion ? nil : .easeInOut(duration: 0.16), value: geometry.tooltip)
+    }
+
+    private var cell: some View {
+        VStack(spacing: NotchLayout.ringLabelGap) {
+            ZStack {
+                Circle().strokeBorder(NotchLayout.ringTrack, lineWidth: NotchLayout.trackStroke)
+                if let fraction = reading.fraction {
+                    Circle().inset(by: NotchLayout.trackStroke / 2)
+                        .trim(from: 0, to: min(max(fraction, 0), 1))
+                        .stroke(NotchLayout.accent(fraction, blocked: reading.snapshot?.block != nil),
+                                style: StrokeStyle(lineWidth: NotchLayout.progressStroke, lineCap: .round))
+                        .rotationEffect(.degrees(-90))
+                        .animation(reduceMotion ? nil : .spring(response: 0.9, dampingFraction: 0.9), value: fraction)
+                }
+                QuotaGlyph().fill(.white, style: FillStyle(eoFill: true))
+                    .scaleEffect(0.94).frame(width: NotchLayout.glyphSize, height: NotchLayout.glyphSize)
+                    .opacity(reading.snapshot?.block != nil || (reading.fraction ?? 0) >= 1
+                             ? (reduceTransparency ? 0.7 : 0.35) : 1)
+            }
+            .frame(width: NotchLayout.ringDiameter, height: NotchLayout.ringDiameter)
+            .opacity(reading.stale ? (reduceTransparency ? 0.75 : 0.45) : 1)
+            Text(reading.percentage).font(NotchLayout.percent)
+                .fixedSize().frame(height: NotchLayout.percentLineHeight)
+        }
+        .frame(width: NotchLayout.ringDiameter, height: NotchLayout.cellExtent)
+        .position(x: geometry.ringCenter.x,
+                  y: geometry.ringCenter.y - NotchLayout.ringDiameter / 2 + NotchLayout.cellExtent / 2)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Codex, \(reading.percentage)\(reading.status.map { ", \($0)" } ?? "")")
+    }
+}
