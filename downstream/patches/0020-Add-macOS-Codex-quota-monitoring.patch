diff --git a/macos/Sources/AgentSpeed/App/QuotaNotch.swift b/macos/Sources/AgentSpeed/App/QuotaNotch.swift
new file mode 100644
index 00000000..a514fba9
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaNotch.swift
@@ -0,0 +1,680 @@
+import AgentSpeedCore
+import AppKit
+import Observation
+import SwiftUI
+
+// Port of the approved Windows quota notch, Codenotch 835550a (Vinz, MIT).
+// See Resources/Codenotch-LICENSE.txt. Native input follows actual painted contours.
+
+@MainActor
+struct QuotaNotchReading {
+    let providerID: String
+    let snapshot: QuotaSnapshot?
+    let networkEnabled: Bool
+    let l10n: Localizer
+    let windows: [QuotaWindow]
+    let readings: [String]
+    let readingWidth: CGFloat
+    let readingHeight: CGFloat
+    var outerDiameter: CGFloat { NotchLayout.outerDiameter(windows.count) }
+    var cellMetrics: QuotaNotchCellMetrics { QuotaNotchCellMetrics(width: readingWidth, readingHeight: readingHeight, diameter: outerDiameter) }
+
+    init(providerID: String? = nil, snapshot: QuotaSnapshot?, networkEnabled: Bool, l10n: Localizer) {
+        self.providerID = providerID ?? snapshot?.id ?? "codex"
+        self.snapshot = snapshot; self.networkEnabled = networkEnabled; self.l10n = l10n
+        windows = QuotaWindow.ordered(snapshot?.windows ?? [])
+        let multiple = windows.count > 1
+        readings = windows.isEmpty ? ["—"] : windows.map { window in
+            let remaining = snapshot?.status == .needsAuth ? l10n("mac.quota.unknown")
+                : window.remainingFraction.map { quotaPercent($0, locale: l10n.locale) } ?? l10n("mac.quota.unknown")
+            return (multiple ? quotaCompactWindowLabel(window, l10n, providerName: snapshot?.displayName) + " " : "") + remaining
+        }
+        let font = NSFont.systemFont(ofSize: multiple ? 11 : 15, weight: .semibold)
+        readingWidth = readings.reduce(CGFloat(0)) { $0 + ceil(($1 as NSString).size(withAttributes: [.font: font]).width) }
+            + (multiple ? CGFloat(readings.count * 9 + max(0, readings.count - 1) * 9) : 0)
+        readingHeight = ceil(font.ascender - font.descender + font.leading)
+    }
+    func stale(at now: Date) -> Bool {
+        !networkEnabled || snapshot?.status == .stale || snapshot?.observedAt.map { now.timeIntervalSince($0) > 900 } == true
+    }
+    func status(at now: Date) -> String { quotaDisplayStatus(snapshot, l10n, networkEnabled: networkEnabled, now: now) }
+    var displayName: String { snapshot?.displayName ?? quotaSources.first { $0.id == providerID }?.name ?? providerID }
+
+    func resetText(_ date: Date, now: Date, calendar: Calendar = .current) -> String {
+        let seconds = date.timeIntervalSince(now)
+        guard seconds > 0 else { return l10n("mac.quota.resetting") }
+        let minutes = floor(seconds / 60 + 0.5)
+        if minutes < 60 { return l10n("mac.quota.resetMinutes", quotaNumber(max(1, minutes), l10n)) }
+        let days = calendar.dateComponents([.day], from: calendar.startOfDay(for: now), to: calendar.startOfDay(for: date)).day ?? 0
+        let formatter = DateFormatter()
+        let chinese = l10n.language == .zhHans || l10n.language == .zhHant
+        formatter.locale = l10n.language == .ja ? Locale(identifier: "en_US") : l10n.locale
+        formatter.calendar = calendar; formatter.timeZone = calendar.timeZone
+        if days >= 7 {
+            formatter.dateFormat = chinese ? "M月d日" : "MMM d"
+            return l10n("mac.quota.notchResetsDate", formatter.string(from: date))
+        }
+        formatter.dateFormat = chinese ? "a h:mm" : "h:mm a"
+        let time = formatter.string(from: date)
+        if seconds < 86_400 { return l10n("mac.quota.notchResetsAt", time) }
+        formatter.dateFormat = "EEE"
+        return l10n("mac.quota.notchResetsOn", formatter.string(from: date), time)
+    }
+}
+
+@MainActor func quotaCompactWindowLabel(_ window: QuotaWindow, _ l10n: Localizer, providerName: String?) -> String {
+    let label: String
+    switch window.period {
+    case .month: label = l10n("mac.quota.period.month")
+    case .week: label = l10n("mac.quota.period.week")
+    case .fiveHours: label = l10n("mac.quota.period.fiveHours")
+    case .other:
+        if let duration = window.periodDuration {
+            label = duration < 86_400 ? l10n("mac.quota.periodHours", quotaNumber(duration / 3_600, l10n))
+                : l10n("mac.quota.days", quotaNumber(duration / 86_400, l10n))
+        } else { label = l10n("mac.quota.window") }
+    }
+    if quotaIsProviderLabel(window.label, providerName: providerName) { return label }
+    return window.label + " · " + label
+}
+
+@MainActor @Observable
+final class QuotaNotchHover {
+    enum Region: Equatable { case outside, bar, cell(String), tooltip, grip }
+    private(set) var region = Region.outside
+    private(set) var activeSource: String?
+    private(set) var inside = false
+    private(set) var graceActive = false
+    var keepExpanded = false
+    var held = false
+    var menuOpen = false
+    var onChange: (() -> Void)?
+    @ObservationIgnored private let scheduler: any PerfCardScheduling
+    @ObservationIgnored private var grace: (any PerfCardTimer)?
+    var expanded: Bool { keepExpanded || inside || graceActive || held || menuOpen }
+
+    init(scheduler: any PerfCardScheduling = PerfCardMainScheduler()) {
+        self.scheduler = scheduler
+    }
+
+    func move(to next: Region) {
+        guard region != next else { return }
+        region = next; inside = next != .outside
+        if case let .cell(id) = next { activeSource = id; cancelGrace() }
+        else if next == .tooltip { cancelGrace() }
+        else { startGrace() }
+        onChange?()
+    }
+    func startGrace() {
+        guard !graceActive && !held && !menuOpen else { return }
+        graceActive = true
+        // Arm at departure, not when a newly enqueued main-actor task eventually starts.
+        grace = scheduler.after(0.25) { [weak self] in
+            guard let self else { return }
+            self.graceActive = false; self.grace = nil
+            switch self.region {
+            case .cell, .tooltip: break
+            default: self.activeSource = nil
+            }
+            self.onChange?()
+        }
+    }
+    func cancelGrace() { grace?.cancel(); grace = nil; graceActive = false }
+    func reset() {
+        cancelGrace(); region = .outside; inside = false; activeSource = nil; held = false; menuOpen = false
+    }
+    func dismissCard() { activeSource = nil }
+}
+
+
+
+/// Native body paths and portable grip components remain independent filled sets.
+/// Neither NSView hit testing nor panel interception asks SwiftUI to normalize CSG.
+struct QuotaNotchInput {
+    var paths: [Path] = []
+    var grip = QuotaGripFootprint()
+    func contains(_ point: CGPoint) -> Bool { grip.contains(point) || paths.contains { $0.contains(point) } }
+}
+
+private struct QuotaGripVectorPart: View {
+    let part: QuotaGripFootprint.Part
+    let fill: Color
+    let edge: Color
+    var lineWidth: CGFloat = 1
+    var body: some View {
+        let path = part.contour.path.applying(part.transform.affine)
+        if let clip = part.clip {
+            path.fill(fill).overlay { if lineWidth > 0 { path.stroke(edge, lineWidth: lineWidth) } }
+                .clipShape(clip.contour.path.applying(clip.transform.affine))
+        } else {
+            path.fill(fill).overlay { if lineWidth > 0 { path.stroke(edge, lineWidth: lineWidth) } }
+        }
+    }
+}
