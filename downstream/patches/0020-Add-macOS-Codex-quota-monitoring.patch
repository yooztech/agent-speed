+@MainActor
+final class QuotaNotchController: NSObject, NSMenuDelegate {
+    private let model: AppModel
+    private let panel = QuotaNotchPanel(), card = QuotaNotchPanel()
+    private let hosting = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
+    private let cardHosting = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
+    private let cardMeasure = NSHostingView(rootView: AnyView(EmptyView()))
+    private var cardHeight: CGFloat = 65
+    private var cardMeasureDirty = true
+    private var cardObserved: Date?
+    private var cardSource: String?
+    private var appearanceObservation: NSKeyValueObservation?
+    private let pointer = OrbWindowPointerTracker()
+    private let hover = QuotaNotchHover()
+    private let filter = QuotaGripFilter()
+    private var readings: [QuotaNotchReading] = []
+    private var geometry: QuotaNotchGeometry?
+    private var gripPaint: QuotaGripPaint?
+    private var motion = QuotaGripMotion(), expansion = QuotaMotionTrack()
+    private var gripIntent = QuotaGripIntent()
+    private var gripEnvelope: QuotaGripFootprint?
+    private var animation: Task<Void, Never>?, clock: Task<Void, Never>?
+    private var displayNow = Date()
+    private var edge: NotchEdge
+    private var along: CGFloat
+    private var displayID: UInt32?
+    private var verticalLayout = QuotaNotchContentLayout(cells: [], horizontal: false)
+    private var horizontalLayout = QuotaNotchContentLayout(cells: [], horizontal: true)
+    private var stopped = false, visible = false, reducedMotion = false, dark = true
+    private var pressPoint: CGPoint?, pressedRegion = QuotaNotchHover.Region.outside
+    private var pendingDrag = false, dragging = false
+    private var grabOffset: CGFloat = 0
+    private var revision = 0
+    nonisolated(unsafe) private var screenObserver: NSObjectProtocol?
+
+    init(model: AppModel) {
+        self.model = model
+        edge = model.settings.storage.string(forKey: "quota.notchEdge").flatMap(NotchEdge.init(rawValue:)) ?? .right
+        along = (model.settings.storage.object(forKey: "quota.notchAlong") as? NSNumber).map { CGFloat($0.doubleValue) } ?? 0.5
+        displayID = (model.settings.storage.object(forKey: "quota.notchMonitor") as? NSNumber)?.uint32Value
+        super.init()
+        panel.contentView = hosting; card.contentView = cardHosting
+        hosting.sizingOptions = []; cardHosting.sizingOptions = []
+        hosting.press = { [weak self] in self?.press($0) }
+        hosting.drag = { [weak self] in self?.drag($0) }
+        hosting.release = { [weak self] in self?.release($0) }
+        hosting.context = { [weak self] in self?.showMenu($0, view: self?.hosting) }
+        cardHosting.context = { [weak self] in self?.showMenu($0, view: self?.cardHosting) }
+        hover.onChange = { [weak self] in self?.interactionChanged() }
+        pointer.onMove = { [weak self] point, _ in self?.pointerMoved(point) }
+        screenObserver = NotificationCenter.default.addObserver(forName: NSApplication.didChangeScreenParametersNotification, object: nil, queue: .main) { [weak self] _ in
+            MainActor.assumeIsolated { self?.render() }
+        }
+        appearanceObservation = NSApp.observe(\.effectiveAppearance) { [weak self] _, _ in
+            Task { @MainActor [weak self] in self?.observeModel() }
+        }
+        observeModel()
+    }
+
+    func stop() {
+        stopped = true; revision += 1
+        stopInteraction(); pointer.stop(); panel.orderOut(nil)
+        if let screenObserver { NotificationCenter.default.removeObserver(screenObserver) }
+        screenObserver = nil
+    }
+    deinit {
+        animation?.cancel(); clock?.cancel()
+        if let screenObserver { NotificationCenter.default.removeObserver(screenObserver) }
+    }
+    private static func id(_ screen: NSScreen) -> UInt32? { (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.uint32Value }
+    private var screen: NSScreen? { NSScreen.screens.first { Self.id($0) == displayID } ?? NSScreen.main ?? NSScreen.screens.first }
+    private var now: TimeInterval { ProcessInfo.processInfo.systemUptime }
+
+    private func observeModel() {
+        guard !stopped else { return }
+        revision += 1
+        let current = revision
+        let state = withObservationTracking {
+            (model.quota.floatingVisible, model.accessibility.reduceMotion, model.settings.appearance,
+             model.quota.snapshots,
+             quotaEnabledSources(model.quota).filter { provider in
+                 model.quota.snapshots.contains { $0.id == provider.id }
+             },
+             model.quota.keepExpanded,
+             model.quota.networkEnabled, model.l10n.language)
+        } onChange: { [weak self] in
+            Task { @MainActor [weak self] in
+                guard let self, self.revision == current else { return }
+                self.observeModel()
+            }
+        }
+        let oldVisible = visible
+        visible = state.0; reducedMotion = state.1
+        dark = state.2 == .dark || (state.2 == .auto && NSApp.effectiveAppearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua)
+        readings = state.4.map { provider in
+            QuotaNotchReading(providerID: provider.id, snapshot: state.3.first { $0.id == provider.id }, networkEnabled: state.6, l10n: model.l10n)
+        }
+        if !state.6 { clock?.cancel(); clock = nil }
+        let cells = readings.map(\.cellMetrics)
+        verticalLayout = QuotaNotchContentLayout(cells: cells, horizontal: false)
+        horizontalLayout = QuotaNotchContentLayout(cells: cells, horizontal: true)
+        hover.keepExpanded = state.5
+        cardMeasureDirty = true
+        if let active = hover.activeSource, !readings.contains(where: { $0.providerID == active }) { hover.dismissCard() }
+        if !visible { stopInteraction(); panel.orderOut(nil); pointer.stop() }
+        else {
+            if !oldVisible { expansion.snap(hover.keepExpanded ? 1 : 0) }
+            displayNow = Date(); render(); panel.orderFrontRegardless(); pointer.start(); interactionChanged()
+            pointerMoved(NSEvent.mouseLocation)
+        }
+    }
+
+    private func interactionChanged() {
+        guard visible && !stopped else { return }
+        let time = now, target: CGFloat = hover.expanded ? 1 : 0
+        if expansion.target != target { expansion.to(target, now: time, duration: 0.22) }
+        let expanded = target == 1 && (reducedMotion || expansion.value >= 1)
+        motion.setTargets(expanded: expanded, reveal: expanded && (gripIntent.acquired || hover.held), hover: gripIntent.acquired,
+                          held: hover.held, now: time, reducedMotion: reducedMotion)
+        if reducedMotion { expansion.snap(target); animation?.cancel(); animation = nil }
+        render()
+        if !reducedMotion && animation == nil && (expansion.active || motion.active) {
+            animation = Task { @MainActor [weak self] in
+                while !Task.isCancelled {
+                    try? await Task.sleep(for: .milliseconds(16))
+                    guard !Task.isCancelled, let self, self.visible, !self.stopped else { return }
+                    let time = self.now
+                    self.expansion.sample(time); self.motion.sample(time)
+                    self.motion.setTargets(expanded: self.expansion.target == 1 && self.expansion.value >= 1,
+                                           reveal: self.gripIntent.acquired || self.hover.held, hover: self.gripIntent.acquired,
+                                           held: self.hover.held, now: time, reducedMotion: false)
+                    self.render(); self.pointerMoved(NSEvent.mouseLocation)
+                    if !self.expansion.active && !self.motion.active { self.animation = nil; return }
+                }
+            }
+        }
+    }
+
+    private func render() {
+        guard visible && !stopped, let screen else { return }
+        displayID = Self.id(screen)
+        let geometry = QuotaNotchGeometry(edge: edge, expansion: expansion.value, layout: edge.isVertical ? verticalLayout : horizontalLayout)
+        self.geometry = geometry
+        let grip = QuotaGripPaint(geometry: geometry, frame: motion.frame, filter: filter, scale: screen.backingScaleFactor, acquired: gripEnvelope, dark: dark)
+        gripPaint = grip
+        let frame = geometry.panelFrame(on: screen.visibleFrame, along: along)
+        if panel.frame != frame { panel.setFrame(frame, display: true) }
+        hosting.frame = CGRect(origin: .zero, size: geometry.size)
+        hosting.input = QuotaNotchInput(paths: [geometry.bodyPath, quotaStrokeOutline(geometry.bodyPath, width: expansion.value > 0 ? 1 : 0)], grip: grip.hit)
+        hosting.rootView = AnyView(QuotaNotchView(readings: readings, geometry: geometry, grip: grip, dark: dark))
+        placeCard(on: screen)
+        updateInterception(NSEvent.mouseLocation)
+    }
+
+    private func placeCard(on screen: NSScreen) {
+        guard !dragging, let source = hover.activeSource, let index = readings.firstIndex(where: { $0.providerID == source }), let geometry else {
+            card.orderOut(nil); clock?.cancel(); clock = nil; cardSource = nil; cardObserved = nil; return
+        }
+        let reading = readings[index]
+        let content = QuotaNotchTooltipContent(reading: reading, now: displayNow)
+            .environment(\.colorScheme, dark ? .dark : .light)
+        if cardSource != source || cardObserved != reading.snapshot?.observedAt || clock == nil {
+            cardSource = source; cardObserved = reading.snapshot?.observedAt
+            cardMeasureDirty = true; scheduleClock(observedAt: cardObserved)
+        }
+        if cardMeasureDirty {
+            cardMeasure.rootView = AnyView(content)
+            cardHeight = max(65, ceil(cardMeasure.fittingSize.height))
+            cardMeasureDirty = false
+        }
+        let height = cardHeight
+        let vertical = edge.isVertical
+        let size = vertical ? CGSize(width: 274.2, height: height) : CGSize(width: 246, height: height + 28.2)
+        let center = geometry.centers[index]
+        let localTarget: CGPoint
+        let depth = edge.isVertical ? geometry.size.width - 0.5 : geometry.size.height - 0.5
+        switch edge {
+        case .right: localTarget = CGPoint(x: geometry.size.width - depth - 10.5, y: center.y)
+        case .left: localTarget = CGPoint(x: depth + 10.5, y: center.y)
+        case .top: localTarget = CGPoint(x: center.x, y: depth + 10.5)
+        case .bottom: localTarget = CGPoint(x: center.x, y: geometry.size.height - depth - 10.5)
+        }
+        let target = CGPoint(x: panel.frame.minX + localTarget.x, y: panel.frame.maxY - localTarget.y)
+        let tip: CGPoint
+        switch edge {
+        case .right: tip = CGPoint(x: size.width, y: height / 2)
+        case .left: tip = CGPoint(x: 0, y: height / 2)
+        case .top: tip = CGPoint(x: 123, y: 0)
+        case .bottom: tip = CGPoint(x: 123, y: size.height)
+        }
+        let work = screen.visibleFrame
+        let origin = CGPoint(x: min(max(target.x - tip.x, work.minX), max(work.minX, work.maxX - size.width)),
+                             y: min(max(target.y - size.height + tip.y, work.minY), max(work.minY, work.maxY - size.height)))
+        let frame = CGRect(origin: origin, size: size)
+        if card.frame != frame { card.setFrame(frame, display: true) }
+        let body = CGRect(x: edge == .left ? 28.2 : 0, y: edge == .top ? 28.2 : 0, width: 246, height: height)
+        let along = vertical ? frame.maxY - target.y : target.x - frame.minX
+        let limit = vertical ? height : CGFloat(246)
+        let tailAt = min(max(along, 32.36), max(32.36, limit - 32.36))
+        let tail: CGRect
+        switch edge {
+        case .right: tail = CGRect(x: 246, y: tailAt - 16.36, width: 28.2, height: 32.72)
+        case .left: tail = CGRect(x: 0, y: tailAt - 16.36, width: 28.2, height: 32.72)
+        case .top: tail = CGRect(x: tailAt - 16.36, y: 0, width: 32.72, height: 28.2)
+        case .bottom: tail = CGRect(x: tailAt - 16.36, y: height, width: 32.72, height: 28.2)
+        }
+        let bodyPath = RoundedRectangle(cornerRadius: 16).path(in: body)
+        let tailPath = QuotaTooltipTail(edge: edge).path(in: tail)
+        let path = bodyPath.union(tailPath)
+        cardHosting.input = QuotaNotchInput(paths: [bodyPath, tailPath])
+        cardHosting.frame = CGRect(origin: .zero, size: size)
+        cardHosting.rootView = AnyView(ZStack(alignment: .topLeading) {
+            path.fill(dark ? Color(white: 10 / 255) : .white)
+            content.position(x: body.midX, y: body.midY)
+        }.frame(width: size.width, height: size.height).allowsHitTesting(false))
+        if !card.isVisible { card.orderFrontRegardless() }
+    }
+
+    private func scheduleClock(observedAt: Date?) {
+        clock?.cancel(); clock = nil
+        guard !stopped, visible, model.quota.networkEnabled else { return }
+        clock = Task { @MainActor [weak self] in
+            while !Task.isCancelled {
+                try? await Task.sleep(for: .seconds(QuotaDisplayClock.delay(observedAt: observedAt, now: Date())))
+                guard !Task.isCancelled, let self else { return }
+                guard self.card.isVisible, self.visible, self.model.quota.networkEnabled else {
+                    self.clock = nil
+                    return
+                }
+                self.displayNow = Date(); self.cardMeasureDirty = true; self.render()
+            }
+        }
+    }
+    private func local(_ point: CGPoint, in panel: NSPanel) -> CGPoint { CGPoint(x: point.x - panel.frame.minX, y: panel.frame.maxY - point.y) }
+    private func updateInterception(_ point: CGPoint) {
+        panel.ignoresMouseEvents = pointer.isForeignDragActive || (!pendingDrag && !dragging && !hosting.input.contains(local(point, in: panel)))
+        card.ignoresMouseEvents = pointer.isForeignDragActive || !cardHosting.input.contains(local(point, in: card))
+    }
+    private func region(_ point: CGPoint) -> QuotaNotchHover.Region {
+        if card.isVisible && cardHosting.input.contains(local(point, in: card)) { return .tooltip }
+        guard let geometry else { return .outside }
+        let point = local(point, in: panel)
+        if gripIntent.acquired { return .grip }
+        guard geometry.bodyPath.contains(point) else { return .outside }
+        if expansion.value > 0 {
+            for (index, rect) in geometry.cellRects.enumerated() where rect.contains(point) { return .cell(readings[index].providerID) }
+        }
+        return .bar
+    }
+    private func pointerMoved(_ point: CGPoint) {
+        guard visible && !stopped else { return }
+        guard !pointer.isForeignDragActive && !dragging && !pendingDrag else { updateInterception(point); return }
+        let localPoint = local(point, in: panel)
+        let wasAcquired = gripIntent.acquired
+        let acquired = gripIntent.update(point, entry: gripPaint?.hit.contains(localPoint) == true,
+                                         envelope: gripEnvelope?.contains(localPoint) == true, held: hover.held)
+        if acquired && !wasAcquired, let geometry, let gripPaint {
+            gripEnvelope = QuotaGripGeometry.activation(geometry.orbCenter).applying(geometry.transform).union(gripPaint.hit)
+        }
+        else if !acquired { gripEnvelope = nil }
+        let next = region(point)
+        if case .cell = next, hover.region != next { displayNow = Date(); cardMeasureDirty = true }
+        let regionChanged = hover.region != next
+        hover.move(to: next)
+        if wasAcquired != acquired && !regionChanged { interactionChanged() }
+        updateInterception(point)
+    }
+
+    private func press(_ event: NSEvent) {
+        guard visible, let geometry else { return }
+        let point = NSEvent.mouseLocation
+        pressedRegion = gripPaint?.hit.contains(local(point, in: panel)) == true ? .grip : region(point)
+        pressPoint = point
+        pendingDrag = pressedRegion == .grip || (pressedRegion == .bar && event.modifierFlags.contains(.option))
+        let pointInPanel = local(point, in: panel)
+        grabOffset = (edge.isVertical ? pointInPanel.y : pointInPanel.x) - geometry.bodyCenterAlong
+        hover.cancelGrace(); hover.held = pressedRegion == .grip; interactionChanged()
+    }
+    private func drag(_ event: NSEvent) {
+        guard let pressPoint, pendingDrag || dragging else { return }
+        let point = NSEvent.mouseLocation
+        if !dragging {
+            guard hypot(point.x - pressPoint.x, point.y - pressPoint.y) >= 4 else { return }
+            dragging = true; pendingDrag = false; hover.dismissCard(); card.orderOut(nil); clock?.cancel(); clock = nil
+        }
+        dragTo(point); interactionChanged()
+    }
+    private func dragTo(_ point: CGPoint) {
+        guard let screen = NSScreen.screens.first(where: { $0.frame.contains(point) }) ?? self.screen else { return }
+        let work = screen.visibleFrame
+        let distances: [(NotchEdge, CGFloat)] = [(.left, abs(point.x - work.minX)), (.right, abs(point.x - work.maxX)), (.top, abs(point.y - work.maxY)), (.bottom, abs(point.y - work.minY))]
+        edge = distances.min { $0.1 < $1.1 }!.0
+        along = min(max(edge.isVertical ? (work.maxY - point.y - grabOffset) / work.height : (point.x - work.minX - grabOffset) / work.width, 0), 1)
+        displayID = Self.id(screen); render()
+    }
+    private func release(_ event: NSEvent) {
+        let point = NSEvent.mouseLocation
+        if dragging {
+            dragTo(point)
+            model.settings.storage.set(edge.rawValue, forKey: "quota.notchEdge")
+            model.settings.storage.set(Double(along), forKey: "quota.notchAlong")
+            model.settings.storage.set(displayID, forKey: "quota.notchMonitor")
+        } else if pressedRegion == region(point), case .cell = pressedRegion { model.quota.refresh() }
+        pressPoint = nil; pendingDrag = false; dragging = false; pressedRegion = .outside; hover.held = false
+        pointerMoved(point); if hover.region == .outside { hover.startGrace() }; interactionChanged()
+    }
+    private func showMenu(_ event: NSEvent, view: NSView?) {
+        guard let view, !dragging, !hover.menuOpen else { return }
+        hover.menuOpen = true; hover.cancelGrace(); interactionChanged()
+        let menu = NSMenu()
+        menu.delegate = self
+        let open = NSMenuItem(title: model.l10n("mac.quota.open"), action: #selector(openSettings), keyEquivalent: "")
+        open.target = self; menu.addItem(open)
+        let hide = NSMenuItem(title: model.l10n("mac.quota.hide"), action: #selector(hideNotch), keyEquivalent: "")
+        hide.target = self; menu.addItem(hide)
+        NSMenu.popUpContextMenu(menu, with: event, for: view)
+    }
+    func menuDidClose(_ menu: NSMenu) {
+        hover.menuOpen = false; pointerMoved(NSEvent.mouseLocation)
+        switch hover.region {
+        case .cell, .tooltip: break
+        default: hover.startGrace()
+        }
+        interactionChanged()
+    }
+    @objc private func openSettings() { model.commands?.showSettings(.quota) }
+    @objc private func hideNotch() { model.quota.floatingVisible = false }
+    private func stopInteraction() {
+        animation?.cancel(); animation = nil; clock?.cancel(); clock = nil
+        hover.reset(); expansion.snap(0); motion = QuotaGripMotion()
+        gripIntent.reset(); gripEnvelope = nil
+        pressPoint = nil; pendingDrag = false; dragging = false; pressedRegion = .outside
+        panel.ignoresMouseEvents = true; card.ignoresMouseEvents = true; card.orderOut(nil)
+    }
+}
+
+struct QuotaGlyph: Shape {
+    func path(in rect: CGRect) -> Path {
+        QuotaGlyphOutline.path.applying(CGAffineTransform(a: rect.width, b: 0, c: 0, d: rect.height, tx: rect.minX, ty: rect.minY))
+    }
+}
