+struct QuotaTooltipTail: Shape {
+    let edge: NotchEdge
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        path.move(to: CGPoint(x: 0, y: 0))
+        path.addCurve(to: CGPoint(x: 28.2, y: 16.36), control1: CGPoint(x: 0, y: 8.18), control2: CGPoint(x: 16.36, y: 12.43))
+        path.addCurve(to: CGPoint(x: 0, y: 32.72), control1: CGPoint(x: 16.36, y: 20.29), control2: CGPoint(x: 0, y: 24.54))
+        path.closeSubpath()
+        let transform: CGAffineTransform
+        switch edge {
+        case .right: transform = CGAffineTransform(translationX: rect.minX, y: rect.minY)
+        case .left: transform = CGAffineTransform(a: -1, b: 0, c: 0, d: 1, tx: rect.maxX, ty: rect.minY)
+        case .top: transform = CGAffineTransform(a: 0, b: -1, c: 1, d: 0, tx: rect.minX, ty: rect.maxY)
+        case .bottom: transform = CGAffineTransform(a: 0, b: 1, c: 1, d: 0, tx: rect.minX, ty: rect.minY)
+        }
+        return path.applying(transform)
+    }
+}
