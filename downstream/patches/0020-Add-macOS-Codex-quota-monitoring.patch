+    /// Fixed acquired intent covers the original disc, final dots and narrow
+    /// connecting routes. None of this envelope is input before real grip entry.
+    static func activation(_ center: CGPoint) -> QuotaGripFootprint {
+        let frame = QuotaGripFrame(reveal: 1, hover: 1.3, arc: 1)
+        let radius = NotchLayout.discRadius + 0.5
+        let disc = QuotaGripFootprint(.ellipse(CGRect(x: center.x - radius, y: center.y - radius, width: radius * 2, height: radius * 2)))
+        return routes(center, frame: frame).union(drops(center, frame: frame).hit)
