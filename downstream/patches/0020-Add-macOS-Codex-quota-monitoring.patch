+            path.addLine(to: CGPoint(x: depth - radius, y: start))
+            path.addArc(center: CGPoint(x: depth - radius, y: start + radius), radius: radius, startAngle: .degrees(-90), endAngle: .zero, clockwise: false)
+            path.addLine(to: CGPoint(x: depth, y: end - radius))
+            path.addArc(center: CGPoint(x: depth - radius, y: end - radius), radius: radius, startAngle: .zero, endAngle: .degrees(90), clockwise: false)
+            path.addLine(to: CGPoint(x: flare, y: end))
+            path.addArc(center: CGPoint(x: flare, y: end + flare), radius: flare, startAngle: .degrees(-90), endAngle: .degrees(-180), clockwise: true)
+            path.closeSubpath()
+        }
+        bodyPath = path.applying(transform)
+        orbCenter = CGPoint(x: NotchLayout.curlRadius, y: (start + end) / 2 + length / 2 + NotchLayout.curlRadius)
+        let ringX = horizontal ? (edge == .bottom ? depth - 6 - ringSize / 2 : 6 + ringSize / 2) : depth / 2
+        let ringY = start + 12 + (horizontal ? cellSize.width : ringSize) / 2
+        let pitch = (horizontal ? cellSize.width : cellSize.height) + 14
+        let edgeTransform = transform
+        centers = (0..<count).map { CGPoint(x: ringX, y: ringY + CGFloat($0) * pitch).applying(edgeTransform) }
+        cellRects = centers.map { CGRect(x: $0.x - cellSize.width / 2, y: $0.y - ringSize / 2, width: cellSize.width, height: cellSize.height) }
+    }
+
+    func panelFrame(on screen: CGRect, along: CGFloat) -> CGRect {
+        let alongLength = edge.isVertical ? screen.height : screen.width
+        let windowLength = edge.isVertical ? size.height : size.width
+        let origin = windowLength > alongLength ? (alongLength - windowLength) / 2
+            : min(max(alongLength * along - bodyCenterAlong, 0), alongLength - windowLength)
+        switch edge {
+        case .left: return CGRect(x: screen.minX, y: (screen.maxY - origin - size.height).rounded(), width: size.width, height: size.height)
+        case .right: return CGRect(x: screen.maxX - size.width, y: (screen.maxY - origin - size.height).rounded(), width: size.width, height: size.height)
+        case .top: return CGRect(x: (screen.minX + origin).rounded(), y: screen.maxY - size.height, width: size.width, height: size.height)
+        case .bottom: return CGRect(x: (screen.minX + origin).rounded(), y: screen.minY, width: size.width, height: size.height)
+        }
+    }
+}
