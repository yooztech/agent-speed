+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+#if canImport(CryptoKit)
+import CryptoKit
+#else
+import Crypto
+#endif
+import Testing
+@testable import AgentSpeedCore
+
+private final class LifecycleQuotaFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var requests: [URLRequest] = []
+    var usageStatus = 200
+    var resetStatus = 200
+    var time = Date(timeIntervalSince1970: 1_800_000_000)
+    func now() -> Date { lock.withLock { time } }
+    func count() -> Int { lock.withLock { requests.filter { $0.url?.path.hasSuffix("/usage") == true }.count } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock {
+            requests.append(request)
+            let reset = request.url?.path.hasSuffix("rate-limit-reset-credits") == true
+            let body = reset ? #"{"available_count":2,"credits":[{"status":"available","expires_at":"2028-01-01T00:00:00Z"}]}"#
+                : #"{"rate_limit":{"primary_window":{"used_percent":25,"limit_window_seconds":18000}}}"#
+            return (Data(body.utf8), HTTPURLResponse(url: request.url!, statusCode: reset ? resetStatus : usageStatus,
+                httpVersion: nil, headerFields: ["Retry-After": "900"])!)
+        }
+    }
+}
+
+private actor QuotaResponseGate {
+    private var request: CheckedContinuation<Void, Never>?
+    private var observer: CheckedContinuation<Void, Never>?
+    func pause() async {
+        await withCheckedContinuation { continuation in
+            request = continuation
+            observer?.resume()
+            observer = nil
+        }
+    }
+    func waitForRequest() async {
+        if request != nil { return }
+        await withCheckedContinuation { observer = $0 }
+    }
+    func release() { request?.resume(); request = nil }
+}
+
+@Suite("Quota cache and startup lifecycle")
+struct QuotaLifecycleTests {
+    private func directory() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+    private func writeCodex(_ auth: URL, token: String = "borrowed-token", account: String = "account-a") throws {
+        try JSONSerialization.data(withJSONObject: ["tokens": ["access_token": token, "account_id": account]]).write(to: auth)
+    }
+    private func codex(_ auth: URL, suite: String, fixture: LifecycleQuotaFixture) -> CodexQuotaProvider {
+        CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { fixture.now() }, transport: { fixture.fetch($0) })
+    }
+
+    @Test func startupBypassesOnlyOneTrustedSuccessFloorAndRetainsObservationTime() async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        let original = await codex(auth, suite: suite, fixture: fixture).refresh()
+        #expect(original.resetCreditsAvailable == 2)
+        #expect(original.resetCreditsNextExpiry != nil)
+        let restarted = codex(auth, suite: suite, fixture: fixture)
+        let cached = await restarted.readCachedSnapshot()
+        #expect(cached.status == .stale)
+        #expect(cached.observedAt == original.observedAt)
+        #expect(cached.resetCreditsAvailable == 2)
+        #expect(fixture.count() == 1)
+        #expect(await restarted.refreshStartup().status == .ok)
+        #expect(fixture.count() == 2)
+        _ = await restarted.refreshStartup()
+        _ = await restarted.refresh()
+        #expect(fixture.count() == 2)
+    }
+
+    @Test(arguments: [429, 503])
+    func startupCannotBypassFailureCooldown(status: Int) async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        fixture.usageStatus = status
+        let failed = await codex(auth, suite: suite, fixture: fixture).refresh()
+        let restarted = codex(auth, suite: suite, fixture: fixture)
+        let blocked = await restarted.refreshStartup()
+        #expect(blocked.nextAllowedAt == failed.nextAllowedAt)
+        #expect(fixture.count() == 1)
+    }
+
+    @Test func optionalResetEndpoint429SurvivesRestartAndTokenRotation() async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        fixture.resetStatus = 429
+        let result = await codex(auth, suite: suite, fixture: fixture).refresh()
+        #expect(result.status == .ok)
+        #expect(result.resetCreditsAvailable == nil)
+        #expect(result.nextAllowedAt == fixture.now().addingTimeInterval(900))
+        try writeCodex(auth, token: "rotated-token")
+        let restarted = codex(auth, suite: suite, fixture: fixture)
+        let blocked = await restarted.refreshStartup()
+        #expect(blocked.status == .stale)
+        #expect(blocked.nextAllowedAt == result.nextAllowedAt)
+        #expect(fixture.count() == 1)
+    }
+
+    @Test func unversionedScheduleNeverProvesStartupBypassAndMalformedCacheRetainsCooldown() async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        let key = SHA256.hash(data: Data("account-a".utf8)).map { String(format: "%02x", $0) }.joined()
+        let next = fixture.now().addingTimeInterval(900)
+        let schedule: [String: Any] = ["nextAllowedAt": next.timeIntervalSinceReferenceDate,
+                                      "failures": 0, "successfulObservation": true]
+        defaults.set(try JSONSerialization.data(withJSONObject: schedule), forKey: "codex.quota.schedule." + key)
+        let legacy = await codex(auth, suite: suite, fixture: fixture).refreshStartup()
+        #expect(legacy.waitingForRefresh)
+        #expect(legacy.nextAllowedAt == next)
+        #expect(fixture.count() == 0)
+        let cache = auth.appendingPathExtension("quota-cache")
+        try FileManager.default.createDirectory(at: cache, withIntermediateDirectories: true)
+        var malformed = schedule
+        malformed["observation"] = ["version": 1, "accountKey": key, "snapshot": ["windows": "not-a-list"]]
+        try JSONSerialization.data(withJSONObject: malformed).write(to: cache.appendingPathComponent(key + ".json"))
+        let blocked = await codex(auth, suite: suite, fixture: fixture).refreshStartup()
+        #expect(blocked.nextAllowedAt == next)
+        #expect(fixture.count() == 0)
+    }
+
+    @Test func startupHonorsAuthRejectionAndCacheNeverCrossesAccounts() async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        fixture.usageStatus = 401
+        _ = await codex(auth, suite: suite, fixture: fixture).refresh()
+        #expect(await codex(auth, suite: suite, fixture: fixture).refreshStartup().status == .needsAuth)
+        #expect(fixture.count() == 1)
+        try writeCodex(auth, account: "account-b")
+        #expect(await codex(auth, suite: suite, fixture: fixture).readCachedSnapshot().observedAt == nil)
+    }
+
+    @Test func resetCreditParsingKeepsUnknownCountsAndEarliestAvailableExpiry() throws {
+        let data = Data(#"{"credits":[{"status":"used","expires_at":"2020-01-01T00:00:00Z"},{"status":"available","expires_at":"2028-02-01T00:00:00+00:00"},{"status":"available","expires_at":"2028-01-01T00:00:00.500Z"},{"status":"new-state"}]}"#.utf8)
+        let result = try CodexQuotaProvider.parseResetCredits(data)
+        #expect(result.available == nil)
+        #expect(result.expiry == ISO8601DateFormatter().date(from: "2028-01-01T00:00:00Z")?.addingTimeInterval(0.5))
+        #expect(try CodexQuotaProvider.parseResetCredits(Data(#"{"available_count":0,"credits":[{"status":"new-state"}]}"#.utf8)).available == 0)
+        #expect(try CodexQuotaProvider.parseResetCredits(Data(#"{"credits":[]}"#.utf8)).available == 0)
+        #expect(try CodexQuotaProvider.parseResetCredits(Data(#"{"available_count":true}"#.utf8)).available == nil)
+        #expect(try CodexQuotaProvider.parseResetCredits(Data(#"{"credits":[{"status":"available","expires_at":"2028-01-01T00:00:00"}]}"#.utf8)).expiry == nil)
+    }
+
+    @Test(arguments: [false, true])
+    func cancelledOrReplacedCodexRequestCannotCommit(replaceAccount: Bool) async throws {
+        let directory = try directory(), suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!, fixture = LifecycleQuotaFixture(), gate = QuotaResponseGate()
+        defer { try? FileManager.default.removeItem(at: directory); defaults.removePersistentDomain(forName: suite) }
+        let auth = directory.appendingPathComponent("auth.json")
+        try writeCodex(auth)
+        let provider = CodexQuotaProvider(credentialURL: auth, defaults: UserDefaults(suiteName: suite)!, now: { fixture.now() }) { request in
+            await gate.pause()
+            return fixture.fetch(request)
+        }
+        let pending = Task { await provider.refresh() }
+        await gate.waitForRequest()
+        if replaceAccount { try writeCodex(auth, account: "account-b") }
+        else { await provider.cancel() }
+        await gate.release()
+        _ = await pending.value
+        #expect(await provider.readCachedSnapshot().observedAt == nil)
