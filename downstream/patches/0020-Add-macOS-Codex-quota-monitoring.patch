+struct QuotaNotchTooltipContent: View {
+    let reading: QuotaNotchReading
+    let now: Date
+    @Environment(\.colorScheme) private var colorScheme
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            HStack(spacing: 8) {
+                QuotaSourceLogo(providerID: reading.providerID, ink: colorScheme == .dark ? .white : .primary).frame(width: 16, height: 16)
+                Text(reading.l10n("mac.quota.notchUsageTitle", reading.displayName)).font(.system(size: 14, weight: .bold))
+            }
+            if let account = reading.snapshot?.account { Text(account).font(.system(size: 11)).foregroundStyle(.secondary) }
+            if reading.stale(at: now), let observed = reading.snapshot?.observedAt {
+                Text(reading.l10n("mac.quota.updatedAt", quotaDate(observed, locale: reading.l10n.locale))).font(.system(size: 11)).foregroundStyle(.secondary)
+            }
+            if reading.snapshot?.status != .needsAuth {
+                ForEach(reading.windows, id: \.id) { window in
+                    VStack(alignment: .leading, spacing: 6) {
+                        ViewThatFits(in: .horizontal) {
+                            HStack(alignment: .firstTextBaseline, spacing: 8) {
+                                Text(quotaWindowLabel(window, reading.l10n, providerName: reading.displayName)).fontWeight(.semibold)
+                                Spacer(minLength: 0)
+                                if let reset = window.resetAt { Text(reading.resetText(reset, now: now)).font(.system(size: 11)).foregroundStyle(.secondary) }
+                            }
+                            VStack(alignment: .trailing, spacing: 0) {
+                                Text(quotaWindowLabel(window, reading.l10n, providerName: reading.displayName)).fontWeight(.semibold).frame(maxWidth: .infinity, alignment: .leading)
+                                if let reset = window.resetAt { Text(reading.resetText(reset, now: now)).font(.system(size: 11)).foregroundStyle(.secondary) }
+                            }
+                        }.font(.system(size: 12))
+                        if let remaining = window.remainingFraction {
+                            GeometryReader { proxy in
+                                ZStack(alignment: .leading) {
+                                    Capsule().fill(Color.secondary.opacity(0.25))
+                                    Capsule().fill(NotchLayout.periodColor(window)).frame(width: proxy.size.width * min(max(remaining, 0), 1))
+                                }
+                            }.frame(height: 4)
+                        }
+                        Text(window.usedFraction.map { used in
+                            reading.l10n("mac.quota.notchLeftUsed", quotaNumber((1 - used) * 100, reading.l10n), quotaNumber(used * 100, reading.l10n))
+                        } ?? reading.l10n("mac.quota.unknown")).font(.system(size: 11)).foregroundStyle(.secondary)
+                    }.padding(.top, 10)
+                }
+            }
+            Text(reading.status(at: now)).font(.system(size: 12)).padding(.top, 6)
+        }
+        .padding(16).frame(width: 246, alignment: .leading)
+    }
+}
