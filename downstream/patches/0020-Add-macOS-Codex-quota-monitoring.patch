+        }
+        return goo(center, separation: frame.arc, returning: frame.returning, quick: frame.quick)
+    }
+    static func drop(_ center: CGPoint, frame: QuotaGripFrame, index: Int) -> (center: CGPoint, radius: CGFloat) {
+        let t = min(max(frame.reveal, 0), 1)
+        let moved = CGPoint(x: center.x, y: center.y + 8 * quotaSmooth(t / 0.6) + 1.44 * sin(.pi * min(t / 0.8, 1)))
