+@MainActor
+final class QuotaNotchController: NSObject, NSMenuDelegate {
+    private let model: AppModel
+    private let panel = QuotaNotchPanel(), card = QuotaNotchPanel()
+    private let hosting = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
+    private let cardHosting = QuotaNotchHostingView(rootView: AnyView(EmptyView()))
