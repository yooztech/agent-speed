+                                             cardHeight: reading().cardHeight)
+            let center = CGPoint(x: geometry.bodyRect.midX, y: geometry.bodyRect.midY)
+            #expect(geometry.hits(center))
+            let wake = CGPoint(x: center.x - edge.outward.x * 12, y: center.y - edge.outward.y * 12)
+            #expect(!geometry.hits(wake))
