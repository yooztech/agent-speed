+                                    to: unrolled >= 0.999 ? 1 : 0.5 + half, shift: s * slide), width + (liquid ? blur * 0.4 + 2 : 0))
+        if liquid {
+            let neck = returning ? (quick ? 0 : fill * 1.1 * quotaSmooth((0.94 - t) / 0.1)) : fill * 1.1 * (1 - quotaSmooth((t - 0.2) / 0.5))
