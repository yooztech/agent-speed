+import SwiftUI
+
+/// Official Codex vector, matching the Windows quota renderer.
+struct QuotaSourceLogo: View {
+    let providerID: String?
+    var ink: Color = .white
+
+    var body: some View {
+        Group {
+            switch providerID {
+            case "codex":
+                QuotaGlyph().fill(ink, style: FillStyle(eoFill: true))
+            default:
+                EmptyView()
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}
