+    private var hover = QuotaGripSpring(response: 0.22, damping: 0.55)
+    private var squeeze = QuotaGripSpring(response: 0.26, damping: 0.7)
+    private var last: TimeInterval?
+    private var expanded = false, out = false, hovered = false, held = false
+    private var entryArc: CGFloat = 0
+    private var entryReturning = false, entryQuick = false
+    private(set) var frame = QuotaGripFrame()
+    var active: Bool { arc.active || disc.active || reveal.active || !hover.settled(hovered ? 1 : 0) || !squeeze.settled(held ? 1 : 0) }
+
+    mutating func setTargets(expanded: Bool, reveal show: Bool, hover hovering: Bool, held holding: Bool,
+                             now: TimeInterval, reducedMotion: Bool) {
+        let painted = frame
+        if !holding || held { sample(now) }
+        if self.expanded != expanded {
+            self.expanded = expanded
+            let first = expanded && arc.value <= 0.001
+            arc.to(expanded ? 1 : 0, now: now, delay: first ? 0.34 : 0,
+                   duration: first ? 0.95 : expanded ? 0.35 : 0.26, x1: expanded ? 0.35 : 0.42, x2: expanded ? 0.25 : 0.58)
+        }
+        let show = show && expanded
+        if out != show || held != holding {
+            if !out && show && entryArc <= 0.001 && painted.arc > 0.001 && painted.arc < 0.999 {
+                entryArc = painted.arc; entryReturning = painted.returning; entryQuick = painted.quick
+            }
+            out = show; held = holding
+            reveal.to(holding ? reveal.value : show ? 1 : 0, now: now,
+                      delay: show && !holding ? (reveal.value <= 0.001 ? 0.24 : 0.02) : 0,
+                      duration: show ? 0.42 : 0.2, x1: show ? 0.35 : 0.42, x2: show ? 0.25 : 1)
+            disc.to(holding ? disc.value : show ? 1 : 0, now: now, delay: show || holding ? 0 : 0.3,
+                    duration: show ? 0.22 : 0.4, x1: 0.3, x2: 0.2)
+        }
+        hovered = hovering
+        if reducedMotion {
+            arc.snap(expanded ? 1 : 0); disc.snap(holding ? disc.value : show ? 1 : 0)
+            reveal.snap(holding ? reveal.value : show ? 1 : 0)
+            hover.snap(hovering ? 1 : 0); squeeze.snap(holding ? 1 : 0)
+        }
+        publish()
+    }
+
+    mutating func sample(_ now: TimeInterval) {
+        arc.sample(now); disc.sample(now); reveal.sample(now)
+        if let last {
+            let dt = CGFloat(max(0, now - last))
+            hover.step(hovered ? 1 : 0, dt: dt); squeeze.step(held ? 1 : 0, dt: dt)
+        }
+        last = now
+        publish()
+    }
+    private mutating func publish() {
+        if !out && !held && !disc.active && !reveal.active && disc.value == 0 && reveal.value == 0 {
