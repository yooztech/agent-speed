diff --git a/macos/Sources/AgentSpeed/App/QuotaController.swift b/macos/Sources/AgentSpeed/App/QuotaController.swift
new file mode 100644
index 00000000..f3d016b0
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaController.swift
@@ -0,0 +1,212 @@
+import AgentSpeedCore
+import Foundation
+import Observation
+
+/// App-lifetime readers poll independently of settings/flyout visibility.
+@MainActor @Observable
+final class QuotaController {
+    private final class Reader {
+        let provider: any QuotaProvider
+        var snapshot: QuotaSnapshot?
+        var task: Task<Void, Never>?
+        var cancellation: Task<Void, Never>?
+        var generation = 0
+        var busy = false
+        init(_ provider: any QuotaProvider) { self.provider = provider }
+    }
+
+    private let providers: [any QuotaProvider]
+    private let defaults: UserDefaults
+    private var readers: [String: Reader] = [:]
+    private var cancellations: [String: Task<Void, Never>] = [:]
+    private var startupAttempted: Set<String> = []
+    private let scheduler: any QuotaRefreshScheduling
+    private var updatingPreferences = false
+    private let refreshInterval: TimeInterval
+    private(set) var snapshots: [QuotaSnapshot] = []
+    private(set) var isRefreshing = false
+    private(set) var networkEnabled = false
+
+    var autoRefreshEnabled: Bool {
+        didSet {
+            defaults.set(autoRefreshEnabled, forKey: "quota.autoRefreshEnabled")
+            updateTimer()
+            if autoRefreshEnabled && !oldValue { refreshAutomatically() }
+        }
+    }
+    var allSourcesEnabled: Bool {
+        didSet {
+            guard !updatingPreferences else { return }
+            defaults.set(allSourcesEnabled, forKey: "quota.allSourcesEnabled")
+            if allSourcesEnabled || oldValue {
+                updatingPreferences = true
+                enabledProviderIDs = Set(providers.map(\.id))
+                updatingPreferences = false
+                defaults.set(enabledProviderIDs.sorted(), forKey: "quota.enabledProviderIDs")
+            }
+            reconcileSources()
+        }
+    }
+    var enabledProviderIDs: Set<String> {
+        didSet {
+            guard !updatingPreferences else { return }
+            updatingPreferences = true
+            enabledProviderIDs.formIntersection(Set(providers.map(\.id)))
+            allSourcesEnabled = false
+            updatingPreferences = false
+            defaults.set(false, forKey: "quota.allSourcesEnabled")
+            defaults.set(enabledProviderIDs.sorted(), forKey: "quota.enabledProviderIDs")
+            reconcileSources()
+        }
+    }
+    var keepExpanded: Bool {
+        didSet { defaults.set(keepExpanded, forKey: "quota.keepExpanded") }
+    }
+    var floatingVisible: Bool {
+        didSet { defaults.set(floatingVisible, forKey: "quota.floatingVisible") }
+    }
+
+    init(defaults: UserDefaults = .standard, providers: [any QuotaProvider] = QuotaProviderRegistry.makeProviders(),
+         refreshInterval: TimeInterval = 300, scheduler: any QuotaRefreshScheduling = QuotaRefreshScheduler()) {
+        self.defaults = defaults
+        self.providers = providers
+        self.refreshInterval = refreshInterval
+        self.scheduler = scheduler
+        floatingVisible = defaults.object(forKey: "quota.floatingVisible") as? Bool ?? true
+        keepExpanded = defaults.object(forKey: "quota.keepExpanded") as? Bool ?? false
+        autoRefreshEnabled = defaults.object(forKey: "quota.autoRefreshEnabled") as? Bool ?? true
+        let allSources = defaults.object(forKey: "quota.allSourcesEnabled") as? Bool ?? true
+        allSourcesEnabled = allSources
+        let supported = Set(providers.map(\.id))
+        enabledProviderIDs = allSources ? supported : Set(defaults.stringArray(forKey: "quota.enabledProviderIDs") ?? Array(supported)).intersection(supported)
+        // This runs on the real AppModel init path, before network consent is applied.
+        reconcileSources()
+    }
+
+    func setNetworkEnabled(_ enabled: Bool) {
+        guard networkEnabled != enabled else { return }
+        networkEnabled = enabled
+        for reader in readers.values {
+            stop(reader)
+            load(reader)
+        }
+        collectSnapshots()
+        updateTimer()
+        if enabled { refreshStartupOrAutomatically() }
+    }
+
+    /// A user action, independent of the automatic-refresh preference.
+    func refresh() {
+        guard networkEnabled else { return }
+        for reader in readers.values { start(reader, startup: false) }
+    }
+
+    /// Capture current work before changing sources or consent, then await its completion.
+    /// A removed reader's cancelled task may still be returning from a provider.
+    func operationBarrier() -> Task<Void, Never> {
+        let tasks = readers.values.compactMap(\.task) + Array(cancellations.values)
+        return Task {
+            for task in tasks { await task.value }
+        }
+    }
+
+    private func reconcileSources() {
+        let enabled = allSourcesEnabled ? Set(providers.map(\.id)) : enabledProviderIDs
+        var added = false
+        for id in Array(readers.keys) where !enabled.contains(id) {
+            if let reader = readers.removeValue(forKey: id) { stop(reader) }
+        }
+        for provider in providers where enabled.contains(provider.id) && readers[provider.id] == nil {
+            let reader = Reader(provider)
+            reader.cancellation = cancellations[provider.id]
+            added = true
+            readers[provider.id] = reader
+            load(reader)
+        }
+        collectSnapshots()
+        updateTimer()
+        if added { refreshStartupOrAutomatically() }
+    }
+
+    private func stop(_ reader: Reader) {
+        reader.generation += 1
+        reader.task?.cancel()
+        reader.task = nil
+        reader.busy = false
+        let previous = cancellations[reader.provider.id]
+        let provider = reader.provider
+        reader.cancellation = Task {
+            await previous?.value
+            await provider.cancel()
+        }
+        cancellations[reader.provider.id] = reader.cancellation
+    }
+
+    private func load(_ reader: Reader) {
+        let generation = reader.generation
+        let cancellation = reader.cancellation
+        reader.task = Task { [weak self, weak reader] in
+            await cancellation?.value
+            guard let reader, !Task.isCancelled else { return }
+            let snapshot = await reader.provider.readCachedSnapshot()
+            guard let self, self.isCurrent(reader, generation: generation), !Task.isCancelled else { return }
+            reader.snapshot = snapshot
+            self.collectSnapshots()
+        }
+    }
+
+    private func refreshStartupOrAutomatically() {
+        guard networkEnabled else { return }
+        for reader in readers.values {
+            if !startupAttempted.contains(reader.provider.id) { start(reader, startup: true) }
+            else if autoRefreshEnabled { start(reader, startup: false) }
+        }
+    }
+
+    private func refreshAutomatically() {
+        if autoRefreshEnabled { refresh() }
+    }
+
+    private func start(_ reader: Reader, startup: Bool) {
+        guard networkEnabled, !reader.busy else { return }
+        if startup { startupAttempted.insert(reader.provider.id) }
+        // Supersede a cache-only load without allowing its late result to overwrite a live read.
+        reader.generation += 1
+        reader.task?.cancel()
+        let generation = reader.generation
+        let cancellation = reader.cancellation
+        reader.busy = true
+        collectSnapshots()
+        reader.task = Task { [weak self, weak reader] in
+            await cancellation?.value
+            guard let reader, !Task.isCancelled else { return }
+            let cached = await reader.provider.readCachedSnapshot()
+            guard let self, self.isCurrent(reader, generation: generation), self.networkEnabled, !Task.isCancelled else { return }
+            reader.snapshot = cached
+            self.collectSnapshots()
+            let result = await (startup ? reader.provider.refreshStartup() : reader.provider.refresh())
+            guard self.isCurrent(reader, generation: generation), self.networkEnabled, !Task.isCancelled else { return }
+            reader.snapshot = result
+            reader.busy = false
+            reader.task = nil
+            self.collectSnapshots()
+        }
+    }
+
+    private func isCurrent(_ reader: Reader, generation: Int) -> Bool {
+        reader.generation == generation && readers[reader.provider.id] === reader
+    }
+
+    private func collectSnapshots() {
+        snapshots = providers.compactMap { readers[$0.id]?.snapshot }
+        isRefreshing = readers.values.contains { $0.busy }
+    }
+
+    private func updateTimer() {
+        scheduler.stop()
+        guard networkEnabled, autoRefreshEnabled, !readers.isEmpty else { return }
+        scheduler.start(every: refreshInterval) { [weak self] in
+            self?.refreshAutomatically()
+        }
+    }
+}
