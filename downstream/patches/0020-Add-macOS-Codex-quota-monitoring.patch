+        let l10n = model.l10n
+        Form {
+            Section {
+                SettingToggle(title: l10n("mac.quota.show"), subtitle: l10n("mac.quota.hint"), isOn: $quota.visible)
+                HStack {
+                    if !quota.networkEnabled { Footnote(l10n("mac.quota.offline")) }
+                    Spacer()
+                    if quota.isRefreshing { ProgressView().controlSize(.small) }
+                    Button(l10n("mac.quota.refresh")) { quota.refresh() }
+                        .disabled(!quota.networkEnabled || quota.isRefreshing)
+                }
+            }
+            if quota.snapshots.isEmpty {
+                Section { Footnote(l10n("mac.quota.empty")) }
+            }
+            ForEach(quota.snapshots, id: \.id) { account in
+                Section(account.displayName) {
+                    LabeledContent(l10n("mac.quota.title"), value: quotaStatus(account, l10n))
+                    if let value = account.account { LabeledContent(l10n("mac.quota.account"), value: value) }
+                    if let value = account.plan { LabeledContent(l10n("mac.quota.plan"), value: value) }
+                    LabeledContent(l10n("mac.quota.source"), value: account.source)
+                    LabeledContent(l10n("mac.quota.fidelity"), value: l10n("mac.quota.fidelity.\(account.fidelity)"))
+                    if let value = account.block { LabeledContent(l10n("mac.quota.block"), value: value) }
+                    if let value = account.observedAt { LabeledContent(l10n("mac.quota.observed"), value: quotaDate(value, locale: l10n.locale)) }
+                    if let value = account.nextAllowedAt { LabeledContent(l10n("mac.quota.next"), value: quotaDate(value, locale: l10n.locale)) }
+                    if let credits = account.credits {
+                        if let value = credits.limit { LabeledContent(l10n("mac.quota.creditsLimit"), value: value.formatted(.number.locale(l10n.locale))) }
+                        if let value = credits.used { Text(l10n("mac.quota.used", value.formatted(.number.locale(l10n.locale)))) }
+                        if let value = credits.usedFraction { Text(l10n("mac.quota.used", quotaPercent(value, locale: l10n.locale))) }
+                        if let value = credits.resetAt { Text(l10n("mac.quota.reset", quotaDate(value, locale: l10n.locale))) }
+                        LabeledContent(l10n("mac.quota.credits"), value: credits.unlimited == true ? l10n("mac.quota.unlimited") : (credits.balance ?? (credits.hasCredits.map { l10n($0 ? "mac.quota.yes" : "mac.quota.no") } ?? l10n("mac.quota.unknown"))))
+                    }
+                    ForEach(account.windows, id: \.id) { window in
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(window.label).fontWeight(.semibold)
+                            if let used = window.usedFraction ?? window.used { Text(l10n("mac.quota.used", quotaPercent(used, locale: l10n.locale))) }
+                            if let remaining = window.remaining { Text(l10n("mac.quota.remaining", quotaPercent(remaining, locale: l10n.locale))) }
+                            if let reset = window.resetAt { Text(l10n("mac.quota.reset", quotaDate(reset, locale: l10n.locale))) }
+                            if let duration = window.duration { LabeledContent(l10n("mac.quota.duration"), value: Duration.seconds(duration).formatted(.units(allowed: [.days, .hours, .minutes], width: .abbreviated).locale(l10n.locale))) }
+                        }
+                    }
+                }
+            }
+        }
+        .settingsForm()
+        .onChange(of: quota.networkEnabled) { _, enabled in if enabled { quota.refresh() } }
+        .onAppear { quota.refresh() }
+    }
+}
+
+func quotaDate(_ date: Date, locale: Locale) -> String {
+    date.formatted(Date.FormatStyle(date: .abbreviated, time: .shortened).locale(locale))
+}
+
+func quotaPercent(_ fraction: Double, locale: Locale) -> String {
+    fraction.formatted(.percent.precision(.fractionLength(0)).locale(locale))
+}
+
+@MainActor func quotaStatus(_ account: CodexQuotaSnapshot, _ l10n: Localizer) -> String {
+    if account.waitingForRefresh { return l10n("mac.quota.status.waiting") }
+    return switch account.status {
+    case .ok: l10n("mac.quota.status.ok")
+    case .stale: l10n("mac.quota.status.stale")
+    case .needsAuth: l10n("mac.quota.status.needsAuth")
+    case .accessDenied: l10n("mac.quota.status.accessDenied")
+    case .unsupported: l10n("mac.quota.status.unsupported")
+    case .error: l10n("mac.quota.status.error")
+    }
+}
