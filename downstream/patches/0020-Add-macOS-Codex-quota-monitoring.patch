+        return (CGPoint(x: moved.x + CGFloat(index % 3 - 1) * pitch, y: moved.y + CGFloat(index / 3 * 2 - 1) * pitch / 2), radius)
+    }
+
+    static func drops(_ center: CGPoint, frame: QuotaGripFrame) -> (shape: QuotaOrbShape, hit: QuotaGripFootprint) {
+        let t = min(max(frame.reveal, 0), 1), blur = 2.7 * (1 - quotaSmooth((t - 0.42) / 0.36))
+        let liquid = t > 0.01 && blur > 0.27
+        let moved = CGPoint(x: center.x, y: center.y + 8 * quotaSmooth(t / 0.6) + 1.44 * sin(.pi * min(t / 0.8, 1)))
+        var source = QuotaGripFootprint(), box = CGRect.null
+        let core = liquid ? NotchLayout.discRadius * 0.55 * quotaSmooth(t / 0.15) * (1 - quotaSmooth(t / 0.7)) : 0
+        if core > 0 { source.addEllipse(in: CGRect(x: center.x - core, y: center.y - core, width: core * 2, height: core * 2)) }
+        let neck = 20.5 * 0.55 * (1 - quotaSmooth((t - 0.25) / 0.35))
+        if liquid && neck > 0.45 { source = source.union(strand(center, moved, basis: 20.5 * 0.4, pinch: neck / 2, top: 20.5 * 0.25)) }
+        for index in 0..<6 {
+            let dot = drop(center, frame: frame, index: index)
+            let rect = CGRect(x: dot.center.x - dot.radius, y: dot.center.y - dot.radius, width: dot.radius * 2, height: dot.radius * 2)
+            source = source.union(QuotaGripFootprint(.ellipse(rect))); box = box.union(rect)
+        }
+        var hit = QuotaGripFootprint()
+        if t > 0.01 {
+            hit.addRect(box.insetBy(dx: -2.5, dy: -2.5))
+            hit.addRect(CGRect(x: center.x - 4, y: center.y - 0.5, width: 8, height: max(0, box.maxY + 3 - center.y)))
+        }
+        return (QuotaOrbShape(source: source, blur: blur, liquid: liquid), hit)
+    }
+    static func routes(_ center: CGPoint, frame: QuotaGripFrame) -> QuotaGripFootprint {
+        guard frame.arc > 0.001 || frame.disc > 0.001 || frame.reveal > 0.01 else { return QuotaGripFootprint() }
+        let from = into(center, NotchLayout.curlRadius + 1)
+        let to = frame.disc > 0.001 || frame.reveal > 0.01 ? center : into(center, NotchLayout.arcRadius - (NotchLayout.arcFill + 2) / 2)
+        var path = strand(from, to, basis: 4, pinch: 4, top: 4)
+        if frame.disc > 0.001 || frame.reveal > 0.01 {
