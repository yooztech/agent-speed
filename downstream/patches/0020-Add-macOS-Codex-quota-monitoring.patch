+            let p = 1 - min(max(frame.disc, 0), 1)
+            if p <= 0.001 { return QuotaOrbShape(source: QuotaGripFootprint(.ellipse(CGRect(x: center.x - radius + 0.5, y: center.y - radius + 0.5, width: 2 * radius - 1, height: 2 * radius - 1)))) }
+            let half = max(0.004, 0.5 * quotaSmooth((p - 0.08) / 0.82))
