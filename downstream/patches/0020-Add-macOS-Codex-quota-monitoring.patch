+import Foundation
+
+/// Upright measured content, independent of native paint and provider identity.
+struct QuotaNotchCellMetrics {
+    let width: CGFloat
+    let readingHeight: CGFloat
+    let diameter: CGFloat
+    var size: CGSize { CGSize(width: max(diameter, width), height: diameter + QuotaNotchContentLayout.readingGap + readingHeight) }
+}
+
+/// Cached when readings change; animation only projects these offsets onto the current body.
+struct QuotaNotchContentLayout {
+    static let padding: CGFloat = 8
+    static let cellGap: CGFloat = 8
+    static let readingGap: CGFloat = 4
+    let cells: [QuotaNotchCellMetrics]
+    let horizontal: Bool
+    let offsets: [CGFloat]
+    let length: CGFloat
+    let depth: CGFloat
+
+    init(cells: [QuotaNotchCellMetrics], horizontal: Bool) {
+        self.cells = cells; self.horizontal = horizontal
+        var offsets: [CGFloat] = []
+        offsets.reserveCapacity(cells.count)
+        var along = Self.padding, width: CGFloat = 52, diameter: CGFloat = 52, readingHeight: CGFloat = 20
+        for cell in cells {
+            offsets.append(along)
+            along += (horizontal ? cell.size.width : cell.size.height) + Self.cellGap
+            width = max(width, cell.size.width)
+            diameter = max(diameter, cell.diameter)
+            readingHeight = max(readingHeight, cell.readingHeight)
+        }
+        self.offsets = offsets
+        length = max(80, cells.isEmpty ? 2 * Self.padding : along - Self.cellGap + Self.padding)
+        // Keep ring and reading extents intact; trim only the vertical-edge side insets.
+        depth = horizontal ? max(98, max(80, diameter + Self.readingGap + readingHeight) + 18) : max(70, width + 8)
+    }
+
+    func center(index: Int, bodyStart: CGFloat, bodyDepth: CGFloat, bottom: Bool) -> CGPoint {
+        let cell = cells[index]
+        let x = horizontal ? (bottom ? bodyDepth - 6 - cell.diameter / 2 : 6 + cell.diameter / 2) : bodyDepth / 2
+        return CGPoint(x: x, y: bodyStart + offsets[index] + (horizontal ? cell.size.width : cell.diameter) / 2)
+    }
+}
diff --git a/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift b/macos/Sources/AgentSpeed/App/QuotaNotchShape.swift
