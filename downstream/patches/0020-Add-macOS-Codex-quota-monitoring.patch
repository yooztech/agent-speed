+        bodyCenterAlong = NotchLayout.curlRadius + length / 2 + 0.5
+        size = horizontal ? CGSize(width: ceil(envelopeLength), height: ceil(envelopeDepth))
+            : CGSize(width: ceil(envelopeDepth), height: ceil(envelopeLength))
