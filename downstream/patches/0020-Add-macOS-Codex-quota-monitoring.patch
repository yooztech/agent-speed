+        let result = await codex(auth, suite: suite, fixture: fixture).refresh()
+        #expect(result.status == .ok)
+        #expect(result.resetCreditsAvailable == nil)
+        #expect(result.nextAllowedAt == fixture.now().addingTimeInterval(900))
+        try writeCodex(auth, token: "rotated-token")
