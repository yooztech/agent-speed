+// These are the macOS Design/NotchLayout/Palette/Typography measurements,
+// not the independently sized Windows implementation.
+enum NotchEdge: String, CaseIterable {
+    case right, left, top, bottom
+    var isVertical: Bool { self == .right || self == .left }
+    var outward: CGPoint {
+        switch self {
+        case .right: CGPoint(x: 1, y: 0)
+        case .left: CGPoint(x: -1, y: 0)
+        case .top: CGPoint(x: 0, y: -1)
+        case .bottom: CGPoint(x: 0, y: 1)
+        }
+    }
+}
+
+enum NotchLayout {
+    static let scale: CGFloat = 44.0 / 117.0
+    static func px(_ pixels: CGFloat) -> CGFloat { pixels * scale }
+    static func fontSize(_ capPixels: CGFloat) -> CGFloat { px(capPixels) / 0.714 }
+    static let curlRadius = px(103)
+    static let cornerRadius = px(78.8)
+    static let sideBodyDepth = px(186)
+    static let padTop = px(69.5)
+    static let padBottom = px(50.1)
+    static let pillWidth = px(26)
+    static let pillHeight = px(210)
+    static let pillHotZone = px(90)
+    static let ringDiameter = px(117)
+    static let trackStroke = px(15.5)
+    static let progressStroke = px(8)
+    static let glyphSize = px(46)
+    static let ringLabelGap = px(26.9)
+    static let orbDiameter = px(124)
+    static let orbStroke = px(18)
+    static let orbGap = px(27)
+    static let orbClearance = px(39)
+    static let orbGlyph = px(56)
+    static let orbHotZone = px(152)
+    static var orbArcRadius: CGFloat { curlRadius - orbGap }
+    static let cardWidth = px(600)
+    static let cardCorner = px(49.5)
+    static let cardPadding = px(32)
+    static let tailLength = px(75)
+    static let tailHeight = px(87)
+    static let tailGap = px(28)
+    static let barHeight = px(10.5).rounded()
+    static let headerGap = px(17)
+    static let headerToBlock = px(21)
+    static let labelToBar = px(16.8)
+    static let barToUsed = px(17.8)
+    static let blockSpacing = px(20)
+    static let secondary = Color(white: 128.0 / 255.0)
+    static let ringTrack = Color.white.opacity(0.188)
+    static let barTrack = Color.white.opacity(0.176)
+    static let percent = Font.system(size: fontSize(27), weight: .semibold)
+    static let cardTitle = Font.system(size: fontSize(26), weight: .semibold)
+    static let cardBody = Font.system(size: fontSize(18), weight: .regular)
+    static let percentLineHeight = lineHeight(NSFont.systemFont(ofSize: fontSize(27), weight: .semibold))
+    static let titleLineHeight = lineHeight(NSFont.systemFont(ofSize: fontSize(26), weight: .semibold))
+    static let bodyFont = NSFont.systemFont(ofSize: fontSize(18), weight: .regular)
+    static let bodyLineHeight = lineHeight(bodyFont)
+    static var cellExtent: CGFloat { ringDiameter + ringLabelGap + percentLineHeight }
+    static var ringMargin: CGFloat { (sideBodyDepth - ringDiameter) / 2 }
+
+    static func bodyDepth(for edge: NotchEdge) -> CGFloat {
+        edge.isVertical ? sideBodyDepth : 2 * ringMargin + cellExtent
+    }
+
+    static func shapeLength(for edge: NotchEdge) -> CGFloat {
+        padTop + padBottom + (edge.isVertical ? cellExtent : ringDiameter) + 2 * curlRadius
+    }
+
+    static func ringAlong(for edge: NotchEdge) -> CGFloat {
+        curlRadius + (edge.isVertical ? padTop : (padTop + padBottom) / 2) + ringDiameter / 2
+    }
+
+    static func accent(_ used: Double, blocked: Bool = false) -> Color {
+        if blocked || used >= 0.7 { return Color(red: 1, green: 63.0 / 255, blue: 0) }
+        if used >= 0.5 { return Color(red: 242.0 / 255, green: 1, blue: 0) }
+        return Color(red: 0, green: 1, blue: 136.0 / 255)
+    }
+
+    static func textHeight(_ text: String) -> CGFloat {
+        max(bodyLineHeight, ceil((text as NSString).boundingRect(
+            with: CGSize(width: cardWidth - 2 * cardPadding, height: .greatestFiniteMagnitude),
+            options: [.usesLineFragmentOrigin, .usesFontLeading], attributes: [.font: bodyFont]).height))
+    }
+
+    private static func lineHeight(_ font: NSFont) -> CGFloat {
+        ceil(font.ascender - font.descender + font.leading)
+    }
+}
+
+/// A real provider reading, separate from AppModel so the native renderer can
+/// be exercised offscreen without injecting fixtures into the running app.
+@MainActor
+struct QuotaNotchReading {
+    let snapshot: CodexQuotaSnapshot?
+    let networkEnabled: Bool
+    let l10n: Localizer
+
+    var headline: CodexQuotaWindow? {
+        guard let snapshot else { return nil }
+        return snapshot.windows.first(where: { $0.id == snapshot.headlineId }) ?? snapshot.windows.first
+    }
+    var fraction: Double? { headline?.usedFraction }
+    var stale: Bool { !networkEnabled || snapshot?.status == .stale || fraction == nil }
+    var observationDate: Date? { stale ? snapshot?.observedAt : nil }
+    var percentage: String { fraction.map { quotaPercent($0, locale: l10n.locale) } ?? "—" }
+    var status: String? {
+        guard networkEnabled else { return l10n("mac.quota.offline") }
+        guard let snapshot else { return l10n("mac.quota.empty") }
+        return snapshot.status == .ok && !snapshot.waitingForRefresh ? nil : quotaStatus(snapshot, l10n)
+    }
+
+    func resetText(_ date: Date, now: Date, calendar: Calendar = .current) -> String {
+        let seconds = date.timeIntervalSince(now)
+        guard seconds > 0 else { return l10n("mac.quota.resetting") }
+        let wholeSeconds = Int(seconds.rounded())
+        if wholeSeconds < 60 {
+            return l10n("mac.quota.resetSeconds", max(1, wholeSeconds).formatted(.number.locale(l10n.locale)))
+        }
+        let minutes = Int((seconds / 60).rounded())
+        if minutes < 60 {
+            return l10n("mac.quota.resetMinutes", max(1, minutes).formatted(.number.locale(l10n.locale)))
+        }
+        let days = calendar.dateComponents([.day], from: calendar.startOfDay(for: now),
+                                           to: calendar.startOfDay(for: date)).day ?? 0
+        let formatter = DateFormatter()
+        formatter.locale = l10n.locale
+        formatter.calendar = calendar
+        formatter.setLocalizedDateFormatFromTemplate(days >= 7 ? "MMM d" : "E j:mm")
+        return l10n("mac.quota.reset", formatter.string(from: date))
+    }
+    var cardHeight: CGFloat {
+        var height = 2 * NotchLayout.cardPadding + max(NotchLayout.glyphSize, NotchLayout.titleLineHeight)
+        if snapshot?.plan != nil { height += NotchLayout.bodyLineHeight }
+        if let block = snapshot?.block { height += NotchLayout.headerToBlock + NotchLayout.textHeight(block) }
+        if let status { height += NotchLayout.headerToBlock + NotchLayout.textHeight(status) }
+        for (index, window) in (snapshot?.windows ?? []).enumerated() {
+            height += index == 0 ? NotchLayout.headerToBlock : NotchLayout.blockSpacing
+            height += 2 * NotchLayout.bodyLineHeight + NotchLayout.barToUsed
+            if window.usedFraction != nil { height += NotchLayout.labelToBar + NotchLayout.barHeight }
+        }
+        return height
+    }
+}
