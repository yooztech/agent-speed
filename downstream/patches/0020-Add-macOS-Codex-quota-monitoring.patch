+import Foundation
+import Testing
+@testable import AgentSpeedCore
+
+@Suite("Source-neutral quota windows")
+struct QuotaTests {
+    private func window(_ id: String, _ duration: TimeInterval?, used: Double? = nil) -> QuotaWindow {
+        QuotaWindow(id: id, label: id, usedFraction: used, remaining: used.map { 1 - $0 }, used: used,
+                    resetAt: nil, duration: duration)
+    }
+
+    @Test func longestDurationIsOuterRegardlessOfSlotsAndUnknownScopesAreRetained() {
+        let windows = [window("short", 18_000), window("unknown-z", nil), window("long", 2_678_400),
+                       window("week", 604_800), window("unknown-a", 0), window("extra", 604_800)]
+        let expected = ["long", "extra", "week", "short", "unknown-a", "unknown-z"]
+        #expect(QuotaWindow.ordered(windows).map(\.id) == expected)
+        #expect(QuotaWindow.ordered(Array(windows.reversed())).map(\.id) == expected)
+        #expect(QuotaWindow.ordered(windows).count == windows.count)
+        #expect(window("unknown-z", nil).remainingFraction == nil)
+    }
+
+    @Test func periodIdentityAndExactPercentNeverDependOnArrayPositionOrWarningState() {
+        #expect(window("any", 2_419_200).period == .month)
+        #expect(window("any", 604_800).period == .week)
+        #expect(window("any", 18_000).period == .fiveHours)
+        #expect(window("monthly", nil).period == .month)
+        #expect(window("monthly", 18_000).period == .fiveHours)
+        #expect(window("scope:MONTH", nil).period == .month)
+        #expect(window("scope:week", 0).period == .week)
+        #expect(window("scope:session", nil).period == .fiveHours)
+        #expect(window("scope:5h", nil).periodDuration == 18_000)
+        #expect(QuotaWindow.ordered([window("rolling", nil), window("month", nil), window("week", nil)]).map(\.id) == ["month", "week", "rolling"])
+        #expect(window("unknown", nil).period == .other)
+        #expect(window("known-zero", 0).duration == 0)
+        #expect(window("unused", 18_000, used: 0).remainingFraction == 1)
+        #expect(window("exhausted", 18_000, used: 1).remainingFraction == 0)
+        #expect(window("overused", 18_000, used: 1.25).remainingFraction == -0.25)
+        #expect(window("invalid", 18_000, used: .nan).remainingFraction == nil)
+    }
+
+    @Test func codexRetainsAdditionalSlotsAndRepeatedScopesWithoutDuplicateIdentifiers() throws {
+        let data = Data(#"{"rate_limit":{"tertiary_window":{"used_percent":17,"limit_window_seconds":2592000}},"additional_rate_limits":[{"metered_feature":"spark","rate_limit":{"primary_window":{"used_percent":0,"limit_window_seconds":18000}}},{"metered_feature":"spark","rate_limit":{"primary_window":{"used_percent":20,"limit_window_seconds":18000}}},{"metered_feature":"spark","rate_limit":{"primary_window":{"used_percent":40,"limit_window_seconds":18000}}}]}"#.utf8)
+        let value = try CodexQuotaProvider.parse(data, at: Date())
+        #expect(value.windows.count == 4)
+        #expect(Set(value.windows.map(\.id)).count == 4)
+        #expect(QuotaWindow.ordered(value.windows).first?.duration == 2_592_000)
+    }
+}
