+struct QuotaNotchView: View {
+    let readings: [QuotaNotchReading]
+    let geometry: QuotaNotchGeometry
+    let grip: QuotaGripPaint
+    let dark: Bool
+
+    var body: some View {
+        let fill = dark ? Color.black : Color(red: 245 / 255, green: 245 / 255, blue: 247 / 255)
+        let edge = dark ? Color(white: 46 / 255) : Color(red: 210 / 255, green: 210 / 255, blue: 215 / 255)
+        ZStack(alignment: .topLeading) {
+            geometry.bodyPath.fill(geometry.expansion == 0 ? .black : fill)
+            if geometry.expansion > 0 {
+                geometry.bodyPath.stroke(edge, lineWidth: 1)
+                ForEach(Array(readings.enumerated()), id: \.element.providerID) { index, reading in
+                    QuotaNotchCell(reading: reading, dark: dark)
+                        .position(x: geometry.centers[index].x, y: geometry.centers[index].y + reading.readingHeight / 2 + QuotaNotchContentLayout.readingGap / 2)
+                        .opacity(Double(geometry.expansion))
+                }
+                .mask(geometry.bodyPath.fill(.white))
+            }
+            ForEach(grip.layers.indices, id: \.self) { index in
+                switch grip.layers[index] {
+                case let .vector(footprint):
+                    ForEach(footprint.parts.indices, id: \.self) { part in
+                        QuotaGripVectorPart(part: footprint.parts[part], fill: fill, edge: edge)
+                    }
+                case let .raster(raster, clip):
+                    Image(decorative: raster.image, scale: 1)
+                        .resizable().interpolation(.none)
+                        .frame(width: raster.bounds.width, height: raster.bounds.height)
+                        .position(x: raster.bounds.midX, y: raster.bounds.midY)
+                        .frame(width: geometry.size.width, height: geometry.size.height)
+                        .clipShape(clip.parts[0].contour.path.applying(clip.parts[0].transform.affine))
+                }
+            }
+            ZStack(alignment: .topLeading) {
+                ForEach(grip.routes.parts.indices, id: \.self) { index in
+                    let part = grip.routes.parts[index]
+                    QuotaGripVectorPart(part: part, fill: .black, edge: .black, lineWidth: 0)
+                }
+            }.compositingGroup().opacity(1 / 255)
+        }
+        .frame(width: geometry.size.width, height: geometry.size.height)
+        .foregroundStyle(dark ? Color(red: 232 / 255, green: 232 / 255, blue: 234 / 255) : Color(red: 29 / 255, green: 29 / 255, blue: 31 / 255))
+        .allowsHitTesting(false)
+    }
+}
