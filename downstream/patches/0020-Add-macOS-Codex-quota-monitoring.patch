+import AgentSpeedCore
+import SwiftUI
+
+struct QuotaPane: View {
+    let model: AppModel
+
+    var body: some View {
+        let quota = model.quota
+        let l10n = model.l10n
+        Form {
+            if quota.snapshots.isEmpty {
+                Section { Footnote(l10n("mac.quota.empty")) }
+            }
+            ForEach(quota.snapshots, id: \.id) { account in
+                Section {
+                    HStack(alignment: .top, spacing: 16) {
+                        Text("CX")
+                            .font(.caption.weight(.bold))
+                            .frame(width: 30, height: 30)
+                            .background(.quaternary, in: RoundedRectangle(cornerRadius: 8))
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(account.displayName).font(.headline)
+                            Text(account.source).font(.caption).foregroundStyle(.secondary)
+                            Text(quotaStatus(account, l10n)).font(.caption2).foregroundStyle(.secondary)
+                            if account.status == .stale, let observed = account.observedAt {
+                                Text("\(l10n("mac.quota.observed")) · \(quotaAge(observed, locale: l10n.locale))")
+                                    .font(.caption2).foregroundStyle(.secondary)
+                            }
+                            if let block = account.block { Text(block).font(.caption2).foregroundStyle(.secondary) }
+                        }.frame(width: 105, alignment: .leading)
+                        VStack(alignment: .leading, spacing: 8) {
+                            ForEach(account.windows, id: \.id) { window in
+                                VStack(alignment: .leading, spacing: 4) {
+                                    HStack {
+                                        Text(quotaWindowLabel(window, l10n)).foregroundStyle(.secondary)
+                                        Spacer()
+                                        Text(window.usedFraction.map { quotaPercent($0, locale: l10n.locale) } ?? l10n("mac.quota.unknown")).monospacedDigit()
+                                    }.font(.caption)
+                                    if let used = window.usedFraction {
+                                        ProgressView(value: max(0, min(1, used))).tint(quotaAccent(used))
+                                    }
+                                    if let reset = window.resetAt {
+                                        Text(l10n("mac.quota.reset", quotaDate(reset, locale: l10n.locale))).font(.caption2).foregroundStyle(.secondary)
+                                    }
+                                }
+                            }
+                        }
+                        .opacity(account.status == .stale ? 0.6 : 1)
+                        if let plan = account.plan {
+                            Text(plan).font(.caption.weight(.semibold)).frame(width: 70, alignment: .trailing)
+                        }
+                    }
+                    .padding(10)
+                    .background(.quaternary.opacity(0.35), in: RoundedRectangle(cornerRadius: 10))
+                    DisclosureGroup(l10n("mac.quota.details")) {
+                    LabeledContent(l10n("mac.quota.title"), value: quotaStatus(account, l10n))
+                    if let value = account.plan { LabeledContent(l10n("mac.quota.plan"), value: value) }
+                    LabeledContent(l10n("mac.quota.source"), value: account.source)
+                    LabeledContent(l10n("mac.quota.fidelity"), value: l10n("mac.quota.fidelity.\(account.fidelity)"))
+                    if account.status == .stale, let observed = account.observedAt {
+                        LabeledContent(l10n("mac.quota.observed"), value: quotaAge(observed, locale: l10n.locale))
+                    }
+                    if let value = account.block { LabeledContent(l10n("mac.quota.block"), value: value) }
+                    ForEach(account.windows, id: \.id) { window in
+                        VStack(alignment: .leading, spacing: 6) {
+                            HStack {
+                                Text(quotaWindowLabel(window, l10n)).fontWeight(.semibold)
+                                Spacer()
+                                Text(window.usedFraction.map { quotaPercent($0, locale: l10n.locale) } ?? l10n("mac.quota.unknown"))
+                                    .monospacedDigit()
+                            }
+                            if let used = window.usedFraction {
+                                ProgressView(value: max(0, min(1, used)))
+                                    .tint(quotaAccent(used))
+                                HStack {
+                                    Text(l10n("mac.quota.used", quotaPercent(used, locale: l10n.locale)))
+                                    if let remaining = window.remaining { Text("· " + l10n("mac.quota.remaining", quotaPercent(remaining, locale: l10n.locale))) }
+                                }.font(.caption).foregroundStyle(.secondary)
+                            }
+                            if let reset = window.resetAt {
+                                Text(l10n("mac.quota.reset", quotaDate(reset, locale: l10n.locale)))
+                                    .font(.caption).foregroundStyle(.secondary)
+                            }
+                        }
+                        .padding(10)
+                        .background(.quaternary.opacity(0.35), in: RoundedRectangle(cornerRadius: 10))
+                        .opacity(account.status == .stale ? 0.6 : 1)
+                    }
+                    DisclosureGroup(l10n("mac.quota.diagnostics")) {
+                        if let value = account.account { LabeledContent(l10n("mac.quota.account"), value: value) }
+                        if let value = account.observedAt { LabeledContent(l10n("mac.quota.observed"), value: quotaDate(value, locale: l10n.locale)) }
+                        if let value = account.nextAllowedAt { LabeledContent(l10n("mac.quota.next"), value: quotaDate(value, locale: l10n.locale)) }
+                    }
+                    }
+                }
+                if let credits = account.credits {
+                    Section(l10n("mac.quota.credits")) {
+                        LabeledContent(l10n("mac.quota.credits"), value: credits.unlimited == true ? l10n("mac.quota.unlimited") : (credits.balance ?? (credits.hasCredits.map { l10n($0 ? "mac.quota.yes" : "mac.quota.no") } ?? l10n("mac.quota.unknown"))))
+                        if let value = credits.limit { LabeledContent(l10n("mac.quota.creditsLimit"), value: value.formatted(.number.locale(l10n.locale))) }
+                        if let value = credits.used { Text(l10n("mac.quota.used", value.formatted(.number.locale(l10n.locale)))) }
+                        if let value = credits.usedFraction { Text(l10n("mac.quota.used", quotaPercent(value, locale: l10n.locale))) }
+                        if let value = credits.resetAt { Text(l10n("mac.quota.reset", quotaDate(value, locale: l10n.locale))) }
+                    }
+                }
+            }
+            Section {
+                Toggle(l10n("mac.quota.floating"), isOn: Binding(get: { quota.floatingVisible }, set: { quota.floatingVisible = $0 }))
+                HStack {
+                    if !quota.networkEnabled { Footnote(l10n("mac.quota.offline")) }
+                    Spacer()
+                    if quota.isRefreshing { ProgressView().controlSize(.small) }
+                    Button(l10n("mac.quota.refresh")) { quota.refresh() }
+                        .disabled(!quota.networkEnabled || quota.isRefreshing)
+                }
+            }
+        }
+        .settingsForm()
+        .onChange(of: quota.networkEnabled) { _, enabled in if enabled { quota.refresh() } }
+        .onAppear { quota.refresh() }
+    }
+}
+
+func quotaAccent(_ used: Double) -> Color {
+    used >= 0.9 ? Color(red: 251 / 255, green: 191 / 255, blue: 36 / 255) :
+        Color(red: 91 / 255, green: 140 / 255, blue: 1)
+}
+
+func quotaAge(_ date: Date, locale: Locale) -> String {
+    let formatter = RelativeDateTimeFormatter()
+    formatter.locale = locale
+    formatter.unitsStyle = .full
+    return formatter.localizedString(for: date, relativeTo: Date())
+}
+
+@MainActor func quotaWindowLabel(_ window: CodexQuotaWindow, _ l10n: Localizer) -> String {
+    guard let duration = window.duration, duration > 0 else { return window.label }
+    let length = Duration.seconds(duration).formatted(.units(allowed: [.days, .hours, .minutes, .seconds], width: .abbreviated).locale(l10n.locale))
+    return window.label == "Codex" ? length : "\(window.label) · \(length)"
+}
+
+func quotaDate(_ date: Date, locale: Locale) -> String {
+    date.formatted(Date.FormatStyle(date: .abbreviated, time: .shortened).locale(locale))
+}
+
+func quotaPercent(_ fraction: Double, locale: Locale) -> String {
+    fraction.formatted(.percent.precision(.fractionLength(0)).locale(locale))
+}
+
+@MainActor func quotaStatus(_ account: CodexQuotaSnapshot, _ l10n: Localizer) -> String {
+    if account.waitingForRefresh { return l10n("mac.quota.status.waiting") }
+    return switch account.status {
+    case .ok: l10n("mac.quota.status.ok")
+    case .stale: l10n("mac.quota.status.stale")
+    case .needsAuth: l10n("mac.quota.status.needsAuth")
+    case .accessDenied: l10n("mac.quota.status.accessDenied")
+    case .unsupported: l10n("mac.quota.status.unsupported")
+    case .error: l10n("mac.quota.status.error")
+    }
+}
