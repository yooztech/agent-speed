+import Foundation
+import Testing
+@testable import AgentSpeedCore
+
+private final class QuotaFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    var time = Date(timeIntervalSince1970: 1_700_000_000)
+    var status = 200
+    var body = Data(#"{"rate_limit":{"primary_window":{"limit_window_seconds":18000,"used_percent":0}}}"#.utf8)
+    var retry: String?
+    var requests: [URLRequest] = []
+
+    func currentTime() -> Date { lock.lock(); defer { lock.unlock() }; return time }
+    func advance(_ seconds: TimeInterval) { lock.lock(); defer { lock.unlock() }; time.addTimeInterval(seconds) }
+    func setStatus(_ value: Int, retry: String? = nil) { lock.lock(); defer { lock.unlock() }; status = value; self.retry = retry }
+    func setBody(_ value: String) { lock.lock(); defer { lock.unlock() }; body = Data(value.utf8) }
+    func count() -> Int { lock.lock(); defer { lock.unlock() }; return requests.count }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.lock(); defer { lock.unlock() }
+        requests.append(request)
+        let headers = retry.map { ["Retry-After": $0] }
+        return (body, HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: headers)!)
+    }
+}
+
+@Suite("Codex quota")
+struct CodexQuotaProviderTests {
+    private func makeProvider(_ fixture: QuotaFixture, auth: String? = #"{"tokens":{"access_token":"secret-token","account_id":"account"}}"#) throws -> (CodexQuotaProvider, URL) {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        if let auth { try Data(auth.utf8).write(to: url) }
+        let defaults = UserDefaults(suiteName: UUID().uuidString)!
+        return (CodexQuotaProvider(credentialURL: url, defaults: defaults, now: { fixture.currentTime() }, transport: { request in fixture.fetch(request) }), url)
+    }
+
+    @Test func parsesWindowsCreditsAndUnknowns() throws {
+        let data = Data(#"{"plan_type":"plus","rate_limit":{"primary_window":{"limit_window_seconds":604800,"used_percent":0,"reset_after_seconds":30},"secondary_window":{"limit_window_seconds":18000,"used_percent":null,"reset_at":1700000100}},"additional_rate_limits":[{"metered_feature":"spark","rate_limit":{"primary_window":{"limit_window_seconds":18000,"used_percent":25}}}],"code_review_rate_limit":{"primary_window":{"used_percent":120}},"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"spend_control":{"individual_limit":{"limit":"100.5","used":"3","used_percent":3,"reset_at":1700000200}}}"#.utf8)
+        let now = Date(timeIntervalSince1970: 1_700_000_000)
+        let result = try CodexQuotaProvider.parse(data, at: now)
+        #expect(result.fidelity == "official")
+        #expect(!result.waitingForRefresh)
+        #expect(result.plan == "plus")
+        #expect(result.windows.count == 4)
+        #expect(result.windows[0].duration == 604800)
+        #expect(result.windows[0].usedFraction == 0)
+        #expect(result.windows[0].remaining == 1)
+        #expect(result.windows[0].resetAt == now.addingTimeInterval(30))
+        #expect(result.windows[1].usedFraction == nil)
+        #expect(result.windows[1].resetAt == now.addingTimeInterval(100))
+        #expect(result.windows[2].usedFraction == 0.25)
+        #expect(result.windows[3].usedFraction == 1.2)
+        #expect(result.credits?.hasCredits == false)
+        #expect(result.credits?.balance == "0")
+        #expect(result.credits?.limit == 100.5)
+        #expect(result.credits?.usedFraction == 0.03)
+    }
+
+    @Test func identityTracksDurationAndRetainsDuplicates() throws {
+        let a = Data(#"{"rate_limit":{"primary_window":{"limit_window_seconds":18000},"secondary_window":{"limit_window_seconds":604800}}}"#.utf8)
+        let b = Data(#"{"rate_limit":{"secondary_window":{"limit_window_seconds":18000},"primary_window":{"limit_window_seconds":604800}}}"#.utf8)
+        let first = try CodexQuotaProvider.parse(a, at: Date())
+        let second = try CodexQuotaProvider.parse(b, at: Date())
+        #expect(Set(first.windows.map(\.id)) == Set(second.windows.map(\.id)))
+        let duplicate = Data(#"{"rate_limit":{"primary_window":{"limit_window_seconds":18000},"secondary_window":{"limit_window_seconds":18000}}}"#.utf8)
+        let windows = try CodexQuotaProvider.parse(duplicate, at: Date()).windows
+        #expect(windows.count == 2)
+        #expect(Set(windows.map(\.id)).count == 2)
+    }
+
+    @Test func missingCredentialsNeverRequests() async throws {
+        let fixture = QuotaFixture()
+        let (provider, _) = try makeProvider(fixture, auth: nil)
+        #expect(await provider.refresh().status == .needsAuth)
+        #expect(fixture.count() == 0)
+    }
+
+    @Test func successThrottlesAndFailureIsStale() async throws {
+        let fixture = QuotaFixture()
+        let (provider, url) = try makeProvider(fixture)
+        defer { try? FileManager.default.removeItem(at: url) }
+        let first = await provider.refresh()
+        #expect(first.status == .ok)
+        #expect(first.fidelity == "official")
+        #expect(!first.waitingForRefresh)
+        #expect(first.nextAllowedAt == fixture.currentTime().addingTimeInterval(300))
+        #expect(await provider.refresh().status == .ok)
+        #expect(fixture.count() == 1)
+        fixture.advance(300)
+        fixture.setStatus(500)
+        let stale = await provider.refresh()
+        #expect(stale.status == .stale)
+        #expect(!stale.waitingForRefresh)
+        #expect(stale.windows == first.windows)
+    }
+
+    @Test func rateLimitBackoffAndAuthentication() async throws {
+        let fixture = QuotaFixture()
+        fixture.setStatus(429, retry: "120")
+        let (provider, url) = try makeProvider(fixture)
+        defer { try? FileManager.default.removeItem(at: url) }
+        let first = await provider.refresh()
+        #expect(first.status == .error)
+        #expect(first.observedAt == nil)
+        #expect(!first.waitingForRefresh)
+        #expect(first.windows.isEmpty)
+        #expect(first.nextAllowedAt == fixture.currentTime().addingTimeInterval(120))
+        let blocked = await provider.refresh()
+        #expect(blocked.status == .error)
+        #expect(!blocked.waitingForRefresh)
+        #expect(fixture.count() == 1)
+        fixture.advance(120)
+        fixture.setStatus(429)
+        let second = await provider.refresh()
+        #expect(second.status == .error)
+        #expect(second.nextAllowedAt == fixture.currentTime().addingTimeInterval(120))
+        fixture.advance(120)
+        fixture.setStatus(401)
+        #expect(await provider.refresh().status == .needsAuth)
+        _ = await provider.refresh()
+        #expect(fixture.count() == 3)
+        try Data(#"{"tokens":{"access_token":"new-secret","account_id":"account"}}"#.utf8).write(to: url)
+        fixture.setStatus(403)
+        #expect(await provider.refresh().status == .needsAuth)
+        #expect(fixture.count() == 4)
+    }
+
+    @Test func errorsWithoutObservationNeverBecomeStale() async throws {
+        let fixture = QuotaFixture()
+        fixture.setStatus(429)
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: url) }
+        try Data(#"{"tokens":{"access_token":"secret-token","account_id":"account"}}"#.utf8).write(to: url)
+        let provider = CodexQuotaProvider(credentialURL: url, defaults: UserDefaults(suiteName: UUID().uuidString)!, now: { fixture.currentTime() }, transport: { request in
+            let response = fixture.fetch(request)
+            if response.1.statusCode == 599 { throw URLError(.notConnectedToInternet) }
+            return response
+        })
+        #expect(await provider.refresh().status == .error)
+        fixture.advance(60)
+        fixture.setStatus(500)
+        #expect(await provider.refresh().status == .error)
+        fixture.setStatus(599)
+        #expect(await provider.refresh().status == .error)
+        fixture.setStatus(200)
+        fixture.setBody("invalid JSON")
+        #expect(await provider.refresh().status == .error)
+        fixture.advance(300)
+        #expect(await provider.refresh().status == .error)
+        fixture.advance(300)
+        fixture.setStatus(500)
+        let result = await provider.refresh()
+        #expect(result.status == .error)
+        #expect(result.observedAt == nil)
+    }
+
+    @Test func retryAfterSupportsHTTPDate() {
+        let now = Date(timeIntervalSince1970: 0)
+        #expect(CodexQuotaProvider.retryAfter("Thu, 01 Jan 1970 00:03:00 GMT", now: now) == 180)
+        #expect(CodexQuotaProvider.retryAfter("0", now: now) == 60)
+    }
+
+    @Test func concurrentRefreshesSharePolling() async throws {
+        let fixture = QuotaFixture()
+        let (provider, url) = try makeProvider(fixture)
+        defer { try? FileManager.default.removeItem(at: url) }
+        await withTaskGroup(of: CodexQuotaStatus.self) { group in
+            for _ in 0..<12 { group.addTask { await provider.refresh().status } }
+            for await status in group { #expect(status == .ok) }
+        }
+        #expect(fixture.count() == 1)
+    }
+
+    @Test func zeroAndExtraOnlyAreNotConfusedWithUnknown() throws {
+        let data = Data(#"{"additional_rate_limits":[null,{"metered_feature":"spark","rate_limit":{"primary_window":{"limit_window_seconds":0,"used_percent":0,"reset_at":0}}}]}"#.utf8)
+        let result = try CodexQuotaProvider.parse(data, at: Date())
+        #expect(result.headlineId == nil)
+        #expect(result.windows.count == 1)
+        #expect(result.windows[0].duration == 0)
+        #expect(result.windows[0].usedFraction == 0)
+        #expect(result.windows[0].resetAt == Date(timeIntervalSince1970: 0))
+    }
+
+    @Test func schedulePersistsWithoutCredentialsOrResponse() async throws {
+        let fixture = QuotaFixture()
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: url) }
+        try Data(#"{"tokens":{"access_token":"secret-token","account_id":"private-account"}}"#.utf8).write(to: url)
+        let suite = UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!
+        defer { defaults.removePersistentDomain(forName: suite) }
+        // Each provider owns its defaults instance; the suite shares only persisted values.
+        let first = CodexQuotaProvider(credentialURL: url, defaults: UserDefaults(suiteName: suite)!, now: { fixture.currentTime() }, transport: { fixture.fetch($0) })
+        _ = await first.refresh()
+        let persisted = defaults.dictionaryRepresentation().description
+        #expect(!persisted.contains("secret-token"))
+        #expect(!persisted.contains("private-account"))
+        #expect(!persisted.contains("used_percent"))
+        let second = CodexQuotaProvider(credentialURL: url, defaults: UserDefaults(suiteName: suite)!, now: { fixture.currentTime() }, transport: { fixture.fetch($0) })
+        let waiting = await second.refresh()
+        #expect(waiting.status == .error)
+        #expect(waiting.waitingForRefresh)
+        #expect(waiting.observedAt == nil)
+        #expect(waiting.nextAllowedAt == fixture.currentTime().addingTimeInterval(300))
+        #expect(fixture.count() == 1)
+        fixture.advance(300)
+        fixture.setStatus(429)
+        let failed = await second.refresh()
+        #expect(failed.status == .error)
+        #expect(!failed.waitingForRefresh)
+        let third = CodexQuotaProvider(credentialURL: url, defaults: UserDefaults(suiteName: suite)!, now: { fixture.currentTime() }, transport: { fixture.fetch($0) })
+        let backoff = await third.refresh()
+        #expect(backoff.status == .error)
+        #expect(!backoff.waitingForRefresh)
+        #expect(fixture.count() == 2)
+        fixture.advance(60)
+        fixture.setStatus(200)
+        fixture.setBody("invalid JSON")
+        #expect(!(await third.refresh()).waitingForRefresh)
+        let fourth = CodexQuotaProvider(credentialURL: url, defaults: UserDefaults(suiteName: suite)!, now: { fixture.currentTime() }, transport: { fixture.fetch($0) })
+        #expect(!(await fourth.refresh()).waitingForRefresh)
+        #expect(fixture.count() == 3)
+        fixture.advance(300)
+        fixture.setBody(#"{"rate_limit":{"primary_window":{"used_percent":10}}}"#)
+        let recovered = await fourth.refresh()
+        #expect(recovered.status == .ok)
+        #expect(!recovered.waitingForRefresh)
+    }
+
+}
