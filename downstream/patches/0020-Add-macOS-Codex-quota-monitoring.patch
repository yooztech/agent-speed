+import Foundation
+import Testing
+@testable import AgentSpeed
+@testable import AgentSpeedCore
+
+private actor ControllerQuotaProvider: QuotaProvider {
+    struct Request: Sendable, Equatable {
+        enum Kind: Sendable, Equatable { case startup, refresh }
+        let number: Int
+        let kind: Kind
+    }
+
+    nonisolated let id: String
+    nonisolated let requests: AsyncStream<Request>
+    private let events: AsyncStream<Request>.Continuation
+    private var manualRequests = 0
+    private var startupRequests = 0
+    private var cancellations = 0
+    private var pending: [Int: CheckedContinuation<QuotaSnapshot, Never>] = [:]
+    private var finished = false
+    private let observed = Date(timeIntervalSince1970: 1_800_000_000)
+
+    init(_ id: String) {
+        self.id = id
+        let stream = AsyncStream<Request>.makeStream()
+        requests = stream.stream
+        events = stream.continuation
+    }
+
+    func readCachedSnapshot() -> QuotaSnapshot { snapshot(.stale) }
+    func refreshStartup() async -> QuotaSnapshot {
+        startupRequests += 1
+        return await result(.startup)
+    }
+    func refresh() async -> QuotaSnapshot {
+        manualRequests += 1
+        return await result(.refresh)
+    }
+    // Deliberately leave responses held: cancellation is not a guarantee that a
+    // provider cannot return a late response. The controller must reject it.
+    func cancel() { cancellations += 1 }
+    func counts() -> (manual: Int, startup: Int, cancellations: Int) {
+        (manualRequests, startupRequests, cancellations)
+    }
+    func complete(_ request: Request, status: QuotaStatus = .ok) -> Bool {
+        guard let continuation = pending.removeValue(forKey: request.number) else { return false }
+        continuation.resume(returning: snapshot(status))
+        return true
+    }
+    func finish() {
+        finished = true
+        events.finish()
+        let continuations = pending.values
+        pending.removeAll()
+        for continuation in continuations { continuation.resume(returning: snapshot(.ok)) }
+    }
+    private func result(_ kind: Request.Kind) async -> QuotaSnapshot {
+        guard !finished else { return snapshot(.ok) }
+        let request = Request(number: startupRequests + manualRequests, kind: kind)
+        return await withCheckedContinuation {
+            pending[request.number] = $0
+            events.yield(request)
+        }
+    }
+    private func snapshot(_ status: QuotaStatus) -> QuotaSnapshot {
+        QuotaSnapshot(id: id, displayName: id, fidelity: "official", status: status,
+            windows: [QuotaWindow(id: "rolling", label: "", usedFraction: 0.25, remaining: 0.75,
+                used: 0.25, resetAt: nil, duration: 18_000)], headlineId: "rolling", block: nil,
+            account: nil, plan: nil, observedAt: observed, source: "fixture", credits: nil,
+            nextAllowedAt: nil, waitingForRefresh: false)
+    }
+}
+
+@MainActor
+private final class ControlledQuotaScheduler: QuotaRefreshScheduling {
+    private var tick: (@MainActor () -> Void)?
+    var isRunning: Bool { tick != nil }
+    func start(every interval: TimeInterval, tick: @escaping @MainActor () -> Void) { self.tick = tick }
+    func stop() { tick = nil }
+    func fire() { tick?() }
+}
+
+@MainActor
+private final class ControllerFixture {
+    let suite = UUID().uuidString
+    let defaults: UserDefaults
+    let providers: [ControllerQuotaProvider]
+    let scheduler = ControlledQuotaScheduler()
+    let controller: QuotaController
+    private var controllers: [QuotaController]
+    private var barriers: [Task<Void, Never>] = []
+    private var cleanup: Task<Void, Never>?
+
+    init(ids: [String], automatic: Bool) {
+        defaults = UserDefaults(suiteName: suite)!
+        defaults.set(automatic, forKey: "quota.autoRefreshEnabled")
+        providers = ids.map { ControllerQuotaProvider($0) }
+        controller = QuotaController(defaults: defaults, providers: providers, scheduler: scheduler)
+        controllers = [controller]
+    }
+
+    func restore() -> QuotaController {
+        let restored = QuotaController(defaults: defaults, providers: providers, scheduler: ControlledQuotaScheduler())
+        controllers.append(restored)
+        return restored
+    }
+
+    func request(_ provider: ControllerQuotaProvider, _ kind: ControllerQuotaProvider.Request.Kind) async throws -> ControllerQuotaProvider.Request {
+        var iterator = provider.requests.makeAsyncIterator()
+        let request = try #require(await iterator.next(), "\(provider.id): request stream ended before \(kind)")
+        try #require(request.kind == kind, "\(provider.id): expected \(kind), received \(request.kind)")
+        return request
+    }
+
+    /// Capture before removing a reader so its late response is also drained.
+    func barrier() -> Task<Void, Never> {
+        let operations = controllers.map { $0.operationBarrier() }
+        let barrier = Task { for operation in operations { await operation.value } }
+        barriers.append(barrier)
+        return barrier
+    }
+
+    func close() -> Task<Void, Never> {
+        if let cleanup { return cleanup }
+        _ = barrier()
+        for controller in controllers {
+            controller.setNetworkEnabled(false)
+            controller.enabledProviderIDs = []
+        }
+        _ = barrier()
+        let barriers = barriers
+        let cleanup = Task {
+            for provider in providers { await provider.finish() }
+            for barrier in barriers { await barrier.value }
+            defaults.removePersistentDomain(forName: suite)
+        }
+        self.cleanup = cleanup
+        return cleanup
+    }
+}
+
+@Suite("Quota controller lifecycle", .timeLimit(.minutes(1)))
+@MainActor
+struct QuotaControllerTests {
+    private func withFixture(ids: [String] = ["codex", "test-source"], automatic: Bool = false,
+                             _ body: @MainActor (ControllerFixture) async throws -> Void) async throws {
+        let fixture = ControllerFixture(ids: ids, automatic: automatic)
+        try await withTaskCancellationHandler {
+            do { try await body(fixture) }
+            catch {
+                await fixture.close().value
+                throw error
+            }
+            await fixture.close().value
+        } onCancel: {
+            Task { @MainActor in await fixture.close().value }
+        }
+    }
+
+    @Test func manualModeHydratesOfflineAndStartsExactlyOnceAcrossConsentAndSourceToggles() async throws {
+        try await withFixture { fixture in
+            let controller = fixture.controller
+            let codex = fixture.providers[0], go = fixture.providers[1]
+            await fixture.barrier().value
+            #expect(!controller.keepExpanded)
+            #expect(controller.snapshots.count == 2, "Both enabled accounts must hydrate without network consent")
+            #expect(controller.snapshots.allSatisfy { $0.status == .stale && $0.observedAt != nil })
+            #expect(await codex.counts().startup == 0)
+            #expect(await go.counts().manual == 0)
+            #expect(!fixture.scheduler.isRunning, "Offline mode must not schedule polls")
+
+            controller.setNetworkEnabled(true)
+            let codexStartup = try await fixture.request(codex, .startup)
+            let goStartup = try await fixture.request(go, .startup)
+            #expect(await codex.complete(codexStartup))
+            #expect(await go.complete(goStartup))
+            await fixture.barrier().value
+            #expect(!controller.isRefreshing)
+            #expect(!fixture.scheduler.isRunning, "Manual mode allows startup hydration, not periodic polls")
+
+            controller.setNetworkEnabled(false)
+            controller.setNetworkEnabled(true)
+            controller.enabledProviderIDs = ["codex"]
+            controller.enabledProviderIDs = ["codex", "test-source"]
+            await fixture.barrier().value
+            #expect(controller.snapshots.count == 2)
+            #expect(!controller.isRefreshing)
+            #expect(await codex.counts().startup == 1)
+            #expect(await go.counts().startup == 1)
+            #expect(await codex.counts().manual == 0)
+            #expect(await go.counts().manual == 0)
+
+            controller.refresh()
+            let codexManual = try await fixture.request(codex, .refresh)
+            let goManual = try await fixture.request(go, .refresh)
+            #expect(await codex.complete(codexManual))
+            #expect(await go.complete(goManual))
+            await fixture.barrier().value
+            #expect(!controller.isRefreshing)
+            #expect(await codex.counts().manual == 1)
+            #expect(await go.counts().manual == 1)
+        }
+    }
+
+    @Test func sourceRemovalIsImmediateAndCannotCommitAnOldResponseOrCancelAnotherSource() async throws {
+        try await withFixture { fixture in
+            let controller = fixture.controller
+            let codex = fixture.providers[0], go = fixture.providers[1]
+            controller.setNetworkEnabled(true)
+            let codexStartup = try await fixture.request(codex, .startup)
+            let goStartup = try await fixture.request(go, .startup)
+            let oldResponses = fixture.barrier()
+            let goCancellations = await go.counts().cancellations
+
+            controller.enabledProviderIDs = ["test-source"]
+            #expect(controller.snapshots.map(\.id) == ["test-source"], "Disabling an account must remove it synchronously")
+            #expect(await codex.complete(codexStartup, status: .error))
+            #expect(await go.complete(goStartup))
+            await oldResponses.value
+            await fixture.barrier().value
+            #expect(!controller.isRefreshing)
+            #expect(controller.snapshots.map(\.id) == ["test-source"], "A removed account's late response must stay removed")
+            #expect(controller.snapshots.first?.status == .ok)
+            #expect(await go.counts().cancellations == goCancellations, "Removing Codex must not cancel OpenCode Go")
+
+            // Consent invalidates a still-present reader too: a late live response
+            // must not replace the cache-only state loaded after network revocation.
+            controller.refresh()
+            let late = try await fixture.request(go, .refresh)
+            let revokedResponse = fixture.barrier()
+            controller.setNetworkEnabled(false)
+            await fixture.barrier().value
+            #expect(controller.snapshots.first?.status == .stale)
+            #expect(await go.complete(late, status: .error))
+            await revokedResponse.value
+            #expect(controller.snapshots.first?.status == .stale, "Revoked network consent must reject an old live response")
+            #expect(!controller.isRefreshing)
+        }
+    }
+
+    @Test func automaticRefreshContinuesWithoutVisibleSurfacesAndStopsInManualMode() async throws {
+        try await withFixture(ids: ["codex"], automatic: true) { fixture in
+            let controller = fixture.controller, provider = fixture.providers[0]
+            controller.floatingVisible = false
+            controller.setNetworkEnabled(true)
+            let startup = try await fixture.request(provider, .startup)
+            #expect(await provider.complete(startup))
+            await fixture.barrier().value
+            #expect(fixture.scheduler.isRunning, "Hiding all surfaces must not stop automatic polling")
+
+            fixture.scheduler.fire()
+            let automatic = try await fixture.request(provider, .refresh)
+            controller.autoRefreshEnabled = false
+            #expect(!fixture.scheduler.isRunning, "Manual mode must stop polling without cancelling an in-flight response")
+            #expect(await provider.complete(automatic))
+            await fixture.barrier().value
+            #expect(await provider.counts().manual == 1)
+            #expect(!controller.isRefreshing)
+
+            fixture.scheduler.fire()
+            await fixture.barrier().value
+            #expect(await provider.counts().manual == 1, "No periodic read is allowed in manual mode")
+
+            controller.refresh()
+            let manual = try await fixture.request(provider, .refresh)
+            #expect(await provider.complete(manual))
+            await fixture.barrier().value
+            #expect(await provider.counts().manual == 2, "Explicit refresh must still work in manual mode")
+            #expect(!controller.isRefreshing)
+        }
+    }
+
+    @Test func allAndIndividualSelectionAndIndependentExpansionPersist() async throws {
+        try await withFixture { fixture in
+            let controller = fixture.controller
+            controller.allSourcesEnabled = false
+            #expect(controller.enabledProviderIDs == ["codex", "test-source"])
+            controller.enabledProviderIDs = ["test-source", "unavailable"]
+            #expect(!controller.allSourcesEnabled)
+            #expect(controller.enabledProviderIDs == ["test-source"])
+            controller.keepExpanded = true
+            controller.floatingVisible = false
+            controller.autoRefreshEnabled = false
+            let restored = fixture.restore()
+            #expect(restored.keepExpanded)
+            #expect(!restored.floatingVisible)
+            #expect(!restored.autoRefreshEnabled)
+            #expect(restored.enabledProviderIDs == ["test-source"])
+            await fixture.barrier().value
+            #expect(restored.snapshots.map(\.id) == ["test-source"])
+            restored.allSourcesEnabled = true
+            #expect(restored.enabledProviderIDs == ["codex", "test-source"])
+            restored.enabledProviderIDs = []
+            #expect(restored.snapshots.isEmpty)
+        }
+    }
+}
