+/// Paint and native input share the outer alpha mask. Liquid paint is not stroked
+/// a second time: its one-DIP rim is the eroded-inner/outer raster composition.
+final class QuotaGripFilter {
+    private let filter = QuotaGripAlphaFilter()
+    private var source: [UInt8] = [], pixels: [UInt8] = []
+
+    func render(_ shape: QuotaOrbShape, transform: QuotaGripTransform, scale: CGFloat, dark: Bool) -> QuotaGripRaster {
+        let scale = max(scale, 1)
+        let path = shape.source.applying(transform)
+        let extent = path.boundingRect
+        let padding = ceil(3 * shape.blur * scale + scale)
+        let left = floor(extent.minX * scale) - padding, top = floor(extent.minY * scale) - padding
+        let width = Int(ceil(extent.maxX * scale) - left + padding)
+        let height = Int(ceil(extent.maxY * scale) - top + padding), count = width * height
+        if source.count < count { source = [UInt8](repeating: 0, count: count) }
+        if pixels.count < count * 4 { pixels = [UInt8](repeating: 0, count: count * 4) }
+        for y in 0..<height {
+            for x in 0..<width {
+                var coverage = 0
+                for subY in 0..<2 {
+                    for subX in 0..<2 {
+                        if path.contains(CGPoint(x: (left + CGFloat(x) + (CGFloat(subX) + 0.5) / 2) / scale,
+                                                 y: (top + CGFloat(y) + (CGFloat(subY) + 0.5) / 2) / scale)) { coverage += 1 }
+                    }
+                }
+                source[y * width + x] = UInt8(coverage * 255 / 4)
+            }
+        }
+        filter.apply(width: width, height: height, sigma: Double(shape.blur), scale: Double(scale), source: source)
+        let rim: SIMD3<UInt8> = dark ? SIMD3(repeating: 46) : SIMD3(210, 210, 215)
+        let fill: SIMD3<UInt8> = dark ? SIMD3(repeating: 0) : SIMD3(245, 245, 247)
+        for index in 0..<count {
+            let color = QuotaGripAlphaFilter.composite(outer: filter.outer[index], inner: filter.inner[index], rim: rim, fill: fill)
+            let pixel = index * 4
+            pixels[pixel] = color.x; pixels[pixel + 1] = color.y; pixels[pixel + 2] = color.z; pixels[pixel + 3] = color.w
+        }
+        // The immutable image must own its bytes; scratch remains reusable next frame.
+        let data = pixels.withUnsafeBytes { Data(bytes: $0.baseAddress!, count: count * 4) }
+        var input = QuotaGripFootprint()
+        for y in 0..<height {
+            var x = 0
+            while x < width {
+                while x < width && filter.outer[y * width + x] == 0 { x += 1 }
+                let start = x
+                while x < width && filter.outer[y * width + x] != 0 { x += 1 }
+                if start < x {
+                    input.addRect(CGRect(x: (left + CGFloat(start)) / scale, y: (top + CGFloat(y)) / scale,
+                                         width: CGFloat(x - start) / scale, height: 1 / scale))
+                }
+            }
+        }
+        return QuotaGripRaster(pixels: data, bounds: CGRect(x: left / scale, y: top / scale,
+                                                           width: CGFloat(width) / scale, height: CGFloat(height) / scale), input: input, scale: scale)
+    }
+}
+
+#if canImport(SwiftUI)
+extension QuotaGripFilter {
+    func render(_ shape: QuotaOrbShape, transform: CGAffineTransform, scale: CGFloat, dark: Bool) -> QuotaGripRaster {
+        render(shape, transform: QuotaGripTransform(transform), scale: scale, dark: dark)
+    }
+}
+#endif
+
+enum QuotaGripLayer {
+    case vector(QuotaGripFootprint)
+    case raster(QuotaGripRaster, clip: QuotaGripFootprint)
+}
+
+/// Production construction shared by native rendering/input and the Linux proof.
+struct QuotaGripPaint {
+    var layers: [QuotaGripLayer] = []
+    var paint = QuotaGripFootprint()
+    var hit = QuotaGripFootprint()
+    var routes = QuotaGripFootprint()
+
+    init(center: CGPoint, transform: QuotaGripTransform, size: CGSize, expansion: CGFloat = 1,
+         frame: QuotaGripFrame, filter: QuotaGripFilter, scale: CGFloat,
+         acquired: QuotaGripFootprint? = nil, dark: Bool = true) {
+        guard expansion >= 1 else { return }
+        let clip = QuotaGripContour.ellipse(CGRect(x: center.x - 39.2, y: center.y - 39.2, width: 78.4, height: 78.4))
+        if frame.entryArc > 0.001 {
+            append(QuotaGripGeometry.goo(center, separation: frame.entryArc, returning: frame.entryReturning, quick: frame.entryQuick),
+                   transform: transform, clip: clip, filter: filter, scale: scale, dark: dark)
+        }
+        if frame.disc > 0.001 || frame.reveal > 0.01 {
+            append(QuotaGripGeometry.goo(center, separation: 1, returning: false, quick: false),
+                   transform: transform, clip: clip, filter: filter, scale: scale, dark: dark)
+        }
+        append(QuotaGripGeometry.orb(center, frame: frame), transform: transform, clip: clip, filter: filter, scale: scale, dark: dark)
+        if frame.reveal > 0.01 {
+            let drops = QuotaGripGeometry.drops(center, frame: frame)
+            // Canvas clips are in display coordinates, unlike the local orb clip.
+            let canvas = QuotaGripContour.rect(CGRect(origin: .zero, size: size))
+            append(drops.shape, transform: transform, clip: canvas, clipIsDisplay: true, filter: filter, scale: scale, dark: dark)
+            routes = drops.hit.applying(transform)
+        }
+        routes = routes.union(QuotaGripGeometry.routes(center, frame: frame).applying(transform))
+        if let acquired { routes = routes.union(acquired) }
+        hit = paint.union(routes)
+    }
+
+    private mutating func append(_ shape: QuotaOrbShape, transform: QuotaGripTransform, clip: QuotaGripContour,
+                                 clipIsDisplay: Bool = false, filter: QuotaGripFilter, scale: CGFloat, dark: Bool) {
+        guard !shape.source.isEmpty else { return }
+        let footprint: QuotaGripFootprint
+        if shape.liquid {
+            // Rasterize in local coordinates and carry the edge transform into
+            // coverage before filtering; pixels and input share the final mask.
+            let raster = filter.render(shape, transform: transform, scale: scale, dark: dark)
+            let displayClip = QuotaGripFootprint(clip).applying(clipIsDisplay ? QuotaGripTransform() : transform)
+            layers.append(.raster(raster, clip: displayClip))
+            var input = raster.input
+            let part = displayClip.parts[0]
+            for index in input.parts.indices { input.parts[index].clip = .init(contour: part.contour, transform: part.transform) }
+            footprint = input
+        } else {
+            let vector = clipIsDisplay ? shape.source.applying(transform).clipped(to: clip) : shape.source.clipped(to: clip).applying(transform)
+            layers.append(.vector(vector))
+            footprint = vector.outlined(1)
+        }
+        paint = paint.union(footprint)
+    }
+}
+
+#if canImport(SwiftUI)
+extension QuotaGripPaint {
+    init(geometry: QuotaNotchGeometry, frame: QuotaGripFrame, filter: QuotaGripFilter, scale: CGFloat,
+         acquired: QuotaGripFootprint? = nil, dark: Bool = true) {
+        self.init(center: geometry.orbCenter, transform: QuotaGripTransform(geometry.transform), size: geometry.size,
+                  expansion: geometry.expansion, frame: frame, filter: filter, scale: scale, acquired: acquired, dark: dark)
+    }
+}
+#endif
diff --git a/macos/Sources/AgentSpeed/App/QuotaNotchVisualHarness.swift b/macos/Sources/AgentSpeed/App/QuotaNotchVisualHarness.swift
new file mode 100644
index 00000000..d239a9b3
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaNotchVisualHarness.swift
@@ -0,0 +1,163 @@
+#if DEBUG
+import AgentSpeedCore
+import AppKit
+import Darwin
+import SwiftUI
+
+/// Opt-in native captures of the production Codex renderer and its exact
+/// painted input mask. Never runs in the live app without the diagnostic flag.
+@MainActor
+struct QuotaNotchVisualHarness {
+    private let now = Date(timeIntervalSince1970: 1_800_000_000)
+    private var failures: [String] = []
+
+    static func run(into directory: URL) {
+        var harness = Self()
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            try harness.captureStates(into: directory)
+            if !harness.failures.isEmpty { throw Failure(message: harness.failures.joined(separator: "\n")) }
+            print("Native notch visual checks passed: \(directory.path) — \(ProcessInfo.processInfo.operatingSystemVersionString)")
+            NSApp.terminate(nil)
+        } catch {
+            FileHandle.standardError.write(Data("Native notch visual checks failed: \(error)\nArtifacts: \(directory.path)\n".utf8))
+            exit(EXIT_FAILURE)
+        }
+    }
+
+    private struct Failure: Error, CustomStringConvertible {
+        let message: String
+        var description: String { message }
+    }
+    private mutating func check(_ condition: Bool, _ expression: String) {
+        if !condition { failures.append(expression) }
+    }
+    private func require<T>(_ value: T?, _ message: String) throws -> T {
+        guard let value else { throw Failure(message: message) }
+        return value
+    }
+
+    private func reading(_ id: String, state: String) -> QuotaNotchReading {
+        let unknown = state == "unknown"
+        let windows = [
+            QuotaWindow(id: "monthly", label: "", usedFraction: unknown ? nil : 0.1, remaining: nil, used: nil, resetAt: now.addingTimeInterval(400_000), duration: nil),
+            QuotaWindow(id: "weekly", label: "", usedFraction: unknown ? nil : 0.52, remaining: nil, used: nil, resetAt: now.addingTimeInterval(100_000), duration: nil),
+            QuotaWindow(id: "rolling", label: "", usedFraction: unknown ? nil : 0.21, remaining: nil, used: nil, resetAt: now.addingTimeInterval(3_060), duration: nil),
+        ]
+        let snapshot = QuotaSnapshot(id: id, displayName: "Codex", fidelity: "official",
+                                     status: state == "stale" ? .stale : state == "auth" ? .needsAuth : .ok, windows: windows,
+                                     headlineId: "rolling", block: nil, account: "local account", plan: "Plus",
+                                     observedAt: now.addingTimeInterval(state == "aged" ? -3_600 : -300), source: "local", credits: nil, nextAllowedAt: nil, waitingForRefresh: false)
+        return QuotaNotchReading(snapshot: snapshot, networkEnabled: state != "offline", l10n: Localizer(preference: .en))
+    }
+
+    private func render<Content: View>(_ content: Content, scale: CGFloat) throws -> NSBitmapImageRep {
+        let renderer = ImageRenderer(content: content)
+        renderer.scale = scale; renderer.isOpaque = false
+        return NSBitmapImageRep(cgImage: try require(renderer.cgImage, "Native renderer returned no image"))
+    }
+    private func save(_ bitmap: NSBitmapImageRep, to url: URL) throws {
+        let data = try require(bitmap.representation(using: .png, properties: [:]), "Native renderer returned no PNG")
+        try data.write(to: url)
+    }
+
+    private mutating func captureStates(into directory: URL) throws {
+        let filter = QuotaGripFilter()
+        let states: [(String, QuotaGripFrame)] = [
+            ("folded", QuotaGripFrame()), ("arc", QuotaGripFrame(arc: 1)),
+            ("entry", QuotaGripFrame(arc: 0.65)), ("disc", QuotaGripFrame(arc: 1, disc: 1)),
+            ("dividing", QuotaGripFrame(reveal: 0.45, hover: 1, arc: 1, disc: 0.4)),
+            ("six-drops", QuotaGripFrame(reveal: 1, hover: 1, arc: 1)),
+            ("held", QuotaGripFrame(reveal: 1, hover: 1, squeeze: 1, arc: 1)),
+            ("stale", QuotaGripFrame(arc: 1)), ("offline", QuotaGripFrame(arc: 1)),
+            ("aged", QuotaGripFrame(arc: 1)),
+            ("unknown", QuotaGripFrame(arc: 1)), ("auth", QuotaGripFrame(arc: 1)),
+        ]
+        for edge in NotchEdge.allCases {
+            for dark in [true, false] {
+                for scale in [CGFloat(1), 2] {
+                    for (state, frame) in states {
+                        let readings = [reading("codex", state: state)]
+                        let layout = QuotaNotchContentLayout(cells: readings.map(\.cellMetrics), horizontal: !edge.isVertical)
+                        let geometry = QuotaNotchGeometry(edge: edge, expansion: state == "folded" ? 0 : 1, layout: layout)
+                        let grip = QuotaGripPaint(geometry: geometry, frame: frame, filter: filter, scale: scale, dark: dark)
+                        let view = QuotaNotchView(readings: readings, geometry: geometry, grip: grip, dark: dark)
+                        let bitmap = try render(view, scale: scale)
+                        let name = "native-notch-\(edge.rawValue)-\(dark ? "dark" : "light")-\(state)@\(Int(scale))x.png"
+                        try save(bitmap, to: directory.appendingPathComponent(name))
+                        if ["stale", "offline", "aged"].contains(state) {
+                            let fresh = readings.map { reading($0.providerID, state: "arc") }
+                            let control = try render(QuotaNotchView(readings: fresh, geometry: geometry, grip: grip, dark: dark), scale: scale)
+                            let actualPixels = try require(bitmap.bitmapData, "Missing native pixels")
+                            let controlPixels = try require(control.bitmapData, "Missing control pixels")
+                            check(bitmap.bytesPerRow == control.bytesPerRow && bitmap.pixelsHigh == control.pixelsHigh,
+                                  "\(name): matching native bitmap dimensions")
+                            let count = bitmap.bytesPerRow * bitmap.pixelsHigh
+                            if count == control.bytesPerRow * control.pixelsHigh {
+                                check(Data(bytes: actualPixels, count: count) == Data(bytes: controlPixels, count: count),
+                                      "\(name): old data retains the fresh logo, rings and readings")
+                            }
+                        }
+                        check(abs(CGFloat(bitmap.pixelsWide) / scale - geometry.size.width) < 1, "\(name): tight native width")
+                        check(abs(CGFloat(bitmap.pixelsHigh) / scale - geometry.size.height) < 1, "\(name): tight native height")
+                        let input = QuotaNotchInput(paths: [geometry.bodyPath, quotaStrokeOutline(geometry.bodyPath, width: state == "folded" ? 0 : 1)], grip: grip.hit)
+                        for y in stride(from: 2, to: bitmap.pixelsHigh - 2, by: 4) {
+                            for x in stride(from: 2, to: bitmap.pixelsWide - 2, by: 4) {
+                                let color = try require(bitmap.colorAt(x: x, y: y), "\(name): missing native sample")
+                                if color.alphaComponent > 0.95 {
+                                    let point = CGPoint(x: (CGFloat(x) + 0.5) / scale, y: (CGFloat(y) + 0.5) / scale)
+                                    check(input.contains(point), "\(name): opaque pixel outside shared native input at \(x),\(y)")
+                                }
+                            }
+                        }
+                        if state == "arc" {
+                            let hole = geometry.orbCenter.applying(geometry.transform)
+                            check(!grip.hit.contains(hole), "\(name): resting arc hole passes clicks through")
+                        }
+                        if state == "six-drops" {
+                            for index in 0..<6 {
+                                let point = CGPoint(x: geometry.orbCenter.x + CGFloat(index % 3 - 1) * 12.5,
+                                                    y: geometry.orbCenter.y + 8 + CGFloat(index / 3 * 2 - 1) * 6.25).applying(geometry.transform)
+                                check(grip.hit.contains(point), "\(name): drop \(index) is draggable")
+                            }
+                        }
+                        if dark && state == "arc" {
+                            try checkRing(readings[0], geometry: geometry, bitmap: bitmap, scale: scale)
+                        }
+                    }
+                }
+            }
+        }
+        for preference in [LanguagePreference.en, .zhHans, .zhHant, .ja] {
+            let value = reading("codex", state: "stale")
+            let localized = QuotaNotchReading(snapshot: value.snapshot, networkEnabled: false, l10n: Localizer(preference: preference))
+            let bitmap = try render(QuotaNotchTooltipContent(reading: localized, now: now).background(.black).environment(\.colorScheme, .dark), scale: 2)
+            try save(bitmap, to: directory.appendingPathComponent("native-quota-details-\(localized.l10n.language.rawValue)@2x.png"))
+        }
+    }
+
+    /// Independent circular reference retains period color and progress-over-track compositing.
+    private mutating func checkRing(_ reading: QuotaNotchReading, geometry: QuotaNotchGeometry,
+                                   bitmap: NSBitmapImageRep, scale: CGFloat) throws {
+        let diameter = reading.outerDiameter - 6 - 16 // weekly ring between monthly and session
+        let center = geometry.centers[0]
+        let reference = ZStack(alignment: .topLeading) {
+            Color.black
+            ZStack {
+                Circle().stroke(Color(red: 34 / 255, green: 217 / 255, blue: 148 / 255).opacity(0.22), lineWidth: 5)
+                Circle().trim(from: 0, to: 0.48).stroke(Color(red: 34 / 255, green: 217 / 255, blue: 148 / 255), style: StrokeStyle(lineWidth: 5, lineCap: .round)).rotationEffect(.degrees(-90))
+            }.frame(width: diameter, height: diameter).position(center)
+        }.frame(width: geometry.size.width, height: geometry.size.height)
+        let expected = try render(reference, scale: scale)
+        for angle in [CGFloat(0.3), 4.6] {
+            let x = Int((center.x + sin(angle) * diameter / 2) * scale)
+            let y = Int((center.y - cos(angle) * diameter / 2) * scale)
+            let actual = try require(bitmap.colorAt(x: x, y: y)?.usingColorSpace(.sRGB), "Missing ring pixel")
+            let control = try require(expected.colorAt(x: x, y: y)?.usingColorSpace(.sRGB), "Missing reference ring pixel")
+            for (a, b) in zip([actual.redComponent, actual.greenComponent, actual.blueComponent], [control.redComponent, control.greenComponent, control.blueComponent]) {
+                check(abs(a - b) < 0.02, "\(geometry.edge.rawValue) @\(scale)x: approved weekly ring color/compositing")
+            }
+        }
+    }
+}
+#endif
diff --git a/macos/Sources/AgentSpeed/App/QuotaRefreshScheduler.swift b/macos/Sources/AgentSpeed/App/QuotaRefreshScheduler.swift
new file mode 100644
index 00000000..73bf336c
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaRefreshScheduler.swift
@@ -0,0 +1,94 @@
+import AgentSpeedCore
+import Foundation
+
+@MainActor
+protocol QuotaRefreshScheduling: AnyObject {
+    func start(every interval: TimeInterval, tick: @escaping @MainActor () -> Void)
+    func stop()
+    func scheduleRetry(for sourceID: String, after delay: TimeInterval, tick: @escaping @MainActor () -> Void)
+    func cancelRetry(for sourceID: String)
+    func stopRetries()
+}
+
+/// The controller owns the polling policy; this only schedules its ticks.
+@MainActor
+final class QuotaRefreshScheduler: QuotaRefreshScheduling {
+    private var task: Task<Void, Never>?
+    private var retries: [String: Task<Void, Never>] = [:]
+
+    func start(every interval: TimeInterval, tick: @escaping @MainActor () -> Void) {
+        stop()
+        task = Task {
+            while !Task.isCancelled {
+                do { try await Task.sleep(for: .seconds(interval)) }
+                catch { return }
+                guard !Task.isCancelled else { return }
+                tick()
+            }
+        }
+    }
+
+    func stop() {
+        task?.cancel()
+        task = nil
+    }
+
+    func scheduleRetry(for sourceID: String, after delay: TimeInterval, tick: @escaping @MainActor () -> Void) {
+        cancelRetry(for: sourceID)
+        retries[sourceID] = Task { [weak self] in
+            do { try await Task.sleep(for: .seconds(delay)) }
+            catch { return }
+            guard !Task.isCancelled, let self else { return }
+            self.retries.removeValue(forKey: sourceID)
+            tick()
+        }
+    }
+
+    func cancelRetry(for sourceID: String) {
+        retries.removeValue(forKey: sourceID)?.cancel()
+    }
+
+    func stopRetries() {
+        for task in retries.values { task.cancel() }
+        retries.removeAll()
+    }
+
+    deinit {
+        task?.cancel()
+        for task in retries.values { task.cancel() }
+    }
+}
+
+/// Per-reader failure policy. Providers remain the authority for persisted request pacing.
+struct QuotaFailureRetry {
+    private(set) var dueAt: Date?
+    private var failures = 0
+    private var coldFailures = 0
+
+    mutating func clear() {
+        dueAt = nil
+        failures = 0
+        coldFailures = 0
+    }
+
+    mutating func complete(before: QuotaSnapshot, result: QuotaSnapshot, startedAt: Date, now: Date) {
+        guard (result.status == .error || result.status == .stale), !result.waitingForRefresh else {
+            clear()
+            return
+        }
+        // Returning behind an existing provider floor warrants a freshness wake, not
+        // another failure count. Cache-only hydration never calls this method.
+        if !(before.nextAllowedAt.map { $0 > startedAt && result.nextAllowedAt == $0 } ?? false) {
+            failures = min(failures + 1, 5)
+            if result.observedAt == nil { coldFailures = min(coldFailures + 1, 4) }
+        }
+        let fallback = result.observedAt == nil
+            ? min(30, 5 * Double(1 << max(0, coldFailures - 1)))
+            : min(60 * Double(1 << max(0, failures - 1)), 900)
+        if let deadline = result.nextAllowedAt, deadline > now {
+            dueAt = deadline
+        } else {
+            dueAt = now.addingTimeInterval(fallback)
+        }
+    }
+}
