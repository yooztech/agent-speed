+                clients.emplace(fd, Client{Fd(fd), nextId++});
+            }
+        }
+        for (std::size_t i = 1; i < fds.size(); ++i) {
+            auto it = clients.find(fds[i].fd); if (it == clients.end()) continue; auto& c = it->second; short events = fds[i].revents;
