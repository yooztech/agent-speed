+using J = agentspeed::report::Json;
+constexpr const char* origin = "https://agent-speed.yooztech.com";
+std::int64_t wall() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count(); }
+bool text(const std::string& s, std::size_t max, bool bearer = false) {
+    if (s.empty() || s.size() > max) return false;
+    for (unsigned char c : s) if (c < 0x20 || c == 0x7f || (bearer && std::isspace(c))) return false;
+    return true;
+}
+bool utf8(const std::string& s) {
+    std::size_t chars = 0;
+    for (std::size_t i = 0; i < s.size();) {
+        unsigned char c = s[i++]; unsigned n = 0; unsigned cp = c;
+        if (c < 0x80) {} else if (c >= 0xc2 && c <= 0xdf) { n=1; cp=c&31; } else if (c >= 0xe0 && c <= 0xef) { n=2; cp=c&15; } else if (c >= 0xf0 && c <= 0xf4) { n=3; cp=c&7; } else return false;
+        if (i+n > s.size()) return false;
+        for (unsigned j=0;j<n;++j) { unsigned char b=s[i++]; if ((b&0xc0)!=0x80) return false; cp=(cp<<6)|(b&63); }
+        if ((n==2 && cp<0x800) || (n==3 && cp<0x10000) || cp>0x10ffff || (cp>=0xd800 && cp<=0xdfff)) return false;
+        chars += cp > 0xffff ? 2 : 1;
+    }
+    return chars <= 256;
+}
+bool zoneName(const std::string& z) {
+    if (!text(z,256) || z == "localtime" || z.front() == '/' || z.find("..") != std::string::npos) return false;
+    for (unsigned char c : z) if (!(std::isalnum(c) || c=='/' || c=='_' || c=='-' || c=='+')) return false;
+    return z.find("//")==std::string::npos && z.back()!='/';
+}
+size_t bodyWrite(char* p,size_t a,size_t b,void* opaque) {
+    auto& s=*static_cast<std::string*>(opaque); size_t n=a*b; if (n>4096-s.size()) return 0; s.append(p,n); return n;
+}
+size_t headerWrite(char* p,size_t a,size_t b,void* opaque) {
+    size_t n=a*b; std::string s(p,n); auto& ms=*static_cast<std::int64_t*>(opaque);
+    if (s.size()>12 && std::equal(s.begin(),s.begin()+12,"retry-after:",[](char x,char y){return std::tolower(static_cast<unsigned char>(x))==y;})) {
+        const char* q=s.c_str()+12; while (*q==' ' || *q=='\t') ++q;
+        std::int64_t v=0; bool ok=false; while (*q>='0' && *q<='9') { ok=true; v=std::min<std::int64_t>(28800,v*10+(*q++-'0')); }
+        if (ok && (*q=='\r' || *q=='\n' || *q=='\0' || *q==' ')) ms=v*1000;
+        else { auto date=curl_getdate(q,nullptr); if(date>=0) ms=std::max<std::int64_t>(0,static_cast<std::int64_t>(date)*1000-wall()); }
+    } return n;
+}
+Publisher::Result curlTransport(const std::string& lease,const std::string& body) {
+    Publisher::Result r;
+    static const bool ready=[] { if (curl_global_init(CURL_GLOBAL_DEFAULT)!=CURLE_OK) return false; auto* v=curl_version_info(CURLVERSION_NOW); return v && (v->features&CURL_VERSION_ASYNCHDNS); }();
+    if (!ready) return r;
+    CURL* c=curl_easy_init(); if (!c) return r;
+ #ifdef AGENTSPEED_COLLECTOR_TEST_RELAY
+    curl_easy_setopt(c,CURLOPT_URL,"https://localhost:19443/v1/publish");
+    curl_easy_setopt(c,CURLOPT_CAINFO,"/tmp/agent-speed-shared-ca.pem");
+#else
+    curl_easy_setopt(c,CURLOPT_URL,"https://agent-speed.yooztech.com/v1/publish");
+#endif
+    std::string auth="Authorization: Bearer "+lease;
+    curl_slist* headers=nullptr; headers=curl_slist_append(headers,"Content-Type: application/json"); headers=curl_slist_append(headers,auth.c_str());
+    curl_easy_setopt(c,CURLOPT_HTTPHEADER,headers); curl_easy_setopt(c,CURLOPT_POSTFIELDS,body.data()); curl_easy_setopt(c,CURLOPT_POSTFIELDSIZE,static_cast<long>(body.size()));
+#if LIBCURL_VERSION_NUM >= 0x075500
+    curl_easy_setopt(c, CURLOPT_PROTOCOLS_STR, "https");
+#else
+    curl_easy_setopt(c, CURLOPT_PROTOCOLS, CURLPROTO_HTTPS);
+#endif
+    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 0L); curl_easy_setopt(c, CURLOPT_PROXY, ""); curl_easy_setopt(c, CURLOPT_NETRC, CURL_NETRC_IGNORED);
+    curl_easy_setopt(c,CURLOPT_SSL_VERIFYPEER,1L); curl_easy_setopt(c,CURLOPT_SSL_VERIFYHOST,2L); curl_easy_setopt(c,CURLOPT_CONNECTTIMEOUT_MS,3000L); curl_easy_setopt(c,CURLOPT_TIMEOUT_MS,6000L); curl_easy_setopt(c,CURLOPT_NOSIGNAL,1L);
+    curl_easy_setopt(c,CURLOPT_WRITEFUNCTION,bodyWrite); curl_easy_setopt(c,CURLOPT_WRITEDATA,&r.body); curl_easy_setopt(c,CURLOPT_HEADERFUNCTION,headerWrite); curl_easy_setopt(c,CURLOPT_HEADERDATA,&r.retryAfterMs);
+    if (curl_easy_perform(c)==CURLE_OK) curl_easy_getinfo(c,CURLINFO_RESPONSE_CODE,&r.status);
+    curl_slist_free_all(headers); curl_easy_cleanup(c); return r;
+}
+std::string ack(const std::string& type,const std::string& request,const std::string& activity,const std::string& lease,std::int64_t expires,bool accepted,const char* error=nullptr) {
+    auto j=J::object({{"version",J::of(1)},{"type",J::of(type)},{"controlVersion",J::of(2)},{"requestId",J::of(request)}});
+    if (type=="live_activity_subscribe_ack") j.add("activityId",J::of(activity));
+    j.add("leaseId",J::of(lease)); if (type=="live_activity_subscribe_ack") j.add("expiresAt",J::of(expires));
+    j.add("accepted",J::of(accepted)); if (error) j.add("error",J::of(error)); return j.compact()+"\n";
+}
+}
+struct Publisher::Impl {
+    struct Waiter { std::uint64_t client; std::string request; };
+    enum class Activity { unknown, idle, active };
+    static Activity activity(int generating, int tools) {
+        if (generating > 0 || tools > 0) return Activity::active;
+        if (generating == 0 && tools == 0) return Activity::idle;
+        return Activity::unknown;
+    }
+    struct Lease {
+        std::string activity, id, token, host, name, zone;
+        std::int64_t expires = 0, deadline = 0, created = 0, last = 0, next = 0;
+        std::int64_t failureUntil = 0;
+        Activity sampledActivity = Activity::unknown, attemptedActivity = Activity::unknown;
+        std::uint64_t generation = 0;
+        View view;
+        bool confirmed = false;
+        int failures = 0;
+        int invalidSnapshots = 0;
+        std::vector<Waiter> waiters;
+        std::string payload;
+        std::int64_t sampled = 0;
+    };
+    struct Request { std::string binding; std::string response; };
+    Options options;
+    mutable std::mutex mutex;
+    std::condition_variable cv;
+    bool stop = false;
+    std::thread worker;
+    std::vector<Lease> leases;
+    // Active leases reserve their own fence slot so retirement can never evict a live fence.
+    std::map<std::pair<std::string, std::string>, std::int64_t> retired;
+    std::map<std::pair<std::uint64_t, std::string>, Request> requests;
+    std::vector<std::pair<std::uint64_t, std::string>> pending;
+    std::uint64_t generation = 0;
+
+    explicit Impl(Options o) : options(std::move(o)) {
+        if (!options.clock) options.clock = wall;
+        if (!options.transport) options.transport = curlTransport;
+        options.confirmationMs = std::max<std::int64_t>(1, std::min<std::int64_t>(75000, options.confirmationMs));
+        options.intervalMs = std::max<std::int64_t>(1, options.intervalMs);
+        worker = std::thread([this] { run(); });
+    }
+    ~Impl() {
+        { std::lock_guard<std::mutex> lock(mutex); stop = true; }
+        cv.notify_all();
+        worker.join();
+    }
+    void finish(Lease& lease, bool ok, const char* error) {
+        for (const auto& waiter : lease.waiters) {
+            auto response = ack("live_activity_subscribe_ack", waiter.request, lease.activity, lease.id, lease.expires, ok, error);
+            if (pending.size() < 256) pending.emplace_back(waiter.client, response);
+            auto it = requests.find({waiter.client, waiter.request});
+            if (it != requests.end()) it->second.response = response;
+        }
+        lease.waiters.clear();
+    }
+    void retire(const Lease& lease) {
+        retired[{lease.activity, lease.id}] = lease.expires;
+    }
+    void expire(std::int64_t now) {
+        for (auto it = retired.begin(); it != retired.end();) {
+            if (now >= it->second) it = retired.erase(it);
+            else ++it;
+        }
+        for (auto it = leases.begin(); it != leases.end();) {
+            if (now >= it->expires || (!it->confirmed && now >= it->deadline)) {
+                if (!it->confirmed) finish(*it, false, "timeout");
+                if (now < it->expires) retire(*it);
+                it = leases.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    void run() {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (!stop) {
+            auto now = options.clock();
+            expire(now);
+            auto it = leases.end();
+            for (auto candidate = leases.begin(); candidate != leases.end(); ++candidate) {
+                if (candidate->sampled <= candidate->last || candidate->sampled < candidate->created ||
+                    candidate->sampled > now || now - candidate->sampled > 30000 ||
+                    now < candidate->failureUntil || candidate->payload.empty()) continue;
+                const bool edge = candidate->sampledActivity != Activity::unknown &&
+                    candidate->attemptedActivity != Activity::unknown &&
+                    candidate->sampledActivity != candidate->attemptedActivity;
+                if (!edge && now < candidate->next) continue;
+                const auto due = edge ? candidate->sampled : candidate->next;
+                if (it == leases.end()) it = candidate;
+                else {
+                    const bool selectedEdge = it->sampledActivity != Activity::unknown &&
+                        it->attemptedActivity != Activity::unknown && it->sampledActivity != it->attemptedActivity;
+                    if (due < (selectedEdge ? it->sampled : it->next)) it = candidate;
+                }
+            }
+            if (it == leases.end()) {
+                cv.wait_for(lock, std::chrono::milliseconds(100));
+                continue;
+            }
+            auto id = it->id;
+            auto gen = it->generation;
+            auto token = it->token;
+            auto body = it->payload;
+            it->last = it->sampled;
+            if (it->sampledActivity != Activity::unknown) it->attemptedActivity = it->sampledActivity;
+            it->next = now + std::max<std::int64_t>(10000, options.intervalMs);
+            lock.unlock();
+            Result result;
+            try { result = options.transport(token, body); } catch (...) {}
+            lock.lock();
+            now = options.clock();
+            expire(now);
+            it = std::find_if(leases.begin(), leases.end(), [&](const Lease& lease) {
+                return lease.id == id && lease.generation == gen;
+            });
+            if (it == leases.end()) continue;
+            if (result.status >= 200 && result.status < 300) {
+                // The relay reserves its window after request arrival, not at our attempt start.
+                it->next = std::max(it->next, now + std::max<std::int64_t>(10000, options.intervalMs));
+                it->failures = 0;
+                it->invalidSnapshots = 0;
+                it->failureUntil = 0;
+                if (!it->confirmed) {
+                    it->confirmed = true;
+                    finish(*it, true, nullptr);
+                }
+            } else if (result.status == 401 || result.status == 403 || result.status == 410 || result.status == 413) {
+                if (!it->confirmed) finish(*it, false, "relay_rejected");
+                retire(*it);
+                leases.erase(it);
+            } else {
+                it->failures = std::min(it->failures + 1, 6);
+                it->invalidSnapshots = result.status == 400 ? it->invalidSnapshots + 1 : 0;
+                if (it->invalidSnapshots >= 8) {
+                    if (!it->confirmed) finish(*it, false, "relay_rejected");
+                    retire(*it);
+                    leases.erase(it);
+                    continue;
+                }
+                auto delay = std::min<std::int64_t>(60000, 10000LL << (it->failures - 1));
+                if (result.status == 429) {
+                    delay = std::max(delay, result.retryAfterMs);
+                    if (result.body.find("apns_backoff") != std::string::npos)
+                        delay = std::max<std::int64_t>(60000, delay);
+                    delay = std::min<std::int64_t>(delay, 28800000);
+                }
+                it->failureUntil = now + delay;
+            }
+        }
+    }
+};
+Publisher::Publisher():Publisher(Options{}) {}
+Publisher::Publisher(Options o):impl_(new Impl(std::move(o))) {}
+Publisher::~Publisher()=default;
+std::vector<std::string> Publisher::control(const std::string& line, std::uint64_t client, std::int64_t now) {
+    if (line.size() > 16384) return {};
+    agentspeed::json::Document doc;
+    if (!doc.parse(line, 32)) return {};
+    auto root = doc.root();
+    if (!root.isObject()) return {};
+    auto type = root["type"].string().value_or("");
+    if (type != "capabilities" && type != "live_activity_subscribe" && type != "live_activity_unsubscribe") return {};
+    auto request = root["requestId"].string().value_or("");
+    auto id = root["leaseId"].string().value_or("");
+    auto activity = root["activityId"].string().value_or("");
+    auto expires = root["expiresAt"].isIntegerLiteral() ? root["expiresAt"].truncated().value_or(0) : 0;
+    if (type == "capabilities") {
+        if (!root["version"].isIntegerLiteral() || root["version"].truncated() != 1 || !text(request, 128)) return {};
+        return {J::object({{"version", J::of(1)}, {"type", J::of("capabilities")},
+            {"requestId", J::of(request)}, {"capabilities", J::array({J::of("live_activity_v2"), J::of("live_activity_edges_v1"), J::of("shared_collector_v1")})},
+            {"controlVersion", J::of(2)}, {"subscribeTimeoutMs", J::of(75000)},
+            {"relayUrl", J::of(origin)}, {"minPublishIntervalMs", J::of(10000)}}).compact() + "\n"};
+    }
+    auto ackType = type + "_ack";
+    auto bad = [&](const char* error) {
+        return std::vector<std::string>{ack(ackType, request, activity, id, expires, false, error)};
+    };
+    if (!root["version"].isIntegerLiteral() || root["version"].truncated() != 1 ||
+        !root["controlVersion"].isIntegerLiteral() || root["controlVersion"].truncated() != 2 ||
+        !text(request, 128) || !text(id, 256)) return bad("invalid_request");
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    impl_->expire(now);
+    if (type == "live_activity_unsubscribe") {
+        auto binding = std::string("u:") + id;
+        auto seen = impl_->requests.find({client, request});
+        if (seen != impl_->requests.end()) {
+            if (seen->second.binding != binding) return bad("conflicting_request");
+            return {seen->second.response};
+        }
+        auto it = std::find_if(impl_->leases.begin(), impl_->leases.end(), [&](const Impl::Lease& lease) { return lease.id == id; });
+        if (it != impl_->leases.end()) {
+            if (!it->confirmed) impl_->finish(*it, false, "cancelled");
+            impl_->retire(*it);
+            impl_->leases.erase(it);
+        }
+        auto response = ack(ackType, request, "", id, 0, true);
+        if (impl_->requests.size() >= 256) impl_->requests.erase(impl_->requests.begin());
+        impl_->requests[{client, request}] = {binding, response};
+        return {response};
+    }
+    auto relay = root["relayUrl"].string().value_or("");
+    auto token = root["lease"].string().value_or("");
+    auto host = root["hostId"].string().value_or("");
+    auto name = root["hostName"].string().value_or("");
+    auto zone = root["timezone"].string().value_or("");
+    if ((relay != origin && relay != std::string(origin) + "/") || !text(token, 4096, true) ||
+        !text(activity, 256) || !text(host, 1024) || !utf8(host) || !text(name, 1024) ||
+        !utf8(name) || !zoneName(zone) || expires <= now || expires - now > 28800000) return bad("invalid_request");
+    auto tz = agentspeed::TimeZone::load(zone);
+    if (!tz) return bad("invalid_request");
+    auto binding = std::string("s:") + J::array({J::of(activity), J::of(id), J::of(token), J::of(host), J::of(name), J::of(zone), J::of(expires)}).compact();
+    auto requestIt = impl_->requests.find({client, request});
+    if (requestIt != impl_->requests.end() && requestIt->second.binding != binding) return bad("conflicting_request");
+    std::size_t outstanding = impl_->pending.size();
+    for (const auto& lease : impl_->leases) outstanding += lease.waiters.size();
+    if (outstanding >= 256) return bad("busy");
+    auto it = std::find_if(impl_->leases.begin(), impl_->leases.end(), [&](const Impl::Lease& lease) { return lease.id == id; });
+    if (it != impl_->leases.end()) {
+        if (it->activity != activity || it->token != token || it->host != host || it->name != name ||
+            it->zone != zone || it->expires != expires) return bad("conflicting_request");
+        if (it->confirmed) {
+            auto response = ack(ackType, request, activity, id, expires, true);
+            if (impl_->requests.size() >= 256 && requestIt == impl_->requests.end()) impl_->requests.erase(impl_->requests.begin());
+            impl_->requests[{client, request}] = {binding, response};
+            return {response};
+        }
+        if (it->waiters.size() >= 32) return bad("busy");
+        if (std::none_of(it->waiters.begin(), it->waiters.end(), [&](const Impl::Waiter& waiter) {
+            return waiter.client == client && waiter.request == request;
+        })) it->waiters.push_back({client, request});
+    } else {
+        if (requestIt != impl_->requests.end() && !requestIt->second.response.empty()) {
+            if (requestIt->second.response.find("\"accepted\":false") != std::string::npos) return {requestIt->second.response};
+            return bad("cancelled");
+        }
+        if (impl_->retired.find({activity, id}) != impl_->retired.end()) return bad("cancelled");
+        if (impl_->retired.size() + impl_->leases.size() >= 256) return bad("busy");
+        auto old = std::find_if(impl_->leases.begin(), impl_->leases.end(), [&](const Impl::Lease& lease) { return lease.activity == activity; });
+        if (old != impl_->leases.end()) {
+            if (!old->confirmed) impl_->finish(*old, false, "cancelled");
+            impl_->retire(*old);
+            impl_->leases.erase(old);
+        }
+        if (impl_->leases.size() >= 32) return bad("busy");
+        Impl::Lease lease;
+        lease.activity = activity; lease.id = id; lease.token = token; lease.host = host;
+        lease.name = name; lease.zone = zone; lease.expires = expires; lease.created = now;
+        lease.deadline = now + impl_->options.confirmationMs;
+        lease.generation = ++impl_->generation;
+        lease.view = {zone, tz};
+        lease.waiters.push_back({client, request});
+        impl_->leases.push_back(std::move(lease));
+    }
+    if (impl_->requests.size() >= 256) impl_->requests.erase(impl_->requests.begin());
+    impl_->requests[{client, request}] = {std::move(binding), ""};
+    impl_->cv.notify_one();
+    return {};
+}
+void Publisher::sample(const View& view, const Sample& sample) {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    auto now = impl_->options.clock();
+    for (auto& lease : impl_->leases) {
+        if (lease.view.name != view.name || lease.view.zone != view.zone ||
+            sample.snapshot.nowMs < lease.created || sample.snapshot.nowMs <= lease.sampled ||
+            sample.snapshot.nowMs > now || now - sample.snapshot.nowMs > 30000) continue;
+        const auto& snapshot = sample.snapshot;
+        auto number = [](double value) { return std::isfinite(value) ? J::decimal(value, 3) : J::null(); };
+        auto projection = J::object({
+            {"version", J::of(1)}, {"hostId", J::of(lease.host)}, {"hostName", J::of(lease.name)},
+            {"sampledAt", J::of(snapshot.nowMs)}, {"status", J::of("live")},
+            {"speed", snapshot.liveRateComplete ? number(snapshot.liveOutput) : J::null()},
+            {"generating", J::of(snapshot.generating)}, {"tools", J::of(snapshot.tools)},
+            {"todayOutput", J::of(snapshot.todayOutput)},
+            {"rxBytesPerSecond", snapshot.traffic.machine ? number(snapshot.traffic.machine->rx) : J::null()},
+            {"txBytesPerSecond", snapshot.traffic.machine ? number(snapshot.traffic.machine->tx) : J::null()},
+            {"title", J::null()}});
+        auto body = J::object({{"snapshot", std::move(projection)}}).compact();
+        if (body.size() <= 4096) {
+            lease.payload = std::move(body);
+            lease.sampled = snapshot.nowMs;
+            lease.sampledActivity = Impl::activity(snapshot.generating, snapshot.tools);
+            if (lease.attemptedActivity == Impl::Activity::unknown && lease.sampledActivity != Impl::Activity::unknown)
+                lease.attemptedActivity = lease.sampledActivity;
+        }
+    }
+    impl_->cv.notify_one();
+}
+std::vector<View> Publisher::views() const {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    std::vector<View> out;
+    for (const auto& lease : impl_->leases) out.push_back(lease.view);
+    return out;
+}
+std::vector<std::pair<std::uint64_t, std::string>> Publisher::replies() {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    std::vector<std::pair<std::uint64_t, std::string>> out;
+    out.swap(impl_->pending);
+    return out;
+}
+void Publisher::disconnected(std::uint64_t client) {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    impl_->pending.erase(std::remove_if(impl_->pending.begin(), impl_->pending.end(),
+        [&](const auto& reply) { return reply.first == client; }), impl_->pending.end());
+    auto request = impl_->requests.lower_bound({client, std::string{}});
+    while (request != impl_->requests.end() && request->first.first == client)
+        request = impl_->requests.erase(request);
+    for (auto it = impl_->leases.begin(); it != impl_->leases.end();) {
+        auto& waiters = it->waiters;
+        waiters.erase(std::remove_if(waiters.begin(), waiters.end(),
+            [&](const Impl::Waiter& waiter) { return waiter.client == client; }), waiters.end());
+        if (!it->confirmed && waiters.empty()) {
+            impl_->retire(*it);
+            it = impl_->leases.erase(it);
+        }
+        else ++it;
+    }
+}
+bool Publisher::authorized(std::int64_t now) const {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    return std::any_of(impl_->leases.begin(), impl_->leases.end(), [&](const Impl::Lease& lease) {
+        return now < lease.expires && (lease.confirmed || now < lease.deadline);
+    });
+}
