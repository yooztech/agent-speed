+struct Fd {
+    int value = -1;
+    explicit Fd(int fd = -1) : value(fd) {}
+    ~Fd() { if (value >= 0) close(value); }
+    Fd(const Fd&) = delete;
+    Fd& operator=(const Fd&) = delete;
+    Fd(Fd&& other) noexcept : value(other.value) { other.value = -1; }
+    Fd& operator=(Fd&& other) noexcept { if (this != &other) { if (value >= 0) close(value); value = other.value; other.value = -1; } return *this; }
+};
+bool nonblock(int fd) { int flags = fcntl(fd, F_GETFL); return flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0; }
+std::string identity() {
+    Fd fd(open("/proc/self/exe", O_RDONLY | O_CLOEXEC));
+    if (fd.value < 0) fail("identity");
+    EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+    if (!ctx) fail("identity");
+    bool ok = EVP_DigestInit_ex(ctx, EVP_sha256(), nullptr) == 1;
+    char buf[16384]; ssize_t n;
+    while (ok && (n = read(fd.value, buf, sizeof(buf))) > 0) ok = EVP_DigestUpdate(ctx, buf, static_cast<std::size_t>(n)) == 1;
+    if (ok && n < 0) ok = false;
+    unsigned char digest[EVP_MAX_MD_SIZE]; unsigned int length = 0;
+    if (ok) ok = EVP_DigestFinal_ex(ctx, digest, &length) == 1;
+    EVP_MD_CTX_free(ctx);
+    if (!ok || length != 32) fail("identity");
+    static const char hex[] = "0123456789abcdef";
+    std::string result;
+    for (unsigned int i = 0; i < length; ++i) { result += hex[digest[i] >> 4]; result += hex[digest[i] & 15]; }
+    return result;
+}
+struct Paths { std::string home, socket; Fd directory; };
+Paths paths(const std::string& hash) {
+    long size = sysconf(_SC_GETPW_R_SIZE_MAX); if (size < 1024 || size > 1024 * 1024) size = 16384;
+    std::vector<char> buffer(static_cast<std::size_t>(size)); struct passwd pw{}, *result = nullptr;
+    if (getpwuid_r(geteuid(), &pw, buffer.data(), buffer.size(), &result) || !result || !pw.pw_dir || pw.pw_dir[0] != '/') fail("account directory");
+    const char* homePath = pw.pw_dir;
+#ifdef AGENTSPEED_COLLECTOR_TESTING
+    homePath = std::getenv("HOME");
+    if (!homePath || homePath[0] != '/') fail("test account directory");
+#endif
+    Fd home(open(homePath, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    struct stat st{};
+    if (home.value < 0 || fstat(home.value, &st) || st.st_uid != geteuid() || (st.st_mode & 0022)) fail("account directory");
+#ifdef AGENTSPEED_COLLECTOR_TESTING
+    if ((st.st_mode & 07777) != 0700) fail("test account directory");
+#endif
+    if (mkdirat(home.value, ".agent-speed", 0700) && errno != EEXIST) fail("runtime directory");
+    Fd dir(openat(home.value, ".agent-speed", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    if (dir.value < 0 || fstat(dir.value, &st) || st.st_uid != geteuid() || (st.st_mode & 07777) != 0700) fail("runtime directory");
+    if (mkdirat(dir.value, "daemons", 0700) && errno != EEXIST) fail("runtime directory");
+    Fd daemons(openat(dir.value, "daemons", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    if (daemons.value < 0 || fstat(daemons.value, &st) || st.st_uid != geteuid() || (st.st_mode & 07777) != 0700) fail("runtime directory");
+    if (mkdirat(daemons.value, hash.c_str(), 0700) && errno != EEXIST) fail("runtime directory");
+    Fd digestDir(openat(daemons.value, hash.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+    if (digestDir.value < 0 || fstat(digestDir.value, &st) || st.st_uid != geteuid() || (st.st_mode & 07777) != 0700) fail("runtime directory");
+    // Keep the verified directory FD alive: procfs avoids sun_path limits for long homes and full digests.
+    std::string socket = "/proc/self/fd/" + std::to_string(digestDir.value) + "/collector.sock";
+    return {homePath, socket, std::move(digestDir)};
+}
+Fd lockFile(const Paths& p) {
+    Fd fd(openat(p.directory.value, "collector.lock", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600));
+    struct stat st{};
+    if (fd.value < 0 || fstat(fd.value, &st) || !S_ISREG(st.st_mode) || st.st_uid != geteuid() || (st.st_mode & 07777) != 0600 || st.st_nlink != 1) fail("runtime lock");
+    return fd;
+}
+bool socketValid(const Paths& p, bool& exists) {
+    struct stat st{};
+    if (fstatat(p.directory.value, "collector.sock", &st, AT_SYMLINK_NOFOLLOW)) { if (errno == ENOENT) { exists = false; return true; } return false; }
+    exists = true;
+    return S_ISSOCK(st.st_mode) && st.st_uid == geteuid() && (st.st_mode & 07777) == 0600;
+}
+bool peer(int fd) { struct ucred cred{}; socklen_t len = sizeof(cred); return getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &len) == 0 && len == sizeof(cred) && cred.uid == geteuid(); }
+Fd connectSocket(const Paths& p) {
+    bool exists = false; if (!socketValid(p, exists)) fail("runtime socket");
+    if (!exists) return Fd();
+    Fd fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)); if (fd.value < 0) fail("socket");
+    sockaddr_un addr{}; addr.sun_family = AF_UNIX; std::memcpy(addr.sun_path, p.socket.c_str(), p.socket.size() + 1);
+    if (connect(fd.value, reinterpret_cast<sockaddr*>(&addr), sizeof(addr))) {
+        int error = errno;
+        if (error == EINPROGRESS) {
+            pollfd event{fd.value, POLLOUT, 0};
+            auto deadline = Clock::now() + std::chrono::seconds(1);
+            int result;
+            do {
+                auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count();
+                if (remaining <= 0) { result = 0; break; }
+                result = poll(&event, 1, static_cast<int>(remaining));
+            } while (result < 0 && errno == EINTR);
+            if (result == 0) error = ETIMEDOUT;
+            else if (result < 0) error = errno;
+            else { socklen_t length = sizeof(error); if (getsockopt(fd.value, SOL_SOCKET, SO_ERROR, &error, &length)) error = errno; }
+        }
+        if (error) { close(fd.value); fd.value = -1; errno = error; return Fd(); }
+    }
+    int flags = fcntl(fd.value, F_GETFL);
+    if (flags < 0 || fcntl(fd.value, F_SETFL, flags & ~O_NONBLOCK) < 0) fail("socket flags");
+    if (!peer(fd.value)) fail("socket peer");
+    return fd;
+}
+bool writeAll(int fd, const std::string& s) {
+    std::size_t pos = 0;
+    while (pos < s.size()) { ssize_t n = write(fd, s.data() + pos, s.size() - pos); if (n > 0) pos += static_cast<std::size_t>(n); else if (n < 0 && errno == EINTR) continue; else return false; }
+    return true;
+}
+std::optional<std::string> readLine(int fd, int timeout) {
+    std::string s; auto deadline = Clock::now() + std::chrono::milliseconds(timeout);
+    while (s.size() < 256) {
+        auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count(); if (left <= 0) return std::nullopt;
+        pollfd p{fd, POLLIN, 0}; int r = poll(&p, 1, static_cast<int>(left)); if (r < 0 && errno == EINTR) continue; if (r <= 0) return std::nullopt;
+        char c; ssize_t n = read(fd, &c, 1); if (n != 1) return std::nullopt; if (c == '\n') return s; s += c;
+    }
+    return std::nullopt;
+}
+std::optional<std::string> machineIdentity() {
+    std::ifstream file("/etc/machine-id"); std::string id;
+    if (!(file >> id)) return std::nullopt;
+    return scopedIdentity(id, static_cast<std::uint64_t>(geteuid()));
+}
+struct Frame { std::string data; std::size_t offset = 0; bool snapshot = false; bool viewFrame = false; std::uint64_t generation = 0; };
+struct Client {
+    Fd fd; std::uint64_t id; std::string input; std::deque<Frame> output; std::size_t bytes = 0;
+    View view; std::uint64_t historyGeneration = 0; std::uint64_t viewGeneration = 0; bool handshaken = false; bool dead = false; Clock::time_point deadline = Clock::now() + std::chrono::seconds(5);
+};
+void enqueue(Client& c, std::string line, bool snapshot = false, bool viewFrame = false) {
+    if (line.empty() || c.dead) return;
+    if (line.back() != '\n') line += '\n';
+    if (snapshot) {
+        for (auto it = c.output.begin(); it != c.output.end(); ++it) {
+            if (it->snapshot && it->offset == 0) { c.bytes -= it->data.size(); c.output.erase(it); break; }
+        }
+    }
+    if (line.size() > kOutput || c.bytes > kOutput - line.size()) { c.dead = true; return; }
+    c.bytes += line.size(); c.output.push_back({std::move(line), 0, snapshot, snapshot || viewFrame, c.viewGeneration});
+}
+void command(Client& c, const std::string& line, Publisher& publisher, std::int64_t now) {
+    agentspeed::json::Document doc; if (!doc.parse(line)) return;
+    auto root = doc.root(); if (root["version"].raw() != "1") return;
+    auto type = root["type"].string(); if (!type) return;
+    if (*type == "history_timezone") {
+        auto name = root["timezone"].string();
+        if (!name || name->empty() || name->size() > 255 || *name == "localtime") return;
+        auto zone = agentspeed::TimeZone::load(*name); if (!zone) return;
+        ++c.viewGeneration;
+        for (auto it = c.output.begin(); it != c.output.end();) {
+            if (it->viewFrame && it->generation != c.viewGeneration && it->offset == 0) {
+                c.bytes -= it->data.size();
+                it = c.output.erase(it);
+            } else ++it;
+        }
+        c.view = {*name, std::move(zone)};
+        c.historyGeneration = 0;
+    } else if (*type == "capabilities" || *type == "live_activity_subscribe" || *type == "live_activity_unsubscribe") {
+        for (auto& response : publisher.control(line, c.id, now)) enqueue(c, std::move(response));
+    }
+}
+void serve(const Paths& p, int lock, int ready, const std::string& hash) {
+    (void)lock;
+    signal(SIGPIPE, SIG_IGN); signal(SIGTERM, stop); signal(SIGINT, stop); signal(SIGHUP, SIG_IGN);
+    bool exists = false; if (!socketValid(p, exists)) fail("runtime socket");
+    if (exists) {
+        Fd check = connectSocket(p); if (check.value >= 0) fail("runtime busy");
+        if (errno != ECONNREFUSED) fail("runtime socket");
+        if (!socketValid(p, exists) || !exists || unlinkat(p.directory.value, "collector.sock", 0)) fail("runtime socket");
+    }
+    Fd listener(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)); if (listener.value < 0) fail("socket");
+    sockaddr_un addr{}; addr.sun_family = AF_UNIX; std::memcpy(addr.sun_path, p.socket.c_str(), p.socket.size() + 1);
+    mode_t mask = umask(0177); int bound = bind(listener.value, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)); umask(mask);
+    if (bound || listen(listener.value, 64)) fail("socket bind");
