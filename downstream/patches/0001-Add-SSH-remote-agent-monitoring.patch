diff --git a/linux/collector/main.cpp b/linux/collector/main.cpp
new file mode 100644
index 00000000..f9759531
--- /dev/null
+++ b/linux/collector/main.cpp
@@ -0,0 +1,144 @@
+#include "protocol.hpp"
+#include "history_cache.hpp"
+
+#include "agentspeed/history_analyzer.hpp"
+#include "agentspeed/history_store.hpp"
+#include "agentspeed/monitor.hpp"
+#include "agentspeed/price_book.hpp"
+#include "agentspeed/tz.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <ctime>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+#include <exception>
+#include <fcntl.h>
+#include <iostream>
+#include <mutex>
+#include <poll.h>
+#include <signal.h>
+#include <thread>
+#include <unistd.h>
+
+namespace {
+std::int64_t nowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+std::int64_t todayStart(std::int64_t now) {
+    const std::time_t seconds = static_cast<std::time_t>(now / 1000);
+    std::tm local{};
+    localtime_r(&seconds, &local);
+    local.tm_hour = local.tm_min = local.tm_sec = 0;
+    local.tm_isdst = -1;
+    return static_cast<std::int64_t>(std::mktime(&local)) * 1000;
+}
+std::string cacheIdentity(const agentspeed::SourceLocations& locations, const std::set<agentspeed::SourceKind>& enabled) {
+    std::ostringstream out;
+    auto add = [&](const std::string& s) { out << s.size() << ':' << s; };
+    for (const auto source : enabled) out << static_cast<int>(source) << ',';
+    out << ';';
+    for (const auto& [family, path] : locations.fileRoots()) { out << static_cast<int>(family) << ','; add(path); }
+    add(locations.openCodeRoot); add(locations.zcodeRoot); add(locations.hermesRoot);
+    for (const auto& path : locations.openClawRoots) add(path);
+    out << locations.ompAutomatic << locations.piAutomatic << locations.openClawAutomatic
+        << locations.codexAutomatic << locations.hermesChosen;
+    return out.str();
+}
+std::string zoneIdentity() {
+    const char* tz = std::getenv("TZ");
+    std::string id = tz ? tz : "";
+    auto name = id;
+    if (!name.empty() && name.front() == ':') name.erase(0, 1);
+    std::string path = "/etc/localtime";
+    if (!name.empty() && name.front() != '/' && name.find("..") == std::string::npos)
+        path = "/usr/share/zoneinfo/" + name;
+    std::ifstream file(path, std::ios::binary);
+    return id + '\0' + std::string(std::istreambuf_iterator<char>(file), {});
+}
+}
+int main(int argc, char**) {
+    if (argc != 1) {
+        std::cerr << "usage: agentspeed-collector\n";
+        return 2;
+    }
+    signal(SIGPIPE, SIG_IGN);
+    if (fcntl(STDIN_FILENO, F_SETFL, fcntl(STDIN_FILENO, F_GETFL) | O_NONBLOCK) < 0 ||
+        fcntl(STDOUT_FILENO, F_SETFL, fcntl(STDOUT_FILENO, F_GETFL) | O_NONBLOCK) < 0) return 1;
+    try {
+        auto config = agentspeed::MonitorConfig::fromEnvironment();
+        agentspeed::Monitor monitor(config);
+        collector::Protocol protocol;
+        auto now = nowMs();
+        monitor.start(now, todayStart(now));
+        std::mutex outputMutex;
+        std::atomic<bool> stopping{false};
+        auto checkInput = [&](short events) {
+            if (events & (POLLERR | POLLNVAL)) { stopping = true; return; }
+            if (events & (POLLIN | POLLHUP)) {
+                char buf[256];
+                const auto n = read(STDIN_FILENO, buf, sizeof(buf));
+                if (n == 0 || (n < 0 && errno != EAGAIN && errno != EINTR)) stopping = true;
+            }
+        };
+        auto emit = [&](const std::string& line) {
+            std::lock_guard lock(outputMutex);
+            const std::string_view parts[] = {line, "\n"};
+            for (auto part : parts) {
+                while (!part.empty() && !stopping) {
+                    pollfd fds[] = {{STDIN_FILENO, POLLIN, 0}, {STDOUT_FILENO, POLLOUT, 0}};
+                    const int ready = poll(fds, 2, 1000);
+                    if (ready < 0) { if (errno != EINTR) stopping = true; continue; }
+                    checkInput(fds[0].revents);
+                    if (stopping) break;
+                    if (fds[1].revents & (POLLERR | POLLHUP | POLLNVAL)) { stopping = true; break; }
+                    if (fds[1].revents & POLLOUT) {
+                        const auto n = write(STDOUT_FILENO, part.data(), part.size());
+                        if (n > 0) part.remove_prefix(static_cast<std::size_t>(n));
+                        else if (n < 0 && errno != EAGAIN && errno != EINTR) stopping = true;
+                    }
+                }
+            }
+        };
+        emit(protocol.snapshot(monitor.snapshot(now, todayStart(now))));
+        std::thread history([&] {
+            try {
+                const char* home = std::getenv("HOME");
+                collector::HistoryCache cache(home ? home : "");
+                auto store = cache.open(cacheIdentity(config.locations, config.enabled));
+                agentspeed::history::Analyzer analyzer(*store, std::make_shared<agentspeed::pricing::PriceBook>());
+                auto zone = agentspeed::localZone(agentspeed::processEnvironment());
+                const auto zoneId = zoneIdentity();
+                while (!stopping) {
+                    auto report = analyzer.run(config.locations, config.enabled, zone, zoneId, [&] { return stopping.load(); });
+                    if (!stopping && !report.cancelled)
+                        emit(collector::Protocol::history(analyzer.days(), report));
+                    for (int i = 0; i < 60 && !stopping; ++i)
+                        std::this_thread::sleep_for(std::chrono::seconds(1));
+                }
+            } catch (const std::exception&) {
+                std::cerr << "history unavailable\n";
+            }
+        });
+        while (!stopping) {
+            pollfd input{STDIN_FILENO, POLLIN, 0};
+            int result = poll(&input, 1, 1000);
+            if (result < 0) break;
+            if (result > 0) checkInput(input.revents);
+            if (stopping) break;
+            now = nowMs();
+            monitor.poll(now, todayStart(now));
+            emit(protocol.snapshot(monitor.snapshot(now, todayStart(now))));
+            for (const auto& event : monitor.takeCompletions()) emit(collector::Protocol::completion(event));
+        }
+        stopping = true;
+        history.join();
+        return 0;
+    } catch (const std::exception&) {
+        std::cerr << "collector unavailable\n";
+        return 1;
+    }
+}
diff --git a/linux/collector/protocol.cpp b/linux/collector/protocol.cpp
new file mode 100644
index 00000000..fc28c519
--- /dev/null
+++ b/linux/collector/protocol.cpp
@@ -0,0 +1,99 @@
+#include "protocol.hpp"
+#include "agentspeed/history_analyzer.hpp"
+
+#include <cmath>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <string_view>
+
+namespace collector {
+namespace {
+void text(std::ostream& out, std::string_view value) {
+    static constexpr char hex[] = "0123456789abcdef";
+    out << '"';
+    for (unsigned char c : value) {
+        if (c == '"' || c == '\\') out << '\\' << static_cast<char>(c);
+        else if (c < 0x20) out << "\\u00" << hex[c >> 4] << hex[c & 15];
+        else out << static_cast<char>(c);
+    }
+    out << '"';
+}
+void number(std::ostream& out, double value) {
+    if (std::isfinite(value)) out << value; else out << "null";
+}
+template<class T> void optionalNumber(std::ostream& out, const std::optional<T>& value) {
+    if (value) number(out, static_cast<double>(*value)); else out << "null";
+}
+void optionalText(std::ostream& out, const std::optional<std::string>& value) {
+    if (value) text(out, *value); else out << "null";
+}
+std::ostringstream stream() {
+    std::ostringstream out;
+    out.imbue(std::locale::classic());
+    out << std::setprecision(17);
+    return out;
+}
+}
+std::string Protocol::id(const std::string& raw) {
+    auto [it, inserted] = ids_.try_emplace(raw);
+    if (inserted) it->second = std::to_string(ids_.size());
+    return it->second;
+}
+std::string Protocol::snapshot(const agentspeed::Snapshot& v) {
+    auto o = stream();
+    o << "{\"version\":1,\"type\":\"snapshot\",\"now_ms\":" << v.nowMs
+      << ",\"today_output\":" << v.todayOutput << ",\"today_input\":" << v.todayInput
+      << ",\"today_requests\":" << v.todayRequests << ",\"today_average\":";
+    optionalNumber(o, v.todayAverage);
+    o << ",\"live_output\":"; if (v.liveRateComplete) number(o, v.liveOutput); else o << "null";
+    o << ",\"live_total\":"; if (v.liveRateComplete) number(o, v.liveTotal); else o << "null";
+    o << ",\"estimated_share\":"; number(o, v.estimatedShare);
+    o << ",\"generating\":" << v.generating << ",\"tools\":" << v.tools << ",\"agents\":[";
+    bool first = true;
+    for (const auto& a : v.agents) {
+        if (!first) o << ',';
+        first = false;
+        o << "{\"id\":"; text(o, id(a.id));
+        o << ",\"source\":"; text(o, agentspeed::sourceId(a.source));
+        o << ",\"model\":"; optionalText(o, a.model);
+        o << ",\"phase\":"; text(o, agentspeed::phaseId(a.phase));
+        o << ",\"live_output\":"; if (a.liveRateComplete) number(o, a.liveOutput); else o << "null";
+        o << ",\"live_total\":"; if (a.liveRateComplete) number(o, a.liveTotal); else o << "null";
+        o << ",\"subagent\":" << (a.subagent ? "true" : "false") << ",\"parent_id\":";
+        if (a.parentId) text(o, id(*a.parentId)); else o << "null";
+        o << ",\"last_line_ms\":";
+        if (a.lastLineMs) o << *a.lastLineMs; else o << "null";
+        o << '}';
+    }
+    o << "]}";
+    return o.str();
+}
+std::string Protocol::history(const std::vector<agentspeed::history::DailyUsage>& days, const agentspeed::history::Report& report) {
+    auto o = stream();
+    o << "{\"version\":1,\"type\":\"history\",\"partial\":" << (report.filesUnreadable ? "true" : "false") << ",\"days\":[";
+    bool first = true;
+    for (const auto& d : days) {
+        if (!first) o << ',';
+        first = false;
+        const auto& t = d.totals;
+        o << "{\"day\":"; text(o, d.key.day);
+        o << ",\"source\":"; text(o, agentspeed::sourceId(d.key.source));
+        o << ",\"requests\":" << t.requests << ",\"input\":" << t.input
+          << ",\"cached_input\":" << t.cachedInput << ",\"cache_write_input\":" << t.cacheWriteInput
+          << ",\"output\":" << t.output << ",\"reasoning\":" << t.reasoning
+          << ",\"measured_output\":" << t.measuredOutput << ",\"measured_ms\":" << t.measuredMs << ",\"peak\":";
+        optionalNumber(o, d.peak);
+        o << '}';
+    }
+    o << "]}";
+    return o.str();
+}
+std::string Protocol::completion(const agentspeed::Completion& v) {
+    auto o = stream();
+    o << "{\"version\":1,\"type\":\"completion\",\"source\":"; text(o, agentspeed::sourceId(v.source));
+    o << ",\"output\":" << v.output << ",\"speed\":"; optionalNumber(o, v.speed);
+    o << '}';
+    return o.str();
+}
+}
