diff --git a/macos/scripts/build-linux-collector.sh b/macos/scripts/build-linux-collector.sh
new file mode 100755
index 00000000..63f7ec2b
--- /dev/null
+++ b/macos/scripts/build-linux-collector.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# Build on a compatible target Ubuntu system, not on the Mac packaging host.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
+REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
+
+if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
+    cat <<EOF
+Usage: $(basename "$0") [OUTPUT_DIR]
+
+Build the collector natively on the target Ubuntu architecture and install it
+under OUTPUT_DIR/linux-<architecture>/agent-speed-collector. OUTPUT_DIR defaults
+to <repo>/dist/collectors. Copy the architecture directory to the Mac before
+running build-app.sh; use --collectors there if not using its default location.
+
+Install build dependencies: cmake, g++, pkg-config, libzstd-dev, libbrotli-dev,
+libsqlite3-dev, libicu-dev and libssl-dev. The collector uses system shared
+libraries: build against a compatible target Ubuntu release and ensure the target
+has the corresponding runtime libraries installed.
+EOF
+    exit 0
+fi
+[[ $# -le 1 ]] || { echo "Usage: $(basename "$0") [OUTPUT_DIR]" >&2; exit 1; }
+[[ "$(uname -s)" == Linux ]] || { echo "Build the collector on the target Linux system." >&2; exit 1; }
+case "$(uname -m)" in
+    x86_64) arch=x86_64 ;;
+    aarch64|arm64) arch=aarch64 ;;
+    *) echo "Unsupported Linux architecture: $(uname -m)" >&2; exit 1 ;;
+esac
+
+output_dir="${1:-$REPO_ROOT/dist/collectors}"
+build_dir="$REPO_ROOT/linux/build/collector-$arch"
+cmake -S "$REPO_ROOT/linux" -B "$build_dir" \
+    -DCMAKE_BUILD_TYPE=Release -DAGENTSPEED_BUILD_TESTS=OFF -DAGENTSPEED_BUILD_APP=OFF
+cmake --build "$build_dir" --config Release --target agentspeed-collector --parallel
+mkdir -p "$output_dir/linux-$arch"
+install -m 755 "$build_dir/collector/agentspeed-collector" "$output_dir/linux-$arch/agent-speed-collector"
+printf 'Collector artifact: %s\n' "$output_dir/linux-$arch/agent-speed-collector"
