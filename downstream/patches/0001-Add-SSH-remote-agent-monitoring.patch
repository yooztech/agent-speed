+#pragma once
+
+#include <memory>
+#include <string>
+
+#include "agentspeed/history_store.hpp"
+
+namespace collector {
+// An exclusive process lock protects the analyzer's in-memory ownership ledger as well as SQLite writes.
+class HistoryCache {
+public:
+    explicit HistoryCache(const std::string& home);
+    ~HistoryCache();
+    HistoryCache(const HistoryCache&) = delete;
+    HistoryCache& operator=(const HistoryCache&) = delete;
+    std::unique_ptr<agentspeed::history::Store> open(const std::string& identity) const;
