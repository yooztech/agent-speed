+                char buf[4096]; ssize_t n = read(c.fd.value, buf, sizeof(buf));
+                if (n <= 0) { if (n == 0 || (errno != EAGAIN && errno != EINTR)) c.dead = true; }
+                else {
+                    c.input.append(buf, static_cast<std::size_t>(n));
+                    if (c.input.size() > kInput) c.dead = true;
+                    std::size_t end;
+                    while (!c.dead && (end = c.input.find('\n')) != std::string::npos) {
