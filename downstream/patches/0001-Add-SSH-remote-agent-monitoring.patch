+import SwiftUI
+
+/// Remote data is deliberately presented separately from the local dashboard and its history.
+struct RemoteHostsView: View {
+    let remote: RemoteHosts
+    var body: some View {
+        if !remote.hosts.isEmpty {
+            VStack(alignment: .leading, spacing: 8) {
+                Text("REMOTE HOSTS").font(.caption.weight(.semibold)).foregroundStyle(.secondary)
+                ForEach(remote.hosts) { host in
+                    RemoteHostCard(host: host, state: remote.states[host.id] ?? RemoteHostState())
+                }
+            }
+        }
+    }
+}
+
+private struct RemoteHostCard: View {
+    let host: RemoteHost
+    let state: RemoteHostState
+    var body: some View {
+        VStack(alignment: .leading, spacing: 5) {
+            HStack {
+                Text(host.label.isEmpty ? host.destination : host.label).font(.headline)
+                Spacer()
+                Text(!host.enabled ? "DISABLED" : state.online ? "LIVE" : "OFFLINE · STALE")
+                    .font(.caption2.weight(.bold)).foregroundStyle(state.online ? Color.green : Color.secondary)
+            }
+            if let error = state.error, host.enabled { Text(error).font(.caption).foregroundStyle(.secondary) }
+            if let snapshot = state.snapshot {
+                Text("Today: \(snapshot.todayOutput.map(String.init) ?? "unknown") output · \(snapshot.todayInput.map(String.init) ?? "unknown") input · \(snapshot.todayRequests.map(String.init) ?? "unknown") requests")
+                    .font(.caption)
+                if let average = snapshot.todayAverage {
+                    Text("Today measured average: \(average.formatted(.number.precision(.fractionLength(1)))) tok/s")
+                        .font(.caption).foregroundStyle(.secondary)
+                } else { Text("Today measured average unknown").font(.caption).foregroundStyle(.secondary) }
+                if let now = snapshot.nowMs {
+                    Text("Sample: \(Date(timeIntervalSince1970: now / 1000).formatted())")
+                        .font(.caption2).foregroundStyle(.secondary)
+                }
+                if let rate = snapshot.liveOutput {
+                    Text("Live output: \(rate.formatted(.number.precision(.fractionLength(1)))) tok/s · estimate")
+                        .font(.caption).foregroundStyle(.secondary)
+                } else { Text("Live output speed unknown").font(.caption).foregroundStyle(.secondary) }
+                ForEach(snapshot.agents ?? []) { agent in
+                    HStack {
+                        Text(agent.source + (agent.model.map { " · " + $0 } ?? " · model unknown"))
+                        Spacer()
+                        Text(agent.phase).foregroundStyle(.secondary)
+                    }.font(.caption)
+                    if let rate = agent.liveOutput, agent.phase == "generating" {
+                        Text("\(rate.formatted(.number.precision(.fractionLength(1)))) tok/s · estimate")
+                            .font(.caption2).foregroundStyle(.secondary)
+                    } else if agent.phase == "generating" {
+                        Text("Live speed unknown").font(.caption2).foregroundStyle(.secondary)
+                    }
+                }
+            } else { Text("No remote snapshot yet").font(.caption).foregroundStyle(.secondary) }
+            if !state.completions.isEmpty {
+                DisclosureGroup("Recent completions") {
+                    ForEach(state.completions) { completion in
+                        HStack {
+                            Text("\(completion.source) · \(completion.output) output")
+                            Spacer()
+                            if let speed = completion.speed {
+                                Text("\(speed.formatted(.number.precision(.fractionLength(1)))) tok/s · measured")
+                            } else { Text("Speed unknown") }
+                        }.font(.caption)
+                    }
+                }.font(.caption)
+            }
+            if state.historyPartial == true {
+                Text("History incomplete · some files could not be read")
+                    .font(.caption).foregroundStyle(.secondary)
+            } else if state.historyPartial == nil {
+                Text("History completeness unknown")
+                    .font(.caption).foregroundStyle(.secondary)
+            } else if state.days.isEmpty {
+                Text("No history rows reported").font(.caption).foregroundStyle(.secondary)
+            }
