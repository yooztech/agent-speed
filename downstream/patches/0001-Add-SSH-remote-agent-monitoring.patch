+            }
+            tick = steady + std::chrono::seconds(1);
+        }
+        for (auto& reply : publisher.replies()) for (auto& [fd, c] : clients) if (c.id == reply.first && c.handshaken) { enqueue(c, std::move(reply.second)); break; }
+        for (auto& [fd, c] : clients) if (!c.handshaken && steady >= c.deadline) c.dead = true;
+        for (auto it = clients.begin(); it != clients.end();) { if (it->second.dead) { publisher.disconnected(it->second.id); it = clients.erase(it); } else ++it; }
+        if (!clients.empty() || publisher.authorized(now)) idle = steady;
+#ifdef AGENTSPEED_COLLECTOR_TESTING
+        else if (steady - idle >= std::chrono::seconds(1)) break;
+#else
+        else if (steady - idle >= std::chrono::seconds(30)) break;
+#endif
