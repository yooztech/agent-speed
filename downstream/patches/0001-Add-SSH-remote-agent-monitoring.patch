index 00000000..242462d6
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/RemoteHosts.swift
@@ -0,0 +1,243 @@
+import Foundation
+import Observation
+
+struct RemoteHost: Codable, Identifiable, Equatable {
+    var id: UUID = UUID()
+    var label: String
+    var destination: String
+    var enabled: Bool = false
+
+    // A destination is passed as one ssh argument, never interpolated into a shell command.
+    var validDestination: Bool {
+        !destination.isEmpty && !destination.hasPrefix("-") &&
+            destination.unicodeScalars.allSatisfy { CharacterSet.alphanumerics.union(CharacterSet(charactersIn: "._-@:")).contains($0) }
+    }
+}
+
+struct RemoteAgent: Decodable, Identifiable, Sendable {
+    let id: String
+    let source: String
+    let model: String?
+    let phase: String
+    let liveOutput: Double?
+    let liveTotal: Double?
+    let subagent: Bool
+    let parentId: String?
+    let lastLineMs: Double?
+}
+
+struct RemoteDay: Decodable, Identifiable, Sendable {
+    var id: String { "\(day)/\(source)" }
+    let day: String
+    let source: String
+    let requests: Int
+    let input: Int
+    let cachedInput: Int
+    let cacheWriteInput: Int
+    let output: Int
+    let reasoning: Int
+    let measuredOutput: Int
+    let measuredMs: Double
+    let peak: Double?
+}
+
+struct RemoteMessage: Decodable, Sendable {
+    let version: Int
+    let type: String
+    let nowMs: Double?
+    let todayOutput: Int?
+    let todayInput: Int?
+    let todayRequests: Int?
+    let todayAverage: Double?
+    let liveOutput: Double?
+    let liveTotal: Double?
+    let estimatedShare: Double?
+    let generating: Int?
+    let tools: Int?
+    let agents: [RemoteAgent]?
+    let days: [RemoteDay]?
+    let partial: Bool?
+    let source: String?
+    let output: Int?
+    let speed: Double?
+
+    static func decode(_ data: Data) -> RemoteMessage? {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        guard let message = try? decoder.decode(RemoteMessage.self, from: data), message.version == 1 else { return nil }
+        return message
+    }
+}
+
+struct RemoteCompletion: Identifiable {
+    let id = UUID()
+    let source: String
+    let output: Int
+    let speed: Double?
+}
+
+struct RemoteHostState {
+    var online = false
+    var snapshot: RemoteMessage?
+    var days: [RemoteDay] = []
+    var historyPartial: Bool?
+    var completions: [RemoteCompletion] = []
+    var error: String?
+
+    mutating func apply(_ message: RemoteMessage) {
+        if message.type == "snapshot" {
+            snapshot = message
+            online = true
+            error = nil
+        } else if message.type == "history", let replacement = message.days {
+            days = replacement
+            historyPartial = message.partial
+        } else if message.type == "completion", let source = message.source, let output = message.output {
+            completions.insert(RemoteCompletion(source: source, output: output, speed: message.speed), at: 0)
+            if completions.count > 10 { completions.removeLast() }
+        }
+    }
+}
+
+/// Each connection replaces its own snapshot and history; no remote values enter local accounting.
+@MainActor @Observable
+final class RemoteHosts {
+    private(set) var hosts: [RemoteHost]
+    private(set) var states: [UUID: RemoteHostState] = [:]
+    @ObservationIgnored private let defaults: UserDefaults
+    @ObservationIgnored private var workers: [UUID: RemoteSSHWorker] = [:]
+    @ObservationIgnored private var reconnects: [UUID: Task<Void, Never>] = [:]
+    private static let key = "remoteHosts.v1"
+
+    init(defaults: UserDefaults) {
+        self.defaults = defaults
+        hosts = defaults.data(forKey: Self.key).flatMap { try? JSONDecoder().decode([RemoteHost].self, from: $0) } ?? []
+    }
+
+    func start() { for host in hosts where host.enabled { connect(host) } }
+
+    func save(_ host: RemoteHost) {
+        guard host.validDestination else { return }
+        if let index = hosts.firstIndex(where: { $0.id == host.id }) { hosts[index] = host }
+        else { hosts.append(host) }
+        persist()
+        disconnect(host.id)
+        if host.enabled { connect(host) }
+    }
+
+    func remove(_ id: UUID) {
+        disconnect(id)
+        hosts.removeAll { $0.id == id }
+        states.removeValue(forKey: id)
+        persist()
+    }
+
+    private func persist() { defaults.set(try? JSONEncoder().encode(hosts), forKey: Self.key) }
+
+    private func disconnect(_ id: UUID) {
+        reconnects.removeValue(forKey: id)?.cancel()
+        workers.removeValue(forKey: id)?.stop()
+        states[id, default: RemoteHostState()].online = false
+    }
+
+    private func connect(_ host: RemoteHost) {
+        guard host.validDestination, workers[host.id] == nil else { return }
+        let worker = RemoteSSHWorker(destination: host.destination) { [weak self] event in
+            Task { @MainActor [weak self] in self?.receive(event, host: host) }
+        }
+        workers[host.id] = worker
+        states[host.id, default: RemoteHostState()].error = nil
+        worker.start()
+    }
+
+    private func receive(_ event: RemoteSSHWorker.Event, host: RemoteHost) {
+        guard let worker = workers[host.id], worker.token == event.token else { return }
+        switch event.payload {
+        case .message(let message):
+            states[host.id, default: RemoteHostState()].apply(message)
+        case .ended(let reason):
+            workers.removeValue(forKey: host.id)
+            states[host.id, default: RemoteHostState()].online = false
+            states[host.id, default: RemoteHostState()].error = reason
+            reconnects[host.id] = Task { [weak self] in
+                try? await Task.sleep(for: .seconds(10))
+                guard !Task.isCancelled, let self, let current = self.hosts.first(where: { $0.id == host.id }), current.enabled else { return }
+                self.reconnects.removeValue(forKey: host.id)
+                self.connect(current)
+            }
+        }
+    }
+}
+
+/// All commands are fixed strings. Authentication and host-key policy belong to the user's ssh configuration.
+final class RemoteSSHWorker: @unchecked Sendable {
+    enum Payload: Sendable { case message(RemoteMessage), ended(String) }
+    struct Event: Sendable { let token: UUID; let payload: Payload }
+    let token = UUID()
+    private let destination: String
+    private let callback: @Sendable (Event) -> Void
+    private let lock = NSLock()
+    private var process: Process?
+    private var stopped = false
+
+    init(destination: String, callback: @escaping @Sendable (Event) -> Void) {
+        self.destination = destination
+        self.callback = callback
+    }
+    func start() { Thread.detachNewThread { [self] in run() } }
+    func stop() {
+        lock.lock(); stopped = true; let running = process; lock.unlock()
+        if running?.isRunning == true { running?.terminate() }
+    }
+    static func arguments(destination: String, command: String) -> [String] {
+        ["-T", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", destination, command]
+    }
+    private func launch(_ command: String, input: Data? = nil) throws -> (Process, Pipe) {
+        let p = Process(); p.executableURL = URL(fileURLWithPath: "/usr/bin/ssh")
+        p.arguments = Self.arguments(destination: destination, command: command)
+        let output = Pipe(); p.standardOutput = output
+        p.standardError = FileHandle.nullDevice
+        let stdin = Pipe(); p.standardInput = stdin
+        lock.lock()
+        if stopped { lock.unlock(); throw CocoaError(.userCancelled) }
+        process = p
+        do { try p.run() } catch { lock.unlock(); throw error }
+        lock.unlock()
+        if let input { try stdin.fileHandleForWriting.write(contentsOf: input); try stdin.fileHandleForWriting.close() }
+        return (p, output)
+    }
+    private func run() {
+        defer {
+            lock.lock(); let running = process; process = nil; lock.unlock()
+            if running?.isRunning == true { running?.terminate() }
+        }
+        do {
+            let (probe, probeOutput) = try launch("uname -m")
+            let archData = probeOutput.fileHandleForReading.readDataToEndOfFile(); probe.waitUntilExit()
+            guard probe.terminationStatus == 0, let name = String(data: archData, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines) else { throw Failure("SSH connection failed; check host key and authentication") }
+            let arch: String
+            switch name { case "x86_64": arch = "x86_64"; case "aarch64", "arm64": arch = "aarch64"; default: throw Failure("Unsupported remote architecture") }
+            guard let resource = Bundle.main.resourceURL?.appendingPathComponent("collectors/linux-\(arch)/agent-speed-collector"), let binary = try? Data(contentsOf: resource) else { throw Failure("Linux collector for \(arch) is missing from this application") }
+            let (upload, uploadOutput) = try launch("umask 077; mkdir -p ~/.cache/agent-speed && f=~/.cache/agent-speed/collector-$$ && cat > \"$f\" && chmod 700 \"$f\" && mv -f \"$f\" ~/.cache/agent-speed/collector", input: binary)
+            _ = uploadOutput.fileHandleForReading.readDataToEndOfFile(); upload.waitUntilExit()
+            guard upload.terminationStatus == 0 else { throw Failure("Collector upload failed") }
+            let (collector, output) = try launch("exec ~/.cache/agent-speed/collector")
+            var buffer = Data()
+            while true {
+                let chunk = output.fileHandleForReading.availableData
+                if chunk.isEmpty { break }
+                buffer.append(chunk)
+                while let newline = buffer.firstIndex(of: 10) {
+                    let line = Data(buffer[..<newline]); buffer.removeSubrange(...newline)
+                    if let message = RemoteMessage.decode(line) { callback(Event(token: token, payload: .message(message))) }
+                }
+                if buffer.count > 4_194_304 { throw Failure("Collector sent an oversized message") }
+            }
+            collector.waitUntilExit()
+            throw Failure("Disconnected; retrying")
+        } catch {
+            callback(Event(token: token, payload: .ended((error as? Failure)?.message ?? "SSH connection failed")))
+        }
+    }
+    private struct Failure: Error { let message: String; init(_ message: String) { self.message = message } }
+}
