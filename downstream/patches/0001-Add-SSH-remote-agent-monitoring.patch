index 00000000..959c1025
--- /dev/null
+++ b/linux/tests/shared_collector_ssh_smoke.py
@@ -0,0 +1,700 @@
+#!/usr/bin/env python3
+"""Root-only isolated SSH/TLS acceptance. Run after building the test collector.
+
+sudo python3 linux/tests/shared_collector_ssh_smoke.py --collector /absolute/path/build-shared/collector/agentspeed-collector-ssh-smoke
+Requires ssh, sshd, ssh-keygen, openssl, useradd, userdel, chpasswd and /proc.
+The collector must be built with its test relay pointing at https://localhost:19443
+and its CA bundle set to /tmp/agent-speed-shared-ca.pem. That path must not exist.
+No system SSH service or configuration is modified. Output is JSON, without credentials.
+"""
+import argparse
+import datetime
+import hashlib
+import http.server
+import json
+import os
+import math
+import pathlib
+import pwd
+import queue
+import secrets
+import shutil
+import stat
+import signal
+import socket
+import ssl
+import struct
+import subprocess
+import tempfile
+import threading
+import time
+
+CA = pathlib.Path('/tmp/agent-speed-shared-ca.pem')
+ORIGIN = 'https://agent-speed.yooztech.com'
+HOST_ID, HOST_NAME = 'smoke-host-id', 'Smoke Host'
+FIELDS = {'version', 'hostId', 'hostName', 'sampledAt', 'status', 'speed', 'generating', 'tools', 'todayOutput', 'rxBytesPerSecond', 'txBytesPerSecond', 'title'}
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def command(*args, **kwargs):
+    return subprocess.run(args, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)
+
+
+def eventually(fn, timeout, message):
+    end = time.monotonic() + timeout
+    while time.monotonic() < end:
+        value = fn()
+        if value:
+            return value
+        time.sleep(.1)
+    raise AssertionError(message)
+
+
+class Relay(http.server.ThreadingHTTPServer):
+    daemon_threads = True
+    allow_reuse_address = True
+
+    def __init__(self, port):
+        super().__init__(('127.0.0.1', port), Handler)
+        self.lock = threading.Lock()
+        self.tokens = {}
+        self.records = []
+        self.errors = []
+        self.responses = {}
+        self.gates = {}
+        self.retry_after = {}
+        self.activities = {}
+        self.last_success = {}
+        self.last_sample = {}
+ 
+    def register(self, token, label, statuses=(200,), activity=None):
+        with self.lock:
+            activity = activity or label
+            old = self.activities.get(activity)
+            if old is not None:
+                self.tokens.pop(old, None)
+            self.activities[activity] = token
+            self.tokens[token] = (label, activity)
+            self.responses[label] = list(statuses)
+
+
+    def count(self, label):
+        with self.lock:
+            return sum(r['lease'] == label for r in self.records)
+
+    def snapshot(self):
+        with self.lock:
+            return list(self.records), list(self.errors)
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def do_POST(self):
+        relay = self.server
+        now = time.time()
+        status = 400
+        gate = None
+        retry_after = 1
+        try:
+            require(self.path == '/v1/publish', 'unexpected relay path')
+            require(self.headers.get_content_type() == 'application/json', 'unexpected content type')
+            length = int(self.headers.get('Content-Length', '0'))
+            require(0 < length <= 4096, 'invalid body length')
+            auth = self.headers.get('Authorization', '')
+            with relay.lock:
+                binding = relay.tokens.get(auth.removeprefix('Bearer ')) if auth.startswith('Bearer ') else None
+            require(binding is not None, 'unexpected or revoked authorization')
+            label, activity = binding
+            body = json.loads(self.rfile.read(length))
+            require(isinstance(body, dict) and set(body) == {'snapshot'}, 'unexpected envelope')
+            snap = body['snapshot']
+            require(isinstance(snap, dict) and set(snap) == FIELDS, 'unexpected snapshot fields')
+            require(snap['version'] == 1 and snap['hostId'] == HOST_ID and snap['hostName'] == HOST_NAME and snap['status'] == 'live', 'wrong snapshot identity')
+            ts = snap['sampledAt']
+            require(type(ts) is int and 0 <= now * 1000 - ts <= 30000, 'stale or future sample')
+            with relay.lock:
+                require(relay.tokens.get(auth.removeprefix('Bearer ')) == binding, 'revoked authorization')
+                prior = [r for r in relay.records if r['lease'] == label]
+                require(not prior or now - prior[-1]['receivedAt'] >= 9.8, 'publisher retried too quickly')
+                require(ts > relay.last_sample.get(activity, 0), 'activity sample timestamp did not increase')
+                relay.last_sample[activity] = ts
+                statuses = relay.responses[label]
+                last = relay.last_success.get(activity)
+                if last is not None and now - last < 10:
+                    status = 429
+                    retry_after = max(1, math.ceil(10 - (now - last)))
+                else:
+                    status = statuses.pop(0) if len(statuses) > 1 else statuses[0]
+                    if 200 <= status < 300:
+                        relay.last_success[activity] = now
+                if status == 429 and activity in relay.retry_after:
+                    retry_after = relay.retry_after[activity]
+                relay.records.append({'lease': label, 'activity': activity, 'sampledAt': ts, 'receivedAt': now, 'status': status, 'retryAfter': retry_after if status == 429 else None})
+                gate = relay.gates.get(label)
+        except Exception as exc:
+            with relay.lock:
+                relay.errors.append(str(exc))
+        if gate:
+            gate.wait(8)
+        if status == -1:
+            self.connection.shutdown(socket.SHUT_RDWR)
+            self.connection.close()
+            return
+        try:
+            self.send_response(status)
+            if status == 429:
+                self.send_header('Retry-After', str(retry_after))
+            self.send_header('Content-Length', '0')
+            self.end_headers()
+        except (BrokenPipeError, ConnectionResetError):
+            pass
+
+
+class Client:
+    def __init__(self, ssh, user, port, key, executable, slow=False):
+        self.messages = queue.Queue(maxsize=4096)
+        self.stderr = bytearray()
