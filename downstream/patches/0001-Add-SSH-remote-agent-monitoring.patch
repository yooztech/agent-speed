+};
+
+struct Sample {
+    agentspeed::Snapshot snapshot;
+};
+
+// All public methods are called by the collection thread. History analysis runs in the background.
+class Sampler {
+public:
+    Sampler(const std::string& home, const std::string& digest);
+    ~Sampler();
+    Sampler(const Sampler&) = delete;
