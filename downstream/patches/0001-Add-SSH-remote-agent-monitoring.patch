+constexpr std::size_t kInput = 16384, kOutput = 1024 * 1024, kClients = 64;
+volatile sig_atomic_t stopping = 0;
+void stop(int) { stopping = 1; }
+std::int64_t nowMs() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count(); }
+using Clock = std::chrono::steady_clock;
+struct SafeError : std::runtime_error { using std::runtime_error::runtime_error; };
+void fail(const char* category) { throw SafeError(category); }
+void protectCredentials() {
+    const rlimit limit{0, 0};
+    if (setrlimit(RLIMIT_CORE, &limit)) fail("core dump protection");
