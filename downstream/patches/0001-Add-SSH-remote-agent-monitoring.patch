+            if p.stat().st_uid != uid:
+                continue
+            target = os.readlink(p / 'exe')
+            if executable is None or os.path.realpath(target.removesuffix(' (deleted)')) == os.path.realpath(executable):
+                result.append(int(p.name))
+        except (OSError, ProcessLookupError):
+            pass
+    return result
