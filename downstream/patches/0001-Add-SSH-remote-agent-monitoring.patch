@@ -0,0 +1,92 @@
+import Foundation
+import Testing
+@testable import AgentSpeed
+
+@Suite("Remote hosts")
+struct RemoteHostsTests {
+    private func message(_ text: String) -> RemoteMessage? { RemoteMessage.decode(Data(text.utf8)) }
+
+    @Test func protocolVersionAndUnknownValues() throws {
+        let snapshot = try #require(message(#"{"version":1,"type":"snapshot","now_ms":42,"today_average":null,"live_output":null,"agents":[{"id":"1","source":"pi","model":null,"phase":"generating","live_output":null,"live_total":0,"subagent":false,"parent_id":null,"last_line_ms":null}]}"#))
+        #expect(snapshot.todayAverage == nil)
+        #expect(snapshot.liveOutput == nil)
+        #expect(snapshot.agents?.first?.model == nil)
+        #expect(snapshot.agents?.first?.liveOutput == nil)
+        #expect(message(#"{"version":2,"type":"snapshot"}"#) == nil)
+    }
+
+    @Test func historyReplacementAndIsolation() throws {
+        let first = try #require(message(#"{"version":1,"type":"history","days":[{"day":"2026-01-01","source":"pi","requests":1,"input":10,"cached_input":2,"cache_write_input":0,"output":5,"reasoning":0,"measured_output":5,"measured_ms":1000,"peak":5}]}"#))
+        let empty = try #require(message(#"{"version":1,"type":"history","days":[]}"#))
+        let snapshot = try #require(message(#"{"version":1,"type":"snapshot","today_output":5}"#))
+        var a = RemoteHostState(); var b = RemoteHostState()
+        a.apply(first); b.apply(first); a.apply(first)
+        #expect(a.days.count == 1)
+        a.apply(empty)
+        #expect(a.days.isEmpty)
+        #expect(b.days.count == 1)
+        a.apply(snapshot)
+        #expect(a.online)
+        a.online = false
+        #expect(a.snapshot?.todayOutput == 5)
+        a.apply(snapshot)
+        #expect(a.online)
+        #expect(a.days.isEmpty)
+    }
+
+    @Test func partialHistoryReplacesCompletenessPerHost() throws {
+        let partial = try #require(message(#"{"version":1,"type":"history","days":[],"partial":true}"#))
+        let complete = try #require(message(#"{"version":1,"type":"history","days":[],"partial":false}"#))
+        let unspecified = try #require(message(#"{"version":1,"type":"history","days":[]}"#))
+        var a = RemoteHostState(); var b = RemoteHostState()
+        a.apply(partial); b.apply(complete)
+        #expect(a.historyPartial == true)
+        #expect(b.historyPartial == false)
+        a.apply(complete)
+        #expect(a.historyPartial == false)
+        a.apply(unspecified)
+        #expect(a.historyPartial == nil)
+    }
+
+    @Test func completionsAreMeasuredIsolatedAndBounded() throws {
+        let measured = try #require(message(#"{"version":1,"type":"completion","source":"pi","output":123,"speed":12.5}"#))
+        let unknown = try #require(message(#"{"version":1,"type":"completion","source":"pi","output":7,"speed":null}"#))
+        var first = RemoteHostState(); let second = RemoteHostState()
+        for _ in 0..<12 { first.apply(measured) }
+        first.apply(unknown)
+        #expect(first.completions.count == 10)
+        #expect(first.completions[0].speed == nil)
+        #expect(first.completions[1].speed == 12.5)
+        #expect(first.completions[1].output == 123)
+        #expect(second.completions.isEmpty)
+    }
+
+    @Test func sshUsesBoundedLivenessAndHostPolicy() {
+        let arguments = RemoteSSHWorker.arguments(destination: "server", command: "uname -m")
+        #expect(arguments.contains("ServerAliveInterval=15"))
+        #expect(arguments.contains("ServerAliveCountMax=3"))
+        #expect(!arguments.contains { $0.lowercased().contains("stricthostkeychecking") })
+        #expect(arguments.suffix(2) == ["server", "uname -m"])
+    }
+
+    @Test func destinationsAreSingleSafeArguments() {
+        #expect(RemoteHost(label: "", destination: "user@server.example").validDestination)
+        #expect(!RemoteHost(label: "", destination: "-oProxyCommand=x").validDestination)
+        #expect(!RemoteHost(label: "", destination: "server; touch file").validDestination)
+        #expect(!RemoteHost(label: "", destination: "").validDestination)
+    }
+
+    @MainActor @Test func hostConfigurationPersistsStableIds() throws {
+        let suite = "remote-host-tests-\(UUID())"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let hosts = RemoteHosts(defaults: defaults)
+        let host = RemoteHost(label: "Server", destination: "server")
+        hosts.save(host)
+        let restored = RemoteHosts(defaults: defaults)
+        #expect(restored.hosts == [host])
+        #expect(restored.hosts.first?.enabled == false)
+        restored.remove(host.id)
+        #expect(RemoteHosts(defaults: defaults).hosts.isEmpty)
+    }
+}
