+TEST(CollectorIntegration, GrokWithoutInFlightStartHasUnknownLiveRates) {
+    constexpr std::int64_t base = 1792497600000;
+    constexpr std::int64_t dayStart = 1792454400000;
+    char home[] = "/tmp/agentspeed-grok-rate-test-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    const auto sessions = std::filesystem::path(home) / "sessions";
+    const auto dir = sessions / "work/one";
+    std::filesystem::create_directories(dir);
+    std::ofstream(dir / "summary.json") << R"({"info":{"id":"one","cwd":"/projects/nova"},"current_model_id":"grok-4.5"})";
+    std::ofstream(dir / "updates.jsonl");
+
+    agentspeed::RootSettings settings;
+    settings.grokBuild = sessions.string();
+    agentspeed::MonitorConfig config;
+    config.locations = agentspeed::SourceLocations::resolve(settings, agentspeed::processEnvironment(), "/nonexistent-home");
+    config.enabled = {agentspeed::SourceKind::GrokBuild};
+    agentspeed::Monitor monitor(std::move(config));
+    monitor.start(base + 1000, dayStart);
+    std::ofstream(dir / "updates.jsonl", std::ios::app)
+        << R"({"timestamp":1792497603,"method":"_x.ai/session/update","params":{"sessionId":"one","update":{"sessionUpdate":"tool_call_update","status":"completed"},"_meta":{"agentTimestampMs":1792497603000}}})" << '\n';
+    monitor.poll(base + 5000, dayStart);
+    ASSERT_EQ(monitor.agents().size(), 1u);
+    const auto& agent = monitor.agents().begin()->second;
+    EXPECT_EQ(agent.phase, agentspeed::Phase::Generating);
+    EXPECT_FALSE(agent.inFlightStartMs.has_value());
+
+    collector::Protocol protocol;
+    agentspeed::json::Document doc;
+    const auto wire = protocol.snapshot(monitor.snapshot(base + 5000, dayStart));
+    ASSERT_TRUE(doc.parse(wire));
+    const auto root = doc.root();
+    EXPECT_TRUE(root["live_output"].isNull());
+    EXPECT_TRUE(root["live_total"].isNull());
+    ASSERT_EQ(root["agents"].size(), 1u);
+    EXPECT_EQ(root["agents"].at(0)["phase"].string(), "generating");
+    EXPECT_TRUE(root["agents"].at(0)["live_output"].isNull());
+    EXPECT_TRUE(root["agents"].at(0)["live_total"].isNull());
+    std::filesystem::remove_all(home);
+}
