diff --git a/linux/collector/history_cache.cpp b/linux/collector/history_cache.cpp
new file mode 100644
index 00000000..571e0e2b
--- /dev/null
+++ b/linux/collector/history_cache.cpp
@@ -0,0 +1,77 @@
+#include "history_cache.hpp"
+
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace collector {
+namespace {
+bool safeDirectory(int fd, bool privateDirectory) {
+    struct stat st{};
+    return fd >= 0 && fstat(fd, &st) == 0 && S_ISDIR(st.st_mode) && st.st_uid == geteuid() &&
+           !(st.st_mode & (privateDirectory ? 0077 : 0022));
+}
+bool safeFile(int fd) {
+    struct stat st{};
+    return fd >= 0 && fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == geteuid() &&
+           st.st_nlink == 1 && !(st.st_mode & 0077);
+}
+}
+HistoryCache::HistoryCache(const std::string& home) {
+    if (home.empty() || home.front() != '/') return;
+    const int root = ::open(home.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (!safeDirectory(root, false)) { if (root >= 0) close(root); return; }
+    if (mkdirat(root, ".cache", 0700) < 0 && errno != EEXIST) { close(root); return; }
+    const int cache = openat(root, ".cache", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    close(root);
+    if (!safeDirectory(cache, false)) { if (cache >= 0) close(cache); return; }
+    if (mkdirat(cache, "agentspeed-collector", 0700) < 0 && errno != EEXIST) { close(cache); return; }
+    dir_ = openat(cache, "agentspeed-collector", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    close(cache);
+    if (!safeDirectory(dir_, true)) { if (dir_ >= 0) close(dir_); dir_ = -1; return; }
+    lock_ = openat(dir_, "history.lock", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (!safeFile(lock_) || flock(lock_, LOCK_EX | LOCK_NB) < 0) {
+        if (lock_ >= 0) close(lock_);
+        lock_ = -1;
+        return;
+    }
+    const int db = openat(dir_, "history.sqlite3", O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (!safeFile(db)) { if (db >= 0) close(db); return; }
+    close(db);
+    path_ = home + "/.cache/agentspeed-collector/history.sqlite3";
+}
+HistoryCache::~HistoryCache() {
+    if (lock_ >= 0) close(lock_);
+    if (dir_ >= 0) close(dir_);
+}
+std::unique_ptr<agentspeed::history::Store> HistoryCache::open(const std::string& identity) const {
+    if (!path_.empty()) {
+        try {
+            auto store = agentspeed::history::Store::open(path_);
+            const auto existing = store->meta("collectorIdentity");
+            if (!existing) store->setMeta("collectorIdentity", identity);
+            else if (*existing != identity) {
+                store.reset();
+                for (const char* name : {"history.sqlite3", "history.sqlite3-wal", "history.sqlite3-shm"}) {
+                    if (unlinkat(dir_, name, 0) < 0 && errno != ENOENT)
+                        return agentspeed::history::Store::open(":memory:");
+                }
+                const int db = openat(dir_, "history.sqlite3", O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+                if (!safeFile(db)) {
+                    if (db >= 0) close(db);
+                    return agentspeed::history::Store::open(":memory:");
+                }
+                close(db);
+                store = agentspeed::history::Store::open(path_);
+                store->setMeta("collectorIdentity", identity);
+            }
+            return store;
+        } catch (...) {
+            // A cache is optional; the collector must still operate when it is unavailable or corrupt.
+        }
+    }
+    return agentspeed::history::Store::open(":memory:");
+}
+}
