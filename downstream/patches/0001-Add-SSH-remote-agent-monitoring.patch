+            result = {'passed': False, 'error': str(exc), 'exception': type(exc).__name__, 'scenarios': results, 'relay': {'requests': records, 'validationErrors': errors}, 'diagnostics': diagnostics, 'seconds': round(time.monotonic()-start, 3)}
