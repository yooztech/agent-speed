+TEST(CollectorIntegration, AppendsMetricsWithoutLeakingContentAndStopsOnEof) {
+    char home[] = "/tmp/agentspeed-collector-test-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-private-project";
+    std::filesystem::create_directories(dir);
+    const auto file = dir / "2026-10-20T10-48-00-000Z_01a158ec-db00-75e2-83a6-00013c6ef362.jsonl";
+    const auto now = std::time(nullptr);
+    std::tm utc{};
+    gmtime_r(&now, &utc);
+    char stamp[32];
+    std::strftime(stamp, sizeof(stamp), "%Y-%m-%dT%H:%M:%S.000Z", &utc);
+    {
+        std::ofstream out(file);
+        out << "{\"type\":\"session\",\"version\":3,\"id\":\"01a158ec-db00-75e2-83a6-00013c6ef362\",\"timestamp\":\"" << stamp << "\",\"cwd\":\"/private-project\"}\n";
+    }
+    int input[2], output[2];
+    ASSERT_EQ(pipe(input), 0);
+    ASSERT_EQ(pipe(output), 0);
+    const auto pid = fork();
+    ASSERT_GE(pid, 0);
+    if (pid == 0) {
+        dup2(input[0], STDIN_FILENO);
+        dup2(output[1], STDOUT_FILENO);
+        close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+        setenv("HOME", home, 1);
+        unsetenv("PI_CODING_AGENT_DIR"); unsetenv("PI_CONFIG_DIR");
+        execl(AGENTSPEED_COLLECTOR_PATH, AGENTSPEED_COLLECTOR_PATH, nullptr);
+        _exit(127);
+    }
+    close(input[0]); close(output[1]);
+    std::string data;
+    bool initial = false, completion = false, changed = false;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(25);
+    std::size_t consumed = 0;
+    while (std::chrono::steady_clock::now() < deadline && !(completion && changed)) {
+        pollfd fd{output[0], POLLIN, 0};
+        if (poll(&fd, 1, 1000) <= 0) continue;
+        char bytes[8192];
+        const auto n = read(output[0], bytes, sizeof(bytes));
+        if (n <= 0) break;
+        data.append(bytes, static_cast<std::size_t>(n));
+        std::size_t end;
+        while ((end = data.find('\n', consumed)) != std::string::npos) {
+            const auto line = data.substr(consumed, end - consumed);
+            consumed = end + 1;
+            agentspeed::json::Document doc;
+            if (!doc.parse(line)) continue;
+            const auto root = doc.root();
+            if (root["type"].string() == "snapshot") {
+                if (!initial) {
+                    initial = true;
+                    std::ofstream out(file, std::ios::app);
+                    out << "{\"type\":\"message\",\"id\":\"private-id\",\"parentId\":null,\"timestamp\":\"" << stamp
+                        << "\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"private-prompt-marker\"}],\"api\":\"openai-responses\",\"provider\":\"openai\",\"model\":\"gpt-5.5\",\"usage\":{\"input\":300,\"output\":410,\"cacheRead\":0,\"cacheWrite\":0,\"totalTokens\":710},\"stopReason\":\"stop\",\"timestamp\":" << static_cast<long long>(now) * 1000 << ",\"duration\":3000}}\n";
+                } else if (root["today_output"].count() >= 410) changed = true;
+            } else if (root["type"].string() == "completion" && root["output"].count() == 410) completion = true;
+        }
+    }
+    close(input[1]);
+    int status = 0;
+    bool exited = false;
+    for (int i = 0; i < 50; ++i) {
+        if (waitpid(pid, &status, WNOHANG) == pid) { exited = true; break; }
+        usleep(100000);
+    }
+    if (!exited) { kill(pid, SIGKILL); waitpid(pid, &status, 0); }
+    close(output[0]);
+    std::filesystem::remove_all(home);
+    EXPECT_TRUE(initial);
+    EXPECT_TRUE(completion);
+    EXPECT_TRUE(changed);
+    EXPECT_TRUE(exited);
+    if (exited) EXPECT_TRUE(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    EXPECT_EQ(data.find("private-prompt-marker"), std::string::npos);
+    EXPECT_EQ(data.find("private-project"), std::string::npos);
+    EXPECT_EQ(data.find("private-id"), std::string::npos);
+}
+
+TEST(CollectorIntegration, EofInterruptsBlockedOutput) {
+    char home[] = "/tmp/agentspeed-collector-full-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    int input[2], output[2];
+    ASSERT_EQ(pipe(input), 0);
+    ASSERT_EQ(pipe(output), 0);
+    ASSERT_GE(fcntl(output[1], F_SETFL, O_NONBLOCK), 0);
+    char buffer[4096]{};
+    while (write(output[1], buffer, sizeof(buffer)) > 0) {}
+    ASSERT_EQ(errno, EAGAIN);
+    const auto pid = fork();
+    ASSERT_GE(pid, 0);
+    if (pid == 0) {
+        dup2(input[0], STDIN_FILENO);
+        dup2(output[1], STDOUT_FILENO);
+        close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+        setenv("HOME", home, 1);
+        unsetenv("PI_CODING_AGENT_DIR"); unsetenv("PI_CONFIG_DIR");
+        execl(AGENTSPEED_COLLECTOR_PATH, AGENTSPEED_COLLECTOR_PATH, nullptr);
+        _exit(127);
+    }
+    close(input[0]); close(output[1]);
+    usleep(500000);
+    close(input[1]);
+    int status = 0;
+    bool exited = false;
+    for (int i = 0; i < 100; ++i) {
+        if (waitpid(pid, &status, WNOHANG) == pid) { exited = true; break; }
+        usleep(100000);
+    }
+    if (!exited) { kill(pid, SIGKILL); waitpid(pid, &status, 0); }
+    close(output[0]);
+    std::filesystem::remove_all(home);
+    EXPECT_TRUE(exited);
+    if (exited) EXPECT_TRUE(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
