+    std::map<int, Client> clients; std::uint64_t nextId = 1;
+    auto tick = Clock::now(); auto idle = Clock::now();
+    while (!stopping) {
+        auto now = nowMs(); auto steady = Clock::now();
+        if (steady >= tick) {
+            sampler.poll(now);
+            for (auto& [fd, c] : clients) if (c.handshaken && !c.dead) {
+                auto sample = sampler.sample(now, c.view);
+                enqueue(c, protocol.snapshot(sample.snapshot, c.view.name, c.view.zone), true);
+                // Compare the projection's generation before reading its text: a replacement
+                // that lands in between can then only cause one redundant resend, never a
+                // skipped projection, and the unchanged case copies nothing.
+                const auto historyGeneration = sampler.historyGeneration(c.view);
+                if (historyGeneration != c.historyGeneration) {
+                    auto history = sampler.history(c.view);
+                    if (!history.empty()) { c.historyGeneration = historyGeneration; enqueue(c, std::move(history), false, true); }
+                }
+            }
+            for (const auto& view : publisher.views()) { auto sample = sampler.sample(now, view); publisher.sample(view, sample); }
+            auto completions = sampler.takeCompletions();
+            for (const auto& completion : completions) {
+                auto line = Protocol::completion(completion);
