+                auto& frame = c.output.front(); ssize_t n = write(c.fd.value, frame.data.data() + frame.offset, frame.data.size() - frame.offset);
+                if (n > 0) { frame.offset += static_cast<std::size_t>(n); c.bytes -= static_cast<std::size_t>(n); if (frame.offset == frame.data.size()) c.output.pop_front(); }
+                else if (n < 0 && errno != EAGAIN && errno != EINTR) c.dead = true;
+            }
+        }
+    }
+    bool valid = false; if (socketValid(p, valid) && valid) unlinkat(p.directory.value, "collector.sock", 0);
+}
+void startDaemon(const Paths& p, Fd& lock, const std::string& hash) {
+    int pipefd[2]; if (pipe2(pipefd, O_CLOEXEC)) fail("readiness"); Fd rd(pipefd[0]), wr(pipefd[1]);
+    pid_t child = fork(); if (child < 0) fail("detach");
+    if (child == 0) {
+        close(rd.value);
+        if (setsid() < 0) _exit(1);
+        pid_t grandchild = fork(); if (grandchild < 0) _exit(1); if (grandchild > 0) _exit(0);
+        int nullfd = open("/dev/null", O_RDWR); if (nullfd < 0) _exit(1);
+        for (int i = 0; i < 3; ++i) if (dup2(nullfd, i) < 0) _exit(1);
+        long maxfd = sysconf(_SC_OPEN_MAX); if (maxfd < 0) maxfd = 65536;
+        for (int fd = 3; fd < maxfd; ++fd) if (fd != wr.value && fd != lock.value && fd != p.directory.value) close(fd);
+        try { serve(p, lock.value, wr.value, hash); } catch (...) { _exit(1); }
+        _exit(0);
+    }
+    close(wr.value); wr.value = -1;
+    int status = 0; while (waitpid(child, &status, 0) < 0 && errno == EINTR) {}
+    pollfd f{rd.value, POLLIN, 0}; int r; do { r = poll(&f, 1, 15000); } while (r < 0 && errno == EINTR);
+    char ready = 0; if (r <= 0 || read(rd.value, &ready, 1) != 1 || ready != 'R') fail("daemon readiness");
+}
+int bridge(Fd& socket) {
+    if (!nonblock(STDIN_FILENO) || !nonblock(STDOUT_FILENO) || !nonblock(socket.value)) fail("bridge descriptors");
+    std::string input, output; bool eof = false;
+    while (true) {
+        pollfd fds[3]{{STDIN_FILENO, static_cast<short>(!eof && input.size() < kInput ? POLLIN : 0), 0}, {socket.value, static_cast<short>((output.size() < kOutput ? POLLIN : 0) | (!input.empty() ? POLLOUT : 0)), 0}, {STDOUT_FILENO, static_cast<short>(!output.empty() ? POLLOUT : 0), 0}};
+        int r = poll(fds, 3, -1); if (r < 0) { if (errno == EINTR) continue; fail("bridge poll"); }
+        if (fds[0].revents & (POLLIN | POLLHUP)) { char buf[4096]; ssize_t n = read(0, buf, std::min(sizeof(buf), kInput - input.size())); if (n > 0) input.append(buf, static_cast<std::size_t>(n)); else if (n == 0) eof = true; else if (errno != EINTR && errno != EAGAIN) fail("bridge input"); }
+        if ((fds[1].revents & POLLOUT) && !input.empty()) { ssize_t n = write(socket.value, input.data(), input.size()); if (n > 0) input.erase(0, static_cast<std::size_t>(n)); else if (n < 0 && errno != EINTR && errno != EAGAIN) fail("bridge socket"); }
+        if (eof && input.empty()) return 0;
+        if (fds[1].revents & (POLLIN | POLLHUP)) { char buf[4096]; ssize_t n = read(socket.value, buf, std::min(sizeof(buf), kOutput - output.size())); if (n > 0) output.append(buf, static_cast<std::size_t>(n)); else if (n == 0) { std::cerr << "collector: stream interrupted/incomplete\n"; return 1; } else if (errno != EINTR && errno != EAGAIN) fail("stream interrupted/incomplete"); }
+        if ((fds[2].revents & POLLOUT) && !output.empty()) { ssize_t n = write(1, output.data(), output.size()); if (n > 0) output.erase(0, static_cast<std::size_t>(n)); else if (n < 0 && errno != EINTR && errno != EAGAIN) fail("bridge output"); }
+        if ((fds[0].revents | fds[1].revents | fds[2].revents) & (POLLERR | POLLNVAL)) fail("stream interrupted/incomplete");
+    }
+}
+} // namespace
+int printIdentity() { std::cout << "shared-collector-v2 " << identity() << '\n'; return 0; }
+int runBridge() {
+    signal(SIGPIPE, SIG_IGN);
+    try {
+        protectCredentials();
+        auto hash = identity(); auto p = paths(hash); Fd lock = lockFile(p); Fd connection;
+        if (flock(lock.value, LOCK_EX | LOCK_NB) == 0) {
+            connection = connectSocket(p);
+            if (connection.value >= 0) fail("runtime busy");
+            startDaemon(p, lock, hash);
+            connection = connectSocket(p);
+        } else if (errno == EWOULDBLOCK) {
+            for (int i = 0; i < 150 && connection.value < 0; ++i) { connection = connectSocket(p); if (connection.value < 0) usleep(100000); }
+        } else fail("runtime lock");
+        if (connection.value < 0) fail("daemon connection");
+        // The daemon inherited the open-file description; release our duplicate without unlocking it.
+        lock = Fd();
+        if (!writeAll(connection.value, "shared-collector-v2 " + hash + "\n")) fail("daemon handshake");
+        auto response = readLine(connection.value, 5000);
+        if (!response || *response != "shared-collector-v2 " + hash) { std::cerr << "collector: version-conflict or daemon handshake failure\n"; return 1; }
+        return bridge(connection);
+    } catch (const SafeError& e) { std::cerr << "collector: " << e.what() << "\n"; return 1; }
+    catch (...) { std::cerr << "collector: runtime failure\n"; return 1; }
+}
