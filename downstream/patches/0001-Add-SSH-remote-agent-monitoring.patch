+struct Sampler::Impl {
+    struct Cached {
+        View view;
+        std::string history;
+        std::vector<agentspeed::perf::DayRecord> perf;
+        // Advances whenever this view's projection is replaced, so a subscriber decides
+        // "changed" by comparing integers instead of copying and comparing the projection.
+        std::uint64_t historyGeneration = 0;
+    };
+
+    std::string home, digest;
+    agentspeed::MonitorConfig config = agentspeed::MonitorConfig::fromEnvironment();
+    agentspeed::Monitor monitor{config};
+    std::shared_ptr<const agentspeed::TimeZone> local = agentspeed::localZone(agentspeed::processEnvironment());
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::map<std::optional<std::string>, Cached> views;
+    std::uint64_t baselineGeneration = 0;
+    std::optional<std::uint64_t> appliedBaselineGeneration;
+    std::optional<std::string> baselineDay;
+    bool stopping = false;
+    bool requested = true;
+    bool started = false;
+    std::thread worker;
+
+    Impl(const std::string& accountHome, const std::string& binaryDigest) : home(accountHome), digest(binaryDigest) {
+        views.emplace(std::nullopt, Cached{View{std::nullopt, local}, {}, {}});
+        worker = std::thread([this] { historyLoop(); });
+    }
+    ~Impl() {
+        { std::lock_guard lock(mutex); stopping = true; }
+        changed.notify_one();
+        worker.join();
+    }
+
+    void registerView(const View& view) {
+        std::lock_guard lock(mutex);
+        auto [it, inserted] = views.try_emplace(view.name, Cached{View{view.name, view.name ? view.zone : local}, {}, {}});
+        if (inserted) { requested = true; changed.notify_one(); }
+    }
+    std::shared_ptr<const agentspeed::TimeZone> localZone() {
+        std::lock_guard lock(mutex);
+        return local;
+    }
+    void updateBaselines(std::int64_t now) {
+        const auto day = agentspeed::history::DayLabeler(localZone()).label(now);
+        std::vector<agentspeed::perf::DayRecord> records;
+        std::uint64_t generation;
+        {
+            std::lock_guard lock(mutex);
+            generation = baselineGeneration;
+            if (appliedBaselineGeneration == generation && baselineDay == day) return;
+            records = views.at(std::nullopt).perf;
+        }
+        std::map<std::pair<agentspeed::SourceKind, std::string>, double> baselines;
+        if (day) {
+            for (const auto& record : records) {
+                const auto key = std::make_pair(record.source, record.model);
+                if (baselines.count(key)) continue;
+                if (const auto value = agentspeed::perf::baseline(records, record.source, record.model, *day))
+                    baselines.emplace(key, *value);
+            }
+        }
+        monitor.setPerfBaselines(std::move(baselines));
+        appliedBaselineGeneration = generation;
+        baselineDay = day;
+    }
+
+    void historyLoop() {
+        struct Saved {
+            View view;
+            agentspeed::history::Projection projection;
+            agentspeed::history::Report report;
+        };
+        // Kept by this thread so a failed scan can continue serving the last complete
+        // projection, explicitly marked partial, while the analyzer is restarted.
+        std::map<std::optional<std::string>, Saved> saved;
+        std::string scanIdentity;
+        for (;;) {
+            try {
+                HistoryCache cache(home, digest);
+                auto store = cache.open(cacheIdentity(config.locations, config.enabled));
+                agentspeed::history::Analyzer analyzer(*store, std::make_shared<agentspeed::pricing::PriceBook>());
+                auto nextScan = std::chrono::steady_clock::time_point::min();
+                agentspeed::history::Report report;
+                for (;;) {
+                    std::map<std::optional<std::string>, View> todo;
+                    {
+                        std::unique_lock lock(mutex);
+                        changed.wait_until(lock, nextScan, [&] { return stopping || requested; });
+                        if (stopping) return;
+                        requested = false;
+                        for (const auto& [key, value] : views) todo.emplace(key, value.view);
+                    }
+                    if (std::chrono::steady_clock::now() >= nextScan) {
+                        auto identity = localIdentity();
+                        if (identity != scanIdentity) {
+                            auto zone = agentspeed::localZone(agentspeed::processEnvironment());
+                            {
+                                std::lock_guard lock(mutex);
+                                local = zone;
+                                auto& value = views.at(std::nullopt);
+                                value.view.zone = zone;
+                                value.history.clear();
+                                ++value.historyGeneration;
+                                value.perf.clear();
+                                ++baselineGeneration;
+                                todo.at(std::nullopt).zone = zone;
+                            }
+                            saved.erase(std::nullopt);
+                            scanIdentity = identity;
+                        }
+                        auto zone = localZone();
+                        analyzer.setHermesZone(zone);
+                        report = analyzer.runShared(config.locations, config.enabled, zone, identity, [this] {
+                            std::lock_guard lock(mutex);
+                            return stopping;
+                        });
+                        nextScan = std::chrono::steady_clock::now() + std::chrono::seconds(60);
+                        if (report.cancelled) continue;
+                    }
+                    for (const auto& [key, view] : todo) {
+                        auto projection = analyzer.project(view.zone, nullptr, nullptr, !view.name);
+                        auto viewReport = report;
+                        if (!projection.complete && !viewReport.filesUnreadable) viewReport.filesUnreadable = 1;
+                        auto line = Protocol::history(projection.days, viewReport, view.name, projection.perfRecords);
+                        auto perf = projection.perfRecords;
+                        saved.insert_or_assign(key, Saved{view, std::move(projection), viewReport});
+                        std::lock_guard lock(mutex);
+                        if (stopping) return;
+                        auto& value = views.at(key);
+                        // Only a different projection is a new generation: re-deriving the
+                        // same text must not resend what a subscriber already holds.
+                        if (value.history != line) { value.history = std::move(line); ++value.historyGeneration; }
+                        value.perf = std::move(perf);
+                        if (!key) ++baselineGeneration;
+                    }
+                }
+            } catch (const std::exception&) {
+                for (const auto& [key, value] : saved) {
+                    auto report = value.report;
+                    if (!report.filesUnreadable) report.filesUnreadable = 1;
+                    auto line = Protocol::history(value.projection.days, report, value.view.name,
+                                                  value.projection.perfRecords);
+                    std::lock_guard lock(mutex);
+                    if (stopping) return;
+                    auto& cached = views.at(key);
+                    if (cached.history != line) { cached.history = std::move(line); ++cached.historyGeneration; }
+                }
+                std::unique_lock lock(mutex);
+                if (changed.wait_for(lock, std::chrono::seconds(10), [&] { return stopping; })) return;
+                requested = true;
+            }
+        }
+    }
+};
+
+Sampler::Sampler(const std::string& home, const std::string& digest) : impl_(std::make_unique<Impl>(home, digest)) {}
+Sampler::~Sampler() = default;
+
+void Sampler::poll(std::int64_t now) {
+    // A rolling 48-hour window covers the current civil day in every supported zone,
+    // including long days at offset transitions, without coupling ingest to a viewer.
+    const auto keepFrom = now - 2 * dayMs;
+    if (!impl_->started) {
+        impl_->monitor.start(now, keepFrom);
+        impl_->started = true;
+    }
+    impl_->monitor.poll(now, keepFrom);
+    impl_->updateBaselines(now);
+}
+
+Sample Sampler::sample(std::int64_t now, const View& view) {
+    impl_->registerView(view);
+    const auto zone = view.name ? view.zone : impl_->localZone();
+    return {impl_->monitor.snapshot(now, dayStart(now, zone))};
+}
+
+std::string Sampler::history(const View& view) {
+    impl_->registerView(view);
+    std::lock_guard lock(impl_->mutex);
+    return impl_->views.at(view.name).history;
+}
+
+std::uint64_t Sampler::historyGeneration(const View& view) {
+    impl_->registerView(view);
+    std::lock_guard lock(impl_->mutex);
+    return impl_->views.at(view.name).historyGeneration;
+}
+
+std::vector<agentspeed::Completion> Sampler::takeCompletions() {
+    return impl_->monitor.takeCompletions();
+}
+
+}  // namespace collector
