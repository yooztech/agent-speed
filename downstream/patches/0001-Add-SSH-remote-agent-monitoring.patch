+    parser.add_argument('--relay-port', type=int, default=19443, help='test relay port (must match compile seam)')
+    args = parser.parse_args()
+    try:
+        result = run(args)
+    except Exception as exc:
+        result = {'passed':False, 'error':str(exc), 'exception':type(exc).__name__}
+    print(json.dumps(result, sort_keys=True))
+    return 0 if result['passed'] else 1
