index 00000000..ea7090ab
--- /dev/null
+++ b/macos/Tests/AgentSpeedAppTests/OrbHostRuntimeTests.swift
@@ -0,0 +1,85 @@
+import AgentSpeedCore
+import AgentSpeedOrbModel
+import Foundation
+import Testing
+@testable import AgentSpeed
+
+@Suite("Orb host source and peak regressions")
+@MainActor
+struct OrbHostRuntimeTests {
+    @Test func unseenRemoteOffersEverySourceForExclusion() {
+        let host = UUID()
+        let kinds = orbSourceKinds(hostID: host, instances: [], excluded: [])
+        #expect(kinds == SourceKind.allCases)
+        let exclusions = kinds.map { OrbSourceExclusion(hostID: host, source: $0.rawValue) }
+        #expect(!OrbSubset.hasUnknownSources(hosts: [host], sources: nil, excluded: exclusions))
+        #expect(orbSourceKinds(hostID: nil, instances: [], excluded: []).isEmpty)
+    }
+
+    @Test func seenHostKeepsActiveAndExcludedKinds() {
+        let host = UUID()
+        let status = SourceStatus(kind: .codex, enabled: true, rootPath: "remote", available: true, sessionCount: 1,
+                                  live: .zero, today: TokenTotals(requests: 1), activeAgents: 0)
+        let excluded = OrbSourceExclusion(hostID: host, source: SourceKind.claudeCode.rawValue)
+        let kinds = orbSourceKinds(hostID: host, instances: [SourceInstance(hostID: host, status: status)], excluded: [excluded])
+        #expect(kinds.contains(.codex))
+        #expect(kinds.contains(.claudeCode))
+        #expect(kinds.count == 2)
+    }
+
+    @Test func excludedHostsDoNotUseAggregatePeak() throws {
+        let suite = "OrbHostRuntimeTests.excluded"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defaults.removePersistentDomain(forName: suite)
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let settings = AppSettings(defaults: defaults)
+        let host = UUID()
+        let exclusion = OrbSourceExclusion(hostID: host, source: SourceKind.codex.rawValue)
+        let runtime = OrbRuntime(config: OrbConfig(id: "orb", excludedSources: [exclusion]))
+        var events: [OrbFeedEvent] = []
+        runtime.feed.addListener { events.append($0) }
+        var snapshot = SpeedSnapshot.empty
+        snapshot.state = .running
+        snapshot.dayStart = Date(timeIntervalSince1970: 1)
+        snapshot.peakToday = Rate(output: 100, total: 100)
+        for (seconds, speed) in [(10.0, 20.0), (71.0, 30.0)] {
+            let status = SourceStatus(kind: .codex, enabled: true, rootPath: "local", available: true, sessionCount: 1,
+                                      live: Rate(output: speed, total: speed), today: TokenTotals(requests: 1), activeAgents: 0)
+            snapshot.timestamp = Date(timeIntervalSince1970: seconds)
+            snapshot.sources = [status]
+            snapshot.sourceInstances = [SourceInstance(hostID: nil, status: status)]
+            runtime.ingest(snapshot, settings: settings, cost: nil, isPreviewing: false, now: seconds)
+        }
+        #expect(events == [.newPeak])
+    }
+
+    @Test func measuredPeaksPreventFalseCelebrationsForAllAndSubset() throws {
+        let suite = "OrbHostRuntimeTests.peaks"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defaults.removePersistentDomain(forName: suite)
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let settings = AppSettings(defaults: defaults)
+        let set = SourceSet([.codex])
+        for selection in [OrbSourceSelection.all, .explicit([.codex])] {
+            let runtime = OrbRuntime(config: OrbConfig(id: "orb", sources: selection))
+            var events: [OrbFeedEvent] = []
+            runtime.feed.addListener { events.append($0) }
+            var snapshot = SpeedSnapshot.empty
+            snapshot.state = .running
+            snapshot.dayStart = Date(timeIntervalSince1970: 1)
+            snapshot.peakToday = Rate(output: 100, total: 100)
+            snapshot.subsetPeaks = [set: 100]
+            for (seconds, speed) in [(10.0, 20.0), (71.0, 30.0), (72.0, 120.0)] {
+                let status = SourceStatus(kind: .codex, enabled: true, rootPath: "local", available: true, sessionCount: 1,
+                                          live: Rate(output: speed, total: speed), today: TokenTotals(requests: 1), activeAgents: 0)
+                snapshot.timestamp = Date(timeIntervalSince1970: seconds)
+                snapshot.live = status.live
+                snapshot.sources = [status]
+                snapshot.sourceInstances = [SourceInstance(hostID: nil, status: status)]
+                runtime.ingest(snapshot, settings: settings, cost: nil, isPreviewing: false, now: seconds)
+                if speed == 30 { #expect(events.isEmpty) }
+            }
+            #expect(events == [.newPeak])
+        }
+    }
+}
