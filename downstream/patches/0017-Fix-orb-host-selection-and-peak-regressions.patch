+/// <summary>Host/source choices for the orb editor, including hosts without a first snapshot.</summary>
+public static class OrbSourceChoices
+{
+    public static IEnumerable<OrbSourceInstance> ForEditor(
+        SpeedSnapshot snapshot, IEnumerable<Guid> hosts, IEnumerable<OrbSourceInstance> exclusions)
+    {
+        var active = snapshot.Sources.Where(s => !OrbSubset.IsUnavailable(s)
+                && (s.SessionCount > 0 || s.Today.Requests > 0 || s.Live != Rate.Zero))
+            .Select(s => new OrbSourceInstance(s.HostId, s.Kind));
+        var unknown = hosts.Where(host => !snapshot.Sources.Any(s => s.HostId == host))
+            .SelectMany(host => SourceSet.Everything.Select(kind => new OrbSourceInstance(host, kind)));
+        return active.Concat(exclusions).Concat(unknown).Distinct();
+    }
+}
