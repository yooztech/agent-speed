+using System.Text;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>An SSH destination; authentication and host keys are managed by OpenSSH.</summary>
+public sealed record RemoteHost(Guid Id, string Label, string Destination, bool Enabled)
+{
+    public bool ValidDestination
+    {
+        get
+        {
+            if (string.IsNullOrEmpty(Destination) || Destination[0] == '-') return false;
+            foreach (var rune in Destination.EnumerateRunes())
+                if (!Rune.IsLetterOrDigit(rune) && rune.Value is not ('.' or '_' or '-' or '@' or ':')) return false;
+            return true;
+        }
+    }
+}
+
+/// <summary>Formats the connection state shown alongside an SSH host.</summary>
+public static class RemoteHostStatusText
+{
+    public static string Format(bool? online, string? error)
+    {
+        if (online is null) return "Waiting for connection";
+        var state = online.Value ? "Online" : "Offline";
+        return string.IsNullOrWhiteSpace(error) ? state : $"{state}: {error}";
+    }
+}
