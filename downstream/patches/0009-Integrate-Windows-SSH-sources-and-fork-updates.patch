diff --git a/windows/src/AgentSpeed/Services/RemoteConnectionManager.cs b/windows/src/AgentSpeed/Services/RemoteConnectionManager.cs
new file mode 100644
index 00000000..9e5864fe
--- /dev/null
+++ b/windows/src/AgentSpeed/Services/RemoteConnectionManager.cs
@@ -0,0 +1,236 @@
+using System.Diagnostics;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Services;
+
+/// <summary>Owns the configured SSH connections on the UI dispatcher.</summary>
+internal sealed class RemoteConnectionManager : IDisposable
+{
+    private static readonly TimeSpan ReconnectDelay = TimeSpan.FromSeconds(10);
+    private readonly SettingsService _settings;
+    private readonly SpeedHub _hub;
+    private readonly Dispatcher _dispatcher;
+    private readonly Dictionary<Guid, Connection> _connections = new();
+    private readonly DispatcherTimer _timezoneTimer;
+    private string _timezone = TimeZoneInfo.Local.Id;
+    private bool _started;
+    private bool _disposed;
+
+    private sealed class Connection(RemoteHost host)
+    {
+        public RemoteHost Host = host;
+        public RemoteSshWorker? Worker;
+        public DispatcherTimer? Reconnect;
+        public long LastReceived;
+        public bool Online;
+        public string? Error;
+    }
+
+    public RemoteConnectionManager(SettingsService settings, SpeedHub hub, Dispatcher dispatcher)
+    {
+        _settings = settings;
+        _hub = hub;
+        _dispatcher = dispatcher;
+        _timezoneTimer = new DispatcherTimer(TimeSpan.FromSeconds(30), DispatcherPriority.Background, OnTimezoneTimer, dispatcher);
+        _timezoneTimer.Stop();
+    }
+
+    public void Start()
+    {
+        _dispatcher.VerifyAccess();
+        if (_disposed || _started) return;
+        _started = true;
+        _settings.Changed += OnSettingsChanged;
+        ApplyHosts(_settings.Current);
+        _timezoneTimer.Start();
+    }
+
+    private void OnSettingsChanged(object? sender, SettingsChangedEventArgs e)
+    {
+        if (!_dispatcher.CheckAccess())
+        {
+            Post(() => ApplyHosts(_settings.Current));
+            return;
+        }
+        ApplyHosts(e.Current);
+    }
+
+    private void ApplyHosts(AppSettings settings)
+    {
+        if (_disposed || !_started) return;
+        var hosts = new Dictionary<Guid, RemoteHost>();
+        foreach (var host in settings.RemoteHosts)
+            hosts[host.Id] = host;
+
+        foreach (var id in _connections.Keys.ToArray())
+        {
+            if (hosts.ContainsKey(id)) continue;
+            var removed = _connections[id];
+            Stop(removed);
+            _connections.Remove(id);
+            _hub.RemoveRemoteHost(id);
+        }
+
+        foreach (var host in hosts.Values)
+        {
+            if (!_connections.TryGetValue(host.Id, out var connection))
+            {
+                connection = new Connection(host);
+                _connections.Add(host.Id, connection);
+                Publish(connection);
+                if (host.Enabled) Connect(connection);
+                continue;
+            }
+
+            var previous = connection.Host;
+            var destinationChanged = previous.Destination != host.Destination;
+            connection.Host = host;
+            if (destinationChanged)
+            {
+                Stop(connection);
+                _hub.RemoveRemoteHost(host.Id);
+                connection.Error = null;
+            }
+            else if (previous.Enabled && !host.Enabled)
+            {
+                Stop(connection);
+                connection.Error = null;
+            }
+            Publish(connection);
+            if (host.Enabled && (destinationChanged || !previous.Enabled)) Connect(connection);
+        }
+    }
+
+    private void Connect(Connection connection)
+    {
+        if (_disposed || !connection.Host.Enabled || connection.Worker is not null) return;
+        if (!connection.Host.ValidDestination)
+        {
+            connection.Error = "Invalid SSH destination";
+            Publish(connection);
+            return;
+        }
+
+        try
+        {
+            _hub.ResetRemoteHostSession(connection.Host.Id);
+            var worker = new RemoteSshWorker(connection.Host.Destination);
+            connection.Worker = worker;
+            connection.LastReceived = Stopwatch.GetTimestamp();
+            var id = connection.Host.Id;
+            worker.LineReceived += (token, line) => Post(() => Receive(id, token, line));
+            worker.Ended += (token, reason) => Post(() => Ended(id, token, reason));
+            worker.Start();
+        }
+        catch (Exception ex)
+        {
+            connection.Worker?.Stop();
+            connection.Worker = null;
+            connection.Online = false;
+            connection.Error = ex.Message;
+            Publish(connection);
+            ScheduleReconnect(connection);
+        }
+    }
+
+    private void Receive(Guid id, Guid token, string line)
+    {
+        if (_disposed || !_connections.TryGetValue(id, out var connection) || connection.Worker?.Token != token) return;
+        var result = _hub.UpdateRemoteHost(id, connection.Host.Label, connection.Online, json: line);
+        if (result.Accepted) connection.LastReceived = Stopwatch.GetTimestamp();
+        connection.Online = result.Online;
+        connection.Error = result.Error;
+    }
+
+    private void Ended(Guid id, Guid token, string reason)
+    {
+        if (_disposed || !_connections.TryGetValue(id, out var connection) || connection.Worker?.Token != token) return;
+        connection.Worker = null;
+        connection.Online = false;
+        connection.Error = AppendError(connection.Error, reason);
+        Publish(connection);
+        ScheduleReconnect(connection);
+    }
+    private static string AppendError(string? prior, string reason) => prior is { Length: > 0 }
+        ? $"{prior[..Math.Min(prior.Length, 512)]}; {reason}"
+        : reason;
+
+
+    private void ScheduleReconnect(Connection connection)
+    {
+        if (_disposed || !connection.Host.Enabled || connection.Reconnect is not null) return;
+        var timer = new DispatcherTimer(DispatcherPriority.Background, _dispatcher) { Interval = ReconnectDelay };
+        connection.Reconnect = timer;
+        timer.Tick += (_, _) =>
+        {
+            timer.Stop();
+            if (connection.Reconnect != timer) return;
+            connection.Reconnect = null;
+            if (!_disposed && _connections.TryGetValue(connection.Host.Id, out var current) && ReferenceEquals(current, connection))
+                Connect(connection);
+        };
+        timer.Start();
+    }
+
+    private void Stop(Connection connection)
+    {
+        connection.Reconnect?.Stop();
+        connection.Reconnect = null;
+        var worker = connection.Worker;
+        connection.Worker = null;
+        connection.Online = false;
+        worker?.Stop();
+    }
+
+    private void Publish(Connection connection)
+    {
+        if (connection.Host.Enabled)
+            _hub.UpdateRemoteHost(connection.Host.Id, connection.Host.Label, connection.Online, connection.Error);
+        else
+            _hub.RemoveRemoteHost(connection.Host.Id);
+    }
+
+    private void OnTimezoneTimer(object? sender, EventArgs e)
+    {
+        TimeZoneInfo.ClearCachedData();
+        var timezone = TimeZoneInfo.Local.Id;
+        if (timezone != _timezone)
+        {
+            _timezone = timezone;
+            foreach (var connection in _connections.Values)
+                connection.Worker?.RequestHistoryTimezone();
+        }
+
+        foreach (var connection in _connections.Values)
+        {
+            if (connection.Worker is null || Stopwatch.GetElapsedTime(connection.LastReceived) < TimeSpan.FromSeconds(90)) continue;
+            Stop(connection);
+            connection.Error = AppendError(connection.Error, "Collector heartbeat timed out");
+            Publish(connection);
+            ScheduleReconnect(connection);
+        }
+    }
+
+    private void Post(Action action)
+    {
+        if (!_dispatcher.HasShutdownStarted && !_dispatcher.HasShutdownFinished)
+            _dispatcher.BeginInvoke(action);
+    }
+
+    public void Dispose()
+    {
+        if (!_dispatcher.CheckAccess())
+        {
+            _dispatcher.Invoke(Dispose);
+            return;
+        }
+        if (_disposed) return;
+        _disposed = true;
+        _settings.Changed -= OnSettingsChanged;
+        _timezoneTimer.Stop();
+        foreach (var connection in _connections.Values) Stop(connection);
+        _connections.Clear();
+    }
+}
diff --git a/windows/src/AgentSpeed/Services/RemoteSshWorker.cs b/windows/src/AgentSpeed/Services/RemoteSshWorker.cs
new file mode 100644
index 00000000..7808904e
--- /dev/null
+++ b/windows/src/AgentSpeed/Services/RemoteSshWorker.cs
@@ -0,0 +1,203 @@
+using System.Diagnostics;
+using System.Text;
+using System.Text.Json;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Services;
+
+/// <summary>Runs the bundled Linux collector over the user's OpenSSH configuration.</summary>
+public sealed class RemoteSshWorker
+{
+    private const string UploadCommand = "umask 077; mkdir -p ~/.cache/agent-speed && f=~/.cache/agent-speed/collector-$$ && cat > \"$f\" && chmod 700 \"$f\" && mv -f \"$f\" ~/.cache/agent-speed/collector";
+    private const string CollectorCommand = "exec ~/.cache/agent-speed/collector";
+    private const int MaxLineBytes = 4_194_304;
+    private readonly string destination;
+    private readonly object gate = new();
+    private Process? process;
+    private StreamWriter? collectorInput;
+    private bool stopped;
+    private bool started;
+    private readonly Dictionary<Process, Task<string>> diagnostics = new();
+
+    public RemoteSshWorker(string destination) => this.destination = destination;
+    public Guid Token { get; } = Guid.NewGuid();
+    public event Action<Guid, string>? LineReceived;
+    public event Action<Guid, string>? Ended;
+
+    public void Start()
+    {
+        lock (gate)
+        {
+            if (started || stopped) return;
+            started = true;
+        }
+        _ = Task.Run(RunAsync);
+    }
+
+    public void Stop()
+    {
+        lock (gate)
+        {
+            stopped = true;
+            Kill(process);
+        }
+    }
+
+    public void RequestHistoryTimezone()
+    {
+        var timezone = TimeZoneInfo.Local.Id;
+        if (TimeZoneInfo.TryConvertWindowsIdToIanaId(timezone, out var iana)) timezone = iana;
+        var request = JsonSerializer.Serialize(new { version = 1, type = "history_timezone", timezone });
+        lock (gate)
+        {
+            try { collectorInput?.WriteLine(request); collectorInput?.Flush(); }
+            catch (IOException) { }
+            catch (ObjectDisposedException) { }
+        }
+    }
+
+    private Process Launch(string command)
+    {
+        var info = new ProcessStartInfo("ssh")
+        {
+            UseShellExecute = false, CreateNoWindow = true,
+            RedirectStandardInput = true, RedirectStandardOutput = true, RedirectStandardError = true,
+        };
+        foreach (var arg in new[] { "-T", "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", destination, command })
+            info.ArgumentList.Add(arg);
+        var child = new Process { StartInfo = info };
+        lock (gate)
+        {
+            if (stopped) throw new OperationCanceledException();
+            if (!child.Start()) throw new IOException("SSH connection failed");
+            process = child;
+        }
+        diagnostics[child] = ReadDiagnosticsAsync(child.StandardError);
+        return child;
+    }
+    private static async Task<string> ReadDiagnosticsAsync(StreamReader reader)
+    {
+        const int limit = 4096;
+        var result = new StringBuilder(limit);
+        var buffer = new char[1024];
+        int count;
+        while ((count = await reader.ReadAsync(buffer.AsMemory()).ConfigureAwait(false)) != 0)
+        {
+            if (count >= limit) { result.Clear(); result.Append(buffer, count - limit, limit); }
+            else
+            {
+                var excess = result.Length + count - limit;
+                if (excess > 0) result.Remove(0, excess);
+                result.Append(buffer, 0, count);
+            }
+        }
+        return result.ToString().Trim();
+    }
+
+    private async Task<string> ExitReasonAsync(Process child, string prefix)
+    {
+        await child.WaitForExitAsync().ConfigureAwait(false);
+        var detail = await diagnostics[child].ConfigureAwait(false);
+        return $"{prefix} (exit code {child.ExitCode})" + (detail.Length == 0 ? "" : $": {detail}");
+    }
+
+
+    private async Task RunAsync()
+    {
+        string reason = "SSH connection failed";
+        try
+        {
+            if (!new RemoteHost(Guid.Empty, "", destination, false).ValidDestination)
+                throw new IOException("Invalid SSH destination");
+            var probe = Launch("uname -m");
+            try
+            {
+                probe.StandardInput.Close();
+                var architecture = (await probe.StandardOutput.ReadToEndAsync().ConfigureAwait(false)).Trim();
+                await probe.WaitForExitAsync().ConfigureAwait(false);
+                if (probe.ExitCode != 0) throw new IOException(await ExitReasonAsync(probe, "SSH connection failed; check host key and authentication").ConfigureAwait(false));
+                var arch = architecture switch { "x86_64" => "x86_64", "aarch64" or "arm64" => "aarch64", _ => throw new IOException("Unsupported remote architecture") };
+                var path = Path.Combine(AppContext.BaseDirectory, "collectors", "linux-" + arch, "agent-speed-collector");
+                if (!File.Exists(path)) throw new IOException($"Linux collector for {arch} is missing from this application");
+                var upload = Launch(UploadCommand);
+                try
+                {
+                    var drain = upload.StandardOutput.BaseStream.CopyToAsync(Stream.Null);
+                    await using (var binary = File.OpenRead(path))
+                        await binary.CopyToAsync(upload.StandardInput.BaseStream).ConfigureAwait(false);
+                    upload.StandardInput.Close();
+                    await drain.ConfigureAwait(false);
+                    await upload.WaitForExitAsync().ConfigureAwait(false);
+                    if (upload.ExitCode != 0) throw new IOException(await ExitReasonAsync(upload, "Collector upload failed").ConfigureAwait(false));
+                }
+                finally { await CleanupAsync(upload).ConfigureAwait(false); }
+            }
+            finally { await CleanupAsync(probe).ConfigureAwait(false); }
+            var collector = Launch(CollectorCommand);
+            try
+            {
+                lock (gate) { if (!stopped) collectorInput = collector.StandardInput; }
+                RequestHistoryTimezone();
+                var stream = collector.StandardOutput.BaseStream;
+                var chunk = new byte[8192];
+                using var line = new MemoryStream();
+                while (true)
+                {
+                    var count = await stream.ReadAsync(chunk).ConfigureAwait(false);
+                    if (count == 0) break;
+                    for (var i = 0; i < count; i++)
+                    {
+                        if (chunk[i] == (byte)'\n')
+                        {
+                            var text = Encoding.UTF8.GetString(line.GetBuffer(), 0, (int)line.Length);
+                            line.SetLength(0);
+                            lock (gate) { if (stopped) return; }
+                            LineReceived?.Invoke(Token, text);
+                        }
+                        else
+                        {
+                            if (line.Length >= MaxLineBytes) throw new IOException("Collector sent an oversized message");
+                            line.WriteByte(chunk[i]);
+                        }
+                    }
+                }
+                reason = await ExitReasonAsync(collector, "Collector disconnected; retrying").ConfigureAwait(false);
+            }
+            finally { await CleanupAsync(collector).ConfigureAwait(false); }
+        }
+        catch (IOException e) { reason = e.Message; }
+        catch (Exception) { reason = "SSH connection failed"; }
+        finally
+        {
+            lock (gate)
+            {
+                collectorInput = null;
+                process = null;
+                if (stopped) reason = "";
+            }
+        }
+        if (reason.Length != 0) Ended?.Invoke(Token, reason);
+    }
+
+    private async Task CleanupAsync(Process child)
+    {
+        lock (gate)
+        {
+            if (ReferenceEquals(process, child))
+            {
+                collectorInput = null;
+                process = null;
+            }
+            Kill(child);
+        }
+        try { await child.WaitForExitAsync().ConfigureAwait(false); await diagnostics[child].ConfigureAwait(false); }
+        finally { diagnostics.Remove(child); child.Dispose(); }
+    }
+
+    private static void Kill(Process? child)
+    {
+        try { if (child is not null && !child.HasExited) child.Kill(entireProcessTree: true); }
+        catch (InvalidOperationException) { }
+        catch (System.ComponentModel.Win32Exception) { }
+    }
+}
