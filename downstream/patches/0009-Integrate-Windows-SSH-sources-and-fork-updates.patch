new file mode 100644
index 00000000..c0ae38bb
--- /dev/null
+++ b/linux/tests/update_release_test.cpp
@@ -0,0 +1,31 @@
+#include "../app/src/update_release.hpp"
+
+#include <gtest/gtest.h>
+
+using agentspeed::updates::isNewForkRelease;
+using agentspeed::updates::kReleaseFeed;
+using agentspeed::updates::kReleasePage;
+
+TEST(UpdateRelease, UsesForkFeedAndReleasePage) {
+    EXPECT_STREQ(kReleaseFeed, "https://api.github.com/repos/yooztech/agent-speed/releases?per_page=100");
+    EXPECT_STREQ(kReleasePage, "https://github.com/yooztech/agent-speed/releases");
+}
+
+TEST(UpdateRelease, ComparesForkOrdinalsNumerically) {
+    EXPECT_TRUE(isNewForkRelease("1.6.1-fork.1", "v1.6.1-fork.2", false, false));
+    EXPECT_TRUE(isNewForkRelease("1.6.1-fork.2", "v1.6.1-fork.10", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.2", "v1.6.1-fork.1", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.2", "v1.6.1-fork.2", false, false));
+    EXPECT_TRUE(isNewForkRelease("1.6.1", "v1.6.2-fork.1", false, false));
+}
+
+TEST(UpdateRelease, RejectsUpstreamAndNonForkReleases) {
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.1", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-rc.1", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-fork.x", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-fork.01", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-fork.1.extra", false, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-fork.1", true, false));
+    EXPECT_FALSE(isNewForkRelease("1.6.1-fork.1", "v1.6.2-fork.1", false, true));
+}
