diff --git a/linux/app/src/update_release.hpp b/linux/app/src/update_release.hpp
new file mode 100644
index 00000000..adda87e6
--- /dev/null
+++ b/linux/app/src/update_release.hpp
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <algorithm>
+#include <optional>
+#include <regex>
+#include <string>
+#include <string_view>
+#include <vector>
+#include <utility>
+
+namespace agentspeed::updates {
+
+inline constexpr auto kReleaseFeed = "https://api.github.com/repos/yooztech/agent-speed/releases?per_page=100";
+inline constexpr auto kReleasePage = "https://github.com/yooztech/agent-speed/releases";
+
+struct Version {
+    std::string major, minor, patch;
+    std::vector<std::string> prerelease;
+};
+
+inline std::optional<Version> parseVersion(const std::string& text) {
+    static const std::regex pattern(R"(^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$)");
+    std::smatch match;
+    if (!std::regex_match(text, match, pattern)) return std::nullopt;
+    Version version{match[1], match[2], match[3], {}};
+    const std::string suffix = match[4];
+    for (std::size_t start = 0; start < suffix.size();) {
+        const auto end = suffix.find('.', start);
+        auto id = suffix.substr(start, end == std::string::npos ? end : end - start);
+        const bool numeric = std::all_of(id.begin(), id.end(), [](char c) { return c >= '0' && c <= '9'; });
+        if (numeric && id.size() > 1 && id.front() == '0') return std::nullopt;
+        version.prerelease.push_back(std::move(id));
+        if (end == std::string::npos) break;
+        start = end + 1;
+    }
+    return version;
+}
+
+inline int compareNumber(std::string_view a, std::string_view b) {
+    if (a.size() != b.size()) return a.size() < b.size() ? -1 : 1;
+    return a == b ? 0 : (a < b ? -1 : 1);
+}
+
+inline bool less(const Version& a, const Version& b) {
+    for (const auto& [left, right] : {std::pair{&a.major, &b.major}, std::pair{&a.minor, &b.minor}, std::pair{&a.patch, &b.patch}}) {
+        const int comparison = compareNumber(*left, *right);
+        if (comparison) return comparison < 0;
+    }
+    if (a.prerelease.empty() || b.prerelease.empty()) return !a.prerelease.empty() && b.prerelease.empty();
+    for (std::size_t i = 0; i < std::min(a.prerelease.size(), b.prerelease.size()); ++i) {
+        const auto& left = a.prerelease[i];
+        const auto& right = b.prerelease[i];
+        const auto numeric = [](const std::string& id) { return std::all_of(id.begin(), id.end(), [](char c) { return c >= '0' && c <= '9'; }); };
+        const bool ln = numeric(left), rn = numeric(right);
+        if (ln != rn) return ln;
+        const int comparison = ln ? compareNumber(left, right) : (left == right ? 0 : (left < right ? -1 : 1));
+        if (comparison) return comparison < 0;
+    }
+    return a.prerelease.size() < b.prerelease.size();
+}
+
+inline bool isNewForkRelease(const std::string& current, const std::string& tag, bool draft, bool prerelease) {
+    const auto installed = parseVersion(current);
+    const auto offered = parseVersion(tag);
+    if (draft || prerelease || !installed || !offered || offered->prerelease.size() != 2 || offered->prerelease[0] != "fork") return false;
+    const auto& ordinal = offered->prerelease[1];
+    if (!std::all_of(ordinal.begin(), ordinal.end(), [](char c) { return c >= '0' && c <= '9'; })) return false;
+    return less(*installed, *offered);
+}
+
+}  // namespace agentspeed::updates
