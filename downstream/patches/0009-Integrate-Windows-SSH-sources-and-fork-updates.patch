@@ -0,0 +1,189 @@
+using System.Text.Json;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemoteConsumerTests
+{
+    private static string Snapshot(string machine, long output, string live = "5") => $$"""
+        {"version":1,"type":"snapshot","machine_id":"{{machine}}","today_day":"{{DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}}","sources":[{"source":"pi","enabled":true,"available":true,"today_output":{{output}},"live_output":{{live}},"live_total":{{live}}}],"agents":[]}
+        """;
+
+    private static string History(string timezone, long output) => $$"""
+        {"version":1,"type":"history","timezone":{{JsonSerializer.Serialize(timezone)}},"partial":false,"days":[{"day":"2026-01-01","source":"pi","output":{{output}}}]}
+        """;
+
+    private static string LocalTimezone => TimeZoneInfo.TryConvertWindowsIdToIanaId(TimeZoneInfo.Local.Id, out var iana)
+        ? iana : TimeZoneInfo.Local.Id;
+
+    [Fact]
+    public async Task HostsKeepIdentityAndDeduplicateSameMachineWithoutMergingDifferentMachines()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var first = Guid.NewGuid();
+        var duplicate = Guid.NewGuid();
+        var other = Guid.NewGuid();
+        hub.UpdateRemoteHost(first, "first", true, json: Snapshot("machine-a", 10));
+        hub.UpdateRemoteHost(duplicate, "duplicate", true, json: Snapshot("machine-a", 10));
+        hub.UpdateRemoteHost(other, "other", true, json: Snapshot("machine-b", 20));
+
+        Assert.Equal(3, hub.Snapshot.RemoteHosts.Count);
+        Assert.Equal(30, hub.Snapshot.Today.Output);
+        var sources = hub.Snapshot.Sources.Where(s => s.HostId.HasValue).ToArray();
+        Assert.Equal(2, sources.Length);
+        Assert.Contains(sources, s => s.HostId == other);
+        Assert.Single(sources.Where(s => s.HostId == first || s.HostId == duplicate));
+
+        hub.RemoveRemoteHost(other);
+        Assert.Equal(10, hub.Snapshot.Today.Output);
+        Assert.DoesNotContain(hub.Snapshot.RemoteHosts, h => h.Id == other);
+    }
+
+    [Fact]
+    public async Task IdenticalRemoteAgentIdsAreScopedToTheirHosts()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var a = Guid.NewGuid();
+        var b = Guid.NewGuid();
+        const string agents = "\"agents\":[{\"id\":\"session\",\"source\":\"pi\",\"phase\":\"generating\",\"parent_id\":\"parent\"}]";
+        hub.UpdateRemoteHost(a, "a", true, json: Snapshot("a", 1).Replace("\"agents\":[]", agents));
+        hub.UpdateRemoteHost(b, "b", true, json: Snapshot("b", 1).Replace("\"agents\":[]", agents));
+
+        var first = Assert.Single(hub.Snapshot.Agents.Where(agent => agent.HostId == a));
+        var second = Assert.Single(hub.Snapshot.Agents.Where(agent => agent.HostId == b));
+        Assert.NotEqual(first.Id, second.Id);
+        Assert.NotEqual(first.ParentId, second.ParentId);
+        Assert.Equal(AgentPhase.Generating, first.Phase);
+    }
+
+    [Fact]
+    public async Task UnknownLiveAndDisconnectedHostsAreNotReportedAsLiveZero()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "host", true, json: Snapshot("machine", 42, "null"));
+        var unknown = Assert.Single(hub.Snapshot.Sources.Where(s => s.HostId == id));
+        Assert.False(unknown.LiveAvailable);
+        Assert.True(unknown.TodayAvailable);
+        Assert.Equal(42, unknown.Today.Output);
+
+        hub.UpdateRemoteHost(id, "host", false, error: "offline");
+        var status = Assert.Single(hub.Snapshot.RemoteHosts);
+        Assert.False(status.Online);
+        Assert.Equal("offline", status.Error);
+        var offline = Assert.Single(hub.Snapshot.Sources.Where(s => s.HostId == id));
+        Assert.False(offline.LiveAvailable);
+        Assert.False(offline.Available);
+        Assert.False(offline.TodayAvailable);
+    }
+
+    [Fact]
+    public async Task LocalPublicationRemainsIsolatedFromRemoteData()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        SpeedSnapshot? published = null;
+        hub.LivePublished += (_, snapshot) => published = snapshot;
+        hub.UpdateRemoteHost(Guid.NewGuid(), "remote", true, json: Snapshot("remote-machine", 99));
+        var local = SpeedSnapshot.Empty with { Today = new TokenTotals(Output: 7) };
+        hub.PublishLive(local);
+
+        Assert.Same(local, published);
+        Assert.Equal(7, published!.Today.Output);
+        Assert.Empty(published.RemoteHosts);
+        Assert.Equal(106, hub.Snapshot.Today.Output);
+    }
+
+    [Fact]
+    public async Task UnknownRemoteLiveDoesNotProduceLocalOnlyChartBuckets()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "host", true, json: Snapshot("machine", 42, "null"));
+        var point = new HistoryPoint(DateTimeOffset.UtcNow, new Rate(3, 4), Rate.Zero);
+        hub.PublishLive(SpeedSnapshot.Empty with { History = [point] });
+
+        Assert.False(hub.Snapshot.RemoteLiveComplete);
+        Assert.Empty(hub.Snapshot.History);
+        hub.UpdateRemoteHost(id, "host", false);
+        Assert.Empty(hub.Snapshot.History);
+    }
+
+    [Fact]
+    public async Task RemoteTodayFromAnotherDayIsUnknown()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        var frame = Snapshot("machine", 42).Replace(
+            DateTime.Now.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture), "2000-01-01");
+        hub.UpdateRemoteHost(id, "host", true, json: frame);
+        var source = Assert.Single(hub.Snapshot.Sources.Where(s => s.HostId == id));
+        Assert.False(source.TodayAvailable);
+        Assert.Equal(0, hub.Snapshot.Today.Output);
+        Assert.False(hub.Snapshot.RemoteTodayComplete);
+    }
+
+    [Fact]
+    public async Task HistoryIsPerHostReplacedAndRejectsOtherTimezones()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var a = Guid.NewGuid();
+        var b = Guid.NewGuid();
+        hub.UpdateRemoteHost(a, "a", true, json: History(LocalTimezone, 10));
+        hub.UpdateRemoteHost(b, "b", true, json: History(LocalTimezone, 20));
+        var wrongZone = LocalTimezone == "UTC" ? "America/New_York" : "UTC";
+        hub.UpdateRemoteHost(a, "a", true, json: History(wrongZone, 999));
+        var stateA = hub.Snapshot.RemoteHosts.Single(h => h.Id == a);
+        var stateB = hub.Snapshot.RemoteHosts.Single(h => h.Id == b);
+        Assert.True(stateA.HistoryCurrent);
+        Assert.Equal(10, Assert.Single(stateA.Days).Totals.Output);
+        Assert.Equal(a, Assert.Single(stateA.Days).HostId);
+        Assert.Equal(20, Assert.Single(stateB.Days).Totals.Output);
+
+        hub.UpdateRemoteHost(a, "a", true, json: $$"""{"version":1,"type":"history","timezone":{{JsonSerializer.Serialize(LocalTimezone)}},"partial":true,"days":[]} """);
+        Assert.Empty(hub.Snapshot.RemoteHosts.Single(h => h.Id == a).Days);
+        Assert.Single(hub.Snapshot.RemoteHosts.Single(h => h.Id == b).Days);
+        hub.UpdateRemoteHost(b, "b", false);
+        stateB = hub.Snapshot.RemoteHosts.Single(h => h.Id == b);
+        Assert.False(stateB.HistoryCurrent);
+        Assert.Equal(20, Assert.Single(stateB.Days).Totals.Output);
+    }
+
+    [Fact]
+    public async Task CompletionEventsAreScopedDeduplicatedAndSuppressedDuringPreview()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var a = Guid.NewGuid();
+        var b = Guid.NewGuid();
+        var events = new List<SpeedEvent>();
+        hub.EventRaised += (_, e) => events.Add(e);
+        hub.UpdateRemoteHost(a, "a", true, json: Snapshot("shared", 1));
+        hub.UpdateRemoteHost(b, "b", true, json: Snapshot("shared", 1));
+        const string completion = "{\"version\":1,\"type\":\"completion\",\"source\":\"pi\",\"response_id\":\"r1\",\"output\":9,\"speed\":null}";
+        hub.UpdateRemoteHost(a, "a", true, json: completion);
+        hub.UpdateRemoteHost(a, "a", false);
+        hub.UpdateRemoteHost(a, "a", true, json: completion);
+        hub.UpdateRemoteHost(b, "b", true, json: completion);
+        var response = Assert.IsType<SpeedEvent.ResponseCompleted>(Assert.Single(events)).Response;
+        Assert.Equal(a, response.HostId);
+        Assert.Equal(9, response.OutputTokens);
+        Assert.False(response.HasTotalTokens);
+        Assert.Null(response.Speed);
+
+        hub.UpdateRemoteHost(a, "a", true, json: "{\"version\":1,\"type\":\"completion\",\"source\":\"pi\",\"output\":3}");
+        hub.UpdateRemoteHost(a, "a", true, json: "{\"version\":1,\"type\":\"completion\",\"source\":\"pi\",\"response_id\":\"\",\"output\":3}");
+        hub.BeginPreview();
+        hub.UpdateRemoteHost(a, "a", true, json: completion.Replace("r1", "r2"));
+        hub.EndPreview();
+        Assert.Single(events);
+    }
+
+    [Fact]
+    public async Task InvalidAndFutureProtocolFramesDoNotReplaceLastValidSnapshot()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "host", true, json: Snapshot("machine", 42));
+        hub.UpdateRemoteHost(id, "host", true, json: "{not json");
+        hub.UpdateRemoteHost(id, "host", true, json: "{\"version\":2,\"type\":\"snapshot\",\"sources\":[]}");
+        Assert.Equal(42, hub.Snapshot.Today.Output);
+    }
+}
