+++ b/windows/tests/AgentSpeed.Core.Tests/RemoteProtocolLifecycleTests.cs
@@ -0,0 +1,102 @@
+namespace AgentSpeed.Core.Tests;
+
+public sealed class RemoteProtocolLifecycleTests
+{
+    private const string Snapshot = """
+        {"version":1,"type":"snapshot","machine_id":"remote","sources":[{"source":"pi","enabled":true,"available":true,"live_output":5}],"agents":[]}
+        """;
+    private const string Completion = """
+        {"version":1,"type":"completion","source":"pi","response_id":"a","output":1}
+        """;
+
+    [Fact]
+    public async Task OnlyValidSnapshotMakesHostOnlineAndErrorsSurviveOtherFrames()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "remote", false);
+        var completion = hub.UpdateRemoteHost(id, "remote", false, json: Completion);
+        Assert.True(completion.Accepted);
+        Assert.False(completion.Online);
+        Assert.False(Assert.Single(hub.Snapshot.RemoteHosts).Online);
+
+        var invalid = hub.UpdateRemoteHost(id, "remote", false, json: "{broken");
+        Assert.False(invalid.Accepted);
+        Assert.NotNull(Assert.Single(hub.Snapshot.RemoteHosts).Error);
+        var afterCompletion = hub.UpdateRemoteHost(id, "remote", false, json: Completion);
+        Assert.True(afterCompletion.Accepted);
+        Assert.Equal(invalid.Error, afterCompletion.Error);
+        Assert.False(afterCompletion.Online);
+
+        var snapshot = hub.UpdateRemoteHost(id, "remote", false, json: Snapshot);
+        Assert.True(snapshot.Accepted);
+        Assert.True(snapshot.Online);
+        Assert.Null(snapshot.Error);
+        Assert.True(Assert.Single(hub.Snapshot.RemoteHosts).Online);
+    }
+
+    [Fact]
+    public async Task InvalidFramesDoNotRefreshHeartbeatOrEraseErrors()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "remote", false, json: Snapshot);
+        foreach (var frame in new[] { "{}", "{\"version\":2,\"type\":\"snapshot\",\"sources\":[]}", "{\"version\":1,\"type\":\"snapshot\",\"sources\":[{}]}", "{\"version\":1,\"type\":\"unknown\"}" })
+        {
+            var result = hub.UpdateRemoteHost(id, "remote", true, json: frame);
+            Assert.False(result.Accepted);
+            Assert.True(result.Online);
+            Assert.NotNull(result.Error);
+            Assert.Equal(result.Error, Assert.Single(hub.Snapshot.RemoteHosts).Error);
+        }
+    }
+
+    [Fact]
+    public async Task ReconnectCannotReusePreviousSnapshot()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        hub.UpdateRemoteHost(id, "remote", false, json: Snapshot);
+        hub.UpdateRemoteHost(id, "remote", false, "disconnected");
+        hub.ResetRemoteHostSession(id);
+        var result = hub.UpdateRemoteHost(id, "remote", false, json: Completion);
+        Assert.False(result.Online);
+        var host = Assert.Single(hub.Snapshot.RemoteHosts);
+        Assert.False(host.Online);
+        Assert.Equal("disconnected", host.Error);
+        Assert.DoesNotContain(hub.Snapshot.Sources, source => source.HostId == id);
+    }
+    [Fact]
+    public async Task ReconnectRetainsHistoryIdentityAndRejectsMalformedHistory()
+    {
+        var hub = await Task.Run(() => new SpeedHub());
+        var id = Guid.NewGuid();
+        var zone = TimeZoneInfo.TryConvertWindowsIdToIanaId(TimeZoneInfo.Local.Id, out var iana) ? iana : TimeZoneInfo.Local.Id;
+        var history = $$"""
+            {"version":1,"type":"history","timezone":{{System.Text.Json.JsonSerializer.Serialize(zone)}},"partial":false,"days":[{"day":"2026-01-01","source":"pi","output":42}]}
+            """;
+        hub.UpdateRemoteHost(id, "remote", false, json: Snapshot);
+        Assert.True(hub.UpdateRemoteHost(id, "remote", true, json: history).Accepted);
+        var before = Assert.Single(hub.Snapshot.RemoteHosts);
+        Assert.Equal(42, Assert.Single(before.Days).Totals.Output);
+        foreach (var row in new[] { "{}", "{\"source\":\"pi\"}", "{\"day\":\"2026-01-01\"}" })
+        {
+            var malformed = $$"""
+                {"version":1,"type":"history","timezone":{{System.Text.Json.JsonSerializer.Serialize(zone)}},"partial":false,"days":[{{row}}]}
+                """;
+            var result = hub.UpdateRemoteHost(id, "remote", true, json: malformed);
+            Assert.False(result.Accepted);
+            Assert.NotNull(result.Error);
+            var current = Assert.Single(hub.Snapshot.RemoteHosts);
+            Assert.Equal(42, Assert.Single(current.Days).Totals.Output);
+            Assert.Equal(before.HistoryReceivedAt, current.HistoryReceivedAt);
+        }
+        hub.UpdateRemoteHost(id, "remote", false, "disconnected");
+        hub.ResetRemoteHostSession(id);
+        var reconnected = Assert.Single(hub.Snapshot.RemoteHosts);
+        Assert.Equal("remote", reconnected.MachineId);
+        Assert.Equal(42, Assert.Single(reconnected.Days).Totals.Output);
+        Assert.False(reconnected.HistoryCurrent);
+    }
+
+}
