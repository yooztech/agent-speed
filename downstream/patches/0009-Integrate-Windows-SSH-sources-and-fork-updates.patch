@@ -0,0 +1,42 @@
+using System.Collections.Immutable;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public sealed class RemoteHostSettingsTests
+{
+    [Theory]
+    [InlineData("server")]
+    [InlineData("alice@example.org")]
+    [InlineData("host-name_1:22")]
+    [InlineData("用户@主机")]
+    public void DestinationAcceptsSshNames(string destination)
+    {
+        Assert.True(new RemoteHost(Guid.NewGuid(), "Host", destination, true).ValidDestination);
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("-oProxyCommand=x")]
+    [InlineData("host name")]
+    [InlineData("host;touch")]
+    [InlineData("host\nother")]
+    [InlineData("host$(command)")]
+    public void DestinationRejectsOptionsAndShellMetacharacters(string destination)
+    {
+        Assert.False(new RemoteHost(Guid.NewGuid(), "Host", destination, true).ValidDestination);
+    }
+
+    [Fact]
+    public void RemoteHostsRoundTripWithStableIdentityAndEnabledState()
+    {
+        var first = new RemoteHost(Guid.NewGuid(), "Work \"server\"", "alice@example.org", true);
+        var second = new RemoteHost(Guid.NewGuid(), "Offline", "backup", false);
+        var settings = AppSettings.Default with { RemoteHosts = ImmutableArray.Create(first, second) };
+
+        var restored = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(settings));
+
+        Assert.Equal(new[] { first, second }, restored.RemoteHosts.ToArray());
+        Assert.Empty(AppSettings.Default.RemoteHosts);
+    }
+}
