@@ -0,0 +1,125 @@
+using System.Text.Json;
+using AgentSpeed.Core.Reporting;
+
+namespace AgentSpeed.Core;
+
+/// <summary>Connection and last received history for one configured remote host.</summary>
+public sealed record RemoteHostStatus(Guid Id, string Label, bool Online, string? Error)
+{
+    public string MachineId { get; init; } = Id.ToString();
+    public IReadOnlyList<DailyUsage> Days { get; init; } = [];
+    public bool? HistoryPartial { get; init; }
+    public DateTimeOffset? HistoryReceivedAt { get; init; }
+    public bool HistoryCurrent { get; init; }
+}
+
+internal sealed record RemoteCompletion(string Id, SourceKind Source, long Output, double? Speed);
+
+internal sealed class RemoteHostData(Guid id, string label)
+{
+    public Guid Id { get; } = id;
+    public string Label { get; set; } = label;
+    public bool Online { get; set; }
+    public string? Error { get; set; }
+    public JsonElement? Snapshot { get; set; }
+    private string? _machineId;
+    private string? _historyMachineId;
+    public IReadOnlyList<DailyUsage> Days { get; set; } = [];
+    public string? HistoryTimezone { get; set; }
+    public bool? HistoryPartial { get; set; }
+    public DateTimeOffset? HistoryReceivedAt { get; set; }
+    public bool HistoryCurrent { get; set; }
+
+    public bool Apply(string json, out RemoteCompletion? completion)
+    {
+        completion = null;
+        try
+        {
+            using var doc = JsonDocument.Parse(json);
+            var root = doc.RootElement;
+            if (root.ValueKind != JsonValueKind.Object) { Error = "Malformed collector message"; return false; }
+            if (root.Number("version") != 1) { Error = "Unsupported collector protocol version"; return false; }
+            switch (root.Text("type"))
+            {
+                case "snapshot":
+                    if (root.Array("sources") is not { } sources || sources.EnumerateArray().Any(s => s.ValueKind != JsonValueKind.Object || string.IsNullOrEmpty(s.Text("source")) || s.Boolean("enabled") is null))
+                    { Error = "Invalid collector sources"; return false; }
+                    Snapshot = root.Clone(); Online = true; Error = null;
+                    _machineId = root.Text("machine_id");
+                    return true;
+                case "history":
+                    var timezone = root.Text("timezone");
+                    if (timezone != LocalTimezone() || root.Array("days") is not { } days) { Error = "Invalid collector history"; return false; }
+                    if (days.EnumerateArray().Any(d => d.ValueKind != JsonValueKind.Object || string.IsNullOrWhiteSpace(d.Text("day")) || string.IsNullOrWhiteSpace(d.Text("source"))))
+                    { Error = "Invalid collector history row"; return false; }
+                    Days = days.EnumerateArray().Select(Day).Where(d => d is not null).Cast<DailyUsage>().ToArray();
+                    _historyMachineId = _machineId;
+                    HistoryTimezone = timezone; HistoryPartial = root.Boolean("partial");
+                    HistoryReceivedAt = DateTimeOffset.UtcNow; HistoryCurrent = true;
+                    return true;
+                case "completion":
+                    var responseId = root.Text("response_id");
+                    var source = Kind(root.Text("source"));
+                    if (string.IsNullOrEmpty(responseId) || source is null || !root.TryGetProperty("output", out var output) ||
+                        output.ValueKind != JsonValueKind.Number || !output.TryGetInt64(out var count) || count < 0) { Error = "Invalid collector completion source or output"; return false; }
+                    var speed = root.NullableNumber("speed");
+                    completion = new RemoteCompletion(responseId, source.Value, count, speed is >= 0 ? speed : null);
+                    return true;
+                default:
+                    Error = "Unknown collector message type";
+                    return false;
+            }
+        }
+        catch (JsonException) { Error = "Malformed collector message"; }
+        catch (ArgumentOutOfRangeException) { Error = "Malformed collector message"; }
+        return false;
+    }
+
+    private DailyUsage? Day(JsonElement d)
+    {
+        if (d.Text("day") is not { } day || Kind(d.Text("source")) is not { } kind) return null;
+        var models = d.Array("models") is { } array
+            ? array.EnumerateArray().Select(m => new ModelUsage(m.Text("model") ?? "", m.Integer("requests"), m.Integer("output"), m.Integer("measured_output"), m.Integer("measured_ms")) { Cost = Cost(m) }).ToArray()
+            : [];
+        var modes = new List<ExecutionModeUsage>();
+        if (d.Array("modes") is { } modeArray)
+            foreach (var m in modeArray.EnumerateArray())
+                if (Enum.TryParse<ExecutionModeKind>(m.Text("kind"), true, out var modeKind) && m.Text("mode") is { } mode && m.Text("evidence") is { } evidence)
+                    modes.Add(new ExecutionModeUsage(m.Text("model") ?? "", kind, modeKind, mode, evidence, m.Text("provider"),
+                        m.Integer("requests"), m.Integer("output"), m.Integer("measured_output"), m.Integer("measured_ms")));
+        var facts = d.Array("unpriced") is { } unpriced
+            ? unpriced.EnumerateArray().Select(f => new Unpriced.UnpricedCount(
+                Unpriced.UnpricedFact.Of(f.Text("model"), f.Text("provider"), f.Boolean("fast") == true, f.Boolean("no_date") == true), f.Integer("count"))).ToArray()
+            : [];
+        return new DailyUsage(day, kind, Totals(d), d.Integer("measured_output"), d.Integer("measured_ms"), d.Integer("unfinalized"), (int)d.Integer("agents"), d.NullableNumber("peak"), models)
+            { HostId = Id, Cost = Cost(d), Modes = modes, Unpriced = new Unpriced.UnpricedReading(Cost(d) is null ? d.Integer("requests") : 0, 0, facts) };
+    }
+
+    public RemoteHostStatus Status()
+    {
+        bool sameZone = HistoryTimezone == LocalTimezone();
+        return new(Id, Label, Online, Error) { MachineId = _historyMachineId ?? _machineId ?? Id.ToString(), Days = sameZone ? Days : [], HistoryPartial = sameZone ? HistoryPartial : null,
+            HistoryReceivedAt = sameZone ? HistoryReceivedAt : null, HistoryCurrent = sameZone && Online && HistoryCurrent };
+    }
+
+    internal static string LocalTimezone() => TimeZoneInfo.TryConvertWindowsIdToIanaId(TimeZoneInfo.Local.Id, out var iana) ? iana : TimeZoneInfo.Local.Id;
+    internal static SourceKind? Kind(string? value)
+    {
+        foreach (var kind in Enum.GetValues<SourceKind>())
+            if (string.Equals(ReportBody.SourceId(kind), value, StringComparison.OrdinalIgnoreCase)) return kind;
+        return null;
+    }
+    internal static CostTally? Cost(JsonElement e) => e.NullableNumber("cost_micro_usd") is not null && e.NullableNumber("unpriced_requests") is not null
+        ? new CostTally(e.Integer("cost_micro_usd"), e.Integer("unpriced_requests")) : null;
+    internal static TokenTotals Totals(JsonElement e, string prefix = "") => new(e.Integer(prefix + "requests"), e.Integer(prefix + "input"), e.Integer(prefix + "cached_input"), e.Integer(prefix + "cache_write_input"), e.Integer(prefix + "output"), e.Integer(prefix + "reasoning"));
+}
+
+internal static class RemoteJson
+{
+    internal static JsonElement? Array(this JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Array ? v : null;
+    internal static string? Text(this JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
+    internal static double? NullableNumber(this JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetDouble(out var n) && double.IsFinite(n) ? n : null;
+    internal static double Number(this JsonElement e, string name) => e.NullableNumber(name) ?? 0;
+    internal static long Integer(this JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt64(out var n) ? n : 0;
+    internal static bool? Boolean(this JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && (v.ValueKind == JsonValueKind.True || v.ValueKind == JsonValueKind.False) ? v.GetBoolean() : null;
+}
