+    private static ImmutableArray<RemoteHost> ReadRemoteHosts(JsonElement root)
+    {
+        if (!root.TryGetProperty("remoteHosts", out var value) || value.ValueKind != JsonValueKind.Array)
+            return ImmutableArray<RemoteHost>.Empty;
+        var hosts = ImmutableArray.CreateBuilder<RemoteHost>();
+        var ids = new HashSet<Guid>();
+        var destinations = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var item in value.EnumerateArray())
+        {
+            if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty("id", out var idValue)
+                || idValue.ValueKind != JsonValueKind.String || !Guid.TryParse(idValue.GetString(), out var id)
+                || id == Guid.Empty) continue;
+            var host = new RemoteHost(id, ReadString(item, "label") ?? "", ReadString(item, "destination") ?? "", ReadBool(item, "enabled", false));
+            if (host.ValidDestination && ids.Add(id) && destinations.Add(host.Destination)) hosts.Add(host);
+        }
+        return hosts.ToImmutable();
+    }
