@@ -0,0 +1,37 @@
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.History;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public sealed class RemoteHistoryCsvTests
+{
+    [Fact]
+    public void HistoryCsvAddsHostIdentityWithoutChangingLegacyExport()
+    {
+        var day = new DaySummary(new(2026, 10, 24), 1, 0, 0, 0, 10, 0, 10, 1000, 0, 1, null, [], []);
+        var host = Guid.NewGuid().ToString();
+        var local = HistoryCsv.Build([day], SourceKind.Pi);
+        var remote = HistoryCsv.Build([day], SourceKind.Pi, hostId: host);
+        var localLines = local.Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+        var remoteLines = remote.Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+
+        Assert.Equal("host_id," + localLines[0], remoteLines[0]);
+        Assert.Equal(host + "," + localLines[1], remoteLines[1]);
+        Assert.Contains(",pi,", remoteLines[1], StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void ModeCsvAddsHostIdentityWithoutChangingModeColumns()
+    {
+        var day = new DaySummary(new(2026, 10, 24), 1, 0, 0, 0, 10, 0, 10, 1000, 0, 1, null, [], [])
+        {
+            Modes = [new("model", SourceKind.Pi, ExecutionModeKind.Effort, "high", "recorded", null, 1, 10, 10, 1000)],
+        };
+        var host = Guid.NewGuid().ToString();
+        var localLines = ExecutionModeCsv.Build([day]).Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+        var remoteLines = ExecutionModeCsv.Build([day], host).Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
+
+        Assert.Equal("host_id," + localLines[0], remoteLines[0]);
+        Assert.Equal(host + "," + localLines[1], remoteLines[1]);
+    }
+}
