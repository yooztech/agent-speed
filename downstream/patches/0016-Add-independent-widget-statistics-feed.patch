+            if made_user: command('userdel', user)
+            if made_ca: CA.unlink(missing_ok=True)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--collector', required=True)
+    parser.add_argument('--evidence', required=True, help='path to write non-secret JSON evidence')
+    args = parser.parse_args()
+    try:
+        result = run(args)
