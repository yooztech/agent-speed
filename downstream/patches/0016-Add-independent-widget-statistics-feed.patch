+namespace {
+std::string subscribe(std::string request="r", std::string id="widget", std::string lease="lease", std::int64_t expiry=1710098200000LL, std::string host="host") {
+    return "{\"version\":1,\"type\":\"widget_subscribe\",\"controlVersion\":2,\"requestId\":\""+request+"\",\"subscriptionId\":\""+id+"\",\"lease\":\""+lease+"\",\"expiresAt\":"+std::to_string(expiry)+",\"hostId\":\""+host+"\",\"hostName\":\"name\",\"timezone\":\"UTC\",\"intervalMs\":1800000}";
+}
+std::string unsubscribe(std::string request, std::string id, std::string lease) {
+    return "{\"version\":1,\"type\":\"widget_unsubscribe\",\"controlVersion\":2,\"requestId\":\""+request+"\",\"subscriptionId\":\""+id+"\",\"lease\":\""+lease+"\"}";
+}
+bool accepted(const std::string& s) { agentspeed::json::Document d; return d.parse(s) && d.root()["accepted"].isTrue(); }
+template<class F> bool eventually(F f) { for(int i=0;i<200;++i) { if(f()) return true; std::this_thread::sleep_for(std::chrono::milliseconds(5)); } return false; }
+collector::Sample sampleAt(std::int64_t now, std::int64_t input = 3, std::int64_t output = 4) {
+    collector::Sample s;
+    s.snapshot.nowMs = now;
+    s.snapshot.todayInput = input;
+    s.snapshot.todayOutput = output;
+    agentspeed::SourceRow row;
+    row.source = agentspeed::SourceKind::Omp;
+    row.enabled = true;
+    row.available = true;
+    row.todayInput = input;
+    row.todayOutput = output;
+    s.snapshot.sources.push_back(row);
+    return s;
+}
+std::string dayLabel(const std::string& zone, std::int64_t ms) {
+    const auto label = agentspeed::history::DayLabeler(agentspeed::TimeZone::load(zone)).label(ms);
+    return label.value_or(std::string());
+}
+// Seven ascending scanned days ending at the calendar day of `now` in `zone`.
+std::shared_ptr<collector::StatisticsHistory> scanned(const std::string& zone, std::int64_t now, std::int64_t base = 300) {
+    auto h = std::make_shared<collector::StatisticsHistory>();
+    h->timezone = zone;
+    h->usageDate = dayLabel(zone, now);
+    h->complete = true;
+    for (int i = 0; i < 7; ++i) {
+        agentspeed::history::DailyUsage row;
+        row.key.day = dayLabel(zone, now - std::int64_t(6 - i) * 86400000LL);
+        row.key.source = agentspeed::SourceKind::Omp;
+        row.totals.input = base + i;
+        row.totals.output = base + i;
+        row.totals.requests = 1;
+        h->days.push_back(row);
+    }
+    return h;
+}
+std::shared_ptr<collector::StatisticsHistory> scannedYesterday(const std::string& zone, std::int64_t now) {
+    auto h = scanned(zone, now - 86400000LL);
+    h->usageDate = dayLabel(zone, now - 86400000LL);
+    return h;
+}
+void pump(collector::WidgetPublisher& p, std::int64_t now,
+          const std::shared_ptr<const collector::StatisticsHistory>& history) {
+    for (const auto& view : p.views()) p.sample(view, sampleAt(now), history);
+}
+void sample(collector::WidgetPublisher& p, std::int64_t now) {
+    for (const auto& view : p.views())
+        p.sample(view, sampleAt(now), scanned(view.name.value_or("UTC"), now));
+}
+constexpr std::int64_t start=1710088200000LL;
+}
+TEST(WidgetPublisher, ConfirmsOnlyAfter200AndRejectsUnexpectedFields) {
+    std::atomic<std::int64_t> now{start}; std::atomic<int> calls{0}; std::string body; std::mutex mutex;
