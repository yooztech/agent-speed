+    for (unsigned char c : z) if (!(std::isalnum(c) || c=='/' || c=='_' || c=='-' || c=='+')) return false;
+    return true;
+}
+size_t bodyWrite(char* p, size_t a, size_t b, void* data) {
+    auto& body=*static_cast<std::string*>(data); size_t n=a*b; if (n>4096-body.size()) return 0; body.append(p,n); return n;
+}
+size_t headerWrite(char* p, size_t a, size_t b, void* data) {
+    size_t n=a*b; std::string s(p,n); auto& ms=*static_cast<std::int64_t*>(data);
+    if (s.size()>12 && std::equal(s.begin(),s.begin()+12,"retry-after:",[](char x,char y){return std::tolower(static_cast<unsigned char>(x))==y;})) {
+        const char* q=s.c_str()+12; while (*q==' ' || *q=='\t') ++q;
+        std::int64_t v=0; bool ok=false; while (*q>='0' && *q<='9') { ok=true; v=std::min<std::int64_t>(2592000,v*10+(*q++-'0')); }
