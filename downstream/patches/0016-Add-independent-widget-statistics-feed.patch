+}
+void WidgetPublisher::sample(const View& view,const Sample& sample,const std::shared_ptr<const StatisticsHistory>& history) {
+    std::lock_guard<std::mutex> lock(impl_->mutex); auto now=impl_->options.clock(); impl_->prune(now);
+    for (auto& l:impl_->leases) {
+        if (l.view.name!=view.name || l.view.zone!=view.zone || l.inFlight) continue;
+        const bool routine=l.next<=now;
+        if (!routine && !l.needsCoverage) continue;
+        if (now<l.probe || now<l.notBefore) continue;
+        if (sample.snapshot.nowMs<l.created || sample.snapshot.nowMs>now || now-sample.snapshot.nowMs>30000 || sample.snapshot.nowMs<=l.lastAttemptSample) continue;
+        auto stats=widgetStatistics(sample,view,history,l.host,l.name);
+        if (!stats || stats->payload.size()>65536-sizeof("{\"snapshot\":}")+1) continue;
+        if (!stats->pastCovered) {
+            // A null past day is reserved for a scanned day without records. The history did not
+            // reach this window (missing, stale or another zone), so the stored payload stays and
+            // the sampler is asked to catch up instead. Retry far below the routine interval.
+            l.needsCoverage=true;
+            l.probe=now+Impl::probeMs;
+            if (l.confirmed) continue;
+        } else {
+            l.needsCoverage=false;
+            l.correction=!routine;
+            if (!routine) l.mustPublish=true;
+        }
+        l.payload="{\"snapshot\":"+stats->payload+"}"; l.payloadSampledAt=sample.snapshot.nowMs;
+    }
+    impl_->cv.notify_one();
+}
+std::vector<View> WidgetPublisher::views() const {
+    std::lock_guard<std::mutex> lock(impl_->mutex); auto now=impl_->options.clock(); std::vector<View> out;
+    for (const auto& l:impl_->leases)
+        if (l.expiry>now && (l.confirmed || l.deadline>now) && !l.inFlight && l.payload.empty() && now>=l.notBefore &&
+            now>=l.probe && (l.next<=now || l.needsCoverage) &&
+            std::none_of(out.begin(),out.end(),[&](const View& v){return v.name==l.view.name && v.zone==l.view.zone;})) out.push_back(l.view);
+    return out;
+}
+bool WidgetPublisher::needsCoverage() const {
+    std::lock_guard<std::mutex> lock(impl_->mutex); auto now=impl_->options.clock();
+    return std::any_of(impl_->leases.begin(),impl_->leases.end(),[&](const Impl::Lease& l){
+        return l.needsCoverage && l.expiry>now && (l.confirmed || l.deadline>now); });
+}
+std::vector<std::pair<std::uint64_t,std::string>> WidgetPublisher::replies() { std::lock_guard<std::mutex> lock(impl_->mutex); impl_->prune(impl_->options.clock()); auto out=std::move(impl_->pending); impl_->pending.clear(); return out; }
+void WidgetPublisher::disconnected(std::uint64_t client) {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    for (auto it=impl_->leases.begin();it!=impl_->leases.end();) {
+        auto& w=it->waiters; w.erase(std::remove_if(w.begin(),w.end(),[&](const Impl::Waiter& x){return x.client==client;}),w.end());
+        if (!it->confirmed && w.empty()) { impl_->retire(*it); it=impl_->leases.erase(it); } else ++it;
+    }
+    for (auto it=impl_->requests.begin();it!=impl_->requests.end();) if (it->first.first==client) it=impl_->requests.erase(it); else ++it;
+    impl_->pending.erase(std::remove_if(impl_->pending.begin(),impl_->pending.end(),[&](const auto& p){return p.first==client;}),impl_->pending.end());
+}
+bool WidgetPublisher::authorized(std::int64_t now) const { std::lock_guard<std::mutex> lock(impl_->mutex); return std::any_of(impl_->leases.begin(),impl_->leases.end(),[&](const Impl::Lease& l){return l.confirmed && l.expiry>now;}); }
+}
