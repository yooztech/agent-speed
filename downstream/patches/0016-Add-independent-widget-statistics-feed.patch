+class Relay(http.server.ThreadingHTTPServer):
+    daemon_threads = True
+    allow_reuse_address = True
+
+    def __init__(self):
+        super().__init__(('127.0.0.1', 19443), Handler)
+        self.lock = threading.Lock()
+        self.records = []
+        self.tokens = {}
+        self.gate = threading.Event()
+
+    def count(self, label):
+        with self.lock:
+            return sum(record['label'] == label for record in self.records)
+
+    def record(self, label):
+        with self.lock:
+            return next(record for record in self.records if record['label'] == label)
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def do_POST(self):
+        size = int(self.headers.get('Content-Length', '0'))
+        if size > 65536:
+            self.send_error(413)
+            return
+        body = self.rfile.read(size)
+        token = self.headers.get('Authorization', '').removeprefix('Bearer ')
+        with self.server.lock:
+            label = self.server.tokens.get(token, 'unknown')
+            self.server.records.append({'label': label, 'path': self.path, 'body': body})
+        if label == 'first':
+            self.server.gate.wait(20)
+        status = 401 if label in ('bad', 'unknown') else 200
