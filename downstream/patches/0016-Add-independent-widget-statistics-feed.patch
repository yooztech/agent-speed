+#include <gtest/gtest.h>
+#include "widget_statistics.hpp"
+#include "agentspeed/json.hpp"
+
+namespace {
+using namespace collector;
+using agentspeed::SourceKind;
+Sample sample() {
+    Sample s;
+    s.snapshot.nowMs = 1710088200000LL; // 2024-03-10 19:10 UTC, US DST transition
+    s.snapshot.todayInput = 11;
+    s.snapshot.todayOutput = 7;
+    agentspeed::SourceRow row;
+    row.source = SourceKind::Codex;
+    row.available = true;
+    row.todayInput = 11;
+    row.todayOutput = 7;
+    s.snapshot.sources.push_back(row);
+    return s;
+}
+View view(const char* name = "UTC") { return {std::string(name), agentspeed::TimeZone::load(name)}; }
+std::shared_ptr<StatisticsHistory> history() {
+    auto h = std::make_shared<StatisticsHistory>();
+    h->timezone = "UTC";
+    h->usageDate = "2024-03-10";
+    h->complete = true;
+    for (int d = 4; d <= 10; ++d) {
+        agentspeed::history::DailyUsage row;
+        row.key.day = "2024-03-" + std::string(d < 10 ? "0" : "") + std::to_string(d);
+        row.key.source = SourceKind::Codex;
+        row.totals.input = d;
+        row.totals.output = d + 1;
+        h->days.push_back(row);
+    }
+    return h;
+}
