+        require(all(r['input'] is not None and r['output'] is not None for r in s['models']), 'complete models contain unknowns')
+        require(sum(r['input'] for r in s['models']) == s['today']['input'] and sum(r['output'] for r in s['models']) == s['today']['output'], 'complete models do not match today')
+    return {'today': s['today'], 'days': s['days'], 'models': s['models'], 'modelsComplete': s['modelsComplete'], 'usageDate': s['usageDate'], 'timezone': s['timezone'], 'historyComplete': s['historyComplete']}
+
+
