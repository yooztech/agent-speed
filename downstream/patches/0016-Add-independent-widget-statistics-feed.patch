+#pragma once
+
+#include "publisher.hpp"
+
+namespace collector {
+struct StatisticsHistory;
+class WidgetPublisher {
+public:
+    using Result = Publisher::Result;
+    using Transport = Publisher::Transport;
+    struct Options {
+        Transport transport;
+        std::function<std::int64_t()> clock;
+        std::int64_t confirmationMs = 75000;
+        std::int64_t intervalMs = 1800000;
+    };
+    WidgetPublisher();
+    explicit WidgetPublisher(Options);
+    ~WidgetPublisher();
+    WidgetPublisher(const WidgetPublisher&) = delete;
+    WidgetPublisher& operator=(const WidgetPublisher&) = delete;
+    std::vector<std::string> control(const std::string&, std::uint64_t, std::int64_t);
+    void sample(const View&, const Sample&, const std::shared_ptr<const StatisticsHistory>&);
+    std::vector<View> views() const;
+    // True while a lease is waiting for a projection whose history covers the published window.
+    // The sampler should be asked to refresh its history rather than the lease being republished.
+    bool needsCoverage() const;
+    std::vector<std::pair<std::uint64_t, std::string>> replies();
+    void disconnected(std::uint64_t);
+    bool authorized(std::int64_t) const;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+}
diff --git a/linux/collector/widget_statistics.cpp b/linux/collector/widget_statistics.cpp
new file mode 100644
index 00000000..8a74f4af
--- /dev/null
+++ b/linux/collector/widget_statistics.cpp
@@ -0,0 +1,210 @@
+#include "widget_statistics.hpp"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <map>
+#include <set>
+#include <sstream>
+#include <string_view>
+
+namespace collector {
+namespace {
+constexpr std::int64_t maxInteger = 9007199254740991LL;
+
+bool validText(std::string_view s, std::size_t limit) {
+    if (s.empty() || s.size() > limit) return false;
+    for (std::size_t i = 0; i < s.size();) {
+        unsigned char c = s[i++];
+        if (c < 0x80) continue;
+        unsigned length = c >= 0xc2 && c <= 0xdf ? 2 : c >= 0xe0 && c <= 0xef ? 3 : c >= 0xf0 && c <= 0xf4 ? 4 : 0;
+        if (!length || i + length - 1 > s.size()) return false;
+        unsigned char first = static_cast<unsigned char>(s[i]);
+        if ((c == 0xe0 && first < 0xa0) || (c == 0xed && first >= 0xa0) ||
+            (c == 0xf0 && first < 0x90) || (c == 0xf4 && first >= 0x90)) return false;
+        for (unsigned j = 1; j < length; ++j)
+            if ((static_cast<unsigned char>(s[i++]) & 0xc0) != 0x80) return false;
+    }
+    return true;
+}
+void text(std::ostream& out, std::string_view value) {
+    static constexpr char hex[] = "0123456789abcdef";
+    out << '"';
+    for (unsigned char c : value) {
+        if (c == '"' || c == '\\') out << '\\' << static_cast<char>(c);
+        else if (c < 0x20) out << "\\u00" << hex[c >> 4] << hex[c & 15];
+        else out << static_cast<char>(c);
+    }
+    out << '"';
+}
+bool safe(std::int64_t value) { return value >= 0 && value <= maxInteger; }
+struct Counts {
+    std::optional<std::int64_t> input, output, requests, cost, unpriced;
+    bool complete = false;
+};
+void number(std::ostream& out, const std::optional<std::int64_t>& value) {
+    if (value) out << *value; else out << "null";
+}
+bool add(std::optional<std::int64_t>& sum, const std::optional<std::int64_t>& value) {
+    if (value && !safe(*value)) return false;
+    if (!sum || !value) { sum.reset(); return true; }
+    if (*sum > maxInteger - *value) return false;
+    *sum += *value;
+    return true;
+}
+void counts(std::ostream& out, const Counts& c) {
+    out << "\"input\":"; number(out, c.input);
+    out << ",\"output\":"; number(out, c.output);
+    out << ",\"requests\":"; number(out, c.requests);
+    out << ",\"costMicroUsd\":"; number(out, c.cost);
+    out << ",\"unpricedRequests\":"; number(out, c.unpriced);
+    out << ",\"complete\":" << (c.complete ? "true" : "false");
+}
+std::optional<std::array<std::string, 7>> dates(const std::string& date) {
+    if (date.size() != 10 || date[4] != '-' || date[7] != '-') return std::nullopt;
+    for (std::size_t i : {0, 1, 2, 3, 5, 6, 8, 9}) if (date[i] < '0' || date[i] > '9') return std::nullopt;
+    const int y = std::stoi(date.substr(0, 4));
+    const unsigned m = std::stoi(date.substr(5, 2)), d = std::stoi(date.substr(8, 2));
+    const std::chrono::year_month_day ymd{std::chrono::year{y}, std::chrono::month{m}, std::chrono::day{d}};
+    if (!ymd.ok()) return std::nullopt;
+    std::array<std::string, 7> result;
+    for (int i = 0; i < 7; ++i) {
+        auto day = std::chrono::year_month_day{std::chrono::sys_days{ymd} - std::chrono::days{6 - i}};
+        int year = int(day.year());
+        if (year < 1 || year > 9999) return std::nullopt;
+        char buf[11];
+        std::snprintf(buf, sizeof(buf), "%04d-%02u-%02u", year, unsigned(day.month()), unsigned(day.day()));
+        result[i] = buf;
+    }
+    return result;
+}
+}
+
+std::optional<WidgetSnapshot> widgetStatistics(const Sample& sample, const View& view,
+    const std::shared_ptr<const StatisticsHistory>& history, const std::string& hostId, const std::string& hostName) {
+    if (!view.name || !view.zone || !validText(*view.name, 128) || !validText(hostId, 128) || !validText(hostName, 128) ||
+        sample.snapshot.nowMs < -maxInteger || sample.snapshot.nowMs > maxInteger) return std::nullopt;
+    const auto namedZone = agentspeed::TimeZone::load(*view.name);
+    if (!namedZone || namedZone->identity() != view.zone->identity()) return std::nullopt;
+    const auto date = agentspeed::history::DayLabeler(view.zone).label(sample.snapshot.nowMs);
+    if (!date) return std::nullopt;
+    const auto calendar = dates(*date);
+    if (!calendar) return std::nullopt;
+    const auto& snapshot = sample.snapshot;
+    std::map<agentspeed::SourceKind, const agentspeed::SourceRow*> sources;
+    std::set<std::string_view> identifiers;
+    std::set<agentspeed::SourceKind> participating;
+    for (const auto& row : snapshot.sources) {
+        if (static_cast<unsigned>(row.source) > static_cast<unsigned>(agentspeed::SourceKind::Droid)) return std::nullopt;
+        auto id = agentspeed::sourceId(row.source);
+        if (!validText(id, 64) || !identifiers.insert(id).second || !sources.emplace(row.source, &row).second) return std::nullopt;
+        if (!safe(row.todayInput) || !safe(row.todayOutput) || !safe(row.todayRequests) || !safe(row.todayCostMicroUsd) || !safe(row.unpricedRequests)) return std::nullopt;
+        if (row.enabled && (row.todayInput || row.todayOutput || row.todayRequests || row.todayCostMicroUsd || row.unpricedRequests)) participating.insert(row.source);
+    }
+    if (sources.size() > 32) return std::nullopt;
+    if (!safe(snapshot.todayInput) || !safe(snapshot.todayOutput) || !safe(snapshot.todayRequests) ||
+        !safe(snapshot.todayCostMicroUsd) || !safe(snapshot.todayUnpricedRequests)) return std::nullopt;
+    Counts today;
+    today.input = snapshot.todayInput; today.output = snapshot.todayOutput;
+    today.complete = !snapshot.warnings.partialHistory;
+    if (today.complete) { today.requests = snapshot.todayRequests; today.cost = snapshot.todayCostMicroUsd; today.unpriced = snapshot.todayUnpricedRequests; }
+
+    const bool matching = history && history->timezone == *view.name && history->usageDate == *date;
+    std::array<Counts, 7> days;
+    using Model = std::pair<std::optional<std::int64_t>, std::optional<std::int64_t>>;
+    std::map<std::string, Model> models;
+    bool currentCovered = false;
+    if (matching) {
+        std::map<std::pair<std::string, agentspeed::SourceKind>, const agentspeed::history::DailyUsage*> rows;
+        for (const auto& row : history->days) {
+            if (row.key.day < calendar->front() || row.key.day > calendar->back()) continue;
+            if (!safe(row.totals.input) || !safe(row.totals.output) || !safe(row.totals.requests) ||
+                (row.totals.costMicroUsd && !safe(*row.totals.costMicroUsd)) ||
+                (row.totals.unpricedRequests && !safe(*row.totals.unpricedRequests)) ||
+                !rows.emplace(std::make_pair(row.key.day, row.key.source), &row).second) return std::nullopt;
+            participating.insert(row.key.source);
+        }
+        for (std::size_t i = 0; i < days.size(); ++i) {
+            Counts sum; sum.input = sum.output = sum.requests = sum.cost = sum.unpriced = 0;
+            bool covered = true, found = false;
+            for (const auto kind : participating) {
+                // A recorded row is a fact about that day. Whether the source is detected or enabled
+                // right now only decides today's live counts, so it must not erase yesterday's sum:
+                // one retired source would otherwise empty the whole window beside a real today.
+                auto it = rows.find({(*calendar)[i], kind});
+                if (it == rows.end()) { covered = false; continue; }
+                found = true;
+                const auto& totals = it->second->totals;
+                if (!add(sum.input, totals.input) || !add(sum.output, totals.output) || !add(sum.requests, totals.requests) ||
+                    !add(sum.cost, totals.costMicroUsd) || !add(sum.unpriced, totals.unpricedRequests)) return std::nullopt;
+            }
+            if (found) { days[i].input = sum.input; days[i].output = sum.output; }
+            days[i].complete = covered && found && history->complete;
+            if (days[i].complete) { days[i].requests = sum.requests; days[i].cost = sum.cost; days[i].unpriced = sum.unpriced; }
+            if (i == 6) currentCovered = covered && found;
+        }
+        for (const auto& [key, row] : rows) {
+            if (key.first != *date) continue;
+            for (const auto& [name, value] : row->totals.models) {
+                if (!name.empty() && !validText(name, 256)) return std::nullopt;
+                auto [it, inserted] = models.try_emplace(name, Model{0, 0});
+                if (!add(it->second.first, value.input) || !add(it->second.second, value.output)) return std::nullopt;
+            }
+        }
+    }
+    bool modelsComplete = today.complete && matching && history->complete && currentCovered;
+    std::optional<std::int64_t> modelInput = 0, modelOutput = 0;
+    for (const auto& [name, value] : models) {
+        if (!value.first || !value.second) modelsComplete = false;
+        if (!add(modelInput, value.first) || !add(modelOutput, value.second)) return std::nullopt;
+    }
+    modelsComplete = modelsComplete && modelInput == today.input && modelOutput == today.output;
+    std::vector<std::pair<std::string, Model>> ranked;
+    for (const auto& entry : models) if (!entry.first.empty() && entry.second.first && entry.second.second) ranked.push_back(entry);
+    std::sort(ranked.begin(), ranked.end(), [](const auto& a, const auto& b) {
+        auto at = static_cast<std::uint64_t>(*a.second.first) + *a.second.second;
+        auto bt = static_cast<std::uint64_t>(*b.second.first) + *b.second.second;
+        return at != bt ? at > bt : a.first < b.first;
+    });
+    if (ranked.size() > 3) ranked.resize(3);
+    std::set<std::string> selected;
+    for (const auto& entry : ranked) selected.insert(entry.first);
+    Model other{0, 0}; bool hasOther = false;
+    for (const auto& [name, value] : models) if (!selected.count(name)) {
+        hasOther = true;
+        if (!add(other.first, value.first) || !add(other.second, value.second)) return std::nullopt;
+    }
+    days.back() = today;
+    bool historyComplete = true;
+    for (const auto& day : days) historyComplete &= day.complete;
+    std::ostringstream out;
+    out << "{\"version\":2,\"hostId\":"; text(out, hostId);
+    out << ",\"hostName\":"; text(out, hostName);
+    out << ",\"sampledAt\":" << snapshot.nowMs << ",\"timezone\":"; text(out, *view.name);
+    out << ",\"usageDate\":"; text(out, *date);
+    out << ",\"today\":{"; counts(out, today); out << "},\"days\":[";
+    for (std::size_t i = 0; i < days.size(); ++i) {
+        if (i) out << ',';
+        out << "{\"date\":"; text(out, (*calendar)[i]); out << ','; counts(out, days[i]); out << '}';
+    }
+    out << "],\"models\":[";
+    bool first = true;
+    for (const auto& [name, value] : ranked) {
+        if (!first) out << ','; first = false;
+        out << "{\"model\":"; text(out, name);
+        out << ",\"input\":"; number(out, value.first);
+        out << ",\"output\":"; number(out, value.second); out << '}';
+    }
+    if (hasOther) {
+        if (!first) out << ',';
+        out << "{\"model\":null,\"input\":"; number(out, other.first);
+        out << ",\"output\":"; number(out, other.second); out << '}';
+    }
+    out << "],\"modelsComplete\":" << (modelsComplete ? "true" : "false")
+        << ",\"historyComplete\":" << (historyComplete ? "true" : "false") << '}';
+    auto result = out.str();
+    if (result.size() > 65536) return std::nullopt;
+    return WidgetSnapshot{std::move(result), matching};
+}
+}
