+    ASSERT_EQ(replies.size(),1u); EXPECT_TRUE(accepted(replies[0].second)); EXPECT_TRUE(p.authorized(now)); EXPECT_EQ(calls,1);
+    agentspeed::json::Document doc; { std::lock_guard<std::mutex> lock(mutex); ASSERT_TRUE(doc.parse(body)); }
