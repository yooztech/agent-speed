+struct WidgetPublisher::Impl {
+    // A refused projection is retried this often, far below the routine interval, so coverage is
+    // published as soon as the history scan reaches it.
+    static constexpr std::int64_t probeMs = 2000;
+    struct Waiter { std::uint64_t client; std::string request; };
+    struct Lease {
+        std::string id, token, host, name, zone, payload;
+        std::int64_t expiry=0, created=0, deadline=0, next=0, probe=0, notBefore=0;
+        std::int64_t payloadSampledAt=0, lastAttemptSample=-1;
+        std::uint64_t generation=0;
+        View view; bool confirmed=false, inFlight=false;
+        // The stored payload's past days were not scanned; no routine publish may replace it with
+        // a null window until a covered projection arrives.
+        bool needsCoverage=false;
+        // A pending payload is a coverage correction and bypasses the routine interval.
+        bool mustPublish=false, correction=false;
+        std::vector<Waiter> waiters;
+    };
+    struct Request { std::string binding, response; std::int64_t expiry; };
+    Options options; mutable std::mutex mutex; std::condition_variable cv; bool stop=false;
+    std::thread worker; std::vector<Lease> leases;
+    std::map<std::pair<std::uint64_t,std::string>,Request> requests;
+    std::map<std::pair<std::string,std::string>,std::int64_t> retired;
+    std::vector<std::pair<std::uint64_t,std::string>> pending;
+    std::uint64_t generation=0;
+    explicit Impl(Options o):options(std::move(o)) {
+        if (!options.clock) options.clock=wall;
+        if (!options.transport) options.transport=transport;
+        options.confirmationMs=std::max<std::int64_t>(1,std::min<std::int64_t>(75000,options.confirmationMs));
+        options.intervalMs=std::max<std::int64_t>(1,options.intervalMs);
+        worker=std::thread([this]{ run(); });
+    }
+    ~Impl() { { std::lock_guard<std::mutex> lock(mutex); stop=true; leases.clear(); } cv.notify_all(); worker.join(); }
+    void finish(Lease& l, bool success, const char* error=nullptr) {
+        for (const auto& w:l.waiters) {
+            auto response=ack("widget_subscribe",w.request,l.id,l.host,l.name,l.zone,l.expiry,success,error);
+            auto r=requests.find({w.client,w.request}); if (r!=requests.end()) r->second.response=response;
+            pending.emplace_back(w.client,std::move(response));
+        }
+        l.waiters.clear();
+    }
+    void retire(const Lease& l) { retired[{l.id,l.token}]=l.expiry; }
+    void prune(std::int64_t now) {
+        for (auto i=leases.begin(); i!=leases.end();) {
+            if (i->expiry<=now || (!i->confirmed && i->deadline<=now)) {
+                if (!i->confirmed) finish(*i,false,i->expiry<=now?"expired":"stats_unavailable");
+                retire(*i); i=leases.erase(i);
+            } else ++i;
+        }
+        for (auto i=retired.begin();i!=retired.end();) if (i->second<=now) i=retired.erase(i); else ++i;
+        for (auto i=requests.begin();i!=requests.end();) if (i->second.expiry<=now) i=requests.erase(i); else ++i;
+    }
+    void run() {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (!stop) {
+            auto now=options.clock(); prune(now);
+            auto it=std::find_if(leases.begin(),leases.end(),[&](const Lease& l){
+                return !l.inFlight && !l.payload.empty() && l.notBefore<=now && (l.mustPublish || l.next<=now); });
+            if (it==leases.end()) { cv.wait_for(lock,std::chrono::milliseconds(100)); continue; }
+            if (it->payloadSampledAt>now || now-it->payloadSampledAt>300000 || it->payloadSampledAt<=it->lastAttemptSample) {
+                it->payload.clear();
+                if (it->correction) { it->correction=false; it->needsCoverage=true; }
+                continue;
+            }
+            auto id=it->id, token=it->token, payload=std::move(it->payload); auto gen=it->generation;
+            it->inFlight=true; it->mustPublish=false; it->correction=false; it->next=now+options.intervalMs;
+            it->lastAttemptSample=it->payloadSampledAt;
+            lock.unlock(); auto result=options.transport(token,payload); lock.lock();
+            if (stop) break;
+            now=options.clock(); prune(now);
+            it=std::find_if(leases.begin(),leases.end(),[&](const Lease& l){return l.id==id && l.generation==gen;});
+            if (it==leases.end()) continue;
+            it->inFlight=false;
+            if (result.status==200) { if (!it->confirmed) { it->confirmed=true; finish(*it,true); } }
+            else if (!it->confirmed) { finish(*it,false,"publish_failed"); retire(*it); leases.erase(it); }
+            else if (result.status>=400 && result.status<500 && result.status!=429) { retire(*it); leases.erase(it); }
+            else if (result.status==429 && result.retryAfterMs>0) {
+                it->next=std::max(it->next,now+std::min<std::int64_t>(result.retryAfterMs,2592000000LL));
+                // A correction may not bypass a server-mandated delay.
+                it->notBefore=std::max(it->notBefore,it->next);
+            }
+        }
+    }
+};
