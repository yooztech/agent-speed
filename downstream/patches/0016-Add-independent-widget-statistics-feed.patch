+std::vector<std::string> WidgetPublisher::control(const std::string& line,std::uint64_t client,std::int64_t now) {
+    if (line.size()>16384) return {};
+    agentspeed::json::Document doc; if (!doc.parse(line,32) || !doc.root().isObject()) return {};
+    auto root=doc.root(); auto type=root["type"].string().value_or("");
+    if (type!="widget_subscribe" && type!="widget_unsubscribe") return {};
+    auto req=root["requestId"].string().value_or(""), id=root["subscriptionId"].string().value_or(""), token=root["lease"].string().value_or("");
+    auto host=root["hostId"].string().value_or(""), name=root["hostName"].string().value_or(""), zone=root["timezone"].string().value_or("");
+    auto expiry=root["expiresAt"].isIntegerLiteral()?root["expiresAt"].truncated().value_or(0):0;
+    auto bad=[&](const char* e){return std::vector<std::string>{ack(type,req,id,host,name,zone,expiry,false,e)};};
+    std::set<std::string> keys={"version","type","controlVersion","requestId","subscriptionId","lease"};
+    if (type=="widget_subscribe") keys.insert({"expiresAt","hostId","hostName","timezone","intervalMs"});
+    std::set<std::string> seen;
+    for (const auto& member:root.members()) if (!keys.count(member.first) || !seen.insert(member.first).second) return bad("invalid_request");
+    if (seen!=keys || !root["version"].isIntegerLiteral() || root["version"].truncated()!=1 || !root["controlVersion"].isIntegerLiteral() || root["controlVersion"].truncated()!=2 || !text(req,128) || !utf8(req) || !text(id,128) || !utf8(id) || !text(token,4096,true)) return bad("invalid_request");
+    std::shared_ptr<const agentspeed::TimeZone> tz;
+    if (type=="widget_subscribe") {
+        if (!text(host,128) || !utf8(host) || !text(name,128) || !utf8(name) || !zoneName(zone) || !root["intervalMs"].isIntegerLiteral() || root["intervalMs"].truncated()!=1800000 || expiry<=now || expiry-now>2592000000LL || !(tz=agentspeed::TimeZone::load(zone))) return bad("invalid_request");
+    }
+    auto binding=J::array({J::of(type),J::of(id),J::of(token),J::of(host),J::of(name),J::of(zone),J::of(expiry)}).compact();
+    std::lock_guard<std::mutex> lock(impl_->mutex); impl_->prune(now);
+    auto prior=impl_->requests.find({client,req});
+    if (prior!=impl_->requests.end()) {
+        if (prior->second.binding!=binding) return bad("conflicting_request");
+        if (type=="widget_subscribe" && prior->second.response.find("\"accepted\":true")!=std::string::npos && impl_->retired.count({id,token})) return bad("cancelled");
+        if (!prior->second.response.empty()) return {prior->second.response};
+        return {};
+    }
+    if (impl_->requests.size()>=256 || impl_->pending.size()>=256) return bad("busy");
+    auto it=std::find_if(impl_->leases.begin(),impl_->leases.end(),[&](const Impl::Lease& l){return l.id==id;});
+    if (type=="widget_unsubscribe") {
+        if (it!=impl_->leases.end() && it->token!=token) return bad("lease_mismatch");
+        if (it!=impl_->leases.end()) { if (!it->confirmed) impl_->finish(*it,false,"cancelled"); impl_->retire(*it); impl_->leases.erase(it); }
+        else if (!impl_->retired.count({id,token})) {
+            if (impl_->retired.size()+impl_->leases.size()>=256) return bad("busy");
+            impl_->retired[{id,token}]=now+2592000000LL;
+        }
+        else impl_->retired[{id,token}]=now+2592000000LL;
+        auto response=ack(type,req,id,"","","",0,true); impl_->requests[{client,req}]={binding,response,now+75000}; return {response};
