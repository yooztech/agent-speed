+    if (type=="widget_subscribe") { j.add("hostId",J::of(host)); j.add("hostName",J::of(name)); j.add("timezone",J::of(zone)); j.add("expiresAt",J::of(expiry)); }
+    j.add("accepted",J::of(accepted)); if (error) j.add("error",J::of(error)); return j.compact()+"\n";
+}
