+    EXPECT_EQ(first.models.at("alpha").input, 26);
+    EXPECT_EQ(first.models.at("").input, 2);
+
+    auto legacy = decode(R"({"models":{"alpha":[1,4,0,0,null,null]}})");
+    ASSERT_TRUE(legacy);
+    EXPECT_FALSE(legacy->models.at("alpha").input);
+    first.merge(*legacy);
+    EXPECT_FALSE(first.models.at("alpha").input);
+    response.model = "alpha";
+    first.add(response, 0);
+    EXPECT_FALSE(first.models.at("alpha").input);
+
+    DayAggregate legacyFirst = *legacy;
+    legacyFirst.merge(second);
+    EXPECT_FALSE(legacyFirst.models.at("alpha").input);
+    EXPECT_EQ(legacyFirst.models.at("").input, 2);
+}
+
+TEST(History, ModelInputPersistenceIsAdditiveAndLegacyInputIsUnknown) {
+    auto legacy = decode(R"({"models":{"old":[2,9,7,100,4,0],"null":[1,3,0,0,null,null,null]}})");
+    ASSERT_TRUE(legacy);
+    EXPECT_FALSE(legacy->models.at("old").input);
+    EXPECT_FALSE(legacy->models.at("null").input);
+    EXPECT_EQ(legacy->models.at("old").output, 9);
+    EXPECT_EQ(legacy->models.at("old").costMicroUsd, 4);
+
+    ParsedResponse response;
+    response.model = "new";
+    response.tokens.input = 42;
+    response.tokens.output = 11;
+    legacy->add(response, 0);
+    const auto encoded = encode(*legacy);
+    EXPECT_NE(encoded.find("\"new\":[1,11,0,0,0,0,42]"), std::string::npos);
+    EXPECT_NE(encoded.find("\"old\":[2,9,7,100,4,0,null]"), std::string::npos);
+    const auto restored = decode(encoded);
+    ASSERT_TRUE(restored);
+    EXPECT_EQ(restored->models.at("new").input, 42);
+    EXPECT_EQ(restored->models.at("new").output, 11);
+    EXPECT_FALSE(restored->models.at("old").input);
+    EXPECT_FALSE(restored->models.at("null").input);
+}
