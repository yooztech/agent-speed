 namespace {
 class ScopedEnv {
@@ -115,3 +120,119 @@ TEST(CollectorSampler, SamplingNeverDrainsCompletions) {
     }
     std::filesystem::remove_all(home);
 }
+
+namespace {
+std::string stampOf(std::int64_t ms) {
+    const std::time_t seconds = static_cast<std::time_t>(ms / 1000);
+    std::tm utc{};
+    gmtime_r(&seconds, &utc);
+    char text[32];
+    std::strftime(text, sizeof(text), "%Y-%m-%dT%H:%M:%S.000Z", &utc);
+    return text;
+}
+std::string labelOf(std::int64_t ms) {
+    const auto label = agentspeed::history::DayLabeler(agentspeed::TimeZone::utc()).label(ms);
+    return label.value_or(std::string());
+}
+}
+
+// A widget-only daemon has no SSH client to drive a rescan: its projection must follow the
+// calendar by itself, and a sample taken after local midnight may not be paired with the
+// previous day's projection (that pairing is what produces six null past days beside a real
+// today). The past days stay real once the projection catches up.
+TEST(CollectorSampler, WidgetHistoryStaysCoveredAcrossMidnight) {
+    char home[] = "/tmp/agentspeed-sampler-widget-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    struct TempHome {
+        const char* path;
+        ~TempHome() { std::filesystem::remove_all(path); }
+    } tempHome{home};
+    ScopedEnv homeEnv("HOME", home);
+    ScopedEnv agentEnv("PI_CODING_AGENT_DIR", nullptr);
+    ScopedEnv sessionEnv("PI_CODING_AGENT_SESSION_DIR", nullptr);
+    ScopedEnv configEnv("PI_CONFIG_DIR", ".omp");
+    ScopedEnv codexEnv("CODEX_HOME", nullptr);
+    ScopedEnv claudeEnv("CLAUDE_CONFIG_DIR", nullptr);
+    ScopedEnv deepseekEnv("DSH_HOME", nullptr);
+    ScopedEnv xdgEnv("XDG_DATA_HOME", nullptr);
+    ScopedEnv geminiEnv("GEMINI_CLI_HOME", nullptr);
+    ScopedEnv tzEnv("TZ", "UTC");
+
+    using namespace std::chrono;
+    const auto today = floor<days>(system_clock::now());
+    const auto yesterday = today - days{1};
+    const auto t0 = yesterday + hours{23} + minutes{50};
+    const auto t1 = t0 + minutes{20};  // the following civil day, 00:10
+    const auto t0ms = duration_cast<milliseconds>(t0.time_since_epoch()).count();
+    const auto t1ms = duration_cast<milliseconds>(t1.time_since_epoch()).count();
+    ASSERT_NE(labelOf(t0ms), labelOf(t1ms));
+
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-widget-project";
+    std::filesystem::create_directories(dir);
+    for (int i = 0; i < 7; ++i) {
+        const auto when = yesterday - days{6 - i} + hours{12};
+        const auto ms = duration_cast<milliseconds>(when.time_since_epoch()).count();
+        const auto stamp = stampOf(ms);
+        std::ofstream(dir / ("session-" + std::to_string(i) + ".jsonl"))
+            << R"({"type":"session","version":3,"id":"session-)" << i << R"(","timestamp":")" << stamp << R"(","cwd":"/project"})" << '\n'
+            << R"({"type":"message","id":"response-)" << i << R"(","parentId":null,"timestamp":")" << stamp
+            << R"(","message":{"role":"assistant","content":[],"api":"openai-responses","provider":"openai","model":"gpt-5.5","usage":{"input":300,"output":410,"cacheRead":40,"cacheWrite":20,"reasoningTokens":70,"totalTokens":770},"stopReason":"stop","timestamp":)"
+            << ms << R"(,"duration":3000}})" << '\n';
+    }
+
+    std::atomic<std::int64_t> clock{t0ms};
+    collector::Sampler sampler(home, std::string(64, 'a'), [&] { return clock.load(); });
+    sampler.poll(t0ms);
+    const collector::View utc{std::string("UTC"), agentspeed::TimeZone::utc()};
+    const auto before = sampler.sample(t0ms, utc);
+    EXPECT_EQ(before.snapshot.nowMs, t0ms);
+    EXPECT_EQ(before.snapshot.todayInput, 360);
+    EXPECT_EQ(before.snapshot.todayOutput, 410);
+
+    std::shared_ptr<const collector::StatisticsHistory> projection;
+    for (int i = 0; i < 500 && !projection; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        projection = sampler.statisticsHistory(utc);
+    }
+    ASSERT_TRUE(projection);
+    EXPECT_EQ(projection->usageDate, labelOf(t0ms));
+    auto covered = collector::widgetStatistics(before, utc, projection, "h", "n");
+    ASSERT_TRUE(covered);
+    EXPECT_TRUE(covered->pastCovered);
+    agentspeed::json::Document doc;
+    ASSERT_TRUE(doc.parse(covered->payload));
+    for (std::size_t i = 0; i < 6; ++i) {
+        EXPECT_EQ(doc.root()["days"].at(int(i))["input"].raw(), "360") << "past day " << i;
+        EXPECT_EQ(doc.root()["days"].at(int(i))["output"].raw(), "410") << "past day " << i;
+    }
+
+    // The same projection cannot describe a sample taken after midnight: it is not covered.
+    clock = t1ms;
+    const auto after = sampler.sample(t1ms, utc);
+    EXPECT_EQ(after.snapshot.todayInput, 0);
+    auto stale = collector::widgetStatistics(after, utc, projection, "h", "n");
+    ASSERT_TRUE(stale);
+    EXPECT_FALSE(stale->pastCovered);
+
+    sampler.requestHistoryRefresh();
+    std::shared_ptr<const collector::StatisticsHistory> refreshed;
+    for (int i = 0; i < 250; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        refreshed = sampler.statisticsHistory(utc);
+        if (refreshed && refreshed.get() != projection.get() && refreshed->usageDate == labelOf(t1ms)) break;
+    }
+    ASSERT_TRUE(refreshed);
+    ASSERT_NE(refreshed.get(), projection.get());
+    EXPECT_EQ(refreshed->usageDate, labelOf(t1ms));
+    auto fresh = collector::widgetStatistics(after, utc, refreshed, "h", "n");
+    ASSERT_TRUE(fresh);
+    EXPECT_TRUE(fresh->pastCovered);
+    ASSERT_TRUE(doc.parse(fresh->payload));
+    for (std::size_t i = 0; i < 6; ++i) {
+        EXPECT_EQ(doc.root()["days"].at(int(i))["input"].raw(), "360") << "past day " << i;
+        EXPECT_EQ(doc.root()["days"].at(int(i))["output"].raw(), "410") << "past day " << i;
+    }
+    EXPECT_EQ(doc.root()["days"].at(6)["input"].raw(), "0");
+    EXPECT_EQ(doc.root()["days"].at(6)["output"].raw(), "0");
+    EXPECT_EQ(doc.root()["usageDate"].string(), labelOf(t1ms));
+}
