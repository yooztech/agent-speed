+// A recorded history row stays a known fact even when its source is no longer detected now.
+// Dropping such rows empties whole days: a widget-only daemon whose snapshot describes today
+// while the window's rows belong to a source that has since disappeared would publish six
+// null days beside a real today.
+TEST(WidgetStatistics, UndetectedHistoricalSourceKeepsKnownLowerBound) {
+    auto s = sample();
+    s.snapshot.sources[0].available = false;  // Codex has no detected root in this snapshot
+    agentspeed::SourceRow gemini;
+    gemini.source = SourceKind::Gemini;
+    gemini.available = true;
+    gemini.todayInput = 5;
+    gemini.todayOutput = 1;
+    s.snapshot.sources.push_back(gemini);  // active today, but no history row for any past day
+    auto result = widgetStatistics(s, view(), history(), "h", "n");
+    ASSERT_TRUE(result);
+    EXPECT_TRUE(result->pastCovered);
+    agentspeed::json::Document doc;
+    ASSERT_TRUE(doc.parse(result->payload));
+    auto day = doc.root()["days"].at(0);
+    EXPECT_EQ(day["input"].raw(), "4");
+    EXPECT_EQ(day["output"].raw(), "5");
+    EXPECT_FALSE(day["complete"].isTrue());
+    EXPECT_FALSE(doc.root()["historyComplete"].isTrue());
+    EXPECT_TRUE(doc.root()["days"].at(6)["input"].raw() == "11");
+}
