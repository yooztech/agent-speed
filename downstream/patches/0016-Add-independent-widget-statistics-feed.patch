+    if (it!=impl_->leases.end() && it->token==token) {
+        if (it->host!=host || it->name!=name || it->zone!=zone || it->expiry!=expiry) return bad("conflicting_request");
+        if (it->confirmed) { auto response=ack(type,req,id,host,name,zone,expiry,true); impl_->requests[{client,req}]={binding,response,expiry}; return {response}; }
+        if (it->waiters.size()>=32) return bad("busy");
+        it->waiters.push_back({client,req}); impl_->requests[{client,req}]={binding,"",expiry}; return {};
+    }
+    if (impl_->retired.count({id,token})) return bad("cancelled");
+    if (impl_->retired.size()+impl_->leases.size()>=256 || (it==impl_->leases.end() && impl_->leases.size()>=32)) return bad("busy");
+    if (it!=impl_->leases.end()) { if (!it->confirmed) impl_->finish(*it,false,"cancelled"); impl_->retire(*it); impl_->leases.erase(it); }
+    Impl::Lease l; l.id=id; l.token=token; l.host=host; l.name=name; l.zone=zone; l.expiry=expiry; l.created=now; l.deadline=now+impl_->options.confirmationMs; l.next=now; l.generation=++impl_->generation; l.view={zone,tz}; l.waiters.push_back({client,req});
