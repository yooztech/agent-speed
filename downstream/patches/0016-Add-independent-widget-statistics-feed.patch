+#pragma once
+
+#include "sampling.hpp"
+
+namespace collector {
+// A v2 Widget projection and whether it may replace a stored one. `payload` is the snapshot
+// object; `pastCovered` is true only when the history projection was built for this view's
+// timezone and current calendar day, so a null past day there means the scan found no records.
+// A projection that is not covered must not replace a stored payload on a routine slot.
+struct WidgetSnapshot {
+    std::string payload;
+    bool pastCovered = false;
+};
+
+std::optional<WidgetSnapshot> widgetStatistics(const Sample& sample, const View& view,
+    const std::shared_ptr<const StatisticsHistory>& history, const std::string& hostId,
+    const std::string& hostName);
+}
