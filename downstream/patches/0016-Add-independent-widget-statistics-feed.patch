diff --git a/linux/collector/relay_http.hpp b/linux/collector/relay_http.hpp
new file mode 100644
index 00000000..16d21855
--- /dev/null
+++ b/linux/collector/relay_http.hpp
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <curl/curl.h>
+
+namespace collector {
+// Both publishing workers share one initialization, including on libcurl builds
+// where curl_global_init itself is not safe to call concurrently.
+inline bool initializeRelayHttp() {
+    static const bool ready = [] {
+        if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) return false;
+        const auto* version = curl_version_info(CURLVERSION_NOW);
+        return version && (version->features & CURL_VERSION_ASYNCHDNS);
+    }();
+    return ready;
+}
+}
