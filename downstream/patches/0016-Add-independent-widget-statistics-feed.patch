+TEST(WidgetPublisher, RoutineSlotKeepsStoredPayloadWhenHistoryIsNotScanned) {
+    std::atomic<std::int64_t> now{start};
+    std::atomic<int> calls{0};
+    collector::WidgetPublisher::Options o;
+    o.clock = [&] { return now.load(); };
+    o.transport = [&](const auto&, const auto&) {
+        ++calls;
+        return collector::WidgetPublisher::Result{200};
+    };
+    collector::WidgetPublisher p(o);
+    EXPECT_TRUE(p.control(subscribe("a", "one", "l1", start + 9000000), 1, now).empty());
+    pump(p, now, nullptr);
+    ASSERT_TRUE(eventually([&] { return p.authorized(now); }));
+    EXPECT_EQ(calls.load(), 1);  // the confirmation projection may still be unscanned
+    EXPECT_TRUE(p.needsCoverage());
+    now += 1800000;  // routine slot, history still missing
+    pump(p, now, nullptr);
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    EXPECT_EQ(calls.load(), 1) << "an unscanned window replaced the stored payload";
+    EXPECT_TRUE(p.needsCoverage());
+    now += 1800000;  // next routine slot, history labelled for yesterday
+    pump(p, now, scannedYesterday("UTC", now));
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    EXPECT_EQ(calls.load(), 1) << "a stale projection replaced the stored payload";
+    EXPECT_TRUE(p.needsCoverage());
+    now += 2000;  // coverage completes: the correction is not held back by the interval
+    pump(p, now, scanned("UTC", now));
+    ASSERT_TRUE(eventually([&] { return calls.load() == 2; })) << "coverage completion was throttled";
+    EXPECT_FALSE(p.needsCoverage());
+}
+
+TEST(WidgetPublisher, PublishesTheCorrectionAsSoonAsCoverageArrives) {
+    std::atomic<std::int64_t> now{start};
+    std::atomic<int> calls{0};
+    std::mutex mutex;
+    std::vector<std::string> bodies;
+    collector::WidgetPublisher::Options o;
+    o.clock = [&] { return now.load(); };
+    o.transport = [&](const auto&, const auto& body) {
+        std::lock_guard<std::mutex> lock(mutex);
+        bodies.push_back(body);
+        ++calls;
+        return collector::WidgetPublisher::Result{200};
+    };
+    collector::WidgetPublisher p(o);
+    EXPECT_TRUE(p.control(subscribe("a", "one", "l1", start + 9000000), 1, now).empty());
+    pump(p, now, nullptr);
+    ASSERT_TRUE(eventually([&] { return p.authorized(now); }));
+    ASSERT_EQ(calls.load(), 1);
+    now += 2000;
+    pump(p, now, scanned("UTC", now));
+    ASSERT_TRUE(eventually([&] { return calls.load() == 2; }));
+    agentspeed::json::Document doc;
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        ASSERT_EQ(bodies.size(), 2u);
+        ASSERT_TRUE(doc.parse(bodies.at(1)));
+    }
+    auto days = doc.root()["snapshot"]["days"];
+    ASSERT_EQ(days.size(), 7u);
+    for (std::size_t i = 0; i < 6; ++i) {
+        EXPECT_FALSE(days.at(i)["input"].isNull()) << "past day " << i << " is still unscanned";
+        EXPECT_EQ(days.at(i)["input"].raw(), std::to_string(300 + int(i)));
+    }
+    EXPECT_EQ(doc.root()["snapshot"]["usageDate"].string(), dayLabel("UTC", now));
+    EXPECT_FALSE(p.needsCoverage());
+    agentspeed::json::Document first;
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        ASSERT_TRUE(first.parse(bodies.at(0)));
+    }
+    EXPECT_TRUE(first.root()["snapshot"]["days"].at(0)["input"].isNull());
+}
+
+// The routine interval still paces ordinary republishing after a covered projection.
+TEST(WidgetPublisher, RoutineCadenceRepublishesCoveredWindows) {
+    std::atomic<std::int64_t> now{start};
+    std::atomic<int> calls{0};
+    collector::WidgetPublisher::Options o;
+    o.clock = [&] { return now.load(); };
+    o.transport = [&](const auto&, const auto&) {
+        ++calls;
+        return collector::WidgetPublisher::Result{200};
+    };
+    collector::WidgetPublisher p(o);
+    EXPECT_TRUE(p.control(subscribe("a", "one", "l1", start + 9000000), 1, now).empty());
+    pump(p, now, scanned("UTC", now));
+    ASSERT_TRUE(eventually([&] { return p.authorized(now); }));
+    ASSERT_EQ(calls.load(), 1);
+    now += 1799000;
+    EXPECT_TRUE(p.views().empty());
+    pump(p, now, scanned("UTC", now));
+    EXPECT_EQ(calls.load(), 1);
+    now += 1000;
+    pump(p, now, scanned("UTC", now));
+    ASSERT_TRUE(eventually([&] { return calls.load() == 2; }));
+}
