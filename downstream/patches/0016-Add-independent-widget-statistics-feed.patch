+            binding(ack(c, 'repeat'), 'repeat')
+            time.sleep(2)
+            require(relay.count('first') == 1, 'idempotent subscribe reset publishing cadence')
+            subscribe(c, 'replace', 'replacement')
+            eventually(lambda: relay.count('replacement') >= 1, 20, 'replacement HTTPS POST missing')
+            check_snapshot(relay.record('replacement'), expected)
+            binding(ack(c, 'replace'), 'replace')
+            require(unsubscribe(c, 'old-unsub', 'first').get('accepted') is False, 'old lease removed replacement')
+            subscribe(c, 'replacement-check', 'replacement')
+            binding(ack(c, 'replacement-check'), 'replacement-check')
+            time.sleep(2)
+            require(relay.count('replacement') == 1, 'replacement resubscribe caused immediate extra POST')
+            subscribe(c, 'bad', 'bad', 'bad-widget')
+            eventually(lambda: relay.count('bad') >= 1, 20, 'bad lease HTTPS POST missing')
+            require(ack(c, 'bad').get('accepted') is False, '401 lease falsely enabled')
+            require(unsubscribe(c, 'correct-unsub', 'replacement').get('accepted') is True, 'correct unsubscribe failed')
+            c.close()
+            clients.remove(c)
+            eventually(lambda: not processes(uid, args.collector), 45, 'daemon did not exit after unsubscribe')
+            result.update({'passed':True, 'capabilities':{'widgetMinPublishIntervalMs':1800000,'widgetMaxLeaseSeconds':2592000}, 'snapshot':snapshot, 'postCounts':{label:relay.count(label) for label in tokens}, 'checks':['ack gated on HTTPS 200','authorized daemon survives SSH disconnect','idempotent resubscribe','replacement and lease-scoped unsubscribe','401 rejected','bounded idle exit']})
