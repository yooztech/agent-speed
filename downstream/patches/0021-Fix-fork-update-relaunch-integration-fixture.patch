From e4bce52a7a15cbda09991f871deff5543b57eef0 Mon Sep 17 00:00:00 2001
From: yooztech <service@yooztech.com>
Date: Thu, 5 Nov 2026 19:39:29 +0800
Subject: [PATCH] Fix fork update relaunch integration fixture

---
 .../UpdateRelaunchIntegration/FixtureConfiguration.swift | 2 +-
 macos/Tests/UpdateRelaunchIntegration/Harness.swift      | 2 +-
 macos/scripts/test-update-relaunch.py                    | 9 +++++----
 3 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/macos/Tests/UpdateRelaunchIntegration/FixtureConfiguration.swift b/macos/Tests/UpdateRelaunchIntegration/FixtureConfiguration.swift
index 4e679e61..38f347f2 100644
--- a/macos/Tests/UpdateRelaunchIntegration/FixtureConfiguration.swift
+++ b/macos/Tests/UpdateRelaunchIntegration/FixtureConfiguration.swift
@@ -19,7 +19,7 @@ struct UpdateConfiguration: Sendable {
         UpdateConfiguration(
             feedURL: URL(string: Bundle.main.object(forInfoDictionaryKey: "ASFeedURL") as! String)!,
             policy: .testing,
-            currentVersion: Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as! String
+            currentVersion: Bundle.main.object(forInfoDictionaryKey: "AgentSpeedVersion") as! String
         )
     }
 }
diff --git a/macos/Tests/UpdateRelaunchIntegration/Harness.swift b/macos/Tests/UpdateRelaunchIntegration/Harness.swift
index a67794a8..b0ad510d 100644
--- a/macos/Tests/UpdateRelaunchIntegration/Harness.swift
+++ b/macos/Tests/UpdateRelaunchIntegration/Harness.swift
@@ -96,7 +96,7 @@ final class Delegate: NSObject, NSApplicationDelegate {
         RunLoop.main.add(progress!, forMode: .common)
         Task { @MainActor in
             await updates.check(manual: true)
-            guard updates.availableRelease?.version.description == "1.1.0" else {
+            guard updates.availableRelease?.version.description == "1.1.0-fork.1" else {
                 self.log.event("no_offer", fields: ["status": String(describing: updates.status)])
                 Darwin.exit(32)
             }
diff --git a/macos/scripts/test-update-relaunch.py b/macos/scripts/test-update-relaunch.py
index bf4702ac..354a73ce 100644
--- a/macos/scripts/test-update-relaunch.py
+++ b/macos/scripts/test-update-relaunch.py
@@ -122,6 +122,7 @@ def run(binary, label, output):
         shutil.copy2(binary, macos / 'UpdateFinishPipeline')
         info = {'CFBundleIdentifier': bundle_id, 'CFBundleExecutable': 'UpdateFinishPipeline', 'CFBundlePackageType': 'APPL',
                 'CFBundleName': 'Agent Speed Update Isolation', 'CFBundleShortVersionString': version, 'CFBundleVersion': version,
+                'AgentSpeedVersion': version + '-fork.1',
                 'LSUIElement': True, 'ASOutputRoot': str(root), 'ASFeedURL': base + '/feed.json', 'ASDefaultsSuite': suite}
         (contents / 'Info.plist').write_bytes(plistlib.dumps(info))
         subprocess.run(['/usr/bin/codesign', '--force', '--sign', '-', str(app)], check=True, capture_output=True)
@@ -130,7 +131,7 @@ def run(binary, label, output):
     digest = hashlib.sha256(archive.read_bytes()).hexdigest()
     sums = www / 'SHA256SUMS.txt'
     sums.write_text(digest + '  AgentSpeed-macOS.zip\n')
-    feed = {'tag_name': 'v1.1.0', 'name': 'Synthetic update 1.1.0', 'body': 'Isolated update completion test.',
+    feed = {'tag_name': 'v1.1.0-fork.1', 'name': 'Synthetic update 1.1.0', 'body': 'Isolated update completion test.',
             'draft': False, 'prerelease': False, 'assets': [
                 {'name': archive.name, 'size': archive.stat().st_size, 'browser_download_url': base + '/' + archive.name},
                 {'name': sums.name, 'size': sums.stat().st_size, 'browser_download_url': base + '/' + sums.name}]}
@@ -180,10 +181,10 @@ def run(binary, label, output):
         assert marker_data['pid'] != proc.pid
         assert marker_data['version'] == '1.1.0'
         assert new_exited, ('new fixture process did not exit', root)
-        assert marker_data['installedBefore'] == '1.1.0'
-        assert marker_data['previousBefore'] == '1.0.0'
+        assert marker_data['installedBefore'] == '1.1.0-fork.1'
+        assert marker_data['previousBefore'] == '1.0.0-fork.1'
         assert marker_data['installedAfter'] == marker_data['previousAfter'] == 'nil'
-        assert marker_data['justUpdatedTo'] == '1.1.0'
+        assert marker_data['justUpdatedTo'] == '1.1.0-fork.1'
         old_names = [e['event'] for e in old_events]
         new_names = [e['event'] for e in new_events]
         assert 'ready_to_relaunch' in old_names and 'leaving_reply' in old_names and 'will_terminate' in old_names
-- 
