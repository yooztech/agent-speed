From 47dfb5fda8a1c63d622fa7ef6378f109d4e02202 Mon Sep 17 00:00:00 2001
From: yooztech <service@yooztech.com>
Date: Thu, 5 Nov 2026 20:00:00 +0800
Subject: [PATCH] Preserve Windows installer startup choice

Inno populates the task list when it enters the tasks page, after
InitializeWizard. Select the inherited default once that list exists, while
respecting explicit command-line task selections and later user changes.

---
 windows/scripts/installer.iss      | 52 ++++++++++++++++++++++++++++++----
 windows/scripts/test-installer.ps1 | 12 ++++++++
 2 files changed, 59 insertions(+), 5 deletions(-)

diff --git a/windows/scripts/installer.iss b/windows/scripts/installer.iss
--- a/windows/scripts/installer.iss
+++ b/windows/scripts/installer.iss
@@ -53,14 +53,56 @@ Name: "{userdesktop}\Agent Speed"; Filename: "{app}\AgentSpeed.exe"; WorkingDir:
 const
   RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
 
-procedure InitializeWizard;
+var
+  StartupDefaultApplied: Boolean;
+
+function StartupSpecifiedOnCommandLine: Boolean;
 var
-  RunValue: String;
+  I, P: Integer;
+  Arg, Tasks, Task: String;
 begin
-  if (RegQueryStringValue(HKCU, RunKey, 'AgentSpeed', RunValue) and (Trim(RunValue) <> '')) or
-     FileExists(ExpandConstant('{userstartup}\Agent Speed.lnk')) then
-    WizardSelectTasks('startup');
+  Result := False;
+  for I := 1 to ParamCount do
+  begin
+    Arg := Lowercase(ParamStr(I));
+    { /TASKS replaces all defaults, including startup. }
+    if Pos('/tasks=', Arg) = 1 then
+    begin
+      Result := True;
+      Exit;
+    end;
+    { /MERGETASKS only overrides the named tasks. }
+    if Pos('/mergetasks=', Arg) = 1 then
+    begin
+      Tasks := Copy(Arg, Length('/mergetasks=') + 1, Length(Arg)) + ',';
+      while Tasks <> '' do
+      begin
+        P := Pos(',', Tasks);
+        Task := Trim(Copy(Tasks, 1, P - 1));
+        Delete(Tasks, 1, P);
+        if (Task = 'startup') or (Task = '*startup') or (Task = '!startup') then
+        begin
+          Result := True;
+          Exit;
+        end;
+      end;
+    end;
+  end;
+end;
+
+procedure CurPageChanged(CurPageID: Integer);
+var
+  RunValue: String;
+begin
+  if (CurPageID = wpSelectTasks) and not StartupDefaultApplied then
+  begin
+    StartupDefaultApplied := True;
+    if not StartupSpecifiedOnCommandLine and
+       ((RegQueryStringValue(HKCU, RunKey, 'AgentSpeed', RunValue) and (Trim(RunValue) <> '')) or
+        FileExists(ExpandConstant('{userstartup}\Agent Speed.lnk'))) then
+      WizardSelectTasks('startup');
+  end;
 end;
 
 procedure CurStepChanged(CurStep: TSetupStep);
diff --git a/windows/scripts/test-installer.ps1 b/windows/scripts/test-installer.ps1
--- a/windows/scripts/test-installer.ps1
+++ b/windows/scripts/test-installer.ps1
@@ -38,6 +38,18 @@ try {
     $process = Start-Process -FilePath $setup -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', "/DIR=`"$installDir`"") -Wait -PassThru
     if ($process.ExitCode -ne 0) { throw "Installer upgrade failed: $($process.ExitCode)" }
     if ((Get-Item $runKey).GetValue('AgentSpeed') -ne $expectedRun) { throw 'Startup choice was not preserved on upgrade' }
+    $process = Start-Process -FilePath $setup -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/MERGETASKS=!startup', "/DIR=`"$installDir`"") -Wait -PassThru
+    if ($process.ExitCode -ne 0) { throw "Installer startup disable failed: $($process.ExitCode)" }
+    if ((Get-Item $runKey).GetValue('AgentSpeed')) { throw 'Explicit startup disable was ignored' }
+    $process = Start-Process -FilePath $setup -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', "/DIR=`"$installDir`"") -Wait -PassThru
+    if ($process.ExitCode -ne 0) { throw "Installer disabled startup upgrade failed: $($process.ExitCode)" }
+    if ((Get-Item $runKey).GetValue('AgentSpeed')) { throw 'Disabled startup choice was not preserved' }
+    $process = Start-Process -FilePath $setup -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/TASKS=startup', "/DIR=`"$installDir`"") -Wait -PassThru
+    if ($process.ExitCode -ne 0) { throw "Installer startup enable failed: $($process.ExitCode)" }
+    if ((Get-Item $runKey).GetValue('AgentSpeed') -ne $expectedRun) { throw 'Explicit startup enable was ignored' }
+    $process = Start-Process -FilePath $setup -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/MERGETASKS=desktopicon', "/DIR=`"$installDir`"") -Wait -PassThru
+    if ($process.ExitCode -ne 0) { throw "Installer merged tasks upgrade failed: $($process.ExitCode)" }
+    if ((Get-Item $runKey).GetValue('AgentSpeed') -ne $expectedRun) { throw 'Unrelated merged task lost startup choice' }
     $asset = "AgentSpeed-Windows-$Architecture.zip"
     $hash = (Get-FileHash (Join-Path $root "dist/$asset") -Algorithm SHA256).Hash.ToLowerInvariant()
     Set-Content -Path (Join-Path $root 'dist/SHA256SUMS.txt') -Value "$hash  $asset" -Encoding ascii
