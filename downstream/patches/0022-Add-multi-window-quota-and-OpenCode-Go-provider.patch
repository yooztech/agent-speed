diff --git a/macos/Sources/AgentSpeed/App/QuotaSourceLogo.swift b/macos/Sources/AgentSpeed/App/QuotaSourceLogo.swift
new file mode 100644
index 00000000..150fe7b9
--- /dev/null
+++ b/macos/Sources/AgentSpeed/App/QuotaSourceLogo.swift
@@ -0,0 +1,36 @@
+import SwiftUI
+
+/// OpenCode mark: official transparent-dark brand SVG from anomalyco/opencode.
+/// OpenAI mark: existing Codenotch outline, retaining its attribution.
+struct QuotaSourceLogo: View {
+    let providerID: String?
+
+    var body: some View {
+        Group {
+            switch providerID {
+            case "codex":
+                QuotaGlyph().fill(.white, style: FillStyle(eoFill: true)).scaleEffect(0.94)
+            case "opencode-go":
+                GeometryReader { proxy in
+                    let width = proxy.size.width * 0.8
+                    let height = proxy.size.height
+                    ZStack(alignment: .topLeading) {
+                        Path { path in
+                            path.addRect(CGRect(x: 0, y: 0, width: width, height: height))
+                            path.addRect(CGRect(x: width * 0.25, y: height * 0.2,
+                                                width: width * 0.5, height: height * 0.6))
+                        }.fill(.white, style: FillStyle(eoFill: true))
+                        Rectangle().fill(.white.opacity(0.28))
+                            .frame(width: width * 0.5, height: height * 0.4)
+                            .offset(x: width * 0.25, y: height * 0.4)
+                    }
+                    .frame(width: width, height: height)
+                    .frame(width: proxy.size.width, height: height)
+                }
+            default:
+                EmptyView()
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}
