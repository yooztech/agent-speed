@@ -0,0 +1,401 @@
+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+using AgentSpeed.Core.IO.Sqlite;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class OpenCodeGoQuotaProviderTests
+{
+    private static readonly DateTimeOffset Time = new(2026, 2, 1, 0, 0, 0, TimeSpan.Zero);
+    private const string Reading = """
+        {"usage":{"rolling":{"status":"ok","percent":12.5,"resetsAt":"2026-02-01T05:00:00.611Z"},
+        "weekly":{"status":"ok","percent":0,"resetsAt":"2026-02-08T00:00:00Z"},
+        "monthly":{"status":"rate-limited","percent":125,"resetsAt":"2026-03-01T00:00:00Z"}}}
+        """;
+
+    [Fact]
+    public void ParserRetainsAllActualWindowsOveruseZeroAndCalendarMonth()
+    {
+        var snapshot = OpenCodeGoQuotaProvider.Parse(Reading, Time);
+        Assert.Equal("opencode-go", snapshot.Id);
+        Assert.Equal("OpenCode Go", snapshot.DisplayName);
+        Assert.Equal("Go", snapshot.Plan);
+        Assert.Null(snapshot.HeadlineId);
+        Assert.Equal(3, snapshot.Windows.Count);
+        var rolling = Assert.Single(snapshot.Windows, window => window.Id == "go:rolling");
+        Assert.Equal(.125, rolling.UsedFraction);
+        Assert.Equal(.875, rolling.Remaining);
+        Assert.Equal(TimeSpan.FromHours(5), rolling.Duration);
+        Assert.Equal(Time.AddHours(5).AddMilliseconds(611), rolling.ResetAt);
+        Assert.Equal(0, Assert.Single(snapshot.Windows, window => window.Id == "go:weekly").UsedFraction);
+        var monthly = Assert.Single(snapshot.Windows, window => window.Id == "go:monthly");
+        Assert.Equal(1.25, monthly.UsedFraction);
+        Assert.Equal(-.25, monthly.Remaining);
+        Assert.Equal(TimeSpan.FromDays(28), monthly.Duration);
+        Assert.Equal("rate-limited", snapshot.Block);
+    }
+
+    [Fact]
+    public void ParserPreservesPartialSiblingsUnknownValuesAndExtraScope()
+    {
+        var snapshot = OpenCodeGoQuotaProvider.Parse("""
+            {"usage":{"rolling":{"percent":3,"resetsAt":"bad-date"},"weekly":{"status":"ok","percent":null},
+            "monthly":null,"new-scope":{"percent":25,"resetsAt":"2026-03-01T00:00:00+00:00"},"invalid":false}}
+            """, Time);
+        Assert.Equal(3, snapshot.Windows.Count);
+        var rolling = Assert.Single(snapshot.Windows, window => window.Id == "go:rolling");
+        Assert.Equal(.03, rolling.UsedFraction); Assert.Null(rolling.ResetAt);
+        var unknown = Assert.Single(snapshot.Windows, window => window.Id == "go:weekly");
+        Assert.Null(unknown.UsedFraction); Assert.Null(unknown.Remaining);
+        var extra = Assert.Single(snapshot.Windows, window => window.Id == "go:new-scope");
+        Assert.Null(extra.Duration); Assert.Equal("new-scope", extra.Label); Assert.Equal(.25, extra.UsedFraction);
+    }
+
+    [Theory]
+    [InlineData("{}")]
+    [InlineData("{\"usage\":[]}")]
+    [InlineData("{\"usage\":{\"rolling\":{\"percent\":null}}}")]
+    [InlineData("{\"usage\":{\"rolling\":{\"percent\":\"12\"}}}")]
+    public void UnreadableUsageIsUnavailableNeverZero(string json) =>
+        Assert.Throws<JsonException>(() => OpenCodeGoQuotaProvider.Parse(json, Time));
+
+    [Theory]
+    [InlineData("2026-03-31T00:00:00Z", 31)]
+    [InlineData("2028-03-01T00:00:00Z", 29)]
+    [InlineData("2026-04-30T00:00:00Z", 31)]
+    public void MonthlyDurationUsesActualGregorianPeriodEndingAtReset(string reset, int days)
+    {
+        var snapshot = OpenCodeGoQuotaProvider.Parse($$$$"""{"usage":{"monthly":{"percent":1,"resetsAt":"{{{{reset}}}}"}}}""", Time);
+        Assert.Equal(TimeSpan.FromDays(days), Assert.Single(snapshot.Windows).Duration);
+    }
+
+    [Fact]
+    public async Task ApiKeyUsesRealReadOnlyRouteAndPersistsSecretFreeAccountIsolatedCache()
+    {
+        using var fixture = new Fixture();
+        using (var provider = fixture.Provider())
+        {
+            Assert.Equal(QuotaStatus.Error, provider.ReadCachedSnapshot().Status);
+            Assert.Equal(0, fixture.Handler.Calls);
+            var result = await provider.RefreshAsync();
+            Assert.Equal(QuotaStatus.Ok, result.Status);
+            Assert.Equal(1, fixture.Handler.Calls);
+            Assert.Equal("/zen/go/v1/usage", fixture.Handler.Paths.Single());
+            Assert.Equal("Bearer", fixture.Handler.AuthorizationScheme);
+            Assert.Equal("synthetic-go-key", fixture.Handler.Token);
+            Assert.Null(fixture.Handler.Organization);
+            Assert.Null(result.NextAllowedAt);
+            await provider.RefreshAsync(); Assert.Equal(2, fixture.Handler.Calls);
+        }
+        var file = Assert.Single(Directory.GetFiles(fixture.Schedule));
+        var cache = File.ReadAllText(file);
+        Assert.DoesNotContain("synthetic-go-key", cache);
+        Assert.DoesNotContain("auth.json", cache);
+        using (var restarted = fixture.Provider())
+        {
+            var cached = restarted.ReadCachedSnapshot();
+            Assert.Equal(QuotaStatus.Stale, cached.Status);
+            Assert.Equal(Time, cached.ObservedAt);
+            Assert.Equal(3, cached.Windows.Count);
+            Assert.Equal(2, fixture.Handler.Calls);
+            Assert.Null(cached.NextAllowedAt);
+            await restarted.RefreshAsync(); Assert.Equal(3, fixture.Handler.Calls);
+            await restarted.RefreshStartupAsync(); Assert.Equal(4, fixture.Handler.Calls);
+            await restarted.RefreshStartupAsync(); Assert.Equal(5, fixture.Handler.Calls);
+            fixture.ApiKey("different-synthetic-key");
+            Assert.Empty(restarted.ReadCachedSnapshot().Windows);
+            await restarted.RefreshAsync(); Assert.Equal(6, fixture.Handler.Calls);
+        }
+    }
+
+    [Fact]
+    public async Task DatabaseCredentialWinsRetiredFileAndReadsActiveRowMetadataWithoutWriting()
+    {
+        using var fixture = new Fixture();
+        fixture.Database();
+        fixture.Row("older", "opencode", """{"type":"key","key":"old-database-key","metadata":{"orgID":"old-org"}}""", true, 1);
