--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/Quota.swift
@@ -0,0 +1,122 @@
+import Foundation
+
+public enum QuotaStatus: String, Sendable, Codable {
+    case ok, stale, needsAuth, accessDenied, unsupported, error
+}
+
+public struct QuotaWindow: Sendable, Equatable, Codable {
+    public let id: String
+    public let label: String
+    public let usedFraction: Double?
+    public let remaining: Double?
+    public let used: Double?
+    public let resetAt: Date?
+    public let duration: TimeInterval?
+
+    public init(id: String, label: String, usedFraction: Double?, remaining: Double?, used: Double?,
+                resetAt: Date?, duration: TimeInterval?) {
+        self.id = id
+        self.label = label
+        self.usedFraction = usedFraction
+        self.remaining = remaining
+        self.used = used
+        self.resetAt = resetAt
+        self.duration = duration
+    }
+}
+
+public struct QuotaCredits: Sendable, Equatable, Codable {
+    public let hasCredits: Bool?
+    public let unlimited: Bool?
+    public let limit: Double?
+    public let used: Double?
+    public let usedFraction: Double?
+    public let resetAt: Date?
+    public let balance: String?
+}
+
+public struct QuotaSnapshot: Sendable, Equatable, Codable {
+    public let id: String
+    public let displayName: String
+    public let fidelity: String
+    public let status: QuotaStatus
+    public let windows: [QuotaWindow]
+    public let headlineId: String?
+    public let block: String?
+    public let account: String?
+    public let plan: String?
+    public let observedAt: Date?
+    public let source: String
+    public let credits: QuotaCredits?
+    public let nextAllowedAt: Date?
+    /// No observation is available because a previously successful poll is still throttled.
+    public let waitingForRefresh: Bool
+
+    public init(id: String, displayName: String, fidelity: String, status: QuotaStatus,
+                windows: [QuotaWindow], headlineId: String?, block: String?, account: String?,
+                plan: String?, observedAt: Date?, source: String, credits: QuotaCredits?,
+                nextAllowedAt: Date?, waitingForRefresh: Bool) {
+        self.id = id
+        self.displayName = displayName
+        self.fidelity = fidelity
+        self.status = status
+        self.windows = windows
+        self.headlineId = headlineId
+        self.block = block
+        self.account = account
+        self.plan = plan
+        self.observedAt = observedAt
+        self.source = source
+        self.credits = credits
+        self.nextAllowedAt = nextAllowedAt
+        self.waitingForRefresh = waitingForRefresh
+    }
+}
+
+/// Providers own credentials, account isolation and persisted polling schedules.
+public protocol QuotaProvider: Sendable {
+    func refresh() async -> QuotaSnapshot
+    func cancel() async
+}
+
+public enum QuotaPeriod: String, Sendable {
+    case month, week, fiveHours, other
+}
+
+extension QuotaWindow {
+    public var period: QuotaPeriod {
+        if id == "monthly" { return .month }
+        if id == "weekly" { return .week }
+        if id == "rolling" { return .fiveHours }
+        guard let duration, duration.isFinite, duration > 0 else { return .other }
+        if duration == 18_000 { return .fiveHours }
+        if duration == 604_800 { return .week }
+        if duration >= 2_419_200 && duration <= 2_678_400 { return .month }
+        return .other
+    }
+
+    /// Exact readings remain unclamped, including negative remaining after overuse.
+    public var remainingFraction: Double? {
+        if let usedFraction, usedFraction.isFinite { return 1 - usedFraction }
+        return nil
+    }
+
+    public static func ordered(_ windows: [QuotaWindow]) -> [QuotaWindow] {
+        windows.enumerated().sorted { lhs, rhs in
+            let a = lhs.element.duration.flatMap { $0.isFinite && $0 > 0 ? $0 : nil }
+            let b = rhs.element.duration.flatMap { $0.isFinite && $0 > 0 ? $0 : nil }
+            if a != b {
+                if let a, let b { return a > b }
+                return a != nil
+            }
+            if lhs.element.id != rhs.element.id { return lhs.element.id < rhs.element.id }
+            return lhs.offset < rhs.offset
+        }.map(\.element)
+    }
+}
+
+public enum QuotaProviderRegistry {
+    public static func makeProviders() -> [any QuotaProvider] {
+        [CodexQuotaProvider(), OpenCodeGoQuotaProvider()]
+    }
+}
