+            database.Execute("CREATE TABLE credential(id TEXT PRIMARY KEY,integration_id TEXT,value TEXT,active INTEGER,time_created INTEGER,time_updated INTEGER)");
+        }
+        public void Row(string id, string integration, string value, bool active, int created)
+        {
+            using var database = SqliteConnection.Open(DatabaseFile, SqliteOpenMode.ReadWriteCreate);
+            using var insert = database.Prepare("INSERT INTO credential VALUES(?,?,?,?,?,?)");
+            insert.Bind(1, id).Bind(2, integration).Bind(3, value).Bind(4, active ? 1L : 0L).Bind(5, created).Bind(6, created).Run();
+        }
