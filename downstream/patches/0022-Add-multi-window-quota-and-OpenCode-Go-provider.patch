+    private sealed class Handler(bool go) : HttpMessageHandler
+    {
+        private int usageCalls, cancellations;
+        public int UsageCalls => Volatile.Read(ref usageCalls);
+        public int Cancellations => Volatile.Read(ref cancellations);
+        public TaskCompletionSource? Block;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var usage = request.RequestUri!.AbsolutePath.EndsWith("/usage", StringComparison.Ordinal);
+            if (usage) Interlocked.Increment(ref usageCalls);
+            try { if (usage && Block is { } block) await block.Task.WaitAsync(cancellationToken); }
+            catch (OperationCanceledException) { Interlocked.Increment(ref cancellations); throw; }
+            return new(HttpStatusCode.OK) { Content = new StringContent(!usage ? "{\"available_count\":0}" : go ? """
+                {"usage":{"rolling":{"status":"ok","percent":0,"resetsAt":"2026-02-01T05:00:00Z"},
+                "weekly":{"status":"ok","percent":30,"resetsAt":"2026-02-08T00:00:00Z"},
+                "monthly":{"status":"rate-limited","percent":125,"resetsAt":"2026-03-01T00:00:00Z"}}}
+                """ : """{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":95,"limit_window_seconds":604800}}}""") };
+        }
+    }
