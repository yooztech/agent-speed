+import Foundation
+import Testing
+import CSQLite
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+@testable import AgentSpeedCore
+
+private final class GoFixture: @unchecked Sendable {
+    private let lock = NSLock()
+    private var time = Date(timeIntervalSince1970: 1_800_000_000)
+    private var requests: [URLRequest] = []
+    private var statuses: [Int]
+    let body: Data
+    let retryAfter: String?
+
+    init(_ statuses: [Int] = [200], body: Data = Data(#"{"usage":{"rolling":{"status":"ok","percent":16,"resetsAt":"2027-03-01T12:00:00.611Z"},"weekly":{"status":"ok","percent":64,"resetsAt":"2027-03-01T12:00:00Z"},"monthly":{"status":"ok","percent":38,"resetsAt":"2027-03-01T12:00:00Z"}}}"#.utf8), retryAfter: String? = nil) {
+        self.statuses = statuses
+        self.body = body
+        self.retryAfter = retryAfter
+    }
+    func now() -> Date { lock.withLock { time } }
+    func advance(_ seconds: TimeInterval) { lock.withLock { time = time.addingTimeInterval(seconds) } }
+    func captured() -> [URLRequest] { lock.withLock { requests } }
+    func fetch(_ request: URLRequest) -> (Data, HTTPURLResponse) {
+        lock.withLock {
+            requests.append(request)
+            let status = statuses.isEmpty ? 200 : statuses.removeFirst()
+            return (body, HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil,
+                                          headerFields: (status == 429 || status == 503) ? retryAfter.map { ["Retry-After": $0] } : nil)!)
+        }
+    }
+}
+
+@Suite("OpenCode Go quota")
+struct OpenCodeGoQuotaProviderTests {
+    private func temporaryDirectory() throws -> URL {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        return url
+    }
+    private func writeAuth(_ directory: URL, token: String = "fixture-key", oauth: Bool = false) throws {
+        let entry: [String: Any] = oauth
+            ? ["type": "oauth", "access": token, "expires": 9_999_999_999_000,
+               "metadata": ["orgID": "fixture-org", "server": "https://opencode.ai/console"]]
+            : ["type": "api", "key": token]
+        let value = [oauth ? "opencode" : "opencode-go": entry]
+        try JSONSerialization.data(withJSONObject: value).write(to: directory.appendingPathComponent("auth.json"))
+    }
+    private func provider(_ directory: URL, suite: String, fixture: GoFixture) -> OpenCodeGoQuotaProvider {
+        OpenCodeGoQuotaProvider(directory: directory, defaults: UserDefaults(suiteName: suite)!,
+                                now: { fixture.now() }, transport: { fixture.fetch($0) })
+    }
+
+    @Test func parsesEveryWindowAndRealCalendarMonth() throws {
+        let fixture = GoFixture()
+        let value = try OpenCodeGoQuotaProvider.parse(fixture.body, at: fixture.now())
+        #expect(value.id == "opencode-go")
+        #expect(value.displayName == "OpenCode Go")
+        #expect(value.windows.map(\.id) == ["monthly", "weekly", "rolling"])
+        let durations: [TimeInterval?] = [28.0 * 86_400, 604_800, 18_000]
+        #expect(value.windows.map(\.duration) == durations)
+        #expect(value.windows[0].remainingFraction == 0.62)
+        #expect(value.windows[0].period == .month)
+        #expect(value.windows.allSatisfy { $0.resetAt != nil })
+    }
+
+    @Test func partialUnknownAndOveruseNeverBecomeZeroOrDiscardValidSiblings() throws {
+        let data = Data(#"{"usage":{"rolling":{"status":"rate-limited","percent":124},"weekly":{"status":"ok","percent":true},"monthly":{"status":"ok","percent":37,"resetsAt":"bad"}}}"#.utf8)
+        let value = try OpenCodeGoQuotaProvider.parse(data, at: Date())
+        #expect(value.windows.count == 3)
+        #expect(value.windows.first { $0.id == "rolling" }?.remainingFraction.map { abs($0 + 0.24) < 0.000_001 } == true)
+        #expect(value.windows.first { $0.id == "weekly" }?.remainingFraction == nil)
+        #expect(value.windows.first { $0.id == "monthly" }?.duration == nil)
+        #expect(value.windows.first { $0.id == "monthly" }?.period == .month)
+        #expect(value.block != nil)
+        #expect(throws: (any Error).self) { try OpenCodeGoQuotaProvider.parse(Data(#"{"usage":{}}"#.utf8), at: Date()) }
+    }
+
+    @Test func legacyKeyUsesOfficialEndpointAndNeverInventsOrganization() async throws {
+        let directory = try temporaryDirectory(), suite = UUID().uuidString
+        defer { try? FileManager.default.removeItem(at: directory); UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite) }
+        try writeAuth(directory)
+        let fixture = GoFixture()
+        let value = await provider(directory, suite: suite, fixture: fixture).refresh()
+        #expect(value.status == .ok)
+        let request = try #require(fixture.captured().first)
+        #expect(request.url?.absoluteString == "https://opencode.ai/zen/go/v1/usage")
+        #expect(request.value(forHTTPHeaderField: "Authorization") == "Bearer fixture-key")
+        #expect(request.value(forHTTPHeaderField: "x-opencode-org-id") == nil)
+        let persisted = UserDefaults(suiteName: suite)!.dictionaryRepresentation().description
+        #expect(!persisted.contains("fixture-key"))
+        #expect(!persisted.contains("resetsAt"))
+    }
+
+    @Test func oauthReferenceRouteAndConsoleProbeDistinguishMissingPlan() async throws {
+        let directory = try temporaryDirectory(), suite = UUID().uuidString
+        defer { try? FileManager.default.removeItem(at: directory); UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite) }
+        try writeAuth(directory, oauth: true)
+        let fixture = GoFixture([401, 200])
+        let value = await provider(directory, suite: suite, fixture: fixture).refresh()
+        #expect(value.status == .unsupported)
+        #expect(fixture.captured().map { $0.url!.path } == ["/inference/go/v1/usage", "/console/api/user"])
+        #expect(fixture.captured().allSatisfy { $0.value(forHTTPHeaderField: "x-opencode-org-id") == "fixture-org" })
+        #expect(await provider(directory, suite: suite, fixture: fixture).refresh().status == .unsupported)
+        #expect(fixture.captured().count == 2)
+    }
+
+    @Test func transientOAuthProbePreservesStaleObservationWithoutAuthBan() async throws {
+        let directory = try temporaryDirectory(), suite = UUID().uuidString
+        defer { try? FileManager.default.removeItem(at: directory); UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite) }
+        try writeAuth(directory, oauth: true)
+        let fixture = GoFixture([200, 401, 503, 200])
+        let reader = provider(directory, suite: suite, fixture: fixture)
+        let original = await reader.refresh()
+        fixture.advance(300)
+        let stale = await reader.refresh()
+        #expect(stale.status == .stale)
+        #expect(stale.windows == original.windows)
+        #expect(await reader.refresh().status == .stale)
+        #expect(fixture.captured().count == 3)
+        fixture.advance(60)
+        #expect(await reader.refresh().status == .ok)
+    }
+
+    @Test func rateLimitPersistsAcrossRestartAndRotatedAccountCannotSeePriorCache() async throws {
+        let directory = try temporaryDirectory(), suite = UUID().uuidString
+        defer { try? FileManager.default.removeItem(at: directory); UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite) }
+        try writeAuth(directory)
+        let fixture = GoFixture([200, 429, 401])
+        let reader = provider(directory, suite: suite, fixture: fixture)
+        #expect(await reader.refresh().status == .ok)
+        fixture.advance(300)
+        #expect(await reader.refresh().status == .stale)
+        let restarted = await provider(directory, suite: suite, fixture: fixture).refresh()
+        #expect(!restarted.windows.isEmpty)
+        #expect(restarted.status == .stale)
+        #expect(restarted.observedAt == fixture.now().addingTimeInterval(-300))
+        #expect(!restarted.waitingForRefresh)
+        #expect(fixture.captured().count == 2)
+        try writeAuth(directory, token: "different-account")
+        let rotated = await reader.refresh()
+        #expect(rotated.status == .needsAuth)
+        #expect(rotated.windows.isEmpty)
+        #expect(fixture.captured().count == 3)
+        #expect(await provider(directory, suite: suite, fixture: fixture).refresh().status == .needsAuth)
+        #expect(fixture.captured().count == 3)
