+namespace AgentSpeed.Core;
+
+/// <summary>A read-only local credential reader with account-isolated persistent observations and request pacing.</summary>
+public interface IQuotaProvider : IDisposable
+{
+    QuotaSnapshot ReadCachedSnapshot();
+    Task<QuotaSnapshot> RefreshAsync();
+    Task<QuotaSnapshot> RefreshStartupAsync();
