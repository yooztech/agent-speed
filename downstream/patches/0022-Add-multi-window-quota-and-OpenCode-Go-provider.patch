diff --git a/macos/Sources/AgentSpeedCore/OpenCodeGoCredentials.swift b/macos/Sources/AgentSpeedCore/OpenCodeGoCredentials.swift
new file mode 100644
index 0000000000000000000000000000000000000000..31948d641906f2be7c9cba42ac4899ec3ecc3a92
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/OpenCodeGoCredentials.swift
@@ -0,0 +1,98 @@
+import Foundation
+import CSQLite
+
+// Adapted from Codenotch OpenCodeCredentials, 835550a342871779135b6484d6899161c5222f7c.
+// Copyright (c) 2026 Vinz, MIT. See Resources/Codenotch-LICENSE.txt.
+struct OpenCodeGoCredentials: Sendable {
+    let token: String
+    let oauth: Bool
+    let org: String?
+    let expires: Date?
+    let console: URL
+
+    static var dataDirectory: URL {
+        let environment = ProcessInfo.processInfo.environment
+        let root = environment["XDG_DATA_HOME"].flatMap(nonEmpty)
+            .map { URL(fileURLWithPath: $0, isDirectory: true) }
+            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/share", isDirectory: true)
+        return root.appendingPathComponent("opencode", isDirectory: true)
+    }
+
+    static var databaseURL: URL {
+        guard let override = ProcessInfo.processInfo.environment["OPENCODE_DB"].flatMap(nonEmpty), override != ":memory:" else {
+            return dataDirectory.appendingPathComponent("opencode.db")
+        }
+        return override.hasPrefix("/") ? URL(fileURLWithPath: override) : dataDirectory.appendingPathComponent(override)
+    }
+
+    static func load(directory: URL, databaseURL: URL) -> Self? {
+        let database = loadDatabase(databaseURL)
+        // A database row is authoritative even if it is expired, unsupported or malformed.
+        // Never resurrect the retired auth.json key after OpenCode rotated it.
+        if database.found { return database.credential }
+        guard let data = try? Data(contentsOf: directory.appendingPathComponent("auth.json")),
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return nil }
+        if let entry = root["opencode-go"] { return decode(entry) }
+        guard let entry = root["opencode"] as? [String: Any], entry["type"] as? String == "oauth" else { return nil }
+        return decode(entry)
+    }
+
+    private static func loadDatabase(_ url: URL) -> (found: Bool, credential: Self?) {
+        var database: OpaquePointer?
+        guard sqlite3_open_v2(url.path, &database, SQLITE_OPEN_READONLY | SQLITE_OPEN_NOMUTEX, nil) == SQLITE_OK else {
+            if let database { sqlite3_close(database) }
+            return (false, nil)
+        }
+        defer { sqlite3_close(database) }
+        var statement: OpaquePointer?
+        // Preserve the pinned reference: Go key first, active/null rows, newest update.
+        let sql = """
+        SELECT value FROM credential
+        WHERE integration_id IN ('opencode-go', 'opencode') AND COALESCE(active, 1) != 0
+        ORDER BY CASE integration_id WHEN 'opencode-go' THEN 0 ELSE 1 END,
+                 time_updated DESC LIMIT 1
+        """
+        guard sqlite3_prepare_v2(database, sql, -1, &statement, nil) == SQLITE_OK else { return (false, nil) }
+        defer { sqlite3_finalize(statement) }
+        guard sqlite3_step(statement) == SQLITE_ROW else {
+            // An inactive sign-in must not resurrect a retired legacy file either.
+            var existing: OpaquePointer?
+            let sql = "SELECT 1 FROM credential WHERE integration_id IN ('opencode-go', 'opencode') LIMIT 1"
+            guard sqlite3_prepare_v2(database, sql, -1, &existing, nil) == SQLITE_OK else { return (false, nil) }
+            defer { sqlite3_finalize(existing) }
+            return (sqlite3_step(existing) == SQLITE_ROW, nil)
+        }
+        guard let value = sqlite3_column_text(statement, 0),
+              let object = try? JSONSerialization.jsonObject(with: Data(String(cString: value).utf8)) else { return (true, nil) }
+        return (true, decode(object))
+    }
+
+    static func decode(_ entry: Any) -> Self? {
+        if let key = nonEmpty(entry as? String) {
+            return Self(token: key, oauth: false, org: nil, expires: nil, console: defaultConsole)
+        }
+        guard let value = entry as? [String: Any], let type = value["type"] as? String,
+              ["api", "key", "oauth"].contains(type) else { return nil }
+        let oauth = type == "oauth"
+        guard let token = nonEmpty(value[oauth ? "access" : "key"] as? String) else { return nil }
+        var metadata = value["metadata"] as? [String: Any] ?? [:]
+        // OpenCode's released pre-v2.1 decoder merges configuration over metadata.
+        if let configuration = value["configuration"] as? [String: Any] { metadata.merge(configuration) { _, new in new } }
+        let milliseconds = (value["expires"] as? NSNumber)?.doubleValue ?? (value["expires"] as? String).flatMap(Double.init)
+        let expires = milliseconds.flatMap { $0.isFinite && $0 > 0 ? Date(timeIntervalSince1970: $0 / 1_000) : nil }
+        let console: URL
+        if let server = nonEmpty(metadata["server"] as? String) {
+            guard let url = URL(string: server), url.scheme == "https", url.host == "opencode.ai",
+                  url.user == nil, url.password == nil, url.port == nil, url.query == nil, url.fragment == nil else { return nil }
+            console = url
+        } else { console = defaultConsole }
+        return Self(token: token, oauth: oauth, org: nonEmpty(metadata["orgID"] as? String), expires: expires, console: console)
+    }
+
+    private static let defaultConsole = URL(string: "https://opencode.ai/console")!
+    private static func nonEmpty(_ value: String?) -> String? {
+        guard let value, !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              !value.contains("\r"), !value.contains("\n") else { return nil }
+        return value
+    }
+}
diff --git a/macos/Sources/AgentSpeedCore/OpenCodeGoQuotaProvider.swift b/macos/Sources/AgentSpeedCore/OpenCodeGoQuotaProvider.swift
new file mode 100644
index 0000000000000000000000000000000000000000..257d644ad737fd79317f2ef3f76ac4cff86eb36b
--- /dev/null
+++ b/macos/Sources/AgentSpeedCore/OpenCodeGoQuotaProvider.swift
@@ -0,0 +1,290 @@
+import Foundation
+import CoreFoundation
+#if canImport(CryptoKit)
+import CryptoKit
+#else
+import Crypto
+#endif
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+// Adapted from Codenotch OpenCodeProvider/OpenCodeUsage at
+// 835550a342871779135b6484d6899161c5222f7c, Copyright (c) 2026 Vinz, MIT.
+// See Resources/Codenotch-LICENSE.txt. Credentials are borrowed, never written.
+public actor OpenCodeGoQuotaProvider: QuotaProvider {
+    public nonisolated let id = "opencode-go"
+    typealias Transport = @Sendable (URLRequest) async throws -> (Data, HTTPURLResponse)
+    private struct Schedule: Codable {
+        var next: Date?
+        var failures = 0
+        var coldFailures: Int?
+        var rejected = false
+        var status: QuotaStatus?
+        var observation: QuotaPersistedObservation?
+    }
+    private let directory: URL
+    private let databaseURL: URL
+    private let defaults: UserDefaults
+    private let now: @Sendable () -> Date
+    private let transport: Transport
+    private var inFlight: Task<QuotaSnapshot, Never>?
+    private var cached: [String: QuotaSnapshot] = [:]
+    private var schedules: [String: Schedule] = [:]
+    private let persistence: QuotaPersistence
+    private var generation = 0
+
+    public init() {
+        directory = OpenCodeGoCredentials.dataDirectory
+        databaseURL = OpenCodeGoCredentials.databaseURL
+        defaults = .standard
+        now = { Date() }
+        persistence = QuotaPersistence(directory: QuotaPersistence.directory.appendingPathComponent("opencode-go"))
+        transport = Self.request
+    }
+
+    init(directory: URL, databaseURL: URL? = nil, defaults: UserDefaults,
+         now: @escaping @Sendable () -> Date, cacheDirectory: URL? = nil, transport: @escaping Transport) {
+        self.directory = directory
+        self.databaseURL = databaseURL ?? directory.appendingPathComponent("opencode.db")
+        self.defaults = defaults
+        self.now = now
+        self.transport = transport
+        persistence = QuotaPersistence(directory: cacheDirectory ?? directory.appendingPathComponent(".quota-cache"))
+    }
+
+    public func readCachedSnapshot() -> QuotaSnapshot {
+        guard let credential = OpenCodeGoCredentials.load(directory: directory, databaseURL: databaseURL) else { return snapshot(.needsAuth) }
+        let account = accountKey(credential)
+        let schedule = load(account)
+        if schedule.rejected { return snapshot(.needsAuth) }
+        if schedule.status == .unsupported { return snapshot(.unsupported, next: schedule.next) }
+        return stale(account, next: schedule.next, otherwise: schedule.status ?? .error)
+    }
+
+    public func refreshStartup() async -> QuotaSnapshot { await refresh() }
+
+    public func refresh() async -> QuotaSnapshot {
+        if let inFlight { return await inFlight.value }
+        let current = generation
+        let task = Task { await self.performRefresh() }
+        inFlight = task
+        let result = await task.value
+        if current == generation { inFlight = nil }
+        return result
+    }
+
+    public func cancel() {
+        generation += 1
+        inFlight?.cancel()
+        inFlight = nil
+    }
+
+    private func accountKey(_ credential: OpenCodeGoCredentials) -> String {
+        let identity = [directory.standardizedFileURL.path, databaseURL.standardizedFileURL.path, credential.token, credential.org ?? "", credential.oauth ? "oauth" : "key", credential.console.absoluteString].joined(separator: "\u{0}")
+        return SHA256.hash(data: Data(identity.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private func isCurrent(_ credential: OpenCodeGoCredentials) -> Bool {
+        guard !Task.isCancelled, let current = OpenCodeGoCredentials.load(directory: directory, databaseURL: databaseURL) else { return false }
+        return accountKey(current) == accountKey(credential) && current.expires == credential.expires
+    }
+
+    private func load(_ account: String) -> Schedule {
+        let schedule = schedules[account] ?? persistence.load(Schedule.self, key: account)
+            ?? defaults.data(forKey: "opencode-go.quota.schedule." + account).flatMap { try? JSONDecoder().decode(Schedule.self, from: $0) }
+            ?? Schedule()
+        schedules[account] = schedule
+        if cached[account] == nil, let value = schedule.observation?.validated(accountKey: account, id: id, source: "go/v1/usage") {
+            cached[account] = value.copying(status: .stale, next: schedule.next)
+        }
+        return schedule
+    }
+
+    private func performRefresh() async -> QuotaSnapshot {
+        guard !Task.isCancelled else { return readCachedSnapshot() }
+        guard let credential = OpenCodeGoCredentials.load(directory: directory, databaseURL: databaseURL) else { return snapshot(.needsAuth) }
+        let account = accountKey(credential)
+        var schedule = load(account)
+        if schedule.rejected { return snapshot(.needsAuth) }
+        if let next = schedule.next, now() < next {
+            if schedule.status == .unsupported { return snapshot(.unsupported, next: next) }
+            return cached[account] ?? snapshot(schedule.status ?? .error, next: next)
+        }
+        // Keep credential-specific reference routes; never retry a borrowed token on another usage route.
+        let endpoint = credential.oauth ? "https://opencode.ai/inference/go/v1/usage" : "https://opencode.ai/zen/go/v1/usage"
+        let request = Self.authorizedRequest(URL(string: endpoint)!, credential: credential)
+        var retry: TimeInterval?
+        let allowCold = credential.expires.map { $0 > now() } ?? true
+        do {
+            let (data, response) = try await transport(request)
+            guard isCurrent(credential) else { return readCachedSnapshot() }
+            let completed = now()
+            retry = Self.retryAfter(response.value(forHTTPHeaderField: "Retry-After"), now: completed)
+            switch response.statusCode {
+            case 200...299:
+                let result = try Self.parse(data, at: completed)
+                // Go has no successful manual-read floor; the app owns its 300s automatic cadence.
+                schedule = Schedule(observation: QuotaPersistedObservation(accountKey: account, snapshot: result))
+                save(schedule, key: account)
+                cached[account] = result
+                return result
+            case 401:
+                if credential.oauth {
+                    let probe = Self.authorizedRequest(credential.console.appendingPathComponent("api/user"), credential: credential)
+                    do {
+                        let (_, answer) = try await transport(probe)
+                        guard isCurrent(credential) else { return readCachedSnapshot() }
+                        if answer.statusCode == 200 {
+                            schedule = Schedule(next: now().addingTimeInterval(300), status: .unsupported)
+                            save(schedule, key: account)
+                            let result = snapshot(.unsupported, next: schedule.next)
+                            cached[account] = result
+                            return result
+                        }
+                        guard answer.statusCode == 401 || answer.statusCode == 403 else {
+                            return failure(account, schedule: &schedule, key: account,
+                                           retryAfter: max(retry ?? 0, Self.retryAfter(answer.value(forHTTPHeaderField: "Retry-After"), now: now()) ?? 0),
+                                           rateLimited: answer.statusCode == 429, allowCold: allowCold)
+                        }
+                    } catch {
+                        guard isCurrent(credential) else { return readCachedSnapshot() }
+                        return failure(account, schedule: &schedule, key: account, retryAfter: retry, allowCold: allowCold)
+                    }
+                }
+                // An expired token may be renewed by OpenCode without changing its local timestamp.
+                if let expires = credential.expires, expires <= now() {
+                    return failure(account, schedule: &schedule, key: account, retryAfter: retry, otherwise: .needsAuth)
+                }
+                schedule.rejected = true
+                schedule.next = nil
+                schedule.observation = nil
+                save(schedule, key: account)
+                cached.removeValue(forKey: account)
+                return snapshot(.needsAuth)
+            case 403:
+                schedule = Schedule(next: completed.addingTimeInterval(300), status: .unsupported)
+                save(schedule, key: account)
+                let result = snapshot(.unsupported, next: schedule.next)
+                cached[account] = result
+                return result
+            case 429:
+                return failure(account, schedule: &schedule, key: account, retryAfter: retry, rateLimited: true, allowCold: allowCold)
+            default:
+                return failure(account, schedule: &schedule, key: account, retryAfter: retry, allowCold: allowCold)
+            }
+        } catch {
+            guard isCurrent(credential) else { return readCachedSnapshot() }
+            return failure(account, schedule: &schedule, key: account, retryAfter: retry, allowCold: allowCold)
+        }
+    }
+
+    private func failure(_ account: String, schedule: inout Schedule, key: String,
+                         retryAfter: TimeInterval? = nil, rateLimited: Bool = false, allowCold: Bool = true,
+                         otherwise: QuotaStatus = .error) -> QuotaSnapshot {
+        let cold = schedule.observation?.validated(accountKey: account, id: id, source: "go/v1/usage") == nil
+        let wait: TimeInterval
+        if cold && allowCold && !rateLimited && otherwise == .error {
+            let attempt = min((schedule.coldFailures ?? 0) + 1, 4)
+            schedule.coldFailures = attempt
+            wait = max(min(30, 5 * pow(2, Double(attempt - 1))), retryAfter ?? 0)
+        } else {
+            wait = Self.backoff(attempt: schedule.failures, retryAfter: retryAfter)
+        }
+        schedule.failures = min(schedule.failures + 1, 5)
+        schedule.next = now().addingTimeInterval(wait)
+        schedule.status = .error
+        save(schedule, key: key)
+        let result = stale(account, next: schedule.next, otherwise: otherwise)
+        cached[account] = result
+        return result
+    }
+
+    static func retryAfter(_ value: String?, now: Date) -> TimeInterval? {
+        guard let value else { return nil }
+        let header = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        if let seconds = Double(header), seconds.isFinite { return max(0, seconds) }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(secondsFromGMT: 0)
+        formatter.dateFormat = "EEE, dd MMM yyyy HH:mm:ss zzz"
+        return formatter.date(from: header).map { max(0, $0.timeIntervalSince(now)) }
+    }
+
+    static func backoff(attempt: Int, retryAfter: TimeInterval?) -> TimeInterval {
+        max(min(900, 60 * pow(2, Double(min(max(0, attempt), 4)))), retryAfter ?? 0)
+    }
+
+    static func parse(_ data: Data, at time: Date) throws -> QuotaSnapshot {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let usage = root["usage"] as? [String: Any] else { throw URLError(.cannotParseResponse) }
+        let fractional = ISO8601DateFormatter()
+        fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        let plain = ISO8601DateFormatter()
+        var blocked = false
+        let known = ["monthly", "weekly", "rolling"]
+        let keys = known + usage.keys.filter { !known.contains($0) }.sorted()
+        let windows = keys.compactMap { id -> QuotaWindow? in
+            guard let entry = usage[id] as? [String: Any] else { return nil }
+            let number = entry["percent"] as? NSNumber
+            let percent = number.flatMap { CFGetTypeID($0) == CFBooleanGetTypeID() ? nil : $0.doubleValue }
+            let fraction = percent.flatMap { $0.isFinite ? $0 / 100 : nil }
+            let reset = (entry["resetsAt"] as? String).flatMap { fractional.date(from: $0) ?? plain.date(from: $0) }
+            if entry["status"] as? String == "rate-limited" { blocked = true }
+            let duration: TimeInterval?
+            switch id {
+            case "rolling": duration = 18_000
+            case "weekly": duration = 604_800
+            case "monthly":
+                var calendar = Calendar(identifier: .gregorian)
+                calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+                duration = reset.flatMap { end in calendar.date(byAdding: .month, value: -1, to: end).map { end.timeIntervalSince($0) } }
+            default: duration = nil
+            }
+            return QuotaWindow(id: id, label: known.contains(id) ? "" : id, usedFraction: fraction, remaining: fraction.map { 1 - $0 },
+                               used: fraction, resetAt: reset, duration: duration)
+        }
+        guard !windows.isEmpty else { throw URLError(.cannotParseResponse) }
+        return QuotaSnapshot(id: "opencode-go", displayName: "OpenCode Go", fidelity: "official", status: .ok,
+                             windows: windows, headlineId: "rolling", block: blocked ? "OpenCode Go allowance reached" : nil,
+                             account: nil, plan: "Go", observedAt: time, source: "go/v1/usage", credits: nil,
+                             nextAllowedAt: nil, waitingForRefresh: false)
+    }
+
+    private static func authorizedRequest(_ url: URL, credential: OpenCodeGoCredentials) -> URLRequest {
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15
+        request.setValue("Bearer \(credential.token)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        if let org = credential.org { request.setValue(org, forHTTPHeaderField: "x-opencode-org-id") }
+        return request
+    }
+
+    private final class NoRedirect: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+        func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                        newRequest request: URLRequest, completionHandler: @escaping (URLRequest?) -> Void) { completionHandler(nil) }
+    }
+    private static func request(_ request: URLRequest) async throws -> (Data, HTTPURLResponse) {
+        let session = URLSession(configuration: .ephemeral, delegate: NoRedirect(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        let (data, response) = try await session.data(for: request)
+        guard let response = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        return (data, response)
+    }
+    private func save(_ schedule: Schedule, key: String) {
+        schedules[key] = schedule
+        if persistence.save(schedule, key: key) { defaults.removeObject(forKey: "opencode-go.quota.schedule." + key) }
+    }
+    private func stale(_ account: String, next: Date?, otherwise: QuotaStatus = .error) -> QuotaSnapshot {
+        guard let value = cached[account], value.observedAt != nil else { return snapshot(otherwise, next: next) }
+        return copying(value, status: .stale, next: next)
+    }
+    private func copying(_ value: QuotaSnapshot, status: QuotaStatus, next: Date?) -> QuotaSnapshot {
+        value.copying(status: status, next: next)
+    }
+    private func snapshot(_ status: QuotaStatus, next: Date? = nil) -> QuotaSnapshot {
+        QuotaSnapshot(id: "opencode-go", displayName: "OpenCode Go", fidelity: "official", status: status,
+                      windows: [], headlineId: nil, block: nil, account: nil, plan: nil, observedAt: nil,
+                      source: "go/v1/usage", credits: nil, nextAllowedAt: next, waitingForRefresh: false)
+    }
+}
