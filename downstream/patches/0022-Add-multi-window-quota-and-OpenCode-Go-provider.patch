+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls;
+        public readonly List<string> Paths = [];
+        public string? AuthorizationScheme, Token, Organization;
+        public Func<HttpRequestMessage, HttpResponseMessage> Reply = _ => Response(200);
+        public TaskCompletionSource? Block;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Calls++;
+            Assert.Equal(HttpMethod.Get, request.Method);
+            Assert.Equal("opencode.ai", request.RequestUri!.Host);
+            Assert.Contains(request.Headers.Accept, item => item.MediaType == "application/json");
+            Paths.Add(request.RequestUri.AbsolutePath);
