+        #expect(sqlite3_exec(db, "UPDATE credential SET value='{}' WHERE id='go'", nil, nil, nil) == SQLITE_OK)
+        #expect(OpenCodeGoCredentials.load(directory: directory, databaseURL: url) == nil)
+        #expect(sqlite3_exec(db, "UPDATE credential SET active=0", nil, nil, nil) == SQLITE_OK)
+        #expect(OpenCodeGoCredentials.load(directory: directory, databaseURL: url) == nil)
+    }
+
+    @Test func concurrentRefreshesShareOneRealProviderPoll() async throws {
+        let directory = try temporaryDirectory(), suite = UUID().uuidString
+        defer { try? FileManager.default.removeItem(at: directory); UserDefaults(suiteName: suite)?.removePersistentDomain(forName: suite) }
