 /// Owns quota refresh state; credentials remain with the provider.
 @MainActor @Observable
 final class QuotaController {
-    private let provider = CodexQuotaProvider()
+    private let providers: [any QuotaProvider]
     private var task: Task<Void, Never>?
     private var timer: Timer?
-    private(set) var snapshots: [CodexQuotaSnapshot] = []
+    private(set) var snapshots: [QuotaSnapshot] = []
     private(set) var isRefreshing = false
     private(set) var networkEnabled = false
     var floatingVisible: Bool {
         didSet { defaults.set(floatingVisible, forKey: "quota.floatingVisible") }
     }
     private let defaults: UserDefaults
+    var selectedProviderID: String {
+        didSet { defaults.set(selectedProviderID, forKey: "quota.selectedProviderID") }
+    }
+    var selectedSnapshot: QuotaSnapshot? {
+        snapshots.first { $0.id == selectedProviderID } ?? snapshots.first
+    }
 
-    init(defaults: UserDefaults = .standard) {
+    init(defaults: UserDefaults = .standard, providers: [any QuotaProvider] = QuotaProviderRegistry.makeProviders()) {
         self.defaults = defaults
+        self.providers = providers
+        selectedProviderID = defaults.string(forKey: "quota.selectedProviderID") ?? "codex"
         floatingVisible = defaults.object(forKey: "quota.floatingVisible") as? Bool ?? true
     }
 
@@ -26,7 +34,9 @@ final class QuotaController {
         networkEnabled = enabled
         if !enabled {
             task?.cancel()
-            Task { [provider] in await provider.cancel() }
+            Task { [providers] in
+                for provider in providers { await provider.cancel() }
+            }
             task = nil
             isRefreshing = false
             timer?.invalidate()
@@ -39,10 +49,17 @@ final class QuotaController {
     func refresh() {
         guard networkEnabled, !isRefreshing else { return }
         isRefreshing = true
-        task = Task { [weak self, provider] in
-            let snapshot = await provider.refresh()
+        task = Task { [weak self, providers] in
+            let snapshots = await withTaskGroup(of: (Int, QuotaSnapshot).self) { group in
+                for (index, provider) in providers.enumerated() {
+                    group.addTask { (index, await provider.refresh()) }
+                }
+                var results: [(Int, QuotaSnapshot)] = []
+                for await result in group { results.append(result) }
+                return results.sorted { $0.0 < $1.0 }.map(\.1)
+            }
             guard !Task.isCancelled, let self else { return }
-            self.snapshots = [snapshot]
+            self.snapshots = snapshots
             self.isRefreshing = false
             self.task = nil
             self.scheduleRefresh()
