+    [Fact]
+    public void ProvidersHydrateBeforePaintStartIndependentlyAndDisplayEveryQualifyingWindow()
+    {
+        RunSta(() =>
+        {
+            using var fixture = new Fixture();
+            using (var codex = fixture.Provider("codex")) codex.RefreshAsync().GetAwaiter().GetResult();
+            using (var go = fixture.Provider("opencode-go")) go.RefreshAsync().GetAwaiter().GetResult();
+            fixture.Now = fixture.Now.AddMinutes(1);
+            fixture.Go.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+            settings.MakeEphemeral();
+            settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = false,
+                QuotaAllSources = false, QuotaSources = ["codex", "opencode-go"] });
+            var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+            using var surface = new QuotaSurface(settings, loc, false, fixture.Provider, now: () => fixture.Now);
+            settings.Changed += (_, _) => surface.ApplySettings();
+            var page = surface.CreatePage();
+            string[] PageText() => Descendants(page).OfType<TextBlock>().Select(text => text.Text).ToArray();
+            Assert.Contains("Codex", PageText()); Assert.Contains("OpenCode Go", PageText());
+            Assert.Contains(loc.Format("win.quota.remaining", QuotaFormat.Percent(loc, -.25)), PageText());
+            Assert.Equal(1, fixture.Codex.UsageCalls); Assert.Equal(1, fixture.Go.UsageCalls);
+            settings.Update(value => value with { NetworkEnabled = true });
+            PumpUntil(() => fixture.Codex.UsageCalls == 2 && fixture.Go.UsageCalls == 2);
+            // The blocked Go request must not hide the independently completed Codex observation.
+            PumpUntil(() => PageText().Contains("plus"));
+            UIElement? summary = null;
+            surface.FlyoutChanged += value => summary = value;
+            surface.SetFlyoutActive(true);
+            Assert.NotNull(summary);
+            Assert.Equal(4, Descendants(summary!).OfType<ProgressBar>().Count());
+            var labels = Descendants(summary!).OfType<TextBlock>().Select(text => text.Text).ToArray();
+            Assert.Contains(labels, text => text.Contains(QuotaFormat.Percent(loc, -.25), StringComparison.Ordinal));
+            Assert.Contains(labels, text => text.Contains("OpenCode Go", StringComparison.Ordinal));
+            var bars = Descendants(summary!).OfType<ProgressBar>().ToArray();
+            Assert.Contains(bars, bar => bar.Value == 0);
+            Assert.Contains(bars, bar => bar.Value == 1);
+            var blue = (Color)ColorConverter.ConvertFromString("#438fe5");
+            Assert.Contains(bars, bar => bar.Foreground is SolidColorBrush brush && brush.Color == blue);
+            settings.Update(value => value with { QuotaSources = ["opencode-go"] });
+            Assert.Equal(0, fixture.Go.Cancellations);
+            fixture.Go.Block.SetResult();
+            PumpUntil(() => !PageText().Contains(loc["win.quota.stale"]));
+            Assert.Equal(2, fixture.Codex.UsageCalls); Assert.Equal(2, fixture.Go.UsageCalls);
+            settings.Update(value => value with { QuotaSources = ["codex", "opencode-go"] });
