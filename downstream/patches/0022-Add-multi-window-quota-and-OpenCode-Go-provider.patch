+        fixture.Clock = Time.AddSeconds(expected).AddTicks(-1);
+        await restarted.RefreshStartupAsync();
+        Assert.Equal(2, fixture.Handler.Calls);
+        fixture.Clock = Time.AddSeconds(expected);
