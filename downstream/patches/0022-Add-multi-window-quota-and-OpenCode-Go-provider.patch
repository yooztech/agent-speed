+        #expect(sqlite3_open(url.path, &db) == SQLITE_OK)
+        defer { sqlite3_close(db) }
+        let sql = """
+        PRAGMA journal_mode=WAL;
+        CREATE TABLE credential(id TEXT, integration_id TEXT, value TEXT, active INTEGER, time_created INTEGER, time_updated INTEGER);
+        INSERT INTO credential VALUES('console', 'opencode', '{"type":"key","key":"console-key"}', 1, 200, 200);
+        INSERT INTO credential VALUES('go', 'opencode-go', '{"type":"api","key":"database-key"}', NULL, 100, 100);
+        """
+        #expect(sqlite3_exec(db, sql, nil, nil, nil) == SQLITE_OK)
