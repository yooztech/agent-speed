+using System.Globalization;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using AgentSpeed.Core.IO.Sqlite;
+
+namespace AgentSpeed.Core;
+
+/// <remarks>Adapted from Codenotch (MIT), commit 835550a342871779135b6484d6899161c5222f7c,
+/// Sources/Providers/OpenCodeCredentials.swift, OpenCodeProvider.swift and OpenCodeUsage.swift.
+/// Saved metadata decoding also follows OpenCode v2.3.0. Never renews or writes credentials.</remarks>
+public sealed class OpenCodeGoQuotaProvider : IQuotaProvider
+{
+    private static readonly Uri Endpoint = new("https://opencode.ai/zen/go/v1/usage");
+    private static readonly Uri OAuthEndpoint = new("https://opencode.ai/inference/go/v1/usage");
+    private const string Source = "go/v1/usage";
+    private readonly string credentialPath, scheduleDirectory;
+    private readonly string? databasePath;
+    private readonly HttpClient client;
+    private readonly Func<DateTimeOffset> now;
+    private readonly object gate = new();
+    private readonly Dictionary<string, Schedule> schedules = new(StringComparer.Ordinal);
+    private Task<QuotaSnapshot>? inFlight;
+    private CancellationTokenSource? activeCancellation;
+    private bool disposed;
+
+    public OpenCodeGoQuotaProvider() : this(Path.Combine(DataDirectory(), "auth.json"),
+        Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota", "opencode-go"),
+        new HttpClient(new HttpClientHandler { AllowAutoRedirect = false }), () => DateTimeOffset.UtcNow,
+        DatabasePath(DataDirectory())) { }
+
+    internal OpenCodeGoQuotaProvider(string credentialPath, string scheduleDirectory, HttpClient client,
+        Func<DateTimeOffset> now, string? databasePath = null)
+    {
+        this.credentialPath = credentialPath;
+        this.scheduleDirectory = scheduleDirectory;
+        this.client = client;
+        this.now = now;
+        this.databasePath = databasePath;
+    }
+
+    internal static string DataDirectory() => Path.Combine(
+        Environment.GetEnvironmentVariable("XDG_DATA_HOME") is { Length: > 0 } data ? data :
+            Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share"), "opencode");
+
+    internal static string? DatabasePath(string directory)
+    {
+        var value = Environment.GetEnvironmentVariable("OPENCODE_DB");
+        if (value == ":memory:") return null;
+        return string.IsNullOrEmpty(value) ? Path.Combine(directory, "opencode.db") :
+            Path.IsPathRooted(value) ? value : Path.Combine(directory, value);
+    }
+
+    private sealed record Credential(string Token, string? Organization, string Context, bool OAuth,
+        Uri Console, DateTimeOffset? Expires)
+    {
+        public string Key => Digest(Context + "\n" + Organization + "\n" + Token + "\n" + OAuth + "\n" + Console);
+    }
+
+    private Credential? ReadCredentials()
+    {
+        if (databasePath is not null && File.Exists(databasePath))
+        {
+            try
+            {
+                using var db = SqliteConnection.Open(databasePath, SqliteOpenMode.ReadOnly);
+                if (db.ScalarInt64("SELECT count(*) FROM sqlite_master WHERE type='table' AND name='credential'") > 0)
+                {
+                    using var row = db.Prepare("SELECT id, value FROM credential WHERE integration_id IN ('opencode-go','opencode') AND COALESCE(active,1) != 0 ORDER BY CASE integration_id WHEN 'opencode-go' THEN 0 ELSE 1 END, time_updated DESC, id DESC LIMIT 1");
+                    // A selected database row owns this identity even if malformed. Never revive a retired file key.
+                    if (row.Step()) return DecodeCredential(row.GetString(1), "saved:" + row.GetString(0));
+                }
+            }
+            catch (Exception error) when (error is SqliteException or IOException or UnauthorizedAccessException or
+                InvalidOperationException or DllNotFoundException) { }
+            catch (JsonException) { return null; }
+        }
+        try
+        {
+            using var doc = JsonDocument.Parse(File.ReadAllText(credentialPath));
+            var go = Property(doc.RootElement, "opencode-go");
+            if (go.ValueKind != JsonValueKind.Undefined)
+                return DecodeCredential(go.GetRawText(), "legacy:opencode-go");
+            var oauth = Property(doc.RootElement, "opencode");
+            return Text(oauth, "type") == "oauth" ? DecodeCredential(oauth.GetRawText(), "legacy:opencode") : null;
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or JsonException or ArgumentException)
+        { return null; }
+    }
+
+    private static Credential? DecodeCredential(string? json, string context)
+    {
+        if (json is null) return null;
+        using var doc = JsonDocument.Parse(json);
+        var value = doc.RootElement;
+        if (value.ValueKind == JsonValueKind.String)
+            return ValidHeader(value.GetString()) ? new(value.GetString()!, null, context, false, new("https://opencode.ai/console"), null) : null;
+        var type = Text(value, "type");
+        var metadata = Property(value, "metadata");
+        var configuration = Property(value, "configuration");
+        var organization = type == "key" && configuration.ValueKind == JsonValueKind.Object && configuration.TryGetProperty("orgID", out var configured)
+            ? configured.ValueKind == JsonValueKind.String ? configured.GetString() : null : Text(metadata, "orgID");
+        if (organization is not null && !ValidHeader(organization)) return null;
+        var oauth = type == "oauth";
+        var token = oauth ? Text(value, "access") : value.ValueKind == JsonValueKind.Object
+            ? new[] { "key", "apiKey", "api_key", "token", "accessToken" }.Select(name => Text(value, name)).FirstOrDefault(ValidHeader) : null;
+        if (!ValidHeader(token)) return null;
+        var console = new Uri("https://opencode.ai/console");
+        if (Text(metadata, "server") is { } server)
+        {
+            // Never transmit a borrowed credential to an arbitrary metadata URL or follow redirects.
+            if (!Uri.TryCreate(server, UriKind.Absolute, out var parsed) || parsed.Scheme != "https" || parsed.Host != "opencode.ai" ||
+                !parsed.IsDefaultPort || parsed.UserInfo.Length != 0) return null;
+            console = new UriBuilder(parsed) { Query = "", Fragment = "" }.Uri;
+        }
+        DateTimeOffset? expires = null;
+        var rawExpiry = Property(value, "expires");
+        var expiry = Number(value, "expires") ?? (rawExpiry.ValueKind == JsonValueKind.String && double.TryParse(rawExpiry.GetString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var number) && double.IsFinite(number) ? (double?)number : null);
+        if (expiry is > 0 and <= 253402300799999) expires = DateTimeOffset.UnixEpoch.AddMilliseconds(expiry.Value);
+        return new(token!, organization, context, oauth, console, expires);
+    }
+
+    private static bool ValidHeader(string? value) => !string.IsNullOrWhiteSpace(value) && !value.Any(char.IsControl);
+
+    public QuotaSnapshot ReadCachedSnapshot()
+    {
+        lock (gate)
+        {
+            if (disposed || ReadCredentials() is not { } credential) return Empty(QuotaStatus.NeedsAuth);
+            var schedule = GetSchedule(credential.Key);
+            return schedule.RejectedStatus is { } rejected ? Empty(rejected, schedule.NextAllowedAt) : StaleOrError(schedule);
+        }
+    }
+
+    public Task<QuotaSnapshot> RefreshAsync() => StartRefresh();
+    public Task<QuotaSnapshot> RefreshStartupAsync() => StartRefresh();
+
+    private Task<QuotaSnapshot> StartRefresh()
+    {
+        lock (gate)
+        {
+            if (disposed) return Task.FromResult(Empty(QuotaStatus.Error));
+            if (inFlight is { IsCompleted: false }) return inFlight;
+            activeCancellation?.Dispose();
+            activeCancellation = new CancellationTokenSource();
+            return inFlight = RefreshCoreAsync(activeCancellation.Token);
+        }
+    }
+
+    public void Cancel() { lock (gate) activeCancellation?.Cancel(); }
+    public void Dispose() { lock (gate) { disposed = true; activeCancellation?.Cancel(); client.Dispose(); } }
+
+    private async Task<QuotaSnapshot> RefreshCoreAsync(CancellationToken cancellationToken)
+    {
+        var credential = ReadCredentials();
+        if (credential is null) return Empty(QuotaStatus.NeedsAuth);
+        var key = credential.Key;
+        Schedule schedule;
+        lock (gate)
+        {
+            schedule = GetSchedule(key).Copy();
+            var time = now();
+            if (schedule.RejectedStatus == QuotaStatus.NeedsAuth) return Empty(QuotaStatus.NeedsAuth);
+            if (schedule.RejectedStatus == QuotaStatus.Unsupported && schedule.NextAllowedAt is { } unavailableUntil && time < unavailableUntil)
+                return Empty(QuotaStatus.Unsupported, unavailableUntil);
+            schedule.RejectedStatus = null;
+            if (schedule.NextAllowedAt is { } next && time < next)
+                return schedule.Snapshot is { } cached ? cached with { NextAllowedAt = next } : Empty(QuotaStatus.Error, next);
+        }
+        QuotaSnapshot result;
+        try
+        {
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            timeout.CancelAfter(TimeSpan.FromSeconds(15));
+            using var request = new HttpRequestMessage(HttpMethod.Get, credential.OAuth ? OAuthEndpoint : Endpoint);
+            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", credential.Token);
+            request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
+            if (credential.Organization is not null) request.Headers.Add("x-opencode-org-id", credential.Organization);
+            using var response = await client.SendAsync(request, timeout.Token).ConfigureAwait(false);
+            if (response.IsSuccessStatusCode)
+            {
+                result = Parse(await response.Content.ReadAsStringAsync(timeout.Token).ConfigureAwait(false), now());
+                // Successful Go observations clear backoff; only the application timer imposes a 300s cadence.
+                schedule.NextAllowedAt = null;
+                schedule.RetryNotBefore = null;
+                schedule.Failures = 0;
+                schedule.ColdFailures = 0;
+                schedule.SuccessfulObservation = true;
+                schedule.Snapshot = result;
+            }
+            else if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+            {
+                var signedIn = credential.OAuth && response.StatusCode == HttpStatusCode.Unauthorized
+                    ? await SignedInAsync(credential, schedule, timeout.Token).ConfigureAwait(false) : false;
+                var noPlan = response.StatusCode == HttpStatusCode.Forbidden || signedIn == true;
+                if (signedIn is null)
+                    result = StaleOrError(schedule);
