diff --git a/windows/tests/AgentSpeed.Windows.Tests/QuotaSurfaceProviderCollectionTests.cs b/windows/tests/AgentSpeed.Windows.Tests/QuotaSurfaceProviderCollectionTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b759efe5430be9176e2539dcff7235bfafdf2092
--- /dev/null
+++ b/windows/tests/AgentSpeed.Windows.Tests/QuotaSurfaceProviderCollectionTests.cs
@@ -0,0 +1,171 @@
+using System.IO;
+using System.Net;
+using System.Net.Http;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Services;
+using AgentSpeed.Settings;
+
+namespace AgentSpeed.Windows.Tests;
+
+public sealed class QuotaSurfaceProviderCollectionTests
+{
+    [Fact]
+    public void ProvidersHydrateBeforePaintStartIndependentlyAndDisplayEveryQualifyingWindow()
+    {
+        RunSta(() =>
+        {
+            using var fixture = new Fixture();
+            using (var codex = fixture.Provider("codex")) codex.RefreshAsync().GetAwaiter().GetResult();
+            using (var go = fixture.Provider("opencode-go")) go.RefreshAsync().GetAwaiter().GetResult();
+            fixture.Now = fixture.Now.AddMinutes(1);
+            fixture.Go.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+            settings.MakeEphemeral();
+            settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = false,
+                QuotaAllSources = false, QuotaSources = ["codex", "opencode-go"] });
+            var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+            using var surface = new QuotaSurface(settings, loc, false, fixture.Provider, now: () => fixture.Now);
+            settings.Changed += (_, _) => surface.ApplySettings();
+            var page = surface.CreatePage();
+            string[] PageText() => Descendants(page).OfType<TextBlock>().Select(text => text.Text).ToArray();
+            Assert.Contains("Codex", PageText()); Assert.Contains("OpenCode Go", PageText());
+            Assert.Contains(loc.Format("win.quota.remaining", QuotaFormat.Percent(loc, -.25)), PageText());
+            Assert.Equal(1, fixture.Codex.UsageCalls); Assert.Equal(1, fixture.Go.UsageCalls);
+            settings.Update(value => value with { NetworkEnabled = true });
+            PumpUntil(() => fixture.Codex.UsageCalls == 2 && fixture.Go.UsageCalls == 2);
+            // The blocked Go request must not hide the independently completed Codex observation.
+            PumpUntil(() => PageText().Contains("plus"));
+            UIElement? summary = null;
+            surface.FlyoutChanged += value => summary = value;
+            surface.SetFlyoutActive(true);
+            Assert.NotNull(summary);
+            Assert.Equal(4, Descendants(summary!).OfType<ProgressBar>().Count());
+            var labels = Descendants(summary!).OfType<TextBlock>().Select(text => text.Text).ToArray();
+            Assert.Contains(labels, text => text.Contains(QuotaFormat.Percent(loc, -.25), StringComparison.Ordinal));
+            Assert.Contains(labels, text => text.Contains("OpenCode Go", StringComparison.Ordinal));
+            var bars = Descendants(summary!).OfType<ProgressBar>().ToArray();
+            Assert.Contains(bars, bar => bar.Value == 0);
+            Assert.Contains(bars, bar => bar.Value == 1);
+            var blue = (Color)ColorConverter.ConvertFromString("#438fe5");
+            Assert.Contains(bars, bar => bar.Foreground is SolidColorBrush brush && brush.Color == blue);
+            settings.Update(value => value with { QuotaSources = ["opencode-go"] });
+            Assert.Equal(0, fixture.Go.Cancellations);
+            fixture.Go.Block.SetResult();
+            PumpUntil(() => !PageText().Contains(loc["win.quota.stale"]));
+            Assert.Equal(2, fixture.Codex.UsageCalls); Assert.Equal(2, fixture.Go.UsageCalls);
+            settings.Update(value => value with { QuotaSources = ["codex", "opencode-go"] });
+            PumpFor(TimeSpan.FromMilliseconds(40));
+            // Re-enabling a source does not grant a second application startup observation in manual mode.
+            Assert.Equal(2, fixture.Codex.UsageCalls); Assert.Equal(2, fixture.Go.UsageCalls);
+            // A user refresh, unlike automatic cadence or source changes, immediately re-reads successful Go usage.
+            var refresh = Assert.Single(Descendants(page).OfType<Button>(), button => Equals(button.Content, loc["win.quota.refresh"]));
+            refresh.RaiseEvent(new RoutedEventArgs(Button.ClickEvent));
+            PumpUntil(() => fixture.Go.UsageCalls == 3);
+            Assert.Equal(2, fixture.Codex.UsageCalls);
+        });
+    }
+
+    [Fact]
+    public void DisablingOneSourceCancelsOnlyItsRequestAndConsentCancellationCannotReviveIt()
+    {
+        RunSta(() =>
+        {
+            using var fixture = new Fixture();
+            fixture.Codex.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            fixture.Go.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+            using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+            settings.MakeEphemeral();
+            settings.Update(value => value with { ShowQuotaNotch = false, AutoRefreshQuota = false, NetworkEnabled = true,
+                QuotaAllSources = false, QuotaSources = ["codex", "opencode-go"] });
+            var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+            using var surface = new QuotaSurface(settings, loc, false, fixture.Provider, now: () => fixture.Now);
+            settings.Changed += (_, _) => surface.ApplySettings();
+            PumpUntil(() => fixture.Codex.UsageCalls == 1 && fixture.Go.UsageCalls == 1);
+            settings.Update(value => value with { QuotaSources = ["codex"] });
+            PumpUntil(() => fixture.Go.Cancellations == 1);
+            Assert.Equal(0, fixture.Codex.Cancellations);
+            settings.Update(value => value with { NetworkEnabled = false });
+            PumpUntil(() => fixture.Codex.Cancellations == 1);
+            fixture.Go.Block.SetResult(); fixture.Codex.Block.SetResult();
+            PumpFor(TimeSpan.FromMilliseconds(40));
+            Assert.False(Directory.Exists(fixture.GoSchedule));
+            Assert.False(Directory.Exists(fixture.CodexSchedule));
+        });
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        private readonly string root = Path.Combine(Path.GetTempPath(), "quota-collection-" + Guid.NewGuid().ToString("N"));
+        public DateTimeOffset Now = new(2026, 2, 1, 0, 0, 0, TimeSpan.Zero);
+        public readonly Handler Codex = new(false), Go = new(true);
+        public string CodexSchedule => Path.Combine(root, "codex-cache");
+        public string GoSchedule => Path.Combine(root, "go-cache");
+        public Fixture()
+        {
+            Directory.CreateDirectory(root);
+            File.WriteAllText(Path.Combine(root, "codex-auth.json"), """{"tokens":{"access_token":"synthetic-codex-token","account_id":"synthetic-codex-account"}}""");
+            File.WriteAllText(Path.Combine(root, "go-auth.json"), """{"opencode-go":{"type":"api","key":"synthetic-go-key"}}""");
+        }
+        public IQuotaProvider Provider(string id) => id switch
+        {
+            "codex" => new CodexQuotaProvider(Path.Combine(root, "codex-auth.json"), CodexSchedule, new HttpClient(Codex, false), () => Now),
+            "opencode-go" => new OpenCodeGoQuotaProvider(Path.Combine(root, "go-auth.json"), GoSchedule, new HttpClient(Go, false), () => Now),
+            _ => throw new ArgumentOutOfRangeException(nameof(id))
+        };
+        public void Dispose() { Codex.Dispose(); Go.Dispose(); Directory.Delete(root, true); }
+    }
+
+    private sealed class Handler(bool go) : HttpMessageHandler
+    {
+        private int usageCalls, cancellations;
+        public int UsageCalls => Volatile.Read(ref usageCalls);
+        public int Cancellations => Volatile.Read(ref cancellations);
+        public TaskCompletionSource? Block;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var usage = request.RequestUri!.AbsolutePath.EndsWith("/usage", StringComparison.Ordinal);
+            if (usage) Interlocked.Increment(ref usageCalls);
+            try { if (usage && Block is { } block) await block.Task.WaitAsync(cancellationToken); }
+            catch (OperationCanceledException) { Interlocked.Increment(ref cancellations); throw; }
+            return new(HttpStatusCode.OK) { Content = new StringContent(!usage ? "{\"available_count\":0}" : go ? """
+                {"usage":{"rolling":{"status":"ok","percent":0,"resetsAt":"2026-02-01T05:00:00Z"},
+                "weekly":{"status":"ok","percent":30,"resetsAt":"2026-02-08T00:00:00Z"},
+                "monthly":{"status":"rate-limited","percent":125,"resetsAt":"2026-03-01T00:00:00Z"}}}
+                """ : """{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":95,"limit_window_seconds":604800}}}""") };
+        }
+    }
+
+    private static IEnumerable<DependencyObject> Descendants(DependencyObject parent)
+    {
+        foreach (var child in LogicalTreeHelper.GetChildren(parent).OfType<DependencyObject>())
+        {
+            yield return child;
+            foreach (var descendant in Descendants(child)) yield return descendant;
+        }
+    }
+    private static void RunSta(Action action)
+    {
+        Exception? failure = null;
+        var thread = new Thread(() => { try { action(); } catch (Exception error) { failure = error; } });
+        thread.SetApartmentState(ApartmentState.STA); thread.Start(); thread.Join();
+        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+    }
+    private static void PumpUntil(Func<bool> condition)
+    {
+        var deadline = DateTime.UtcNow.AddSeconds(5);
+        while (!condition() && DateTime.UtcNow < deadline) PumpFor(TimeSpan.FromMilliseconds(10));
+        Assert.True(condition());
+    }
+    private static void PumpFor(TimeSpan duration)
+    {
+        var frame = new DispatcherFrame();
+        var timer = new DispatcherTimer { Interval = duration };
+        timer.Tick += (_, _) => { timer.Stop(); frame.Continue = false; }; timer.Start(); Dispatcher.PushFrame(frame);
+    }
+}
