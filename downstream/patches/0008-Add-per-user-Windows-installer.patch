+[Code]
+const
+  RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
+
+var
+  StartupDefaultApplied: Boolean;
+
+function StartupSpecifiedOnCommandLine: Boolean;
+var
+  I, P: Integer;
+  Arg, Tasks, Task: String;
+begin
+  Result := False;
+  for I := 1 to ParamCount do
+  begin
+    Arg := Lowercase(ParamStr(I));
+    { /TASKS replaces all defaults, including startup. }
+    if Pos('/tasks=', Arg) = 1 then
+    begin
+      Result := True;
+      Exit;
+    end;
+    { /MERGETASKS only overrides the named tasks. }
+    if Pos('/mergetasks=', Arg) = 1 then
+    begin
+      Tasks := Copy(Arg, Length('/mergetasks=') + 1, Length(Arg)) + ',';
+      while Tasks <> '' do
+      begin
+        P := Pos(',', Tasks);
+        Task := Trim(Copy(Tasks, 1, P - 1));
+        Delete(Tasks, 1, P);
+        if (Task = 'startup') or (Task = '*startup') or (Task = '!startup') then
+        begin
+          Result := True;
+          Exit;
+        end;
+      end;
+    end;
+  end;
+end;
+
+procedure CurPageChanged(CurPageID: Integer);
+var
+  RunValue: String;
+begin
+  if (CurPageID = wpSelectTasks) and not StartupDefaultApplied then
+  begin
+    StartupDefaultApplied := True;
+    if not StartupSpecifiedOnCommandLine and
+       ((RegQueryStringValue(HKCU, RunKey, 'AgentSpeed', RunValue) and (Trim(RunValue) <> '')) or
+        FileExists(ExpandConstant('{userstartup}\Agent Speed.lnk'))) then
+      WizardSelectTasks('startup');
+  end;
+end;
+
+procedure CurStepChanged(CurStep: TSetupStep);
+var
+  Location: String;
+begin
+  if CurStep = ssPostInstall then
+  begin
+    DeleteFile(ExpandConstant('{userstartup}\Agent Speed.lnk'));
+    if WizardIsTaskSelected('startup') then
+      RegWriteStringValue(HKCU, RunKey, 'AgentSpeed', '"' + ExpandConstant('{app}\AgentSpeed.exe') + '"')
+    else
+      RegDeleteValue(HKCU, RunKey, 'AgentSpeed');
+  end;
+  if (CurStep = ssPostInstall) and
+     RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\AgentSpeed', 'InstallLocation', Location) and
+     (CompareText(RemoveBackslashUnlessRoot(Location), RemoveBackslashUnlessRoot(ExpandConstant('{app}'))) = 0) then
+  begin
+    RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\AgentSpeed');
+    DeleteFile(ExpandConstant('{app}\uninstall.ps1'));
+  end;
+end;
+
+procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
+var
+  Script, Params: String;
+  ResultCode: Integer;
+begin
+  if CurUninstallStep = usUninstall then
+  begin
+    RegDeleteValue(HKCU, RunKey, 'AgentSpeed');
+    DeleteFile(ExpandConstant('{userstartup}\Agent Speed.lnk'));
+    { Stage a private, locked copy so the helper can remove its installed executable. }
+    Script := '$ErrorActionPreference = ''Stop''; ' +
+      '$sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value; ' +
+      '$key = [Microsoft.Win32.RegistryKey]::OpenBaseKey(' +
+      '[Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64); ' +
+      'try { $helperKey = $key.OpenSubKey(''SOFTWARE\AgentSpeed\TrafficHelper''); ' +
+      'if (-not $helperKey) { exit 0 }; ' +
+      'try { $allowed = $helperKey.GetValue(''AllowedUsers'') } finally { $helperKey.Dispose() } ' +
+      '} finally { $key.Dispose() }; ' +
+      'if (@($allowed) -notcontains $sid) { exit 0 }; ' +
+      '$programFiles = if ($env:ProgramW6432) { $env:ProgramW6432 } else { $env:ProgramFiles }; ' +
+      '$helper = Join-Path $programFiles ''Agent Speed\Traffic Helper\AgentSpeedTrafficHelper.exe''; ' +
+      'if (-not (Test-Path -LiteralPath $helper -PathType Leaf)) { exit 1 }; ' +
+      '$parent = Join-Path ([Environment]::GetFolderPath(''LocalApplicationData'')) ''AgentSpeed\helper-staging''; ' +
+      '[void][IO.Directory]::CreateDirectory($parent); ' +
+      '$folder = Join-Path $parent ([Guid]::NewGuid().ToString(''N'')); ' +
+      '$acl = New-Object Security.AccessControl.DirectorySecurity; ' +
+      '$acl.SetSecurityDescriptorSddlForm((''O:{0}D:P(A;OICI;FA;;;{0})(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)'' -f $sid)); ' +
+      '[void][IO.Directory]::CreateDirectory($folder, $acl); ' +
+      'try { $copy = Join-Path $folder ''AgentSpeedTrafficHelper.exe''; ' +
+      '[IO.File]::Copy($helper, $copy); ' +
+      '$hold = [IO.File]::Open($copy, ''Open'', ''Read'', ''Read''); ' +
+      'try { $p = Start-Process -FilePath $copy -ArgumentList @(''remove'', ''--user'', $sid) -Verb RunAs -Wait -PassThru; ' +
+      '$code = $p.ExitCode } finally { $hold.Dispose() } ' +
+      '} finally { Remove-Item -LiteralPath $folder -Recurse -Force -ErrorAction SilentlyContinue }; ' +
+      'exit $code';
+    Params := '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';
+    if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params, '', SW_HIDE,
+      ewWaitUntilTerminated, ResultCode) then
+      ResultCode := -1;
+    if ResultCode <> 0 then
+    begin
+      Log('Could not remove the current user from the Agent Speed traffic helper: ' + IntToStr(ResultCode));
+      if not UninstallSilent then
+        MsgBox('Could not remove the Agent Speed traffic helper authorization. You can remove it from Agent Speed settings before uninstalling.', mbError, MB_OK);
+    end;
+  end;
+end;
