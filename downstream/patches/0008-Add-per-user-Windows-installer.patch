+#ifndef AppVersion
+  #error AppVersion is required
+#endif
+#ifndef PayloadDir
+  #error PayloadDir is required
+#endif
+#ifndef OutputDir
+  #error OutputDir is required
+#endif
+#ifndef Arch
+  #error Arch is required
+#endif
+
+[Setup]
+AppId={{B891159D-356B-4CCB-BB2F-69C3445B30E8}
+AppName=Agent Speed
+AppVersion={#AppVersion}
+AppPublisher=zoefix
+AppPublisherURL=https://github.com/zoefix/agent-speed
+DefaultDirName={localappdata}\Programs\AgentSpeed
+DisableDirPage=yes
+PrivilegesRequired=lowest
+#if Arch == "arm64"
+ArchitecturesAllowed=arm64
+ArchitecturesInstallIn64BitMode=arm64
+#else
+ArchitecturesAllowed=x64compatible and not arm64
+ArchitecturesInstallIn64BitMode=x64compatible
+#endif
+OutputDir={#OutputDir}
+OutputBaseFilename=AgentSpeed-Windows-{#Arch}-Setup
+Compression=lzma2
+SolidCompression=yes
+UninstallDisplayIcon={app}\AgentSpeed.exe
+CloseApplications=yes
+CloseApplicationsFilter=AgentSpeed.exe
+RestartApplications=no
+UsePreviousTasks=no
+
+[Tasks]
+Name: desktopicon; Description: "Create a desktop shortcut"; Flags: unchecked
+Name: startup; Description: "Start Agent Speed when I sign in"; Flags: unchecked
+
+[Files]
+Source: "{#PayloadDir}\AgentSpeed.exe"; DestDir: "{app}"; Flags: ignoreversion
+Source: "{#PayloadDir}\collectors\linux-x86_64\agent-speed-collector"; DestDir: "{app}\collectors\linux-x86_64"; Flags: ignoreversion
+
+[Icons]
+Name: "{userprograms}\Agent Speed"; Filename: "{app}\AgentSpeed.exe"; WorkingDir: "{app}"
+Name: "{userdesktop}\Agent Speed"; Filename: "{app}\AgentSpeed.exe"; WorkingDir: "{app}"; Tasks: desktopicon
