+using AgentSpeed.Updates;
+using Microsoft.Win32;
+
+namespace AgentSpeed.Windows.Tests;
+
+public class UninstallEntryTests
+{
+    [Theory]
+    [InlineData(UninstallEntry.InnoKeyName)]
+    [InlineData(UninstallEntry.LegacyKeyName)]
+    public void UpdatesAndRestoresInstalledVersion(string keyName)
+    {
+        using var registry = new TestRegistry();
+        using var key = registry.CreateEntry(keyName, @"C:\Users\Example\AgentSpeed\", "1.0.0");
+
+        var restore = UninstallEntry.TrySetDisplayVersion(Registry.CurrentUser, registry.Path, @"C:\Users\Example\AgentSpeed", "2.0.0");
+
+        Assert.NotNull(restore);
+        Assert.Equal("2.0.0", key.GetValue("DisplayVersion"));
+        UninstallEntry.Restore(Registry.CurrentUser, restore);
+        Assert.Equal("1.0.0", key.GetValue("DisplayVersion"));
+    }
+
+    [Fact]
+    public void RestoringAnAbsentVersionDeletesTheNewValue()
+    {
+        using var registry = new TestRegistry();
+        using var key = registry.CreateEntry(UninstallEntry.InnoKeyName, @"C:\AgentSpeed", null);
+
+        var restore = UninstallEntry.TrySetDisplayVersion(Registry.CurrentUser, registry.Path, @"C:\AgentSpeed", "2.0.0");
+
+        Assert.NotNull(restore);
+        Assert.Equal("2.0.0", key.GetValue("DisplayVersion"));
+        UninstallEntry.Restore(Registry.CurrentUser, restore);
+        Assert.Null(key.GetValue("DisplayVersion"));
+    }
+
+    [Fact]
+    public void IgnoresOtherInstallAndFallsBackToLegacyEntry()
+    {
+        using var registry = new TestRegistry();
+        using var inno = registry.CreateEntry(UninstallEntry.InnoKeyName, @"C:\Other", "1.0.0");
+        using var legacy = registry.CreateEntry(UninstallEntry.LegacyKeyName, @"C:\AgentSpeed", "1.1.0");
+
+        var restore = UninstallEntry.TrySetDisplayVersion(Registry.CurrentUser, registry.Path, @"C:\AgentSpeed", "2.0.0");
+
+        Assert.NotNull(restore);
+        Assert.Equal("1.0.0", inno.GetValue("DisplayVersion"));
+        Assert.Equal("2.0.0", legacy.GetValue("DisplayVersion"));
+        UninstallEntry.Restore(Registry.CurrentUser, restore);
+        Assert.Equal("1.1.0", legacy.GetValue("DisplayVersion"));
+    }
+
+    [Fact]
+    public void DoesNotCreateAnUninstallEntryForPortableInstall()
+    {
+        using var registry = new TestRegistry();
+
+        Assert.Null(UninstallEntry.TrySetDisplayVersion(Registry.CurrentUser, registry.Path, @"C:\AgentSpeed", "2.0.0"));
+        Assert.Null(Registry.CurrentUser.OpenSubKey(registry.Path));
+    }
+
+    private sealed class TestRegistry : IDisposable
+    {
+        public string Path { get; } = $@"Software\AgentSpeed.Tests\{Guid.NewGuid():N}";
+
+        public RegistryKey CreateEntry(string name, string location, string? version)
+        {
+            var key = Registry.CurrentUser.CreateSubKey($@"{Path}\{name}");
+            key.SetValue("InstallLocation", location);
+            if (version is not null)
+            {
+                key.SetValue("DisplayVersion", version);
+            }
+            return key;
+        }
+
+        public void Dispose() => Registry.CurrentUser.DeleteSubKeyTree(Path, throwOnMissingSubKey: false);
+    }
+}
