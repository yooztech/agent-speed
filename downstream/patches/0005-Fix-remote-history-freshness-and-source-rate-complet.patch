+    @Test @MainActor func historyStaysStaleUntilCurrentConnectionReceivesHistory() throws {
+        let suite = "RemoteHistoryFreshness.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let id = UUID()
+        let host = RemoteHost(id: id, label: "Remote", destination: "remote", enabled: true)
+        defaults.set(try JSONEncoder().encode([host]), forKey: "remoteHosts.v1")
+        let today = DayKey(Date(), calendar: HistoryDates.calendar).description
+        let snapshot = try #require(message(#"{"version":1,"type":"snapshot","today_day":"\#(today)"}"#))
+        let history = try #require(message(#"{"version":1,"type":"history","partial":false,"days":[]}"#))
+        let malformedHistory = try #require(message(#"{"version":1,"type":"history"}"#))
+        var state = RemoteHostState()
+
+        func check(_ state: RemoteHostState, stale: Bool, available: Bool) {
+            let hosts = RemoteHosts(defaults: defaults, states: [id: state])
+            let store = HistoryStore()
+            let app = AppModel(settings: AppSettings(defaults: defaults), history: store, remoteHosts: hosts)
+            app.selectedRemoteHostID = id
+            let view = HistoryViewModel(store: store, l10n: app.l10n, accessibility: app.accessibility,
+                                        cost: app.cost, traffic: app.traffic, model: app)
+            #expect(view.remoteHistoryStale == stale)
+            #expect(view.remoteHistoryAvailable == available)
+        }
+
+        state.apply(snapshot)
+        check(state, stale: true, available: false)
+        state.apply(history)
+        let receivedAt = state.historyReceivedAt
+        check(state, stale: false, available: true)
+        state.disconnected()
+        check(state, stale: true, available: true)
+        state.apply(snapshot)
+        state.apply(snapshot)
+        state.apply(malformedHistory)
+        #expect(state.historyReceivedAt == receivedAt)
+        check(state, stale: true, available: true)
+        state.apply(history)
+        check(state, stale: false, available: true)
+    }
