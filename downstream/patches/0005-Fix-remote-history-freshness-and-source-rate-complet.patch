@@ -154,6 +155,40 @@ TEST(CollectorProtocol, UnknownGeneratingRateIsNull) {
     EXPECT_TRUE(doc.root()["agents"].at(0)["live_total"].isNull());
     EXPECT_TRUE(doc.root()["sources"].at(0)["live_output"].isNull());
