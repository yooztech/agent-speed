+}
+
+TEST(CollectorProtocol, SourceRatesUseTheirOwnCompleteness) {
+    agentspeed::Snapshot snapshot;
+    snapshot.liveRateComplete = false;
+    agentspeed::SourceRow known;
+    known.liveOutput = 4;
+    known.liveTotal = 6;
+    known.liveEstimatedShare = 0.5;
+    agentspeed::SourceRow unknown;
+    unknown.liveRateComplete = false;
+    snapshot.sources = {known, unknown};
+    collector::Protocol protocol;
+    agentspeed::json::Document doc;
+    const auto wire = protocol.snapshot(snapshot);
+    ASSERT_TRUE(doc.parse(wire));
+    const auto root = doc.root();
+    EXPECT_TRUE(root["live_output"].isNull());
+    const auto sources = root["sources"];
+    EXPECT_EQ(sources.at(0)["live_output"].raw(), "4");
+    EXPECT_EQ(sources.at(0)["live_total"].raw(), "6");
+    EXPECT_EQ(sources.at(0)["estimated_share"].raw(), "0.5");
+    EXPECT_TRUE(sources.at(1)["live_output"].isNull());
+    EXPECT_TRUE(sources.at(1)["live_total"].isNull());
+    EXPECT_TRUE(sources.at(1)["estimated_share"].isNull());
+
+    snapshot.liveRateComplete = true;
+    agentspeed::json::Document inverse;
+    const auto inverseWire = protocol.snapshot(snapshot);
+    ASSERT_TRUE(inverse.parse(inverseWire));
+    EXPECT_TRUE(inverse.root()["sources"].at(1)["live_output"].isNull());
+    EXPECT_TRUE(inverse.root()["sources"].at(1)["live_total"].isNull());
+    EXPECT_TRUE(inverse.root()["sources"].at(1)["estimated_share"].isNull());
 }
 
