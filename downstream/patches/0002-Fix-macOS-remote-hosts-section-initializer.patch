From: yooztech <service@yooztech.com>
Date: Thu, 5 Nov 2026 15:03:10 +0800
Subject: [PATCH] Fix macOS remote hosts section initializer

---
 macos/Sources/AgentSpeed/Dashboard/RemoteHostsView.swift | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/macos/Sources/AgentSpeed/Dashboard/RemoteHostsView.swift b/macos/Sources/AgentSpeed/Dashboard/RemoteHostsView.swift
index 7cfa4c63..676db1d2 100644
--- a/macos/Sources/AgentSpeed/Dashboard/RemoteHostsView.swift
+++ b/macos/Sources/AgentSpeed/Dashboard/RemoteHostsView.swift
@@ -102,7 +102,7 @@ struct RemoteHostSettings: View {
     @State private var label = ""
     @State private var destination = ""
     var body: some View {
-        Section("Remote hosts") {
+        Section {
             ForEach(remote.hosts) { host in
                 HStack {
                     VStack(alignment: .leading) {
@@ -122,6 +122,8 @@ struct RemoteHostSettings: View {
                 remote.save(RemoteHost(label: label, destination: destination))
                 label = ""; destination = ""
             }.disabled(!RemoteHost(label: label, destination: destination).validDestination)
+        } header: {
+            Text("Remote hosts")
         } footer: {
             Text("Remote monitoring is off until enabled. SSH uses your existing configuration, trusted host keys and non-interactive authentication; no passwords are stored. Remote metrics and history remain separate from this Mac.")
         }
