     }
+
+    func waitForDelivery() async throws {
+        while true {
+            if case .reporting = report.status { return }
+            let changed = XCTestExpectation(description: "HTTP reporting status changes")
+            withObservationTracking { _ = report.status } onChange: { changed.fulfill() }
+            let result = await XCTWaiter.fulfillment(of: [changed], timeout: 60)
+            try #require(result == .completed, "report delivery did not complete")
+        }
+    }
 }
 
 /// Answers every API request with `accepted` and keeps it; discovery is not fetched in these tests.
 private final class RecordingTransport: ReportTransport, @unchecked Sendable {
     private let lock = NSLock()
     private var sent: [ReportRequest] = []
+    private let gate: ResponseGate?
+
+    init(gate: ResponseGate? = nil) { self.gate = gate }
 
     var requests: [ReportRequest] { lock.withLock { sent } }
 
@@ -262,11 +286,33 @@ private final class RecordingTransport: ReportTransport, @unchecked Sendable {
     func send(_ request: ReportRequest, maxBytes: Int, timeout: TimeInterval)
         async throws(ReportTransportError) -> ReportHTTPResponse {
         lock.withLock { sent.append(request) }
+        await gate?.wait()
         return ReportHTTPResponse(status: 200, headers: ["content-type": "application/json"],
                                   body: Data(#"{"status":"accepted"}"#.utf8))
     }
 }
 
+/// Keeps the accepted response pending until the test has inspected the request and pre-delivery status.
+private actor ResponseGate {
+    let received: XCTestExpectation
+    private var released = false
+    private var waiter: CheckedContinuation<Void, Never>?
+
+    init(received: XCTestExpectation) { self.received = received }
+
+    func wait() async {
+        received.fulfill()
+        guard !released else { return }
+        await withCheckedContinuation { waiter = $0 }
+    }
+
+    func release() {
+        released = true
+        waiter?.resume()
+        waiter = nil
+    }
+}
+
 /// Connections that never open: the session asks for one and nothing leaves the process.
 private final class SilentStreamTransport: ReportStreamTransport, @unchecked Sendable {
     private let lock = NSLock()
