+        var snapshot = SpeedSnapshot.Empty with
+        {
+            Sources =
+            [
+                Source(kind, live: 10, requests: 1, output: 10) with { HostId = first },
+                Source(kind, live: 20, requests: 1, output: 20) with { HostId = second },
+                Source(kind, available: false) with { HostId = missing, NotDetected = true, LiveAvailable = false, TodayAvailable = false },
+            ],
+            Agents =
+            [
+                Agent("first", kind, AgentPhase.Generating) with { HostId = first },
+                Agent("second", kind, AgentPhase.Generating) with { HostId = second },
+            ],
+            History = [new HistoryPoint(DateTimeOffset.UnixEpoch, Rate.Zero, Rate.Zero), new HistoryPoint(DateTimeOffset.UnixEpoch.AddSeconds(1), Rate.Zero, Rate.Zero)],
+            InstanceHistory = new Dictionary<OrbSourceInstance, IReadOnlyList<HistoryPoint>>
+            {
+                [new OrbSourceInstance(first, kind)] = [new(DateTimeOffset.UnixEpoch, new Rate(10, 10), Rate.Zero)],
+                [new OrbSourceInstance(second, kind)] = [new(DateTimeOffset.UnixEpoch, new Rate(20, 20), Rate.Zero), new(DateTimeOffset.UnixEpoch.AddSeconds(1), Rate.Zero, Rate.Zero) { IsAvailable = false }],
+            },
+        };
+
+        var reading = OrbSubset.Reading(snapshot, null, [new OrbSourceInstance(first, kind)]);
+        Assert.Equal(20, reading.Live.Output);
+        Assert.Equal(20, reading.Today.Output);
+        Assert.Single(reading.Agents);
+        Assert.Equal("second", reading.Agents[0].Id);
+        Assert.True(reading.LiveComplete);
+        Assert.True(reading.TodayComplete);
+
+        var projected = OrbSubset.Project(snapshot, null, [new OrbSourceInstance(first, kind)]);
+        Assert.Single(projected.Sources);
+        Assert.Equal(second, projected.Sources[0].HostId);
+        Assert.Equal(20, projected.Today.Output);
+        Assert.Single(projected.Agents);
+        Assert.True(projected.RemoteLiveComplete);
+        Assert.Equal(20, projected.History[0].Measured.Output);
+        Assert.True(projected.History[0].IsAvailable);
+        Assert.False(projected.History[1].IsAvailable);
+
+        var filteredHost = SpeedSnapshot.Empty with { RemoteHosts = [new RemoteHostStatus(missing, "host", false, null) { SourcesKnown = true }] };
+        var filteredReading = OrbSubset.Reading(filteredHost, null, []);
+        Assert.True(filteredReading.LiveComplete);
+        Assert.True(filteredReading.TodayComplete);
+
+        var offline = snapshot with { Sources = [snapshot.Sources[1] with { Available = false, LiveAvailable = false, TodayAvailable = false }] };
+        var unknown = OrbSubset.Reading(offline, null, []);
+        Assert.Equal(SubsetState.Available, unknown.State);
+        Assert.False(unknown.LiveComplete);
+        Assert.False(unknown.TodayComplete);
+    }
