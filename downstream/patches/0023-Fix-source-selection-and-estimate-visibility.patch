+    /// <summary>Projects a snapshot and its attributed history for an orb's associated dashboard.</summary>
+    public static SpeedSnapshot Project(SpeedSnapshot snapshot, SourceSet? sources, IReadOnlyCollection<OrbSourceInstance> exclusions)
+    {
+        ArgumentNullException.ThrowIfNull(snapshot);
+        ArgumentNullException.ThrowIfNull(exclusions);
+        if (sources is null && exclusions.Count == 0) return snapshot;
+
+        var reading = Reading(snapshot, sources, exclusions);
+        var members = (sources ?? SourceSet.Everything).Intersect(snapshot.EnabledSources);
+        var selected = snapshot.Sources.Where(s => members.Contains(s.Kind)
+            && !exclusions.Contains(new OrbSourceInstance(s.HostId, s.Kind)) && !IsUnavailable(s)).ToArray();
+        var last = snapshot.LastResponse;
+        if (last is not null && (!members.Contains(last.Source)
+            || exclusions.Contains(new OrbSourceInstance(last.HostId, last.Source)))) last = null;
+        var histories = selected.Select(s => snapshot.InstanceHistory.TryGetValue(new OrbSourceInstance(s.HostId, s.Kind), out var points)
+            ? points.ToDictionary(point => point.Time) : null).ToArray();
+        var unknownHost = snapshot.RemoteHosts.Any(host => !host.Online && !host.SourcesKnown
+            && members.Any(kind => !exclusions.Contains(new OrbSourceInstance(host.Id, kind))));
+        var history = snapshot.History.Select(point =>
+        {
+            double measuredOutput = 0, measuredTotal = 0, estimatedOutput = 0, estimatedTotal = 0;
+            var complete = !unknownHost;
+            foreach (var series in histories)
+            {
+                if (series is null || !series.TryGetValue(point.Time, out var part) || !part.IsAvailable)
+                {
+                    complete = false;
+                    continue;
+                }
+                measuredOutput += part.Measured.Output;
+                measuredTotal += part.Measured.Total;
+                estimatedOutput += part.Estimated.Output;
+                estimatedTotal += part.Estimated.Total;
+            }
+            return new HistoryPoint(point.Time, new Rate(measuredOutput, measuredTotal), new Rate(estimatedOutput, estimatedTotal)) { IsAvailable = complete };
+        }).ToArray();
+        var localMembers = SourceSet.Empty;
+        foreach (var kind in members)
+            if (!exclusions.Contains(new OrbSourceInstance(null, kind))) localMembers = localMembers.With(kind);
+        var hasPeak = snapshot.RemoteHosts.Count == 0 && snapshot.SubsetPeaks.TryGetValue(localMembers, out _);
+        var subsetPeak = hasPeak ? snapshot.SubsetPeaks[localMembers] : 0;
+        return snapshot with
+        {
+            Live = reading.Live,
+            LiveEstimatedShare = reading.EstimatedShare,
+            Today = reading.Today,
+            Sources = selected,
+            Agents = reading.Agents,
+            GeneratingCount = reading.Agents.Count(a => a.Phase == AgentPhase.Generating),
+            ToolsCount = reading.Agents.Count(a => a.Phase == AgentPhase.Tools),
+            PeakToday = new Rate(subsetPeak, 0),
+            PeakTodayOutputAvailable = hasPeak,
+            PeakTodayTotalAvailable = false,
+            PeakTodayAt = null,
+            AverageToday = null,
+            LastResponse = last,
+            History = history,
+            RemoteLiveComplete = reading.LiveComplete,
+            RemoteTodayComplete = reading.TodayComplete,
+        };
+    }
+
     /// <summary>
     /// The money-unit reading of <paramref name="sources"/> (null = every source) counting only
     /// <paramref name="billable"/> sources (METRICS 9.4, 9.5).
@@ -246,7 +309,9 @@ public static class OrbSubset
     public static bool IsUnavailable(SourceStatus status)
