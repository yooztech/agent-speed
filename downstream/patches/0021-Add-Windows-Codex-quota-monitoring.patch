+    public void FinalOutlinedGripHasModerateClearanceFromActualPaintedCurve(string edge) => OnSta(() =>
+    {
+        bool flat = edge is "top" or "bottom";
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(flat, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var body = Geometry.Parse(main.BodyPath).GetFlattenedPathGeometry(.001, ToleranceType.Absolute);
+        foreach (double hover in new[] { 0d, 1d, 1.2 })
+        {
+            double gap = double.PositiveInfinity;
+            for (int i = 0; i < 6; i++)
+            {
+                var dot = QuotaNotchGeometry.GetGripDot(main, new(1, hover), i);
+                var center = new Point(dot.Center.X, dot.Center.Y);
+                foreach (var figure in body.Figures)
+                {
+                    var previous = figure.StartPoint;
+                    foreach (var segment in figure.Segments)
+                    {
+                        IEnumerable<Point> points = segment is PolyLineSegment poly ? poly.Points :
+                            segment is LineSegment line ? new[] { line.Point } : Array.Empty<Point>();
+                        foreach (var point in points)
+                        {
+                            gap = Math.Min(gap, SegmentDistance(center, previous, point) - dot.Radius - 1);
+                            previous = point;
+                        }
+                    }
+                    gap = Math.Min(gap, SegmentDistance(center, previous, figure.StartPoint) - dot.Radius - 1);
+                }
+            }
+            Assert.Equal(QuotaNotchGeometry.GripPaintClearance(main) - QuotaNotchGeometry.GripDot / 2 * .3 * hover, gap, 2);
