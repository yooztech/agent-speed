+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchGripMotionTests
+{
+    [Fact]
+    public void ExpandedRestRevealsArcWithoutHoverAndThenStopsSampling()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, false, false, false, 0, false);
+        Assert.True(motion.Active);
+        bool emerged = false;
+        for (int time = 1; time < 10000 && motion.Active; time += 10)
+        {
+            var frame = motion.Sample(time);
+            emerged |= frame.Arc > 0 && frame.Arc < 1;
+        }
+        Assert.True(emerged);
+        Assert.Equal(new QuotaNotchGeometry.GripFrame(Arc: 1), motion.Frame);
+        Assert.False(motion.Active);
+        Assert.Equal(motion.Frame, motion.Sample(10000));
+    }
+
+    [Fact]
+    public void HoverMorphsArcToDiscBeforeDropsDivideInTheSamePocket()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, false, false, false, 0, true);
+        motion.SetTargets(true, true, false, false, 10, false);
+        Assert.Equal(0, motion.Sample(230).Reveal);
+        Assert.Equal(1, motion.Frame.Disc);
+        Assert.Equal(0, motion.Sample(250).Reveal);
+        var middle = motion.Sample(460);
+        Assert.InRange(middle.Reveal, .60, .80);
+        Assert.InRange(middle.Disc, 0, .1);
+        var end = motion.Sample(670);
+        Assert.Equal(new QuotaNotchGeometry.GripFrame(1, Arc: 1), end);
+        Assert.False(motion.Active);
+    }
+
+    [Fact]
+    public void HoverSpringsAndDragSqueezesWithoutMovingPressedDropOrEntry()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, true, false, false, 0, true);
+        motion.SetTargets(true, true, true, false, 10, false);
+        Assert.InRange(motion.Sample(120).Hover, 1, 1.3);
+        motion.Sample(1000);
+        Assert.False(motion.Active);
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var pose = motion.Frame;
+        motion.SetTargets(true, true, true, true, 1010, false);
+        Assert.Equal(pose.Reveal, motion.Frame.Reveal);
+        var held = motion.Sample(2010);
+        Assert.False(motion.Active);
+        Assert.Equal(1, held.Squeeze);
+        Assert.Equal(QuotaNotchGeometry.CreateGrip(main, pose).Center, QuotaNotchGeometry.CreateGrip(main, held).Center);
+        Assert.Equal(QuotaNotchGeometry.CreateOrbEntry(main, pose), QuotaNotchGeometry.CreateOrbEntry(main, held));
+        Assert.True(QuotaNotchGeometry.GetGripDot(main, held, 0).Radius < QuotaNotchGeometry.GetGripDot(main, pose, 0).Radius);
+        motion.SetTargets(true, true, true, false, 2020, false);
+        Assert.Equal(0, motion.Sample(3020).Squeeze);
+        Assert.False(motion.Active);
+    }
+
+    [Fact]
+    public void DropsReturnBeforeDiscRollsBackIntoPersistentArc()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, true, false, false, 0, true);
+        motion.SetTargets(true, false, false, false, 100, false);
+        Assert.InRange(motion.Sample(200).Reveal, .5, .8);
+        var absorbed = motion.Sample(300);
+        Assert.Equal(0, absorbed.Reveal);
+        Assert.Equal(1, absorbed.Disc);
+        Assert.Equal(1, motion.Sample(400).Disc);
+        Assert.Equal(new QuotaNotchGeometry.GripFrame(Arc: 1), motion.Sample(800));
+        Assert.False(motion.Active);
+        motion.SetTargets(false, false, false, false, 900, false);
+        Assert.True(motion.Sample(1000).Quick);
+        Assert.Equal(default, motion.Sample(1160));
+        Assert.False(motion.Active);
+    }
+
+    [Fact]
+    public void ReducedMotionSettlesEveryChannelButCannotJumpHeldDrop()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, false, false, false, 0, true);
+        Assert.Equal(new QuotaNotchGeometry.GripFrame(Arc: 1), motion.Frame);
+        motion.SetTargets(true, true, true, true, 100, true);
+        Assert.Equal(0, motion.Frame.Reveal);
+        Assert.Equal(1, motion.Frame.Squeeze);
+        Assert.False(motion.Active);
+        motion.SetTargets(true, true, true, false, 200, true);
+        Assert.Equal(new QuotaNotchGeometry.GripFrame(1, 1, 0, 1), motion.Frame);
+        motion.Reset();
+        Assert.Equal(default, motion.Frame);
+        Assert.False(motion.Active);
+    }
+
+    [Fact]
+    public void PressDuringDivisionFreezesPaintedPositionBeforeFurtherTimeSampling()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, false, false, false, 0, true);
+        motion.SetTargets(true, true, false, false, 10, false);
+        var painted = motion.Sample(380);
+        motion.SetTargets(true, true, true, true, 420, false);
+        Assert.Equal(painted.Reveal, motion.Frame.Reveal);
+        Assert.Equal(painted.Disc, motion.Frame.Disc);
+        Assert.Equal(painted.Reveal, motion.Sample(1200).Reveal);
+        motion.SetTargets(true, true, true, false, 1210, false);
+        Assert.Equal(1, motion.Sample(2000).Reveal);
+        Assert.False(motion.Active);
+    }
+
+    [Fact]
+    public void EnteringEmergingArcRetainsExactPaintedSourceUntilFamilyReturnCompletes()
+    {
+        var motion = new QuotaNotchGripMotion();
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        motion.SetTargets(true, false, false, false, 0, false);
+        var painted = motion.Sample(815);
+        var touchedSource = QuotaNotchGeometry.CreateOrb(main, painted);
+        Assert.True(touchedSource.Liquid);
+        motion.SetTargets(true, true, false, false, 900, false);
+        Assert.Equal(painted.Arc, motion.Frame.EntryArc);
+        Assert.Equal(touchedSource, QuotaNotchGeometry.CreateOrbCarry(main, motion.Frame));
+        motion.Sample(2000);
+        Assert.Equal(1, motion.Frame.Arc);
+        Assert.Equal(1, motion.Frame.Reveal);
+        Assert.Equal(0, motion.Frame.Disc);
+        Assert.Equal(touchedSource, QuotaNotchGeometry.CreateOrbCarry(main, motion.Frame));
+        Assert.False(motion.Active);
+        motion.SetTargets(true, false, false, false, 2100, false);
+        Assert.Equal(touchedSource, QuotaNotchGeometry.CreateOrbCarry(main, motion.Sample(2300)));
+        Assert.Equal(0, motion.Sample(2800).EntryArc);
+        Assert.Equal(default, QuotaNotchGeometry.CreateOrbCarry(main, motion.Frame));
+    }
+
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void StationaryPaintEdgeRetainsIntentUntilPhysicalDeparture(string edge)
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(edge is "top" or "bottom", new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var canvas = QuotaNotchGeometry.CreateEnvelope(new QuotaNotchGeometry.ContentLayout(edge is "top" or "bottom", new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var transform = QuotaNotchGeometry.EdgeTransform(edge, canvas.Depth, canvas.Offset(main));
+        var motion = new QuotaNotchGripMotion();
+        var intent = new QuotaNotchGripIntent();
+        var dot = QuotaNotchGeometry.GetGripDot(main, new(1, 1), 5);
+        var local = new QuotaNotchGeometry.Point(dot.Center.X + dot.Radius, dot.Center.Y);
+        var pointer = transform.Apply(local);
+        var hit = QuotaNotchGeometry.GetGripHitBox(main, new(1, 1.3));
+        bool Contains(QuotaNotchGeometry.Point p) => p.X >= hit.X && p.X <= hit.X + hit.Width &&
+            p.Y >= hit.Y && p.Y <= hit.Y + hit.Height;
+        Assert.True(Contains(local));
+        Assert.False(intent.Update(transform.Apply(new(-20, -20)), false, false));
+        Assert.True(intent.Update(pointer, true, Contains(local)));
+        motion.SetTargets(true, true, true, false, 0, true);
+        motion.SetTargets(true, true, false, false, 1, false);
+        bool paintDeparted = false;
+        for (int time = 2; time < 1000; time++)
+        {
+            var frame = motion.Sample(time);
+            var current = QuotaNotchGeometry.GetGripDot(main, frame, 5);
+            double dx = local.X - current.Center.X, dy = local.Y - current.Center.Y;
+            bool entry = dx * dx + dy * dy <= current.Radius * current.Radius;
+            paintDeparted |= !entry;
+            Assert.True(intent.Update(pointer, entry, Contains(local)));
+        }
+        Assert.True(paintDeparted, "The stationary painted edge must outlive shrinking hover paint.");
+        var departed = transform.Apply(new(hit.X + hit.Width + 10, hit.Y));
+        Assert.False(intent.Update(departed, false, false));
+        for (int i = 0; i < 100; i++) Assert.False(intent.Update(departed, true, true));
+        Assert.True(intent.Update(pointer, true, Contains(local)));
+        Assert.True(intent.Update(departed, false, false, held: true));
+        Assert.False(intent.Update(departed, false, false));
+        intent.Reset();
+        Assert.False(intent.Acquired);
+    }
+
+    [Fact]
+    public void DiscBurstReversalAndPressPreserveThePaintedPose()
+    {
+        var motion = new QuotaNotchGripMotion();
+        motion.SetTargets(true, false, false, false, 0, true);
+        motion.SetTargets(true, true, false, false, 1000, false);
+        var opening = motion.Sample(1400);
+        Assert.InRange(opening.Reveal, .01, .99);
+        motion.SetTargets(true, false, false, false, 1400, false);
+        Assert.Equal(opening, motion.Frame);
+        var returning = motion.Sample(1430);
+        Assert.True(returning.Reveal < opening.Reveal);
+        motion.SetTargets(true, true, false, false, 1430, false);
+        Assert.Equal(returning, motion.Frame);
+        var painted = motion.Sample(1480);
+        Assert.True(painted.Reveal > returning.Reveal);
+        motion.SetTargets(true, true, true, true, 1500, false);
+        Assert.Equal(painted.Reveal, motion.Frame.Reveal);
+        Assert.Equal(painted.Disc, motion.Frame.Disc);
+        var held = motion.Sample(10000);
+        Assert.Equal(painted.Reveal, held.Reveal);
+        Assert.Equal(painted.Disc, held.Disc);
+        motion.SetTargets(true, true, true, false, 11000, false);
+        var end = motion.Sample(20000);
+        Assert.Equal(1, end.Reveal);
+        Assert.Equal(0, end.Disc);
+        Assert.False(motion.Active);
+    }
+}
