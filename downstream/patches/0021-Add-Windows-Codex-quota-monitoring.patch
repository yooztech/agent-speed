+using System.Numerics;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchFilterParityTests
+{
+    [Theory]
+    [InlineData(1, 1, 0, .25)]
+    [InlineData(1, 17, .65, 1.5)]
+    [InlineData(19, 1, 1, 2)]
+    [InlineData(3, 19, 5, 4)]
+    [InlineData(17, 3, .4, .75)]
+    [InlineData(7, 11, 0, 1.25)]
+    [InlineData(37, 29, 0, 2.5)]
+    [InlineData(37, 29, .65, 1.25)]
+    [InlineData(53, 31, 1.1, 1.5)]
+    [InlineData(69, 37, 1.35, 2.25)]
+    [InlineData(137, 41, 5, 4)]
+    public void AlphaAndSquareErosionExactlyMatchScalarReference(int width, int height, double sigma, double dpi)
+    {
+        var scratch = new QuotaNotchFilterScratch();
+        for (int pattern = 0; pattern < 4; pattern++)
+            AssertParity(width, height, sigma, dpi, MakeSource(width, height, pattern), scratch);
+    }
+
+    [Fact]
+    public void OddWidthsBeyondSimdLanesKeepScalarEdgesAndRemaindersExact()
+    {
+        int lanes = Vector<float>.Count;
+        var scratch = new QuotaNotchFilterScratch();
+        foreach (int width in new[] { lanes - 1, lanes + 1, 2 * lanes + 13, 4 * lanes + 17 })
+            for (int pattern = 0; pattern < 4; pattern++)
+                AssertParity(width, 27, .65, 1.5, MakeSource(width, 27, pattern), scratch);
+    }
+
+    [Fact]
+    public void ZeroSigmaPreservesHoleAndErasesNarrowBridgeAndBoundary()
+    {
+        const int width = 47, height = 31;
+        var source = new byte[width * height];
+        // Two solid regions joined by a one-pixel bridge; the left one has a hole.
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+                if (x <= 18 || x >= 28 || y == 15) source[y * width + x] = 255;
+        source[15 * width + 9] = 0;
+        var outer = new byte[source.Length];
+        var inner = new byte[source.Length];
+        QuotaNotchGeometryFilter.Apply(width, height, 0, 1.25, source, outer, inner, new());
+        var expected = Reference(width, height, 0, 1.25, source);
+        Assert.Equal(expected.Outer, outer);
+        Assert.Equal(expected.Inner, inner);
+        Assert.Equal((byte)255, outer[15 * width + 23]);
+        Assert.Equal((byte)0, inner[15 * width + 23]);
+        Assert.Equal((byte)0, outer[15 * width + 9]);
+        Assert.Equal((byte)0, inner[15 * width + 10]);
+        Assert.Equal((byte)255, inner[8 * width + 8]);
+        Assert.Equal((byte)255, outer[8 * width]);
+        Assert.Equal((byte)0, inner[8 * width]);
+    }
+
+    [Theory]
+    [InlineData(0, 0, 900)]
+    [InlineData(0, 900, 0)]
+    [InlineData(0, 0, 0)]
+    [InlineData(0, 4, 1710)]
+    [InlineData(0, 1710, 7)]
+    [InlineData(1710, 0, 4)]
+    [InlineData(1710, 4, 0)]
+    [InlineData(5, 11, 19)]
+    public void AliasedAndPartiallyOverlappingSpansKeepReferenceWriteOrder(int sourceOffset, int outerOffset, int innerOffset)
+    {
+        const int width = 37, height = 23, count = width * height;
+        var scratch = new QuotaNotchFilterScratch();
+        foreach (double sigma in new[] { 0, .65 })
+        {
+            var source = MakeSource(width, height, 2);
+            var reference = Reference(width, height, sigma, 1.5, source);
+            var backing = new byte[Math.Max(sourceOffset, Math.Max(outerOffset, innerOffset)) + count + 5];
+            Array.Fill(backing, (byte)73);
+            source.CopyTo(backing, sourceOffset);
+            var expected = (byte[])backing.Clone();
+            reference.Outer.CopyTo(expected, outerOffset);
+            reference.Inner.CopyTo(expected, innerOffset);
+
+            QuotaNotchGeometryFilter.Apply(width, height, sigma, 1.5,
+                backing.AsSpan(sourceOffset, count), backing.AsSpan(outerOffset, count),
+                backing.AsSpan(innerOffset, count), scratch);
+
+            Assert.Equal(expected, backing);
+        }
+    }
+
+    [Fact]
+    public void ReusedScratchHandlesGrowthShrinkAndKernelChangesWithoutStaleAlpha()
+    {
+        var scratch = new QuotaNotchFilterScratch();
+        foreach (var (width, height, sigma, dpi) in new[]
+        {
+            (37, 23, .5, 1.0), (73, 39, 1.25, 2.0), (1, 3, 0.0, .25),
+            (23, 9, 5.0, 4.0), (73, 39, 0.0, 1.5), (37, 23, .5, 1.0)
+        })
+            for (int pattern = 0; pattern < 4; pattern++)
+                AssertParity(width, height, sigma, dpi, MakeSource(width, height, pattern), scratch);
+    }
+
+    private static void AssertParity(int width, int height, double sigma, double dpi, byte[] source,
+        QuotaNotchFilterScratch scratch)
+    {
+        var expected = Reference(width, height, sigma, dpi, source);
+        int count = width * height;
+        var outer = new byte[count + 3];
+        var inner = new byte[count + 3];
+        Array.Fill(outer, (byte)41);
+        Array.Fill(inner, (byte)79);
+        QuotaNotchGeometryFilter.Apply(width, height, sigma, dpi, source, outer, inner, scratch);
+        // Exact bytes, including the antialiased contour: no one-alpha tolerance.
+        Assert.Equal(expected.Outer, outer[..count]);
+        Assert.Equal(expected.Inner, inner[..count]);
+        Assert.All(outer[count..], value => Assert.Equal((byte)41, value));
+        Assert.All(inner[count..], value => Assert.Equal((byte)79, value));
+    }
+
+    private static byte[] MakeSource(int width, int height, int pattern)
+    {
+        var source = new byte[width * height];
+        uint random = 0xC0DE1234;
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+            {
+                int i = y * width + x;
+                if (pattern == 0) source[i] = 255; // Solid mask touching every zero-padded boundary.
+                else if (pattern == 1)
+                {
+                    random = unchecked(random * 1664525 + 1013904223);
+                    source[i] = (byte)(random >> 24);
+                }
+                else if (pattern == 2)
+                {
+                    bool left = x < width * 2 / 5 && y > height / 7 && y < height * 6 / 7;
+                    bool right = x > width * 3 / 5 && y > height / 5 && y < height * 4 / 5;
+                    bool bridge = Math.Abs(y - height / 2) <= 1;
+                    bool hole = Math.Abs(x - width / 5) <= 1 && Math.Abs(y - height / 2) <= 1;
+                    source[i] = hole ? (byte)0 : left || right || bridge ? (byte)255 : (byte)0;
+                }
+                else source[i] = (byte)((x * 37 + y * 19 + 119) & 255); // Fractional contour alphas and rounding ties.
+            }
+        return source;
+    }
+
+    private static (byte[] Outer, byte[] Inner) Reference(int width, int height, double sigma, double dpi, byte[] source)
+    {
+        double deviation = sigma * dpi;
+        int radius = (int)Math.Ceiling(3 * deviation);
+        int erosion = (int)Math.Ceiling(dpi);
+        var kernel = new float[2 * radius + 1];
+        if (radius == 0) kernel[0] = 1;
+        else
+        {
+            double total = 0;
+            for (int k = -radius; k <= radius; k++)
+            {
+                double weight = Math.Exp(-.5 * k * k / (deviation * deviation));
+                kernel[k + radius] = (float)weight;
+                total += weight;
+            }
+            for (int k = 0; k < kernel.Length; k++) kernel[k] = (float)(kernel[k] / total);
+        }
+
+        var horizontal = new float[source.Length];
+        var alpha = new float[source.Length];
+        var outer = new byte[source.Length];
+        var inner = new byte[source.Length];
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+            {
+                float sum = 0;
+                for (int k = -radius; k <= radius; k++)
+                    if (x + k >= 0 && x + k < width)
+                        sum += source[y * width + x + k] * kernel[k + radius];
+                horizontal[y * width + x] = sum;
+            }
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+            {
+                float sum = 0;
+                for (int k = -radius; k <= radius; k++)
+                    if (y + k >= 0 && y + k < height)
+                        sum += horizontal[(y + k) * width + x] * kernel[k + radius];
+                float value = Math.Clamp(18 * sum - 8.5f * 255, 0, 255);
+                alpha[y * width + x] = value;
+                outer[y * width + x] = (byte)Math.Round(value);
+            }
+        // Deliberately direct 2D float morphology, independent of the optimized byte passes.
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < width; x++)
+            {
+                float minimum = 255;
+                for (int yy = y - erosion; yy <= y + erosion; yy++)
+                    for (int xx = x - erosion; xx <= x + erosion; xx++)
+                    {
+                        float sample = xx < 0 || xx >= width || yy < 0 || yy >= height ? 0 : alpha[yy * width + xx];
+                        minimum = Math.Min(minimum, sample);
+                    }
+                inner[y * width + x] = (byte)Math.Round(minimum);
+            }
+        return (outer, inner);
+    }
+}
