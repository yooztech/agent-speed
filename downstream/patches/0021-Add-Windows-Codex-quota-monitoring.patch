@@ -0,0 +1,48 @@
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchLayoutTests
+{
+    [Fact]
+    public void HiddenNotchAndPlacementSurviveSettingsRoundTrip()
+    {
+        var settings = AppSettings.Default with { ShowQuotaNotch = false, QuotaNotchEdge = "bottom", QuotaNotchAlong = .2, QuotaNotchMonitor = "display-two" };
+        var restored = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(settings));
+        Assert.False(restored.ShowQuotaNotch);
+        Assert.Equal("bottom", restored.QuotaNotchEdge);
+        Assert.Equal(.2, restored.QuotaNotchAlong, 6);
+        Assert.Equal("display-two", restored.QuotaNotchMonitor);
+    }
+
+    [Fact]
+    public void InvalidPlacementIsRepaired()
+    {
+        var repaired = (AppSettings.Default with { QuotaNotchEdge = "invalid", QuotaNotchAlong = double.NaN }).Validated();
+        Assert.Equal("right", repaired.QuotaNotchEdge);
+        Assert.Equal(.5, repaired.QuotaNotchAlong);
+    }
+
+    [Theory]
+    [InlineData(1.5, 2, 1, .75)]
+    [InlineData(1.5, 1.5, .75, .75)]
+    [InlineData(2, 1.5, .75, 1)]
+    public void WebViewZoomTargetsTheMonitorScale(double scale, double dpr, double zoom, double expected) =>
+        Assert.Equal(expected, QuotaNotchLayout.TargetZoom(scale, dpr, zoom), 6);
+
+    [Theory]
+    [InlineData(0, 100, 1000, 650, 425)]
+    [InlineData(2000, 100, 1000, 650, 775)]
+    [InlineData(500, 100, 1000, 650, 500)]
+    [InlineData(0, 100, 300, 650, 250)]
+    public void CenterStaysOnWorkArea(double center, double start, double extent, double window, double expected) =>
+        Assert.Equal(expected, QuotaNotchLayout.ClampCenter(center, start, extent, window), 6);
+
+    [Theory]
+    [InlineData("left", true)]
+    [InlineData("right", true)]
+    [InlineData("top", false)]
+    [InlineData("bottom", false)]
+    public void EdgesChooseTheReferenceWindowAspect(string edge, bool vertical) =>
+        Assert.Equal(vertical, QuotaNotchLayout.Vertical(edge));
+}
