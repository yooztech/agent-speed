+        }
+        string? cardsText = snapshot.ResetCreditsAvailable is { } cards ? T("resetCards") + " " + cards.ToString(_loc.Culture) : null;
+        if (snapshot.ResetCreditsAvailable != 0 && snapshot.ResetCreditsNextExpiry is { } expiry)
