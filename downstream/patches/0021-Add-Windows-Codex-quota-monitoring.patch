@@ -0,0 +1,112 @@
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public sealed class QuotaFailureRetryTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 11, 15, 12, 0, 0, TimeSpan.Zero);
+    private static QuotaSnapshot Snapshot(QuotaStatus status = QuotaStatus.Error, DateTimeOffset? deadline = null,
+        bool waiting = false) => new("codex", "Codex", "official", status, [], null, null, null, null, null,
+            "fixture", null, deadline, waiting);
+
+    [Fact]
+    public void ProviderRetryAfterAndPersistedDeadlineAreAuthoritative()
+    {
+        var retry = new QuotaFailureRetry();
+        var cached = Snapshot();
+        var failure = Snapshot(deadline: Now.AddMinutes(40));
+        retry.Complete(cached, failure, Now, Now);
+        Assert.Equal(failure.NextAllowedAt, retry.DueAt);
+        retry.Clear();
+        retry.Complete(failure, failure, Now, Now);
+        Assert.Equal(failure.NextAllowedAt, retry.DueAt);
+    }
+
+    [Fact]
+    public void TransportFallbackIsBoundedExponentialAndSuccessResetsIt()
+    {
+        var retry = new QuotaFailureRetry();
+        var now = Now;
+        var failure = Snapshot();
+        foreach (var seconds in new[] { 5, 10, 20, 30, 30, 30 })
+        {
+            retry.Complete(failure, failure, now, now);
+            Assert.Equal(now.AddSeconds(seconds), retry.DueAt);
+            now = retry.DueAt!.Value;
+        }
+        retry.Complete(failure, Snapshot(QuotaStatus.Ok), now, now);
+        Assert.Null(retry.DueAt);
+        retry.Complete(failure, failure, now, now);
+        Assert.Equal(now.AddSeconds(5), retry.DueAt);
+    }
+
+    [Fact]
+    public void WaitingBehindExistingDeadlineDoesNotAdvanceFallbackFailureCount()
+    {
+        var retry = new QuotaFailureRetry();
+        var waiting = Snapshot(deadline: Now.AddMinutes(1));
+        for (var i = 0; i < 8; i++) retry.Complete(waiting, waiting, Now, Now);
+        Assert.Equal(waiting.NextAllowedAt, retry.DueAt);
+        retry.Complete(Snapshot(), Snapshot(), Now, Now);
+        Assert.Equal(Now.AddSeconds(5), retry.DueAt);
+    }
+
+    [Theory]
+    [InlineData(QuotaStatus.Ok)]
+    [InlineData(QuotaStatus.NeedsAuth)]
+    [InlineData(QuotaStatus.AccessDenied)]
+    [InlineData(QuotaStatus.Unsupported)]
+    public void NonTransientStatusesClearFailureRetry(QuotaStatus status)
+    {
+        var retry = new QuotaFailureRetry();
+        retry.Complete(Snapshot(), Snapshot(), Now, Now);
+        retry.Complete(Snapshot(), Snapshot(status, Now.AddSeconds(30)), Now, Now);
+        Assert.Null(retry.DueAt);
+    }
+
+    [Fact]
+    public void SuccessfulObservationFloorIsNotFailureAndExpiredDeadlineCannotSpin()
+    {
+        var retry = new QuotaFailureRetry();
+        retry.Complete(Snapshot(), Snapshot(waiting: true, deadline: Now.AddMinutes(5)), Now, Now);
+        Assert.Null(retry.DueAt);
+        retry.Complete(Snapshot(), Snapshot(deadline: Now.AddSeconds(-30)), Now, Now);
+        Assert.Equal(Now.AddSeconds(5), retry.DueAt);
+        retry.Complete(Snapshot(), Snapshot(deadline: Now.AddSeconds(-30)), Now, Now);
+        Assert.Equal(Now.AddSeconds(10), retry.DueAt);
+        retry.Clear();
+        Assert.Null(retry.DueAt);
+    }
+
+    [Fact]
+    public void ValidCachedObservationKeepsWarmFallbackAfterRepeatedErrors()
+    {
+        var retry = new QuotaFailureRetry();
+        var warm = Snapshot(QuotaStatus.Stale) with { ObservedAt = Now.AddDays(-1) };
+        var now = Now;
+        foreach (var seconds in new[] { 60, 120, 240, 480, 900, 900 })
+        {
+            retry.Complete(warm, warm, now, now);
+            Assert.Equal(now.AddSeconds(seconds), retry.DueAt);
+            now = retry.DueAt!.Value;
+        }
+        retry.Complete(warm, Snapshot(QuotaStatus.Ok) with { ObservedAt = now }, now, now);
+        Assert.Null(retry.DueAt);
+        retry.Complete(warm, warm, now, now);
+        Assert.Equal(now.AddSeconds(60), retry.DueAt);
+    }
+
+    [Fact]
+    public void SourcesHaveIndependentFailureCountsAndDeadlines()
+    {
+        var local = new QuotaFailureRetry();
+        var remote = new QuotaFailureRetry();
+        local.Complete(Snapshot(), Snapshot(), Now, Now);
+        remote.Complete(Snapshot(), Snapshot(QuotaStatus.Stale, Now.AddSeconds(130)), Now, Now);
+        Assert.Equal(Now.AddSeconds(5), local.DueAt);
+        Assert.Equal(Now.AddSeconds(130), remote.DueAt);
+        local.Clear();
+        Assert.Equal(Now.AddSeconds(130), remote.DueAt);
+    }
+}
