+
+namespace AgentSpeed.Windows.Tests;
+
+public class QuotaNotchViewTests
+{
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void ExternalGripHasOnlySmallPaintedControlAndContinuousCrossing(string edge) => OnSta(() =>
+    {
+        var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+        var view = new QuotaNotchView(loc);
+        var frame = new QuotaNotchGeometry.GripFrame(1, Arc: 1);
+        view.Update(new(Array.Empty<QuotaSnapshot>(), ["codex"], true, true, edge, 1, Grip: frame));
+        bool flat = edge is "top" or "bottom";
+        var model = QuotaNotchGeometry.CreateMain(1, view.ContentLayout);
+        var envelope = QuotaNotchGeometry.CreateEnvelope(view.ContentLayout);
+        var matrix = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(model));
+        view.Measure(view.Extent); view.Arrange(new Rect(view.Extent));
+        var bitmap = new RenderTargetBitmap((int)Math.Ceiling(view.Extent.Width), (int)Math.Ceiling(view.Extent.Height), 96, 96, PixelFormats.Pbgra32);
+        bitmap.Render(view);
+        var center = QuotaNotchGeometry.GetOrbCenter(model);
+        var bodyEntry = new QuotaNotchGeometry.Point(center.X - (QuotaNotchGeometry.Fillet + 1) * Math.Sqrt(.5),
+            center.Y - (QuotaNotchGeometry.Fillet + 1) * Math.Sqrt(.5));
+        var arc = new QuotaNotchGeometry.Point(center.X - QuotaNotchGeometry.ArcRadius * Math.Sqrt(.5),
+            center.Y - QuotaNotchGeometry.ArcRadius * Math.Sqrt(.5));
+        for (int dot = 0; dot < 6; dot++)
+        {
+            QuotaNotchGeometry.Point[] route = [bodyEntry, arc, center, QuotaNotchGeometry.GetGripDot(model, frame, dot).Center];
+            for (int segment = 0; segment < route.Length - 1; segment++)
+                for (int i = 0; i <= 24; i++)
+                {
+                    var from = route[segment]; var to = route[segment + 1];
+                    var p = matrix.Apply(new(from.X + (to.X - from.X) * i / 24,
+                        from.Y + (to.Y - from.Y) * i / 24));
+                    var point = new Point(p.X, p.Y);
+                    Assert.True(view.InputGeometry.FillContains(point));
+                    Assert.NotEqual(QuotaNotchTarget.None, view.HitTestTarget(point).Target);
+                    Assert.InRange((int)AlphaAt(bitmap, point), 1, 255);
+                }
+        }
+        var arcPaint = matrix.Apply(arc);
+        Assert.Equal(255, AlphaAt(bitmap, new Point(arcPaint.X, arcPaint.Y)));
+        var dotPaint = matrix.Apply(QuotaNotchGeometry.GetGripDot(model, frame, 1).Center);
+        Assert.Equal(QuotaNotchTarget.Grip, view.HitTestTarget(new Point(dotPaint.X, dotPaint.Y)).Target);
+        Assert.Equal(255, AlphaAt(bitmap, new Point(dotPaint.X, dotPaint.Y)));
+        // The unused pocket quadrants are desktop, not a hidden disc or envelope.
+        foreach (var clear in new[] { new QuotaNotchGeometry.Point(center.X + 20, center.Y - 12),
+            new QuotaNotchGeometry.Point(center.X, center.Y + 28) })
+        {
+            var p = matrix.Apply(clear); var point = new Point(p.X, p.Y);
+            Assert.Equal(0, AlphaAt(bitmap, point));
+            Assert.False(view.InputGeometry.FillContains(point));
+            Assert.Equal(QuotaNotchTarget.None, view.HitTestTarget(point).Target);
+        }
+    });
+
+    [Theory]
+    [InlineData("left", false)]
+    [InlineData("right", false)]
+    [InlineData("top", false)]
+    [InlineData("bottom", false)]
+    [InlineData("left", true)]
+    [InlineData("right", true)]
+    [InlineData("top", true)]
+    [InlineData("bottom", true)]
+    public void ExpandedAffordanceIsVisibleBeforeHoverAndThroughoutDiscAndDropFrames(string edge, bool dark) => OnSta(() =>
+    {
+        var view = new QuotaNotchView(new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En));
+        view.Update(new(Array.Empty<QuotaSnapshot>(), ["codex"], true, dark, edge, 1));
