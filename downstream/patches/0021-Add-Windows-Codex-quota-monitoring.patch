+using System.ComponentModel;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Interop;
+using System.Windows.Media;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Interop;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Services;
+using Microsoft.Web.WebView2.Core;
+using Microsoft.Web.WebView2.Wpf;
+
+namespace AgentSpeed.Settings;
+
+internal enum QuotaNotchFailure { RuntimeMissing, InitializationFailed }
+
+/// <summary>Transparent, nonactivating native host for the pinned Windows Codenotch renderer.</summary>
+internal sealed class QuotaNotchWindow : Window
+{
+    private readonly SettingsService _settings;
+    private readonly Localizer _loc;
+    private readonly WebView2CompositionControl _web = new() { DefaultBackgroundColor = System.Drawing.Color.Transparent };
+    private readonly DispatcherTimer _pointer;
+    private readonly DispatcherTimer _leaveGrace;
+    private readonly List<Rect> _hot = [];
+    private nint _hwnd;
+    private bool _ready, _initializing, _through, _inside, _carrying, _closed;
+    private int _dpiCorrections;
+    private string? _dpiMonitor;
+    private CodexQuotaSnapshot? _snapshot;
+    private bool _network;
+
+    public event Action? OpenSettingsRequested;
+    public event Action? RefreshRequested;
+    public event Action<bool>? AttentionChanged;
+    public event Action<QuotaNotchFailure>? InitializationFailed;
+
+    public QuotaNotchWindow(SettingsService settings, Localizer loc)
+    {
+        _settings = settings;
+        _loc = loc;
+        WindowStyle = WindowStyle.None;
+        AllowsTransparency = true;
+        Background = Brushes.Transparent;
+        ShowInTaskbar = false;
+        ShowActivated = false;
+        Focusable = false;
+        ResizeMode = ResizeMode.NoResize;
+        Topmost = true;
+        Content = _web;
+        Style = new Style(typeof(Window));
+        Width = QuotaNotchLayout.UprightWidth;
+        Height = QuotaNotchLayout.LongSide;
+        Left = -32000; Top = -32000;
+        _pointer = new DispatcherTimer(TimeSpan.FromMilliseconds(40), DispatcherPriority.Input, (_, _) => PollPointer(), Dispatcher);
+        _leaveGrace = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(250) };
+        _leaveGrace.Tick += (_, _) => { _leaveGrace.Stop(); if (!_inside && !_closed) Send("pointer_left", true); };
+        _pointer.Stop();
+        SourceInitialized += (_, _) =>
+        {
+            _hwnd = new WindowInteropHelper(this).Handle;
+            WindowEffects.AddExtendedStyle(_hwnd, WS_EX.TOOLWINDOW | WS_EX.NOACTIVATE | WS_EX.TRANSPARENT | WS_EX.LAYERED, frameChanged: false);
+            _through = true;
+            Place();
+        };
+        Loaded += async (_, _) => await InitializeAsync();
+        DpiChanged += (_, _) => Dispatcher.BeginInvoke(DispatcherPriority.Loaded, () => Place());
+        SystemParameters.StaticPropertyChanged += SystemParametersChanged;
+        Microsoft.Win32.SystemEvents.DisplaySettingsChanged += DisplaySettingsChanged;
+        IsVisibleChanged += (_, _) =>
+        {
+            if (IsVisible && _ready) _pointer.Start();
+            else if (!IsVisible)
+            {
+                _pointer.Stop();
+                _leaveGrace.Stop();
+                if (_inside) { _inside = false; Send("notch_pointer", false); Send("pointer_left", true); AttentionChanged?.Invoke(false); }
+            }
+        };
+        Closed += (_, _) =>
+        {
+            _closed = true;
+            _pointer.Stop();
+            _leaveGrace.Stop();
+            SystemParameters.StaticPropertyChanged -= SystemParametersChanged;
+            Microsoft.Win32.SystemEvents.DisplaySettingsChanged -= DisplaySettingsChanged;
+            _web.Dispose();
+        };
+    }
+
+    private void SystemParametersChanged(object? sender, PropertyChangedEventArgs e) => Dispatcher.BeginInvoke(DispatcherPriority.Loaded, () => Place());
+    private void DisplaySettingsChanged(object? sender, EventArgs e) => Dispatcher.BeginInvoke(DispatcherPriority.Loaded, () => Place());
+
+    private static string Asset(string name)
+    {
+        using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream(name) ?? throw new InvalidOperationException("Missing quota renderer resource.");
+        using var reader = new StreamReader(stream);
+        return reader.ReadToEnd();
+    }
+
+    private async Task InitializeAsync()
+    {
+        if (_ready || _initializing) return;
+        _initializing = true;
+        try
+        {
+            var localData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+            if (!Path.IsPathFullyQualified(localData)) throw new InvalidOperationException("Local application data is unavailable.");
+            var profile = Path.Combine(localData, "AgentSpeed", "WebView2", "QuotaNotch");
+            Directory.CreateDirectory(profile);
+            var environment = await CoreWebView2Environment.CreateAsync(userDataFolder: profile);
+            if (_closed) return;
+            await _web.EnsureCoreWebView2Async(environment);
+            if (_closed) return;
+            var core = _web.CoreWebView2;
+            core.Settings.AreDefaultContextMenusEnabled = false;
+            core.Settings.AreDevToolsEnabled = false;
+            core.Settings.IsStatusBarEnabled = false;
+            core.Settings.AreBrowserAcceleratorKeysEnabled = false;
+            core.NewWindowRequested += (_, e) => e.Handled = true;
+            core.NavigationStarting += (_, e) => { if (e.Uri != "about:blank") e.Cancel = true; };
+            core.WebMessageReceived += OnMessage;
+            core.NavigationCompleted += (_, e) =>
+            {
+                if (_closed) return;
+                if (!e.IsSuccess) { InitializationFailed?.Invoke(QuotaNotchFailure.InitializationFailed); Hide(); return; }
+                if (IsVisible) _pointer.Start();
+                _ready = true;
+                Send("glyphs", new { codex = new { kind = "svg", svg = Asset("AgentSpeed.QuotaCodex.svg") } });
+                Send("notch_edge", Edge());
+                Push();
+            };
+            _web.NavigateToString(Asset("AgentSpeed.QuotaNotch.html"));
+            if (IsVisible) _pointer.Start();
+        }
+        catch (WebView2RuntimeNotFoundException)
+        {
+            if (!_closed) { InitializationFailed?.Invoke(QuotaNotchFailure.RuntimeMissing); Hide(); }
+        }
+        catch (Exception)
+        {
+            if (!_closed) { InitializationFailed?.Invoke(QuotaNotchFailure.InitializationFailed); Hide(); }
+        }
+        finally { _initializing = false; }
+    }
+
+    public void Update(CodexQuotaSnapshot? snapshot, bool network)
+    {
+        _snapshot = snapshot;
+        _network = network;
+        Push();
+    }
+
+    private void Push()
+    {
+        if (!_ready) return;
+        var projection = QuotaFormat.NotchProjection(_loc, _network, _snapshot);
+        var windows = projection.Windows.Select(w => new
+        {
+            id = w.Id == _snapshot?.HeadlineId ? "primary" : w.Id,
+            label = QuotaFormat.WindowLabel(_loc, w), used = w.UsedFraction,
+            resets_at = w.ResetAt?.ToUnixTimeMilliseconds(), unknown = _loc["win.quota.unknown"]
+        }).ToArray();
+        Send("codex", new { status = projection.Status, windows, fetched_at = projection.ObservedAt?.ToUnixTimeMilliseconds() ?? 0,
+            note = projection.Note });
+        Send("state", new { sessions = Array.Empty<object>(), agg = "idle", lang_resolved = _loc.LanguageCode == "zh-Hans" ? "zh" : _loc.LanguageCode });
+    }
+
+    private void Send(string name, object value)
+    {
+        if (!_ready || _closed) return;
+        _ = _web.CoreWebView2.ExecuteScriptAsync($"window.agentQuotaSet({JsonSerializer.Serialize(name)}, {JsonSerializer.Serialize(value)});");
+    }
+
+    private string Edge() => _settings.Current.QuotaNotchEdge is "left" or "top" or "bottom" ? _settings.Current.QuotaNotchEdge : "right";
+
+    public void Place()
+    {
+        if (_hwnd == 0 || _closed) return;
+        var monitor = Monitors.All().FirstOrDefault(m => m.DeviceName == _settings.Current.QuotaNotchMonitor) ?? Monitors.Primary();
+        if (monitor is null) return;
+        if (_dpiMonitor != monitor.DeviceName) { _dpiMonitor = monitor.DeviceName; _dpiCorrections = 0; }
+        var area = monitor.WorkArea;
+        var edge = Edge();
+        var vertical = QuotaNotchLayout.Vertical(edge);
+        var scale = monitor.Scale;
+        var width = Math.Min(area.Width, (int)Math.Round((vertical ? QuotaNotchLayout.UprightWidth : QuotaNotchLayout.LongSide) * scale));
+        var height = Math.Min(area.Height, (int)Math.Round(QuotaNotchLayout.LongSide * scale));
+        var along = double.IsFinite(_settings.Current.QuotaNotchAlong) ? Math.Clamp(_settings.Current.QuotaNotchAlong, 0, 1) : .5;
+        var center = vertical
+            ? QuotaNotchLayout.ClampCenter(area.Top + area.Height * along, area.Top, area.Height, height)
+            : QuotaNotchLayout.ClampCenter(area.Left + area.Width * along, area.Left, area.Width, width);
+        int x = vertical ? (edge == "left" ? area.Left : area.Right - width) : (int)Math.Round(center - width / 2.0);
+        int y = vertical ? (int)Math.Round(center - height / 2.0) : (edge == "top" ? area.Top : area.Bottom - height);
+        User32.SetWindowPos(_hwnd, HWND.TOPMOST, x, y, width, height, SWP.NOACTIVATE);
+        Send("notch_edge", edge);
+    }
+
+    private void OnMessage(object? sender, CoreWebView2WebMessageReceivedEventArgs e)
+    {
+        if (e.Source != "about:blank") return;
+        try
+        {
+            using var doc = JsonDocument.Parse(e.WebMessageAsJson);
+            var root = doc.RootElement;
+            var action = root.GetProperty("action").GetString();
+            var args = root.GetProperty("args");
+            switch (action)
+            {
+                case "set_hot":
+                    _hot.Clear();
+                    foreach (var item in args.GetProperty("rects").EnumerateArray())
+                    {
+                        var a = item.EnumerateArray().Select(x => x.GetDouble()).ToArray();
+                        if (a.Length == 4 && a.All(double.IsFinite) && a[2] >= 0 && a[3] >= 0) _hot.Add(new Rect(a[0], a[1], a[2], a[3]));
+                    }
+                    break;
+                case "report_dpr":
+                    var dpr = args.GetProperty("dpr").GetDouble();
+                    var monitor = Monitors.All().FirstOrDefault(m => m.DeviceName == _settings.Current.QuotaNotchMonitor) ?? Monitors.Primary();
+                    if (monitor is not null && double.IsFinite(dpr) && dpr > 0 && _web.ZoomFactor > 0)
+                    {
+                        var target = QuotaNotchLayout.TargetZoom(monitor.Scale, dpr, _web.ZoomFactor);
+                        if (Math.Abs(dpr - monitor.Scale) > .02 && Math.Abs(target - _web.ZoomFactor) > .01 && target is >= .25 and <= 4 && _dpiCorrections++ < 3)
+                            _web.ZoomFactor = target;
+                    }
+                    break;
+                case "open_settings": OpenSettingsRequested?.Invoke(); break;
+                case "refresh_ring": RefreshRequested?.Invoke(); break;
+                case "begin_carry": _carrying = true; break;
+                case "show_notch_menu": ShowMenu(); break;
+            }
+        }
+        catch (Exception ex) when (ex is JsonException or InvalidOperationException or KeyNotFoundException or ArgumentException) { }
+    }
+
+    private void ShowMenu()
+    {
+        var menu = new ContextMenu();
+        var settings = new MenuItem { Header = _loc["win.quota.open"] };
+        settings.Click += (_, _) => OpenSettingsRequested?.Invoke();
+        var hide = new MenuItem { Header = _loc["win.quota.hideNotch"] };
+        hide.Click += (_, _) => _settings.Update(s => s with { ShowQuotaNotch = false });
+        menu.Items.Add(settings); menu.Items.Add(hide); menu.IsOpen = true;
+    }
+
+    private void PollPointer()
+    {
+        if (_hwnd == 0 || !User32.GetCursorPos(out var p) || !User32.GetWindowRect(_hwnd, out var r)) return;
+        if (_carrying)
+        {
+            if ((GetAsyncKeyState(1) & 0x8000) == 0) { _carrying = false; Send("drag_end", true); return; }
+            var monitor = Monitors.FromPoint(p);
+            if (monitor is null) return;
+            var a = monitor.WorkArea;
+            var distances = new[] { ("left", Math.Abs(p.X - a.Left)), ("right", Math.Abs(p.X - a.Right)), ("top", Math.Abs(p.Y - a.Top)), ("bottom", Math.Abs(p.Y - a.Bottom)) };
+            var edge = distances.MinBy(x => x.Item2).Item1;
+            var along = QuotaNotchLayout.Vertical(edge) ? (p.Y - a.Top) / (double)a.Height : (p.X - a.Left) / (double)a.Width;
+            _settings.Update(s => s with { QuotaNotchEdge = edge, QuotaNotchAlong = Math.Clamp(along, 0, 1), QuotaNotchMonitor = monitor.DeviceName });
+            Place(); return;
+        }
+        var point = new Point(p.X - r.Left, p.Y - r.Top);
+        var hit = _hot.Any(rect => rect.Contains(point));
+        if (hit != _inside)
+        {
+            _inside = hit;
+            Send("notch_pointer", hit);
+            _leaveGrace.Stop();
+            if (!hit) _leaveGrace.Start();
+            AttentionChanged?.Invoke(hit);
+        }
+        if (_through == hit)
+        {
+            _through = !hit;
+            if (_through) WindowEffects.AddExtendedStyle(_hwnd, WS_EX.TRANSPARENT | WS_EX.LAYERED, frameChanged: false);
+            else WindowEffects.AddExtendedStyle(_hwnd, 0, WS_EX.TRANSPARENT, frameChanged: false);
+        }
+    }
+
+    [DllImport("user32.dll")]
+    private static extern short GetAsyncKeyState(int key);
+}
