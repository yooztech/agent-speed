@@ -0,0 +1,63 @@
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Threading;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Settings;
+
+namespace AgentSpeed.Windows.Tests;
+
+public sealed class QuotaDisplayClockTests
+{
+    [Fact]
+    public void ClockRunsOnlyForLoadedVisibleDisplayAndCannotRestartAfterDisposal()
+    {
+        Exception? failure = null;
+        var thread = new Thread(() =>
+        {
+            var display = new Border();
+            var window = new Window { Content = display, Width = 1, Height = 1, ShowInTaskbar = false };
+            try
+            {
+                var observed = new DateTimeOffset(2026, 11, 15, 12, 0, 0, TimeSpan.Zero);
+                var now = observed.AddSeconds(59);
+                using var clock = new QuotaDisplayClock(display, () => { },
+                    () => QuotaFormat.ObservationAgeRefreshDelay(observed, now));
+                void FlushLoaded() => window.Dispatcher.Invoke(() => { }, DispatcherPriority.ApplicationIdle);
+                Assert.False(clock.IsActive);
+                window.Show();
+                FlushLoaded();
+                Assert.True(display.IsLoaded);
+                Assert.True(clock.IsActive);
+                Assert.Equal(TimeSpan.FromSeconds(1), clock.NextTickDelay);
+                window.Hide();
+                Assert.False(clock.IsActive);
+                now = observed.AddSeconds(119);
+                window.Show();
+                FlushLoaded();
+                Assert.True(clock.IsActive);
+                Assert.Equal(TimeSpan.FromSeconds(1), clock.NextTickDelay);
+                observed = now;
+                clock.Reschedule();
+                Assert.Equal(TimeSpan.FromMinutes(1), clock.NextTickDelay);
+                window.Content = null;
+                FlushLoaded();
+                Assert.False(clock.IsActive);
+                window.Content = display;
+                FlushLoaded();
+                Assert.True(clock.IsActive);
+                clock.Dispose();
+                Assert.False(clock.IsActive);
+                window.Hide();
+                window.Show();
+                FlushLoaded();
+                Assert.False(clock.IsActive);
+            }
+            catch (Exception ex) { failure = ex; }
+            finally { window.Close(); }
+        });
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start();
+        thread.Join();
+        if (failure is not null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+    }
+}
