diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaFailureRetry.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaFailureRetry.cs
new file mode 100644
index 0000000000000000000000000000000000000000..323817ba3a9fffbd57452c84881ac36273f92f7b
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaFailureRetry.cs
@@ -0,0 +1,42 @@
+using AgentSpeed.Core;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Per-reader failure pacing, separate from the provider's persisted request policy.</summary>
+public sealed class QuotaFailureRetry
+{
+    public DateTimeOffset? DueAt { get; private set; }
+    private int _failures;
+
+    public void Clear()
+    {
+        DueAt = null;
+        _failures = 0;
+    }
+
+    public void Complete(QuotaSnapshot before, QuotaSnapshot result, DateTimeOffset startedAt, DateTimeOffset now)
+    {
+        if (result.Status is not (QuotaStatus.Error or QuotaStatus.Stale) || result.WaitingForRefresh)
+        {
+            Clear();
+            return;
+        }
+        // A refresh may return behind a persisted floor. Wake at that authoritative
+        // deadline without counting a second failure; cache hydration never calls this.
+        if (!(before.NextAllowedAt is { } next && next > startedAt && result.NextAllowedAt == next))
+            _failures = Math.Min(_failures + 1, 5);
+        var cold = result.ObservedAt is null;
+        var seconds = cold ? Math.Min(5 * (1 << Math.Max(0, _failures - 1)), 30)
+            : Math.Min(60 * (1 << Math.Max(0, _failures - 1)), 900);
+        DueAt = result.NextAllowedAt is { } deadline && deadline > now
+            ? deadline : now.AddSeconds(seconds);
+    }
+}
+
+/// <summary>One-shot, source-keyed wakeups. Callbacks run on the controller's owning thread.</summary>
+public interface IQuotaRetryScheduler
+{
+    void Schedule(string sourceId, TimeSpan delay, Action retry);
+    void Cancel(string sourceId);
+    void Clear();
+}
