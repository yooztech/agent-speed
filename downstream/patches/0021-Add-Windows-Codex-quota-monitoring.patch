index 0000000000000000000000000000000000000000..13d3dadf6b30b0731d7aae6421ff44175ec068a7
--- /dev/null
+++ b/windows/src/AgentSpeed/Settings/QuotaNotchRegion.cs
@@ -0,0 +1,118 @@
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Windows;
+using System.Windows.Media;
+
+namespace AgentSpeed.Settings;
+
+/// <summary>Clips a borderless HWND to the renderer's filled geometry, not its rectangular extent.</summary>
+internal sealed class QuotaNotchRegion : IDisposable
+{
+    private Geometry? _geometry;
+    private Matrix _device;
+    private NativePoint[]? _points;
+    private int[]? _counts;
+    private int _fillMode;
+    private bool _disposed;
+
+    public int Updates { get; private set; }
+    public int Vertices => _points?.Length ?? 0;
+    public int Contours => _counts?.Length ?? 0;
+
+    public void Apply(nint hwnd, Geometry geometry, Matrix device)
+    {
+        ObjectDisposedException.ThrowIf(_disposed, this);
+        if (ReferenceEquals(_geometry, geometry) && _device == device) return;
+
+        // Flatten in DIPs at a subpixel tolerance, then apply BOTH the path's transform
+        // and WPF's actual HWND DPI transform. All contours go into one region call:
+        // combining individual polygons with OR would incorrectly fill arc/ring holes.
+        var scale = Math.Max(Math.Abs(device.M11), Math.Abs(device.M22));
+        var path = geometry.GetFlattenedPathGeometry(.2 / Math.Max(1, scale), ToleranceType.Absolute);
+        var transform = path.Transform?.Value ?? Matrix.Identity;
+        transform.Append(device);
+        var points = new List<NativePoint>();
+        var counts = new List<int>();
+        foreach (var figure in path.Figures)
+        {
+            if (!figure.IsFilled) continue;
+            var start = points.Count;
+            Add(figure.StartPoint);
+            foreach (var segment in figure.Segments)
+            {
+                if (segment is PolyLineSegment lines)
+                    foreach (var point in lines.Points) Add(point);
+                else if (segment is LineSegment line) Add(line.Point);
+                else throw new InvalidOperationException();
+            }
+            // A filled WPF figure is implicitly closed even if IsClosed is false.
+            if (points.Count - start >= 3) counts.Add(points.Count - start);
+            else points.RemoveRange(start, points.Count - start);
+        }
+
+        var vertices = points.ToArray();
+        var contours = counts.ToArray();
+        var fillMode = path.FillRule == FillRule.EvenOdd ? 1 : 2; // ALTERNATE / WINDING
+        if (_fillMode == fillMode && _points is not null && _counts is not null &&
+            vertices.AsSpan().SequenceEqual(_points) && contours.AsSpan().SequenceEqual(_counts))
+        {
+            _geometry = geometry;
+            _device = device;
+            return;
+        }
+
+        nint region = contours.Length == 0
+            ? CreateRectRgn(0, 0, 0, 0)
+            : CreatePolyPolygonRgn(vertices, contours, contours.Length, fillMode);
+        if (region == 0) throw new Win32Exception(Marshal.GetLastPInvokeError());
+        try
+        {
+            if (SetWindowRgn(hwnd, region, true) == 0)
+                throw new Win32Exception(Marshal.GetLastPInvokeError());
+            // SetWindowRgn transfers ownership on success; Windows frees/replaces it.
+            region = 0;
+            _geometry = geometry;
+            _device = device;
+            _points = vertices;
+            _counts = contours;
+            _fillMode = fillMode;
+            Updates++;
+        }
+        finally
+        {
+            // Includes failed SetWindowRgn and any exception before ownership transfer.
+            if (region != 0) DeleteObject(region);
+        }
+
+        void Add(Point point)
+        {
+            point = transform.Transform(point);
+            points.Add(new NativePoint(checked((int)Math.Round(point.X)), checked((int)Math.Round(point.Y))));
+        }
+    }
+
+    public void Dispose()
+    {
+        _disposed = true;
+        _geometry = null;
+        _points = null;
+        _counts = null;
+        // No HRGN is retained: every successful handle belongs to its HWND.
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private readonly record struct NativePoint(int X, int Y);
+
+    [DllImport("gdi32.dll", SetLastError = true)]
+    private static extern nint CreateRectRgn(int left, int top, int right, int bottom);
+
+    [DllImport("gdi32.dll", SetLastError = true)]
+    private static extern nint CreatePolyPolygonRgn([In] NativePoint[] points, [In] int[] counts, int polygons, int fillMode);
+
+    [DllImport("user32.dll", SetLastError = true)]
+    private static extern int SetWindowRgn(nint hwnd, nint region, [MarshalAs(UnmanagedType.Bool)] bool redraw);
+
+    [DllImport("gdi32.dll")]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool DeleteObject(nint handle);
+}
