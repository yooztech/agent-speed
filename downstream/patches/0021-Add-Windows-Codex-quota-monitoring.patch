+
+    [Fact]
+    public void EnabledSourceWithoutReadingHasARealCardAndClampedTail() => OnSta(() =>
+    {
+        var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+        var view = new QuotaNotchView(loc, card: true);
+        view.Update(new(Array.Empty<QuotaSnapshot>(), ["codex"], true, true, "right", 1, "codex", -500));
+        Assert.True(view.HasCard);
+        Assert.Equal(QuotaNotchTarget.Tail, view.HitTestTarget(new Point(view.CardTip.X - 4, view.CardTip.Y)).Target);
+        Assert.False(view.InputGeometry.FillContains(new Point(0, 0)));
+    });
+
+    [Fact]
+    public void ResetCopyRoundsMinutesBeforeChoosingTheTimeFormat()
+    {
+        OnSta(() =>
+        {
+            var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+            var view = new QuotaNotchView(loc);
+            var now = DateTimeOffset.Now;
+            Assert.Equal("Resetting…", view.ResetText(now, now));
+            Assert.Equal("Resets in 1 min", view.ResetText(now.AddSeconds(20), now));
+            Assert.Equal("Resets in 59 min", view.ResetText(now.AddMinutes(59).AddSeconds(20), now));
