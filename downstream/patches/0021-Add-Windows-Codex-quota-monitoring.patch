+using AgentSpeed.Presentation.Layout;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchLayoutTests
+{
+    [Fact]
+    public void FloatingPanelDefaultsToVisibleHoverCollapsedAtTheRightEdge()
+    {
+        var settings = AppSettings.Default;
+        Assert.True(settings.ShowQuotaNotch);
+        Assert.False(settings.KeepQuotaNotchExpanded);
+        Assert.Equal("right", settings.QuotaNotchEdge);
+        Assert.Equal(.5, settings.QuotaNotchAlong);
+        Assert.Null(settings.QuotaNotchMonitor);
+    }
+
+    [Fact]
+    public void HiddenNotchAndPlacementSurviveSettingsRoundTrip()
+    {
+        var settings = AppSettings.Default with { ShowQuotaNotch = false, QuotaNotchEdge = "bottom", QuotaNotchAlong = .2, QuotaNotchMonitor = "display-two" };
+        var restored = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(settings));
+        Assert.False(restored.ShowQuotaNotch);
+        Assert.Equal("bottom", restored.QuotaNotchEdge);
+        Assert.Equal(.2, restored.QuotaNotchAlong, 6);
+        Assert.Equal("display-two", restored.QuotaNotchMonitor);
+    }
+
+    [Fact]
+    public void InvalidPlacementIsRepaired()
+    {
+        var repaired = (AppSettings.Default with { QuotaNotchEdge = "invalid", QuotaNotchAlong = double.NaN }).Validated();
+        Assert.Equal("right", repaired.QuotaNotchEdge);
+        Assert.Equal(.5, repaired.QuotaNotchAlong);
+    }
+
+    [Theory]
+    [InlineData(0, 100, 1000, 120, 160)]
+    [InlineData(2000, 100, 1000, 120, 1040)]
+    [InlineData(500, 100, 1000, 120, 500)]
+    [InlineData(0, 100, 300, 650, 250)]
+    public void CenterStaysOnWorkArea(double center, double start, double extent, double window, double expected) =>
+        Assert.Equal(expected, QuotaNotchLayout.ClampCenter(center, start, extent, window), 6);
+
+    [Theory]
+    [InlineData("left", 100, 510)]
+    [InlineData("right", 1950, 510)]
+    [InlineData("top", 1025, 50)]
+    [InlineData("bottom", 1025, 970)]
+    public void TightNativeBoundsAttachToEachWorkAreaEdge(string edge, int left, int top)
+    {
+        var bounds = QuotaNotchLayout.Place(new RectD(100, 50, 1920, 1040), edge, .5, 1, 70, 120, QuotaNotchLayout.Vertical(edge) ? 60 : 35);
+        Assert.Equal(new QuotaNotchBounds(left, top, 70, 120), bounds);
+    }
+
+    [Fact]
+    public void SecondaryDisplayUsesItsOwnOriginAndPhysicalScale()
+    {
+        var bounds = QuotaNotchLayout.Place(new RectD(-2560, -200, 2560, 1400), "right", .5, 2, 70, 120, 60);
+        Assert.Equal(new QuotaNotchBounds(-140, 380, 140, 240), bounds);
+    }
+
+    [Theory]
+    [InlineData("left", -500, 40)]
+    [InlineData("right", -600, 40)]
+    [InlineData("top", -550, 100)]
+    [InlineData("bottom", -550, -20)]
+    public void OversizeShapeRetainsItsExtentAndCentresAlongConstrainedAxis(string edge, int left, int top)
+    {
+        var bounds = QuotaNotchLayout.Place(new RectD(-500, 100, 500, 400), edge, 1, 2, 300, 260, QuotaNotchLayout.Vertical(edge) ? 130 : 150);
+        Assert.Equal(new QuotaNotchBounds(left, top, 600, 520), bounds);
+    }
+
+    [Theory]
+    [InlineData("left", -1, 100, 50)]
+    [InlineData("left", 2, 100, 970)]
+    [InlineData("top", -1, 100, 50)]
+    [InlineData("top", 2, 1950, 50)]
+    [InlineData("top", double.NaN, 1025, 50)]
+    public void AlongPositionCannotPushFittingBoundsOutsideWorkArea(string edge, double along, int left, int top)
+    {
+        var bounds = QuotaNotchLayout.Place(new RectD(100, 50, 1920, 1040), edge, along, 1, 70, 120, QuotaNotchLayout.Vertical(edge) ? 60 : 35);
+        Assert.Equal(left, bounds.Left);
+        Assert.Equal(top, bounds.Top);
+    }
+
+    [Fact]
+    public void FractionalDpiRoundsOutwardWithoutChangingTheEdgeAnchor()
+    {
+        var bounds = QuotaNotchLayout.Place(new RectD(0, 0, 1920, 1080), "right", .5, 1.25, 70.2, 79, 39.5);
+        Assert.Equal(new QuotaNotchBounds(1832, 491, 88, 99), bounds);
+    }
+
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void AnimatedHandleExtentAndLocalOriginDoNotMoveTheBodyAnchor(string edge)
+    {
+        var area = new RectD(-1920, -200, 1920, 1280);
+        var vertical = QuotaNotchLayout.Vertical(edge);
+        var before = QuotaNotchLayout.Place(area, edge, .5, 1.5, vertical ? 70 : 120, vertical ? 120 : 70, 60);
+        var after = QuotaNotchLayout.Place(area, edge, .5, 1.5, vertical ? 90 : 200, vertical ? 200 : 90, 70);
+        var bodyBefore = (vertical ? before.Top : before.Left) + 60 * 1.5;
+        var bodyAfter = (vertical ? after.Top : after.Left) + 70 * 1.5;
+        Assert.Equal(bodyBefore, bodyAfter);
+        Assert.Equal(vertical ? area.Y + area.Height / 2 : area.X + area.Width / 2, bodyAfter);
+    }
+
+    [Fact]
+    public void CardClampingKeepsPhysicalTargetAsItsTailCoordinate()
+    {
+        var target = new PointD(-10, 1060);
+        var bounds = QuotaNotchLayout.PlaceCard(new RectD(-1920, 0, 1920, 1080), target, new PointD(0, 30), 1, 246, 200);
+        Assert.Equal(new QuotaNotchBounds(-246, 880, 246, 200), bounds);
+        Assert.Equal(180, QuotaNotchLayout.CardAlongPosition(bounds, target, "right", 1));
+    }
+
+    [Fact]
+    public void CardTipPlacementUsesDipsAtTheTargetMonitorsDpi()
+    {
+        var target = new PointD(-800, 300);
+        var bounds = QuotaNotchLayout.PlaceCard(new RectD(-1920, -200, 1920, 1280), target, new PointD(60, 0), 1.5, 246, 200);
+        Assert.Equal(new QuotaNotchBounds(-890, 300, 369, 300), bounds);
+        Assert.Equal(60, QuotaNotchLayout.CardAlongPosition(bounds, target, "top", 1.5));
+    }
+
+    [Fact]
+    public void OversizeCardKeepsItsDrawingExtentAndCentresInWorkArea()
+    {
+        var bounds = QuotaNotchLayout.PlaceCard(new RectD(100, 50, 200, 100), new PointD(150, 80), new PointD(0, 20), 2, 246, 200);
+        Assert.Equal(new QuotaNotchBounds(-46, -100, 492, 400), bounds);
+    }
+
+    [Theory]
+    [InlineData(-1919, 270, "left", .25)]
+    [InlineData(-1, 810, "right", .75)]
+    [InlineData(-1440, 1, "top", .25)]
+    [InlineData(-480, 1079, "bottom", .75)]
+    public void DraggedAnchorPersistsAndPlacesOnItsTargetMonitor(double x, double y, string edge, double along)
+    {
+        var area = new RectD(-1920, 0, 1920, 1080);
+        var anchor = QuotaNotchLayout.SnapDrag(area, new PointD(x, y), 0, 1.5);
+        Assert.Equal(edge, anchor.Edge);
+        Assert.Equal(along, anchor.Along, 6);
+        var settings = AppSettings.Default with
+        {
+            QuotaNotchEdge = anchor.Edge, QuotaNotchAlong = anchor.Along, QuotaNotchMonitor = "secondary"
+        };
+        var restored = SettingsSerializer.Deserialize(SettingsSerializer.Serialize(settings));
+        Assert.Equal("secondary", restored.QuotaNotchMonitor);
+        var bounds = QuotaNotchLayout.Place(area, restored.QuotaNotchEdge, restored.QuotaNotchAlong, 1.5, 70, 120, QuotaNotchLayout.Vertical(edge) ? 60 : 35);
+        switch (edge)
+        {
