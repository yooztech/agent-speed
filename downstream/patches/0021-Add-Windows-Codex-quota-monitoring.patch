new file mode 100644
index 0000000000000000000000000000000000000000..e23cdd1423d41b0628a62177db44357f03e966cb
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryRaster.cs
@@ -0,0 +1,69 @@
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Closed polygon contours of one already-unioned even-odd filled geometry, in DIPs.</summary>
+public static class QuotaNotchGeometryRaster
+{
+    public readonly record struct Point(double X, double Y);
+    public sealed class Scratch
+    {
+        internal double[] Intersections = [];
+        internal int[] Coverage = [];
+        internal void Ensure(int edges, int width)
+        {
+            if (Intersections.Length < edges) Intersections = new double[edges];
+            if (Coverage.Length < width) Coverage = new int[width];
+        }
+    }
+
+    /// <summary>Rasterize a tight local source box using a 2×2 coverage grid, without a visual,
+    /// renderer, capture, bitmap or platform dependency. Contours must be closed and disjoint
+    /// boundaries of the final union; holes are represented by even-odd winding. Output is alpha.</summary>
+    public static void Rasterize(IReadOnlyList<IReadOnlyList<Point>> contours, int width, int height,
+        double originX, double originY, double pixelsPerDip, Span<byte> output, Scratch scratch)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(width);
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(height);
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(pixelsPerDip);
+        int count = checked(width * height);
+        if (output.Length < count) throw new ArgumentException("Output is smaller than the supplied bounds.");
+        int edges = 0;
+        for (int i = 0; i < contours.Count; i++) edges += contours[i].Count;
+        scratch.Ensure(edges, width);
+        double[] intersections = scratch.Intersections; int[] coverage = scratch.Coverage;
+        for (int y = 0; y < height; y++)
+        {
+            Array.Clear(coverage, 0, width);
+            for (int subY = 0; subY < 2; subY++)
+            {
+                double scanY = originY + (y + (subY + .5) / 2) / pixelsPerDip;
+                int n = 0;
+                for (int contourIndex = 0; contourIndex < contours.Count; contourIndex++)
+                {
+                    var polygon = contours[contourIndex];
+                    if (polygon.Count < 3) continue;
+                    var a = polygon[polygon.Count - 1];
+                    for (int pointIndex = 0; pointIndex < polygon.Count; pointIndex++)
+                    {
+                        var b = polygon[pointIndex];
+                        if ((a.Y <= scanY && b.Y > scanY) || (b.Y <= scanY && a.Y > scanY))
+                            intersections[n++] = (a.X + (scanY-a.Y)*(b.X-a.X)/(b.Y-a.Y) - originX) * pixelsPerDip;
+                        a = b;
+                    }
+                }
+                Array.Sort(intersections, 0, n);
+                for (int j = 0; j + 1 < n; j += 2)
+                {
+                    double left = intersections[j], right = intersections[j+1];
+                    int first = Math.Max(0, (int)Math.Floor(left));
+                    int last = Math.Min(width - 1, (int)Math.Floor(right));
+                    for (int x = first; x <= last; x++)
+                    {
+                        if (x + .25 >= left && x + .25 < right) coverage[x]++;
+                        if (x + .75 >= left && x + .75 < right) coverage[x]++;
+                    }
+                }
+            }
+            for (int x = 0; x < width; x++) output[y * width + x] = (byte)(coverage[x] * 255 / 4);
+        }
+    }
+}
diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGripMotion.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGripMotion.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a96c768aeadc97ae6e1859fa25aaef43ae5b701b
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGripMotion.cs
@@ -0,0 +1,158 @@
+using AgentSpeed.Presentation.Motion;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>One event-driven timeline for the visible arc, temporary disc and six drops.
+/// Monotonic milliseconds and bounded analytic transitions allow deterministic frame sampling.</summary>
+public sealed class QuotaNotchGripMotion
+{
+    private Track _arc, _disc, _reveal;
+    private double _last, _entryArc;
+    private bool _expanded, _out, _hovered, _held, _initialized, _entryReturning, _entryQuick;
+    private DampedSpring _hover = new(.22, .55);
+    private DampedSpring _squeeze = new(.26, .7);
+    public QuotaNotchGeometry.GripFrame Frame { get; private set; }
+    public bool Active { get; private set; }
+
+    public void SetTargets(bool expanded, bool reveal, bool hover, bool held, double now, bool reducedMotion)
+    {
+        var painted = Frame;
+        // DOWN keeps the actual painted pose, not a later sample that moves under the press.
+        if (!held || _held) Sample(now);
+        if (!_initialized) { _initialized = true; _last = now; }
+        if (_expanded != expanded)
+        {
+            _expanded = expanded;
+            bool firstSeparation = expanded && _arc.Value <= .001;
+            _arc.To(expanded ? 1 : 0, now, firstSeparation ? 340 : 0,
+                firstSeparation ? 950 : expanded ? 350 : 260, expanded ? .35 : .42, expanded ? .25 : .58);
+        }
+        reveal &= expanded;
+        if (_out != reveal || _held != held)
+        {
+            if (!_out && reveal && _entryArc <= .001 && painted.Arc > .001 && painted.Arc < .999)
+            {
+                // Entry is classified against the previously painted frame, not Sample(now).
+                _entryArc = painted.Arc;
+                _entryReturning = painted.Returning;
+                _entryQuick = painted.Quick;
+            }
+            _out = reveal;
+            _held = held;
+            // Give the arc-to-disc its 220 ms, then the reference 20 ms drop delay.
+            _reveal.To(held ? _reveal.Value : reveal ? 1 : 0, now,
+                reveal && !held ? (_reveal.Value <= .001 ? 240 : 20) : 0,
+                reveal ? 420 : 200, reveal ? .35 : .42, reveal ? .25 : 1);
+            // On leave, let the drops return (200 ms), then wait 100 ms before rolling out the arc.
+            _disc.To(held ? _disc.Value : reveal ? 1 : 0, now,
+                reveal || held ? 0 : 300, reveal ? 220 : 400, .3, .2);
+        }
+        _hovered = hover;
+        if (reducedMotion) Settle();
+        else Publish();
+    }
+
+    public QuotaNotchGeometry.GripFrame Sample(double now)
+    {
+        _arc.Sample(now); _disc.Sample(now); _reveal.Sample(now);
+        if (_initialized)
+        {
+            double dt = Math.Max(0, (now - _last) / 1000);
+            _hover.Step(_hovered ? 1 : 0, dt);
+            _squeeze.Step(_held ? 1 : 0, dt);
+            if (_hover.IsSettled(_hovered ? 1 : 0, .002)) _hover.Snap(_hovered ? 1 : 0);
+            if (_squeeze.IsSettled(_held ? 1 : 0, .002)) _squeeze.Snap(_held ? 1 : 0);
+        }
+        _last = now;
+        Publish();
+        return Frame;
+    }
+
+    private void Publish()
+    {
+        bool returning = _arc.Active && _arc.Target < _arc.From;
+        double t = Math.Clamp(_reveal.Value / .7, 0, 1);
+        double disc = _disc.Value * (1 - t * t * (3 - 2 * t));
+        if (!_out && !_held && !_disc.Active && !_reveal.Active && _disc.Value == 0 && _reveal.Value == 0)
+        {
+            _entryArc = 0;
+            _entryReturning = _entryQuick = false;
+        }
+        Frame = new(_reveal.Value, _hover.Value, _squeeze.Value, _arc.Value, disc,
+            returning, returning && !_expanded, _entryArc, _entryReturning, _entryQuick);
+        Active = _arc.Active || _disc.Active || _reveal.Active
+            || !_hover.IsSettled(_hovered ? 1 : 0, .002) || !_squeeze.IsSettled(_held ? 1 : 0, .002);
+    }
+
+    public void Settle()
+    {
+        _arc.Snap(_expanded ? 1 : 0);
+        _disc.Snap(_held ? _disc.Value : _out ? 1 : 0);
+        _reveal.Snap(_held ? _reveal.Value : _out ? 1 : 0);
+        _hover.Snap(_hovered ? 1 : 0);
+        _squeeze.Snap(_held ? 1 : 0);
+        Publish();
+    }
+
+    public void Reset()
+    {
+        _initialized = _expanded = _out = _hovered = _held = Active = false;
+        _arc = _disc = _reveal = default;
+        _entryArc = 0; _entryReturning = _entryQuick = false;
+        _hover.Snap(0); _squeeze.Snap(0); Frame = default;
+    }
+
+    private struct Track
+    {
+        public double Value, From, Target;
+        private double _start, _duration, _x1, _x2;
+        public bool Active;
+
+        public void To(double target, double now, double delay, double duration, double x1, double x2)
+        {
+            From = Value; Target = target; _start = now + delay; _duration = duration;
+            _x1 = x1; _x2 = x2; Active = From != target;
+        }
+
+        public void Sample(double now)
+        {
+            if (!Active) return;
+            double u = Math.Clamp((now - _start) / _duration, 0, 1);
+            Value = From + (Target - From) * Curve(u, _x1, _x2);
+            if (u >= 1) Snap(Target);
+        }
+
+        public void Snap(double value) { Value = From = Target = value; Active = false; }
+    }
+
+    private static double Curve(double x, double x1, double x2)
+    {
+        if (x <= 0) return 0;
+        if (x >= 1) return 1;
+        double lo = 0, hi = 1, t = x;
+        for (int i = 0; i < 24; i++)
+        {
+            t = (lo + hi) / 2;
+            double at = 3 * x1 * t * (1 - t) * (1 - t) + 3 * x2 * t * t * (1 - t) + t * t * t;
+            if (at < x) lo = t; else hi = t;
+        }
+        return 3 * t * t * (1 - t) + t * t * t;
+    }
+}
+
+/// <summary>Acquisition requires physical pointer movement through current input.
+/// Paint-only samples cannot re-acquire after departure or withdraw an owned route.</summary>
+public sealed class QuotaNotchGripIntent
+{
+    private QuotaNotchGeometry.Point? _previous;
+    public bool Acquired { get; private set; }
+    public bool Update(QuotaNotchGeometry.Point point, bool entry, bool envelope, bool held = false)
+    {
+        bool moved = _previous is not null && _previous != point;
+        _previous = point;
+        if (Acquired) Acquired = held || envelope;
+        else if (moved && entry) Acquired = true;
+        return Acquired;
+    }
+    public void Reset() { Acquired = false; _previous = null; }
+}
diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchLayout.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchLayout.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2c476469e4d17838f7248baef9585d9c22592978
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchLayout.cs
@@ -0,0 +1,79 @@
+using AgentSpeed.Presentation.Layout;
+
+namespace AgentSpeed.Presentation.Settings;
+
+public readonly record struct QuotaNotchBounds(int Left, int Top, int Width, int Height);
+public readonly record struct QuotaNotchAnchor(string Edge, double Along);
+
+/// <summary>Tight native vector extents placed in physical monitor coordinates.</summary>
+public static class QuotaNotchLayout
+{
+    public static bool Vertical(string edge) => edge is "left" or "right";
+
+    /// <summary>Oversize shapes retain their geometry and are centred on the constrained axis.</summary>
+    public static double ClampCenter(double center, double start, double extent, double windowExtent)
+    {
+        var half = Math.Min(windowExtent, extent) / 2;
+        return Math.Clamp(center, start + half, start + extent - half);
+    }
+
+    /// <summary>Anchor the body's centre, not the changing handle extent, while fitting the tight HWND.</summary>
+    public static QuotaNotchBounds Place(RectD workArea, string edge, double along, double scale, double width, double height, double bodyCenterAlong)
+    {
+        var vertical = Vertical(edge);
+        var pixelsWide = Pixels(width, scale);
+        var pixelsHigh = Pixels(height, scale);
+        along = double.IsFinite(along) ? Math.Clamp(along, 0, 1) : .5;
+        var windowAlong = vertical ? pixelsHigh : pixelsWide;
+        var start = vertical ? workArea.Y : workArea.X;
+        var length = vertical ? workArea.Height : workArea.Width;
+        var desiredWindowCenter = start + length * along - bodyCenterAlong * scale + windowAlong / 2.0;
+        var center = ClampCenter(desiredWindowCenter, start, length, windowAlong);
+        var left = vertical ? (edge == "left" ? workArea.X : workArea.Right - pixelsWide) : Math.Round(center - pixelsWide / 2.0);
+        var top = vertical ? Math.Round(center - pixelsHigh / 2.0) : (edge == "top" ? workArea.Y : workArea.Bottom - pixelsHigh);
+        return new((int)left, (int)top, pixelsWide, pixelsHigh);
+    }
+
+    /// <summary>Align the real card tip to its physical target, then constrain the tight card HWND.</summary>
+    public static QuotaNotchBounds PlaceCard(RectD workArea, PointD target, PointD tip, double scale, double width, double height)
+    {
+        var pixelsWide = Pixels(width, scale);
+        var pixelsHigh = Pixels(height, scale);
+        var centerX = ClampCenter(target.X - tip.X * scale + pixelsWide / 2.0, workArea.X, workArea.Width, pixelsWide);
+        var centerY = ClampCenter(target.Y - tip.Y * scale + pixelsHigh / 2.0, workArea.Y, workArea.Height, pixelsHigh);
+        return new((int)Math.Round(centerX - pixelsWide / 2.0), (int)Math.Round(centerY - pixelsHigh / 2.0), pixelsWide, pixelsHigh);
+    }
+
+    /// <summary>Tail coordinate after clamping; the renderer applies its corner-clearance limit.</summary>
+    public static double CardAlongPosition(QuotaNotchBounds card, PointD target, string edge, double scale) =>
+        Vertical(edge) ? (target.Y - card.Top) / scale : (target.X - card.Left) / scale;
+
+    private static int Pixels(double extent, double scale) => Math.Max(1, checked((int)Math.Ceiling(extent * scale)));
+
+    /// <summary>Snap a physical screen point on its monitor; ties consistently prefer left, right, top, bottom.</summary>
+    public static QuotaNotchAnchor Snap(RectD workArea, PointD pointer)
+    {
+        var edge = "left";
+        var distance = Math.Abs(pointer.X - workArea.X);
+        var right = Math.Abs(pointer.X - workArea.Right);
+        if (right < distance) { edge = "right"; distance = right; }
+        var top = Math.Abs(pointer.Y - workArea.Y);
+        if (top < distance) { edge = "top"; distance = top; }
+        if (Math.Abs(pointer.Y - workArea.Bottom) < distance) edge = "bottom";
+        var along = Vertical(edge) ? (pointer.Y - workArea.Y) / workArea.Height : (pointer.X - workArea.X) / workArea.Width;
+        return new(edge, Math.Clamp(along, 0, 1));
+    }
+
+    /// <summary>Choose the edge from the real cursor, retaining the captured along-axis DIP offset at the target DPI.</summary>
+    public static QuotaNotchAnchor SnapDrag(RectD workArea, PointD pointer, double grabOffsetDip, double targetScale)
+    {
+        var edge = Snap(workArea, pointer).Edge;
+        var vertical = Vertical(edge);
+        var start = vertical ? workArea.Y : workArea.X;
+        var extent = vertical ? workArea.Height : workArea.Width;
+        var cursorAlong = vertical ? pointer.Y : pointer.X;
+        var bodyAlong = (cursorAlong - grabOffsetDip * targetScale - start) / extent;
+        return new(edge, Math.Clamp(bodyAlong, 0, 1));
+    }
+
+}
