+            }
+            footer.Children.Add(balances);
+            var edge = new Border { Child = footer, BorderThickness = new Thickness(0, 1, 0, 0),
+                Margin = new Thickness(0, 13, 0, 0), Padding = new Thickness(0, 11, 0, 0) };
+            edge.SetResourceReference(BorderBrushProperty, Edge); outer.Children.Add(edge);
+        }
+        return outer;
+    }
+
+    private void AddWindow(Panel parent, QuotaWindow window, string providerDisplayName)
+    {
+        var reading = new StackPanel { Margin = new Thickness(0, 18, 0, 0) };
+        var label = QuotaFormat.WindowLabel(_loc, window, providerDisplayName);
+        var heading = new DockPanel();
+        var remainingText = window.UsedFraction is { } usedFraction ? _loc.Format("win.quota.remaining", QuotaFormat.Percent(_loc, QuotaFormat.RemainingFraction(usedFraction))) : T("unavailable");
+        var value = Text(remainingText, 14, Ink, margin: new Thickness(12, 0, 0, 0), weight: FontWeights.SemiBold);
+        DockPanel.SetDock(value, Dock.Right); heading.Children.Add(value); heading.Children.Add(Text(label, 14, Ink)); reading.Children.Add(heading);
+        if (window.UsedFraction is { } used)
+        {
+            var track = new Grid { Height = 4, Margin = new Thickness(0, 9, 0, 0) };
+            var background = new Border { CornerRadius = new CornerRadius(3) };
+            background.SetResourceReference(BackgroundProperty, Field); track.Children.Add(background);
+            var fill = QuotaFormat.BarFill(used); var columns = new Grid();
+            columns.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(fill, GridUnitType.Star) });
+            columns.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1 - fill, GridUnitType.Star) });
+            var bar = new Border { CornerRadius = new CornerRadius(3) };
+            bar.SetResourceReference(BackgroundProperty, QuotaFormat.BarIsWarning(used) ? Amber : Blue);
+            columns.Children.Add(bar); track.Children.Add(columns);
+            System.Windows.Automation.AutomationProperties.SetName(track, label + ": " + remainingText);
+            reading.Children.Add(track);
+        }
+        if (window.ResetAt is { } at)
+        {
+            var reset = ResetLabel(at); reset.Margin = new Thickness(0, 8, 0, 0);
+            reading.Children.Add(reset);
+        }
+        parent.Children.Add(reading);
+    }
+
+    private TextBlock ResetLabel(DateTimeOffset at)
+    {
+        var text = Text(QuotaFormat.ResetTime(_loc, at, _now()), 12, Muted);
+        _resetLabels.Add((text, at));
+        return text;
+    }
+
+    private string T(string key) => _loc["win.quota." + key];
+    private string Date(DateTimeOffset date) => QuotaFormat.AbsoluteTime(_loc, date);
+    private static Border Group(UIElement child)
+    {
+        var group = new Border { Child = child, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(8) };
+        group.SetResourceReference(BackgroundProperty, Card);
+        group.SetResourceReference(BorderBrushProperty, Edge);
+        return group;
+    }
+    private static TextBlock Text(string text, double size, string color, Thickness margin = default, FontWeight weight = default)
+    {
+        var block = new TextBlock { Text = text, FontSize = size, FontWeight = weight == default ? FontWeights.Normal : weight, TextWrapping = TextWrapping.Wrap, Margin = margin };
+        block.SetResourceReference(TextBlock.ForegroundProperty, color);
+        return block;
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _clockTimer.Stop();
+        _clockTimer.Tick -= OnClockTick;
+        _resetLabels.Clear();
+    }
+}
