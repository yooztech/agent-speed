+    private void CaptureLost(object sender, MouseEventArgs e)
+    {
+        if (_dragging && !_closed && !_failed) EndDrag();
+        _pressed = default;
+        _pendingDrag = false;
+        if (!_mainInside && !_cardInside) StartGrace();
+        UpdateTargets();
+    }
+
+    private void EndDrag(Point? screen = null)
+    {
