diff --git a/windows/src/AgentSpeed/Settings/QuotaNotchGoo.cs b/windows/src/AgentSpeed/Settings/QuotaNotchGoo.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b1545ba91f8d8cd5f7bec2754a98272e089b6355
--- /dev/null
+++ b/windows/src/AgentSpeed/Settings/QuotaNotchGoo.cs
@@ -0,0 +1,95 @@
+using System.Windows;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Settings;
+
+/// <summary>Rasterizes only a finite-transition vector source, never a visual or the screen.
+/// The same thresholded mask produces both the local image and its native input contour.</summary>
+internal sealed class QuotaNotchGoo
+{
+    internal readonly record struct Result(ImageSource Image, Rect Bounds, Geometry Input);
+    private readonly QuotaNotchGeometryRaster.Scratch _rasterScratch = new();
+    private readonly QuotaNotchFilterScratch _filterScratch = new();
+    private byte[] _source = [], _outer = [], _inner = [], _pixels = [];
+
+    public Result? Create(Geometry source, double sigma, double scale, Color rim, Color fill)
+    {
+        if (source.IsEmpty() || sigma <= 0) return null;
+        scale = Math.Max(scale, 1);
+        Rect bounds = source.Bounds;
+        int padding = QuotaNotchGeometryFilter.Padding(sigma, scale);
+        double left = Math.Floor(bounds.Left * scale) - padding, top = Math.Floor(bounds.Top * scale) - padding;
+        int width = checked((int)(Math.Ceiling(bounds.Right * scale) - left) + padding);
+        int height = checked((int)(Math.Ceiling(bounds.Bottom * scale) - top) + padding);
+        int count = checked(width * height);
+        Ensure(ref _source, count); Ensure(ref _outer, count); Ensure(ref _inner, count); Ensure(ref _pixels, checked(count * 4));
+        var figures = Contours(source);
+        QuotaNotchGeometryRaster.Rasterize(figures, width, height, left / scale, top / scale, scale,
+            _source.AsSpan(0, count), _rasterScratch);
+        QuotaNotchGeometryFilter.Apply(width, height, sigma, scale, _source.AsSpan(0, count),
+            _outer.AsSpan(0, count), _inner.AsSpan(0, count), _filterScratch);
+        for (int i = 0; i < count; i++)
+        {
+            double outer = _outer[i] / 255d, inner = _inner[i] / 255d;
+            double under = outer * (1-inner), alpha = inner + under;
+            int p = i*4;
+            _pixels[p] = (byte)Math.Clamp(Math.Round(fill.B*inner + rim.B*under), 0, 255);
+            _pixels[p+1] = (byte)Math.Clamp(Math.Round(fill.G*inner + rim.G*under), 0, 255);
+            _pixels[p+2] = (byte)Math.Clamp(Math.Round(fill.R*inner + rim.R*under), 0, 255);
+            _pixels[p+3] = (byte)Math.Clamp(Math.Round(alpha*255), 0, 255);
+        }
+        var image = BitmapSource.Create(width, height, 96*scale, 96*scale, PixelFormats.Pbgra32, null, _pixels, width*4);
+        image.Freeze();
+        var hit = Runs(width, height, left / scale, top / scale, scale, _outer);
+        return new(image, new Rect(left/scale, top/scale, width/scale, height/scale), hit);
+    }
+
+    private static void Ensure(ref byte[] buffer, int size) { if (buffer.Length < size) buffer = new byte[size]; }
+
+    private static IReadOnlyList<IReadOnlyList<QuotaNotchGeometryRaster.Point>> Contours(Geometry source)
+    {
+        var paths = source.GetFlattenedPathGeometry(.1, ToleranceType.Absolute);
+        var transform = paths.Transform?.Value ?? Matrix.Identity;
+        var result = new List<IReadOnlyList<QuotaNotchGeometryRaster.Point>>(paths.Figures.Count);
+        foreach (var figure in paths.Figures)
+        {
+            if (!figure.IsFilled) continue;
+            var start = transform.Transform(figure.StartPoint);
+            var points = new List<QuotaNotchGeometryRaster.Point> { new(start.X, start.Y) };
+            foreach (var segment in figure.Segments)
+            {
+                if (segment is LineSegment line) { var p = transform.Transform(line.Point); points.Add(new(p.X, p.Y)); }
+                else if (segment is PolyLineSegment poly)
+                    foreach (var point in poly.Points) { var p = transform.Transform(point); points.Add(new(p.X, p.Y)); }
+            }
+            result.Add(points);
+        }
+        return result;
+    }
+
+    private static Geometry Runs(int width, int height, double x, double y, double scale, byte[] alpha)
+    {
+        var geometry = new StreamGeometry { FillRule = FillRule.Nonzero };
+        using (var c = geometry.Open())
+        {
+            for (int row = 0; row < height; row++)
+            {
+                int column = 0;
+                while (column < width)
+                {
+                    while (column < width && alpha[row*width+column] == 0) column++;
+                    int start = column;
+                    while (column < width && alpha[row*width+column] != 0) column++;
+                    if (start == column) continue;
+                    double left = x + start/scale, right = x + column/scale, top = y + row/scale, bottom = y + (row+1)/scale;
+                    c.BeginFigure(new Point(left, top), true, true);
+                    c.LineTo(new Point(right, top), true, false); c.LineTo(new Point(right, bottom), true, false);
+                    c.LineTo(new Point(left, bottom), true, false);
+                }
+            }
+        }
+        geometry.Freeze(); return geometry;
+    }
+}
