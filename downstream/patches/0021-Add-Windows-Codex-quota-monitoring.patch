+using System.IO;
+using System.Net;
+using System.Net.Http;
+using System.Runtime.ExceptionServices;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Services;
+using AgentSpeed.Settings;
+
+namespace AgentSpeed.Windows.Tests;
+
+public sealed class QuotaWarmStartupTests
+{
+    [Fact]
+    public void CachedStartupFailureKeepsReadingAndRetriesActualHttpAtSixtySeconds()
+    {
+        Exception? failure = null;
+        var thread = new Thread(() =>
+        {
+            var directory = Path.Combine(Path.GetTempPath(), "quota-warm-startup-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+            try
+            {
+                var auth = Path.Combine(directory, "auth.json");
+                File.WriteAllText(auth, """{"tokens":{"access_token":"fixture","account_id":"fixture-account"}}""");
+                var now = new DateTimeOffset(2026, 11, 16, 12, 0, 0, TimeSpan.Zero);
+                using var handler = new WarmStartupHandler();
+                CodexQuotaProvider Provider() => new(auth, Path.Combine(directory, "schedule"), new HttpClient(handler, false), () => now);
+                using var seed = Provider();
+                var successful = seed.RefreshAsync().GetAwaiter().GetResult();
+                Assert.Equal(QuotaStatus.Ok, successful.Status);
+                Assert.Equal(1, handler.UsageCalls);
+                using var restored = Provider();
+                Assert.Equal(successful.ObservedAt, restored.ReadCachedSnapshot().ObservedAt);
+                using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+                settings.MakeEphemeral();
+                settings.Update(s => s with { ShowQuotaNotch = false, NetworkEnabled = true, AutoRefreshQuota = true,
+                    QuotaAllSources = false, QuotaSources = ["codex"] });
+                var scheduler = new WarmStartupScheduler();
+                var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+                using var surface = new QuotaSurface(settings, loc, false, _ => restored,
+                    refreshInterval: TimeSpan.FromHours(1), now: () => now, retryScheduler: scheduler);
+                Drain();
+                Assert.Equal(2, handler.UsageCalls); // Startup bypasses only the cached success floor.
+                var stale = restored.ReadCachedSnapshot();
+                Assert.Equal(QuotaStatus.Stale, stale.Status);
+                Assert.Equal(successful.ObservedAt, stale.ObservedAt);
+                Assert.Equal(successful.Windows, stale.Windows);
+                Assert.Equal(TimeSpan.FromSeconds(60), scheduler.Delay); // Not the ordinary five-minute tick.
+                now = now.AddSeconds(59);
+                scheduler.Fire();
+                Assert.Equal(2, handler.UsageCalls);
+                Assert.Equal(TimeSpan.FromSeconds(1), scheduler.Delay);
+                now = now.AddSeconds(1);
+                scheduler.Fire();
+                Drain();
+                Assert.Equal(3, handler.UsageCalls);
+                Assert.Equal(now, restored.ReadCachedSnapshot().ObservedAt);
+                Assert.Null(scheduler.Delay);
+            }
+            catch (Exception error) { failure = error; }
+            finally { Directory.Delete(directory, recursive: true); }
+        });
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start(); thread.Join();
+        if (failure is not null) ExceptionDispatchInfo.Capture(failure).Throw();
+    }
+
+    private sealed class WarmStartupHandler : HttpMessageHandler
+    {
+        public int UsageCalls;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var usage = request.RequestUri!.AbsolutePath.EndsWith("/usage", StringComparison.Ordinal);
+            if (usage && ++UsageCalls == 2) return Task.FromResult(new HttpResponseMessage(HttpStatusCode.ServiceUnavailable));
+            var body = usage
+                ? """{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":25,"limit_window_seconds":18000}}}"""
+                : """{"available_count":2}""";
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent(body) });
+        }
+    }
+
+    private sealed class WarmStartupScheduler : IQuotaRetryScheduler
+    {
+        public TimeSpan? Delay { get; private set; }
+        private Action? retry;
+        public void Schedule(string sourceId, TimeSpan delay, Action retry) { Delay = delay; this.retry = retry; }
+        public void Cancel(string sourceId) { Delay = null; retry = null; }
+        public void Clear() { Delay = null; retry = null; }
+        public void Fire() { var tick = retry; Clear(); tick?.Invoke(); }
+    }
+
+    private static void Drain()
+    {
+        var frame = new DispatcherFrame();
+        Dispatcher.CurrentDispatcher.BeginInvoke(DispatcherPriority.ApplicationIdle, new Action(() => frame.Continue = false));
+        Dispatcher.PushFrame(frame);
+    }
+}
