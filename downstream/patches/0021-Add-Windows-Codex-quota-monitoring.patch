+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchGeometryFilterTests
+{
+    [Fact]
+    public void MatrixAndOnePixelErosionMatchReferenceAlphaPipeline()
+    {
+        const int size = 7;
+        var source = new byte[size * size];
+        for (int y = 1; y <= 5; y++) for (int x = 1; x <= 5; x++) source[y * size + x] = 255;
+        var outer = new byte[source.Length]; var inner = new byte[source.Length];
+        var scratch = new QuotaNotchFilterScratch();
+        QuotaNotchGeometryFilter.Apply(size, size, 0, 1, source, outer, inner, scratch);
+        Assert.Equal(255, outer[1 * size + 1]);
+        Assert.Equal(0, inner[1 * size + 1]);
+        Assert.Equal(255, inner[2 * size + 2]);
+        Assert.Equal(0, outer[0]);
+    }
+
+    [Fact]
+    public void BlurKeepsSolidCoreAndDoesNotInventRemotePixels()
+    {
+        const int size = 21;
+        var source = new byte[size * size];
+        for (int y = 7; y < 14; y++) for (int x = 7; x < 14; x++) source[y * size + x] = 255;
+        var outer = new byte[source.Length]; var inner = new byte[source.Length];
+        QuotaNotchGeometryFilter.Apply(size, size, 1, 1, source, outer, inner, new());
+        Assert.Equal(255, outer[10 * size + 10]);
+        Assert.Equal(255, inner[10 * size + 10]);
+        Assert.Equal(0, outer[0]);
+        Assert.Equal(4, QuotaNotchGeometryFilter.Padding(1, 1));
+    }
+}
