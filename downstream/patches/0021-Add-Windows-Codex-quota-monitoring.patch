--- /dev/null
+++ b/windows/src/AgentSpeed/Settings/QuotaRetryScheduler.cs
@@ -0,0 +1,35 @@
+using System.Windows.Threading;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Settings;
+
+internal sealed class QuotaRetryScheduler(Dispatcher dispatcher) : IQuotaRetryScheduler
+{
+    private readonly Dictionary<string, DispatcherTimer> _timers = new(StringComparer.Ordinal);
+
+    public void Schedule(string sourceId, TimeSpan delay, Action retry)
+    {
+        Cancel(sourceId);
+        var timer = new DispatcherTimer(DispatcherPriority.Background, dispatcher) { Interval = delay };
+        timer.Tick += (_, _) =>
+        {
+            timer.Stop();
+            if (!_timers.TryGetValue(sourceId, out var current) || !ReferenceEquals(current, timer)) return;
+            _timers.Remove(sourceId);
+            retry();
+        };
+        _timers.Add(sourceId, timer);
+        timer.Start();
+    }
+
+    public void Cancel(string sourceId)
+    {
+        if (_timers.Remove(sourceId, out var timer)) timer.Stop();
+    }
+
+    public void Clear()
+    {
+        foreach (var timer in _timers.Values) timer.Stop();
+        _timers.Clear();
+    }
+}
