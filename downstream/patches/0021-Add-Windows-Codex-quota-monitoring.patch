+/* The part `a` to `b` (0 to 1) of the quarter circle facing `m` round the fillet's centre, `r` out
+   and moved by (sx, sy): the Mac's FlareArc, whose flare is a circle here */
+function quarter(m,r,a,b,sx=0,sy=0){
+  const th=Math.atan2(m[1],m[0])-Math.PI/4;
+  const p=s=>`${(sx+r*Math.cos(th+s*Math.PI/2)).toFixed(2)} ${(sy+r*Math.sin(th+s*Math.PI/2)).toFixed(2)}`;
+  return `M${p(a)} A${r.toFixed(2)} ${r.toFixed(2)} 0 0 1 ${p(b)}`;
+}
+/* A neck of goo from `f` to `t`, half `base` wide where it leaves, `pinch` in its middle and `top`
+   where it holds on */
+function strand(f,t,base,pinch,top){
+  const dx=t[0]-f[0], dy=t[1]-f[1], l=Math.max(Math.hypot(dx,dy),.001), px=-dy/l, py=dx/l, mid=[f[0]+dx/2,f[1]+dy/2];
+  const side=(p,h,s)=>`${(p[0]+px*h*s).toFixed(2)} ${(p[1]+py*h*s).toFixed(2)}`;
+  return `M${side(f,base,1)} Q${side(mid,pinch,1)} ${side(t,top,1)} L${side(t,top,-1)} Q${side(mid,pinch,-1)} ${side(f,base,-1)} Z`;
+}
+/* DiscMerge: the disc drawn along a neck into the flare, smaller as it goes. Round the fillet's
+   centre, for a fillet `F`, the arc's stroke `S`, the disc's radius `D` and `m` into the notch. */
+function discMerge(t,F,S,D,m){
+  t=clamp01(t);
+  const goo=5*smooth(t/.2), at=o=>[m[0]*(F-o),m[1]*(F-o)];
+  const inside=at(-D*.75), k=smooth(t), c=[inside[0]*k,inside[1]*k], r=D*(1-.72*smooth((t-.2)/.8));
+  const g={goo,liquid:goo>.3,disc:[c[0],c[1],r]};
+  if(!g.liquid) return g;
+  const band=S*2.4, hold=smooth(t/.22);
+  g.band={d:quarter(m,F+.5+band/2,0,1),width:band};
+  if(hold>.02) g.neck=strand(at(-S),c,D*1.1*hold/2,r*.8*hold/2,r*1.2*hold/2);
+  return g;
+}
+/* GooArc: at 0 buried in the notch, at 1 the resting arc. `returning` is the way back in — rolled
+   up first, then drawn home on a neck — and `quick` that way with the notch already folding, when
+   there is nothing to go into and it only rolls up and dwindles where it is. */
+function gooArc(sep,returning,quick,F,S,m){
+  if(sep<=.001) return null;
+  const rest=F-ARC_R, t=clamp01(sep), rq=returning&&quick, buried=-(rest+S*1.4);
+  const goo=rq?0:returning?S*.45*(1+.8*(1-smooth((sep-.04)/.32)))*smooth((.93-sep)/.15)*smooth(sep/.05)
+    :S*.4*smooth(sep/.15)*(1-smooth((sep-.6)/.35));
+  const slide=rq?0:returning?buried*(1-t)+(t<.85?rest*1.2*Math.sin(Math.PI*t/.85):0)
+    :buried*(1-t)+(t<.8?rest*2.1*Math.sin(Math.PI*t/.8):0);
+  const unrolled=rq?smooth((sep-.05)/.9):returning?smooth((sep-.6)/.35):smooth((sep-.52)/.43);
+  let width=S*2.3+(S-S*2.3)*unrolled;
+  if(rq) width=S*smooth(sep/.7);
+  if(returning&&!quick) width*=smooth(sep/.35);
+  if(width<.4) return null;
+  const half=Math.max(.004,unrolled/2), whole=unrolled>=.999;
+  const g={goo,liquid:goo>.2,arc:{d:quarter(m,ARC_R,whole?0:.5-half,whole?1:.5+half,-m[0]*slide,-m[1]*slide),width}};
+  if(!g.liquid) return g;
+  g.arc.width+=goo*.4;
+  const neck=returning?(quick?0:S*1.1*smooth((.94-sep)/.1)):S*1.1*(1-smooth((sep-.2)/.5));
+  if(neck>S*.18){
+    const reach=returning?smooth((.92-sep)/.32):1, out=rest+slide;
+    const from=[m[0]*(F+S),m[1]*(F+S)], drop=[m[0]*(F-out),m[1]*(F-out)];
+    g.neck=strand(from,[from[0]+(drop[0]-from[0])*reach,from[1]+(drop[1]-from[1])*reach],S*1.3,neck/2,S*.7);
+  }
+  const band=S+goo*1.6;
+  g.band={d:quarter(m,F+.5+band/2,0,1),width:band};
+  return g;
+}
+/* DiscToArc: the disc flowing out along the arc from its middle, thinning as it goes, until it is the
+   arc. From the disc's own size, edge included, so it takes over from it without a step. */
+function discToArc(p,S,D,m){
+  p=clamp01(p);
+  const onto=smooth(p/.55), half=Math.max(.004,.5*smooth((p-.08)/.82)), from=2*D-2;
+  return {goo:0,liquid:false,arc:{d:quarter(m,ARC_R,.5-half,.5+half,-m[0]*ARC_R*(1-onto),-m[1]*ARC_R*(1-onto)),width:from+(S-from)*smooth(p/.8)}};
+}
+function paintOrb(g){
+  if(!g){ orbInk.style.display='none'; return; }
+  orbInk.style.display='';
+  plainInk.style.display=g.liquid?'none':''; liquidInk.style.display=g.liquid?'':'none';
+  const a=g.arc, d=g.disc||[0,0,0];
+  if(!g.liquid){
+    // The resting arc's own drawing: the edge a pixel either side of the fill
+    pRing.setAttribute('d',a?a.d:''); pRing.setAttribute('stroke-width',a?(a.width+2).toFixed(2):'0');
+    pFill.setAttribute('d',a?a.d:''); pFill.setAttribute('stroke-width',a?a.width.toFixed(2):'0');
+    setCircle(pDisc,d[0],d[1],d[2]-.5);
+    return;
+  }
+  orbBlur.setAttribute('stdDeviation',g.goo.toFixed(2));
+  lArc.setAttribute('d',a?a.d:''); lArc.setAttribute('stroke-width',a?(a.width+2).toFixed(2):'0');
+  lBand.setAttribute('d',g.band?g.band.d:''); lBand.setAttribute('stroke-width',g.band?g.band.width.toFixed(2):'0');
+  lNeck.setAttribute('d',g.neck||'');
+  setCircle(lDisc,d[0],d[1],d[2]);
+}
+function drawOrb(now){
+  if(handleCarry) return;
+  let g=null, drawn=false;
+  if(release){
+    const p=RELEASE(clamp01((now-release.start)/release.dur)), m=pocket();
+    g=release.home?discMerge(p,orbFillet,ORB_STROKE,DISC_R,m):discToArc(p,ORB_STROKE,DISC_R,m);
+  } else if(!gripOut()&&(arcRun||arcSep<1)){
+    g=gooArc(arcSep,!!arcRun&&arcRun.returning,!!arcRun&&arcRun.quick,orbFillet,ORB_STROKE,pocket());
+    drawn=true;
+  }
+  orb.classList.toggle('drawn',drawn);
+  paintOrb(g);
+}
+function arcTo(to,run){
+  arcRun={from:arcSep,to,returning:false,quick:false,start:performance.now(),...run};
+  runGrip();
+}
+// Out as the notch opens; caught on its way back in, straight back out the way it was going
+function arcOut(){
+  if(arcRun?arcRun.to===1:arcSep>=1) return;
+  if(performance.now()-arcHome<ARC_RETURN) arcTo(1,{returning:true,dur:350,ease:EASE_OUT});
+  else { arcSep=0; arcTo(1,{start:performance.now()+ARC_DIVIDES,dur:950,ease:ARC_DIVIDE}); }
+}
+// Home before the notch folds; `quick` when it is folding already
+function arcIn(quick){
+  if(arcRun?arcRun.to===0:arcSep<=0) return;
+  arcHome=performance.now();
+  arcTo(0,{returning:true,quick,dur:quick?ARC_QUICK:ARC_RETURN,ease:EASE_IN_OUT});
+}
+/* Left, the disc turns back into its arc a beat late, so the dots have run back into it while it is
+   still the disc there to take them; with the arc already going home, it goes into the notch instead */
+function releaseOrb(){
+  if(handleCarry||still()) return;
+  const home=(arcRun?arcRun.to:arcSep)<.5;
+  release={start:performance.now()+(home?0:100),dur:home?340:400,home};
+  orb.classList.add('releasing');
+  runGrip();
+}
+function holdOrb(){ release=null; orb.classList.remove('releasing'); runGrip(); }
+
+/* Show on hover, the Mac's .onHover. It opens on contact and folds a moment after the pointer has gone.
+   Rust says which (notch_pointer): once click-through is back on, the page is sent nothing at all. It
+   never folds mid-carry, mid-drag or under the right-click menu, all of which take the pointer off the
+   notch on purpose — folding under them is what #239's reviewers caught, so it is ruled out here. */
+const FOLD_GRACE=450; // NotchWindowController.foldGrace
+function foldAllowed(){ return (onHover||fullScreen)&&!pointerIn&&!dragging&&!menuOpen; }
+function setFolded(f){
+  if(f===folded||CARD_ONLY) return;
+  folded=f;
+  if(f){ clearTimeout(hideTimer); hideCard(); arcIn(true); setHovered(null); } else arcOut();
+  document.body.classList.toggle('folded',f);
+  reportHot();
+}
+function unfold(){ clearTimeout(foldTimer); clearTimeout(tuckTimer); setFolded(false); arcOut(); }
+/* The Mac's order: left from the orb or its dots, the disc turns back into its arc first; then the arc
+   goes home, while there is still a notch to go into; and only then does the notch fold */
+function scheduleFold(){
+  clearTimeout(foldTimer); clearTimeout(tuckTimer);
+  if(!onHover&&!fullScreen){ setFolded(false); arcOut(); return; }
+  if(!foldAllowed()){ if(!folded) arcOut(); return; }
+  const turnBack=gripOut()?TURNS_BACK:release?Math.max(0,release.start+release.dur-performance.now()):0;
+  tuckTimer=setTimeout(()=>{ if(foldAllowed()) arcIn(false); },turnBack);
+  foldTimer=setTimeout(()=>{ if(foldAllowed()) setFolded(true); },FOLD_GRACE+turnBack);
+}
+function applyUiFlags(f){ onHover=!!(f&&f.notch_on_hover); scheduleFold(); }
+/* A full-screen app in front folds it as Show on hover would, whatever Show says, and at once rather
+   than after the grace — the Mac's foldForFullScreen. */
+function applyFullScreen(on){
+  fullScreen=on===true;
+  if(fullScreen&&foldAllowed()){ clearTimeout(foldTimer); clearTimeout(tuckTimer); setFolded(true); } else scheduleFold();
+}
+listen('full_screen',e=>applyFullScreen(e.payload)).catch(()=>{});
+invoke('get_full_screen').then(applyFullScreen).catch(()=>{});
+// Called by GTK crossing events on Linux; the native side owns the leave grace timer.
+if(isLinux) window.codenotchPointer = inside => {
+  pointerIn=inside;
+  if(inside){ clearTimeout(hideTimer); unfold(); }
+  else if(!dragging){ setHovered(null); clearTimeout(hideTimer); hideCard(); scheduleFold(); }
+};
+// Off the notch is off the orb too: once the window is click-through the page may never see it leave
+listen('notch_pointer',e=>{
+  if(CARD_ONLY) return;
+  pointerIn=e.payload===true;
+  if(pointerIn) unfold(); else { if(!dragging) setHovered(null); scheduleFold(); }
+}).catch(()=>{});
+listen('ui_flags',e=>applyUiFlags(e.payload)).catch(()=>{});
+listen('pill_backdrop',e=>{
+  if(e.payload==='dark'||e.payload==='light') document.body.dataset.behind=e.payload;
+  else delete document.body.dataset.behind;
+}).catch(()=>{});
+invoke('get_ui_flags').then(applyUiFlags).catch(()=>{});
+listen('notch_shows_remaining',e=>{ showRemaining=e.payload===true; renderRing(); }).catch(()=>{});
+invoke('get_notch_shows_remaining').then(v=>{ showRemaining=v===true; renderRing(); }).catch(()=>{});
+listen('show_usage_pace',e=>{ showPace=e.payload===true; if(card.classList.contains('show')) renderCard(); }).catch(()=>{});
+invoke('get_show_usage_pace').then(v=>{ showPace=v===true; }).catch(()=>{});
+
+listen('state',e=>{stateSnap=e.payload||stateSnap;setUiLanguage(stateSnap.lang_resolved);renderRing();if(card.classList.contains('show'))renderCard();})
+  .catch(e=>notice('listen(state) failed: '+e));
+listen('notice',e=>notice(e.payload)).catch(()=>{});
+listen('codex',e=>{codexSnap=e.payload||codexSnap;settle('codex');renderRing();if(card.classList.contains('show'))renderCard();}).catch(()=>{});
+invoke('get_notch_slots').then(v=>{if(Array.isArray(v)){notchSlots=v;renderRing();}}).catch(()=>{});
+listen('notch_slots',e=>{
+  notchSlots=Array.isArray(e.payload)?e.payload:null;
+  renderRing();
+  if(card.classList.contains('show')){renderCard();armWatchdog();}
+}).catch(()=>{});
+invoke('get_weekly_ring').then(v=>{if(typeof v==='string'){weeklyRing=v;renderRing();}}).catch(()=>{});
+listen('weekly_ring',e=>{if(typeof e.payload==='string'){weeklyRing=e.payload;renderRing();}}).catch(()=>{});
+invoke('get_color_transition').then(v=>{if(typeof v==='string'){colorTransition=v;renderRing();}}).catch(()=>{});
+listen('color_transition',e=>{if(typeof e.payload==='string'){colorTransition=e.payload;renderRing();}}).catch(()=>{});
+invoke('get_weekly_ring_dashed').then(v=>{if(typeof v==='boolean'){weeklyRingDashed=v;renderRing();}}).catch(()=>{});
+listen('weekly_ring_dashed',e=>{if(typeof e.payload==='boolean'){weeklyRingDashed=e.payload;renderRing();}}).catch(()=>{});
+invoke('get_watch_limit').then(v=>{if(typeof v==='number'){watchLimit=v;renderRing();}}).catch(()=>{});
+listen('watch_limit',e=>{if(typeof e.payload==='number'){watchLimit=e.payload;renderRing();}}).catch(()=>{});
+invoke('get_critical_limit').then(v=>{if(typeof v==='number'){criticalLimit=v;renderRing();}}).catch(()=>{});
+listen('critical_limit',e=>{if(typeof e.payload==='number'){criticalLimit=e.payload;renderRing();}}).catch(()=>{});
+listen('antigravity_prefs',e=>{if(e.payload){agPrefs=e.payload;renderRing();}}).catch(()=>{});
+listen('glyphs',e=>{glyphs=e.payload||glyphs;renderRing();if(card.classList.contains('show'))renderCard();}).catch(()=>{});
+invoke('get_glyphs').then(g=>{glyphs=g||glyphs;renderRing();}).catch(()=>{});
+// The edge: pushed on every placement (a drag that snapped elsewhere, or Settings), and asked for once
+// at startup in case the placement happened before this page was listening.
+listen('notch_edge',e=>applyEdge(e.payload)).catch(()=>{});
+// applyEdge measures for the edge it is given; on the right-hand one it returns early, so the first
+// measurement is made here either way — and still made if the ask fails, from the default edge.
+invoke('get_notch_edge').then(e=>{applyEdge(e);reportDpr();}).catch(()=>reportDpr());
+invoke('get_codex').then(u=>{codexSnap=u||codexSnap;renderRing();}).catch(()=>{});
+invoke('get_state').then(s=>{stateSnap=s||stateSnap;setUiLanguage(stateSnap.lang_resolved);renderRing();}).catch(()=>{});
+setInterval(()=>{renderRing();if(card.classList.contains('show'))renderCard();},30_000); // freshness changes even without a new response
+// The taskbar's ids name the default Claude account claude@default, where this page calls it claude
+if(CARD_ONLY){
+  const cardId=id=>id==='claude@default'?'claude':id;
+  cardShownId=window.__CODENOTCH_TASKBAR_ITEM_ID__||null;
+  hoverId=cardId(cardShownId);
+  card.classList.add('show');
+  // Every reading that redraws the rings redraws the card, which measures it again
+  const drawRings=renderRing;
+  renderRing=function(){ drawRings(); if(providers().length) renderCard(); };
+  listen('taskbar_hover_item',e=>{ cardShownId=e.payload; hoverId=cardId(cardShownId); lastCardSize=''; renderRing(); }).catch(()=>{});
+  listen('taskbar_hover_tail',e=>{ cardTail=e.payload; placeCard(); }).catch(()=>{});
+  // Holding the card open while the pointer is on it is Rust's: it also lets clicks through the
+  // empty part of the window, and a page that is let through never hears the pointer leave.
+}
+</script>
+</body>
+</html>
