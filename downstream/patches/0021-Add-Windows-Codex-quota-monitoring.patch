+        Assert.Null(provider.ReadCachedSnapshot().ObservedAt);
+        var other = await provider.RefreshAsync();
+        Assert.Equal(Time, other.ObservedAt);
+        Assert.Equal(2, Directory.GetFiles(context.Schedule).Length);
+        context.RemoveCredentials();
+        Assert.Equal(QuotaStatus.NeedsAuth, provider.ReadCachedSnapshot().Status);
+        Assert.Null((await provider.RefreshAsync()).ObservedAt);
+        context.Credentials("secret-token");
+        Assert.Equal(QuotaStatus.Stale, provider.ReadCachedSnapshot().Status);
+        context.Clock = Time.AddMinutes(6);
+        context.Handler.Status = HttpStatusCode.Forbidden;
+        Assert.Equal(QuotaStatus.NeedsAuth, (await provider.RefreshAsync()).Status);
+        using var restarted = context.Provider();
+        Assert.Null(restarted.ReadCachedSnapshot().ObservedAt);
+        Assert.Null((await restarted.RefreshStartupAsync()).ObservedAt);
+        context.Credentials("replacement");
+        Assert.Equal(Time, restarted.ReadCachedSnapshot().ObservedAt);
+    }
+
+    [Theory]
+    [InlineData("not JSON")]
+    [InlineData("{\"snapshotVersion\":2,\"snapshot\":{}}")]
+    [InlineData("{\"snapshotVersion\":1,\"snapshotAccountKey\":\"ACCOUNT\",\"snapshot\":{\"Id\":\"codex\",\"Status\":0}}")]
+    public async Task CorruptOrUnknownCacheIsAMissAndCanBeReplacedBySuccess(string content)
+    {
+        using var context = new Context();
+        using (var first = context.Provider()) await first.RefreshAsync();
+        var path = Directory.GetFiles(context.Schedule).Single();
+        File.WriteAllText(path, content.Replace("ACCOUNT", Path.GetFileNameWithoutExtension(path), StringComparison.Ordinal));
+        using var restarted = context.Provider();
+        Assert.Null(restarted.ReadCachedSnapshot().ObservedAt);
+        Assert.Equal(1, context.Handler.UsageCalls);
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshStartupAsync()).Status);
+        Assert.Equal(2, context.Handler.UsageCalls);
+    }
+
+    [Fact]
+    public async Task SnapshotEnvelopeFromAnotherAccountIsNeverHydrated()
+    {
+        using var context = new Context();
+        using (var first = context.Provider()) await first.RefreshAsync();
+        var path = Directory.GetFiles(context.Schedule).Single();
+        var saved = File.ReadAllText(path);
+        File.WriteAllText(path, saved.Replace(Path.GetFileNameWithoutExtension(path), "another-account-digest", StringComparison.Ordinal));
+        using var restarted = context.Provider();
+        Assert.Null(restarted.ReadCachedSnapshot().ObservedAt);
+        Assert.Null((await restarted.RefreshAsync()).ObservedAt);
+        Assert.Equal(1, context.Handler.UsageCalls);
+    }
+
+    [Theory]
+    [InlineData("not JSON")]
+    [InlineData("server error")]
+    public async Task FailedRefreshNeverOverwritesLastGoodStructuredSnapshot(string failure)
+    {
+        using var context = new Context();
+        using var provider = context.Provider();
+        var good = await provider.RefreshAsync();
+        context.Clock = Time.AddMinutes(6);
+        context.Handler.UsageBody = failure;
+        if (failure == "server error") context.Handler.Status = HttpStatusCode.InternalServerError;
+        Assert.Equal(QuotaStatus.Stale, (await provider.RefreshAsync()).Status);
+        using var restarted = context.Provider();
+        var restored = restarted.ReadCachedSnapshot();
+        Assert.Equal(good.ObservedAt, restored.ObservedAt);
+        Assert.Equal(good.Windows.ToArray(), restored.Windows.ToArray());
+        Assert.Equal(good.Credits, restored.Credits);
+        Assert.Equal(good.ResetCreditsAvailable, restored.ResetCreditsAvailable);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task AccountChangeOrCancellationDuringRequestNeverCommitsOldObservation(bool cancel)
+    {
+        using var context = new Context();
+        context.Handler.Block = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        context.Handler.UsageStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var provider = context.Provider();
+        var pending = provider.RefreshStartupAsync();
+        await context.Handler.UsageStarted.Task;
+        if (cancel) provider.Cancel(); else context.Credentials("other-token", "other-account");
+        context.Handler.Block.SetResult();
+        Assert.Null((await pending).ObservedAt);
+        Assert.False(Directory.Exists(context.Schedule));
+        Assert.Null(provider.ReadCachedSnapshot().ObservedAt);
+    }
+
+    [Theory]
+    [InlineData(HttpStatusCode.TooManyRequests)]
+    [InlineData(HttpStatusCode.ServiceUnavailable)]
+    public async Task OptionalResetServerGuidanceRemainsBindingWithoutDiscardingUsableObservation(HttpStatusCode status)
+    {
+        using var context = new Context();
+        context.Handler.ResetStatus = status;
+        context.Handler.ResetRetry = TimeSpan.FromMinutes(40);
+        using (var provider = context.Provider())
+        {
+            var good = await provider.RefreshStartupAsync();
+            Assert.Equal(QuotaStatus.Ok, good.Status);
+            Assert.Equal(Time, good.ObservedAt);
+            Assert.Equal(Time.AddMinutes(40), good.NextAllowedAt);
+        }
+        using var restarted = context.Provider();
+        context.Clock = Time.AddMinutes(40).AddTicks(-1);
+        Assert.Equal(Time, restarted.ReadCachedSnapshot().ObservedAt);
+        await restarted.RefreshStartupAsync();
+        Assert.Equal(1, context.Handler.UsageCalls);
+        Assert.Equal(1, context.Handler.ResetCalls);
+        context.Clock = Time.AddMinutes(40);
+        context.Handler.ResetStatus = HttpStatusCode.OK;
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshAsync()).Status);
+        Assert.Equal(2, context.Handler.UsageCalls);
+        Assert.Equal(2, context.Handler.ResetCalls);
+    }
+
+    private sealed class Context : IDisposable
+    {
+        private readonly string root = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
+        public string Schedule => Path.Combine(root, "schedule");
+        public DateTimeOffset Clock = Time;
+        public Handler Handler = new();
+        public Context() { Directory.CreateDirectory(root); Credentials("secret-token"); }
+        public void Credentials(string token, string account = "account-id")
+        {
+            Handler.Account = account;
+            File.WriteAllText(Path.Combine(root, "auth.json"), "{\"tokens\":{\"access_token\":\"" + token + "\",\"account_id\":\"" + account + "\"}}");
+        }
+        public void RemoveCredentials() => File.Delete(Path.Combine(root, "auth.json"));
+        public CodexQuotaProvider Provider() => new(Path.Combine(root, "auth.json"), Schedule, new HttpClient(Handler, false), () => Clock);
+        public void Dispose() => Directory.Delete(root, true);
+    }
+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls;
+        public int UsageCalls, ResetCalls;
+        public HttpStatusCode Status = HttpStatusCode.OK;
+        public TimeSpan? Retry;
+        public DateTimeOffset? RetryDate;
+        public TaskCompletionSource? Block;
+        public TaskCompletionSource? UsageStarted;
+        public string Account = "account-id";
+        public HttpStatusCode ResetStatus = HttpStatusCode.OK;
+        public string UsageBody = "{\"rate_limit\":{\"primary_window\":{\"used_percent\":0}},\"credits\":{\"balance\":\"19\"}}";
+        public string ResetBody = "{\"available_count\":2}";
+        public TimeSpan? ResetRetry;
+        public Exception? ResetException;
+        public TaskCompletionSource? ResetBlock, ResetStarted;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Interlocked.Increment(ref Calls);
+            Assert.Equal(HttpMethod.Get, request.Method);
+            Assert.Equal("https", request.RequestUri!.Scheme);
+            Assert.Equal("chatgpt.com", request.RequestUri.Host);
+            Assert.True(request.RequestUri.IsDefaultPort);
+            Assert.Equal("", request.RequestUri.Query);
+            Assert.Equal("application/json", request.Headers.Accept.Single().MediaType);
+            Assert.Equal("Bearer", request.Headers.Authorization?.Scheme);
+            Assert.False(string.IsNullOrEmpty(request.Headers.Authorization?.Parameter));
+            Assert.Equal(Account, request.Headers.GetValues("ChatGPT-Account-Id").Single());
+            var isReset = request.RequestUri.AbsolutePath == "/backend-api/wham/rate-limit-reset-credits";
+            if (isReset)
+            {
+                Interlocked.Increment(ref ResetCalls);
+                Assert.Equal("codex-1", request.Headers.GetValues("OpenAI-Beta").Single());
+                Assert.True(request.Headers.CacheControl?.NoCache);
+                Assert.True(request.Headers.CacheControl?.NoStore);
+                ResetStarted?.TrySetResult();
+                if (ResetBlock != null) await ResetBlock.Task.WaitAsync(cancellationToken);
+                if (ResetException != null) throw ResetException;
+                var resetResponse = new HttpResponseMessage(ResetStatus) { Content = new StringContent(ResetBody) };
+                if (ResetRetry != null) resetResponse.Headers.RetryAfter = new RetryConditionHeaderValue(ResetRetry.Value);
+                if (ResetStatus == HttpStatusCode.Redirect) resetResponse.Headers.Location = new Uri("https://untrusted.invalid/reset");
+                return resetResponse;
+            }
+            Assert.Equal("/backend-api/wham/usage", request.RequestUri.AbsolutePath);
+            Interlocked.Increment(ref UsageCalls);
+            UsageStarted?.TrySetResult();
+            if (Block != null) await Block.Task.WaitAsync(cancellationToken);
+            var response = new HttpResponseMessage(Status) { Content = new StringContent(UsageBody) };
+            if (Retry != null) response.Headers.RetryAfter = new RetryConditionHeaderValue(Retry.Value);
+            if (RetryDate != null) response.Headers.RetryAfter = new RetryConditionHeaderValue(RetryDate.Value);
+            if (Status == HttpStatusCode.Redirect) response.Headers.Location = new Uri("https://untrusted.invalid/usage");
+            return response;
+        }
+    }
+}
diff --git a/windows/tests/AgentSpeed.Core.Tests/QuotaColdStartTests.cs b/windows/tests/AgentSpeed.Core.Tests/QuotaColdStartTests.cs
