new file mode 100644
index 00000000..cb885543
--- /dev/null
+++ b/windows/tests/AgentSpeed.Presentation.Tests/QuotaFormatTests.cs
@@ -0,0 +1,87 @@
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaFormatTests
+{
+    private static readonly Localizer Loc = new(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+    private static CodexQuotaWindow Window(TimeSpan? duration, double? used = null) =>
+        new("main", "Codex", used, used is null ? null : 1 - used, used, null, duration);
+    private static CodexQuotaSnapshot Snapshot(CodexQuotaStatus status, CodexQuotaWindow[] windows, string? block = null) =>
+        new("codex", "Codex", "official", status, windows, "main", block, null, null, null, "local", null, null, false);
+
+    [Fact]
+    public void LabelsFollowDurationNotWindowSlot()
+    {
+        Assert.Equal("Weekly", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromDays(7))));
+        Assert.Equal("Session · 5h", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromHours(5))));
+        Assert.Equal("Monthly", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromDays(30))));
+        Assert.Equal("Window", QuotaFormat.WindowLabel(Loc, Window(null)));
+        Assert.Equal("Window", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.Zero)));
+    }
+
+    [Fact]
+    public void UnknownAndOverLimitAreNotClampedInText()
+    {
+        Assert.Equal("Unknown", QuotaFormat.Percent(Loc, null));
+        Assert.Equal(0d.ToString("P0", Loc.Culture), QuotaFormat.Percent(Loc, 0));
+        Assert.Equal(1.25.ToString("P0", Loc.Culture), QuotaFormat.Percent(Loc, 1.25));
+    }
+
+    [Theory]
+    [InlineData(-.2, 0, false)]
+    [InlineData(.89, .89, false)]
+    [InlineData(.9, .9, true)]
+    [InlineData(1.25, 1, true)]
+    public void AccountBarClampsFillButUsesActualValueForWarning(double used, double fill, bool warning)
+    {
+        Assert.Equal(fill, QuotaFormat.BarFill(used), 6);
+        Assert.Equal(warning, QuotaFormat.BarIsWarning(used));
+    }
+
+    [Fact]
+    public void SuccessfulCooldownWithoutCachedObservationShowsWaitingNotError()
+    {
+        var waiting = Snapshot(CodexQuotaStatus.Error, []) with { WaitingForRefresh = true };
+        Assert.Equal("Waiting for refresh", QuotaFormat.Status(Loc, true, waiting));
+        Assert.Equal("Could not load quota", QuotaFormat.Status(Loc, true, waiting with { WaitingForRefresh = false }));
+        Assert.Equal("Network access is off.", QuotaFormat.Status(Loc, false, waiting));
+    }
+
+    [Fact]
+    public void OfflineNotchRetainsObservationButMarksItStale()
+    {
+        var observed = new DateTimeOffset(2026, 1, 2, 3, 4, 0, TimeSpan.Zero);
+        var reading = Snapshot(CodexQuotaStatus.Ok, [Window(TimeSpan.FromHours(5), .34)]) with { ObservedAt = observed };
+        var offline = QuotaFormat.NotchProjection(Loc, false, reading);
+        Assert.Equal("stale", offline.Status);
+        Assert.Equal(.34, offline.Windows.Single().UsedFraction);
+        Assert.Equal(observed, offline.ObservedAt);
+        Assert.Equal("Network access is off.", offline.Note);
+        Assert.Equal("ok", QuotaFormat.NotchProjection(Loc, true, reading).Status);
+    }
+
+    [Fact]
+    public void OfflineWithoutObservationDoesNotInventAReading()
+    {
+        var offline = QuotaFormat.NotchProjection(Loc, false, null);
+        Assert.Equal("none", offline.Status);
+        Assert.Empty(offline.Windows);
+        Assert.Null(offline.ObservedAt);
+        Assert.Equal("Network access is off.", offline.Note);
+    }
+
+    [Fact]
+    public void FlyoutAppearsOnlyForAttentionStates()
+    {
+        Assert.False(QuotaFormat.ShowFlyoutSummary(null));
+        Assert.False(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.Ok, [])));
+        Assert.False(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.Ok, [Window(null)])));
+        Assert.False(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.Ok, [Window(null, .89)])));
+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.Ok, [Window(null, .9)])));
+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.NeedsAuth, [])));
+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(CodexQuotaStatus.Ok, [], "blocked")));
+    }
+}
