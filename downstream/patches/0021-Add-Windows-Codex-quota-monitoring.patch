@@ -0,0 +1,209 @@
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchGeometryTests
+{
+
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void UprightCellFitsInsideExpandedBodyOnEveryEdge(string edge)
+    {
+        bool horizontal = edge is "top" or "bottom";
+        var cell = new QuotaNotchGeometry.Cell(52, 24, 52);
+        var layout = new QuotaNotchGeometry.ContentLayout(horizontal, cell);
+        var main = QuotaNotchGeometry.CreateMain(1, layout);
+        var envelope = QuotaNotchGeometry.CreateEnvelope(layout);
+        var transform = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(main));
+        var content = layout.Bounds(main, transform, 0, edge == "bottom");
+        var corners = new[] { transform.Apply(new(0, main.BodyStart)), transform.Apply(new(main.BodyDepth, main.BodyStart)),
+            transform.Apply(new(0, main.BodyEnd)), transform.Apply(new(main.BodyDepth, main.BodyEnd)) };
+        double left = corners.Min(p => p.X), right = corners.Max(p => p.X);
+        double top = corners.Min(p => p.Y), bottom = corners.Max(p => p.Y);
+        Assert.InRange(content.X, left, right - content.Width);
+        Assert.InRange(content.Y, top, bottom - content.Height);
+    }
+
+    [Theory]
+    [InlineData("left", 10, 20)]
+    [InlineData("right", 60, 20)]
+    [InlineData("top", 20, 10)]
+    [InlineData("bottom", 20, 60)]
+    public void EdgeTransformsKeepTheScreenEdgeAndAlongAxis(string edge, double x, double y)
+    {
+        var point = QuotaNotchGeometry.EdgeTransform(edge, 70).Apply(new(10, 20));
+        Assert.Equal(x, point.X);
+        Assert.Equal(y, point.Y);
+    }
+
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void EnvelopeKeepsBodyAnchoredThroughoutMorph(string edge)
+    {
+        bool horizontal = edge is "top" or "bottom";
+        var envelope = QuotaNotchGeometry.CreateEnvelope(new QuotaNotchGeometry.ContentLayout(horizontal, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var expanded = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(horizontal, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var fixedGrip = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(expanded)).Apply(expanded.Grip);
+        foreach (double progress in new[] { 0d, .3, 1d })
+        {
+            var shape = QuotaNotchGeometry.CreateMain(progress, new QuotaNotchGeometry.ContentLayout(horizontal, new QuotaNotchGeometry.Cell(52, 24, 52)));
+            var point = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(shape))
+                .Apply(new(0, (shape.BodyStart + shape.BodyEnd) / 2));
+            Assert.Equal(envelope.BodyCenterAlong, horizontal ? point.X : point.Y, 4);
+            Assert.True(envelope.Offset(shape) >= .5 - 1e-9);
+            Assert.True(shape.Length + envelope.Offset(shape) <= envelope.Length - .5 + 1e-9);
+            Assert.True(shape.Depth <= envelope.Depth - .5 + 1e-9);
+            var grip = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(shape)).Apply(shape.Grip);
+            Assert.Equal(fixedGrip.X, grip.X, 6);
+            Assert.Equal(fixedGrip.Y, grip.Y, 6);
+        }
+    }
+
+    [Fact]
+    public void TailClampsOutsideRoundedCornersAndTallCardIsNotCropped()
+    {
+        var low = QuotaNotchGeometry.CreateCard(300, 246, -100);
+        var high = QuotaNotchGeometry.CreateCard(300, 246, 1000);
+        Assert.Equal(300, low.Width);
+        Assert.Equal(16 + QuotaNotchGeometry.TailWidth / 2, low.TipAlong, 4);
+        Assert.Equal(246 - 16 - QuotaNotchGeometry.TailWidth / 2, high.TipAlong, 4);
+    }
+
+    [Fact]
+    public void GripCorridorConnectsToHitBoxInsideBodyDepth()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var hit = QuotaNotchGeometry.GetGripHitBox(main);
+        var crossing = QuotaNotchGeometry.GetGripCorridor(main);
+        Assert.Equal(hit.Y + hit.Height, crossing.Y + crossing.Height, 6);
+        Assert.True(hit.X + hit.Width < main.BodyDepth);
+    }
+
+
+    [Fact]
+    public void ReferenceDropSeparatesInOrderAndHasNoLiquidAtRest()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var middle = QuotaNotchGeometry.CreateGrip(main, new(.4));
+        Assert.True(middle.Liquid);
+        Assert.NotNull(middle.NeckPath);
+        Assert.True(middle.Core.Radius > 0);
+        Assert.True(QuotaNotchGeometry.GetGripDot(main, new(.4), 0).Radius < QuotaNotchGeometry.GetGripDot(main, new(.4), 5).Radius);
+        var final = QuotaNotchGeometry.CreateGrip(main, new(1));
+        Assert.False(final.Liquid);
+        Assert.Null(final.NeckPath);
+        Assert.Equal(0, final.Core.Radius);
+        Assert.Equal(main.Grip, final.Center);
+    }
+
+    [Fact]
+    public void EveryDropAndHoverFrameFitsStableCanvasWithoutInterceptingUnusedSpace()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var envelope = QuotaNotchGeometry.CreateEnvelope(new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        for (int step = 1; step <= 100; step++)
+            foreach (double hover in new[] { 0d, 1.2 })
+            {
+                var frame = new QuotaNotchGeometry.GripFrame(step / 100d, hover);
+                var hit = QuotaNotchGeometry.GetGripHitBox(main, frame);
+                Assert.True(hit.X >= 0 && hit.X + hit.Width <= envelope.Depth);
+                Assert.True(hit.Y + hit.Height + envelope.Offset(main) <= envelope.Length);
+            }
+        Assert.Equal(0, QuotaNotchGeometry.GetGripHitBox(main, default).Width);
+        Assert.Equal(0, QuotaNotchGeometry.GetGripCorridor(main, default).Width);
+    }
+
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void ArcAndDotsUseOneStableScreenAnchorAndEdgeRotatesTheGrid(string edge)
+    {
+        bool horizontal = edge is "top" or "bottom";
+        var envelope = QuotaNotchGeometry.CreateEnvelope(new QuotaNotchGeometry.ContentLayout(horizontal, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        QuotaNotchGeometry.Point? fixedCenter = null;
+        foreach (double expansion in new[] { 0d, .3, 1d })
+        {
+            var main = QuotaNotchGeometry.CreateMain(expansion, new QuotaNotchGeometry.ContentLayout(horizontal, new QuotaNotchGeometry.Cell(52, 24, 52)));
+            var matrix = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(main));
+            var center = matrix.Apply(QuotaNotchGeometry.GetOrbCenter(main));
+            if (fixedCenter.HasValue)
+            {
+                Assert.Equal(fixedCenter.Value.X, center.X, 6);
+                Assert.Equal(fixedCenter.Value.Y, center.Y, 6);
+            }
+            fixedCenter = center;
+            var first = matrix.Apply(QuotaNotchGeometry.GetGripDot(main, 0).Center);
+            var next = matrix.Apply(QuotaNotchGeometry.GetGripDot(main, 1).Center);
+            Assert.Equal(horizontal ? 0 : QuotaNotchGeometry.GripPitch, Math.Abs(next.X - first.X), 6);
+            Assert.Equal(horizontal ? QuotaNotchGeometry.GripPitch : 0, Math.Abs(next.Y - first.Y), 6);
+        }
+    }
+
+    [Theory]
+    [InlineData(.0001, "<0.1", ">99.9")]
+    [InlineData(.995, "99.5", "0.5")]
+    [InlineData(.126, "13", "87")]
+    [InlineData(1.2, "120", "0")]
+    public void DisplayHalvesMatchTheReference(double used, string spent, string remaining)
+    {
+        Assert.Equal((spent, remaining), QuotaNotchGeometry.PercentHalves(used));
+    }
+
+    [Theory]
+    [InlineData(-.2, 1, 0)]
+    [InlineData(.5, .5, 1)]
+    [InlineData(.7, .3, 2)]
+    [InlineData(1.2, 0, 2)]
+    public void RemainingAndWarningBandsFollowUsedFraction(double used, double remaining, int tone)
+    {
+        Assert.Equal(remaining, QuotaNotchGeometry.RemainingFill(used), 6);
+        Assert.Equal(tone, QuotaNotchGeometry.Tone(used));
+    }
+    [Theory]
+    [InlineData("left")]
+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void MixedMeasuredCellsUseTheirOwnExtentAndKeepStableGrip(string edge)
+    {
+        bool horizontal = edge is "top" or "bottom";
+        QuotaNotchGeometry.Cell[] cells = [new(52, 19, 52), new(91, 31, 58), new(90, 47, 64), new(128, 83, 88)];
+        for (int count = 1; count <= cells.Length; count++)
+        {
+            var layout = new QuotaNotchGeometry.ContentLayout(horizontal, cells[..count]);
+            var envelope = QuotaNotchGeometry.CreateEnvelope(layout);
+            QuotaNotchGeometry.Point? grip = null;
+            foreach (double expansion in new[] { 0d, .3, 1d })
+            {
+                var main = QuotaNotchGeometry.CreateMain(expansion, layout);
+                var transform = QuotaNotchGeometry.EdgeTransform(edge, envelope.Depth, envelope.Offset(main));
+                var anchor = transform.Apply(main.Grip);
+                if (grip is { } previous) { Assert.Equal(previous.X, anchor.X, 6); Assert.Equal(previous.Y, anchor.Y, 6); }
+                grip = anchor;
+                if (expansion != 1) continue;
+                for (int i = 0; i < layout.Cells.Count; i++)
+                {
+                    var box = layout.Bounds(main, transform, i, edge == "bottom");
+                    Assert.Equal(layout.Cells[i].ContentWidth, box.Width);
+                    Assert.Equal(layout.Cells[i].ContentHeight, box.Height);
+                    Assert.InRange(box.X, 0, (horizontal ? envelope.Length : envelope.Depth) - box.Width);
+                    Assert.InRange(box.Y, 0, (horizontal ? envelope.Depth : envelope.Length) - box.Height);
+                    if (i == 0) continue;
+                    var previousBox = layout.Bounds(main, transform, i - 1, edge == "bottom");
+                    Assert.Equal(QuotaNotchGeometry.CellGap, horizontal ? box.X - previousBox.X - previousBox.Width : box.Y - previousBox.Y - previousBox.Height, 6);
+                }
+                var expected = 2 * QuotaNotchGeometry.ContentPadding + layout.Cells.Sum(cell => horizontal ? cell.ContentWidth : cell.ContentHeight)
+                    + (layout.Cells.Count - 1) * QuotaNotchGeometry.CellGap;
+                Assert.Equal(Math.Max(80, expected), main.BodyEnd - main.BodyStart, 6);
+            }
+        }
+    }
+}
