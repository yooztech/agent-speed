diff --git a/windows/tests/AgentSpeed.Core.Tests/CodexQuotaProviderTests.cs b/windows/tests/AgentSpeed.Core.Tests/CodexQuotaProviderTests.cs
new file mode 100644
index 00000000..023d27d9
--- /dev/null
+++ b/windows/tests/AgentSpeed.Core.Tests/CodexQuotaProviderTests.cs
@@ -0,0 +1,184 @@
+using System.Net;
+using System.Net.Http.Headers;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class CodexQuotaProviderTests
+{
+    private static readonly DateTimeOffset Time = new(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    [Fact]
+    public void ParsesIndependentWindowsAndCreditsWithoutClamping()
+    {
+        var snapshot = CodexQuotaProvider.Parse("""
+            {"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":125,"limit_window_seconds":604800},"secondary_window":{"used_percent":0,"limit_window_seconds":18000,"reset_after_seconds":60}},
+             "additional_rate_limits":[null,{"metered_feature":"image","rate_limit":{"primary_window":{"used_percent":null}}}],
+             "code_review_rate_limit":{"primary_window":{"limit_window_seconds":18000}},
+             "credits":{"balance":"0","has_credits":false},"spend_control":{"individual_limit":{"limit":"10.5","used":"12","used_percent":120}}}
+            """, Time);
+        Assert.Equal("plus", snapshot.Plan);
+        Assert.Equal(4, snapshot.Windows.Count);
+        Assert.StartsWith("main:604800", snapshot.HeadlineId);
+        Assert.Equal(1.25, snapshot.Windows[0].UsedFraction);
+        Assert.Equal(-0.25, snapshot.Windows[0].Remaining);
+        Assert.Equal(0, snapshot.Windows[1].UsedFraction);
+        Assert.Equal(Time.AddSeconds(60), snapshot.Windows[1].ResetAt);
+        Assert.Null(snapshot.Windows[2].UsedFraction);
+        Assert.StartsWith("code_review:", snapshot.Windows[3].Id);
+        Assert.Equal("0", snapshot.Credits!.Balance);
+        Assert.Equal(1.2, snapshot.Credits.UsedFraction);
+    }
+
+    [Fact]
+    public void MissingMainDoesNotPromoteExtraAndSameDurationIdsAreUnique()
+    {
+        var snapshot = CodexQuotaProvider.Parse("""
+            {"rate_limit":{"primary_window":null,"secondary_window":null},"additional_rate_limits":[{"limit_name":"x","rate_limit":{"primary_window":{"limit_window_seconds":5},"secondary_window":{"limit_window_seconds":5}}}]}
+            """, Time);
+        Assert.Null(snapshot.HeadlineId);
+        Assert.Equal(2, snapshot.Windows.Select(w => w.Id).Distinct().Count());
+    }
+
+    [Fact]
+    public async Task SuccessfulSchedulePersistsWithoutPersistingObservationOrCredentials()
+    {
+        using var context = new Context();
+        using (var provider = context.Provider())
+        {
+            var result = await provider.RefreshAsync();
+            Assert.Equal(CodexQuotaStatus.Ok, result.Status);
+            Assert.Equal(Time.AddMinutes(5), result.NextAllowedAt);
+            Assert.Equal(CodexQuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+            Assert.Equal(1, context.Handler.Calls);
+        }
+        using var restarted = context.Provider();
+        var waiting = await restarted.RefreshAsync();
+        Assert.Equal(CodexQuotaStatus.Error, waiting.Status);
+        Assert.True(waiting.WaitingForRefresh);
+        var saved = File.ReadAllText(Directory.GetFiles(context.Schedule).Single());
+        Assert.DoesNotContain("secret-token", saved);
+        Assert.DoesNotContain("account-id", saved);
+    }
+
+    [Theory]
+    [InlineData(HttpStatusCode.OK)]
+    [InlineData(HttpStatusCode.TooManyRequests)]
+    [InlineData(HttpStatusCode.Unauthorized)]
+    public async Task FailedSchedulePersistenceStillPreventsRepeatRequests(HttpStatusCode status)
+    {
+        using var context = new Context();
+        File.WriteAllText(context.Schedule, "not a directory");
+        context.Handler.Status = status;
+        using var provider = context.Provider();
+        await provider.RefreshAsync();
+        await provider.RefreshAsync();
+        Assert.Equal(1, context.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task MissingCredentialsNeverRequestsEndpoint()
+    {
+        using var context = new Context();
+        context.RemoveCredentials();
+        using var provider = context.Provider();
+        Assert.Equal(CodexQuotaStatus.NeedsAuth, (await provider.RefreshAsync()).Status);
+        Assert.Equal(0, context.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task RetryAfterHttpDateIsRespected()
+    {
+        using var context = new Context();
+        context.Handler.Status = HttpStatusCode.TooManyRequests;
+        context.Handler.RetryDate = Time.AddMinutes(12);
+        using var provider = context.Provider();
+        var result = await provider.RefreshAsync();
+        Assert.Equal(Time.AddMinutes(12), result.NextAllowedAt);
+    }
+
+    [Fact]
+    public async Task RateLimitIsStaleAndRestartIsErrorNotWaiting()
+    {
+        using var context = new Context();
+        using var provider = context.Provider();
+        var first = await provider.RefreshAsync();
+        context.Clock = Time.AddMinutes(6);
+        context.Handler.Status = HttpStatusCode.TooManyRequests;
+        context.Handler.Retry = TimeSpan.FromMinutes(10);
+        var stale = await provider.RefreshAsync();
+        Assert.Equal(CodexQuotaStatus.Stale, stale.Status);
+        Assert.Equal(first.ObservedAt, stale.ObservedAt);
+        Assert.Equal(context.Clock.AddMinutes(10), stale.NextAllowedAt);
+        using var restarted = context.Provider();
+        var error = await restarted.RefreshAsync();
+        Assert.Equal(CodexQuotaStatus.Error, error.Status);
+        Assert.False(error.WaitingForRefresh);
+        Assert.Equal(2, context.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task RejectedCredentialDoesNotRetryUntilChanged()
+    {
+        using var context = new Context();
+        context.Handler.Status = HttpStatusCode.Unauthorized;
+        using var provider = context.Provider();
+        Assert.Equal(CodexQuotaStatus.NeedsAuth, (await provider.RefreshAsync()).Status);
+        Assert.Equal(CodexQuotaStatus.NeedsAuth, (await provider.RefreshAsync()).Status);
+        Assert.Equal(1, context.Handler.Calls);
+        var saved = File.ReadAllText(Directory.GetFiles(context.Schedule).Single());
+        Assert.DoesNotContain("secret-token", saved);
+        Assert.DoesNotContain("account-id", saved);
+        context.Credentials("new-token");
+        context.Handler.Status = HttpStatusCode.OK;
+        Assert.Equal(CodexQuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        Assert.Equal(2, context.Handler.Calls);
+    }
+
+    [Fact]
+    public async Task ConcurrentRefreshesShareRequest()
+    {
+        using var context = new Context();
+        context.Handler.Block = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var provider = context.Provider();
+        var first = provider.RefreshAsync();
+        var second = provider.RefreshAsync();
+        context.Handler.Block.SetResult();
+        await Task.WhenAll(first, second);
+        Assert.Equal(1, context.Handler.Calls);
+    }
+
+    private sealed class Context : IDisposable
+    {
+        private readonly string root = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
+        public string Schedule => Path.Combine(root, "schedule");
+        public DateTimeOffset Clock = Time;
+        public Handler Handler = new();
+        public Context() { Directory.CreateDirectory(root); Credentials("secret-token"); }
+        public void Credentials(string token) => File.WriteAllText(Path.Combine(root, "auth.json"), "{\"tokens\":{\"access_token\":\"" + token + "\",\"account_id\":\"account-id\"}}");
+        public void RemoveCredentials() => File.Delete(Path.Combine(root, "auth.json"));
+        public CodexQuotaProvider Provider() => new(Path.Combine(root, "auth.json"), Schedule, new HttpClient(Handler, false), () => Clock);
+        public void Dispose() => Directory.Delete(root, true);
+    }
+    private sealed class Handler : HttpMessageHandler
+    {
+        public int Calls;
+        public HttpStatusCode Status = HttpStatusCode.OK;
+        public TimeSpan? Retry;
+        public DateTimeOffset? RetryDate;
+        public TaskCompletionSource? Block;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Interlocked.Increment(ref Calls);
+            Assert.Equal("chatgpt.com", request.RequestUri!.Host);
+            Assert.Equal("application/json", request.Headers.Accept.Single().MediaType);
+            Assert.Equal("Bearer", request.Headers.Authorization?.Scheme);
+            Assert.False(string.IsNullOrEmpty(request.Headers.Authorization?.Parameter));
+            Assert.Equal("account-id", request.Headers.GetValues("ChatGPT-Account-Id").Single());
+            if (Block != null) await Block.Task.WaitAsync(cancellationToken);
+            var response = new HttpResponseMessage(Status) { Content = new StringContent("{\"rate_limit\":{\"primary_window\":{\"used_percent\":0}}}") };
+            if (Retry != null) response.Headers.RetryAfter = new RetryConditionHeaderValue(Retry.Value);
+            if (RetryDate != null) response.Headers.RetryAfter = new RetryConditionHeaderValue(RetryDate.Value);
+            return response;
+        }
+    }
+}
