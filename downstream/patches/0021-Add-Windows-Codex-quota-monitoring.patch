+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchGeometryRasterTests
+{
+    [Fact]
+    public void EvenOddContoursLeaveTheHoleTransparentAtAnyScale()
+    {
+        IReadOnlyList<QuotaNotchGeometryRaster.Point> outer = [new(0,0), new(10,0), new(10,10), new(0,10)];
+        IReadOnlyList<QuotaNotchGeometryRaster.Point> hole = [new(3,3), new(7,3), new(7,7), new(3,7)];
+        IReadOnlyList<IReadOnlyList<QuotaNotchGeometryRaster.Point>> contours = [outer, hole];
+        var alpha = new byte[20 * 20];
+        QuotaNotchGeometryRaster.Rasterize(contours, 20, 20, 0, 0, 2, alpha, new());
+        Assert.Equal(255, alpha[2 * 20 + 2]);
+        Assert.Equal(0, alpha[10 * 20 + 10]);
+        Assert.Equal(255, alpha[16 * 20 + 16]);
+    }
+
+    [Fact]
+    public void CoverageAccountsForPartialPixelsAndNegativeOrigins()
+    {
+        IReadOnlyList<QuotaNotchGeometryRaster.Point> square = [new(.5,0), new(1.5,0), new(1.5,1), new(.5,1)];
+        IReadOnlyList<IReadOnlyList<QuotaNotchGeometryRaster.Point>> contours = [square];
+        var alpha = new byte[4];
+        QuotaNotchGeometryRaster.Rasterize(contours, 4, 1, -1, 0, 1, alpha, new());
+        Assert.Equal(new byte[] { 0, 127, 127, 0 }, alpha);
+    }
+}
