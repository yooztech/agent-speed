index 0000000000000000000000000000000000000000..b38e173683618666a2b50aaddd78c3cbaab2df2d
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaFormat.cs
@@ -0,0 +1,121 @@
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Retains raw usage windows; render their remaining fraction, without reinterpreting UsedFraction.</summary>
+public sealed record QuotaNotchProjection(string Status, IReadOnlyList<QuotaWindow> Windows, DateTimeOffset? ObservedAt, string Note);
+
+/// <summary>Consumer-visible subscription quota labels and percentages.</summary>
+public static class QuotaFormat
+{
+    public static bool ShowFlyoutSummary(QuotaSnapshot? snapshot) => snapshot is not null &&
+        (snapshot.Status == QuotaStatus.NeedsAuth || snapshot.Block is not null ||
+         snapshot.Windows.Any(window => window.UsedFraction >= .9));
+
+    /// <summary>A provider's declared headline, never a different window promoted in its place.</summary>
+    public static QuotaWindow? Headline(QuotaSnapshot? snapshot) => snapshot?.HeadlineId is { } id
+        ? snapshot.Windows.FirstOrDefault(window => window.Id == id) : null;
+    /// <summary>Only successful observations get an age; transport and authentication states stay explicit.</summary>
+    public static string Status(Localizer loc, bool networkEnabled, QuotaSnapshot? snapshot, DateTimeOffset now)
+    {
+        if (!networkEnabled) return loc["win.quota.offline"];
+        if (snapshot is null) return loc["win.quota.empty"];
+        if (snapshot.WaitingForRefresh) return loc["win.quota.waiting"];
+        if (snapshot.Status != QuotaStatus.Ok)
+            return loc["win.quota." + snapshot.Status.ToString().ToLowerInvariant()];
+        if (snapshot.ObservedAt is not { } observedAt) return loc["win.quota.unknown"];
+        var age = now - observedAt;
+        if (age < TimeSpan.FromMinutes(1)) return loc["win.quota.justNow"];
+        var (unit, count) = age < TimeSpan.FromHours(1) ? ("minutesAgo", (int)age.TotalMinutes)
+            : age < TimeSpan.FromDays(1) ? ("hoursAgo", (int)age.TotalHours)
+            : ("daysAgo", (int)age.TotalDays);
+        return loc.Format("win.quota." + unit, count.ToString(loc.Culture));
+    }
+
+    /// <summary>Wake at the observation's next minute boundary, not a minute after opening its display.</summary>
+    public static TimeSpan ObservationAgeRefreshDelay(DateTimeOffset? observedAt, DateTimeOffset now)
+    {
+        long ageTicks = observedAt is { } observed ? Math.Max(0, (now - observed).Ticks) : 0;
+        // DispatcherTimer uses millisecond deadlines; do not round a fractional boundary down to a zero-delay loop.
+        return TimeSpan.FromTicks(Math.Max(TimeSpan.TicksPerMillisecond,
+            TimeSpan.TicksPerMinute - ageTicks % TimeSpan.TicksPerMinute));
+    }
+
+    /// <summary>Retain previously observed windows offline, but never present them as fresh.</summary>
+    public static QuotaNotchProjection NotchProjection(Localizer loc, bool networkEnabled, QuotaSnapshot? snapshot, DateTimeOffset now)
+    {
+        var windows = snapshot?.Windows ?? Array.Empty<QuotaWindow>();
+        var status = !networkEnabled ? (windows.Count > 0 ? "stale" : "none") : snapshot?.Status switch
+        {
+            QuotaStatus.Ok => "ok", QuotaStatus.Stale => "stale",
+            QuotaStatus.NeedsAuth => "needsAuth", _ => "none"
+        };
+        return new(status, windows, snapshot?.ObservedAt, Status(loc, networkEnabled, snapshot, now));
+    }
+
+
+    public static string Percent(Localizer loc, double? value) => value is { } v ? v.ToString("P0", loc.Culture) : loc["win.quota.unknown"];
+
+    /// <summary>A stable local absolute timestamp; it never becomes a relative “updated ago” label.</summary>
+    public static string AbsoluteTime(Localizer loc, DateTimeOffset value) => value.ToLocalTime().ToString("g", loc.Culture);
+
+    /// <summary>Time until the observed reset, not the provider's quota-window length.</summary>
+    public static string ResetCountdown(Localizer loc, DateTimeOffset? resetAt, DateTimeOffset now)
+    {
+        if (resetAt is not { } at) return loc["win.quota.unknown"];
+        var remaining = at - now;
+        if (remaining <= TimeSpan.Zero) return loc["win.quota.resetPendingRefresh"];
+        if (remaining < TimeSpan.FromMinutes(1)) return loc["win.quota.resetUnderMinute"];
+        var days = (int)remaining.TotalDays;
+        var hours = remaining.Hours;
+        var minutes = remaining.Minutes;
+        string? duration = null;
+        void Add(string key, int count)
+        {
+            if (count == 0) return;
+            var part = loc.Format("win.quota." + key, count.ToString(loc.Culture));
+            duration = duration is null ? part : loc.Format("win.quota.durationJoin", duration, part);
+        }
+        Add("countdownDays", days); Add("countdownHours", hours); Add("countdownMinutes", minutes);
+        return loc.Format("win.quota.resetIn", duration!);
+    }
+
+    public static string ResetTime(Localizer loc, DateTimeOffset resetAt, DateTimeOffset now) =>
+        loc.Format("win.quota.resetWithCountdown", AbsoluteTime(loc, resetAt), ResetCountdown(loc, resetAt, now));
+
+    /// <summary>Unknown usage stays unknown; text can retain negative remaining for an over-limit reading.</summary>
+    public static double? RemainingFraction(double? usedFraction) => 1 - usedFraction;
+
+    /// <summary>The bar is full when untouched and drains with use; callers must not draw a bar for unknown usage.</summary>
+    public static double BarFill(double usedFraction) => Math.Clamp(1 - usedFraction, 0, 1);
+
+    /// <summary>The Settings account card switches from blue to amber near exhaustion.</summary>
+    public static bool BarIsWarning(double used) => used >= .9;
+
+    public static string WindowLabel(Localizer loc, QuotaWindow window, string? providerDisplayName = null)
+    {
+        var duration = window.Duration;
+        if (duration == TimeSpan.FromHours(5))
+        {
+            var fiveHours = loc["win.quota.fiveHourLimit"];
+            return IsOrdinaryLabel(window.Label, providerDisplayName) ? fiveHours : window.Label + " · " + fiveHours;
+        }
+        var key = duration is null || duration <= TimeSpan.Zero ? "window"
+            : duration == TimeSpan.FromDays(7) ? "weekly"
+            : duration >= TimeSpan.FromDays(28) && duration <= TimeSpan.FromDays(31) ? "monthly"
+            : duration <= TimeSpan.FromHours(24) ? "session" : "window";
+        var label = loc["win.quota." + key];
+        if (!IsOrdinaryLabel(window.Label, providerDisplayName))
+            label = window.Label + " · " + label;
+        if (duration is { } value && value > TimeSpan.Zero && value < TimeSpan.FromDays(1))
+            label += " · " + loc.Format("win.quota.hours", value.TotalHours.ToString("0.##", loc.Culture));
+        else if (duration is { } days && days >= TimeSpan.FromDays(1) && key == "window")
+            label += " · " + loc.Format("win.quota.days", days.TotalDays.ToString("0.##", loc.Culture));
+        return label;
+    }
+    private static bool IsOrdinaryLabel(string? label, string? providerDisplayName) =>
+        string.IsNullOrWhiteSpace(label) || string.Equals(label, providerDisplayName, StringComparison.Ordinal) ||
+        label is "Codex";
+
+}
