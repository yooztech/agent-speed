+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaFormatTests
+{
+    private static readonly Localizer Loc = new(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+    private static readonly DateTimeOffset Now = new(2026, 11, 15, 12, 0, 0, TimeSpan.Zero);
+    private static QuotaWindow Window(TimeSpan? duration, double? used = null) =>
+        new("main", "", used, used is null ? null : 1 - used, used, null, duration);
+    private static QuotaSnapshot Snapshot(QuotaStatus status, QuotaWindow[] windows, string? block = null) =>
+        new("codex", "Codex", "official", status, windows, "main", block, null, null, null, "local", null, null, false);
+
+    [Fact]
+    public void LabelsFollowDurationNotWindowSlot()
+    {
+        Assert.Equal("Weekly quota", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromDays(7))));
+        Assert.Equal("5h limit", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromHours(5))));
+        Assert.Equal("Monthly quota", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.FromDays(30))));
+        Assert.Equal("Window", QuotaFormat.WindowLabel(Loc, Window(null)));
+        Assert.Equal("Window", QuotaFormat.WindowLabel(Loc, Window(TimeSpan.Zero)));
+    }
+
+    [Fact]
+    public void ProviderNamesAreNotHardcodedAndFeatureLabelsRemainVisible()
+    {
+        var main = Window(TimeSpan.FromHours(5)) with { Label = "Service name" };
+        Assert.Equal("5h limit", QuotaFormat.WindowLabel(Loc, main, "Service name"));
+        Assert.Equal("Code review · 5h limit", QuotaFormat.WindowLabel(Loc, main with { Label = "Code review" }, "Service name"));
+    }
+
+    [Fact]
+    public void HeadlineUsesDeclaredIdWithoutPromotingAnotherWindow()
+    {
+        var first = Window(TimeSpan.FromDays(7), .8) with { Id = "weekly" };
+        var headline = Window(TimeSpan.FromHours(5), .2) with { Id = "session" };
+        var snapshot = Snapshot(QuotaStatus.Ok, [first, headline]) with { HeadlineId = "session" };
+        Assert.Same(headline, QuotaFormat.Headline(snapshot));
+        Assert.Null(QuotaFormat.Headline(snapshot with { HeadlineId = "missing" }));
+        Assert.Null(QuotaFormat.Headline(snapshot with { HeadlineId = null }));
+        Assert.Null(QuotaFormat.Headline(null));
+    }
+
+    [Fact]
+    public void UnknownAndOverLimitAreNotClampedInText()
+    {
+        Assert.Equal("Unknown", QuotaFormat.Percent(Loc, null));
+        Assert.Equal(0d.ToString("P0", Loc.Culture), QuotaFormat.Percent(Loc, 0));
+        Assert.Equal(1.25.ToString("P0", Loc.Culture), QuotaFormat.Percent(Loc, 1.25));
+    }
+
+    [Theory]
+    [InlineData(-.2, 1, false)]
+    [InlineData(0, 1, false)]
+    [InlineData(.1, .9, false)]
+    [InlineData(.89, .11, false)]
+    [InlineData(.9, .1, true)]
+    [InlineData(1, 0, true)]
+    [InlineData(1.25, 0, true)]
+    public void AccountBarDrainsWithUseButUsesActualValueForWarning(double used, double fill, bool warning)
+    {
+        Assert.Equal(fill, QuotaFormat.BarFill(used), 6);
+        Assert.Equal(warning, QuotaFormat.BarIsWarning(used));
+    }
+
+    [Fact]
+    public void RemainingTextAndBarAgreeWithoutInventingUnknownUsage()
+    {
+        var untouched = Window(TimeSpan.FromHours(5), 0);
+        Assert.Equal(1, QuotaFormat.RemainingFraction(untouched.UsedFraction));
+        Assert.Equal(1, QuotaFormat.BarFill(untouched.UsedFraction!.Value));
+        Assert.Equal(.66, QuotaFormat.RemainingFraction(.34)!.Value, 6);
+        Assert.Equal(-.25, QuotaFormat.RemainingFraction(1.25));
+        var unknown = Window(TimeSpan.FromHours(5));
+        Assert.Null(QuotaFormat.RemainingFraction(unknown.UsedFraction));
+        Assert.Equal("Unknown", QuotaFormat.Percent(Loc, QuotaFormat.RemainingFraction(unknown.UsedFraction)));
+    }
+
+    [Fact]
+    public void SuccessfulCooldownWithoutCachedObservationShowsWaitingNotError()
+    {
+        var waiting = Snapshot(QuotaStatus.Error, []) with { WaitingForRefresh = true };
+        Assert.Equal("Waiting for refresh", QuotaFormat.Status(Loc, true, waiting, Now));
+        Assert.Equal("Could not load quota", QuotaFormat.Status(Loc, true, waiting with { WaitingForRefresh = false }, Now));
+        Assert.Equal("Network access is off.", QuotaFormat.Status(Loc, false, waiting, Now));
+    }
+
+    [Fact]
+    public void OfflineNotchRetainsObservationButMarksItStale()
+    {
+        var observed = new DateTimeOffset(2026, 1, 2, 3, 4, 0, TimeSpan.Zero);
+        var reading = Snapshot(QuotaStatus.Ok, [Window(TimeSpan.FromHours(5), .34)]) with { ObservedAt = observed };
+        var offline = QuotaFormat.NotchProjection(Loc, false, reading, Now);
+        Assert.Equal("stale", offline.Status);
+        Assert.Equal(.34, offline.Windows.Single().UsedFraction);
+        Assert.Equal(observed, offline.ObservedAt);
+        Assert.Equal("Network access is off.", offline.Note);
+        Assert.Equal("ok", QuotaFormat.NotchProjection(Loc, true, reading, Now).Status);
+    }
+
+    [Fact]
+    public void OfflineWithoutObservationDoesNotInventAReading()
+    {
+        var offline = QuotaFormat.NotchProjection(Loc, false, null, Now);
+        Assert.Equal("none", offline.Status);
+        Assert.Empty(offline.Windows);
+        Assert.Null(offline.ObservedAt);
+        Assert.Equal("Network access is off.", offline.Note);
+    }
+
+    [Theory]
+    [InlineData(59, "Updated 1m ago")]
+    [InlineData(119, "Updated 2m ago")]
+    public void DisplayOpenedJustBeforeAgeBoundarySchedulesOnlyRemainingSecond(int seconds, string nextText)
+    {
+        var snapshot = Snapshot(QuotaStatus.Ok, []) with { ObservedAt = Now.AddSeconds(-seconds) };
+        var delay = QuotaFormat.ObservationAgeRefreshDelay(snapshot.ObservedAt, Now);
+        Assert.Equal(TimeSpan.FromSeconds(1), delay);
+        Assert.Equal(nextText, QuotaFormat.Status(Loc, true, snapshot, Now + delay));
+        Assert.Equal(TimeSpan.FromMinutes(1), QuotaFormat.ObservationAgeRefreshDelay(snapshot.ObservedAt, Now + delay));
+    }
+
+    [Fact]
+    public void AgeRefreshDelayRemainsPositiveAtExactAndFractionalMinuteBoundaries()
+    {
+        Assert.Equal(TimeSpan.FromMinutes(1), QuotaFormat.ObservationAgeRefreshDelay(Now, Now));
+        Assert.Equal(TimeSpan.FromMilliseconds(1), QuotaFormat.ObservationAgeRefreshDelay(Now.AddMinutes(-1).AddTicks(1), Now));
+        Assert.Equal(TimeSpan.FromMinutes(1), QuotaFormat.ObservationAgeRefreshDelay(Now.AddDays(1), Now));
+        Assert.Equal(TimeSpan.FromMinutes(1), QuotaFormat.ObservationAgeRefreshDelay(null, Now));
+    }
+
+    [Theory]
+    [InlineData(-86400, "Updated just now")]
+    [InlineData(0, "Updated just now")]
+    [InlineData(59, "Updated just now")]
+    [InlineData(60, "Updated 1m ago")]
+    [InlineData(119, "Updated 1m ago")]
+    [InlineData(3599, "Updated 59m ago")]
+    [InlineData(3600, "Updated 1h ago")]
+    [InlineData(86399, "Updated 23h ago")]
+    [InlineData(86400, "Updated 1d ago")]
+    [InlineData(172800, "Updated 2d ago")]
+    public void SuccessfulObservationUsesOriginalTimestampAndWholeAgeBoundaries(int seconds, string expected)
+    {
+        var observed = Now.AddSeconds(-seconds);
+        var snapshot = Snapshot(QuotaStatus.Ok, []) with { ObservedAt = observed };
+        Assert.Equal(expected, QuotaFormat.Status(Loc, true, snapshot, Now));
+        Assert.Equal(observed, snapshot.ObservedAt);
+    }
+
+
+    [Fact]
+    public void MissingObservationCannotClaimToBeFresh()
+    {
+        var snapshot = Snapshot(QuotaStatus.Ok, [Window(TimeSpan.FromHours(5), .2)]);
+        Assert.Equal("Unknown", QuotaFormat.Status(Loc, true, snapshot, Now));
+        Assert.Equal("Unknown", QuotaFormat.NotchProjection(Loc, true, snapshot, Now).Note);
+        Assert.Equal("No quota data yet.", QuotaFormat.Status(Loc, true, null, Now));
+    }
+
+    [Theory]
+    [InlineData(QuotaStatus.Stale, "Stale")]
+    [InlineData(QuotaStatus.NeedsAuth, "Sign in required")]
+    [InlineData(QuotaStatus.AccessDenied, "Access denied")]
+    [InlineData(QuotaStatus.Unsupported, "Unsupported")]
+    [InlineData(QuotaStatus.Error, "Could not load quota")]
+    public void ObservationAgeNeverOverridesActualFailureOrStaleStatus(QuotaStatus status, string expected)
+    {
+        var snapshot = Snapshot(status, []) with { ObservedAt = Now };
+        Assert.Equal(expected, QuotaFormat.Status(Loc, true, snapshot, Now));
+        Assert.Equal("Network access is off.", QuotaFormat.Status(Loc, false, snapshot, Now));
+    }
+
+    [Fact]
+    public void WaitingStatusTakesPrecedenceOverSuccessfulObservationAge()
+    {
+        var snapshot = Snapshot(QuotaStatus.Ok, []) with { ObservedAt = Now, WaitingForRefresh = true };
+        Assert.Equal("Waiting for refresh", QuotaFormat.Status(Loc, true, snapshot, Now));
+    }
+
+    [Fact]
+    public void NotchProjectionRecomputesAgeWithoutChangingObservationOrWindows()
+    {
+        var snapshot = Snapshot(QuotaStatus.Ok, [Window(TimeSpan.FromHours(5), .2)]) with { ObservedAt = Now };
+        var minute = QuotaFormat.NotchProjection(Loc, true, snapshot, Now.AddMinutes(1));
+        var hour = QuotaFormat.NotchProjection(Loc, true, snapshot, Now.AddHours(1));
+        Assert.Equal("Updated 1m ago", minute.Note);
+        Assert.Equal("Updated 1h ago", hour.Note);
+        Assert.Equal("ok", hour.Status);
+        Assert.Equal(Now, hour.ObservedAt);
+        Assert.Same(snapshot.Windows, hour.Windows);
+    }
+
+    [Fact]
+    public void FlyoutAppearsOnlyForAttentionStates()
+    {
+        Assert.False(QuotaFormat.ShowFlyoutSummary(null));
