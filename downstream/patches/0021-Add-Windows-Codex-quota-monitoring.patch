diff --git a/windows/src/AgentSpeed/Settings/QuotaSurface.cs b/windows/src/AgentSpeed/Settings/QuotaSurface.cs
new file mode 100644
index 00000000..003bcea6
--- /dev/null
+++ b/windows/src/AgentSpeed/Settings/QuotaSurface.cs
@@ -0,0 +1,235 @@
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Input;
+using System.Windows.Media;
+using System.Windows.Shapes;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Services;
+
+namespace AgentSpeed.Settings;
+
+/// <summary>Owns the local quota observation and its two optional UI surfaces.</summary>
+internal sealed class QuotaSurface : IDisposable
+{
+    private readonly SettingsService _settings;
+    private readonly Localizer _loc;
+    private readonly Action _openSettings;
+    private readonly DispatcherTimer _timer;
+    private CodexQuotaProvider? _provider;
+    private CodexQuotaSnapshot? _snapshot;
+    private Window? _panel;
+    private StackPanel? _page;
+    private bool _settingsOpen;
+    private bool _busy;
+    private bool _disposed;
+    private int _generation;
+
+    public QuotaSurface(SettingsService settings, Localizer loc, Action openSettings)
+    {
+        _settings = settings;
+        _loc = loc;
+        _openSettings = openSettings;
+        _timer = new DispatcherTimer { Interval = TimeSpan.FromMinutes(1) };
+        _timer.Tick += (_, _) => Refresh();
+        ApplySettings();
+    }
+
+    public UIElement CreatePage()
+    {
+        _page = new StackPanel();
+        Render();
+        return _page;
+    }
+    public void SetPageActive(bool active)
+    {
+        _settingsOpen = active;
+        UpdateTimer();
+        if (active) Refresh();
+    }
+
+
+    public void ClosePage()
+    {
+        _settingsOpen = false;
+        _page = null;
+        UpdateTimer();
+    }
+
+    public void ApplySettings()
+    {
+        if (_disposed) return;
+        if (!_settings.Current.NetworkEnabled && _provider is not null)
+        {
+            _generation++;
+            _provider.Cancel();
+            _provider.Dispose();
+            _provider = null;
+            _busy = false;
+        }
+        if (_settings.Current.ShowQuotaPanel && _panel is null)
+        {
+            _panel = new Window
+            {
+                Title = _loc["win.quota.title"], Width = 310, SizeToContent = SizeToContent.Height,
+                MinHeight = 100, Topmost = true, ShowInTaskbar = false, ShowActivated = false,
+                WindowStartupLocation = WindowStartupLocation.CenterScreen,
+                Background = SystemColors.WindowBrush, Foreground = SystemColors.WindowTextBrush
+            };
+            _panel.Closed += (_, _) =>
+            {
+                _panel = null;
+                if (!_disposed && _settings.Current.ShowQuotaPanel)
+                    _settings.Update(s => s with { ShowQuotaPanel = false });
+                UpdateTimer();
+            };
+            _panel.Show();
+            Refresh();
+        }
+        else if (!_settings.Current.ShowQuotaPanel && _panel is not null)
+        {
+            _panel.Close();
+        }
+        Render();
+        UpdateTimer();
+    }
+
+    public void Relocalize() => Render();
+    public void NetworkEnabled() { if (_panel is not null || _settingsOpen) Refresh(); }
+
+    private void UpdateTimer()
+    {
+        if (!_disposed && _settings.Current.NetworkEnabled && (_panel is not null || _settingsOpen)) _timer.Start();
+        else _timer.Stop();
+    }
+
+    private async void Refresh()
+    {
+        if (_disposed || _busy || !_settings.Current.NetworkEnabled) return;
+        _provider ??= new CodexQuotaProvider();
+        var provider = _provider;
+        var generation = _generation;
+        _busy = true;
+        Render();
+        try
+        {
+            var result = await provider.RefreshAsync();
+            if (!_disposed && generation == _generation && _settings.Current.NetworkEnabled) _snapshot = result;
+        }
+        catch (OperationCanceledException) { }
+        catch (ObjectDisposedException) { }
+        finally
+        {
+            if (!_disposed && generation == _generation)
+            {
+                _busy = false;
+                Render();
+            }
+        }
+    }
+
+    private string Text(string key) => _loc["win.quota." + key];
+    private string Percent(double? value) => value is { } v ? v.ToString("P0", _loc.Culture) : Text("unknown");
+    private string Date(DateTimeOffset value) => value.ToLocalTime().ToString("g", _loc.Culture);
+    private string Status() => !_settings.Current.NetworkEnabled ? Text("offline") : _snapshot is null ? Text("empty")
+        : Text(_snapshot.WaitingForRefresh ? "waiting" : _snapshot.Status.ToString().ToLowerInvariant());
+
+    private static TextBlock Line(string text, double size = 13) => new()
+    {
+        Text = text, FontSize = size, TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 3, 0, 3)
+    };
+
+    private void Render()
+    {
+        if (_disposed) return;
+        if (_panel is not null)
+        {
+            _panel.Title = Text("title");
+            var row = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(14) };
+            var headline = _snapshot?.Windows.FirstOrDefault(w => w.Id == _snapshot.HeadlineId);
+            var ring = new Grid { Width = 48, Height = 48, Margin = new Thickness(0, 0, 12, 0), VerticalAlignment = VerticalAlignment.Center };
+            ring.Children.Add(new Ellipse { Stroke = SystemColors.GrayTextBrush, Opacity = .25, StrokeThickness = 4 });
+            if (headline?.UsedFraction is double fraction)
+            {
+                var arc = new Ellipse { Stroke = SystemColors.HighlightBrush, StrokeThickness = 4,
+                    StrokeDashArray = new DoubleCollection { Math.Clamp(fraction, 0, 1) * 34.56, 34.56 },
+                    RenderTransform = new RotateTransform(-90, 24, 24) };
+                ring.Children.Add(arc);
+            }
+            ring.Children.Add(new TextBlock { Text = Percent(headline?.UsedFraction), FontSize = 10,
+                HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center });
+            row.Children.Add(ring);
+            var labels = new StackPanel { Width = 205 };
+            labels.Children.Add(Line(_snapshot?.Account ?? _snapshot?.DisplayName ?? "Codex", 14));
+            if (headline is not null)
+            {
+                labels.Children.Add(Line(WindowLabel(headline) + " · " + Percent(headline.UsedFraction), 12));
+                if (headline.ResetAt is { } reset) labels.Children.Add(Line(_loc.Format("win.quota.reset", Date(reset)), 12));
+            }
+            labels.Children.Add(Line(Status(), 12));
+            if (_snapshot?.WaitingForRefresh == true && _snapshot.NextAllowedAt is { } next)
+                labels.Children.Add(Line(Text("next") + ": " + Date(next), 12));
+            row.Children.Add(labels);
+            var button = new Button { Content = row, HorizontalContentAlignment = HorizontalAlignment.Left,
+                ToolTip = Text("title"), Cursor = Cursors.Hand };
+            button.Click += (_, _) => _openSettings();
+            _panel.Content = button;
+        }
+        if (_page is null) return;
+        _page.Children.Clear();
+        var toggle = new CheckBox { Content = Text("show"), IsChecked = _settings.Current.ShowQuotaPanel, Margin = new Thickness(0, 8, 0, 8) };
+        toggle.Click += (_, _) => _settings.Update(s => s with { ShowQuotaPanel = toggle.IsChecked == true });
+        _page.Children.Add(toggle);
+        _page.Children.Add(Line(Text("hint")));
+        var refresh = new Button { Content = Text("refresh"), IsEnabled = _settings.Current.NetworkEnabled && !_busy,
+            HorizontalAlignment = HorizontalAlignment.Left, Margin = new Thickness(0, 12, 0, 12), Padding = new Thickness(14, 5, 14, 5) };
+        refresh.Click += (_, _) => Refresh();
+        _page.Children.Add(refresh);
+        _page.Children.Add(Line(Status()));
+        if (_snapshot is not { } snapshot) return;
+        _page.Children.Add(Line(snapshot.DisplayName, 18));
+        Add("account", snapshot.Account);
+        Add("plan", snapshot.Plan);
+        Add("source", snapshot.Source);
+        Add("fidelity", Text("official"));
+        Add("block", snapshot.Block);
+        if (snapshot.ObservedAt is { } observed) Add("observed", Date(observed));
+        if (snapshot.NextAllowedAt is { } nextAt) Add("next", Date(nextAt));
+        if (snapshot.Credits is { } credits)
+        {
+            Add("credits", credits.Unlimited == true ? Text("unlimited") : credits.Balance ?? (credits.HasCredits is { } hasCredits ? Text(hasCredits ? "yes" : "no") : Text("unknown")));
+            if (credits.Limit is { } limit) Add("limit", limit.ToString(_loc.Culture));
+            if (credits.Used is { } used) _page.Children.Add(Line(_loc.Format("win.quota.used", used.ToString(_loc.Culture))));
+            if (credits.UsedFraction is { } usedFraction) _page.Children.Add(Line(_loc.Format("win.quota.used", Percent(usedFraction))));
+            if (credits.ResetAt is { } reset) _page.Children.Add(Line(_loc.Format("win.quota.reset", Date(reset))));
+        }
+        foreach (var window in snapshot.Windows)
+        {
+            _page.Children.Add(Line(WindowLabel(window), 16));
+            _page.Children.Add(Line(_loc.Format("win.quota.used", Percent(window.UsedFraction))));
+            _page.Children.Add(Line(_loc.Format("win.quota.remaining", Percent(window.Remaining))));
+            if (window.ResetAt is { } reset) _page.Children.Add(Line(_loc.Format("win.quota.reset", Date(reset))));
+            if (window.Duration is { } duration) Add("duration", duration.ToString());
+        }
+    }
+
+    private static string WindowLabel(CodexQuotaWindow window) => window.Duration is { } duration
+        ? window.Label + " · " + duration.ToString() : window.Label;
+
+    private void Add(string key, string? value)
+    {
+        if (value is not null) _page?.Children.Add(Line(Text(key) + ": " + value));
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _generation++;
+        _timer.Stop();
+        _provider?.Dispose();
+        _panel?.Close();
+        _page = null;
+    }
+}
