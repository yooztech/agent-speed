+    private void MainRelease(object sender, MouseButtonEventArgs e)
+    {
+        var local = e.GetPosition(_view);
+        PointerRelease(local, _view.PointToScreen(local));
+        e.Handled = true;
+    }
+
+    private void PointerRelease(Point local, Point screen)
+    {
