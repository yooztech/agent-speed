+        var center = QuotaNotchGeometry.GetOrbCenter(main);
+        var arc = transform.Apply(new(center.X - QuotaNotchGeometry.ArcRadius * Math.Sqrt(.5),
+            center.Y - QuotaNotchGeometry.ArcRadius * Math.Sqrt(.5)));
+        QuotaNotchGeometry.GripFrame[] frames = [new(Arc: 1), new(Arc: 1, Disc: .5),
+            new(Arc: 1, Disc: 1), new(.2, Arc: 1, Disc: .8), new(.4, Arc: 1, Disc: .4),
+            new(.7, Arc: 1), new(1, Arc: 1)];
+        foreach (var frame in frames)
+        {
+            view.Update(new(Array.Empty<QuotaSnapshot>(), ["codex"], true, dark, edge, 1, Grip: frame));
+            view.Measure(view.Extent); view.Arrange(new Rect(view.Extent));
+            var bitmap = new RenderTargetBitmap((int)Math.Ceiling(view.Extent.Width), (int)Math.Ceiling(view.Extent.Height), 96, 96, PixelFormats.Pbgra32);
+            bitmap.Render(view);
+            var point = new Point(arc.X, arc.Y);
+            Assert.Equal(255, AlphaAt(bitmap, point));
+            Assert.Equal(QuotaNotchTarget.Grip, view.HitTestTarget(point).Target);
+            Assert.True(view.InputGeometry.FillContains(point));
