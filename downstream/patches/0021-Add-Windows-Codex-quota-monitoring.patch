+using System.Globalization;
+using System.Reflection;
+using System.Text.RegularExpressions;
+using System.Windows;
+using System.Windows.Media;
+using System.Xml.Linq;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Settings;
+
+internal enum QuotaNotchTarget { None, Body, Cell, Grip, Card, Tail }
+internal readonly record struct QuotaNotchHit(QuotaNotchTarget Target, string? SourceId = null);
+internal readonly record struct QuotaNotchRenderState(IReadOnlyList<QuotaSnapshot> Snapshots,
+    IReadOnlyList<string> EnabledSources, bool Network, bool Dark, string Edge,
+    double Expansion, string? ActiveSource = null, double? CardAlongPosition = null,
+    QuotaNotchGeometry.GripFrame Grip = default, DateTimeOffset? DisplayNow = null, bool GripAcquired = false);
+
+/// <summary>Native vector rendering of Codenotch revision 835550a; see QuotaNotch.LICENSE.txt.</summary>
+internal sealed class QuotaNotchView : FrameworkElement
+{
+    private static readonly Typeface Regular = new("Segoe UI");
+    private static readonly Typeface Semibold = new(new FontFamily("Segoe UI"), FontStyles.Normal, FontWeights.SemiBold, FontStretches.Normal);
+    private static readonly Typeface Bold = new(new FontFamily("Segoe UI"), FontStyles.Normal, FontWeights.Bold, FontStretches.Normal);
+    private static readonly Geometry Codex = LoadCodex();
+    private readonly Localizer _loc;
+    private readonly bool _card;
+    private readonly List<(Geometry Shape, QuotaNotchHit Hit)> _targets = [];
+    private readonly Dictionary<(string Text, double Size, Typeface Face, Color Color, double Width, string Culture, double Dpi), FormattedText> _textCache = [];
+    private readonly QuotaNotchGoo _goo = new();
+    private DrawingGroup _drawing = new();
+    private QuotaNotchRenderState _state;
+    private bool _hasState;
+    private string? _lastLanguage;
+    private double _lastDpi;
+    private QuotaNotchGeometry.Main _main;
+    private QuotaNotchGeometry.Envelope _envelope;
+    private Matrix _matrix;
+    private string? _source;
+    private sealed record CellPresentation(string Id, QuotaSnapshot? Snapshot, QuotaWindow? Headline, FormattedText Reading);
+    private CellPresentation[] _cells = [];
+    private IReadOnlyList<QuotaSnapshot>? _cellSnapshots;
+    private IReadOnlyList<string>? _cellSources;
+    private string? _cellLanguage;
+    private double _cellDpi;
+    private bool _cellDark;
+    private QuotaNotchGeometry.ContentLayout _verticalLayout = new(false);
+    private QuotaNotchGeometry.ContentLayout _horizontalLayout = new(true);
+    internal QuotaNotchGeometry.ContentLayout ContentLayout => QuotaNotchLayout.Vertical(_state.Edge) ? _verticalLayout : _horizontalLayout;
+    public Size Extent { get; private set; }
+    public double BodyCenterAlong => _envelope.BodyCenterAlong;
+    public Geometry InputGeometry { get; private set; } = Geometry.Empty;
+    public Geometry GripInputGeometry { get; private set; } = Geometry.Empty;
+    public Geometry GripActivationGeometry { get; private set; } = Geometry.Empty;
+    private Geometry _entryInput = Geometry.Empty;
+    private (QuotaNotchGeometry.Main Main, Matrix Matrix, Geometry Entry)? _activationKey;
+    public Point CardTip { get; private set; }
+    public bool HasCard { get; private set; }
+
+    public QuotaNotchView(Localizer loc, bool card = false)
+    {
+        _loc = loc; _card = card; IsHitTestVisible = true;
+        RenderOptions.SetBitmapScalingMode(this, BitmapScalingMode.NearestNeighbor);
+    }
+
+    public void Update(QuotaNotchRenderState state)
+    {
+        double dpi = VisualTreeHelper.GetDpi(this).PixelsPerDip;
+        if (_hasState && _state == state && _lastLanguage == _loc.LanguageCode && _lastDpi == dpi) return;
+        if (state.GripAcquired && !_state.GripAcquired) _entryInput = GripInputGeometry;
+        else if (!state.GripAcquired) _entryInput = Geometry.Empty;
+        _hasState = true;
+        _lastLanguage = _loc.LanguageCode;
+        _lastDpi = dpi;
+        _state = state;
+        _targets.Clear();
+        var drawing = new DrawingGroup();
+        using (var dc = drawing.Open())
+        {
+            if (_card) BuildCard(dc); else BuildMain(dc);
+        }
+        drawing.Freeze();
+        _drawing = drawing;
+        Geometry union = Geometry.Empty;
+        foreach (var (shape, _) in _targets)
+            union = new CombinedGeometry(GeometryCombineMode.Union, union, shape);
