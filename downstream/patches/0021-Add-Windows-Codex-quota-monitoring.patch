@@ -0,0 +1,22 @@
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Windows Codenotch's unscaled CSS geometry, in device-independent pixels.</summary>
+public static class QuotaNotchLayout
+{
+    public const double UprightWidth = 360;
+    public const double LongSide = 650;
+
+    public static bool Vertical(string edge) => edge is "left" or "right";
+
+    /// <summary>Clamp a window centre, including when the work area is smaller than the window.</summary>
+    public static double ClampCenter(double center, double start, double extent, double windowExtent)
+    {
+        var half = Math.Min(windowExtent, extent) / 2;
+        return Math.Clamp(center, start + half, start + extent - half);
+    }
+
+    /// <summary>Undo WebView's current zoom to obtain the monitor-native zoom.</summary>
+    public static double TargetZoom(double monitorScale, double reportedDpr, double currentZoom) =>
+        monitorScale / (reportedDpr / currentZoom);
+
+}
