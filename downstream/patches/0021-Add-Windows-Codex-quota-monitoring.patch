+using System.Globalization;
+using System.Text;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Device-independent geometry in the edge-local frame: X points inward, Y along the edge.
+/// Paths are WPF/SVG-compatible and use invariant decimal notation.</summary>
+public static class QuotaNotchGeometry
+{
+    public const double Fillet = 38.7, BodyDepth = 70;
+    public const double TailLength = 28.2, TailWidth = 32.72, TailGap = 10.5;
+    // Reference-scale arc/disc; the larger dot grid is sized independently.
+    public const double GripScale = .9, ArcRadius = 28.5 * GripScale, ArcFill = 6.8 * GripScale;
+    public const double ArcOutline = ArcFill + 2, DiscRadius = 23.3 * GripScale;
+    public const double GripDot = 8, GripPitch = 12.5;
+    public const double GripReach = 8, GripPadding = 2, GripCorridorWidth = 8;
+    public const double CenterDiameter = 36, GlyphDiameter = 22, RingWidth = 4, RingDiameter = 52;
+    public const double ContentPadding = 8, CellGap = 8, ReadingGap = 4;
+    public readonly record struct Cell(double Width, double ReadingHeight, double Diameter)
+    {
+        public double ContentWidth => Math.Max(Diameter, Width);
+        public double ContentHeight => Diameter + ReadingGap + ReadingHeight;
+    }
+
+    /// <summary>Measured upright content. Cache when readings or edge orientation change, not per animation frame.</summary>
+    public sealed class ContentLayout
+    {
+        public bool Horizontal { get; }
+        public IReadOnlyList<Cell> Cells { get; }
+        public double[] Offsets { get; }
+        public double Length { get; }
+        public double Depth { get; }
+
+        public ContentLayout(bool horizontal, params Cell[] cells)
+        {
+            Horizontal = horizontal;
+            Cells = cells;
+            Offsets = new double[cells.Length];
+            double along = ContentPadding, width = 52, diameter = 52, readingHeight = 20;
+            for (int i = 0; i < cells.Length; i++)
+            {
+                var cell = cells[i];
+                Offsets[i] = along;
+                along += (horizontal ? cell.ContentWidth : cell.ContentHeight) + CellGap;
+                width = Math.Max(width, cell.ContentWidth);
+                diameter = Math.Max(diameter, cell.Diameter);
+                readingHeight = Math.Max(readingHeight, cell.ReadingHeight);
+            }
+            Length = Math.Max(80, cells.Length == 0 ? 2 * ContentPadding : along - CellGap + ContentPadding);
+            // Keep the existing cross-edge footprint; compact only the space along the edge.
+            Depth = horizontal ? Math.Max(98, Math.Max(80, diameter + ReadingGap + readingHeight) + 18)
+                : Math.Max(BodyDepth, width + 14);
+        }
+
+        public Point Center(Main main, int index, bool bottom = false)
+        {
+            var cell = Cells[index];
+            double x = Horizontal ? (bottom ? main.BodyDepth - 6 - cell.Diameter / 2 : 6 + cell.Diameter / 2) : main.BodyDepth / 2;
+            return new(x, main.BodyStart + Offsets[index] + (Horizontal ? cell.ContentWidth : cell.Diameter) / 2);
+        }
+
+        public Box Bounds(Main main, Affine transform, int index, bool bottom = false)
+        {
+            var cell = Cells[index];
+            var center = transform.Apply(Center(main, index, bottom));
+            return new(center.X - cell.ContentWidth / 2, center.Y - cell.Diameter / 2,
+                cell.ContentWidth, cell.ContentHeight);
+        }
+    }
+    public readonly record struct Point(double X, double Y);
+    public readonly record struct Main(double Depth, double Length, double BodyDepth, double BodyStart, double BodyEnd,
+        Point Grip, string BodyPath);
+    public readonly record struct Envelope(double Depth, double Length, double BodyCenterAlong)
+    {
+        public double Offset(Main shape) => BodyCenterAlong - (shape.BodyStart + shape.BodyEnd) / 2;
+    }
+    public readonly record struct Card(double Width, double Height, double TipAlong, string BodyPath, string TailPath);
+    public readonly record struct Dot(Point Center, double Radius);
+    public readonly record struct Box(double X, double Y, double Width, double Height);
+    public readonly record struct GripFrame(double Reveal = 0, double Hover = 0, double Squeeze = 0,
+        double Arc = 0, double Disc = 0, bool Returning = false, bool Quick = false,
+        double EntryArc = 0, bool EntryReturning = false, bool EntryQuick = false);
+    public readonly record struct GripShape(Point Center, Dot Core, string? NeckPath, double Blur, bool Liquid);
+    public readonly record struct OrbShape(string? ArcPath, double ArcWidth, string? BandPath, double BandWidth,
+        string? NeckPath, Dot Disc, double Blur, bool Liquid);
+    public readonly record struct Affine(double M11, double M12, double M21, double M22, double X, double Y)
+    {
+        public Point Apply(Point p) => new(p.X * M11 + p.Y * M21 + X, p.X * M12 + p.Y * M22 + Y);
+    }
+    public static Affine EdgeTransform(string edge, double depth, double alongOffset = 0) => edge switch
+    {
+        "left" => new(1, 0, 0, 1, 0, alongOffset),
+        "top" => new(0, 1, 1, 0, alongOffset, 0),
+        "bottom" => new(0, -1, 1, 0, alongOffset, depth),
+        _ => new(-1, 0, 0, 1, depth, alongOffset)
+    };
+
+    /// <summary>Stable canvas and grip anchor; input still follows the current painted outline.</summary>
+    public static Envelope CreateEnvelope(ContentLayout layout) => new(layout.Depth + .5,
+        2 * Fillet + layout.Length + DiscRadius + 12, Fillet + layout.Length / 2 + .5);
+    private static string F(double value) => value.ToString("0.####", CultureInfo.InvariantCulture);
+
+    public static Main CreateMain(double expansion, ContentLayout layout)
+    {
+        double t = Math.Clamp(expansion, 0, 1);
+        double openLength = layout.Length;
+        double depth = 10 + (layout.Depth - 10) * t, bodyLength = 79 + (openLength - 79) * t;
+        double flare = Fillet * t, start = flare, end = start + bodyLength;
+        double radius = 6 + 14 * t;
+        string body = $"M 0 0 A {F(flare)} {F(flare)} 0 0 0 {F(flare)} {F(start)} L {F(depth-radius)} {F(start)} A {F(radius)} {F(radius)} 0 0 1 {F(depth)} {F(start+radius)} L {F(depth)} {F(end-radius)} A {F(radius)} {F(radius)} 0 0 1 {F(depth-radius)} {F(end)} L {F(flare)} {F(end)} A {F(flare)} {F(flare)} 0 0 0 0 {F(end+flare)} Z";
+        if (t == 0) body = "M 0 0 L 4 0 A 6 6 0 0 1 10 6 L 10 73 A 6 6 0 0 1 4 79 L 0 79 Z";
+        // The handle anchor is stable in screen space throughout body expansion.
+        double anchorAlong = (start + end) / 2 + openLength / 2 + Fillet;
+        return new(depth, end + flare, depth, start, end,
+            new Point(Fillet, anchorAlong + GripReach), body);
+    }
+
+    public static Card CreateCard(double width, double height, double? along)
+    {
+        width = Math.Max(width, 64); height = Math.Max(height, 32 + TailWidth);
+        double tip = Math.Clamp(along ?? height / 2, 16 + TailWidth / 2, height - 16 - TailWidth / 2);
