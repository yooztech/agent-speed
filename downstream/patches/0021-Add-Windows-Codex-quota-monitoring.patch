+        double y = tip - TailWidth / 2;
+        string tail = $"M {F(width)} {F(y)} C {F(width)} {F(y+8.18)} {F(width+16.36)} {F(y+12.43)} {F(width+TailLength)} {F(tip)} C {F(width+16.36)} {F(y+20.29)} {F(width)} {F(y+24.54)} {F(width)} {F(y+TailWidth)} Z";
+        return new(width, height, tip, body, tail);
+    }
+
+    private static double Smooth(double value)
+    {
+        double t = Math.Clamp(value, 0, 1);
+        return t * t * (3 - 2 * t);
+    }
+
+    /// <summary>The flare pocket, shared by the resting quarter arc, temporary disc and six drops.</summary>
+    public static Point GetOrbCenter(Main main) => new(main.Grip.X, main.Grip.Y - GripReach);
+
+    public static string GetOrbEntryPath(Main main) => QuotaNotchGeometryOrb.Quarter(GetOrbCenter(main),
+        ArcRadius, 0, 1);
+
+    /// <summary>The visible entry stays present while its disc divides into the nearby six drops.</summary>
+    public static OrbShape CreateOrbEntry(Main main, GripFrame frame) => frame.Disc > .001 || frame.Reveal > .01
+        ? QuotaNotchGeometryOrb.GooArc(GetOrbCenter(main), 1, false, false) : default;
+
+    /// <summary>Reconstruct the exact emerging arc pose touched before its resting entry existed.
+    /// A scalar phase carry retains actual paint, not a broad invisible input rectangle or snapshot.</summary>
+    public static OrbShape CreateOrbCarry(Main main, GripFrame frame) => frame.EntryArc > .001
+        ? QuotaNotchGeometryOrb.GooArc(GetOrbCenter(main), frame.EntryArc, frame.EntryReturning, frame.EntryQuick)
+        : default;
+
+    /// <summary>Reference GooArc / DiscToArc / DiscMerge, without a settings icon or action.
+    /// Clip this source to the (Fillet + .5)-radius circle at GetOrbCenter, as in the reference.</summary>
+    public static OrbShape CreateOrb(Main main, GripFrame frame)
+    {
+        var center = GetOrbCenter(main);
+        if (frame.Arc <= .001 && frame.Disc <= .001) return default;
+        if (frame.Reveal > .01 && frame.Disc <= .001) return default;
+        if (frame.Squeeze > .001)
+            return frame.Disc <= .001 ? default
+                : QuotaNotchGeometryOrb.DiscMerge(center, frame.Squeeze, DiscRadius * frame.Disc);
+        if (frame.Disc > .001)
+        {
+            if (frame.Reveal > .01)
+            {
+                double blur = 3 * GripScale * (1 - Smooth((frame.Reveal - .42) / .36));
+                return new(null, 0, null, 0, null,
+                    new(center, Math.Max(0, DiscRadius * frame.Disc - .5)), blur, blur > .3);
+            }
+            return QuotaNotchGeometryOrb.DiscToArc(center, 1 - Math.Clamp(frame.Disc, 0, 1));
+        }
+        return QuotaNotchGeometryOrb.GooArc(center, frame.Arc, frame.Returning, frame.Quick);
+    }
+
+    /// <summary>The six drops separate within the same pocket as their temporary source disc.</summary>
+    public static GripShape CreateGrip(Main main, GripFrame frame)
+    {
+        double t = Math.Clamp(frame.Reveal, 0, 1);
+        var origin = GetOrbCenter(main);
+        var center = GripCenter(main, t);
+        double blur = 3 * GripScale * (1 - Smooth((t - .42) / .36));
+        bool liquid = t > .01 && blur > .3 * GripScale;
+        double radius = liquid ? DiscRadius * .55 * Smooth(t / .15) * (1 - Smooth(t / .7)) : 0;
+        var core = new Dot(origin, radius);
+        double neck = (GripPitch + GripDot) * .55 * (1 - Smooth((t - .25) / .35));
+        string? path = null;
+        if (liquid && neck > .5 * GripScale)
+            path = QuotaNotchGeometryOrb.Strand(origin, center, (GripPitch + GripDot) * .4,
+                neck / 2, (GripPitch + GripDot) * .25);
+        return new(center, core, path, blur, liquid);
+    }
+
+    private static Point GripCenter(Main main, double reveal)
+    {
+        double t = Math.Clamp(reveal, 0, 1);
+        var origin = GetOrbCenter(main);
+        double distance = GripReach * Smooth(t / .6)
+            + GripReach * .18 * Math.Sin(Math.PI * Math.Min(t / .8, 1));
+        return new(origin.X, origin.Y + distance);
+    }
+
+    public static Dot GetGripDot(Main main, int index) => GetGripDot(main, new GripFrame(1), index);
+    public static Dot GetGripDot(Main main, GripFrame frame, int index)
+    {
+        var center = GripCenter(main, frame.Reveal);
+        double spread = Smooth((frame.Reveal - .32 - .015 * index) / .4);
+        double pitch = GripPitch * spread * (1 - .18 * frame.Squeeze);
+        double radius = GripDot / 2 * (1 + .3 * frame.Hover) * (1 - .3 * frame.Squeeze)
+            * (1 + 1.9 * (1 - spread)) * Smooth(frame.Reveal / .12);
+        return new(new Point(center.X + (index % 3 - 1) * pitch,
+            center.Y + (index / 3 * 2 - 1) * pitch / 2), radius);
+    }
+
+    /// <summary>Only the current six drops plus two DIP padding, never the animation envelope.</summary>
+    public static Box GetGripHitBox(Main main) => GetGripHitBox(main, new GripFrame(1));
+    public static Box GetGripHitBox(Main main, GripFrame frame)
+    {
+        if (frame.Reveal <= .01) return new(main.Grip.X, main.Grip.Y, 0, 0);
+        double left = double.PositiveInfinity, top = left, right = double.NegativeInfinity, bottom = right;
+        for (int i = 0; i < 6; i++)
+        {
+            var dot = GetGripDot(main, frame, i);
+            left = Math.Min(left, dot.Center.X - dot.Radius); top = Math.Min(top, dot.Center.Y - dot.Radius);
+            right = Math.Max(right, dot.Center.X + dot.Radius); bottom = Math.Max(bottom, dot.Center.Y + dot.Radius);
+        }
+        return new(left - GripPadding - .5, top - GripPadding - .5,
+            right - left + 2 * GripPadding + 1, bottom - top + 2 * GripPadding + 1);
+    }
+
+    public static Box GetGripCorridor(Main main) => GetGripCorridor(main, new GripFrame(1));
+    public static Box GetGripCorridor(Main main, GripFrame frame)
+    {
+        if (frame.Reveal <= .01) return default;
+        var origin = GetOrbCenter(main);
+        var hit = GetGripHitBox(main, frame);
+        return new(origin.X - GripCorridorWidth / 2, origin.Y - .5,
+            GripCorridorWidth, Math.Max(0, hit.Y + hit.Height - origin.Y + .5));
+    }
+
+    /// <summary>A narrow radial bridge over the actual body/arc gap, not a rectangular pocket.</summary>
+    public static string? GetControlBridgePath(Main main, GripFrame frame)
+    {
+        if (frame.Arc <= .001 && frame.Disc <= .001 && frame.Reveal <= .01) return null;
+        var center = GetOrbCenter(main);
+        double s = Math.Sqrt(.5);
+        var from = new Point(center.X - s * (Fillet + 1), center.Y - s * (Fillet + 1));
+        var to = frame.Disc > .001 || frame.Reveal > .01 ? center
+            : new Point(center.X - s * (ArcRadius - ArcOutline / 2), center.Y - s * (ArcRadius - ArcOutline / 2));
+        return QuotaNotchGeometryOrb.Strand(from, to, GripCorridorWidth / 2,
+            GripCorridorWidth / 2, GripCorridorWidth / 2);
+    }
+
+    /// <summary>Activation-only straight routes from both arc endpoints and its midpoint to
+    /// each current drop. Fill this compound path with nonzero winding (SVG's default).
+    /// Overlap must union, never toggle holes; no enclosing rectangle is made interactive.</summary>
+    public static string? GetControlFanPath(Main main, GripFrame frame)
+    {
+        if (frame.Disc <= .001 && frame.Reveal <= .01) return null;
+        var center = GetOrbCenter(main);
+        var path = new StringBuilder(4096);
+        for (int anchor = 0; anchor < 3; anchor++)
+        {
+            double angle = Math.PI + anchor * Math.PI / 4;
+            var from = new Point(center.X + ArcRadius * Math.Cos(angle), center.Y + ArcRadius * Math.Sin(angle));
+            Point? previous = null;
+            for (int i = 0; i < 6; i++)
+            {
+                var to = GetGripDot(main, frame, i).Center;
+                if (previous == to) continue; // Early drops coincide: one route is sufficient.
+                previous = to;
+                double dx = to.X - from.X, dy = to.Y - from.Y;
+                double half = GripCorridorWidth / (2 * Math.Sqrt(dx * dx + dy * dy));
+                double px = -dy * half, py = dx * half;
+                path.Append(CultureInfo.InvariantCulture,
+                    $"M {from.X + px:0.####} {from.Y + py:0.####} L {to.X + px:0.####} {to.Y + py:0.####} L {to.X - px:0.####} {to.Y - py:0.####} L {from.X - px:0.####} {from.Y - py:0.####} Z ");
+            }
+        }
+        return path.ToString();
+    }
+
+    /// <summary>Minimum distance from outlined final dots to the outlined quarter-circle body flare.</summary>
+    public static double GripPaintClearance(Main main)
+    {
+        double gap = double.PositiveInfinity;
+        var center = GetOrbCenter(main);
+        for (int i = 0; i < 6; i++)
+        {
+            var dot = GetGripDot(main, i);
+            double distance = QuarterDistance(dot.Center.X - center.X, dot.Center.Y - center.Y, Fillet);
+            gap = Math.Min(gap, distance - dot.Radius - 1);
+        }
+        return gap;
+    }
+
+
+    private static double QuarterDistance(double x, double y, double radius) => x <= 0 && y <= 0
+        ? Math.Abs(radius - Math.Sqrt(x * x + y * y))
+        : Math.Min(Math.Sqrt((x + radius) * (x + radius) + y * y),
+            Math.Sqrt(x * x + (y + radius) * (y + radius)));
+
+    public static double RemainingFill(double used) => Math.Clamp(1 - used, 0, 1);
+    public static int Tone(double used) => used >= .7 ? 2 : used >= .5 ? 1 : 0;
+
+    /// <summary>Actual measured percentages; graphical fills alone clamp to the ring bounds.</summary>
+    public static (string Used, string Remaining) PercentHalves(double used) =>
+        ((used * 100).ToString("0.##", CultureInfo.InvariantCulture),
+         ((1 - used) * 100).ToString("0.##", CultureInfo.InvariantCulture));
+}
diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryFilter.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryFilter.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3079346a9580f842724f5c924c8b3a2bc3a7aa5f
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryFilter.cs
@@ -0,0 +1,190 @@
+using System.Numerics;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Reusable scratch for the reference local SVG alpha filter. The caller supplies only
+/// a tight source-alpha bounding box padded by at least ceil(3*sigma*dpiScale)+erosion pixels;
+/// no pixels are sampled from the screen. Buffers grow, never allocate per pixel.</summary>
+public sealed class QuotaNotchFilterScratch
+{
+    internal float[] Working = [], Horizontal = [], Kernel = [];
+    internal byte[] Alpha = [], Minimum = [];
+
+    internal void Ensure(int pixels, int kernelSize)
+    {
+        if (Working.Length < pixels) Working = new float[pixels];
+        if (Horizontal.Length < pixels) Horizontal = new float[pixels];
+        if (Kernel.Length < kernelSize) Kernel = new float[kernelSize];
+        if (Alpha.Length < pixels) Alpha = new byte[pixels];
+        if (Minimum.Length < pixels) Minimum = new byte[pixels];
+    }
+}
+
+/// <summary>GaussianBlur → alpha = clamp(18*alpha - 8.5) → square feMorphology erosion.
+/// Values are linear alpha bytes. Caller-owned buffers allow deterministic Linux tests/benchmarks
+/// at any DPI; e.g. call Apply repeatedly with dpiScale=4 and sigma=5 on a padded source box.</summary>
+public static class QuotaNotchGeometryFilter
+{
+    public static int Padding(double sigma, double dpiScale) => (int)Math.Ceiling(3 * Math.Max(0, sigma) * dpiScale + dpiScale);
+
+    public static void Apply(int width, int height, double sigma, double dpiScale,
+        ReadOnlySpan<byte> source, Span<byte> outer, Span<byte> inner, QuotaNotchFilterScratch scratch)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(width);
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(height);
+        ArgumentOutOfRangeException.ThrowIfNegative(sigma);
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(dpiScale);
+        int count = checked(width * height);
+        if (source.Length < count || outer.Length < count || inner.Length < count)
+            throw new ArgumentException("Alpha buffers are smaller than the supplied bounds.");
+        double deviation = sigma * dpiScale;
+        int radius = (int)Math.Ceiling(3 * deviation);
+        int erosion = (int)Math.Ceiling(dpiScale);
+        int kernelSize = checked(2 * radius + 1);
+        scratch.Ensure(count, kernelSize);
+        var alpha = scratch.Alpha;
+        if (radius == 0)
+        {
+            // Finish reading source before touching either output: spans may overlap.
+            for (int i = 0; i < count; i++) alpha[i] = Threshold(source[i]);
+        }
+        else
+        {
+            var kernel = scratch.Kernel;
+            double total = 0;
+            for (int i = -radius; i <= radius; i++)
+            {
+                double value = Math.Exp(-.5 * i * i / (deviation * deviation));
+                kernel[i + radius] = (float)value;
+                total += value;
+            }
+            for (int i = 0; i < kernelSize; i++) kernel[i] = (float)(kernel[i] / total);
+
+            // Byte-to-float expansion is exact, and paid once rather than per kernel tap.
+            var working = scratch.Working;
+            for (int i = 0; i < count; i++) working[i] = source[i];
+            BlurHorizontal(width, height, radius, kernel, working, scratch.Horizontal);
+            BlurVertical(width, height, radius, kernel, scratch.Horizontal, working);
+            for (int i = 0; i < count; i++) alpha[i] = Threshold(working[i]);
+        }
+
+        alpha.AsSpan(0, count).CopyTo(outer);
+        Erode(width, height, erosion, alpha, scratch.Minimum, inner);
+    }
+
+    private static byte Threshold(float value) =>
+        (byte)Math.Round(Math.Clamp(18 * value - 8.5f * 255, 0, 255));
+
+    private static void BlurHorizontal(int width, int height, int radius, float[] kernel,
+        float[] source, float[] target)
+    {
+        int lanes = Vector<float>.Count;
+        bool vectorize = Vector.IsHardwareAccelerated && width - 2L * radius >= lanes;
+        for (int y = 0; y < height; y++)
+        {
+            int row = y * width;
+            int x = 0;
+            int leftEnd = vectorize ? radius : width;
+            for (; x < leftEnd; x++)
+                target[row + x] = HorizontalPixel(width, radius, kernel, source, row, x);
+
+            if (vectorize)
+            {
+                int vectorEnd = width - radius - lanes;
+                for (; x <= vectorEnd; x += lanes)
+                {
+                    var sum = Vector<float>.Zero;
+                    for (int k = -radius; k <= radius; k++)
+                    {
+                        // Preserve scalar k order and separate multiply/add rounding; no FMA.
+                        var product = new Vector<float>(source, row + x + k) * new Vector<float>(kernel[k + radius]);
+                        sum += product;
+                    }
+                    sum.CopyTo(target, row + x);
+                }
+            }
+
+            for (; x < width; x++)
+                target[row + x] = HorizontalPixel(width, radius, kernel, source, row, x);
+        }
+    }
+
+    private static float HorizontalPixel(int width, int radius, float[] kernel, float[] source, int row, int x)
+    {
+        float sum = 0;
+        int lo = Math.Max(-radius, -x), hi = Math.Min(radius, width - 1 - x);
+        for (int k = lo; k <= hi; k++) sum += source[row + x + k] * kernel[k + radius];
+        return sum;
+    }
+
+    private static void BlurVertical(int width, int height, int radius, float[] kernel,
+        float[] source, float[] target)
+    {
+        int lanes = Vector<float>.Count;
+        int vectorEnd = Vector.IsHardwareAccelerated ? width - lanes : -1;
+        for (int y = 0; y < height; y++)
+        {
+            int row = y * width;
+            int lo = Math.Max(-radius, -y), hi = Math.Min(radius, height - 1 - y);
+            int x = 0;
+            for (; x <= vectorEnd; x += lanes)
+            {
+                var sum = Vector<float>.Zero;
+                for (int k = lo; k <= hi; k++)
+                {
+                    var product = new Vector<float>(source, (y + k) * width + x) * new Vector<float>(kernel[k + radius]);
+                    sum += product;
+                }
+                sum.CopyTo(target, row + x);
+            }
+            for (; x < width; x++)
+            {
+                float sum = 0;
+                for (int k = lo; k <= hi; k++) sum += source[(y + k) * width + x] * kernel[k + radius];
+                target[row + x] = sum;
+            }
+        }
+    }
+
+    private static void Erode(int width, int height, int radius, byte[] alpha, byte[] horizontal, Span<byte> target)
+    {
+        if (radius >= width - radius || radius >= height - radius)
+        {
+            target[..(width * height)].Clear();
+            return;
+        }
+
+        // Round is monotone on [0,255], so round(min(alpha)) == min(round(alpha)).
+        // Keep an independent alpha snapshot even when outer and inner overlap.
+        for (int y = 0; y < height; y++)
+        {
+            int row = y * width;
+            for (int x = 0; x < width; x++)
+            {
+                byte minimum = 0;
+                if (x >= radius && x < width - radius)
+                {
+                    minimum = 255;
+                    for (int k = -radius; k <= radius && minimum > 0; k++)
+                        minimum = Math.Min(minimum, alpha[row + x + k]);
+                }
+                horizontal[row + x] = minimum;
+            }
+        }
+        for (int y = 0; y < height; y++)
+        {
+            int row = y * width;
+            for (int x = 0; x < width; x++)
+            {
+                byte minimum = 0;
+                if (x >= radius && x < width - radius && y >= radius && y < height - radius)
+                {
+                    minimum = 255;
+                    for (int k = -radius; k <= radius && minimum > 0; k++)
+                        minimum = Math.Min(minimum, horizontal[(y + k) * width + x]);
+                }
+                target[row + x] = minimum;
+            }
+        }
+    }
+}
diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryOrb.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryOrb.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8525bdb058ee5e3e204ecb432a821959edfb827c
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaNotchGeometryOrb.cs
@@ -0,0 +1,100 @@
+using System.Globalization;
+using static AgentSpeed.Presentation.Settings.QuotaNotchGeometry;
+
+namespace AgentSpeed.Presentation.Settings;
+
+/// <summary>Codenotch GooArc, DiscToArc and DiscMerge, expressed in the shared edge-local pocket.
+/// The native renderer clips these filter sources to the (Fillet + .5)-radius circle at the supplied center.
+/// No settings glyph or interaction is part of this geometry. See QuotaNotch.LICENSE.txt.</summary>
+public static class QuotaNotchGeometryOrb
+{
+    private static string F(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
+    private static double Smooth(double value) { double t = Math.Clamp(value, 0, 1); return t * t * (3 - 2 * t); }
+    private static readonly double S = Math.Sqrt(.5);
+    private static Point Into(Point center, double distance) => new(center.X - S * distance, center.Y - S * distance);
+
+    public static string Quarter(Point center, double radius, double from, double to, double shiftX = 0, double shiftY = 0)
+    {
+        Point At(double position) => new(center.X + shiftX + radius * Math.Cos(-Math.PI + position * Math.PI / 2),
+            center.Y + shiftY + radius * Math.Sin(-Math.PI + position * Math.PI / 2));
+        var a = At(from); var b = At(to);
+        return $"M {F(a.X)} {F(a.Y)} A {F(radius)} {F(radius)} 0 0 1 {F(b.X)} {F(b.Y)}";
+    }
+
+    public static string Strand(Point from, Point to, double basis, double pinch, double top)
+    {
+        double dx = to.X - from.X, dy = to.Y - from.Y, length = Math.Max(Math.Sqrt(dx * dx + dy * dy), .001);
+        double px = -dy / length, py = dx / length;
+        var middle = new Point((from.X + to.X) / 2, (from.Y + to.Y) / 2);
+        string Side(Point point, double half, int sign) => $"{F(point.X + px * half * sign)} {F(point.Y + py * half * sign)}";
+        return $"M {Side(from, basis, 1)} Q {Side(middle, pinch, 1)} {Side(to, top, 1)} L {Side(to, top, -1)} Q {Side(middle, pinch, -1)} {Side(from, basis, -1)} Z";
+    }
+
+    public static OrbShape DiscMerge(Point origin, double progress, double discRadius)
+    {
+        double t = Math.Clamp(progress, 0, 1), blur = 5 * GripScale * Smooth(t / .2);
+        var inside = Into(origin, Fillet + discRadius * .75);
+        double k = Smooth(t);
+        var center = new Point(origin.X + (inside.X - origin.X) * k, origin.Y + (inside.Y - origin.Y) * k);
+        double radius = discRadius * (1 - .72 * Smooth((t - .2) / .8));
+        bool liquid = blur > .3;
+        if (!liquid) return new(null, 0, null, 0, null, new(center, Math.Max(0, radius - .5)), blur, false);
+        double band = ArcFill * 2.4, hold = Smooth(t / .22);
+        string? neck = hold > .02 ? Strand(Into(origin, Fillet + ArcFill), center,
+            discRadius * 1.1 * hold / 2, radius * .8 * hold / 2, radius * 1.2 * hold / 2) : null;
+        return new(null, 0, Quarter(origin, Fillet + .5 + band / 2, 0, 1), band, neck,
+            new(center, radius), blur, true);
+    }
+
+    public static OrbShape GooArc(Point center, double separation, bool returning, bool quick)
+    {
+        if (separation <= .001) return default;
+        double rest = Fillet - ArcRadius, t = Math.Clamp(separation, 0, 1), buried = -(rest + ArcFill * 1.4);
+        bool rq = returning && quick;
+        double blur = rq ? 0 : returning
+            ? ArcFill * .45 * (1 + .8 * (1 - Smooth((separation - .04) / .32))) * Smooth((.93 - separation) / .15) * Smooth(separation / .05)
+            : ArcFill * .4 * Smooth(separation / .15) * (1 - Smooth((separation - .6) / .35));
+        double slide = rq ? 0 : returning
+            ? buried * (1 - t) + (t < .85 ? rest * 1.2 * Math.Sin(Math.PI * t / .85) : 0)
+            : buried * (1 - t) + (t < .8 ? rest * 2.1 * Math.Sin(Math.PI * t / .8) : 0);
+        double unrolled = rq ? Smooth((separation - .05) / .9)
+            : returning ? Smooth((separation - .6) / .35) : Smooth((separation - .52) / .43);
+        double width = ArcFill * 2.3 + (ArcFill - ArcFill * 2.3) * unrolled;
+        if (rq) width = ArcFill * Smooth(separation / .7);
+        if (returning && !quick) width *= Smooth(separation / .35);
+        if (width < .4) return default;
+        double half = Math.Max(.004, unrolled / 2);
+        double start = unrolled >= .999 ? 0 : .5 - half, end = unrolled >= .999 ? 1 : .5 + half;
+        string path = Quarter(center, ArcRadius, start, end, S * slide, S * slide);
+        bool liquid = blur > .2;
+        if (!liquid) return new(path, width, null, 0, null, default, blur, false);
+        double neck = returning ? (quick ? 0 : ArcFill * 1.1 * Smooth((.94 - separation) / .1))
+            : ArcFill * 1.1 * (1 - Smooth((separation - .2) / .5));
+        string? strand = null;
+        if (neck > ArcFill * .18)
+        {
+            double reach = returning ? Smooth((.92 - separation) / .32) : 1;
+            var from = Into(center, Fillet + ArcFill);
+            var drop = Into(center, Fillet - rest - slide);
+            var to = new Point(from.X + (drop.X - from.X) * reach, from.Y + (drop.Y - from.Y) * reach);
+            strand = Strand(from, to, ArcFill * 1.3, neck / 2, ArcFill * .7);
+        }
+        double band = ArcFill + blur * 1.6;
+        return new(path, width + blur * .4, Quarter(center, Fillet + .5 + band / 2, 0, 1), band,
+            strand, default, blur, true);
+    }
+
+    public static OrbShape DiscToArc(Point center, double progress)
+    {
+        double p = Math.Clamp(progress, 0, 1), onto = Smooth(p / .55);
+        double half = Math.Max(.004, .5 * Smooth((p - .08) / .82));
+        double from = 2 * DiscRadius - 2;
+        double width = from + (ArcFill - from) * Smooth(p / .8);
+        string path = Quarter(center, ArcRadius, .5 - half, .5 + half,
+            S * ArcRadius * (1 - onto), S * ArcRadius * (1 - onto));
+        // Exactly at the disc endpoint use its circle, avoiding a tiny arc-segment seam.
+        return p <= .001 ? new(null, 0, null, 0, null, new(center, DiscRadius - .5), 0, false)
+            : new(path, width, null, 0, null, default, 0, false);
+    }
+
+}
