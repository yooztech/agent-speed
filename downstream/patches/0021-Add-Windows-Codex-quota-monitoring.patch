+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _generation++;
+        _timer.Stop();
+        _provider?.Dispose();
+        _notch?.Close();
+        _notch = null;
+        _page = null;
+    }
+}
