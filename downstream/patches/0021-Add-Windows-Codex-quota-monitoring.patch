-# Codex quota contract (macOS phase one)
+# Codex quota contract (macOS and Windows)
 
 This is a local, account-level quota observation, distinct from token usage, spend, and the remote collector's metrics. The Codex provider reads the locally available Codex session and queries the account's usage endpoint. Do not transmit credentials or quota data to the collector, include credentials in logs, or write credentials back. The endpoint and fields below are observed provider behavior, not a guarantee of a stable OpenAI API.
 
+On macOS and Windows, the provider reads `auth.json` from a non-empty `CODEX_HOME` directory when set. Otherwise, it reads `~/.codex/auth.json` on macOS or `%USERPROFILE%\.codex\auth.json` on Windows. The file is read-only; credentials are used only for the local account request. Both platforms follow the same snapshot, endpoint, status, freshness, and backoff semantics described below.
+
 ## Snapshot
 
 A snapshot has the following logical fields. Optional values are nullable; a missing reading is **unknown**, not zero. Dates are instants (when serialized, ISO 8601 UTC); durations are seconds. IDs are stable machine identifiers, not localized presentation strings.
diff --git a/windows/src/AgentSpeed.Core/CodexQuotaProvider.cs b/windows/src/AgentSpeed.Core/CodexQuotaProvider.cs
new file mode 100644
index 00000000..bbc7b11f
--- /dev/null
+++ b/windows/src/AgentSpeed.Core/CodexQuotaProvider.cs
@@ -0,0 +1,227 @@
+using System.Globalization;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace AgentSpeed.Core;
+
+public enum CodexQuotaStatus { Ok, Stale, NeedsAuth, AccessDenied, Unsupported, Error }
+
+public sealed record CodexQuotaWindow(string Id, string Label, double? UsedFraction, double? Remaining, double? Used, DateTimeOffset? ResetAt, TimeSpan? Duration);
+public sealed record CodexQuotaCredits(bool? HasCredits, bool? Unlimited, double? Limit, double? Used, double? UsedFraction, DateTimeOffset? ResetAt, string? Balance);
+public sealed record CodexQuotaSnapshot(string Id, string DisplayName, string Fidelity, CodexQuotaStatus Status,
+    IReadOnlyList<CodexQuotaWindow> Windows, string? HeadlineId, string? Block, string? Account, string? Plan,
+    DateTimeOffset? ObservedAt, string Source, CodexQuotaCredits? Credits, DateTimeOffset? NextAllowedAt, bool WaitingForRefresh);
+
+// Endpoint behavior informed by Codenotch (MIT), https://github.com/vinzdg/codenotch.
+public sealed class CodexQuotaProvider : IDisposable
+{
+    private static readonly Uri Endpoint = new("https://chatgpt.com/backend-api/wham/usage");
+    private readonly string credentialPath, scheduleDirectory;
+    private readonly HttpClient client;
+    private readonly Func<DateTimeOffset> now;
+    private readonly object gate = new();
+    private readonly Dictionary<string, CodexQuotaSnapshot> cached = new();
+    private readonly Dictionary<string, Schedule> schedules = new();
+    private Task<CodexQuotaSnapshot>? inFlight;
+    private CancellationTokenSource? activeCancellation;
+
+    public CodexQuotaProvider() : this(
+        Path.Combine(Environment.GetEnvironmentVariable("CODEX_HOME") is { Length: > 0 } home ? home : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".codex"), "auth.json"),
+        Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AgentSpeed", "quota"),
+        new HttpClient(new HttpClientHandler { AllowAutoRedirect = false }), () => DateTimeOffset.UtcNow) { }
+
+    internal CodexQuotaProvider(string credentialPath, string scheduleDirectory, HttpClient client, Func<DateTimeOffset> now)
+    {
+        this.credentialPath = credentialPath; this.scheduleDirectory = scheduleDirectory; this.client = client; this.now = now;
+    }
+
+    public Task<CodexQuotaSnapshot> RefreshAsync()
+    {
+        lock (gate)
+        {
+            if (inFlight is { IsCompleted: false }) return inFlight;
+            activeCancellation?.Dispose();
+            activeCancellation = new CancellationTokenSource();
+            return inFlight = RefreshCoreAsync(activeCancellation.Token);
+        }
+    }
+
+    public void Cancel() { lock (gate) activeCancellation?.Cancel(); }
+    public void Dispose() { Cancel(); client.Dispose(); }
+
+    private async Task<CodexQuotaSnapshot> RefreshCoreAsync(CancellationToken cancellationToken)
+    {
+        string token, account;
+        try
+        {
+            using var auth = JsonDocument.Parse(await File.ReadAllTextAsync(credentialPath, cancellationToken).ConfigureAwait(false));
+            var tokens = Property(auth.RootElement, "tokens");
+            token = Text(tokens, "access_token") ?? "";
+            account = Text(tokens, "account_id") ?? "";
+            if (string.IsNullOrWhiteSpace(token) || string.IsNullOrWhiteSpace(account)) return Empty(CodexQuotaStatus.NeedsAuth);
+        }
+        catch (OperationCanceledException) { return Empty(CodexQuotaStatus.Error); }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException or JsonException or ArgumentException)
+        { return Empty(CodexQuotaStatus.NeedsAuth); }
+
+        var accountKey = Digest(account);
+        var tokenKey = Digest(token);
+        var path = Path.Combine(scheduleDirectory, accountKey + ".json");
+        if (!schedules.TryGetValue(accountKey, out var schedule))
+            schedules[accountKey] = schedule = Load(path);
+        if (schedule.RejectedToken == tokenKey) return Empty(CodexQuotaStatus.NeedsAuth);
+        if (schedule.RejectedToken != null) schedules[accountKey] = schedule = new Schedule();
+        var time = now();
+        if (schedule.NextAllowedAt is { } next && time < next)
+            return cached.TryGetValue(accountKey, out var previous) ? previous : Empty(CodexQuotaStatus.Error, next, schedule.SuccessfulObservation == true);
+        try
+        {
+            using var request = new HttpRequestMessage(HttpMethod.Get, Endpoint);
+            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
+            request.Headers.TryAddWithoutValidation("ChatGPT-Account-Id", account);
+            request.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
+            using var response = await client.SendAsync(request, cancellationToken).ConfigureAwait(false);
+            var completed = now();
+            if (response.IsSuccessStatusCode)
+            {
+                schedules[accountKey] = schedule = new Schedule { NextAllowedAt = completed.AddMinutes(5), SuccessfulObservation = false };
+                CodexQuotaSnapshot result;
+                try { result = Parse(await response.Content.ReadAsStringAsync(cancellationToken).ConfigureAwait(false), completed) with { NextAllowedAt = schedule.NextAllowedAt }; schedule.SuccessfulObservation = true; }
+                catch (JsonException) { result = StaleOrError(accountKey, schedule.NextAllowedAt); }
+                Save(path, schedule); cached[accountKey] = result; return result;
+            }
+            if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+            {
+                schedule.RejectedToken = tokenKey; schedule.NextAllowedAt = null; schedule.SuccessfulObservation = false;
+                Save(path, schedule); cached.Remove(accountKey); return Empty(CodexQuotaStatus.NeedsAuth);
+            }
+            if ((int)response.StatusCode == 429)
+            {
+                schedule.Failures = Math.Min(schedule.Failures + 1, 6);
+                var seconds = Math.Max(60 * Math.Pow(2, schedule.Failures - 1), RetryAfter(response.Headers.RetryAfter, completed));
+                schedule.NextAllowedAt = completed.AddSeconds(seconds); schedule.SuccessfulObservation = false;
+                Save(path, schedule);
+                var result = StaleOrError(accountKey, schedule.NextAllowedAt); cached[accountKey] = result; return result;
+            }
+            return StaleOrError(accountKey, null);
+        }
+        catch (Exception e) when (e is HttpRequestException or IOException or TaskCanceledException or InvalidOperationException or FormatException)
+        { return StaleOrError(accountKey, null); }
+    }
+
+    private static double RetryAfter(RetryConditionHeaderValue? retry, DateTimeOffset time) =>
+        Math.Max(60, retry?.Delta?.TotalSeconds ?? (retry?.Date - time)?.TotalSeconds ?? 60);
+    private static string Digest(string text) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(text))).ToLowerInvariant();
+    private sealed class Schedule
+    {
+        public DateTimeOffset? NextAllowedAt { get; set; }
+        public int Failures { get; set; }
+        public string? RejectedToken { get; set; }
+        public bool? SuccessfulObservation { get; set; }
+    }
+    private static Schedule Load(string path)
+    {
+        try
+        {
+            using var doc = JsonDocument.Parse(File.ReadAllText(path));
+            var root = doc.RootElement;
+            return new Schedule { NextAllowedAt = DateTimeOffset.TryParse(Text(root, "nextAllowedAt"), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var date) ? date : null,
+                Failures = (int)(Number(root, "failures") ?? 0), RejectedToken = Text(root, "rejectedToken"), SuccessfulObservation = Boolean(root, "successfulObservation") };
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException or JsonException or ArgumentException or OverflowException) { return new Schedule(); }
+    }
+    private static void Save(string path, Schedule schedule)
+    {
+        try
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+            using var stream = File.Create(path);
+            using var writer = new Utf8JsonWriter(stream);
+            writer.WriteStartObject();
+            if (schedule.NextAllowedAt is { } next) writer.WriteString("nextAllowedAt", next);
+            writer.WriteNumber("failures", schedule.Failures);
+            if (schedule.RejectedToken != null) writer.WriteString("rejectedToken", schedule.RejectedToken);
+            if (schedule.SuccessfulObservation is { } success) writer.WriteBoolean("successfulObservation", success);
+            writer.WriteEndObject();
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException) { }
+    }
+    private CodexQuotaSnapshot StaleOrError(string key, DateTimeOffset? next) =>
+        cached.TryGetValue(key, out var value) && value.ObservedAt != null ? value with { Status = CodexQuotaStatus.Stale, NextAllowedAt = next, WaitingForRefresh = false } : Empty(CodexQuotaStatus.Error, next);
+    private static CodexQuotaSnapshot Empty(CodexQuotaStatus status, DateTimeOffset? next = null, bool waiting = false) =>
+        new("codex", "Codex", "official", status, [], null, null, null, null, null, "wham/usage", null, next, waiting);
+
+    internal static CodexQuotaSnapshot Parse(string json, DateTimeOffset time)
+    {
+        using var doc = JsonDocument.Parse(json);
+        var root = doc.RootElement;
+        if (root.ValueKind != JsonValueKind.Object) throw new JsonException();
+        var windows = new List<CodexQuotaWindow>();
+        void Add(JsonElement limits, string prefix, string label)
+        {
+            foreach (var slot in new[] { "primary", "secondary" })
+            {
+                var window = Property(limits, slot + "_window");
+                if (window.ValueKind != JsonValueKind.Object) continue;
+                var seconds = Number(window, "limit_window_seconds");
+                if (seconds < 0 || seconds > TimeSpan.MaxValue.TotalSeconds) seconds = null;
+                var fraction = Number(window, "used_percent") / 100;
+                var id = prefix + ":" + (seconds?.ToString("0.0###############", CultureInfo.InvariantCulture) ?? "unknown:" + slot);
+                if (windows.Exists(w => w.Id == id)) id += ":" + slot;
+                // Repeated feature scopes must also remain unique.
+                var baseId = id; var suffix = 2;
+                while (windows.Exists(w => w.Id == id)) id = baseId + ":" + suffix++;
+                windows.Add(new(id, label, fraction, 1 - fraction, fraction, Reset(window, time), seconds is { } s ? TimeSpan.FromSeconds(s) : null));
+            }
+        }
+        Add(Property(root, "rate_limit"), "main", "Codex");
+        var extras = Property(root, "additional_rate_limits");
+        if (extras.ValueKind == JsonValueKind.Array)
+        {
+            var index = 0;
+            foreach (var extra in extras.EnumerateArray())
+            {
+                index++;
+                if (extra.ValueKind != JsonValueKind.Object) continue;
+                var name = Text(extra, "limit_name") ?? Text(extra, "metered_feature") ?? $"Extra {index}";
+                Add(Property(extra, "rate_limit"), "extra:" + (Text(extra, "metered_feature") ?? name), name);
+            }
+        }
+        Add(Property(root, "code_review_rate_limit"), "code_review", "Code review");
+        var raw = Property(root, "credits");
+        var spend = Property(Property(root, "spend_control"), "individual_limit");
+        CodexQuotaCredits? credits = null;
+        if (raw.ValueKind == JsonValueKind.Object || spend.ValueKind == JsonValueKind.Object)
+        {
+            var balance = Property(raw, "balance");
+            credits = new(Boolean(raw, "has_credits"), Boolean(raw, "unlimited"), Number(spend, "limit", true), Number(spend, "used", true), Number(spend, "used_percent", true) / 100,
+                Epoch(Number(spend, "reset_at", true)), balance.ValueKind == JsonValueKind.String ? balance.GetString() : balance.ValueKind == JsonValueKind.Number ? balance.GetRawText() : null);
+        }
+        return new("codex", "Codex", "official", CodexQuotaStatus.Ok, windows, windows.Find(w => w.Id.StartsWith("main:", StringComparison.Ordinal))?.Id,
+            null, null, Text(root, "plan_type"), time, "wham/usage", credits, null, false);
+    }
+    private static JsonElement Property(JsonElement obj, string name) => obj.ValueKind == JsonValueKind.Object && obj.TryGetProperty(name, out var value) ? value : default;
+    private static string? Text(JsonElement obj, string name) { var v = Property(obj, name); return v.ValueKind == JsonValueKind.String ? v.GetString() : null; }
+    private static bool? Boolean(JsonElement obj, string name) { var v = Property(obj, name); return v.ValueKind == JsonValueKind.True ? true : v.ValueKind == JsonValueKind.False ? false : null; }
+    private static double? Number(JsonElement obj, string name, bool strings = false)
+    {
+        var v = Property(obj, name); double n;
+        if ((v.ValueKind == JsonValueKind.Number && v.TryGetDouble(out n) || strings && v.ValueKind == JsonValueKind.String && double.TryParse(v.GetString(), NumberStyles.Float, CultureInfo.InvariantCulture, out n)) && double.IsFinite(n)) return n;
+        return null;
+    }
+    private static DateTimeOffset? Epoch(double? seconds)
+    {
+        if (seconds is not { } s || s < 0 || s > 253402300799) return null;
+        return DateTimeOffset.UnixEpoch.AddSeconds(s);
+    }
+    private static DateTimeOffset? Reset(JsonElement window, DateTimeOffset time)
+    {
+        var absolute = Epoch(Number(window, "reset_at"));
+        if (absolute != null) return absolute;
+        var relative = Number(window, "reset_after_seconds");
+        return relative is { } s && s >= 0 && s <= (DateTimeOffset.MaxValue - time).TotalSeconds ? time.AddSeconds(s) : null;
+    }
+}
