+    private struct MotionRun
+    {
+        private double _from, _start, _duration;
+        public double To { get; private set; }
+        public bool Active { get; private set; }
+
+        public void Start(double from, double to, double now, double duration)
+        {
+            _from = from;
+            To = to;
+            _start = now;
+            _duration = duration;
+            Active = true;
+        }
+
+        public double Sample(double now, double current)
+        {
+            if (!Active) return current;
+            var t = Math.Clamp((now - _start) / _duration, 0, 1);
+            if (t <= 0) return _from;
+            if (t >= 1) { Active = false; return To; }
+            const double x1 = .42, x2 = .58;
+            var lo = 0d;
+            var hi = 1d;
+            var u = t;
+            for (var i = 0; i < 24; i++)
+            {
+                u = (lo + hi) / 2;
+                var x = 3 * x1 * u * (1 - u) * (1 - u) + 3 * x2 * u * u * (1 - u) + u * u * u;
+                if (x < t) lo = u;
+                else hi = u;
+            }
+            t = 3 * u * u * (1 - u) + u * u * u;
+            return _from + (To - _from) * t;
+        }
+    }
