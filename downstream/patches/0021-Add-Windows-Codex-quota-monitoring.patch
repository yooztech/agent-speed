+using System.IO;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.Reflection;
+using System.Runtime.ExceptionServices;
+using System.Windows.Threading;
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+using AgentSpeed.Presentation.Settings;
+using AgentSpeed.Services;
+using AgentSpeed.Settings;
+
+namespace AgentSpeed.Windows.Tests;
+
+public sealed class QuotaSurfaceRetryTests
+{
+    [Theory]
+    [InlineData("codex")]
+    public void FirstTransientProviderFailureMakesActualHttpAtFiveSecondsInsteadOfNormalTick(string id)
+    {
+        RunSta(() =>
+        {
+            var directory = Path.Combine(Path.GetTempPath(), "quota-cold-controller-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+            try
+            {
+                var auth = Path.Combine(directory, "auth.json");
+                File.WriteAllText(auth, id switch
+                {
+                    "codex" => """{"tokens":{"access_token":"fixture","account_id":"fixture"}}""",
+                    _ => throw new InvalidOperationException("Unsupported quota fixture source")
+                });
+                var now = new DateTimeOffset(2026, 11, 15, 12, 0, 0, TimeSpan.Zero);
+                using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+                settings.MakeEphemeral();
+                settings.Update(s => s with { ShowQuotaNotch = false, NetworkEnabled = true, AutoRefreshQuota = true,
+                    QuotaAllSources = false, QuotaSources = [id] });
+                var scheduler = new ControlledScheduler();
+                using var handler = new First429Handler(HttpStatusCode.ServiceUnavailable);
+                var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+                CodexQuotaProvider Provider() => id switch
+                {
+                    "codex" => new CodexQuotaProvider(auth, Path.Combine(directory, "schedule"), new HttpClient(handler, false), () => now),
+                    _ => throw new InvalidOperationException("Unsupported quota fixture source")
+                };
+                using var surface = new QuotaSurface(settings, loc, false, Provider,
+                    refreshInterval: TimeSpan.FromHours(1), now: () => now, retryScheduler: scheduler);
+                Drain();
+                Assert.Equal(1, handler.UsageCalls);
+                Assert.Equal(TimeSpan.FromSeconds(5), scheduler.Pending[id].Delay);
+                now = now.AddSeconds(4);
+                scheduler.Fire(id);
+                Assert.Equal(1, handler.UsageCalls);
+                now = now.AddSeconds(1);
+                scheduler.Fire(id);
+                Drain();
+                Assert.Equal(2, handler.UsageCalls);
+                Assert.Empty(scheduler.Pending);
+            }
+            finally { Directory.Delete(directory, recursive: true); }
+        });
+    }
+
+    [Fact]
+    public void FirstProvider429WakesAtRetryAfterRatherThanFiveMinuteTick()
+    {
+        RunSta(() =>
+        {
+            var directory = Path.Combine(Path.GetTempPath(), "quota-retry-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+            try
+            {
+                var auth = Path.Combine(directory, "auth.json");
+                File.WriteAllText(auth, """{"tokens":{"access_token":"fixture","account_id":"fixture-account"}}""");
+                var now = new DateTimeOffset(2026, 11, 15, 12, 0, 0, TimeSpan.Zero);
+                using var settings = new SettingsService(Dispatcher.CurrentDispatcher);
+                settings.MakeEphemeral();
+                settings.Update(s => s with { ShowQuotaNotch = false, NetworkEnabled = true, AutoRefreshQuota = true,
+                    QuotaAllSources = false, QuotaSources = ["codex"] });
+                var scheduler = new ControlledScheduler();
+                using var handler = new First429Handler();
+                var loc = new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En);
+                using var surface = new QuotaSurface(settings, loc, false,
+                    () => new CodexQuotaProvider(auth, Path.Combine(directory, "schedule"), new HttpClient(handler, false), () => now),
+                    refreshInterval: TimeSpan.FromHours(1), now: () => now, retryScheduler: scheduler);
+                Drain();
+                Assert.Equal(1, handler.UsageCalls);
+                Assert.Equal(TimeSpan.FromSeconds(75), scheduler.Pending["codex"].Delay);
+                now = now.AddSeconds(74);
+                scheduler.Fire("codex");
+                Assert.Equal(1, handler.UsageCalls);
+                Assert.Equal(TimeSpan.FromSeconds(1), scheduler.Pending["codex"].Delay);
+                now = now.AddSeconds(1);
+                scheduler.Fire("codex");
+                Drain();
+                Assert.Equal(2, handler.UsageCalls);
+                Assert.Empty(scheduler.Pending);
+            }
+            finally { Directory.Delete(directory, recursive: true); }
+        });
+    }
+
+    private sealed class First429Handler(HttpStatusCode firstStatus = HttpStatusCode.TooManyRequests) : HttpMessageHandler
+    {
+        public int UsageCalls;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            var usage = !request.RequestUri!.AbsolutePath.EndsWith("/rate-limit-reset-credits", StringComparison.Ordinal);
+            if (usage && ++UsageCalls == 1)
+            {
+                var limited = new HttpResponseMessage(firstStatus);
+                if (firstStatus == HttpStatusCode.TooManyRequests)
+                    limited.Headers.RetryAfter = new RetryConditionHeaderValue(TimeSpan.FromSeconds(75));
+                return Task.FromResult(limited);
+            }
+            var body = !usage ? """{"available_count":2}""" : """{"plan_type":"plus","rate_limit":{"primary_window":{"used_percent":25,"limit_window_seconds":18000}}}""";
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent(body) });
+        }
+    }
+
+    private sealed class ControlledScheduler : IQuotaRetryScheduler
+    {
+        public readonly Dictionary<string, (TimeSpan Delay, Action Retry)> Pending = new();
+        public void Schedule(string id, TimeSpan delay, Action retry) => Pending[id] = (delay, retry);
+        public void Cancel(string id) => Pending.Remove(id);
+        public void Clear() => Pending.Clear();
+        public void Fire(string id) { if (Pending.Remove(id, out var scheduled)) scheduled.Retry(); }
+    }
+
+    private static void Drain()
+    {
+        var frame = new DispatcherFrame();
+        Dispatcher.CurrentDispatcher.BeginInvoke(DispatcherPriority.ApplicationIdle, new Action(() => frame.Continue = false));
+        Dispatcher.PushFrame(frame);
+    }
+
+    private static void RunSta(Action action)
+    {
+        Exception? failure = null;
+        var thread = new Thread(() =>
+        {
+            try { action(); }
+            catch (Exception error) { failure = error; }
+        });
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start();
+        thread.Join();
+        if (failure is not null) ExceptionDispatchInfo.Capture(failure).Throw();
+    }
+}
