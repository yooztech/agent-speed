+        motion.Sample(815);
+        var state = new QuotaNotchRenderState([], ["codex"], true, true, edge, 1, Grip: motion.Frame);
+        view.Update(state);
+        rest.Update(state with { Grip = new(Arc: 1) });
+        view.Measure(view.Extent); view.Arrange(new Rect(view.Extent));
+        var bitmap = new RenderTargetBitmap((int)Math.Ceiling(view.Extent.Width), (int)Math.Ceiling(view.Extent.Height), 96, 96, PixelFormats.Pbgra32);
+        bitmap.Render(view);
+        Point? touched = null;
+        var bounds = view.GripInputGeometry.Bounds;
+        for (int y = Math.Max(0, (int)bounds.Top); y < Math.Min(bitmap.PixelHeight, bounds.Bottom) && touched is null; y++)
+            for (int x = Math.Max(0, (int)bounds.Left); x < Math.Min(bitmap.PixelWidth, bounds.Right); x++)
+            {
+                var point = new Point(x + .5, y + .5);
+                if (AlphaAt(bitmap, point) > 128 && view.GripInputGeometry.FillContains(point) && !rest.InputGeometry.FillContains(point))
+                { touched = point; break; }
+            }
+        Assert.NotNull(touched);
+        var pointer = touched!.Value;
+        Assert.False(intent.Update(new(-100, -100), false, false));
+        Assert.True(intent.Update(new(pointer.X, pointer.Y), view.GripInputGeometry.FillContains(pointer), false));
+        motion.SetTargets(true, true, true, false, 815, false);
+        view.Update(state with { Grip = motion.Frame, GripAcquired = true });
+        var envelope = view.GripActivationGeometry.Bounds;
+        for (int frame = 1; frame <= 80; frame++)
+        {
+            motion.Sample(815 + frame * 20);
+            view.Update(state with { Grip = motion.Frame, GripAcquired = true });
+            Assert.Equal(envelope, view.GripActivationGeometry.Bounds);
+            Assert.True(view.InputGeometry.FillContains(pointer));
+            Assert.True(intent.Update(new(pointer.X, pointer.Y), view.GripInputGeometry.FillContains(pointer),
+                view.GripActivationGeometry.FillContains(pointer)));
+            Assert.False(view.InputGeometry.FillContains(new Point(view.Extent.Width - 1, view.Extent.Height - 1)));
+        }
+        var departed = new Point(-100, -100);
+        Assert.False(intent.Update(new(departed.X, departed.Y), view.GripInputGeometry.FillContains(departed),
+            view.GripActivationGeometry.FillContains(departed)));
+        motion.SetTargets(true, false, false, false, 2500, false);
+        for (int frame = 1; frame <= 40; frame++)
+        {
+            motion.Sample(2500 + frame * 20);
+            view.Update(state with { Grip = motion.Frame });
+            Assert.False(intent.Update(new(departed.X, departed.Y), view.GripInputGeometry.FillContains(departed),
+                view.GripActivationGeometry.FillContains(departed)));
+        }
+    });
