@@ -0,0 +1,60 @@
+using System.Windows;
+using System.Windows.Threading;
+
+namespace AgentSpeed.Settings;
+
+/// <summary>A local-only observation-boundary clock, stopped whenever its display is hidden or unloaded.</summary>
+internal sealed class QuotaDisplayClock : IDisposable
+{
+    private readonly FrameworkElement _owner;
+    private readonly Action _tick;
+    private readonly Func<TimeSpan> _nextTick;
+    private readonly DispatcherTimer _timer;
+    private bool _disposed;
+
+    public QuotaDisplayClock(FrameworkElement owner, Action tick, Func<TimeSpan> nextTick)
+    {
+        _owner = owner;
+        _tick = tick;
+        _nextTick = nextTick;
+        _timer = new DispatcherTimer(DispatcherPriority.Background, owner.Dispatcher);
+        _timer.Tick += OnTick;
+        owner.IsVisibleChanged += OnVisibilityChanged;
+        owner.Loaded += OnLoaded;
+        owner.Unloaded += OnUnloaded;
+        Reschedule();
+    }
+
+    internal bool IsActive => _timer.IsEnabled;
+    internal TimeSpan NextTickDelay => _timer.Interval;
+
+    private void OnTick(object? sender, EventArgs e)
+    {
+        _timer.Stop();
+        if (!_disposed && _owner.IsLoaded && _owner.IsVisible) _tick();
+        Reschedule();
+    }
+
+    private void OnVisibilityChanged(object sender, DependencyPropertyChangedEventArgs e) => Reschedule();
+    private void OnLoaded(object sender, RoutedEventArgs e) => Reschedule();
+    private void OnUnloaded(object sender, RoutedEventArgs e) => _timer.Stop();
+
+    public void Reschedule()
+    {
+        _timer.Stop();
+        if (_disposed || !_owner.IsLoaded || !_owner.IsVisible) return;
+        _timer.Interval = _nextTick();
+        _timer.Start();
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _timer.Stop();
+        _timer.Tick -= OnTick;
+        _owner.IsVisibleChanged -= OnVisibilityChanged;
+        _owner.Loaded -= OnLoaded;
+        _owner.Unloaded -= OnUnloaded;
+    }
+}
