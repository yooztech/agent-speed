+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(QuotaStatus.Ok, [Window(null, .9)])));
+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(QuotaStatus.NeedsAuth, [])));
+        Assert.True(QuotaFormat.ShowFlyoutSummary(Snapshot(QuotaStatus.Ok, [], "blocked")));
