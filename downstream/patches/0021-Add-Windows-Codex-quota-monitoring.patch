diff --git a/windows/src/AgentSpeed/Settings/QuotaNotch.html b/windows/src/AgentSpeed/Settings/QuotaNotch.html
new file mode 100644
index 00000000..b070033a
--- /dev/null
+++ b/windows/src/AgentSpeed/Settings/QuotaNotch.html
@@ -0,0 +1,2489 @@
+<!DOCTYPE html>
+<!-- Codenotch Windows notch renderer, revision 835550a342871779135b6484d6899161c5222f7c; see QuotaNotch.LICENSE.txt. -->
+<html>
+<head>
+<meta charset="UTF-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
+<script>
+// Agent Speed's narrow, local-only bridge. The reference renderer owns its layout;
+// the host supplies only sanitized quota observations and user actions.
+(() => {
+  const handlers = new Map();
+  const values = {
+    get_codex: {status:'none', windows:[], fetched_at:0, note:''},
+    get_state: {sessions:[], agg:'idle', lang_resolved:'en'},
+    get_glyphs: {}, get_notch_slots: [{provider:'codex'}],
+    get_notch_edge: 'right', get_notch_insets: [0,0,0,0],
+    get_theme_resolved: 'dark', get_ui_flags: {notch_on_hover:false},
+    get_notch_shows_remaining:false, get_show_usage_pace:false, get_full_screen:false
+  };
+  const actions = new Set(['set_hot','report_dpr','open_settings','refresh_ring','begin_carry','show_notch_menu']);
+  window.agentQuotaSet = (name, value) => {
+    const getter = {codex:'get_codex',glyphs:'get_glyphs',state:'get_state',notch_edge:'get_notch_edge',theme_resolved:'get_theme_resolved'}[name];
+    if (getter) values[getter] = value;
+    for (const handler of handlers.get(name) || []) handler({payload:value});
+  };
+  window.__TAURI__ = {
+    core: {invoke: (name, args) => {
+      if (actions.has(name)) window.chrome?.webview?.postMessage({action:name, args:args || {}});
+      if (Object.prototype.hasOwnProperty.call(values, name)) return Promise.resolve(values[name]);
+      if (actions.has(name)) return Promise.resolve(name === 'refresh_ring');
+      return Promise.reject(new Error('Unsupported operation'));
+    }},
+    event: {listen: (name, handler) => {
+      if (!handlers.has(name)) handlers.set(name, []);
+      handlers.get(name).push(handler);
+      return Promise.resolve(() => {});
+    }}
+  };
+})();
+</script>
+<style>
+  /* The palette. Dark is the notch as it has always been drawn; light is the same shapes in the
+     inks Settings already uses, plus the Mac's own light secondary (#6b6b6b, Palette.textSecondary).
