+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task ResetRateLimitExtendsSharedPersistedPacingWithoutFailingUsage(bool legacySchedule)
+    {
+        using var context = new Context();
+        context.Handler.ResetStatus = HttpStatusCode.TooManyRequests;
+        context.Handler.ResetRetry = TimeSpan.FromMinutes(12);
+        using var provider = context.Provider();
+        var result = await provider.RefreshAsync();
+        Assert.Equal(QuotaStatus.Ok, result.Status);
+        Assert.Null(result.ResetCreditsAvailable);
+        Assert.Equal(Time.AddMinutes(12), result.NextAllowedAt);
+        context.Clock = Time.AddMinutes(6);
+        Assert.Equal(result, await provider.RefreshAsync());
+        if (legacySchedule)
+        {
+            // dev6 wrote successfulObservation=true after usage success even if reset lookup extended Retry-After,
+            // but persisted neither a snapshot version nor the separate retry deadline.
+            File.WriteAllText(Directory.GetFiles(context.Schedule).Single(),
+                $$"""{"nextAllowedAt":"{{Time.AddMinutes(12).ToString("O")}}","failures":0,"successfulObservation":true}""");
+        }
+        using var restarted = context.Provider();
+        var waiting = await restarted.RefreshAsync();
+        Assert.Equal(legacySchedule ? QuotaStatus.Error : QuotaStatus.Stale, waiting.Status);
+        Assert.Equal(legacySchedule, waiting.WaitingForRefresh);
+        Assert.Equal(legacySchedule ? null : result.ObservedAt, waiting.ObservedAt);
+        var startup = await restarted.RefreshStartupAsync();
+        Assert.Equal(Time.AddMinutes(12), startup.NextAllowedAt);
+        Assert.Equal(Time.AddMinutes(12), waiting.NextAllowedAt);
+        Assert.Equal(2, context.Handler.Calls);
+        context.Clock = Time.AddMinutes(12);
+        context.Handler.ResetStatus = HttpStatusCode.OK;
+        Assert.Equal(2, (await restarted.RefreshAsync()).ResetCreditsAvailable);
+        Assert.Equal(4, context.Handler.Calls);
+        if (legacySchedule)
+        {
+            // Once the deadline expires, a real successful observation upgrades the file. The next process
+            // can hydrate it and safely use the startup exception for its ordinary five-minute floor.
+            context.Clock = Time.AddMinutes(13);
+            using var migrated = context.Provider();
+            Assert.Equal(Time.AddMinutes(12), migrated.ReadCachedSnapshot().ObservedAt);
+            Assert.Equal(QuotaStatus.Ok, (await migrated.RefreshStartupAsync()).Status);
+            Assert.Equal(6, context.Handler.Calls);
+        }
+    }
