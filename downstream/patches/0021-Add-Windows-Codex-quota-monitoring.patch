@@ -0,0 +1,138 @@
+using System.Globalization;
+using AgentSpeed.Presentation.Settings;
+
+namespace AgentSpeed.Presentation.Tests;
+
+public class QuotaNotchGeometryOrbTests
+{
+
+    [Fact]
+    public void DiscToArcEndpointsAreSourceDiscAndExactRestingQuarter()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var center = QuotaNotchGeometry.GetOrbCenter(main);
+        var first = QuotaNotchGeometryOrb.DiscToArc(center, 0);
+        Assert.Null(first.ArcPath);
+        Assert.Equal(center, first.Disc.Center);
+        Assert.Equal(QuotaNotchGeometry.DiscRadius - .5, first.Disc.Radius, 6);
+        var last = QuotaNotchGeometryOrb.DiscToArc(center, 1);
+        Assert.Equal(QuotaNotchGeometry.GetOrbEntryPath(main), last.ArcPath);
+        Assert.Equal(QuotaNotchGeometry.ArcFill, last.ArcWidth, 6);
+        Assert.Equal(0, last.Disc.Radius);
+        Assert.False(last.Liquid);
+    }
+
+    [Fact]
+    public void PickupDrawsShrinkingDiscIntoFlareOnReferenceNeck()
+    {
+        var center = QuotaNotchGeometry.GetOrbCenter(QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52))));
+        var start = QuotaNotchGeometryOrb.DiscMerge(center, 0, QuotaNotchGeometry.DiscRadius);
+        var middle = QuotaNotchGeometryOrb.DiscMerge(center, .5, QuotaNotchGeometry.DiscRadius);
+        var end = QuotaNotchGeometryOrb.DiscMerge(center, 1, QuotaNotchGeometry.DiscRadius);
+        Assert.Equal(center, start.Disc.Center);
+        Assert.True(middle.Liquid);
+        Assert.NotNull(middle.NeckPath);
+        Assert.NotNull(middle.BandPath);
+        Assert.True(end.Disc.Center.X < center.X && end.Disc.Center.Y < center.Y);
+        Assert.True(end.Disc.Radius < middle.Disc.Radius && middle.Disc.Radius < start.Disc.Radius);
+    }
+    [Fact]
+    public void ArcSeparationUsesLiquidNeckAndReturnsToPlainQuarter()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var center = QuotaNotchGeometry.GetOrbCenter(main);
+        Assert.Equal(default, QuotaNotchGeometryOrb.GooArc(center, 0, false, false));
+        var middle = QuotaNotchGeometryOrb.GooArc(center, .5, false, false);
+        Assert.True(middle.Liquid);
+        Assert.NotNull(middle.ArcPath);
+        Assert.NotNull(middle.BandPath);
+        Assert.NotNull(middle.NeckPath);
+        var quick = QuotaNotchGeometryOrb.GooArc(center, .5, true, true);
+        Assert.False(quick.Liquid);
+        Assert.Null(quick.NeckPath);
+        var rest = QuotaNotchGeometryOrb.GooArc(center, 1, false, false);
+        Assert.Equal(QuotaNotchGeometry.GetOrbEntryPath(main), rest.ArcPath);
+        Assert.Equal(QuotaNotchGeometry.ArcFill, rest.ArcWidth, 6);
+        Assert.False(rest.Liquid);
+    }
+
+
+    [Fact]
+    public void FinalDropsRetainVisibleEntryWithoutPermanentDiscOrLiquid()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var final = new QuotaNotchGeometry.GripFrame(1, Arc: 1);
+        var entry = QuotaNotchGeometry.CreateOrbEntry(main, final);
+        Assert.Equal(QuotaNotchGeometry.GetOrbEntryPath(main), entry.ArcPath);
+        Assert.Equal(QuotaNotchGeometry.ArcFill, entry.ArcWidth, 6);
+        Assert.Equal(default, QuotaNotchGeometry.CreateOrb(main, final));
+        Assert.False(QuotaNotchGeometry.CreateGrip(main, final).Liquid);
+        Assert.Equal(0, QuotaNotchGeometry.CreateOrbEntry(main, default).ArcWidth);
+        Assert.Null(QuotaNotchGeometry.GetControlBridgePath(main, default));
+    }
+
+    [Fact]
+    public void EveryMorphKeepsRetainedEntryAndDeterministicNarrowRoutes()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var expected = QuotaNotchGeometry.GetOrbEntryPath(main);
+        for (int sample = 1; sample <= 100; sample++)
+        {
+            double progress = sample / 100d;
+            var frame = new QuotaNotchGeometry.GripFrame(progress, Arc: 1, Disc: 1 - progress);
+            Assert.Equal(expected, QuotaNotchGeometry.CreateOrbEntry(main, frame).ArcPath);
+            Assert.NotNull(QuotaNotchGeometry.GetControlBridgePath(main, frame));
+            Assert.Equal(QuotaNotchGeometry.ArcFill, QuotaNotchGeometry.CreateOrbEntry(main, frame).ArcWidth, 6);
+            if (progress > .01)
+                Assert.Equal(QuotaNotchGeometry.GripCorridorWidth, QuotaNotchGeometry.GetGripCorridor(main, frame).Width);
+        }
+    }
+
+    [Fact]
+    public void ActivatedFanContainsAllEighteenStraightArcToDotTrajectoriesWithinPocket()
+    {
+        var main = QuotaNotchGeometry.CreateMain(1, new QuotaNotchGeometry.ContentLayout(false, new QuotaNotchGeometry.Cell(52, 24, 52)));
+        var frame = new QuotaNotchGeometry.GripFrame(1, Arc: 1);
+        Assert.Null(QuotaNotchGeometry.GetControlFanPath(main, new(Arc: 1)));
+        string path = QuotaNotchGeometry.GetControlFanPath(main, frame)!;
+        var tokens = path.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+        Assert.Equal(18 * 13, tokens.Length);
+        var center = QuotaNotchGeometry.GetOrbCenter(main);
+        double radius = QuotaNotchGeometry.ArcRadius, diagonal = radius * Math.Sqrt(.5);
+        QuotaNotchGeometry.Point[] anchors = [new(center.X - radius, center.Y),
+            new(center.X - diagonal, center.Y - diagonal), new(center.X, center.Y - radius)];
+        QuotaNotchGeometry.Point ReadPoint(int at) => new(double.Parse(tokens[at], CultureInfo.InvariantCulture),
+            double.Parse(tokens[at + 1], CultureInfo.InvariantCulture));
+        for (int route = 0; route < 18; route++)
+        {
+            int at = route * 13;
+            Assert.Equal("M", tokens[at]); Assert.Equal("Z", tokens[at + 12]);
+            var corners = new[] { ReadPoint(at + 1), ReadPoint(at + 4), ReadPoint(at + 7), ReadPoint(at + 10) };
+            var from = anchors[route / 6];
+            var to = QuotaNotchGeometry.GetGripDot(main, frame, route % 6).Center;
+            Assert.Equal(from.X, (corners[0].X + corners[3].X) / 2, 3);
+            Assert.Equal(from.Y, (corners[0].Y + corners[3].Y) / 2, 3);
+            Assert.Equal(to.X, (corners[1].X + corners[2].X) / 2, 3);
+            Assert.Equal(to.Y, (corners[1].Y + corners[2].Y) / 2, 3);
+            foreach (var point in corners)
+            {
+                Assert.InRange(point.X, center.X - radius - 4.001, center.X + QuotaNotchGeometry.GripPitch + 4.001);
+                Assert.InRange(point.Y, center.Y - radius - 4.001,
+                    center.Y + QuotaNotchGeometry.GripReach + QuotaNotchGeometry.GripPitch / 2 + 4.001);
+            }
+            for (int step = 1; step < 100; step++)
+            {
+                double t = step / 100d;
+                var point = new QuotaNotchGeometry.Point(from.X + (to.X - from.X) * t, from.Y + (to.Y - from.Y) * t);
+                double sign = 0;
+                for (int side = 0; side < 4; side++)
+                {
+                    var a = corners[side]; var b = corners[(side + 1) % 4];
+                    double cross = (b.X - a.X) * (point.Y - a.Y) - (b.Y - a.Y) * (point.X - a.X);
+                    if (side == 0) sign = Math.Sign(cross);
+                    Assert.True(cross * sign >= -.001);
+                }
+            }
+        }
+    }
+}
