+  if((v>0&&v<1)||(v>99&&v<100)){ used=smallPct(v); left=100-v>99.9?'>99.9':smallPct(Math.max(0,100-v)); }
+  else { const u=Math.round(v); used=String(u); left=String(Math.max(0,100-u)); }
+  if(derived) used='~'+used;
+  return [used,left];
+}
+// Both ends, since vendors disagree on which they print; the left half comes from the rounded used half, as their dashboards do.
+// The line keeps both ends either way — the card is the detailed view — but the remaining figure leads when set.
+function usedCopy(w){
+  if (w.used == null) return w.unknown || '—';
+  const [u,l]=usedHalves(w.used,w.derived);
+  const d=deficitOf(w);
+  return (showRemaining?ui().leftUsed(l,u):ui().usedLeft(u,l))+(d!=null?' · '+ui().deficit(d):'');
+}
