+using AgentSpeed.Services;
+
+namespace AgentSpeed.Settings;
+
+/// <summary>Owns independent local quota observations and the subscription surfaces.</summary>
+internal sealed class QuotaSurface : IDisposable
+{
+
+    private readonly SettingsService _settings;
+    private readonly Localizer _loc;
+    private readonly DispatcherTimer _timer;
+    private readonly IQuotaRetryScheduler _retryScheduler;
+    private readonly QuotaFailureRetry _retry = new();
+    private readonly DispatcherTimer _flyoutClock;
+    private readonly Func<DateTimeOffset> _now;
+    private readonly Func<CodexQuotaProvider>? _providerFactory;
+    private CodexQuotaProvider? _provider;
+    private IReadOnlyList<QuotaSnapshot> _snapshots = [];
+    private bool _busy;
+    private int _generation;
+    private QuotaNotchWindow? _notch;
+    private QuotaNotchFailure? _notchFailure;
+    private QuotaSettingsPage? _page;
+    private bool _pageActive;
+    private bool _flyoutOpen;
+    private bool _disposed;
+    private bool _autoRefresh;
+    private bool _startupPending;
+    private bool _startupAttempted;
+    private bool _networkEnabled;
+    private bool _dark;
+    private bool _reduceMotion;
+    public event Action<UIElement?>? FlyoutChanged;
+    public event Action? OpenSettingsRequested;
+
+    public QuotaSurface(SettingsService settings, Localizer loc, bool dark,
+        Func<CodexQuotaProvider>? providerFactory = null, TimeSpan? refreshInterval = null,
+        Func<DateTimeOffset>? now = null, IQuotaRetryScheduler? retryScheduler = null)
+    {
+        _settings = settings;
+        _loc = loc;
+        _dark = dark;
+        _retryScheduler = retryScheduler ?? new QuotaRetryScheduler(Dispatcher.CurrentDispatcher);
+        _providerFactory = providerFactory;
+        _now = now ?? (() => DateTimeOffset.UtcNow);
+        _flyoutClock = new DispatcherTimer(DispatcherPriority.Background)
+        {
+            Interval = TimeSpan.FromMinutes(1)
+        };
+        _flyoutClock.Tick += OnFlyoutClockTick;
+        _timer = new DispatcherTimer { Interval = refreshInterval ?? TimeSpan.FromMinutes(5) };
+        _timer.Tick += (_, _) => RefreshAutomatically();
+        ApplySettings();
+    }
+
+    public UIElement CreatePage()
+    {
+        _page?.Dispose();
+        _page = new QuotaSettingsPage(_loc, Refresh,
+            enabled => _settings.Update(s => s with { AutoRefreshQuota = enabled }),
+            SetSource, enabled =>
+            {
+                _notchFailure = null;
+                _settings.Update(s => s with { ShowQuotaNotch = enabled });
+            }, enabled => _settings.Update(s => s with { KeepQuotaNotchExpanded = enabled }), SetAllSources, _now);
+        Render();
+        _page.SetActive(_pageActive);
+        return _page;
+    }
+
+    private void SetSource(string id, bool enabled)
+    {
+        if (!QuotaProviders.Supported.Any(p => p.Id == id)) return;
+        _settings.Update(s => s with
+        {
+            QuotaAllSources = false,
+            QuotaSources = QuotaProviders.Supported.Where(p => p.Id == id ? enabled : s.QuotaSources.Contains(p.Id))
+                .Select(p => p.Id).ToArray()
+        });
+    }
+
+    private void SetAllSources(bool enabled) => _settings.Update(s => s with
+    {
+        QuotaAllSources = enabled,
+        // Turning off “all” keeps today's supported readers explicitly selected, like OrbPage.
+        QuotaSources = enabled || s.QuotaAllSources
+            ? QuotaProviders.Supported.Select(provider => provider.Id).ToArray() : s.QuotaSources
+    });
+
+    public void SetPageActive(bool active)
+    {
+        _pageActive = active;
+        _page?.SetActive(active);
+        if (active) RefreshAutomatically();
+    }
+
+    public void SetFlyoutActive(bool active)
+    {
+        _flyoutOpen = active;
+        if (active) { Render(); RefreshAutomatically(); }
+        else _flyoutClock.Stop();
+    }
+
+    public void ClosePage()
+    {
+        _pageActive = false;
+        _page?.Dispose();
+        _page = null;
+    }
+
+    public void ApplySettings()
+    {
+        if (_disposed) return;
+        var enabled = _settings.Current.QuotaSources;
+        var added = false;
+        var networkChanged = _networkEnabled != _settings.Current.NetworkEnabled;
+        _networkEnabled = _settings.Current.NetworkEnabled;
+        if (!enabled.Contains("codex"))
+        {
+            _generation++;
+            _retryScheduler.Cancel("codex");
+            _retry.Clear();
+            _provider?.Dispose();
+            _provider = null;
+            _busy = false;
+            _startupPending = false;
+            _snapshots = [];
+        }
+        else
+        {
+            if (_provider is null)
+            {
+                _provider = _providerFactory?.Invoke() ?? new CodexQuotaProvider();
+                added = true;
+                _startupPending = !_startupAttempted;
+            }
+            if (networkChanged && !_networkEnabled)
+            {
+                _generation++;
+                _retryScheduler.Cancel("codex");
+                _retry.Clear();
+                _provider.Cancel();
+                _busy = false;
+            }
+            // Hydrate before the first render or native window show, even without network consent.
+            if (added || networkChanged) _snapshots = [_provider.ReadCachedSnapshot()];
+        }
+        if (_settings.Current.ShowQuotaNotch && _notchFailure is null)
+        {
+            if (_notch is null)
+            {
+                _notch = new QuotaNotchWindow(_settings, _loc, _dark);
+                _notch.SetReduceMotion(_reduceMotion);
+                _notch.OpenSettingsRequested += () => OpenSettingsRequested?.Invoke();
+                _notch.RefreshRequested += Refresh;
+                _notch.InitializationFailed += failure =>
+                {
+                    _notchFailure = failure;
+                    Render();
+                };
+                _notch.Update(_snapshots, _settings.Current.NetworkEnabled);
+            }
+            if (!_notch.IsVisible) _notch.Show();
+            _notch.Place();
+        }
+        else if (_notch is not null)
+        {
+            _notch.Hide();
+            if (_notchFailure is not null) { _notch.Close(); _notch = null; }
+        }
+        var startAutomatic = !_autoRefresh && _settings.Current.AutoRefreshQuota;
+        _autoRefresh = _settings.Current.AutoRefreshQuota;
+        Render();
+        UpdateTimer();
+        if (_startupPending && _networkEnabled) RefreshStartup();
+        else if (added || startAutomatic || networkChanged && _networkEnabled) RefreshAutomatically();
+    }
+
+    public void Relocalize() => Render();
+    public void NetworkEnabled()
+    {
+        ApplySettings();
+    }
+
+    public void SetTheme(bool dark)
+    {
+        _dark = dark;
+        _notch?.SetTheme(dark);
+    }
+
+    public void SetReduceMotion(bool reduceMotion)
+    {
+        _reduceMotion = reduceMotion;
+        _notch?.SetReduceMotion(reduceMotion);
+    }
+
+
+    private void UpdateTimer()
+    {
+        if (!_disposed && _settings.Current.NetworkEnabled && _settings.Current.AutoRefreshQuota &&
+            _provider is not null) _timer.Start();
+        else _timer.Stop();
+        if (!_settings.Current.AutoRefreshQuota)
+        {
+            _retryScheduler.Clear();
+            _retry.Clear();
+        }
+    }
+
+    private void RefreshAutomatically()
+    {
+        if (_settings.Current.AutoRefreshQuota && _retry.DueAt is null) Refresh();
+    }
+
+    private void RefreshStartup()
+    {
+        if (_disposed || _busy || !_settings.Current.NetworkEnabled || _provider is null) return;
+        _startupPending = false;
+        _startupAttempted = true;
+        RefreshCore(true);
+    }
+
+    private void Refresh() => RefreshCore(false);
+
+    private async void RefreshCore(bool startup)
+    {
+        if (_disposed || _busy || !_settings.Current.NetworkEnabled || _provider is null) return;
+        _retryScheduler.Cancel("codex");
+        var startedAt = _now();
+        var provider = _provider;
+        var generation = _generation;
+        _busy = true;
+        var before = provider.ReadCachedSnapshot();
+        _snapshots = [before];
+        Render();
+        bool IsCurrent() => !_disposed && _settings.Current.NetworkEnabled && generation == _generation;
+        try
+        {
+            // The real adapter owns its persisted request floor, including manual refreshes.
+            var result = await (startup ? provider.RefreshStartupAsync() : provider.RefreshAsync());
+            if (IsCurrent())
+            {
+                _snapshots = [result];
+                if (_settings.Current.AutoRefreshQuota)
+                {
+                    _retry.Complete(before, result, startedAt, _now());
+                    ScheduleRetry();
+                }
+            }
+        }
+        catch (OperationCanceledException) { }
+        catch (ObjectDisposedException) { }
+        finally
+        {
+            if (IsCurrent())
+            {
+                _busy = false;
+                Render();
+            }
+        }
+    }
+
+    private void ScheduleRetry()
+    {
+        if (_disposed || !_networkEnabled || !_settings.Current.AutoRefreshQuota || _retry.DueAt is not { } due) return;
+        var generation = _generation;
+        var provider = _provider;
+        var delay = due - _now();
+        _retryScheduler.Schedule("codex", delay >= TimeSpan.FromSeconds(1) ? delay : TimeSpan.FromSeconds(1), () =>
+        {
+            if (_disposed || !_networkEnabled || !_settings.Current.AutoRefreshQuota || generation != _generation ||
+                provider is null || !ReferenceEquals(provider, _provider) || _busy) return;
+            if (_retry.DueAt is { } deadline && deadline > _now()) { ScheduleRetry(); return; }
+            RefreshCore(startup: false);
+        });
+    }
+
+    private string Text(string key) => _loc["win.quota." + key];
+    private string Percent(double? value) => QuotaFormat.Percent(_loc, value);
+    private string Date(DateTimeOffset value) => value.ToLocalTime().ToString("g", _loc.Culture);
+    private static TextBlock Line(string text, double size = 13) => new()
+    {
+        Text = text, FontSize = size, TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 3, 0, 3)
+    };
+
+    internal bool IsFlyoutTimeRefreshActive => _flyoutClock.IsEnabled;
+    internal TimeSpan FlyoutTimeRefreshDelay => _flyoutClock.Interval;
+
+    private void OnFlyoutClockTick(object? sender, EventArgs e) => RefreshFlyoutTimes();
+
+    /// <summary>Refresh only the open summary's local labels; never request provider data.</summary>
+    internal void RefreshFlyoutTimes()
+    {
+        _flyoutClock.Stop();
+        if (!_disposed && _flyoutOpen && _settings.Current.NetworkEnabled)
+            FlyoutChanged?.Invoke(CreateFlyoutSummary(_snapshots));
+        UpdateFlyoutClock();
+    }
+
+    private void UpdateFlyoutClock()
+    {
+        _flyoutClock.Stop();
+        if (_disposed || !_flyoutOpen || !_settings.Current.NetworkEnabled) return;
+        TimeSpan? nextTick = null;
+        var now = _now();
+        foreach (var snapshot in _snapshots)
+        {
+            if (!snapshot.ObservedAt.HasValue || !QuotaFormat.ShowFlyoutSummary(snapshot)) continue;
+            var delay = QuotaFormat.ObservationAgeRefreshDelay(snapshot.ObservedAt, now);
+            if (nextTick is null || delay < nextTick.Value) nextTick = delay;
+        }
+        if (nextTick is not { } interval) return;
+        _flyoutClock.Interval = interval;
+        _flyoutClock.Start();
+    }
+
+
+    private void Render()
+    {
+        if (_disposed) return;
+        var snapshots = _snapshots;
+        _notch?.Update(snapshots, _settings.Current.NetworkEnabled);
+        if (_flyoutOpen) FlyoutChanged?.Invoke(CreateFlyoutSummary(snapshots));
+        UpdateFlyoutClock();
+        _page?.Update(new QuotaPageState(snapshots, _settings.Current.QuotaSources,
+            _settings.Current.AutoRefreshQuota, _settings.Current.NetworkEnabled,
+            _busy, _settings.Current.ShowQuotaNotch, _settings.Current.KeepQuotaNotchExpanded,
+            _notchFailure is null ? null : Text("notchInitializationFailed"), _settings.Current.QuotaAllSources));
+    }
+
+    private UIElement? CreateFlyoutSummary(IReadOnlyList<QuotaSnapshot> snapshots)
+    {
+        if (!_settings.Current.NetworkEnabled) return null;
+        StackPanel? summaries = null;
+        var now = _now();
+        foreach (var snapshot in snapshots.Where(QuotaFormat.ShowFlyoutSummary).Take(2))
+        {
+            summaries ??= new StackPanel();
+            var headline = QuotaFormat.Headline(snapshot);
+            var content = new StackPanel { Margin = new Thickness(0, 12, 0, 0) };
+            content.Children.Add(Line(Text("title"), 14));
+            content.Children.Add(Line(snapshot.DisplayName + " · " + QuotaFormat.Status(_loc, true, snapshot, now), 12));
+            if (snapshot is { Status: QuotaStatus.Stale, ObservedAt: { } observedAt })
+                content.Children.Add(Line(_loc.Format("win.quota.age", Math.Max(0, (int)(now - observedAt).TotalMinutes)), 12));
+            if (snapshot.Block is not null) content.Children.Add(Line(Text("block") + ": " + snapshot.Block, 12));
+            if (headline is not null)
+            {
+                var reading = new StackPanel { Opacity = snapshot.Status == QuotaStatus.Stale ? .65 : 1 };
+                reading.Children.Add(Line(QuotaFormat.WindowLabel(_loc, headline, snapshot.DisplayName), 12));
+                if (headline.UsedFraction is { } value)
+                {
+                    var bar = new ProgressBar { Minimum = 0, Maximum = 1, Value = QuotaFormat.BarFill(value), Height = 5, Margin = new Thickness(0, 4, 0, 4) };
+                    bar.SetResourceReference(Control.ForegroundProperty, value >= .9 ? "SystemFillColorCautionBrush" : "AccentFillColorDefaultBrush");
+                    reading.Children.Add(bar);
+                }
+                reading.Children.Add(Line(_loc.Format("win.quota.remaining", Percent(QuotaFormat.RemainingFraction(headline.UsedFraction))) + " · " + _loc.Format("win.quota.used", Percent(headline.UsedFraction)), 12));
+                if (headline.ResetAt is { } reset) reading.Children.Add(Line(_loc.Format("win.quota.reset", Date(reset)), 12));
+                content.Children.Add(reading);
+            }
+            if (snapshot.Plan is not null) content.Children.Add(Line(Text("plan") + ": " + snapshot.Plan, 12));
+            var button = new Button { Content = content, HorizontalContentAlignment = HorizontalAlignment.Stretch,
+                HorizontalAlignment = HorizontalAlignment.Stretch, ToolTip = Text("open") };
+            System.Windows.Automation.AutomationProperties.SetName(button, Text("open"));
+            button.Click += (_, _) => OpenSettingsRequested?.Invoke();
+            summaries.Children.Add(button);
+        }
+        return summaries;
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _timer.Stop();
+        _retryScheduler.Clear();
+        _flyoutClock.Stop();
+        _flyoutClock.Tick -= OnFlyoutClockTick;
+        _generation++;
+        _provider?.Cancel();
+        _provider?.Dispose();
+        _provider = null;
+        _snapshots = [];
+        _notch?.Close();
+        _notch = null;
+        _page?.Dispose();
+        _page = null;
+    }
+}
