+function deficitOf(w){
+  const now=Date.now();
+  if(!showPace) return null; // the Mac's usage pace setting, off by default there too
+  if(w.count!=null || !Number.isFinite(w.used) || w.used<0 || !Number.isFinite(w.duration_ms) || !(w.duration_ms>0) || !Number.isFinite(w.resets_at) || !(w.resets_at>now)) return null;
+  const elapsed=1-Math.min((w.resets_at-now)/w.duration_ms,1);
+  const points=(Math.min(w.used,1)-elapsed)*100;
