+        }
+        if (cardsText is not null) balances.Children.Add(Text(cardsText, 12, Muted, margin: new Thickness(0, 0, 18, 4)));
+        if (balances.Children.Count > 0 || snapshot.ObservedAt.HasValue)
+        {
+            var footer = new DockPanel { LastChildFill = true };
+            if (snapshot.ObservedAt is { } observed)
+            {
+                var updated = Text(_loc.Format("win.quota.updatedAt", Date(observed)), 12, Muted);
+                updated.TextWrapping = TextWrapping.NoWrap;
+                updated.HorizontalAlignment = HorizontalAlignment.Right;
