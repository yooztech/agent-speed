+        open.Click += (_, _) => OpenSettingsRequested?.Invoke();
+        hide.Click += (_, _) => _settings.Update(s => s with { ShowQuotaNotch = false });
+        _menu.Items.Add(open);
+        _menu.Items.Add(hide);
+        _menu.Closed += MenuClosed;
+        _menuOpen = true;
+        CancelGrace();
+        UpdateTargets();
+        _menu.IsOpen = true;
+        e.Handled = true;
+    }
+
+    private void MenuClosed(object sender, RoutedEventArgs e)
+    {
+        if (_menu is not null) _menu.Closed -= MenuClosed;
+        _menu = null;
+        _menuOpen = false;
+        if (!_mainInside && !_cardInside) StartGrace();
+        UpdateTargets();
+    }
+
+    private void VisibilityChanged(object sender, DependencyPropertyChangedEventArgs e)
+    {
+        if (IsVisible)
+        {
+            if (_failed) { Hide(); return; }
+            _expansion = _toExpansion = _settings.Current.KeepQuotaNotchExpanded ? 1 : 0;
+            _expansionRun = default;
+            UpdateTargets();
+            Place();
+            return;
+        }
+        StopInteraction();
+    }
+
+    private void StopInteraction()
+    {
+        StopMotion();
+        CancelGrace();
+        _dragging = _pendingDrag = _mainInside = _cardInside = false;
+        _hover = _pressed = default;
+        _activeSource = null;
+        if (IsMouseCaptured) ReleaseMouseCapture();
+        if (_menu is not null) _menu.IsOpen = false;
+        HideCard();
+        _expansion = _toExpansion = 0;
+        _gripMotion.Reset();
+        _gripIntent.Reset();
+        _expansionRun = default;
+        UpdateTargets();
+    }
+
+    private void SettingsChanged(object? sender, SettingsChangedEventArgs e)
+    {
+        if (!e.Current.ShowQuotaNotch && IsVisible) Hide();
+        UpdateTargets();
+        Place();
+    }
+
+    private void LanguageChanged(object? sender, EventArgs e)
+    {
+        _mainState = _cardState = null;
+        RenderAndPlace();
+    }
+
+    private void QueuePlace()
+    {
+        if (_placeQueued || _closed || _failed) return;
+        _placeQueued = true;
+        Dispatcher.BeginInvoke(DispatcherPriority.Loaded, () =>
+        {
+            _placeQueued = false;
+            if (_closed || _failed) return;
+            if (_dragging) DragToCursor();
+            else Place();
+        });
+    }
+
+    private void SystemParametersChanged(object? sender, PropertyChangedEventArgs e)
+    {
+        if (!_motionPolicySupplied)
+        {
+            _reduceMotion = !SystemParameters.ClientAreaAnimation;
+            if (_reduceMotion) Dispatcher.BeginInvoke(DispatcherPriority.Loaded, UpdateTargets);
+        }
+        QueuePlace();
+    }
+    private void DisplaySettingsChanged(object? sender, EventArgs e) => QueuePlace();
+
+    private void Fail(Exception exception)
+    {
+        if (_closed || _failed) return;
+        _failed = true;
+        var causes = new List<string>();
+        for (var cause = exception; cause is not null; cause = cause.InnerException)
+            causes.Add($"{cause.GetType().FullName}/0x{cause.HResult:X8}" + (cause is Win32Exception native ? $"/native={native.NativeErrorCode}" : string.Empty));
+        FailureDiagnostic = $"stage={_stage}; exceptions=" + string.Join(" > ", causes);
+        // There is deliberately no rectangular or hit-test-only fallback on native-region failure.
+        StopInteraction();
+        Hide();
+        if (!_initialized) InitializationFailed?.Invoke(QuotaNotchFailure.InitializationFailed);
+    }
+
+    private void CardClosed(object? sender, EventArgs e)
+    {
+        _cardClosed = true;
+        _cardSource?.RemoveHook(WindowMessage);
+        _cardRegion.Dispose();
+        _cardSource = null;
+        _cardHwnd = 0;
+    }
+
+    private void WindowClosed(object? sender, EventArgs e)
+    {
+        _closed = true;
+        StopInteraction();
+        _displayClock.Dispose();
+        _leaveGrace.Tick -= LeaveGraceElapsed;
+        _source?.RemoveHook(WindowMessage);
+        _cardSource?.RemoveHook(WindowMessage);
+        _region.Dispose();
+        _cardRegion.Dispose();
+        if (!_cardClosed) _card.Close();
+        _settings.Changed -= SettingsChanged;
+        _loc.LanguageChanged -= LanguageChanged;
+        SystemParameters.StaticPropertyChanged -= SystemParametersChanged;
+        Microsoft.Win32.SystemEvents.DisplaySettingsChanged -= DisplaySettingsChanged;
+    }
+}
