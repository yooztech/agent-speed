diff --git a/windows/src/AgentSpeed.Presentation/Settings/QuotaFormat.cs b/windows/src/AgentSpeed.Presentation/Settings/QuotaFormat.cs
new file mode 100644
index 00000000..f998cf2e
--- /dev/null
+++ b/windows/src/AgentSpeed.Presentation/Settings/QuotaFormat.cs
@@ -0,0 +1,54 @@
+using AgentSpeed.Core;
+using AgentSpeed.Presentation.Localization;
+
+namespace AgentSpeed.Presentation.Settings;
+
+public sealed record QuotaNotchProjection(string Status, IReadOnlyList<CodexQuotaWindow> Windows, DateTimeOffset? ObservedAt, string Note);
+
+/// <summary>Consumer-visible Codex quota labels and percentages.</summary>
+public static class QuotaFormat
+{
+    public static bool ShowFlyoutSummary(CodexQuotaSnapshot? snapshot) => snapshot is not null &&
+        (snapshot.Status == CodexQuotaStatus.NeedsAuth || snapshot.Block is not null ||
+         snapshot.Windows.Any(window => window.UsedFraction >= .9));
+    public static string Status(Localizer loc, bool networkEnabled, CodexQuotaSnapshot? snapshot) =>
+        loc["win.quota." + (!networkEnabled ? "offline" : snapshot is null ? "empty"
+            : snapshot.WaitingForRefresh ? "waiting" : snapshot.Status.ToString().ToLowerInvariant())];
+
+    /// <summary>Retain previously observed windows offline, but never present them as fresh.</summary>
+    public static QuotaNotchProjection NotchProjection(Localizer loc, bool networkEnabled, CodexQuotaSnapshot? snapshot)
+    {
+        var windows = snapshot?.Windows ?? Array.Empty<CodexQuotaWindow>();
+        var status = !networkEnabled ? (windows.Count > 0 ? "stale" : "none") : snapshot?.Status switch
+        {
+            CodexQuotaStatus.Ok => "ok", CodexQuotaStatus.Stale => "stale",
+            CodexQuotaStatus.NeedsAuth => "needsAuth", _ => "none"
+        };
+        return new(status, windows, snapshot?.ObservedAt, Status(loc, networkEnabled, snapshot));
+    }
+
+
+    public static string Percent(Localizer loc, double? value) => value is { } v ? v.ToString("P0", loc.Culture) : loc["win.quota.unknown"];
+
+    /// <summary>Display fill is bounded; the accompanying text retains over-limit readings.</summary>
+    public static double BarFill(double used) => Math.Clamp(used, 0, 1);
+
+    /// <summary>The Settings account card switches from blue to amber near exhaustion.</summary>
+    public static bool BarIsWarning(double used) => used >= .9;
+
+    public static string WindowLabel(Localizer loc, CodexQuotaWindow window)
+    {
+        var duration = window.Duration;
+        var key = duration is null || duration <= TimeSpan.Zero ? "window"
+            : duration == TimeSpan.FromDays(7) ? "weekly"
+            : duration >= TimeSpan.FromDays(28) && duration <= TimeSpan.FromDays(31) ? "monthly"
+            : duration <= TimeSpan.FromHours(24) ? "session" : "window";
+        var label = loc["win.quota." + key];
+        if (window.Label != "Codex") label = window.Label + " · " + label;
+        if (duration is { } value && value > TimeSpan.Zero && value < TimeSpan.FromDays(1))
+            label += " · " + loc.Format("win.quota.hours", value.TotalHours.ToString("0.##", loc.Culture));
+        else if (duration is { } days && days >= TimeSpan.FromDays(1) && key == "window")
+            label += " · " + loc.Format("win.quota.days", days.TotalDays.ToString("0.##", loc.Culture));
+        return label;
+    }
+}
