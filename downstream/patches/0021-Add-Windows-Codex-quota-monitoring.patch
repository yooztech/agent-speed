+    [InlineData("right")]
+    [InlineData("top")]
+    [InlineData("bottom")]
+    public void AcquiredDiscEnvelopeRemainsStableThroughBurstAndReturn(string edge) => OnSta(() =>
+    {
+        var view = new QuotaNotchView(new Localizer(Localizer.LoadEmbeddedTable(), LanguageCodes.En));
+        var state = new QuotaNotchRenderState([], ["codex"], true, true, edge, 1, Grip: new(Arc: 1));
+        view.Update(state);
+        var main = QuotaNotchGeometry.CreateMain(1, view.ContentLayout);
+        var bounds = QuotaNotchGeometry.CreateEnvelope(view.ContentLayout);
+        var transform = QuotaNotchGeometry.EdgeTransform(edge, bounds.Depth, bounds.Offset(main));
+        var center = QuotaNotchGeometry.GetOrbCenter(main);
+        var transformed = transform.Apply(new(center.X + QuotaNotchGeometry.DiscRadius - 1, center.Y));
+        var point = new Point(transformed.X, transformed.Y);
+        Assert.False(view.InputGeometry.FillContains(point));
+        QuotaNotchGeometry.GripFrame[] frames = [new(Arc: 1, Disc: .5), new(Arc: 1, Disc: 1),
+            new(.4, Arc: 1, Disc: .4), new(1, Arc: 1), new(1, Squeeze: 1, Arc: 1), new(Arc: 1)];
+        foreach (var frame in frames)
+        {
