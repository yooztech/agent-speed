+        if (monitor is null) return;
+        var anchor = QuotaNotchLayout.SnapDrag(monitor.WorkRect, new PointD(screen.X, screen.Y), _grabOffsetDip, monitor.Scale);
+        _monitor = monitor;
+        _edge = anchor.Edge;
+        _along = anchor.Along;
+        RenderAndPlace();
+    }
