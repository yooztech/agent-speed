+    contourPath=document.createElementNS(pillContour.namespaceURI,'path');
+    pillContour.appendChild(contourPath);
+    const root=document.getElementById('root');root.insertBefore(pillContour,root.firstChild);
+  }
+  const r=pill.getBoundingClientRect(),vertical=edgeIsVertical();
