+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace AgentSpeed.Core.Tests;
+
+public sealed class QuotaColdStartTests
+{
+    private static readonly DateTimeOffset Time = new(2026, 11, 15, 0, 0, 0, TimeSpan.Zero);
+
+    [Theory]
+    [InlineData("codex", "network")]
+    [InlineData("codex", "server")]
+    [InlineData("codex", "decode")]
+    public async Task ColdTransientDeadlinesGateActualHttpAcrossRestartsAndSuccessRestoresWarmPolicy(string id, string failure)
+    {
+        using var fixture = new Fixture(id);
+        fixture.Handler.Failure = failure;
+        QuotaSnapshot result;
+        using (var provider = fixture.Provider()) result = await provider.RefreshStartupAsync();
+        var calls = 1;
+        foreach (var seconds in new[] { 5, 10, 20, 30, 30, 30 })
+        {
+            Assert.Equal(QuotaStatus.Error, result.Status);
+            Assert.Null(result.ObservedAt);
+            var deadline = fixture.Clock.AddSeconds(seconds);
+            Assert.Equal(deadline, result.NextAllowedAt);
+            using var restarted = fixture.Provider();
+            Assert.Null(restarted.ReadCachedSnapshot().ObservedAt);
+            Assert.Equal(calls, fixture.Handler.UsageCalls);
+            fixture.Clock = deadline.AddTicks(-1);
+            await restarted.RefreshStartupAsync();
+            await restarted.RefreshAsync();
+            Assert.Equal(calls, fixture.Handler.UsageCalls);
+            fixture.Clock = deadline;
+            result = await restarted.RefreshAsync();
+            Assert.Equal(++calls, fixture.Handler.UsageCalls);
+        }
+        fixture.Clock = result.NextAllowedAt!.Value;
+        fixture.Handler.Failure = null;
+        using (var provider = fixture.Provider())
+        {
+            var good = await provider.RefreshAsync();
+            Assert.Equal(QuotaStatus.Ok, good.Status);
+            Assert.Equal(fixture.Clock, good.ObservedAt);
+            Assert.Equal(++calls, fixture.Handler.UsageCalls);
+        }
+        var schedule = JsonNode.Parse(File.ReadAllText(Assert.Single(Directory.GetFiles(fixture.Schedule))))!;
+        Assert.Equal(0, schedule["coldFailures"]!.GetValue<int>());
+        fixture.Clock = fixture.Clock.AddMinutes(5);
+        fixture.Handler.Failure = failure;
+        using (var provider = fixture.Provider())
+        {
+            var cached = provider.ReadCachedSnapshot();
+            Assert.Equal(QuotaStatus.Stale, cached.Status);
+            Assert.NotNull(cached.ObservedAt);
+            for (var attempt = 0; attempt < 2; attempt++)
+            {
+                var stale = await provider.RefreshAsync();
+                Assert.Equal(cached.ObservedAt, stale.ObservedAt);
+                Assert.Equal(QuotaStatus.Stale, stale.Status);
+                Assert.Equal(fixture.Clock.AddSeconds(attempt == 0 ? 60 : 120), stale.NextAllowedAt);
+                Assert.Equal(++calls, fixture.Handler.UsageCalls);
+                fixture.Clock = stale.NextAllowedAt!.Value;
+            }
+        }
+        fixture.Handler.Failure = null;
+        using (var provider = fixture.Provider()) Assert.Equal(QuotaStatus.Ok, (await provider.RefreshAsync()).Status);
+        fixture.Clock = fixture.Clock.AddMinutes(5);
+        fixture.Handler.Failure = failure;
+        using (var provider = fixture.Provider())
+            Assert.Equal(fixture.Clock.AddSeconds(60), (await provider.RefreshAsync()).NextAllowedAt);
+    }
+
+    [Theory]
+    [InlineData("codex", 429, -1, false, 60)]
+    [InlineData("codex", 429, 5, false, 60)]
+    [InlineData("codex", 429, 2400, false, 2400)]
+    [InlineData("codex", 503, 2400, true, 2400)]
+    public async Task ColdServerFloorsRemainAuthoritativeAcrossRestart(string id, int status, int retry, bool date, int expected)
+    {
+        using var fixture = new Fixture(id);
+        fixture.Handler.Status = status;
+        fixture.Handler.Retry = retry;
+        fixture.Handler.RetryDate = date;
+        var deadline = Time.AddSeconds(expected);
+        using (var provider = fixture.Provider()) Assert.Equal(deadline, (await provider.RefreshAsync()).NextAllowedAt);
+        using var restarted = fixture.Provider();
+        fixture.Clock = deadline.AddTicks(-1);
+        Assert.Equal(deadline, (await restarted.RefreshStartupAsync()).NextAllowedAt);
+        Assert.Equal(1, fixture.Handler.UsageCalls);
+        fixture.Handler.Status = 200;
+        fixture.Clock = deadline;
+        Assert.Equal(QuotaStatus.Ok, (await restarted.RefreshAsync()).Status);
+        Assert.Equal(2, fixture.Handler.UsageCalls);
+    }
+
+    [Theory]
+    [InlineData("codex")]
+    public async Task RateLimitDoesNotConsumeColdTransientSequence(string id)
+    {
+        using var fixture = new Fixture(id);
+        using var provider = fixture.Provider();
+        fixture.Handler.Status = 429;
+        Assert.Equal(Time.AddSeconds(60), (await provider.RefreshAsync()).NextAllowedAt);
+        fixture.Clock = Time.AddSeconds(60);
+        fixture.Handler.Status = 503;
+        Assert.Equal(fixture.Clock.AddSeconds(5), (await provider.RefreshAsync()).NextAllowedAt);
+        Assert.Equal(2, fixture.Handler.UsageCalls);
+    }
+
+    [Theory]
+    [InlineData("codex")]
+    public async Task LegacyUnknownFutureDeadlineCannotBeShortenedByColdPolicy(string id)
+    {
+        using var fixture = new Fixture(id);
+        using (var initial = fixture.Provider()) await initial.RefreshAsync();
+        var path = Assert.Single(Directory.GetFiles(fixture.Schedule));
+        var schedule = JsonNode.Parse(File.ReadAllText(path))!.AsObject();
+        schedule.Remove("snapshot");
+        schedule.Remove("coldFailures");
+        schedule.Remove("retryNotBefore");
+        schedule["successfulObservation"] = true; // Not proof of validated usable data.
+        schedule["nextAllowedAt"] = Time.AddMinutes(40).ToString("O");
+        File.WriteAllText(path, schedule.ToJsonString());
+        using var provider = fixture.Provider();
+        fixture.Clock = Time.AddMinutes(39);
+        fixture.Handler.Status = 503;
+        Assert.Null(provider.ReadCachedSnapshot().ObservedAt);
+        Assert.Equal(Time.AddMinutes(40), (await provider.RefreshStartupAsync()).NextAllowedAt);
+        Assert.Equal(1, fixture.Handler.UsageCalls);
+        fixture.Clock = Time.AddMinutes(40);
+        Assert.Equal(fixture.Clock.AddSeconds(5), (await provider.RefreshAsync()).NextAllowedAt);
+        Assert.Equal(2, fixture.Handler.UsageCalls);
+    }
+
+    [Theory]
+    [InlineData("codex", false)]
+    [InlineData("codex", true)]
+    public async Task CanceledOrReplacedSourceCannotPersistColdFailureDeadline(string id, bool changeAccount)
+    {
+        using var fixture = new Fixture(id);
+        using var provider = fixture.Provider();
+        fixture.Handler.Failure = "server";
+        fixture.Handler.Block = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        var pending = provider.RefreshAsync();
+        Assert.Equal(1, fixture.Handler.UsageCalls);
+        if (changeAccount) fixture.Credentials("replacement"); else provider.Cancel();
+        fixture.Handler.Block.TrySetResult();
+        Assert.Null((await pending).ObservedAt);
+        Assert.False(Directory.Exists(fixture.Schedule));
+        fixture.Handler.Block = null;
+        Assert.Equal(fixture.Clock.AddSeconds(5), (await provider.RefreshAsync()).NextAllowedAt);
+        Assert.Equal(2, fixture.Handler.UsageCalls);
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        private readonly string root = Path.Combine(Path.GetTempPath(), "quota-cold-" + Guid.NewGuid().ToString("N"));
+        private readonly string id;
+        public readonly Handler Handler;
+        public DateTimeOffset Clock = Time;
+        public string Schedule => Path.Combine(root, "schedule");
+        private string Auth => Path.Combine(root, "auth.json");
+        public Fixture(string id)
+        {
+            this.id = id;
+            Handler = new(id, () => Clock);
+            Directory.CreateDirectory(root);
+            Credentials("fixture");
+        }
+        public void Credentials(string identity) => File.WriteAllText(Auth, id switch
+        {
+            "codex" => JsonSerializer.Serialize(new { tokens = new { access_token = identity, account_id = identity } }),
+            _ => throw new InvalidOperationException("Unsupported quota fixture source")
+        });
+        public CodexQuotaProvider Provider() => id switch
+        {
+            "codex" => new CodexQuotaProvider(Auth, Schedule, new HttpClient(Handler, false), () => Clock),
+            _ => throw new InvalidOperationException("Unsupported quota fixture source")
+        };
+        public void Dispose() { Handler.Dispose(); Directory.Delete(root, true); }
+    }
+
+    private sealed class Handler(string id, Func<DateTimeOffset> now) : HttpMessageHandler
+    {
+        public int UsageCalls;
+        public int Status = 200, Retry = -1;
+        public bool RetryDate;
+        public string? Failure;
+        public TaskCompletionSource? Block;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            if (request.RequestUri!.AbsolutePath.EndsWith("/rate-limit-reset-credits", StringComparison.Ordinal))
+                return new(HttpStatusCode.OK) { Content = new StringContent("{\"available_count\":2}") };
+            UsageCalls++;
+            if (Block is { } block) await block.Task.WaitAsync(cancellationToken);
+            if (Failure == "network") throw new HttpRequestException("Synthetic unavailable transport");
+            var body = Failure == "decode" ? "not json" : id switch
+            {
+                "codex" => "{\"rate_limit\":{\"primary_window\":{\"used_percent\":25,\"limit_window_seconds\":18000}}}",
+                _ => throw new InvalidOperationException("Unsupported quota fixture source")
+            };
+            var response = new HttpResponseMessage((HttpStatusCode)(Failure == "server" ? 503 : Status)) { Content = new StringContent(body) };
+            if (Retry >= 0) response.Headers.RetryAfter = RetryDate
+                ? new RetryConditionHeaderValue(now().AddSeconds(Retry)) : new RetryConditionHeaderValue(TimeSpan.FromSeconds(Retry));
+            return response;
+        }
+    }
+}
