Subject: [PATCH] Fix remote history test fixtures

---
 macos/Tests/AgentSpeedAppTests/RemoteHostsTests.swift | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/macos/Tests/AgentSpeedAppTests/RemoteHostsTests.swift b/macos/Tests/AgentSpeedAppTests/RemoteHostsTests.swift
index a458c4e6..438a4384 100644
--- a/macos/Tests/AgentSpeedAppTests/RemoteHostsTests.swift
+++ b/macos/Tests/AgentSpeedAppTests/RemoteHostsTests.swift
@@ -265,8 +265,9 @@ struct RemoteHostsTests {
         func state(source: String, output: Int, partial: Bool, offline: Bool) throws -> RemoteHostState {
             var result = RemoteHostState()
             result.apply(try #require(message(#"{"version":1,"type":"snapshot","machine_id":"same-machine"}"#)))
-            let history = #"{"version":1,"type":"history","partial":\#(partial),"days":[{"day":"2026-01-01","source":"\#(source)","requests":1,"input":0,"cached_input":0,"cache_write_input":0,"output":\#(output),"reasoning":0,"measured_output":0,"measured_ms":0,"peak":null}]}"#
+            let history = #"{"version":1,"type":"history","partial":\#(partial),"days":[{"day":"2026-01-01","source":"\#(source)","requests":1,"input":0,"cached_input":0,"cache_write_input":0,"output":\#(output),"reasoning":0,"measured_output":0,"measured_ms":0,"peak":null,"unfinalized":0,"agents":1,"models":[],"modes":[],"unpriced":[]}]}"#
             result.apply(try #require(message(history)))
+            try #require(result.historyUsage != nil)
             if offline { result.disconnected() }
             return result
         }
@@ -299,10 +300,11 @@ struct RemoteHostsTests {
         let today = DayKey(Date(), calendar: HistoryDates.calendar).description
         func remote(_ output: Int, machine: String, source: String = "codex") throws -> RemoteHostState {
             let snapshot = #"{"version":1,"type":"snapshot","machine_id":"\#(machine)","today_day":"\#(today)","today_output":\#(output),"live_output":null,"live_total":null}"#
-            let history = #"{"version":1,"type":"history","partial":false,"days":[{"day":"\#(today)","source":"codex","requests":1,"input":5,"cached_input":0,"cache_write_input":0,"output":\#(output),"reasoning":0,"measured_output":0,"measured_ms":0,"peak":null,"unfinalized":0,"agents":1,"cost_micro_usd":null,"unpriced_requests":null,"models":[],"modes":[{"model":"remote-model","kind":"effort","mode":"high","evidence":"recorded","provider":null,"requests":1,"output":\#(output),"measured_output":0,"measured_ms":0}],"unpriced":[{"model":"remote-secret-model","provider":"remote-secret-provider","fast":false,"no_date":false,"count":1}]}]}"#
+            let history = #"{"version":1,"type":"history","partial":false,"days":[{"day":"\#(today)","source":"codex","requests":1,"input":5,"cached_input":0,"cache_write_input":0,"output":\#(output),"reasoning":0,"measured_output":0,"measured_ms":0,"peak":null,"unfinalized":0,"agents":1,"cost_micro_usd":null,"unpriced_requests":null,"models":[{"model":"remote-model","requests":1,"output":\#(output),"measured_output":0,"measured_ms":0,"cost_micro_usd":null,"unpriced_requests":null}],"modes":[{"model":"remote-model","kind":"effort","mode":"high","evidence":"recorded","provider":null,"requests":1,"output":\#(output),"measured_output":0,"measured_ms":0}],"unpriced":[{"model":"remote-secret-model","provider":"remote-secret-provider","fast":false,"no_date":false,"count":1}]}]}"#
             var state = RemoteHostState()
             state.apply(try #require(message(snapshot)))
             state.apply(try #require(message(history.replacingOccurrences(of: #""source":"codex""#, with: #""source":"\#(source)""#))))
+            try #require(state.historyUsage != nil)
             return state
         }
         let firstID = UUID(), secondID = UUID(), aliasID = UUID(), otherSourceID = UUID(), disabledID = UUID()
