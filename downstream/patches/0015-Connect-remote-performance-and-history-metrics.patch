+TEST(CollectorIntegration, ViewerHistoryTimezoneDoesNotChangeHostBaseline) {
+    char home[] = "/tmp/agentspeed-collector-baseline-zone-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-baseline";
+    std::filesystem::create_directories(dir);
+    const auto file = dir / "2026-10-20T10-48-00-000Z_01a158ec-db00-75e2-83a6-00013c6ef362.jsonl";
+    const auto now = std::time(nullptr);
+    const auto midnight = now - now % 86400;
+    const bool early = now - midnight < 43200;
+    const auto old = early ? midnight - 86400 + 13 * 3600 : midnight - 14 * 86400 + 3600;
+    const std::string viewer = early ? "Etc/GMT-12" : "Etc/GMT+12";
+    auto stamp = [](std::time_t value) {
+        std::tm utc{}; gmtime_r(&value, &utc);
+        char result[32]; std::strftime(result, sizeof(result), "%Y-%m-%dT%H:%M:%S.000Z", &utc);
+        return std::string(result);
+    };
+    auto message = [&](std::ostream& out, int id, std::time_t at) {
+        out << "{\"type\":\"message\",\"id\":\"r" << id << "\",\"parentId\":null,\"timestamp\":\"" << stamp(at)
+            << "\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}],\"api\":\"openai-responses\",\"provider\":\"openai\",\"model\":\"gpt-5.5\",\"usage\":{\"input\":300,\"output\":410,\"cacheRead\":0,\"cacheWrite\":0,\"totalTokens\":710},\"stopReason\":\"stop\",\"timestamp\":" << (static_cast<long long>(at) - 2) * 1000 << ",\"duration\":1000}}\n";
+    };
+    {
+        std::ofstream out(file);
+        out << "{\"type\":\"session\",\"version\":3,\"id\":\"01a158ec-db00-75e2-83a6-00013c6ef362\",\"timestamp\":\"" << stamp(old) << "\",\"cwd\":\"/baseline\"}\n";
+        for (int i = 0; i < 20; ++i) message(out, i, old + i);
+    }
+    int input[2], output[2]; ASSERT_EQ(pipe(input), 0); ASSERT_EQ(pipe(output), 0);
+    const auto pid = fork(); ASSERT_GE(pid, 0);
+    if (pid == 0) {
+        dup2(input[0], STDIN_FILENO); dup2(output[1], STDOUT_FILENO);
+        close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+        setenv("HOME", home, 1); setenv("TZ", "UTC", 1);
+        unsetenv("PI_CODING_AGENT_DIR"); unsetenv("PI_CONFIG_DIR");
+        execl(AGENTSPEED_COLLECTOR_PATH, AGENTSPEED_COLLECTOR_PATH, nullptr); _exit(127);
+    }
+    close(input[0]); close(output[1]);
+    const std::string request = "{\"version\":1,\"type\":\"history_timezone\",\"timezone\":\"" + viewer + "\"}\n";
+    EXPECT_EQ(write(input[1], request.data(), request.size()), static_cast<ssize_t>(request.size()));
+    bool appended = false, history = false, baseline = false;
+    std::string data; std::size_t consumed = 0;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    while (std::chrono::steady_clock::now() < deadline && !(history && baseline)) {
+        pollfd fd{output[0], POLLIN, 0}; if (poll(&fd, 1, 1000) <= 0) continue;
+        char bytes[8192]; const auto n = read(output[0], bytes, sizeof(bytes)); if (n <= 0) break;
+        data.append(bytes, static_cast<std::size_t>(n)); std::size_t end;
+        while ((end = data.find('\n', consumed)) != std::string::npos) {
+            agentspeed::json::Document doc; const auto line = data.substr(consumed, end - consumed); consumed = end + 1;
+            if (!doc.parse(line)) continue;
+            const auto root = doc.root();
+            if (root["type"].string() == "snapshot" && !appended) {
+                std::ofstream out(file, std::ios::app);
+                for (int i = 0; i < 3; ++i) message(out, 20 + i, now - 5 + i);
+                appended = true;
+            } else if (root["timezone"].string() == viewer && root["type"].string() == "history") {
+                for (const auto& record : root["perf_records"].elements())
+                    if (record["n"].count() >= 20 && record["day"].string() != stamp(old).substr(0, 10)) history = true;
+            } else if (root["timezone"].string() == viewer && root["type"].string() == "snapshot") {
+                const auto perf = root["agents"].at(0)["perf"];
+                if (perf["n"].count() == 3 && !perf["baseline"].isNull()) baseline = true;
+            }
+        }
+    }
+    close(input[1]); close(output[0]); int status = 0; waitpid(pid, &status, 0);
+    EXPECT_TRUE(history); EXPECT_TRUE(baseline);
+    std::filesystem::remove_all(home);
+}
