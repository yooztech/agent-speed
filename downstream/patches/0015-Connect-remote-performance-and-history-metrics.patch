+TEST(CollectorProtocol, PreservesPerformanceAndIndependentHistoryRecords) {
+    collector::Protocol protocol;
+    agentspeed::Snapshot snapshot;
+    agentspeed::AgentRow agent;
+    agent.id = "agent";
+    agent.perf.emplace();
+    auto& p = agent.perf->score;
+    p.form = agentspeed::perf::Form::Live;
+    p.n = 3; p.score = 1234.5; p.model = "raw-model";
+    p.components[0].id = agentspeed::perf::Id::T;
+    p.components[0].reason = agentspeed::perf::Reason::FewSamples;
+    agent.perf->workSignals.failed = 2;
+    snapshot.agents.push_back(agent);
+    agentspeed::json::Document doc;
+    const auto wire = protocol.snapshot(snapshot);
+    ASSERT_TRUE(doc.parse(wire));
+    const auto perf = doc.root()["agents"].at(0)["perf"];
+    EXPECT_EQ(perf["form"].string(), "live");
+    EXPECT_EQ(perf["n"].count(), 3);
+    EXPECT_EQ(perf["model"].string(), "raw-model");
+    EXPECT_EQ(perf["components"].at(0)["reason"].string(), "fewSamples");
+    EXPECT_EQ(perf["work_signals"]["failed"].count(), 2);
+    EXPECT_EQ(perf["baseline"].raw(), "null");
+
+    agentspeed::perf::DayRecord record;
+    record.day = "2026-10-19"; record.model = "raw-model";
+    record.record.n = 21; record.record.latencyBins[4] = 7;
+    record.record.toolLnSum = 1.25;
+    auto another = record;
+    another.record.n = 2; another.record.latencyBins[4] = 3; another.record.toolLnSum = 0.5;
+    auto different = record; different.model = "z-other-model";
+    agentspeed::history::Report report;
+    agentspeed::json::Document history;
+    const auto historyWire = collector::Protocol::history({}, report, "UTC", {record, another, different});
+    ASSERT_TRUE(history.parse(historyWire));
+    const auto item = history.root()["perf_records"].at(0);
