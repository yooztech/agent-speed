+TEST(CollectorIntegration, StdioReportsOnlyMeasuredPerformanceSamples) {
+    char home[] = "/tmp/agentspeed-collector-perf-XXXXXX";
+    ASSERT_NE(mkdtemp(home), nullptr);
+    const auto dir = std::filesystem::path(home) / ".omp/agent/sessions/-perf";
+    std::filesystem::create_directories(dir);
+    const auto file = dir / "2026-10-20T10-48-00-000Z_01a158ec-db00-75e2-83a6-00013c6ef362.jsonl";
+    const auto now = std::time(nullptr);
+    std::tm utc{}; gmtime_r(&now, &utc);
+    char stamp[32]; std::strftime(stamp, sizeof(stamp), "%Y-%m-%dT%H:%M:%S.000Z", &utc);
+    std::ofstream(file) << "{\"type\":\"session\",\"version\":3,\"id\":\"01a158ec-db00-75e2-83a6-00013c6ef362\",\"timestamp\":\"" << stamp << "\",\"cwd\":\"/perf\"}\n";
+    int input[2], output[2];
+    ASSERT_EQ(pipe(input), 0); ASSERT_EQ(pipe(output), 0);
+    const auto pid = fork(); ASSERT_GE(pid, 0);
+    if (pid == 0) {
+        dup2(input[0], STDIN_FILENO); dup2(output[1], STDOUT_FILENO);
+        close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+        setenv("HOME", home, 1); unsetenv("PI_CODING_AGENT_DIR"); unsetenv("PI_CONFIG_DIR");
+        execl(AGENTSPEED_COLLECTOR_PATH, AGENTSPEED_COLLECTOR_PATH, nullptr); _exit(127);
+    }
+    close(input[0]); close(output[1]);
+    auto append = [&](int id, bool timed) {
+        std::ofstream out(file, std::ios::app);
+        out << "{\"type\":\"message\",\"id\":\"r" << id << "\",\"parentId\":null,\"timestamp\":\"" << stamp
+            << "\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}],\"api\":\"openai-responses\",\"provider\":\"openai\",\"model\":\"gpt-5.5\",\"usage\":{\"input\":300,\"output\":410,\"cacheRead\":0,\"cacheWrite\":0,\"totalTokens\":710},\"stopReason\":\"stop\"";
+        if (timed) out << ",\"timestamp\":" << (static_cast<long long>(now) - 10 + id) * 1000 << ",\"duration\":1000";
+        out << "}}\n";
+    };
+    std::string data; std::size_t consumed = 0; int stage = 0;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(25);
+    while (std::chrono::steady_clock::now() < deadline && stage < 3) {
+        pollfd fd{output[0], POLLIN, 0};
+        if (poll(&fd, 1, 1000) <= 0) continue;
+        char bytes[8192]; const auto n = read(output[0], bytes, sizeof(bytes));
+        if (n <= 0) break;
+        data.append(bytes, static_cast<std::size_t>(n));
+        std::size_t end;
+        while ((end = data.find('\n', consumed)) != std::string::npos) {
+            agentspeed::json::Document doc;
+            const auto line = data.substr(consumed, end - consumed); consumed = end + 1;
+            if (!doc.parse(line) || doc.root()["type"].string() != "snapshot") continue;
+            if (stage == 0) { append(1, true); append(2, true); append(3, false); stage = 1; continue; }
+            const auto perf = doc.root()["agents"].at(0)["perf"];
+            if (!perf.valid()) continue;
+            if (stage == 1 && perf["n"].count() == 2) {
+                EXPECT_EQ(perf["score"].raw(), "null");
+                append(4, true); stage = 2;
+            } else if (stage == 2 && perf["n"].count() == 3) {
+                EXPECT_NE(perf["score"].raw(), "null"); stage = 3;
+            }
+        }
+    }
+    close(input[1]); close(output[0]);
+    int status = 0; waitpid(pid, &status, 0);
+    EXPECT_EQ(stage, 3);
+    std::filesystem::remove_all(home);
+}
