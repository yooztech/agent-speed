--- /dev/null
+++ b/windows/src/AgentSpeed.Core/RemotePerformance.cs
@@ -0,0 +1,63 @@
+using System.Text.Json;
+using AgentSpeed.Core.Perf;
+using AgentSpeed.Core.Work;
+
+namespace AgentSpeed.Core;
+
+internal static class RemotePerformance
+{
+    private static long? Integer(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt64(out var n) ? n : null;
+    private static int? Int(JsonElement e, string name) => Integer(e, name) is long n && n >= 0 && n <= int.MaxValue ? (int)n : null;
+    private static JsonElement? Object(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.Object ? v : null;
+
+    public static (PerfEvaluation? Evaluation, WorkSignals? Work) Agent(JsonElement agent, SourceKind source)
+    {
+        if (Object(agent, "perf") is not { } p) return (null, null);
+        WorkSignals? work = null;
+        if (Object(p, "work_signals") is { } w && Int(w, "failed") is int failed && Int(w, "recovered") is int recovered)
+            work = new WorkSignals(Int(w, "looping"), Int(w, "repeating"), w.NullableNumber("novelty"), failed, recovered);
+        if (!Enum.TryParse<PerfForm>(p.Text("form"), true, out var form) || Int(p, "n") is not int n ||
+            Int(p, "tools") is not int tools || Integer(p, "active_ms") is not long active || active < 0 || p.Array("components") is not { } array)
+            return (null, work);
+        var components = new PerfComponent[7];
+        var seen = new bool[7];
+        foreach (var c in array.EnumerateArray())
+        {
+            if (!Enum.TryParse<PerfComponentId>(c.Text("id"), false, out var id) || (int)id < 0 || (int)id >= components.Length || seen[(int)id] || Int(c, "samples") is not int samples || c.Boolean("present") is not bool present)
+                return (null, work);
+            var reason = present ? PerfAbsence.None : c.Text("reason") switch { "notRecorded" => PerfAbsence.NotRecorded, "fewSamples" => PerfAbsence.FewSamples, _ => (PerfAbsence)(-1) };
+            var measure = c.NullableNumber("measure");
+            var ratio = c.NullableNumber("ratio");
+            if ((int)reason < 0 || (present && (measure is null || ratio is null))) return (null, work);
+            components[(int)id] = new(id, reason, samples, measure, ratio);
+            seen[(int)id] = true;
+        }
+        if (seen.Any(s => !s)) return (null, work);
+        return (new PerfEvaluation(source, form, p.NullableNumber("score"), n, tools, active, Integer(p, "span_start_ms"), p.Text("model"), components) { Baseline = p.NullableNumber("baseline") }, work);
+    }
+
+    public static IReadOnlyList<PerfRecord>? Records(JsonElement root)
+    {
+        if (root.Array("perf_records") is not { } records) return null;
+        var result = new List<PerfRecord>();
+        foreach (var r in records.EnumerateArray())
+        {
+            if (r.Text("day") is not { } day || RemoteHostData.Kind(r.Text("source")) is not { } source || r.Text("model") is not { } model ||
+                r.Array("latency_bins") is not { } bins || bins.GetArrayLength() != LatencyBins.Count) continue;
+            string[] names = ["n", "output_sum", "duration_ms_sum", "reason_n", "reason_output", "reason_duration_ms_sum", "cache_n", "cache_input", "cache_cached", "tool_n", "tool_failed", "active_ms"];
+            var values = names.Select(name => Integer(r, name)).ToArray();
+            if (values.Any(v => v is null or < 0) || r.NullableNumber("tool_ln_sum") is not double ln) continue;
+            var s = new PerfSums { N = values[0]!.Value, OutputSum = values[1]!.Value, DurationMsSum = values[2]!.Value,
+                ReasonN = values[3]!.Value, ReasonOutput = values[4]!.Value, ReasonDurationMsSum = values[5]!.Value,
+                CacheN = values[6]!.Value, CacheInput = values[7]!.Value, CacheCached = values[8]!.Value,
+                ToolN = values[9]!.Value, ToolLnSum = ln, ToolFailed = values[10]!.Value, ActiveMs = values[11]!.Value };
+            var i = 0;
+            bool valid = true;
+            foreach (var bin in bins.EnumerateArray())
+                if (bin.ValueKind == JsonValueKind.Number && bin.TryGetInt64(out var count) && count >= 0) s.LatencyBins[i++] = count;
+                else { valid = false; break; }
+            if (valid) result.Add(new PerfRecord(day, source, model, s));
+        }
+        return result;
+    }
+}
