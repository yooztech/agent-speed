Subject: [PATCH 11/16] Clarify estimated chart values

---
 .../Dashboard/LiveChartSection.swift          |  3 ++-
 .../AgentSpeed/Localization/StringTable.swift |  4 +++-
 spec/strings.json                             | 20 +++++++++++++++----
 3 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/macos/Sources/AgentSpeed/Dashboard/LiveChartSection.swift b/macos/Sources/AgentSpeed/Dashboard/LiveChartSection.swift
index ea2792a4..2ca062e6 100644
--- a/macos/Sources/AgentSpeed/Dashboard/LiveChartSection.swift
+++ b/macos/Sources/AgentSpeed/Dashboard/LiveChartSection.swift
@@ -81,7 +81,8 @@ struct LiveChartSection: View {
         return HStack(spacing: Spacing.xs) {
             SectionTitle(text: l10n("dashboard.live"), latin: model.dashboardLatinCaps)
             if showsEstimate {
-                EstimateLegend(text: l10n("chart.estimated"))
+                EstimateLegend(text: l10n("chart.containsEstimates"))
+                    .help(l10n("chart.containsEstimates.hint"))
                     .transition(.opacity)
             }
             Spacer(minLength: Spacing.xs)
