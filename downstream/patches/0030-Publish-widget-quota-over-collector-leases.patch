+void Service::refreshWidgets(WidgetProviders providers, std::chrono::steady_clock::time_point now) {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    if (impl_->selected != providers) {
+        impl_->selected = providers;
+        for (std::size_t i = 0; i < kProviders.size(); ++i) if (!(providers & (1u << i))) {
+            impl_->widgetProjection[i].reset(); impl_->widgetDue[i].reset();
+            auto& queue = impl_->jobs[i];
+            queue.erase(std::remove_if(queue.begin(), queue.end(), [](const auto& job) {
+                if (!job->widget) return false;
+                job->widget = false;
+                return !job->running && job->requests.empty();
+            }), queue.end());
+        }
+    }
+    if (!providers || (impl_->nextWidgetTick && now < *impl_->nextWidgetTick)) return;
+    impl_->nextWidgetTick = now + std::chrono::seconds(60);
+    const auto wall = impl_->wall();
+    bool queued = false;
+    for (std::size_t i = 0; i < kProviders.size(); ++i) {
+        auto& queue = impl_->jobs[i];
+        if (!(providers & (1u << i)) || !queue.empty() || (impl_->widgetDue[i] && *impl_->widgetDue[i] > wall)) continue;
+        const std::string id = kProviders[i];
+        auto job = std::make_shared<Impl::Job>();
+        job->refresh = job->widget = true;
+        job->generation = (id == "kimi" || id == "commandcode") ? impl_->generationOf(id) : 0;
+        // On cold start Provider::read loads the account and persisted deadline before any HTTP.
+        queue.push_back(std::move(job));
+        queued = true;
+    }
+    if (queued) impl_->changed.notify_all();
+}
+WidgetRecords Service::widgetRecords() const {
+    std::lock_guard<std::mutex> lock(impl_->mutex);
+    return impl_->widgetProjection;
+}
