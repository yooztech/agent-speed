+namespace {
+std::shared_ptr<const WidgetRecord> widgetRecord(Snapshot snapshot) {
+    const auto input = snapshot.id + "\n" + (snapshot.accountIdentity ? snapshot.accountIdentity->id : "");
+    unsigned char hash[32], encoded[45]; unsigned int length = 0;
+    if (EVP_Digest(input.data(), input.size(), hash, &length, EVP_sha256(), nullptr) != 1 || length != sizeof(hash)) return {};
+    if (EVP_EncodeBlock(encoded, hash, sizeof(hash)) != 44) return {};
+    std::string key(reinterpret_cast<const char*>(encoded), 43);
+    std::replace(key.begin(), key.end(), '+', '-');
+    std::replace(key.begin(), key.end(), '/', '_');
+
+    // The legacy whoami label is for direct clients only; it can be a principal name.
+    snapshot.account.reset();
+    if (snapshot.plan && snapshot.plan->size() > 256) snapshot.plan.reset();
+    auto& windows = snapshot.windows;
+    std::set<std::string> ids;
+    windows.erase(std::remove_if(windows.begin(), windows.end(), [&](const Window& w) {
+        return w.id.empty() || w.id.size() > 128 || w.label.size() > 256 || !ids.insert(w.id).second;
+    }), windows.end());
+    if (windows.size() > 16) windows.resize(16);
+    if (snapshot.headlineId && std::none_of(windows.begin(), windows.end(), [&](const Window& w) {
+        return w.id == *snapshot.headlineId;
+    })) snapshot.headlineId.reset();
+    for (auto& window : windows) if (window.duration && *window.duration <= 0) window.duration.reset();
+    if (snapshot.credits && snapshot.credits->balance) {
+        static const std::regex decimal(R"([+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?)");
+        auto& balance = snapshot.credits->balance;
+        if (balance->size() > 64 || !std::regex_match(*balance, decimal)) balance.reset();
+    }
+    if (snapshot.resetCreditsAvailable && *snapshot.resetCreditsAvailable > 9007199254740991LL)
+        snapshot.resetCreditsAvailable.reset();
+    const auto wire = snapshot.json();
+    std::vector<Json::Member> fields = wire.members(), meaning;
+    fields.emplace_back("accountLabel", Json::null());
+    for (const auto& field : fields) {
+        if (field.first != "nextAllowedAt" && field.first != "waitingForRefresh") meaning.push_back(field);
+    }
+    auto rendered = Json::object(std::move(fields));
+    if (rendered.compact().size() > 16 * 1024) return {};
+    auto record = Json::object({{"provider", Json::of(snapshot.id)}, {"recordKey", Json::of(key)},
+        {"snapshot", std::move(rendered)}});
+    return std::make_shared<const WidgetRecord>(WidgetRecord{record.compact(), digest(Json::object(std::move(meaning)).compact())});
+}
