diff --git a/linux/tests/price_sync_test.cpp b/linux/tests/price_sync_test.cpp
new file mode 100644
index 00000000..ed183fc2
--- /dev/null
+++ b/linux/tests/price_sync_test.cpp
@@ -0,0 +1,248 @@
+#include <gtest/gtest.h>
+
+#include "price_sync.hpp"
+
+#include "agentspeed/pricing.hpp"
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "fixture_support.hpp"
+
+namespace {
+using agentspeed::pricing::PriceBook;
+using agentspeed::pricing::PriceTable;
+using agentspeed::TokenCounts;
+
+// 2026-10-15T12:00Z, the fixture tables' own dates.
+constexpr std::int64_t kNow = 1'792'065'600'000;
+const std::string kDigest(64, 'a');
+
+std::string fixture(const char* name) { return fixtures::readText(fixtures::fixtureDir() / "prices" / name); }
+
+std::shared_ptr<const PriceTable> table(const std::string& text) {
+    agentspeed::pricing::TableError error;
+    auto loaded = PriceTable::load(text, &error);
+    EXPECT_TRUE(loaded) << error.describe();
+    return loaded;
+}
+
+// Drops the table's own `tests` member the way the relay table omits it.
+std::string withoutTests(std::string text) {
+    const auto key = text.find("\"tests\"");
+    if (key == std::string::npos) return text;
+    auto open = text.find('[', key);
+    if (open == std::string::npos) return text;
+    int depth = 0;
+    bool inString = false, escaped = false;
+    std::size_t close = std::string::npos;
+    for (std::size_t i = open; i < text.size(); ++i) {
+        const char c = text[i];
+        if (inString) {
+            if (escaped) escaped = false;
+            else if (c == '\\') escaped = true;
+            else if (c == '"') inString = false;
+            continue;
+        }
+        if (c == '"') inString = true;
+        else if (c == '[') ++depth;
+        else if (c == ']' && --depth == 0) { close = i; break; }
+    }
+    if (close == std::string::npos) return text;
+    std::size_t end = close + 1;
+    while (end < text.size() && (text[end] == ' ' || text[end] == '\n' || text[end] == '\r' || text[end] == '\t')) ++end;
+    if (end < text.size() && text[end] == ',') ++end;
+    // The member may be the last one, in which case its own comma is not followed by another and the
+    // preceding member's comma has to go instead.
+    std::size_t start = key;
+    while (start > 0 && (text[start - 1] == ' ' || text[start - 1] == '\n' || text[start - 1] == '\r' || text[start - 1] == '\t')) --start;
+    if (start > 0 && text[start - 1] == ',') --start;
+    return text.erase(start, end - start);
+}
+
+struct Home {
+    std::filesystem::path path;
+    Home() {
+        static int counter = 0;
+        path = std::filesystem::temp_directory_path() / ("agentspeed-price-sync-" + std::to_string(getpid()) + "-" +
+                                                         std::to_string(counter++));
+        std::filesystem::create_directories(path);
+        chmod(path.c_str(), 0700);
+    }
+    ~Home() { std::error_code ignored; std::filesystem::remove_all(path, ignored); }
+    std::string str() const { return path.string(); }
+    std::filesystem::path cache() const { return path / ".cache/agentspeed-collector" / kDigest; }
+};
+
+collector::PriceSync make(const Home& home, std::shared_ptr<PriceBook> book, collector::PriceSync::Transport transport) {
+    return collector::PriceSync(home.str(), kDigest, std::move(book), std::move(transport), [] { return kNow; });
+}
+
+collector::PriceSync::Fetch ok(std::string body, std::string etag = "\"v2\"") {
+    collector::PriceSync::Fetch f;
+    f.status = 200;
+    f.body = std::move(body);
+    f.etag = std::move(etag);
+    return f;
+}
+}
+
+TEST(PriceSync, NewerTableIsStoredThenAppliedToPricing) {
+    Home home;
+    auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v1.json"))});
+    constexpr const char* model = "gpt-6.1-sol-mini";
+    TokenCounts tokens;
+    tokens.input = 1'000'000;
+    // This day is bound before the update and keeps the table it was priced with.
+    EXPECT_FALSE(book->cost(model, std::nullopt, tokens, std::nullopt, false, "2026-10-01"));
+    auto sync = make(home, book, [&](const std::string&) { return ok(fixture("v2.json")); });
+    const auto response = sync.attempt();
+    EXPECT_EQ(response.outcome, collector::PriceSync::Outcome::updated);
+    EXPECT_EQ(response.version, 2);
+    EXPECT_EQ(book->currentVersion(), 2);
+    // A day not yet bound takes the new table, so a newly priced model becomes known.
+    const auto cost = book->cost(model, std::nullopt, tokens, std::nullopt, false, "2026-10-15");
+    ASSERT_TRUE(cost);
+    EXPECT_GT(*cost, 0);
+}
+
+TEST(PriceSync, EqualOrLowerVersionIsUpToDateAndNeverReplacesTheTable) {
+    for (const auto& body : {fixture("v2.json"), fixture("v1.json")}) {
+        Home home;
+        auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v2.json"))});
+        auto sync = make(home, book, [&](const std::string&) { return ok(body); });
+        const auto response = sync.attempt();
+        EXPECT_EQ(response.outcome, collector::PriceSync::Outcome::upToDate);
+        EXPECT_EQ(book->currentVersion(), 2);
+        EXPECT_FALSE(std::filesystem::exists(home.cache() / "prices.json"));
+        const auto state = sync.state();
+        EXPECT_EQ(state.failures, 0);
+        EXPECT_EQ(state.lastSuccessMs, kNow);
+    }
+}
+
+TEST(PriceSync, WrongSchemaIsNewerSchemaAndInvalidTablesAreRejected) {
+    Home home;
+    auto book = std::make_shared<PriceBook>();
+    {
+        auto sync = make(home, book, [](const std::string&) { return ok("{\"schema\":2}"); });
+        const auto response = sync.attempt();
+        EXPECT_EQ(response.outcome, collector::PriceSync::Outcome::newerSchema);
+        EXPECT_EQ(response.reason, "newer schema");
+        EXPECT_EQ(sync.state().failures, 1);
+    }
+    {
+        auto sync = make(home, book, [](const std::string&) { return ok("not json"); });
+        const auto response = sync.attempt();
+        EXPECT_EQ(response.outcome, collector::PriceSync::Outcome::failed);
+        EXPECT_EQ(response.reason, "not a table");
+    }
+}
+
+TEST(PriceSync, OversizedRedirectedAndStaleTablesFailTheRound) {
+    Home home;
+    {
+        auto sync = make(home, std::make_shared<PriceBook>(), [](const std::string&) { return ok(std::string(PriceTable::kMaxBytes + 1, ' ')); });
+        EXPECT_EQ(sync.attempt().reason, "too large");
+    }
+    {
+        collector::PriceSync::Fetch redirect;
+        redirect.status = 302;
+        auto sync = make(home, std::make_shared<PriceBook>(), [&](const std::string&) { return redirect; });
+        EXPECT_EQ(sync.attempt().reason, "HTTP 302");
+    }
+    {
+        auto stale = fixture("v2.json");
+        const auto at = stale.find("2026-10-15");
+        ASSERT_NE(at, std::string::npos);
+        stale.replace(at, 10, "2030-01-01");
+        auto sync = make(home, std::make_shared<PriceBook>(), [&](const std::string&) { return ok(stale); });
+        const auto response = sync.attempt();
+        EXPECT_EQ(response.outcome, collector::PriceSync::Outcome::failed);
+        EXPECT_EQ(response.reason, "table dated in the future");
+    }
+    EXPECT_FALSE(std::filesystem::exists(home.cache() / "prices.json"));
+}
+
+TEST(PriceSync, TableWithoutItsOwnTestsIsAccepted) {
+    Home home;
+    auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v1.json"))});
+    auto sync = make(home, book, [&](const std::string&) { return ok(withoutTests(fixture("v2.json"))); });
+    EXPECT_EQ(sync.attempt().outcome, collector::PriceSync::Outcome::updated);
+    EXPECT_EQ(book->currentVersion(), 2);
+}
+
+TEST(PriceSync, StateAndTableSurviveRestartAndLeaveNoTemporaryFiles) {
+    Home home;
+    {
+        auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v1.json"))});
+        auto sync = make(home, book, [&](const std::string&) { return ok(fixture("v2.json"), "\"v2\""); });
+        EXPECT_EQ(sync.attempt().outcome, collector::PriceSync::Outcome::updated);
+        const auto state = sync.state();
+        EXPECT_EQ(state.version, 2);
+        EXPECT_EQ(state.updated, std::optional<std::string>("2026-10-15"));
+        EXPECT_EQ(state.url, std::optional<std::string>(collector::PriceSync::url));
+        EXPECT_EQ(state.etag, std::optional<std::string>("\"v2\""));
+        EXPECT_EQ(state.lastSuccessMs, kNow);
+        EXPECT_EQ(state.lastAttemptMs, kNow);
+        EXPECT_EQ(state.failures, 0);
+        EXPECT_FALSE(state.lastError);
+    }
+    for (const auto& entry : std::filesystem::directory_iterator(home.cache())) {
+        EXPECT_EQ(entry.path().extension(), ".json") << entry.path();
+    }
+    {
+        auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v1.json"))});
+        auto sync = make(home, book, [](const std::string&) { return ok(""); });
+        EXPECT_EQ(sync.restore(), std::optional<int>(2));
+        EXPECT_EQ(book->currentVersion(), 2);
+        EXPECT_EQ(sync.state().version, 2);
+    }
+}
+
+TEST(PriceSync, EtagHeadersAreParsedAndMalformedOnesIgnored) {
+    EXPECT_EQ(collector::parseEtagHeader("ETag: \"abc123\"\r\n"), "\"abc123\"");
+    EXPECT_EQ(collector::parseEtagHeader("etag: W/\"weak-1\"\r\n"), "W/\"weak-1\"");
+    EXPECT_EQ(collector::parseEtagHeader("ETAG:\t\"v1000\" \r\n"), "\"v1000\"");
+    EXPECT_EQ(collector::parseEtagHeader("Etag: \"<sha256>\"\r\n"), "\"<sha256>\"");
+    // Not an entity tag, not the ETag header, or unusable: the round stays unconditional.
+    EXPECT_EQ(collector::parseEtagHeader("Content-Type: application/json\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader("ETag: abc\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader("ETag: \"\"\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader("ETag: W/abc\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader("ETag: \"a\"b\"\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader("ETag: \"a\x01b\"\r\n"), "");
+    std::string longTag(210, 'a');
+    EXPECT_EQ(collector::parseEtagHeader("ETag: \"" + longTag + "\"\r\n"), "");
+    EXPECT_EQ(collector::parseEtagHeader(""), "");
+}
+
+TEST(PriceSync, RequestHeadersCarryOnlyAStoredEtagConditionally) {
+    const auto plain = collector::priceRequestHeaders("");
+    EXPECT_EQ(plain.size(), 1u);
+    EXPECT_EQ(plain.front(), "Accept: application/json");
+    const auto conditional = collector::priceRequestHeaders("\"v1000\"");
+    ASSERT_EQ(conditional.size(), 2u);
+    EXPECT_EQ(conditional[0], "Accept: application/json");
+    EXPECT_EQ(conditional[1], "If-None-Match: \"v1000\"");
+}
+
+TEST(PriceSync, ConditionalRequestUsesTheStoredETagOnlyForItsOwnURL) {
+    Home home;
+    auto book = std::make_shared<PriceBook>(std::vector<std::shared_ptr<const PriceTable>>{table(fixture("v1.json"))});
+    std::string seen;
+    auto sync = make(home, book, [&](const std::string& etag) { seen = etag; return ok(fixture("v2.json"), "\"v2\""); });
+    sync.attempt();
+    EXPECT_TRUE(seen.empty());
+    auto next = make(home, book, [&](const std::string& etag) {
+        seen = etag;
+        collector::PriceSync::Fetch notModified;
+        notModified.status = 304;
+        return notModified;
+    });
+    EXPECT_EQ(next.attempt().outcome, collector::PriceSync::Outcome::upToDate);
+    EXPECT_EQ(seen, "\"v2\"");
+}
diff --git a/spec/NETWORK.md b/spec/NETWORK.md
index bb5662a7..5dff5fce 100644
--- a/spec/NETWORK.md
+++ b/spec/NETWORK.md
@@ -86,6 +86,9 @@ repository and by the service relay: a revised table reaches every running app w
   On launch the stored copy is validated again; an invalid copy is deleted (logged) and the bundled table is used.
 - **Current table** = the higher `version` of the bundled table and the stored copy, so a newer app build with a
   newer bundled table wins over an older download.
+- **Collector**: the headless Linux collector uses the same first URL, request hardening and validation rules. It
+  stores the table and the same state object under `~/.cache/agentspeed-collector/<executable SHA-256>/`, restores
+  them at start, and adds a validated newer table to its running price book; unbound days then take the new rates.
 - **Effect**: known costs keep the table bound to their day (METRICS 9.7); new rates therefore apply to days not yet
   bound. A response the bound table could not price may use the newer table instead. Files with unpriced history
   are re-analysed when their local logs are still available, and retained live responses may acquire a known cost.
-- 
