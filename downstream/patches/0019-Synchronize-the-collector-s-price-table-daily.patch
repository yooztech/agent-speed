+bool safeDirectory(int fd, bool privateDirectory) {
+    struct stat st{};
+    return fd >= 0 && fstat(fd, &st) == 0 && S_ISDIR(st.st_mode) && st.st_uid == geteuid() &&
+           !(st.st_mode & (privateDirectory ? 0077 : 0022));
+}
+bool safeFile(int fd) {
+    struct stat st{};
+    return fd >= 0 && fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == geteuid() &&
+           st.st_nlink == 1 && !(st.st_mode & 0077);
+}
+
+// <home>/.cache/agentspeed-collector/<digest>/, the directory history_cache.cpp already uses.
+int openCacheDir(const std::string& home, const std::string& digest) {
+    if (home.empty() || home.front() != '/' || digest.size() != 64 ||
+        digest.find_first_not_of("0123456789abcdef") != std::string::npos) return -1;
+    const int root = ::open(home.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (!safeDirectory(root, false)) { if (root >= 0) close(root); return -1; }
+    if (mkdirat(root, ".cache", 0700) < 0 && errno != EEXIST) { close(root); return -1; }
+    const int cache = openat(root, ".cache", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    close(root);
+    if (!safeDirectory(cache, false)) { if (cache >= 0) close(cache); return -1; }
+    if (mkdirat(cache, "agentspeed-collector", 0700) < 0 && errno != EEXIST) { close(cache); return -1; }
+    const int base = openat(cache, "agentspeed-collector", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    close(cache);
+    if (!safeDirectory(base, true)) { if (base >= 0) close(base); return -1; }
+    if (mkdirat(base, digest.c_str(), 0700) < 0 && errno != EEXIST) { close(base); return -1; }
+    const int dir = openat(base, digest.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    close(base);
+    if (!safeDirectory(dir, true)) { if (dir >= 0) close(dir); return -1; }
+    return dir;
+}
+
+std::string readFile(int dir, const char* name, std::size_t cap) {
+    const int fd = openat(dir, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (!safeFile(fd)) { if (fd >= 0) close(fd); return {}; }
+    std::string out;
+    char buffer[16 * 1024];
+    for (;;) {
+        const ssize_t n = read(fd, buffer, sizeof(buffer));
+        if (n < 0) { if (errno == EINTR) continue; break; }
+        if (n == 0) break;
+        if (out.size() + static_cast<std::size_t>(n) > cap) { out.clear(); break; }
+        out.append(buffer, static_cast<std::size_t>(n));
+    }
+    close(fd);
+    return out;
+}
+
+// Temporary file, fsync, rename over the target: a reader sees the old or the new file, never a partial one.
+bool writeFile(int dir, const char* name, const std::string& data) {
+    const std::string tmp = std::string(name) + ".tmp";
+    const int fd = openat(dir, tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (!safeFile(fd)) { if (fd >= 0) { close(fd); unlinkat(dir, tmp.c_str(), 0); } return false; }
+    bool ok = true;
+    for (std::size_t done = 0; done < data.size();) {
+        const ssize_t n = write(fd, data.data() + done, data.size() - done);
+        if (n < 0) { if (errno == EINTR) continue; ok = false; break; }
+        done += static_cast<std::size_t>(n);
+    }
+    if (ok && fsync(fd) < 0) ok = false;
+    close(fd);
+    if (ok && renameat(dir, tmp.c_str(), dir, name) < 0) ok = false;
+    if (!ok) unlinkat(dir, tmp.c_str(), 0);
+    if (ok) fsync(dir);
+    return ok;
+}
+
+std::string esc(const std::string& s) {
+    std::string out;
+    out.reserve(s.size() + 2);
+    for (unsigned char c : s) {
+        switch (c) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    out += buf;
+                } else {
+                    out += static_cast<char>(c);
+                }
+        }
+    }
+    return out;
+}
+
+std::string stateJson(const PriceSync::State& s) {
+    std::string out = "{";
+    auto number = [&](const char* key, std::optional<std::int64_t> value) {
+        if (!value) return;
+        out += std::string("\"") + key + "\":" + std::to_string(*value) + ",";
+    };
+    number("version", s.version ? std::optional<std::int64_t>(*s.version) : std::nullopt);
+    if (s.updated) out += "\"updated\":\"" + esc(*s.updated) + "\",";
+    if (s.url) out += "\"url\":\"" + esc(*s.url) + "\",";
+    if (s.etag) out += "\"etag\":\"" + esc(*s.etag) + "\",";
+    number("lastSuccessMs", s.lastSuccessMs);
+    number("lastAttemptMs", s.lastAttemptMs);
+    if (s.lastError) out += "\"lastError\":\"" + esc(*s.lastError) + "\",";
+    out += "\"failures\":" + std::to_string(s.failures);
+    out += "}";
+    return out;
+}
+
+PriceSync::State parseState(const std::string& text) {
+    PriceSync::State s;
+    Document document;
+    if (!document.parse(text) || !document.root().isObject()) return s;
+    const auto root = document.root();
+    if (const auto v = root["version"]; v.valid() && !v.isNull()) {
+        if (const auto n = v.truncated(); n && *n > 0 && *n <= 2147483647) s.version = static_cast<int>(*n);
+    }
+    const auto stringOf = [](const Value& v) -> std::optional<std::string> {
+        if (!v.valid() || !v.isString()) return std::nullopt;
+        return v.string();
+    };
+    s.updated = stringOf(root["updated"]);
+    s.url = stringOf(root["url"]);
+    s.etag = stringOf(root["etag"]);
+    s.lastError = stringOf(root["lastError"]);
+    if (const auto n = root["lastSuccessMs"].truncated()) s.lastSuccessMs = *n;
+    if (const auto n = root["lastAttemptMs"].truncated()) s.lastAttemptMs = *n;
+    if (const auto n = root["failures"].truncated(); n && *n >= 0) s.failures = static_cast<int>(std::min<std::int64_t>(*n, 1000));
+    return s;
+}
+
+bool iequals(std::string_view a, std::string_view b) {
+    if (a.size() != b.size()) return false;
+    for (std::size_t i = 0; i < a.size(); ++i) {
+        if (std::tolower(static_cast<unsigned char>(a[i])) != std::tolower(static_cast<unsigned char>(b[i]))) return false;
+    }
+    return true;
+}
+
+std::string_view trim(std::string_view text) {
+    while (!text.empty() && (text.front() == ' ' || text.front() == '\t')) text.remove_prefix(1);
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\t' || text.back() == '\r' || text.back() == '\n')) {
+        text.remove_suffix(1);
+    }
+    return text;
+}
+
+// True for `"..."` or `W/"..."`: a non-empty opaque value with no quote or control character inside.
+bool validEntityTag(std::string_view value) {
+    if (value.size() > 200) return false;
+    if (value.size() > 2 && value[0] == 'W' && value[1] == '/') value.remove_prefix(2);
+    if (value.size() < 3 || value.front() != '"' || value.back() != '"') return false;
+    const auto opaque = value.substr(1, value.size() - 2);
+    for (const unsigned char c : opaque) {
+        if (c < 0x20 || c == 0x7f || c == '"') return false;
+    }
+    return true;
+}
+
+// One header line of the response; the first usable ETag wins and nothing here can fail the transfer.
+std::size_t etagWrite(char* p, std::size_t size, std::size_t count, void* opaque) {
+    auto& etag = *static_cast<std::string*>(opaque);
+    const std::string_view line(p, size * count);
+    const auto colon = line.find(':');
+    if (colon != std::string_view::npos && etag.empty() && iequals(line.substr(0, colon), "etag")) {
+        const auto value = trim(line.substr(colon + 1));
+        if (validEntityTag(value)) etag.assign(value);
+    }
+    return size * count;
+}
+
+std::size_t bodyWrite(char* p, std::size_t size, std::size_t count, void* opaque) {
+    auto& out = *static_cast<std::string*>(opaque);
+    const std::size_t n = size * count;
+    if (n > kMaxBytes - out.size()) return 0;
+    out.append(p, n);
+    return n;
+}
+
+// The same hardening as publisher.cpp's curlTransport: HTTPS only, no redirects, no proxy or netrc, verified peer and
+// host, short timeouts and no signals. A body over the cap aborts the transfer and is rejected by the caller.
+PriceSync::Fetch curlFetch(const std::string& etag) {
+    PriceSync::Fetch result;
+    if (!initializeRelayHttp()) { result.error = "curl init"; return result; }
+    CURL* c = curl_easy_init();
+    if (!c) { result.error = "curl init"; return result; }
+    curl_easy_setopt(c, CURLOPT_URL, PriceSync::url);
+    curl_slist* headers = nullptr;
+    for (const auto& header : priceRequestHeaders(etag)) headers = curl_slist_append(headers, header.c_str());
+    curl_easy_setopt(c, CURLOPT_HTTPHEADER, headers);
+#if LIBCURL_VERSION_NUM >= 0x075500
+    curl_easy_setopt(c, CURLOPT_PROTOCOLS_STR, "https");
+#else
+    curl_easy_setopt(c, CURLOPT_PROTOCOLS, CURLPROTO_HTTPS);
+#endif
+    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 0L);
+    curl_easy_setopt(c, CURLOPT_PROXY, "");
+    curl_easy_setopt(c, CURLOPT_NETRC, CURL_NETRC_IGNORED);
+    curl_easy_setopt(c, CURLOPT_SSL_VERIFYPEER, 1L);
+    curl_easy_setopt(c, CURLOPT_SSL_VERIFYHOST, 2L);
+    curl_easy_setopt(c, CURLOPT_CONNECTTIMEOUT_MS, 3000L);
+    curl_easy_setopt(c, CURLOPT_TIMEOUT_MS, 10'000L);
+    curl_easy_setopt(c, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(c, CURLOPT_WRITEFUNCTION, bodyWrite);
+    curl_easy_setopt(c, CURLOPT_WRITEDATA, &result.body);
+    curl_easy_setopt(c, CURLOPT_HEADERFUNCTION, etagWrite);
+    curl_easy_setopt(c, CURLOPT_HEADERDATA, &result.etag);
+    const CURLcode code = curl_easy_perform(c);
+    if (code == CURLE_OK) curl_easy_getinfo(c, CURLINFO_RESPONSE_CODE, &result.status);
+    else result.error = code == CURLE_WRITE_ERROR ? "too large" : curl_easy_strerror(code);
+    curl_slist_free_all(headers);
+    curl_easy_cleanup(c);
+    return result;
+}
+
+bool pastLocalDate(const std::string& updated, std::int64_t nowMs) {
+    const auto tableDay = agentspeed::pricing::UtcDay::instantMs(updated);
+    if (!tableDay) return true;
+    const auto zone = agentspeed::localZone(agentspeed::processEnvironment());
+    const auto label = agentspeed::history::DayLabeler(zone).label(nowMs);
+    if (!label) return true;
+    const auto localDay = agentspeed::pricing::UtcDay::instantMs(*label);
+    if (!localDay) return true;
+    return *tableDay > *localDay + static_cast<std::int64_t>(PriceSync::maxUpdatedAheadDays) * 86'400'000;
+}
+}
+
+std::string parseEtagHeader(std::string_view line) {
+    std::string etag;
+    etagWrite(const_cast<char*>(line.data()), line.size(), 1, &etag);
+    return etag;
+}
+
+std::vector<std::string> priceRequestHeaders(const std::string& ifNoneMatch) {
+    std::vector<std::string> headers{"Accept: application/json"};
+    if (!ifNoneMatch.empty()) headers.push_back("If-None-Match: " + ifNoneMatch);
+    return headers;
+}
+
+struct PriceSync::Impl {
+    std::string home, digest;
+    std::shared_ptr<agentspeed::pricing::PriceBook> book;
+    Transport transport;
+    Clock clock;
+    int dir = -1;
+    std::int64_t launchedAt = 0;
+
+    mutable std::mutex mutex;
+    std::condition_variable wake;
+    State state_;
+    bool stopping = false;
+    bool started = false;
+    std::thread worker;
+
+    Impl(std::string accountHome, std::string binaryDigest, std::shared_ptr<agentspeed::pricing::PriceBook> prices,
+         Transport given, Clock given_)
+        : home(std::move(accountHome)), digest(std::move(binaryDigest)), book(std::move(prices)),
+          transport(std::move(given)), clock(given_ ? std::move(given_) : Clock(&wallMs)) {
+        launchedAt = clock();
+        dir = openCacheDir(home, digest);
+        state_ = parseState(loadStateText());
+    }
+
+    std::string loadStateText() const { return dir >= 0 ? readFile(dir, "price-sync.json", 64 * 1024) : std::string(); }
+    std::string loadTableText() const { return dir >= 0 ? readFile(dir, "prices.json", kMaxBytes) : std::string(); }
+
+    void saveState() {
+        std::lock_guard lock(mutex);
+        if (dir < 0) return;
+        if (!writeFile(dir, "price-sync.json", stateJson(state_))) std::cerr << "collector: price table state could not be saved\n";
+    }
+
+    Response fail(const std::string& reason, bool newerSchema = false) {
+        {
+            std::lock_guard lock(mutex);
+            ++state_.failures;
+            state_.lastError = reason;
+        }
+        saveState();
+        Response r;
+        r.outcome = newerSchema ? Outcome::newerSchema : Outcome::failed;
+        r.reason = reason;
+        return r;
+    }
+
+    Response success(Outcome outcome, int version, const std::string& reason = {}) {
+        {
+            std::lock_guard lock(mutex);
+            state_.lastSuccessMs = state_.lastAttemptMs;
+            state_.failures = 0;
+            state_.lastError.reset();
+        }
+        saveState();
+        Response r;
+        r.outcome = outcome;
+        r.version = version;
+        r.reason = reason;
+        return r;
+    }
+
+    Response attempt();
+    void run();
+    std::int64_t nextAttempt(std::int64_t launchedAtMs) const;
+    std::int64_t nextAttemptLocked(std::int64_t launchedAtMs) const;
+};
+
+PriceSync::Response PriceSync::Impl::attempt() {
+    State snapshot;
+    {
+        std::lock_guard lock(mutex);
+        state_.lastAttemptMs = clock();
+        snapshot = state_;
+    }
+    const std::int64_t attemptedAt = *snapshot.lastAttemptMs;
+    const std::string etag = snapshot.url == url ? snapshot.etag.value_or(std::string()) : std::string();
+    const int currentVersion = book->currentVersion();
+    const Fetch fetched = transport ? transport(etag) : curlFetch(etag);
+    if (!fetched.error.empty()) {
+        std::cerr << "collector: price table " << host << ": " << fetched.error << "\n";
+        return fail(fetched.error);
+    }
+    if (fetched.status == 304) {
+        {
+            std::lock_guard lock(mutex);
+            state_.url = url;
+        }
+        std::cerr << "collector: price table " << host << ": 304, unchanged\n";
+        return success(Outcome::upToDate, currentVersion);
+    }
+    if (fetched.status < 200 || fetched.status > 299) {
+        const std::string reason = "HTTP " + std::to_string(fetched.status);
+        std::cerr << "collector: price table " << host << ": " << reason << "\n";
+        return fail(reason);
+    }
+    if (fetched.body.size() > kMaxBytes) return fail("too large");
+    agentspeed::pricing::TableError error;
+    auto table = agentspeed::pricing::PriceTable::load(fetched.body, &error);
+    if (!table) {
+        if (error.kind == agentspeed::pricing::TableErrorKind::UnsupportedSchema) {
+            std::cerr << "collector: price table " << host << ": " << fetched.body.size() << " bytes, newer schema "
+                      << error.schema.value_or(0) << "\n";
+            return fail("newer schema", true);
+        }
+        const std::string reason = error.kind == agentspeed::pricing::TableErrorKind::Invalid ? "invalid table" : "not a table";
+        std::cerr << "collector: price table " << host << ": " << fetched.body.size() << " bytes rejected: " << reason << "\n";
+        return fail(reason);
+    }
+    if (pastLocalDate(table->updated(), attemptedAt)) {
+        std::cerr << "collector: price table " << host << ": updated " << table->updated() << " is in the future\n";
+        return fail("table dated in the future");
+    }
+    {
+        std::lock_guard lock(mutex);
+        state_.version = table->version();
+        state_.updated = table->updated();
+        state_.url = url;
+        state_.etag = fetched.etag;
+    }
+    if (table->version() <= currentVersion) {
+        std::cerr << "collector: price table " << host << ": v" << table->version() << " (" << fetched.body.size()
+                  << " bytes), current is v" << currentVersion << "\n";
+        return success(Outcome::upToDate, currentVersion);
+    }
+    if (dir < 0 || !writeFile(dir, "prices.json", fetched.body)) {
+        std::cerr << "collector: price table v" << table->version() << " could not be saved\n";
+        std::lock_guard lock(mutex);
+        state_.version.reset();
+        state_.etag.reset();
+        return fail("could not save");
+    }
+    book->add(table);
+    std::cerr << "collector: price table " << host << ": updated to v" << table->version() << " (" << fetched.body.size()
+              << " bytes)\n";
+    return success(Outcome::updated, table->version());
+}
+
+void PriceSync::Impl::run() {
+    std::unique_lock lock(mutex);
+    for (;;) {
+        const std::int64_t now = clock();
+        const std::int64_t wait = std::min(std::max<std::int64_t>(nextAttemptLocked(launchedAt) - now, 0), checkIntervalMs);
+        wake.wait_for(lock, std::chrono::milliseconds(wait), [this] { return stopping; });
+        if (stopping) return;
+        if (clock() < nextAttemptLocked(launchedAt)) continue;
+        lock.unlock();
+        attempt();
+        lock.lock();
+    }
+}
+
+std::int64_t PriceSync::Impl::nextAttempt(std::int64_t launchedAtMs) const {
+    std::lock_guard lock(mutex);
+    return nextAttemptLocked(launchedAtMs);
+}
+
+std::int64_t PriceSync::Impl::nextAttemptLocked(std::int64_t launchedAtMs) const {
+    const auto earliest = launchedAtMs + launchDelayMs;
+    const auto clamp = [](std::optional<std::int64_t> ms, std::int64_t now) { return std::min(ms.value_or(now), now); };
+    const std::int64_t nowMs = clock();
+    if (state_.failures > 0) {
+        const std::int64_t delay = state_.failures == 1 ? retryDelayMs : intervalMs;
+        const std::int64_t from = clamp(state_.lastAttemptMs, nowMs);
+        return std::max(earliest, from + delay);
+    }
+    if (state_.lastSuccessMs) return std::max(earliest, clamp(state_.lastSuccessMs, nowMs) + intervalMs);
+    return earliest;
+}
+
+PriceSync::PriceSync(const std::string& home, const std::string& digest,
+                     std::shared_ptr<agentspeed::pricing::PriceBook> book, Transport transport, Clock clock)
+    : impl_(std::make_unique<Impl>(home, digest, std::move(book), std::move(transport), std::move(clock))) {}
+PriceSync::~PriceSync() { stop(); }
+
+std::optional<int> PriceSync::restore() {
+    const std::string text = impl_->loadTableText();
+    if (text.empty()) return std::nullopt;
+    agentspeed::pricing::TableError error;
+    auto table = agentspeed::pricing::PriceTable::load(text, &error);
+    if (!table) {
+        std::cerr << "collector: stored price table is invalid; ignored\n";
+        if (impl_->dir >= 0) unlinkat(impl_->dir, "prices.json", 0);
+        return std::nullopt;
+    }
+    impl_->book->add(table);
+    return table->version();
+}
+
+PriceSync::Response PriceSync::attempt() { return impl_->attempt(); }
+
+std::int64_t PriceSync::nextAttempt(std::int64_t launchedAt) const { return impl_->nextAttempt(launchedAt); }
+
+PriceSync::State PriceSync::state() const {
+    std::lock_guard lock(impl_->mutex);
+    return impl_->state_;
+}
+
+void PriceSync::start() {
+    {
+        std::lock_guard lock(impl_->mutex);
+        if (impl_->started) return;
+        impl_->started = true;
+    }
+    impl_->worker = std::thread([this] { impl_->run(); });
+}
+
+void PriceSync::stop() {
+    {
+        std::lock_guard lock(impl_->mutex);
+        impl_->stopping = true;
+    }
+    impl_->wake.notify_all();
+    if (impl_->worker.joinable()) impl_->worker.join();
+}
+}
