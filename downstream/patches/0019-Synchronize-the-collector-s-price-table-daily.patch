+#pragma once
+
+#include <cstdint>
+#include <condition_variable>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+#include "agentspeed/price_book.hpp"
+
+namespace collector {
+// The value of an `ETag` response header, case-insensitively matched and trimmed, or empty when the line is not a
+// usable strong or weak entity tag: a quoted, non-empty opaque value of at most 200 bytes with no control characters.
+// A malformed header never fails the round; it just leaves the request unconditional.
+std::string parseEtagHeader(std::string_view line);
+// The request headers of one round, including `If-None-Match` only when a stored tag is given.
+std::vector<std::string> priceRequestHeaders(const std::string& ifNoneMatch);
+
+// The headless collector's daily price-table sync of spec/NETWORK.md 3. The service relay is asked first and the
+// existing native validator decides whether a download becomes current; nothing here parses a table itself.
+// Storage follows the collector's cache convention: <home>/.cache/agentspeed-collector/<digest>/ with 0700/0600,
+// a temporary file renamed over the target.
+class PriceSync {
+public:
+    struct Fetch {
+        long status = 0;
+        std::string body, etag, error;
+    };
+    // The one request of a round; `ifNoneMatch` is the stored ETag for this URL, or empty.
+    using Transport = std::function<Fetch(const std::string& ifNoneMatch)>;
+    // Wall-clock milliseconds; tests supply a deterministic clock.
+    using Clock = std::function<std::int64_t()>;
+
+    enum class Outcome { upToDate, updated, newerSchema, failed };
+
+    struct Response {
+        Outcome outcome = Outcome::failed;
+        int version = 0;
+        std::string reason;
+    };
+
+    struct State {
+        std::optional<int> version;
+        std::optional<std::string> updated, url, etag;
+        std::optional<std::int64_t> lastSuccessMs, lastAttemptMs;
+        std::optional<std::string> lastError;
+        int failures = 0;
+    };
+
+    static constexpr const char* url = "https://agent-speed.yooztech.com/v1/prices/current";
+    // A table's `updated` may be at most this many days after the local date.
+    static constexpr int maxUpdatedAheadDays = 2;
+
+    // `transport` defaults to the hardened libcurl request; tests inject a scripted one.
+    PriceSync(const std::string& home, const std::string& digest, std::shared_ptr<agentspeed::pricing::PriceBook> book,
+              Transport transport = {}, Clock clock = {});
+    ~PriceSync();
+    PriceSync(const PriceSync&) = delete;
+    PriceSync& operator=(const PriceSync&) = delete;
+
+    // The stored table, validated again; when it is acceptable it becomes known to the book. Returns its version.
+    std::optional<int> restore();
+    // One round: fetch, validate, store and apply. Public so a test can drive it without the thread.
+    Response attempt();
+    // The next automatic round, in wall-clock milliseconds.
+    std::int64_t nextAttempt(std::int64_t launchedAt) const;
+    State state() const;
+
+    void start();
+    void stop();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+}
